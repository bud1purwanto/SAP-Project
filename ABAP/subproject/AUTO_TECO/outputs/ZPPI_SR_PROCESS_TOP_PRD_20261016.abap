***************
INITIALIZATION.
***************
  PERFORM SELECTION_TEXT.

************
TOP-OF-PAGE.
************
  IF TOP_IND EQ SPACE.
    PERFORM BLIST_HEADER.
  ENDIF.

* Create a help data for a selection screen Order Type
*****************************************************
AT SELECTION-SCREEN ON VALUE-REQUEST FOR SO_AUART-LOW.
*****************************************************
  PERFORM F4_AUART.

* Create a help data for a selection screen Order Status
*****************************************************
AT SELECTION-SCREEN ON VALUE-REQUEST FOR SO_ISTAT-LOW.
*****************************************************
  PERFORM F4_HELP USING 'low'.

******************************************************
AT SELECTION-SCREEN ON VALUE-REQUEST FOR SO_ISTAT-HIGH.
******************************************************
  PERFORM F4_HELP USING 'high'.

**********************************
TOP-OF-PAGE DURING LINE-SELECTION.
**********************************
  IF SY-UCOMM = 'REFRESH' OR SY-UCOMM = 'SELE_1' OR SY-UCOMM = 'SELE_2'.
    PERFORM BLIST_HEADER.
  ELSEIF SY-UCOMM = 'SELE05'.
    CLEAR: IN_CHARG1, IN_CHARG2, IN_CHARG3, V_TYPE1, V_TYPE2, V_TYPE3,
           V_TEXT1, V_TEXT2, V_TEXT3, IN_NIK, IN_RES, IN_SPEED,
           IN_SLOC1, IN_SLOC2, IN_SLOC3, IN_JOINT2, IN_JOINT3, CHK1,
           CHK2, CHK3.
    PERFORM BOXER_HEADER.
  ENDIF.

****************
AT USER-COMMAND.
****************
  CLEAR FLGNO.
  CLEAR FLAG.
  IF SY-UCOMM = 'SELE05' OR SY-UCOMM = 'SELE06'.
    PERFORM READ_MARKER_BLIST.
  ENDIF.

  CASE RETCODE.
    WHEN 01.
      MESSAGE I000(0K) WITH 'Select one line item only.'.   "#EC NOTEXT
    WHEN 02.
      IF SY-UCOMM = 'SELE_1'.
        MARK  =  'X'.
        PERFORM MODIF_MARK USING MARK.
      ELSEIF SY-UCOMM = 'SELE_2'.
        MARK  =  ' '.
        PERFORM MODIF_MARK USING MARK.
      ELSE.
        MESSAGE I000(0K) WITH 'No Data Selected.'.          "#EC NOTEXT
      ENDIF.
  ENDCASE.

  CHECK RETCODE = 00.

  IF SY-UCOMM = 'TECO'.
    RETCODE = 00.
    PERFORM READ_MARKER_BLIST_TECO.
  ENDIF.

  IF SY-UCOMM = 'REFRESH'.
    RETCODE = 00.
    PERFORM READ_MARKER_BLIST_REFRESH.
  ENDIF.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      INPUT  = COM_ORDER
    IMPORTING
      OUTPUT = COM_ORDER.

  ZHEADER-AUFNR = COM_ORDER.
  SELECT SINGLE AUART INTO ZHEADER-AUART FROM AUFK WHERE AUFNR = ZHEADER-AUFNR.

  IF SY-UCOMM = 'SELE05'.
    PERFORM FIND_ORDER_TYPE USING ZHEADER.
  ENDIF.

  IF FLAG NE SPACE.
    EXIT.
  ENDIF.

*  clear sy-lsind.
  CASE SY-UCOMM.
    WHEN 'BACK'.

      SET PF-STATUS ''.
      LEAVE SCREEN.
      IF FLGNO = 'X'.
        LEAVE SCREEN.
      ENDIF.

    WHEN 'SELE03' OR 'SELE05'.                    " Start / Stop


      "add by yulius CHECK MATERIAL NOT IN TOYOBO 14.06.2016
      IF SY-TCODE <> 'ZTYB02'.
        DATA : ZMATNR TYPE MARA-MATNR.

        SELECT SINGLE MATNR
          INTO ZMATNR
          FROM ZMRTYB
          WHERE MATNR = ZBOXER-MATNR AND NOTES = 'MASTERTOYOBO'.

        IF ZMATNR IS NOT INITIAL.
          MESSAGE 'Material Toyobo tidak dapat dieksekusi di sini' TYPE 'I'.
          FLAG = 'X'.
        ENDIF.
      ENDIF.

      IF FLAG NE SPACE.
        EXIT.
      ENDIF.
      "end add by yulius CHECK MATERIAL NOT IN TOYOBO 14.06.2016
      SY-LSIND = 1.
      PERFORM DISPLAY_BOXER_LAYOUT.

    WHEN 'SELE06'.                                " Batal Start / Stop

      CLEAR: FLAG, IT_LOG, V_RUECK, VMESS.

      AUTHORITY-CHECK OBJECT 'C_AFRU_AWK'
               ID 'ACTVT' FIELD '85'.
      IF SY-SUBRC <> 0.
        FLAG = 'X'.
        MESSAGE 'Not authorize to cancel order' TYPE 'I'.   "#EC NOTEXT
        EXIT.
      ENDIF.

      REFRESH: IT_LOG.

*- add by ALF at 30-sep-2013
      PERFORM CHECK_STATUS.
*-
      IF FLAG = 'X'.
        EXIT.
      ELSE.
        DATA: ANS.
        CONCATENATE 'Order' COM_ORDER 'akan di cancel ?' INTO VMESS SEPARATED BY SPACE. "#EC NOTEXT
        CALL FUNCTION 'POPUP_TO_CONFIRM'
          EXPORTING
            TITLEBAR                    = 'Cancel Order ??' "#EC NOTEXT
*            DIAGNOSE_OBJECT             = ' '
            TEXT_QUESTION               = VMESS
            TEXT_BUTTON_1               = 'Ya'"(001)
*           ICON_BUTTON_1               = ' '
            TEXT_BUTTON_2               = 'Tidak'"(002)
*           ICON_BUTTON_2               = ' '
            DEFAULT_BUTTON              = '2'
            DISPLAY_CANCEL_BUTTON       = ' '
*           USERDEFINED_F1_HELP         = ' '
*           START_COLUMN                = 25
*           START_ROW                   = 6
*           POPUP_TYPE                  =
*           IV_QUICKINFO_BUTTON_1       = ' '
*           IV_QUICKINFO_BUTTON_2       = ' '
          IMPORTING
            ANSWER                      = ANS
*         TABLES
*           PARAMETER                   =
          EXCEPTIONS
            TEXT_NOT_FOUND              = 1
            OTHERS                      = 2
                   .
        IF SY-SUBRC <> 0.
*   Implement suitable error handling here
        ENDIF.

        IF ANS = 1.
          PERFORM COLLECT_DATA_CANCEL.
          IF FLAG = SPACE.
            PERFORM PROCESS_CANCEL.
          ELSE.
*  ******        MESSAGE i001(00) WITH 'Retrieve Data failed'.
            EXIT.
          ENDIF.
        ENDIF.
      ENDIF.


    WHEN 'TECO'.

      PERFORM TECO_ORDER.

    WHEN 'REFRESH'.

      SY-LSIND = 1.
      PERFORM READ_REFRESH.
      PERFORM MODIFY_REFRESH.
*      PERFORM DISPLAY_ORIGINAL_ORDER.

    WHEN 'SELE_1'.

      MARK  =  'X'.
      PERFORM MODIF_MARK USING MARK.

    WHEN 'SELE_2'.

      MARK  =  ' '.
      PERFORM MODIF_MARK USING MARK.

    WHEN 'DETAIL'.

      CLEAR: FLAG.
      PERFORM GET_DETAIL CHANGING FLAG.
      IF FLAG = 'X'.
*******        MESSAGE I001(00) WITH 'Retrieve Data failed'. "#EC NOTEXT
        MESSAGE 'Retrieve Data failed' TYPE 'I'.            "#EC NOTEXT
        EXIT.
      ENDIF.

    WHEN  'COMMIT'.

** Retrieving Data from layout
      CLEAR: FLAG, IT_SCRAP, WA_SCRAP, R_MBLNR, R_MJAHR, V_CONF_NO,
             S_MBLNR, S_MJAHR, U_MBLNR, U_MJAHR.
      REFRESH: IT_SCRAP.
      PERFORM CEK_COM_ORDER_STATUS CHANGING FLAG.
      IF FLAG EQ SPACE.
        CLEAR FLAG.
        PERFORM RETRIEVE_DATA_BOXER CHANGING FLAG.
*- check locking material by ALF at 14-03-2018
        IF FLAG EQ SPACE.
          PERFORM CHECKING_LOCK_MATNR CHANGING FLAG.
        ENDIF.
*- end of check locking material by ALF at 14-03-2018
        IF FLAG EQ SPACE.
*   Checking the data and condition for the Order
          CLEAR FLAG.
          PERFORM CHECKING_DATA_BOXER CHANGING FLAG.
* add by ALF at 15-05-2007.
          PERFORM CEK_OVER_PROD_Z.
* end of ALF
          IF FLAG EQ SPACE.
* Checking the data for Join sendiri and Panjang kurang
            PERFORM CHECK_LENGTH_BOXER CHANGING FLAG.
            IF FLAG EQ SPACE.
* Popup Confirmation
              PERFORM POPUP_CONFIRMATION CHANGING FLAG.
            ELSE.
*******              MESSAGE i001(00) WITH 'Check Length failed'.
              EXIT.
            ENDIF.
          ELSE.
*******            MESSAGE i001(00) WITH 'Checking Condition failed'.
            EXIT.
          ENDIF.
        ELSE.
*******          MESSAGE i001(00) WITH 'Retrieve Data failed'.
          EXIT.
        ENDIF.
      ELSE.
*******        MESSAGE i001(00) WITH 'Retrieve Data failed'.
        EXIT.
      ENDIF.

** Display Report for Order
    WHEN  'DISPLAY'.

      PERFORM DISPLAY_BATCH_BOXER.

    WHEN 'YES'.
      CLEAR: FLAG.
      PERFORM CEK_COM_ORDER_STATUS CHANGING FLAG.
      IF FLAG EQ SPACE.
        PERFORM PROCESS_ALL.
        SET USER-COMMAND 'RW'.
      ELSE.
        EXIT.
      ENDIF.

* Printing Label
    WHEN  'PRINTING'.
      PERFORM PRINT_LABEL.
  ENDCASE.

*&---------------------------------------------------------------------*
*&      Form  print_label
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM PRINT_LABEL.
  RANGES: TORD FOR AFPO-ABLAD.

  DATA : ANS,
         IT_LABEL LIKE MCMARKED_VALUES OCCURS 2 WITH HEADER LINE.
  DATA : VSIGN LIKE SVAL OCCURS 2 WITH HEADER LINE.

  DATA: BEGIN OF IT_CHARG OCCURS 0,
    MATNR LIKE MCH1-MATNR,
    CHARG LIKE MCH1-CHARG,
    END OF IT_CHARG.

  SELECT A~MATNR B~CHARG INTO TABLE IT_CHARG
    FROM AFPO AS A LEFT JOIN MCH1 AS B ON A~MILL_OC_AUFNR_U = B~LICHA
    WHERE A~AUFNR EQ COM_ORDER.

  IF SY-SUBRC NE 0.
    EXIT.
  ENDIF.

*- modify by ALF for sort print label
  DATA: V_GEN1 TYPE N.
  READ TABLE V_BASIC INDEX 1.
*- ganjil
  LOOP AT ITAB_POS.
    IF V_BASIC-ABLAD = 'MS'.
      V_GEN1 = ITAB_POS-POSMS / 2.
      V_GEN1 = V_GEN1 * 2.
      IF V_GEN1 = ITAB_POS-POSMS.
        CONTINUE.
      ENDIF.

      CONCATENATE ITAB_POS-POSMS '-' ITAB_POS-CHARG INTO IT_LABEL-VALUE SEPARATED BY SPACE.
    ELSE.
      V_GEN1 = ITAB_POS-POSSS / 2.
      V_GEN1 = V_GEN1 * 2.
      IF V_GEN1 = ITAB_POS-POSSS.
        CONTINUE.
      ENDIF.

      CONCATENATE ITAB_POS-POSSS '-' ITAB_POS-CHARG INTO IT_LABEL-VALUE SEPARATED BY SPACE.
    ENDIF.

    APPEND IT_LABEL.
  ENDLOOP.

*- genap
  LOOP AT ITAB_POS.
    IF V_BASIC-ABLAD = 'MS'.
      V_GEN1 = ITAB_POS-POSMS / 2.
      V_GEN1 = V_GEN1 * 2.
      IF V_GEN1 NE ITAB_POS-POSMS.
        CONTINUE.
      ENDIF.

      CONCATENATE ITAB_POS-POSMS '-' ITAB_POS-CHARG INTO IT_LABEL-VALUE SEPARATED BY SPACE.
    ELSE.
      V_GEN1 = ITAB_POS-POSSS / 2.
      V_GEN1 = V_GEN1 * 2.
      IF V_GEN1 NE ITAB_POS-POSSS.
        CONTINUE.
      ENDIF.

      CONCATENATE ITAB_POS-POSSS '-' ITAB_POS-CHARG INTO IT_LABEL-VALUE SEPARATED BY SPACE.
    ENDIF.

    APPEND IT_LABEL.
  ENDLOOP.

  DATA S_ANS(1).
  CALL FUNCTION 'POPUP_TO_CONFIRM'
    EXPORTING
      TITLEBAR              = 'Print Label'
      TEXT_QUESTION         = 'Apakah cetak label dibagi berdasarkan posisi Ganjil - Genap ?'
      TEXT_BUTTON_1         = 'YES'
      ICON_BUTTON_1         = ' '
      TEXT_BUTTON_2         = 'NO'
      ICON_BUTTON_2         = ' '
      DISPLAY_CANCEL_BUTTON = ' '
    IMPORTING
      ANSWER                = S_ANS
    EXCEPTIONS
      TEXT_NOT_FOUND        = 1
      OTHERS                = 2.

  IF S_ANS = 2.
    SORT IT_LABEL BY VALUE ASCENDING.
  ENDIF.

  DATA: V_TYBROL1 LIKE CABN-ATINN,
        V_TYBROL2 LIKE AUSP-ATWRT.
  SELECT SINGLE ATINN INTO V_TYBROL1 FROM CABN WHERE ATNAM EQ 'ZZNOROLLTOYOBO'.
  LOOP AT IT_LABEL.
    SELECT SINGLE B~ATWRT INTO V_TYBROL2
      FROM ( MCH1 AS A JOIN AUSP AS B ON A~CUOBJ_BM = B~OBJEK ) JOIN CABN AS C ON B~ATINN = C~ATINN
      WHERE A~CHARG = IT_LABEL-VALUE+5(10) AND C~ATINN = V_TYBROL1.
    IF SY-SUBRC NE 0.
      EXIT.
    ENDIF.

    CONCATENATE IT_LABEL-VALUE '- Roll TYB: ' V_TYBROL2 INTO IT_LABEL-VALUE SEPARATED BY SPACE.
    MODIFY IT_LABEL.
  ENDLOOP.

*- end of modify by ALF for sort print label

*
*  LOOP AT IT_CHARG.
*    IT_LABEL-VALUE = IT_CHARG-CHARG.
*    APPEND IT_LABEL.
*  ENDLOOP.
*
**-- get position
*  DATA: V_PMS LIKE CABN-ATINN,
*        V_PSS LIKE CABN-ATINN.
*
*data: v_pos1 like ausp-ATWRT,
*      v_pos2 like ausp-ATWRT,
*      v_charg like mch1-charg.
*
*  SELECT SINGLE ATINN INTO V_PMS FROM CABN WHERE ATNAM EQ 'ZZPOSITIONMS'.
*  SELECT SINGLE ATINN INTO V_PSS FROM CABN WHERE ATNAM EQ 'ZZPOSITIONSS'.
*
*select single a~charg b~ATWRT
*  into (v_charg, v_pos2)
*  from ( mch1 as a join ausp as b on a~CUOBJ_BM = b~OBJEK ) join cabn as c on b~atinn = c~atinn
*  where a~charg = it_charg-charg and c~atinn = v_pms.
*
*select single a~charg b~ATWRT
*  into (v_charg, v_pos2)
*  from ( mch1 as a join ausp as b on a~CUOBJ_BM = b~OBJEK ) join cabn as c on b~atinn = c~atinn
*  where a~charg = it_charg-charg and c~atinn = v_pms.
*
******************

  CALL FUNCTION 'MC_POPUP_TO_MARK_VALUES'
    EXPORTING
      I_MIN_MARKED_VALUES  = 0
      I_POPUP_TITLE        = 'Printing Label'
*     i_textline           = 'HU already .. '
      I_TEXT_LENGTH        = 50
      I_ICONINFO_FOR_ENTER = 'Select Print Label'
    TABLES
      T_VALUES_FOR_MARKING = IT_LABEL
    EXCEPTIONS
      CANCEL_PUSHED        = 1
      OTHERS               = 2.

  IF SY-SUBRC = 1.
    EXIT.
  ENDIF.

  LOOP AT IT_LABEL.
    IT_LABEL-VALUE = IT_LABEL-VALUE+5(10).
    MODIFY IT_LABEL.
  ENDLOOP.

* Number of Copies
  VSIGN-TABNAME = 'PRI_PARAMS'. VSIGN-FIELDNAME = 'PRCOP'.
  VSIGN-VALUE   = '1'. APPEND VSIGN.
  CALL FUNCTION 'POPUP_GET_VALUES'
    EXPORTING
      POPUP_TITLE    = 'Enter Number of Copies'
      START_COLUMN   = '05'
      START_ROW      = '15'
      NO_VALUE_CHECK = ' '
    IMPORTING
      RETURNCODE     = ANS
    TABLES
      FIELDS         = VSIGN.

  IF ANS = 'A'.
    EXIT.
  ENDIF.

  IF VSIGN-VALUE > 10.
    MESSAGE I000(0K) WITH 'Print more than 10 Copies not allowed'.
    EXIT.
  ENDIF.

  READ TABLE VSIGN  WITH KEY FIELDNAME = 'PRCOP'.
  IF VSIGN-VALUE = 0.
    MESSAGE I000(0K) WITH '0 (zero) not allowed'.
    EXIT.
  ENDIF.

  LOOP AT IT_LABEL WHERE MARKED = 'X'.
    TORD-SIGN   = 'I'.
    TORD-OPTION = 'EQ'.
    TORD-LOW = IT_LABEL-VALUE.
    APPEND TORD.
  ENDLOOP.

*- add check for GRN
  IF TORD[] IS INITIAL.
    MESSAGE I000(0K) WITH 'No Row Selected..!'.
    EXIT.
  ENDIF.

  LOOP AT IT_LABEL WHERE MARKED = 'X'.
    TORD-SIGN   = ''.
    SELECT  MBLNR INTO IT_LABEL-VALUE FROM MSEG WHERE CHARG = IT_LABEL-VALUE AND BWART = '101'.
      TORD-SIGN   = 'X'.
      SELECT SINGLE MBLNR INTO IT_LABEL-VALUE FROM MSEG WHERE SMBLN = IT_LABEL-VALUE.
      IF SY-SUBRC EQ 0.
        TORD-SIGN   = ''.
      ELSE.
        EXIT.
      ENDIF.
    ENDSELECT.

    IF TORD-SIGN   = ''.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF TORD-SIGN   = 'X'.
    SUBMIT ZMMR_LABELROL WITH P_CHARG IN TORD
                         WITH V_COPIES = VSIGN-VALUE AND RETURN.
  ELSE.
    MESSAGE I000(0K) WITH 'Belum ada GRN....!'.
  ENDIF.
*- end of check for GRN

ENDFORM.                    "print_label


*&---------------------------------------------------------------------*
*&      Form  check_status
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM CHECK_STATUS.
  DATA: V_OBJNR LIKE JEST-OBJNR,
        V_ORI LIKE AFPO-MILL_OC_AUFNR_U.
  SELECT MILL_OC_AUFNR_U INTO V_ORI FROM AFPO WHERE AUFNR = COM_ORDER.
    CONCATENATE 'OR' V_ORI INTO V_OBJNR.

    SELECT SINGLE * INTO *JEST
       FROM JEST
      WHERE OBJNR = V_OBJNR  AND INACT = '' AND ( STAT  = 'I0046' OR  STAT  = 'I0056' ).
    IF SY-SUBRC = 0.
      FLAG = 'X'.
      MESSAGE 'Status sudah Variances calculated, tidak bisa dibatalkan.' TYPE 'I'.
      EXIT.
    ENDIF.

  ENDSELECT.

  READ TABLE V_BASIC WITH KEY AUFNR = COM_ORDER ZSTAT = 'CLSD'.
  IF SY-SUBRC = 0.
    FLAG = 'X'.
    MESSAGE 'Order sudah di Closed, tidak bisa dibatalkan.' TYPE 'I'.
    EXIT.
  ENDIF.
ENDFORM.                    "check_status