REPORT ZTNCR.
DATA: LS TYPE ZLOG_BARRIER, LT TYPE TABLE OF ZLOG_BARRIER.
DATA: LV_M TYPE MATNR VALUE 'ZTEST_NCR'.
DATA: LV_C TYPE CHARG_D VALUE 'ZTNCR00001'.
DATA: LV_J(5) VALUE 'NCR', LV_P(5) VALUE 'PASS'.
DATA: LV_BL TYPE LABST, LV_N(15), LV_S(4), LV_T TYPE STRING.
FIELD-SYMBOLS: <ITAB> TYPE ANY, <F> TYPE ANY.
DEFINE DUMP_ROWS.
  SELECT * FROM ZLOG_BARRIER INTO TABLE LT
    WHERE MATNR = LV_M AND CHARG = LV_C ORDER BY VERSION.
  WRITE: / &1.
  LOOP AT LT INTO LS.
    WRITE: / '  V', LS-VERSION, LS-JUDGEMENT, LS-NCRAPPROVAL,
             'SHIP=', LS-CANBESHIP, 'DEL=', LS-DELETION.
  ENDLOOP.
END-OF-DEFINITION.
DELETE FROM ZLOG_BARRIER WHERE MATNR = LV_M AND CHARG = LV_C.
COMMIT WORK AND WAIT.
CLEAR LS.
LS-MATNR = LV_M. LS-CHARG = LV_C.
LS-VERSION = '000001'. LS-JUDGEMENT = 'NCR'. LS-CANBESHIP = 'X'.
LS-CPUDT = SY-DATUM. LS-USNAM = 'ZTEST'.
INSERT ZLOG_BARRIER FROM LS. COMMIT WORK AND WAIT.
DUMP_ROWS 'S0 SEED V1 NCR BELUM APPROVED'.
PERFORM INSERT_JUDGEMENT IN PROGRAM ZQMI_BARRIER_PASS_FAIL
  USING LV_M LV_C LV_J.
DUMP_ROWS 'S1 INSERT_JUDGEMENT NCR (BELUM APPROVED)'.
UPDATE ZLOG_BARRIER SET NCRAPPROVAL = 'Approved' CANBESHIP = 'O'
  WHERE MATNR = LV_M AND CHARG = LV_C AND DELETION = ''.
COMMIT WORK AND WAIT.
DUMP_ROWS 'S2 SET APPROVED (SEPERTI FORM APPROVAL)'.
PERFORM INSERT_JUDGEMENT IN PROGRAM ZQMI_BARRIER_PASS_FAIL
  USING LV_M LV_C LV_J.
DUMP_ROWS 'S3 INSERT_JUDGEMENT NCR SETELAH APPROVED'.
PERFORM INSERT_JUDGEMENT IN PROGRAM ZQMI_BARRIER_PASS_FAIL
  USING LV_M LV_C LV_P.
DUMP_ROWS 'S4 INSERT_JUDGEMENT PASS SETELAH APPROVED'.
ASSIGN ('(ZQMI_BARRIER_PASS_FAIL)ITAB') TO <ITAB>.
IF SY-SUBRC = 0.
  ASSIGN COMPONENT 'MATNR' OF STRUCTURE <ITAB> TO <F>. <F> = LV_M.
  ASSIGN COMPONENT 'CHARG' OF STRUCTURE <ITAB> TO <F>. <F> = LV_C.
  LV_N = 'Approved'.
  PERFORM GET_SHIPMENT IN PROGRAM ZQMI_BARRIER_PASS_FAIL
    USING LV_BL LV_J LV_N CHANGING LV_S.
  WRITE: / 'GET_SHIPMENT CAN_BE_SHIP HASIL=', LV_S.
  DUMP_ROWS 'S5 GET_SHIPMENT (HANYA CANBESHIP BOLEH BERUBAH)'.
ELSE.
  WRITE: / 'S5 SKIP: ITAB TIDAK BISA DI-ASSIGN'.
ENDIF.
DELETE FROM ZLOG_BARRIER WHERE MATNR = LV_M AND CHARG = LV_C.
COMMIT WORK AND WAIT.
DUMP_ROWS 'CLEANUP (HARUS KOSONG)'.
