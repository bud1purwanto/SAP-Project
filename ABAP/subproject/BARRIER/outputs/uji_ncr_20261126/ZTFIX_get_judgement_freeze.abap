REPORT ZTFIX.
DATA: LS TYPE ZLOG_BARRIER.
DATA: LV_M TYPE MATNR VALUE 'ZTEST_NCR'.
DATA: LV_C TYPE CHARG_D VALUE 'ZTNCR00002'.
DATA: LV_R(14) VALUE '20261125132232'.
DATA: LV_CC(14) VALUE '20261125132232'.
DATA: LV_L(14) VALUE '20261125164321'.
DATA: LV_J(10), LV_N(15), LV_S(4), LV_D(14).
DEFINE RUN.
  CLEAR: LV_J, LV_N, LV_S, LV_D.
  PERFORM GET_JUDGEMENT IN PROGRAM ZQMI_BARRIER_PASS_FAIL
    USING LV_M LV_C LV_R LV_CC LV_L
    CHANGING LV_J LV_N LV_S LV_D.
  WRITE: / &1, 'JUDG=', LV_J, 'NCR=', LV_N, 'SHIP=', LV_S.
END-OF-DEFINITION.
DELETE FROM ZLOG_BARRIER WHERE MATNR = LV_M AND CHARG = LV_C.
COMMIT WORK AND WAIT.
CLEAR LS.
LS-MATNR = LV_M. LS-CHARG = LV_C. LS-VERSION = '000001'.
LS-JUDGEMENT = 'NCR'. LS-CANBESHIP = 'O'.
LS-CPUDT = '20261125'. LS-CPUTM = '133150'. LS-USNAM = 'ZTEST'.
INSERT ZLOG_BARRIER FROM LS. COMMIT WORK AND WAIT.
RUN 'T1 BELUM APPROVED, UD L LEBIH BARU (HARUS KOSONG)'.
UPDATE ZLOG_BARRIER SET NCRAPPROVAL = 'Approved'
  WHERE MATNR = LV_M AND CHARG = LV_C.
COMMIT WORK AND WAIT.
RUN 'T2 APPROVED, UD L LEBIH BARU (HARUS NCR APPROVED O)'.
DELETE FROM ZLOG_BARRIER WHERE MATNR = LV_M AND CHARG = LV_C.
COMMIT WORK AND WAIT.
SELECT COUNT(*) FROM ZLOG_BARRIER WHERE MATNR = LV_M.
WRITE: / 'SISA DUMMY:', SY-DBCNT.
