MODULE USER_COMMAND_2000 INPUT.
  CASE SY-UCOMM.
    WHEN 'BTN_CANCEL'.
      SET SCREEN 0.
      LEAVE SCREEN.
    WHEN 'BTN_SAVE'.
      PERFORM SET_APPROVAL.
      PERFORM APPROVAL.
      PERFORM REFRESH.
      PERFORM CHECK_ERROR.
      SET SCREEN 0.
  ENDCASE.
