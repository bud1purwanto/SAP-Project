*----------------------------------------------------------------------*
FORM COLLECT_DATA.
  READ TABLE ITAB WITH KEY BOX = 'X' ERR = ''.
  IF SY-SUBRC EQ 0.
    CALL SCREEN 2000 STARTING AT 20 01.
  ENDIF.
ENDFORM.                    "COLLECT_DATA

*&---------------------------------------------------------------------*
*&      Form  SET_UD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM SET_APPROVAL.
  IF ACCEPT EQ 'X'.
    READ TABLE IT_SHIPMENT WITH KEY TEXT5 = 'A'.
    IF SY-SUBRC EQ 0.
      V_NCR_APP = IT_SHIPMENT-TEXT3.
    ENDIF.
  ELSEIF REJECT EQ 'X'.
    READ TABLE IT_SHIPMENT WITH KEY TEXT5 = 'R'.
    IF SY-SUBRC EQ 0.
      V_NCR_APP = IT_SHIPMENT-TEXT3.
    ENDIF.
  ELSE.
    V_NCR_APP = ''.
  ENDIF.

  IT_COUNT_ROW[] = ITAB[].
  DELETE IT_COUNT_ROW WHERE BOX EQ '' OR ERR EQ 'X'.
  DESCRIBE TABLE IT_COUNT_ROW LINES V_TFILL.
ENDFORM.                    "SET_UD

*&---------------------------------------------------------------------*
*&      Form  APPROVAL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM APPROVAL.
  LOOP AT ITAB WHERE BOX EQ 'X' AND ERR EQ ''.
    CLEAR: WA_JUDGEMENT.

    SELECT * INTO CORRESPONDING FIELDS OF WA_JUDGEMENT
      FROM ZLOG_BARRIER
     WHERE MATNR    EQ ITAB-MATNR
       AND CHARG    EQ ITAB-CHARG
       AND DELETION EQ ''.
    ENDSELECT.

    IF SY-SUBRC EQ 0.
      WA_JUDGEMENT-NCRAPPROVAL  = V_NCR_APP.
      WA_JUDGEMENT-AEDAT        = SY-DATUM.
      WA_JUDGEMENT-PSOTM        = SY-UZEIT.
      WA_JUDGEMENT-AENAM        = SY-UNAME.

      CALL FUNCTION 'TERMINAL_ID_GET'
        EXPORTING
          USERNAME             = SY-UNAME
        IMPORTING
          TERMINAL             = WA_JUDGEMENT-TERM2
        EXCEPTIONS
          MULTIPLE_TERMINAL_ID = 1
          NO_TERMINAL_FOUND    = 2
          OTHERS               = 3.

      IF SY-SUBRC NE 0.
        WA_JUDGEMENT-TERM2 = V_TERMINAL_JOB.
      ENDIF.

      MODIFY ZLOG_BARRIER FROM WA_JUDGEMENT.
      COMMIT WORK AND WAIT.

      ITAB-NCR_APPROVAL  = V_NCR_APP.
    ELSE.
      ITAB-MESS = 'Inspection not yet 4 times '.
    ENDIF.

    MODIFY ITAB.
    CLEAR ITAB.
  ENDLOOP.
ENDFORM.                    "APPROVAL

*&---------------------------------------------------------------------
*&      Form  F_GUI_STATUS
*&---------------------------------------------------------------------
FORM F_GUI_STATUS_PREVIEW USING FT_EXTAB TYPE SLIS_T_EXTAB.
  DATA: LT_FCODE TYPE TABLE OF SY-UCOMM.

  APPEND 'EXEC' TO LT_FCODE.
  APPEND 'XLSX' TO LT_FCODE.

  IF MODE EQ 'PASS_FAIL'.
    SET PF-STATUS 'PASS_FAIL' EXCLUDING LT_FCODE.
    SET TITLEBAR  'PASS_FAIL'.
  ELSEIF MODE EQ 'NCR_REPORT'.
    SET PF-STATUS 'PASS_FAIL' EXCLUDING 'REFRESH'.
    SET TITLEBAR  'NCR_APPROVAL'.
  ELSE.
    SET PF-STATUS 'PASS_FAIL' EXCLUDING 'REFRESH'.
    SET TITLEBAR  'NCR_UPLOAD'.
  ENDIF.
ENDFORM.                    " F_ALV_STATUS

