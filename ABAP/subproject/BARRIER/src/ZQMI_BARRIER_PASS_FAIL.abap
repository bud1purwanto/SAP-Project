         READ TABLE IT_SR_CG INTO WA_SR_CG WITH KEY  NCHARG = V_TEMP_CHARG.
         IF SY-SUBRC NE 0.
            EXIT.
         ENDIF.

         V_TEMP_MATNR = WA_SR_CG-MATNR.
         V_TEMP_CHARG = WA_SR_CG-CHARG.

         LV_LIMIT_CG = LV_LIMIT_CG + 1.

         IF LV_LIMIT_CG > LINES( IT_SR_CG ).
            EXIT.
         ENDIF.

     ENDDO.

*    READ TABLE IT_SR_CG WITH KEY NCHARG = CHARG.
*    IF SY-SUBRC EQ 0.
*      V_TEMP_MATNR = IT_SR_CG-MATNR.
*      V_TEMP_CHARG = IT_SR_CG-CHARG.
*    ELSE.
*      V_TEMP_MATNR = MATNR.
*      V_TEMP_CHARG = CHARG.
*    ENDIF.
  ENDIF.

  "Check Barrier
  V_NAME+0(10)    = V_TEMP_MATNR.
  V_NAME+22(10)   = V_TEMP_CHARG.

  THEAD-TDID      = 'VERM'.
  THEAD-TDSPRAS   = SY-LANGU.
  THEAD-TDNAME    = V_NAME.
  THEAD-TDOBJECT  = 'CHARGE'.

  CALL FUNCTION 'READ_TEXT'
    EXPORTING
      CLIENT                  = SY-MANDT
      ID                      = THEAD-TDID
      LANGUAGE                = THEAD-TDSPRAS
      NAME                    = THEAD-TDNAME
      OBJECT                  = THEAD-TDOBJECT
    TABLES
      LINES                   = TLINE
    EXCEPTIONS
      ID                      = 1
      LANGUAGE                = 2
      NAME                    = 3
      NOT_FOUND               = 4
      OBJECT                  = 5
      REFERENCE_CHECK         = 6
      WRONG_ACCESS_TO_ARCHIVE = 7
      OTHERS                  = 8.

  READ TABLE TLINE INDEX 1.
  IF SY-SUBRC EQ 0.
