      IF SCREEN-GROUP1 = 'B2' OR SCREEN-GROUP1 = 'B2' OR SCREEN-GROUP1 = 'B2'.
        SCREEN-INPUT  = 0.
        SCREEN-ACTIVE = 0.
        MODIFY SCREEN.
      ELSEIF SCREEN-GROUP1 = 'B3'.
        SCREEN-INPUT  = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ELSE.
*    LOOP AT SCREEN.
*      IF SCREEN-GROUP1 = 'B4'.
*        SCREEN-INPUT  = 0.
*        SCREEN-ACTIVE = 0.
*        MODIFY SCREEN.
*      ENDIF.
*    ENDLOOP.
  ENDIF.

  IF MODE EQ 'PASS_FAIL'.
    SET TITLEBAR  'PASS_FAIL'.
  ELSEIF MODE EQ 'NCR_REPORT'.
    SET TITLEBAR  'NCR_APPROVAL'.
  ELSE.
    SET TITLEBAR  'NCR_UPLOAD'.
  ENDIF.

START-OF-SELECTION.
  PERFORM VALIDATION.
  PERFORM GET_DATA.

  IF BACK EQ ''.
    PERFORM DISPLAY_ALV.
  ENDIF.

END-OF-SELECTION.

*&---------------------------------------------------------------------*
*&      Form  VALIDATION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM VALIDATION.
  IF S_BUDAT[] IS INITIAL.
    MESSAGE 'Please fill the parameters!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  IF S_WERKS IS INITIAL.
    MESSAGE 'Please fill plant!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_CUT_OVER
      FROM ZMAP_TYPE
     WHERE TCODE    EQ SY-TCODE
       AND TYPE     EQ 'BARRIER'
       AND OPT      EQ 'CUT OVER'
       AND DELETION EQ ''.

  IF IT_CUT_OVER[] IS INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_CUT_OVER
      FROM ZMAP_TYPE
     WHERE PROG     EQ SY-CPROG
       AND TYPE     EQ 'BARRIER'
       AND OPT      EQ 'CUT OVER'
       AND DELETION EQ ''.
  ENDIF.

  IF IT_CUT_OVER[] IS NOT INITIAL AND BACK IS INITIAL.
    READ TABLE IT_CUT_OVER INDEX 1.
    IF SY-SUBRC EQ 0.
      LOOP AT S_BUDAT.
        PERFORM CONVERT_DATE_INPUT USING IT_CUT_OVER-VALUE CHANGING IT_CUT_OVER-VALUE.
        IF S_BUDAT-LOW LT IT_CUT_OVER-VALUE.
          MESSAGE IT_CUT_OVER-TEXT5 TYPE 'S' DISPLAY LIKE 'E'.
          LEAVE LIST-PROCESSING.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.
ENDFORM.                    "VALIDATION

*&---------------------------------------------------------------------*
*&      Form  GET_PARAM
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_PARAM.
  REFRESH: IT_RANK, R_DESC.
  CLEAR: IT_RANK, R_DESC.

  SELECT
      VALUE AS VCODE
      TEXT1 AS VALUATION
      TEXT2 AS ALIAS
      TEXT3 AS COLOR
      INTO CORRESPONDING FIELDS OF TABLE IT_RANK
      FROM ZMAP_TYPE
     WHERE TCODE    EQ SY-TCODE
       AND TYPE     EQ 'BARRIER'
       AND OPT      EQ 'JUDGEMENT'
       AND DELETION EQ ''.

  IF IT_RANK[] IS INITIAL.
    SELECT
      VALUE AS VCODE
      TEXT1 AS VALUATION
      TEXT2 AS ALIAS
      TEXT3 AS COLOR
      INTO CORRESPONDING FIELDS OF TABLE IT_RANK
      FROM ZMAP_TYPE
     WHERE PROG     EQ SY-CPROG
       AND TYPE     EQ 'BARRIER'
       AND OPT      EQ 'JUDGEMENT'
       AND DELETION EQ ''.
  ENDIF.

  IF IT_RANK[] IS INITIAL.
    MESSAGE 'Mapping Barrier Judgement not found!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  IF P_PAS EQ 'X'.
    R_STATUS-LOW = V_PASS.
    APPEND R_STATUS.

    READ TABLE IT_RANK WITH KEY VCODE = R_STATUS-LOW.
    IF SY-SUBRC EQ 0 AND IT_RANK-ALIAS IS NOT INITIAL.
      R_STATUS-LOW = IT_RANK-ALIAS.
      APPEND R_STATUS.
    ENDIF.
  ENDIF.

  IF P_FAIL EQ 'X'.
    R_STATUS-LOW = V_FAIL.
    APPEND R_STATUS.

    READ TABLE IT_RANK WITH KEY VCODE = R_STATUS-LOW.
    IF SY-SUBRC EQ 0 AND IT_RANK-ALIAS IS NOT INITIAL.
      R_STATUS-LOW = IT_RANK-ALIAS.
      APPEND R_STATUS.
    ENDIF.
  ENDIF.

  IF P_NCR EQ 'X'.
    R_STATUS-LOW = V_NCR.
    APPEND R_STATUS.

    READ TABLE IT_RANK WITH KEY VCODE = R_STATUS-LOW.
    IF SY-SUBRC EQ 0 AND IT_RANK-ALIAS IS NOT INITIAL.
      R_STATUS-LOW = IT_RANK-ALIAS.
      APPEND R_STATUS.
    ENDIF.
  ENDIF.

  IF P_NOT EQ 'X'.
    R_STATUS-LOW = V_NOT.
    APPEND R_STATUS.

    READ TABLE IT_RANK WITH KEY VCODE = R_STATUS-LOW.
    IF SY-SUBRC EQ 0 AND IT_RANK-ALIAS IS NOT INITIAL.
      R_STATUS-LOW = IT_RANK-ALIAS.
      APPEND R_STATUS.
    ENDIF.
  ENDIF.

  IF R_STATUS[] IS NOT INITIAL.
    R_STATUS-SIGN   = 'I'.
    R_STATUS-OPTION = 'EQ'.
    MODIFY R_STATUS TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  CLEAR: IT_SHIPMENT.
  REFRESH: IT_SHIPMENT.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_SHIPMENT
    FROM ZMAP_TYPE
   WHERE TCODE    EQ SY-TCODE
     AND TYPE     EQ 'BARRIER'
     AND OPT      EQ 'SHIPMENT'
     AND DELETION EQ ''.

  IF IT_SHIPMENT[] IS INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_SHIPMENT
      FROM ZMAP_TYPE
     WHERE PROG   EQ SY-CPROG
       AND TYPE   EQ 'BARRIER'
       AND OPT    EQ 'SHIPMENT'
       AND DELETION EQ ''.
  ENDIF.

  IF IT_SHIPMENT[] IS INITIAL.
    MESSAGE 'Mapping can be ship not found!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_EST_DATE
    FROM ZMAP_TYPE
   WHERE TYPE   EQ 'BARRIER'
     AND OPT    EQ 'ESTDATE'
     AND DELETION EQ ''.

  IF IT_EST_DATE[] IS INITIAL.
    MESSAGE 'Mapping estimation date not found!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_CABN FROM CABN WHERE ATNAM LIKE 'ZZ%'.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTYPE'.
  IF SY-SUBRC EQ 0.
    V_ZZTYPE = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTHICKNESS'.
  IF SY-SUBRC EQ 0.
    V_ZZTHICKNESS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZWIDTH'.
  IF SY-SUBRC EQ 0.
    V_ZZWIDTH = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZLENGTH'.
  IF SY-SUBRC EQ 0.
    V_ZZLENGTH = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZNOMORROLL'.
  IF SY-SUBRC EQ 0.
    V_ZZNOMORROLL = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZDERIVATIVESS'.
  IF SY-SUBRC EQ 0.
    V_ZZDERIVATIVESS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZDERIVATIVEMS'.
  IF SY-SUBRC EQ 0.
    V_ZZDERIVATIVEMS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZPOSITIONSS'.
  IF SY-SUBRC EQ 0.
    V_ZZPOSITIONSS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZPOSITIONMS'.
  IF SY-SUBRC EQ 0.
    V_ZZPOSITIONMS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTYBCOMBINATIONNO'.
  IF SY-SUBRC EQ 0.
    V_ZZTYBCOMBINATIONNO = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZGRADE'.
  IF SY-SUBRC EQ 0.
    V_ZZGRADE = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTAILORED'.
  IF SY-SUBRC EQ 0.
    V_ZZTAILORED = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZALIAS'.
  IF SY-SUBRC EQ 0.
    V_ZZALIAS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZLABEL'.
  IF SY-SUBRC EQ 0.
    V_ZZLABEL = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZSPECIALTOUCH-1'.
  IF SY-SUBRC EQ 0.
    V_ZZSPECIALTOUCH-1 = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZNOROLLTOYOBO'.
  IF SY-SUBRC EQ 0.
    V_ZZNOROLLTOYOBO = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZNOLOTTOYOBO'.
  IF SY-SUBRC EQ 0.
    V_ZZNOLOTTOYOBO = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZNOROLLTOYOBO2'.
  IF SY-SUBRC EQ 0.
    V_ZZNOROLLTOYOBO2 = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZEXPIREDLIVE'.
  IF SY-SUBRC EQ 0.
    V_ZZEXPIREDLIVE = IT_CABN-ATINN.
  ENDIF.

  " Atwtb
  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZCRITERIA'.
  IF SY-SUBRC EQ 0.
    V_ZZCRITERIA = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZPACKING'.
  IF SY-SUBRC EQ 0.
    V_ZZPACKING = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTREATMENT'.
  IF SY-SUBRC EQ 0.
    V_ZZTREATMENT = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZCORE'.
  IF SY-SUBRC EQ 0.
    V_ZZCORE = IT_CABN-ATINN.
  ENDIF.

  R_DESC-LOW = V_ZZCRITERIA.
  APPEND R_DESC.

  R_DESC-LOW = V_ZZPACKING.
  APPEND R_DESC.

  R_DESC-LOW = V_ZZTREATMENT.
  APPEND R_DESC.

  R_DESC-LOW = V_ZZCORE.
  APPEND R_DESC.

  IF R_DESC[] IS NOT INITIAL.
    R_DESC-SIGN   = 'I'.
    R_DESC-OPTION = 'EQ'.
    MODIFY R_DESC TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  R_BWART-LOW = 101.
  APPEND R_BWART.

  R_BWART-LOW = 102.
  APPEND R_BWART.

  IF BACK EQ 'X'.
    R_BWART-LOW = 701.
    APPEND R_BWART.

    R_BWART-LOW = 702.
    APPEND R_BWART.
  ENDIF.

  IF R_BWART[] IS NOT INITIAL.
    R_BWART-SIGN = 'I'.
    R_BWART-OPTION = 'EQ'.
    MODIFY R_BWART TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.
ENDFORM.                    "GET_PARAM

*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA.
  REFRESH: ITAB, IT_CHECK_CANC, IT_CHAR, IT_CHAR_DESC, IT_AUSP, IT_INSP_PLAN, IT_STORE_EXIM.
  CLEAR: ITAB, IT_CHECK_CANC, IT_CHAR, IT_CHAR_DESC, IT_AUSP, IT_INSP_PLAN, IT_STORE_EXIM.

  PERFORM GET_PARAM.

  IF S_CHARG[] IS NOT INITIAL.
    R_CHARG[] = S_CHARG[].
  ENDIF.

  IF S_NOROL[] IS NOT INITIAL.
    SELECT ATWRT OBJEK INTO CORRESPONDING FIELDS OF TABLE IT_AUSP
      FROM AUSP
     WHERE AUSP~ATWRT IN S_NOROL
        AND AUSP~KLART EQ '023'
        AND AUSP~MAFID EQ 'O'
        AND AUSP~ATINN EQ V_ZZNOMORROLL %_HINTS ORACLE 'INDEX("AUSP" "AUSP~N1")'.

    IF IT_AUSP[] IS NOT INITIAL.
      LOOP AT IT_AUSP.
        IT_AUSP-CUOBJ = IT_AUSP-OBJEK.
        MODIFY IT_AUSP.
        CLEAR IT_AUSP.
      ENDLOOP.

      SELECT CHARG AS LOW APPENDING CORRESPONDING FIELDS OF TABLE R_CHARG
        FROM MCH1
         FOR ALL ENTRIES IN IT_AUSP
       WHERE CUOBJ_BM EQ IT_AUSP-CUOBJ
         AND FVDT1    EQ '00000000'
         AND CHARG    IN R_CHARG %_HINTS  ORACLE 'INDEX("MCH1" "MCH1~Z06")'.
    ELSE.
      SY-SUBRC = 4.
    ENDIF.

    IF SY-SUBRC EQ 0.
      R_CHARG-SIGN   = 'I'.
      R_CHARG-OPTION = 'EQ'.
      MODIFY R_CHARG TRANSPORTING SIGN OPTION WHERE SIGN IS INITIAL.
    ELSE.
      CLEAR: R_CHARG.
      REFRESH: R_CHARG.
      R_CHARG-LOW     = 'XXXXXXXXXX'.
      R_CHARG-SIGN   = 'I'.
      R_CHARG-OPTION = 'EQ'.
      APPEND R_CHARG.
    ENDIF.
  ENDIF.

  PERFORM SET_INDICATOR USING 1 1 1 V_PROC_EX 'Getting Material Data...'.

  R_WERKS-LOW     = S_WERKS-LOW.
  R_WERKS-SIGN    = 'I'.
  R_WERKS-OPTION  = 'EQ'.
  APPEND R_WERKS.

  SELECT MARA~MATNR AS LOW INTO CORRESPONDING FIELDS OF TABLE R_MATNR
    FROM MARA
    JOIN MARC ON MARC~MATNR EQ MARA~MATNR
   WHERE MARC~WERKS IN S_WERKS
     AND MARA~MATNR IN S_MATNR
     AND MARA~MATKL LIKE '3%'.

  IF R_MATNR[] IS NOT INITIAL.
    R_MATNR-SIGN    = 'I'.
    R_MATNR-OPTION  = 'EQ'.
    MODIFY R_MATNR TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  IF R_MATNR[] IS INITIAL.
    IF BACK EQ ''.
      MESSAGE 'Data not found!' TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.
    LEAVE LIST-PROCESSING.
  ENDIF.

  PERFORM SET_INDICATOR USING 1 1 2 V_PROC_EX 'Getting Slit Roll Data...'.

  "Get Preview
  SELECT
    MSEG~MATNR
    MSEG~WERKS
    MSEG~LGORT
    MSEG~CHARG
    MSEG~MBLNR
    MSEG~SMBLN
    MSEG~MJAHR
    MSEG~SJAHR
    MSEG~ZEILE
    MSEG~SMBLP
    MSEG~BWART
    MSEG~WERKS
    MSEG~MENGE AS QTY
    MKPF~BUDAT AS PROD_DATE
    INTO CORRESPONDING FIELDS OF TABLE ITAB
    FROM MKPF
    JOIN MSEG ON MSEG~MBLNR EQ MKPF~MBLNR AND MSEG~MJAHR EQ MKPF~MJAHR
   WHERE MKPF~BUDAT IN S_BUDAT
     AND MSEG~WERKS IN S_WERKS
     AND MSEG~CHARG IN R_CHARG
     AND MSEG~BWART IN R_BWART.

  DELETE ITAB WHERE MATNR NOT IN R_MATNR.

  IT_CHECK_CANC[] = ITAB[].
  "Delete Cancel
  DELETE IT_CHECK_CANC WHERE SMBLN IS INITIAL.
  LOOP AT IT_CHECK_CANC.
    PERFORM SET_INDICATOR USING SY-TABIX SY-TFILL 3 V_PROC_EX 'Getting Cancelled Data...'.
    DELETE ITAB WHERE MBLNR EQ IT_CHECK_CANC-SMBLN AND MJAHR EQ IT_CHECK_CANC-SJAHR AND ZEILE EQ IT_CHECK_CANC-SMBLP.
  ENDLOOP.
  DELETE ITAB WHERE SMBLN IS NOT INITIAL OR BWART EQ 102.

  IF ITAB[] IS INITIAL.
    IF BACK EQ ''.
      MESSAGE 'Data not found!' TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.
    LEAVE LIST-PROCESSING.
  ENDIF.

  PERFORM SET_INDICATOR USING 1 1 4 V_PROC_EX 'Getting Characteristic Data...'.

  CLEAR:IT_MBLNR.
  REFRESH:IT_MBLNR.

  IF ITAB[] IS NOT INITIAL.
    "Subcont Condition. Added by Fany(01.10.2026)
    SELECT AUFNR MSEG~MBLNR MSEG~MJAHR ZEILE CPUDT_MKPF CPUTM_MKPF SMBLN SJAHR SMBLP BWART LIFNR MATNR CHARG MENGE BUDAT_MKPF BKTXT
            INTO CORRESPONDING FIELDS OF TABLE IT_MBLNR
          FROM MSEG
          JOIN MKPF ON MSEG~MBLNR = MKPF~MBLNR
       FOR ALL ENTRIES IN ITAB
          WHERE BWART IN ('543','541')
          AND MATNR EQ ITAB-MATNR
          AND CHARG EQ ITAB-CHARG %_HINTS  ORACLE 'INDEX("MSEG" "MSEG~Z07")'.

    SORT IT_MBLNR BY MATNR CHARG.
    DELETE ADJACENT DUPLICATES FROM IT_MBLNR COMPARING MATNR CHARG.

    IF IT_MBLNR[] IS NOT INITIAL.
        LOOP AT ITAB.
          READ TABLE IT_MBLNR WITH KEY CHARG = ITAB-CHARG.
          IF SY-SUBRC EQ 0.
            DELETE ITAB.
          ENDIF.
        ENDLOOP.
    ENDIF.
  ENDIF.


  IT_TEMP_INS_C[] = ITAB[].
  SORT IT_TEMP_INS_C BY MATNR.
  DELETE ADJACENT DUPLICATES FROM IT_TEMP_INS_C COMPARING MATNR.

  LOOP AT IT_TEMP_INS_C.
    V_CODEWVTR = 'S' && IT_TEMP_INS_C-MATNR+2(3) && 'WVTR'.
    V_CODEOTR  = 'S' && IT_TEMP_INS_C-MATNR+2(3) && 'OTR'.

    SELECT
      MAPL~MATNR
      MERKNR
      VERWMERKM
      MKVERSION
      STPRUMF
      QPMK_ZAEHL AS ZAEHLER
      VERWMERKM  AS MKMNR
      KURZTEXT   AS SORTFELD
      SOLLWERT
      TOLERANZOB
      TOLERANZUN
      DELKZ
    APPENDING CORRESPONDING FIELDS OF TABLE IT_INSP_PLAN
    FROM MAPL
    JOIN PLKO ON PLKO~PLNTY EQ MAPL~PLNTY AND PLKO~PLNNR EQ MAPL~PLNNR AND PLKO~PLNAL EQ MAPL~PLNAL
    JOIN PLMK ON PLKO~PLNTY EQ PLMK~PLNTY AND PLKO~PLNNR EQ PLMK~PLNNR AND PLKO~ZAEHL EQ PLMK~PLNKN
    JOIN QDSV ON PLMK~STICHPRVER EQ QDSV~STICHPRVER
   WHERE MAPL~WERKS     EQ IT_TEMP_INS_C-WERKS
     AND MAPL~MATNR     EQ IT_TEMP_INS_C-MATNR
     AND PLMK~VERWMERKM IN (V_CODEWVTR, V_CODEOTR)
     AND PLKO~KTEXT     LIKE '%After Slitting%'
     AND PLKO~DELKZ     NE 'X'.
  ENDLOOP.

  SELECT
    CHARG
    AUSP~ATINN
    AUSP~ATWRT
    AUSP~ATFLV
    INTO CORRESPONDING FIELDS OF TABLE IT_CHAR
    FROM MCH1
    JOIN AUSP  ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
     FOR ALL ENTRIES IN ITAB
   WHERE MATNR EQ ITAB-MATNR
     AND CHARG EQ ITAB-CHARG
     AND KLART EQ '023'
     AND AUSP~ATINN IN (V_ZZTYPE,
                  V_ZZTHICKNESS,
                  V_ZZWIDTH,
                  V_ZZLENGTH,
                  V_ZZNOMORROLL,
                  V_ZZDERIVATIVESS,
                  V_ZZDERIVATIVEMS,
                  V_ZZPOSITIONSS,
                  V_ZZPOSITIONMS,
                  V_ZZTYBCOMBINATIONNO,
                  V_ZZGRADE,
                  V_ZZTAILORED,
                  V_ZZALIAS,
                  V_ZZLABEL,
                  V_ZZSPECIALTOUCH-1,
                  V_ZZNOROLLTOYOBO,
                  V_ZZNOLOTTOYOBO,
                  V_ZZNOROLLTOYOBO2,
                  V_ZZEXPIREDLIVE,
                  V_ZZCRITERIA,
                  V_ZZPACKING,
                  V_ZZTREATMENT,
                  V_ZZCORE).

  IT_CHAR_DESC[] = IT_CHAR[].
  DELETE IT_CHAR_DESC WHERE ATINN NOT IN R_DESC.
  SORT IT_CHAR_DESC BY ATINN ATWRT.
  DELETE ADJACENT DUPLICATES FROM IT_CHAR_DESC COMPARING ATINN ATWRT.
  DELETE IT_CHAR_DESC WHERE ATWRT IS INITIAL.

  LOOP AT IT_CHAR_DESC.
    PERFORM SET_INDICATOR USING SY-TABIX SY-TFILL 5 V_PROC_EX 'Collecting Characteristic Data...'.

    SELECT SINGLE CAWNT~ATWTB INTO IT_CHAR_DESC-ATWTB
      FROM CAWN
      JOIN CAWNT ON CAWN~ATINN  EQ CAWNT~ATINN AND CAWN~ATZHL EQ CAWNT~ATZHL
     WHERE CAWN~ATINN  EQ IT_CHAR_DESC-ATINN
       AND CAWN~ATWRT  EQ IT_CHAR_DESC-ATWRT
       AND CAWNT~SPRAS EQ 'E'.

    MODIFY IT_CHAR_DESC.
    CLEAR IT_CHAR_DESC.
  ENDLOOP.

  DESCRIBE TABLE ITAB LINES V_TFILL.

  "Get batch change grade.     Added by Fany (22.07.2026)
  CLEAR : IT_SR_CG.
  REFRESH : IT_SR_CG.
  IF ITAB[] IS NOT INITIAL.
    SELECT * FROM ZBATCHISTORY
      INTO CORRESPONDING FIELDS OF TABLE IT_SR_CG
      FOR ALL ENTRIES IN ITAB
      WHERE NCHARG = ITAB-CHARG.

      IF IT_SR_CG[] IS NOT INITIAL.
        DATA : LV_ID_CG TYPE I VALUE 1.
        DATA : WA_SR_CG LIKE LINE OF IT_SR_CG.

        WHILE LV_ID_CG <= LINES( IT_SR_CG ).
            CLEAR : WA_SR_CG.
            READ TABLE IT_SR_CG INDEX LV_ID_CG.
            SELECT SINGLE * FROM ZBATCHISTORY INTO WA_SR_CG WHERE NCHARG = IT_SR_CG-CHARG.
            IF SY-SUBRC EQ 0.
                READ TABLE IT_SR_CG WITH KEY NCHARG = WA_SR_CG-NCHARG.
                IF SY-SUBRC NE 0.
                  APPEND WA_SR_CG TO IT_SR_CG.
                ENDIF.
            ENDIF.
            LV_ID_CG = LV_ID_CG + 1 .
        ENDWHILE.
      ENDIF.
  ENDIF.

  LOOP AT ITAB.
    REFRESH: IT_RANK_FINAL.
    CLEAR: IT_RANK_FINAL.

    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 6 V_PROC_EX 'Calculating Judgement Data...'.

    "Check inspection plan
    IF BACK EQ ''.
      READ TABLE IT_INSP_PLAN WITH KEY MATNR = ITAB-MATNR.
      IF SY-SUBRC NE 0.
        DELETE ITAB.
        CONTINUE.
      ENDIF.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTYPE.
    IF SY-SUBRC EQ 0.
      ITAB-TYPE = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTHICKNESS.
    IF SY-SUBRC EQ 0.
      ITAB-THICKNESS = IT_CHAR-ATFLV.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZWIDTH.
    IF SY-SUBRC EQ 0.
      ITAB-WIDTH = IT_CHAR-ATFLV.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZLENGTH.
    IF SY-SUBRC EQ 0.
      ITAB-LENGTH = IT_CHAR-ATFLV.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZNOMORROLL.
    IF SY-SUBRC EQ 0.
      ITAB-ROLL_DERV = IT_CHAR-ATWRT.
    ENDIF.

    IF ITAB-TYPE NOT IN S_FTYPE.
      DELETE ITAB.
      CONTINUE.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZDERIVATIVESS.
    IF SY-SUBRC EQ 0.
      ITAB-DERIVITIVE_SS = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZDERIVATIVEMS.
    IF SY-SUBRC EQ 0.
      ITAB-DERIVITIVE = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZPOSITIONSS.
    IF SY-SUBRC EQ 0.
      ITAB-POSITION_SS = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZPOSITIONMS.
    IF SY-SUBRC EQ 0.
      ITAB-POSITION = IT_CHAR-ATWRT.
    ENDIF.

    PERFORM GET_STORAGE_BIN USING ITAB-MATNR ITAB-WERKS ITAB-CHARG CHANGING ITAB-LGPLA.
    PERFORM GET_HU USING ITAB-CHARG CHANGING ITAB-VENUM ITAB-EXIDV.
    PERFORM GET_SLOC USING ITAB-CHARG CHANGING ITAB-LGORT.
    PERFORM GET_STOCK USING ITAB-MATNR ITAB-WERKS ITAB-CHARG ITAB-LGORT CHANGING ITAB-UNREST_KG ITAB-UNREST_ROLL ITAB-QINSP_KG ITAB-QINSP_ROLL ITAB-BL_STOCK_KG ITAB-BL_SR ITAB-BL_REASON ITAB-BL_COMMENT.
    PERFORM GET_BATCH_JR USING ITAB-CHARG CHANGING ITAB-MATNR_JR ITAB-CHARG_JR.

    IF ITAB-CHARG_JR IS INITIAL.
      IF BACK EQ 'X'.
        MOVE-CORRESPONDING ITAB TO IT_STORE_EXIM.
        APPEND IT_STORE_EXIM.
        CLEAR IT_STORE_EXIM.
      ENDIF.

      DELETE ITAB.
      CONTINUE.
    ENDIF.

    PERFORM GET_UD USING ITAB-CHARG_JR ITAB-CHARG CHANGING ITAB-PRUEFLOS_R ITAB-PRUEFLOS_C ITAB-PRUEFLOS_L ITAB-BARRIER_R ITAB-BARRIER_C ITAB-BARRIER_L ITAB-DATETIME_R ITAB-DATETIME_C ITAB-DATETIME_L.
    PERFORM GET_BARRIER_POS USING ITAB-MATNR ITAB-CHARG CHANGING ITAB-BARRIER_POS.
    PERFORM GET_JUDGEMENT USING ITAB-MATNR ITAB-CHARG ITAB-DATETIME_R ITAB-DATETIME_C ITAB-DATETIME_L CHANGING ITAB-JUDGEMENT ITAB-NCR_APPROVAL ITAB-CAN_BE_SHIP ITAB-DATETIME_JUDG.

    IF ITAB-BARRIER_POS IS NOT INITIAL.
      PERFORM GET_APPROVAL USING ITAB-BARRIER_POS ITAB-PRUEFLOS_R ITAB-PRUEFLOS_C ITAB-PRUEFLOS_L CHANGING ITAB-ERR ITAB-ZSTAT ITAB-MESS.
    ENDIF.

    IF ITAB-BARRIER_POS IS INITIAL OR ITAB-JUDGEMENT IS INITIAL
    OR ( ITAB-DATETIME_JUDG LT ITAB-DATETIME_R OR ITAB-DATETIME_JUDG LT ITAB-DATETIME_C OR ITAB-DATETIME_JUDG LT ITAB-DATETIME_L )
    OR ( ITAB-PRUEFLOS_R IS INITIAL AND ITAB-PRUEFLOS_C IS INITIAL AND ITAB-PRUEFLOS_L IS INITIAL )
    AND ITAB-ERR IS INITIAL.

      CLEAR: ITAB-BARRIER_POS, ITAB-JUDGEMENT, V_R, V_C, V_L.

      "Get RCL
      CALL FUNCTION 'ZQM_GET_BARRIER_POS'
        EXPORTING
          MATNR_SR    = ITAB-MATNR
          CHARG_SR    = ITAB-CHARG
          MATNR_JR    = ITAB-MATNR_JR
          CHARG_JR    = ITAB-CHARG_JR
        IMPORTING
          BARRIER_POS = ITAB-BARRIER_POS
          R           = V_R
          C           = V_C
          L           = V_L
        TABLES
          IT_SR       = IT_SR_DATA
          IT_CABN     = IT_CABN.

      "Get Rank based on Position RCL
      IF V_R EQ 'X'.
        LOOP AT IT_RANK WHERE VCODE EQ ITAB-BARRIER_R.
          MOVE-CORRESPONDING IT_RANK TO IT_RANK_FINAL.
          APPEND IT_RANK_FINAL.
        ENDLOOP.
      ENDIF.

      IF V_C EQ 'X'.
        LOOP AT IT_RANK WHERE VCODE EQ ITAB-BARRIER_C.
          MOVE-CORRESPONDING IT_RANK TO IT_RANK_FINAL.
          APPEND IT_RANK_FINAL.
        ENDLOOP.
      ENDIF.

      IF V_L EQ 'X'.
        LOOP AT IT_RANK WHERE VCODE EQ ITAB-BARRIER_L.
          MOVE-CORRESPONDING IT_RANK TO IT_RANK_FINAL.
          APPEND IT_RANK_FINAL.
        ENDLOOP.
      ENDIF.

      "Ranking
      SORT IT_RANK_FINAL BY VALUATION DESCENDING.
      DELETE ADJACENT DUPLICATES FROM IT_RANK_FINAL COMPARING VALUATION.
      READ TABLE IT_RANK_FINAL INDEX 1.
      IF SY-SUBRC EQ 0.
        ITAB-JUDGEMENT = IT_RANK_FINAL-VCODE.

        IF IT_RANK_FINAL-ALIAS IS NOT INITIAL.
          ITAB-JUDGEMENT = IT_RANK_FINAL-ALIAS.
        ENDIF.
      ENDIF.

      PERFORM GET_WVTR_OTR USING ITAB-BARRIER_POS ITAB-PRUEFLOS_R ITAB-PRUEFLOS_C ITAB-PRUEFLOS_L ITAB-BARRIER_R ITAB-BARRIER_C ITAB-BARRIER_L
                        CHANGING ITAB-DEVICE ITAB-WVTR_R ITAB-OTR_R ITAB-TIMES_R ITAB-WVTR_C ITAB-OTR_C ITAB-TIMES_C ITAB-WVTR_L ITAB-OTR_L ITAB-TIMES_L ITAB-TIMES ITAB-TIMES_NOT_PAS.

      PERFORM GET_APPROVAL USING ITAB-BARRIER_POS ITAB-PRUEFLOS_R ITAB-PRUEFLOS_C ITAB-PRUEFLOS_L CHANGING ITAB-ERR ITAB-ZSTAT ITAB-MESS.

      IF ( ITAB-JUDGEMENT EQ V_PASS OR ITAB-JUDGEMENT EQ V_NCR OR ITAB-TIMES_NOT_PAS EQ 4 ) AND ITAB-ERR IS INITIAL.

        PERFORM INSERT_BARRIER_POS USING ITAB-MATNR ITAB-CHARG ITAB-BARRIER_POS.
        PERFORM INSERT_JUDGEMENT USING ITAB-MATNR ITAB-CHARG ITAB-JUDGEMENT.

      ENDIF.
    ENDIF.

    IF ITAB-TIMES_NOT_PAS IS INITIAL.
      PERFORM GET_WVTR_OTR USING ITAB-BARRIER_POS ITAB-PRUEFLOS_R ITAB-PRUEFLOS_C ITAB-PRUEFLOS_L ITAB-BARRIER_R ITAB-BARRIER_C ITAB-BARRIER_L
                        CHANGING ITAB-DEVICE ITAB-WVTR_R ITAB-OTR_R ITAB-TIMES_R ITAB-WVTR_C ITAB-OTR_C ITAB-TIMES_C ITAB-WVTR_L ITAB-OTR_L
                                 ITAB-TIMES_L ITAB-TIMES ITAB-TIMES_NOT_PAS.
    ENDIF.

    "Set Judgement
    IF ( ( ITAB-JUDGEMENT EQ V_SCRAP OR ITAB-JUDGEMENT EQ V_NOT OR ITAB-JUDGEMENT EQ '' ) AND ITAB-TIMES_NOT_PAS LT 4 ) OR ITAB-ERR IS NOT INITIAL.
      ITAB-JUDGEMENT = V_NOT.
    ENDIF.

    "Set Barrier R
    IF ( ITAB-BARRIER_R EQ V_FAIL OR ITAB-BARRIER_R EQ V_NOT OR ITAB-BARRIER_R EQ '' ) AND ITAB-TIMES_R NE 4 OR ITAB-ERR IS NOT INITIAL.
      ITAB-BARRIER_R = V_NOT.
    ENDIF.

    "Set Barrier C
    IF ( ITAB-BARRIER_C EQ V_FAIL OR ITAB-BARRIER_C EQ V_NOT OR ITAB-BARRIER_C EQ '' ) AND ITAB-TIMES_C NE 4 OR ITAB-ERR IS NOT INITIAL.
      ITAB-BARRIER_C = V_NOT.
    ENDIF.

    "Set Barrier L
    IF ( ITAB-BARRIER_L EQ V_FAIL OR ITAB-BARRIER_L EQ V_NOT OR ITAB-BARRIER_L EQ '' ) AND ITAB-TIMES_L NE 4 OR ITAB-ERR IS NOT INITIAL.
      ITAB-BARRIER_L = V_NOT.
    ENDIF.

    "Set Judgement
    IF ITAB-JUDGEMENT IS INITIAL.
      ITAB-JUDGEMENT = V_NOT.
    ENDIF.

    "Set Barrier R
    IF ITAB-BARRIER_R IS INITIAL.
      ITAB-BARRIER_R = V_NOT.
    ENDIF.

    "Set Barrier C
    IF ITAB-BARRIER_C IS INITIAL.
      ITAB-BARRIER_C = V_NOT.
    ENDIF.

    "Set Barrier L
    IF ITAB-BARRIER_L IS INITIAL.
      ITAB-BARRIER_L = V_NOT.
    ENDIF.

    IF ITAB-JUDGEMENT NOT IN R_STATUS.
      DELETE ITAB.
      CLEAR ITAB.
      CONTINUE.
    ENDIF.


    PERFORM GET_SHIPMENT USING ITAB-BL_STOCK_KG ITAB-JUDGEMENT ITAB-NCR_APPROVAL CHANGING ITAB-CAN_BE_SHIP.

    IF ITAB-JUDGEMENT EQ V_NOT.
      PERFORM GET_ESTIMATION_DATE USING ITAB-WERKS ITAB-BARRIER_POS ITAB-PRUEFLOS_R ITAB-PRUEFLOS_C ITAB-PRUEFLOS_L ITAB-TIMES_R ITAB-TIMES_C ITAB-TIMES_L
      CHANGING ITAB-NEXT_WVTR ITAB-NEXT_OTR.
    ENDIF.

    "Get Characteristic
    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTYBCOMBINATIONNO.
    IF SY-SUBRC EQ 0.
      ITAB-COMB_NO = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZGRADE.
    IF SY-SUBRC EQ 0.
      ITAB-GRADE = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTAILORED.
    IF SY-SUBRC EQ 0.
      ITAB-KATEGORI = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZALIAS.
    IF SY-SUBRC EQ 0.
      ITAB-ALIAS = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZLABEL.
    IF SY-SUBRC EQ 0.
      ITAB-TIPE_LABEL = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZSPECIALTOUCH-1.
    IF SY-SUBRC EQ 0.
      ITAB-SPECIAL_TOUCH = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZNOROLLTOYOBO.
    IF SY-SUBRC EQ 0.
      ITAB-NO_ROL_TOYOBO = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZNOLOTTOYOBO.
    IF SY-SUBRC EQ 0.
      ITAB-NO_LOT_TOYOBO = IT_CHAR-ATWRT.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZNOROLLTOYOBO2.
    IF SY-SUBRC EQ 0.
      ITAB-NO_ROL_MOS = IT_CHAR-ATWRT.
    ENDIF.

    "Get Description
    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZCRITERIA.
    IF SY-SUBRC EQ 0.
      READ TABLE IT_CHAR_DESC WITH KEY ATINN = V_ZZCRITERIA ATWRT = IT_CHAR-ATWRT.
      IF SY-SUBRC EQ 0.
        ITAB-CRITERIA = IT_CHAR_DESC-ATWTB.
      ENDIF.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZPACKING.
    IF SY-SUBRC EQ 0.
      READ TABLE IT_CHAR_DESC WITH KEY ATINN = V_ZZPACKING ATWRT = IT_CHAR-ATWRT.
      IF SY-SUBRC EQ 0.
        ITAB-PACKING = IT_CHAR_DESC-ATWTB.
      ENDIF.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZTREATMENT.
    IF SY-SUBRC EQ 0.
      READ TABLE IT_CHAR_DESC WITH KEY ATINN = V_ZZTREATMENT ATWRT = IT_CHAR-ATWRT.
      IF SY-SUBRC EQ 0.
        ITAB-TREATMENT = IT_CHAR_DESC-ATWTB.
      ENDIF.
    ENDIF.

    READ TABLE IT_CHAR WITH KEY CHARG = ITAB-CHARG ATINN = V_ZZCORE.
    IF SY-SUBRC EQ 0.
      READ TABLE IT_CHAR_DESC WITH KEY ATINN = V_ZZCORE ATWRT = IT_CHAR-ATWRT.
      IF SY-SUBRC EQ 0.
        ITAB-CORE = IT_CHAR_DESC-ATWTB.
      ENDIF.
    ENDIF.

    PERFORM GET_DATE USING ITAB-MATNR ITAB-CHARG ITAB-PROD_DATE CHANGING ITAB-GR_DATE ITAB-EXPIRED_DATE.
    PERFORM GET_VENDOR_BATCH USING ITAB-MATNR ITAB-CHARG CHANGING ITAB-VENDOR_BATCH.
    PERFORM GET_PRODUCTION_NUMBER_TYB USING ITAB-MATNR ITAB-CHARG ITAB-NO_ROL_TOYOBO ITAB-NO_LOT_TOYOBO ITAB-PROD_DATE CHANGING ITAB-PRODUCTION_NUM.

    PERFORM GENERATE_COLUMN_COLOUR USING 'BARRIER_R' ITAB-BARRIER_R.
    PERFORM GENERATE_COLUMN_COLOUR USING 'BARRIER_C' ITAB-BARRIER_C.
    PERFORM GENERATE_COLUMN_COLOUR USING 'BARRIER_L' ITAB-BARRIER_L.
    PERFORM GENERATE_COLUMN_COLOUR USING 'JUDGEMENT' ITAB-JUDGEMENT.


    IF BACK EQ 'X'.
      READ TABLE IT_CUT_OVER INDEX 1.
      IF SY-SUBRC EQ 0.
        PERFORM CONVERT_DATE_INPUT USING IT_CUT_OVER-VALUE CHANGING IT_CUT_OVER-VALUE.
        IF IT_CUT_OVER-VALUE GT ITAB-PROD_DATE.
          CLEAR: ITAB-CAN_BE_SHIP, ITAB-NEXT_WVTR, ITAB-NEXT_OTR.
        ENDIF.
      ENDIF.

      READ TABLE IT_INSP_PLAN WITH KEY MATNR = ITAB-MATNR.
      IF SY-SUBRC NE 0.
        CLEAR: ITAB-CAN_BE_SHIP, ITAB-NEXT_WVTR, ITAB-NEXT_OTR.
      ENDIF.

      MOVE-CORRESPONDING ITAB TO IT_STORE_EXIM.
      APPEND IT_STORE_EXIM.
      CLEAR IT_STORE_EXIM.
    ENDIF.

    MODIFY ITAB.
    CLEAR ITAB.
  ENDLOOP.

  IF BACK EQ 'X'.
    EXPORT IT_STORE_EXIM FROM IT_STORE_EXIM TO MEMORY ID 'ZBMBC_PASS_FAIL'.
  ENDIF.

  IF MODE EQ 'NCR_REPORT'.
    IF P_BLK IS INITIAL.
      DELETE ITAB WHERE NCR_APPROVAL IS INITIAL.
    ENDIF.

    IF P_APV IS INITIAL.
      READ TABLE IT_SHIPMENT WITH KEY TEXT5 = 'A'.
      IF SY-SUBRC EQ 0.
        DELETE ITAB WHERE NCR_APPROVAL EQ IT_SHIPMENT-TEXT3.
      ENDIF.
    ENDIF.

    IF P_RJT IS INITIAL.
      READ TABLE IT_SHIPMENT WITH KEY TEXT5 = 'R'.
      IF SY-SUBRC EQ 0.
        DELETE ITAB WHERE NCR_APPROVAL EQ IT_SHIPMENT-TEXT3.
      ENDIF.
    ENDIF.
  ENDIF.

  IF ITAB[] IS INITIAL.
    IF BACK IS INITIAL.
      MESSAGE 'Data not found!' TYPE 'S' DISPLAY LIKE 'E'.
    ENDIF.
    LEAVE LIST-PROCESSING.
  ENDIF.

*  SORT ITAB BY PROD_DATE ASCENDING ROLL_DERV ASCENDING POSITION ASCENDING.
  SORT ITAB BY PROD_DATE ASCENDING CHARG_JR ASCENDING CHARG ASCENDING POSITION ASCENDING.

  IF ITAB[] IS NOT INITIAL.
    PERFORM REFRESH.
  ENDIF.
ENDFORM.                    "GET_PREVIEW


*&---------------------------------------------------------------------*
*&      Form  GET_STORAGE_BIN
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->MATNR      text
*      -->WERKS      text
*      -->CHARG      text
*      -->LGPLA      text
*----------------------------------------------------------------------*
FORM GET_STORAGE_BIN USING MATNR WERKS CHARG CHANGING LGPLA.
  SELECT SINGLE LGPLA INTO LGPLA
      FROM LQUA
     WHERE MATNR = MATNR
       AND WERKS = WERKS
       AND CHARG = CHARG.
ENDFORM.                    "GET_STORAGE_BIN

*&---------------------------------------------------------------------*
*&      Form  GET_HU
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->CHARG      text
*      -->VENUM      text
*      -->EXIDV      text
*----------------------------------------------------------------------*
FORM GET_HU USING CHARG CHANGING VENUM EXIDV.
  DATA: V_VENUM TYPE VENUM.

  SELECT SINGLE VENUM INTO VENUM FROM VEPO WHERE CHARG EQ CHARG.

  IF VENUM IS NOT INITIAL.
    SELECT SINGLE VENUM INTO V_VENUM FROM VEPO WHERE UNVEL EQ VENUM.
    IF SY-SUBRC EQ 0.
      VENUM = V_VENUM.
    ENDIF.
  ENDIF.

  IF VENUM IS NOT INITIAL.
    SELECT SINGLE EXIDV INTO EXIDV
      FROM VEKP
     WHERE VENUM EQ VENUM.

    IF EXIDV IS INITIAL.
      SELECT SINGLE VENUM INTO ITAB-VENUM FROM VEPO WHERE UNVEL EQ VENUM.
      IF VENUM IS NOT INITIAL.
        SELECT SINGLE EXIDV INTO EXIDV
          FROM VEKP
         WHERE VENUM EQ VENUM.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.                    "GET_HU

*&---------------------------------------------------------------------*
*&      Form  GET_SLOC
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->CHARG      text
*      -->LGORT      text
*----------------------------------------------------------------------*
FORM GET_SLOC USING CHARG CHANGING LGORT.
  REFRESH: IT_SLOC, IT_SLOC_CANC.
  CLEAR: IT_SLOC, IT_SLOC_CANC, V_COUNT.

  "Get Preview
  SELECT
    MSEG~LGORT
    MSEG~CHARG
    MSEG~MBLNR
    MSEG~SMBLN
    MSEG~MJAHR
    MSEG~SJAHR
    MSEG~ZEILE
    MSEG~SMBLP
    MSEG~BWART
    MSEG~BUDAT_MKPF
    MSEG~CPUTM_MKPF
    INTO CORRESPONDING FIELDS OF TABLE IT_SLOC
    FROM MSEG
   WHERE CHARG EQ CHARG %_HINTS ORACLE 'INDEX("MESG" "MSEG~Z07")'.

  IT_SLOC_CANC[] = IT_SLOC[].
  "Delete Cancel
  DELETE IT_SLOC_CANC WHERE SMBLN IS INITIAL.
  LOOP AT IT_SLOC_CANC.
    DELETE IT_SLOC WHERE MBLNR EQ IT_SLOC_CANC-SMBLN AND MJAHR EQ IT_SLOC_CANC-SJAHR AND ZEILE EQ IT_SLOC_CANC-SMBLP.
  ENDLOOP.
  DELETE IT_SLOC WHERE SMBLN IS NOT INITIAL.

  LOOP AT IT_SLOC.
    CONCATENATE IT_SLOC-BUDAT_MKPF IT_SLOC-CPUTM_MKPF INTO IT_SLOC-DATETIME_MKPF.
    MODIFY IT_SLOC.
  ENDLOOP.

  SORT IT_SLOC BY DATETIME_MKPF ASCENDING MBLNR ASCENDING ZEILE ASCENDING.
  DESCRIBE TABLE IT_SLOC LINES V_COUNT.

  READ TABLE IT_SLOC INDEX V_COUNT.
  IF SY-SUBRC EQ 0.
    LGORT = IT_SLOC-LGORT.
  ENDIF.

ENDFORM.                    "GET_SLOC

*&---------------------------------------------------------------------*
*&      Form  GET_STOCK
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->MATNR        text
*      -->WERKS        text
*      -->CHARG        text
*      -->LGORT        text
*      -->UNREST_KG    text
*      -->UNREST_ROLL  text
*      -->QINSP_KG     text
*      -->QINSP_ROLL   text
*      -->BL_STOCK_KG  text
*      -->BL_SR        text
*      -->BL_REASON    text
*      -->BL_COMMENT   text
*----------------------------------------------------------------------*
FORM GET_STOCK USING MATNR WERKS CHARG LGORT CHANGING UNREST_KG UNREST_ROLL QINSP_KG QINSP_ROLL BL_STOCK_KG BL_SR BL_REASON BL_COMMENT.

  SELECT SINGLE CLABS CINSM CSPEM
    INTO (UNREST_KG, QINSP_KG, BL_STOCK_KG)
    FROM MCHB
   WHERE MATNR EQ MATNR AND
         WERKS EQ WERKS AND
         LGORT EQ LGORT AND
         CHARG EQ CHARG.

  IF UNREST_KG IS INITIAL.
    SELECT SINGLE KALAB
      INTO (UNREST_KG)
      FROM MSKA
     WHERE MATNR EQ MATNR AND
           WERKS EQ WERKS AND
           LGORT EQ LGORT AND
           CHARG EQ CHARG.
  ENDIF.

  IF UNREST_KG IS NOT INITIAL.
    UNREST_ROLL = 1.
  ENDIF.

  IF QINSP_KG IS NOT INITIAL.
    QINSP_ROLL = 1.
  ENDIF.

  IF BL_STOCK_KG IS NOT INITIAL.
    BL_SR = 1.

    SELECT SGTXT INTO BL_REASON
      FROM MSEG
     WHERE CHARG EQ CHARG
       AND BWART = '344'.
    ENDSELECT.

    SPLIT BL_REASON AT '_' INTO BL_REASON BL_COMMENT.
  ENDIF.
ENDFORM.                    "GET_BLOCKED_STOCK

*&---------------------------------------------------------------------*
*&      Form  GET_BATCH_JR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ROLL       text
*      -->MATNR      text
*      -->CHARG      text
*----------------------------------------------------------------------*
FORM GET_BATCH_JR USING CHARG_S CHANGING MATNR CHARG.
  READ TABLE IT_SR_DATA WITH KEY CHARG = CHARG_S.
  IF SY-SUBRC EQ 0 AND IT_SR_DATA-CHARGJR IS NOT INITIAL.
    SELECT SINGLE MATNR CHARG
      INTO (MATNR,CHARG)
      FROM MCH1
     WHERE CHARG EQ IT_SR_DATA-CHARGJR.
  ELSE.
    CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
      EXPORTING
        CHARG_S = CHARG_S
      IMPORTING
        MATNR_J = MATNR
        CHARG_J = CHARG.
  ENDIF.
ENDFORM.                    "GET_BATCH_JR

*&---------------------------------------------------------------------*
*&      Form  GET_UD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PRUEFLOS_R text
*      -->PRUEFLOS_C text
*      -->PRUEFLOS_L text
*      -->BARRIER_R  text
*      -->BARRIER_C  text
*      -->BARRIER_L  text
*----------------------------------------------------------------------*
FORM GET_UD USING CHARG CHARG_SR CHANGING PRUEFLOS_R PRUEFLOS_C PRUEFLOS_L BARRIER_R BARRIER_C BARRIER_L DATETIME_R DATETIME_C DATETIME_L.
  IF CHARG IS INITIAL.
    EXIT.
  ENDIF.

  READ TABLE IT_SR_DATA WITH KEY CHARG = CHARG_SR.
  IF SY-SUBRC NE 0.
    REFRESH: IT_SR_DATA.
    CLEAR: IT_SR_DATA.

    CALL FUNCTION 'ZQM_GET_BATCH_SR_BY_JR'
      EXPORTING
        CHARGJR = CHARG
        SCRAP   = 'X'
      TABLES
        T_SR    = IT_SR_DATA
        T_CABN  = IT_CABN.

    SORT IT_SR_DATA BY DERIVATIVE ASCENDING POSITION ASCENDING.
  ENDIF.

  LOOP AT IT_SR_DATA WHERE ( GRADE = '1' OR GRADE = 'R' ) AND ABLAD = 'MS'.
    READ TABLE IT_PRUEFLOS WITH KEY CHARG = IT_SR_DATA-CHARG.
    IF SY-SUBRC NE 0.
      CLEAR: IT_PRUEFLOS, IT_UD.
      REFRESH: IT_PRUEFLOS, IT_UD.

      SELECT QALS~PRUEFLOS KTEXTLOS CHARG
        INTO CORRESPONDING FIELDS OF TABLE IT_PRUEFLOS
        FROM QALS
         WHERE CHARG = IT_SR_DATA-CHARG
         AND ART       EQ 'ZE04'
         AND HERKUNFT  EQ '05'
         AND ( KTEXTLOS LIKE '|R|%'   OR KTEXTLOS LIKE '|C|%'    OR KTEXTLOS LIKE '|L|%' ).

      IF IT_PRUEFLOS[] IS INITIAL.
        EXIT.
      ENDIF.

      LOOP AT IT_PRUEFLOS.
        SELECT COUNT(*)
          INTO V_CANCELLED
          FROM JEST
          JOIN QALS   ON JEST~OBJNR EQ QALS~OBJNR
          JOIN TJ02T  ON JEST~STAT  EQ TJ02T~ISTAT
         WHERE QALS~PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS
           AND TJ02T~TXT04 EQ 'LTCA'
           AND TJ02T~SPRAS EQ 'E'.

        IF SY-SUBRC EQ   0.
          DELETE IT_PRUEFLOS.
          CONTINUE.
        ENDIF.
      ENDLOOP.

      IF IT_PRUEFLOS[] IS NOT INITIAL.
        SELECT PRUEFLOS VCODE VAEDATUM AS DATE VEZEITAEN AS TIME
          INTO CORRESPONDING FIELDS OF TABLE IT_UD
          FROM QAVE
          FOR ALL ENTRIES IN IT_PRUEFLOS
         WHERE PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
      ENDIF.

      DELETE IT_UD WHERE VCODE IS INITIAL.
    ENDIF.

    LOOP AT IT_PRUEFLOS.
      IF IT_PRUEFLOS-KTEXTLOS EQ '|R|' AND PRUEFLOS_R IS INITIAL.
        READ TABLE IT_UD WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
        IF SY-SUBRC EQ 0.
          PRUEFLOS_R = IT_UD-PRUEFLOS.
          BARRIER_R  = IT_UD-VCODE.
          CONCATENATE IT_UD-DATE IT_UD-TIME INTO DATETIME_R.
        ELSE.
          PRUEFLOS_R = IT_PRUEFLOS-PRUEFLOS.
          BARRIER_R  = V_NOT.
        ENDIF.
      ELSEIF IT_PRUEFLOS-KTEXTLOS EQ '|C|' AND PRUEFLOS_C IS INITIAL.
        READ TABLE IT_UD WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
        IF SY-SUBRC EQ 0.
          PRUEFLOS_C = IT_UD-PRUEFLOS.
          BARRIER_C  = IT_UD-VCODE.
          CONCATENATE IT_UD-DATE IT_UD-TIME INTO DATETIME_C.
        ELSE.
          PRUEFLOS_C = IT_PRUEFLOS-PRUEFLOS.
          BARRIER_C  = V_NOT.
        ENDIF.
      ELSEIF IT_PRUEFLOS-KTEXTLOS EQ '|L|' AND PRUEFLOS_L IS INITIAL.
        READ TABLE IT_UD WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
        IF SY-SUBRC EQ 0.
          PRUEFLOS_L = IT_UD-PRUEFLOS.
          BARRIER_L  = IT_UD-VCODE.
          CONCATENATE IT_UD-DATE IT_UD-TIME INTO DATETIME_L.
        ELSE.
          PRUEFLOS_L = IT_PRUEFLOS-PRUEFLOS.
          BARRIER_L  = V_NOT.
        ENDIF.
      ENDIF.
    ENDLOOP.
    EXIT.
  ENDLOOP.
ENDFORM.                    "GET_UD

*&---------------------------------------------------------------------*
*&      Form  GET_APPROVAL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PRUEFLOS_R text
*      -->PRUEFLOS_C text
*      -->PRUEFLOS_L text
*      -->ERR        text
*      -->ZSTAT      text
*      -->MESS       text
*----------------------------------------------------------------------*
FORM GET_APPROVAL USING BARRIER_POS PRUEFLOS_R PRUEFLOS_C PRUEFLOS_L CHANGING ERR ZSTAT MESS.
  IF BARRIER_POS CS 'R'.
    CLEAR: V_VCODE, V_TIMES.
    SELECT VCODE PROBENR
      INTO (V_VCODE, V_TIMES)
      FROM QAPP
     WHERE PRUEFLOS EQ PRUEFLOS_R
     ORDER BY PROBENR.

      IF V_VCODE+0(2) EQ V_NO.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_R '%WVTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'WVTR for R Position not yet approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+2(2) EQ V_NO.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_R '%OTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'OTR for R Position not yet approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+0(2) EQ V_NG.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_R '%WVTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'WVTR for R Position not approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+2(2) EQ V_NG.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_R '%OTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'OTR for R Position not approved...!'.
        ENDIF.
      ENDIF.
    ENDSELECT.
  ENDIF.

  IF BARRIER_POS CS 'C'.
    CLEAR: V_VCODE, V_TIMES.
    SELECT VCODE PROBENR
      INTO (V_VCODE, V_TIMES)
      FROM QAPP
     WHERE PRUEFLOS EQ PRUEFLOS_C
     ORDER BY PROBENR.

      IF V_VCODE+0(2) EQ V_NO.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_C '%WVTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'WVTR for C Position not yet approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+2(2) EQ V_NO.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_C '%OTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'OTR for C Position not yet approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+0(2) EQ V_NG.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_C '%WVTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'WVTR for C Position not approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+2(2) EQ V_NG.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_C '%OTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'OTR for C Position not approved...!'.
        ENDIF.
      ENDIF.
    ENDSELECT.
  ENDIF.

  IF BARRIER_POS CS 'L'.
    CLEAR: V_VCODE, V_TIMES.
    SELECT VCODE PROBENR
      INTO (V_VCODE, V_TIMES)
      FROM QAPP
     WHERE PRUEFLOS EQ PRUEFLOS_L
     ORDER BY PROBENR.

      IF V_VCODE+0(2) EQ V_NO.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_L '%WVTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'WVTR for L Position not yet approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+2(2) EQ V_NO.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_L '%OTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'OTR for L Position not yet approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+0(2) EQ V_NG.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_L '%WVTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'WVTR for L Position not approved...!'.
        ENDIF.
      ENDIF.

      IF V_VCODE+2(2) EQ V_NG.
        CLEAR: V_ERR.
        PERFORM CHECK_QASE_PERTIMES USING PRUEFLOS_L '%OTR%' V_TIMES CHANGING V_ERR.
        IF V_ERR IS INITIAL.
          ERR   = 'X'.
          MESS  = 'OTR for L Position not approved...!'.
        ENDIF.
      ENDIF.
    ENDSELECT.
  ENDIF.
ENDFORM.                    "GET_APPROVAL

*&---------------------------------------------------------------------*
*&      Form  CHECK_QASE_PERTIMES
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PRUEFLOS   text
*      -->INSPECTION text
*      -->TIMES      text
*      -->V_ERR      text
*----------------------------------------------------------------------*
FORM CHECK_QASE_PERTIMES USING PRUEFLOS INSPECTION TIMES CHANGING ERR.
  CLEAR: IT_QASE.
  REFRESH: IT_QASE.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_QASE
    FROM QASE
    JOIN QAMV ON QASE~PRUEFLOS EQ QAMV~PRUEFLOS AND QASE~MERKNR EQ QAMV~MERKNR
   WHERE QASE~PRUEFLOS EQ    PRUEFLOS
     AND VERWMERKM     LIKE  INSPECTION
     AND PROBENR       EQ    TIMES.

  IF SY-SUBRC NE 0.
    ERR = 'X'.
  ENDIF.
ENDFORM.                    "CHECK_QASE_PERTIMES
*&---------------------------------------------------------------------*
*&      Form  GET_JUDGEMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->MATNR         text
*      -->CHARG         text
*      -->JUDGEMENT     text
*      -->NCR_APPROVAL  text
*      -->CAN_BE_SHIP   text
*      -->NO_PO         text
*----------------------------------------------------------------------*
FORM GET_JUDGEMENT USING MATNR CHARG DATETIME_R DATETIME_C DATETIME_L CHANGING JUDGEMENT NCR_APPROVAL CAN_BE_SHIP DATETIME.
  DATA : V_TEMP_CHARG LIKE MSEG-CHARG.
  DATA : V_TEMP_MATNR LIKE MSEG-MATNR.
  DATA : WA_SR_CG LIKE LINE OF IT_SR_CG.
  DATA : LV_LIMIT_CG TYPE I VALUE 1.

  "Check change grade
  V_TEMP_MATNR = MATNR.
  V_TEMP_CHARG = CHARG.
  IF IT_SR_CG[] IS NOT INITIAL.
      DO.
         READ TABLE IT_SR_CG INTO WA_SR_CG WITH KEY  NCHARG = V_TEMP_CHARG.
         IF SY-SUBRC NE 0.
            EXIT.
         ENDIF.

         V_TEMP_MATNR = WA_SR_CG-MATNR.
         V_TEMP_CHARG = WA_SR_CG-CHARG.

         LV_LIMIT_CG = LV_LIMIT_CG + 1.

         IF LV_LIMIT_CG > LINES( IT_SR_CG ).
            EXIT.
         ENDIF.
     ENDDO.
   ENDIF.
  "Check Barrier
  CLEAR: V_DATE, V_TIME, IT_JUDGEMENT.
  REFRESH: IT_JUDGEMENT.

  SELECT *
     INTO CORRESPONDING FIELDS OF TABLE IT_JUDGEMENT
     FROM ZLOG_BARRIER
    WHERE MATNR    EQ V_TEMP_MATNR
      AND CHARG    EQ V_TEMP_CHARG
      AND DELETION EQ ''.

  LOOP AT IT_JUDGEMENT.
    CONCATENATE IT_JUDGEMENT-CPUDT IT_JUDGEMENT-CPUTM INTO DATETIME.

    IF DATETIME GE DATETIME_R AND DATETIME GE DATETIME_C AND DATETIME GE DATETIME_L.
      JUDGEMENT     = IT_JUDGEMENT-JUDGEMENT.
      NCR_APPROVAL  = IT_JUDGEMENT-NCRAPPROVAL.
      CAN_BE_SHIP   = IT_JUDGEMENT-CANBESHIP.
    ENDIF.
  ENDLOOP.
ENDFORM.                    "GET_JUDGEMENT

