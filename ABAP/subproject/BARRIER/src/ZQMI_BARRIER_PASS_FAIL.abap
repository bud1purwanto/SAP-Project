*&---------------------------------------------------------------------*
*&      Form  INSERT_JUDGEMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->MATNR      text
*      -->CHARG      text
*      -->JUDGEMENT  text
*----------------------------------------------------------------------*
FORM INSERT_JUDGEMENT USING MATNR CHARG JUDGEMENT.
  DATA: LV_APPROVED TYPE ZLOG_BARRIER-NCRAPPROVAL.
  CLEAR: WA_JUDGEMENT.

  IF JUDGEMENT IS INITIAL OR JUDGEMENT EQ V_NOT.
    EXIT.
  ENDIF.

  SELECT SINGLE NCRAPPROVAL INTO LV_APPROVED
    FROM ZLOG_BARRIER
   WHERE MATNR       EQ MATNR
     AND CHARG       EQ CHARG
     AND DELETION    EQ ''
     AND NCRAPPROVAL EQ 'Approved'.
  IF SY-SUBRC EQ 0.
    EXIT.
  ENDIF.

  SELECT * INTO CORRESPONDING FIELDS OF WA_JUDGEMENT
    FROM ZLOG_BARRIER
   WHERE MATNR    EQ MATNR
     AND CHARG    EQ CHARG
     AND DELETION EQ ''.
  ENDSELECT.

  IF SY-SUBRC EQ 0.
    WA_JUDGEMENT-DELETION   = 'X'.
    WA_JUDGEMENT-AEDAT      = SY-DATUM.
    WA_JUDGEMENT-PSOTM      = SY-UZEIT.
    WA_JUDGEMENT-AENAM      = SY-UNAME.

    CALL FUNCTION 'TERMINAL_ID_GET'
      EXPORTING
        USERNAME             = SY-UNAME
      IMPORTING
        TERMINAL             = WA_JUDGEMENT-TERM2
      EXCEPTIONS
        MULTIPLE_TERMINAL_ID = 1
        NO_TERMINAL_FOUND    = 2
        OTHERS               = 3.

    IF SY-SUBRC NE 0.
      WA_JUDGEMENT-TERM2 = V_TERMINAL_JOB.
    ENDIF.

    UPDATE ZLOG_BARRIER
       SET DELETION = WA_JUDGEMENT-DELETION
           AEDAT    = WA_JUDGEMENT-AEDAT
           PSOTM    = WA_JUDGEMENT-PSOTM
           AENAM    = WA_JUDGEMENT-AENAM
           TERM2    = WA_JUDGEMENT-TERM2
     WHERE MATNR       = WA_JUDGEMENT-MATNR
       AND CHARG       = WA_JUDGEMENT-CHARG
       AND VERSION     = WA_JUDGEMENT-VERSION
       AND JUDGEMENT   = WA_JUDGEMENT-JUDGEMENT
       AND NCRAPPROVAL <> 'Approved'.
    IF SY-SUBRC NE 0.
      EXIT.
    ENDIF.
    COMMIT WORK AND WAIT.
  ENDIF.

  CLEAR: WA_JUDGEMENT-AEDAT, WA_JUDGEMENT-PSOTM, WA_JUDGEMENT-AENAM, WA_JUDGEMENT-TERM2.

  "Then Insert
  WA_JUDGEMENT-MATNR      = MATNR.
  WA_JUDGEMENT-CHARG      = CHARG.
  WA_JUDGEMENT-JUDGEMENT  = JUDGEMENT.
  WA_JUDGEMENT-DELETION   = ''.
  WA_JUDGEMENT-CPUDT      = SY-DATUM.
  WA_JUDGEMENT-CPUTM      = SY-UZEIT.
  WA_JUDGEMENT-USNAM      = SY-UNAME.

  CALL FUNCTION 'TERMINAL_ID_GET'
    EXPORTING
      USERNAME             = SY-UNAME
    IMPORTING
      TERMINAL             = WA_JUDGEMENT-TERM1
    EXCEPTIONS
      MULTIPLE_TERMINAL_ID = 1
      NO_TERMINAL_FOUND    = 2
      OTHERS               = 3.

  IF SY-SUBRC NE 0.
    WA_JUDGEMENT-TERM1 = V_TERMINAL_JOB.
  ENDIF.

  ADD 1 TO WA_JUDGEMENT-VERSION.

  PERFORM CONVERSION_INPUT USING WA_JUDGEMENT-VERSION CHANGING WA_JUDGEMENT-VERSION.

  INSERT ZLOG_BARRIER FROM WA_JUDGEMENT.
  COMMIT WORK AND WAIT.
ENDFORM.                    "INSERT_JUDGEMENT

*&---------------------------------------------------------------------*
*&      Form  GET_WVTR_OTR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->BARRIER_POS  text
*      -->PRUEFLOS_R   text
*      -->PRUEFLOS_C   text
*      -->PRUEFLOS_L   text
*      -->WVTR_R       text
*      -->OTR_R        text
*      -->WVTR_C       text
*      -->OTR_C        text
*      -->WVTR_L       text
*      -->OTR_L        text
*----------------------------------------------------------------------*
FORM GET_WVTR_OTR USING BARRIER_POS PRUEFLOS_R PRUEFLOS_C PRUEFLOS_L BARRIER_R BARRIER_C BARRIER_L CHANGING DEVICE WVTR_R OTR_R TIMES_R
                                                                                                            WVTR_C OTR_C TIMES_C
                                                                                                            WVTR_L OTR_L TIMES_L
                                                                                                            TIMES TIMES_NOT_PAS.
  CLEAR: IT_QASE, IT_WVTR, IT_OTR, V_COUNT, IT_DEVICE.
  REFRESH: IT_QASE, IT_WVTR, IT_OTR, IT_DEVICE.

  "Get Data WVTR and OTR
  READ TABLE IT_BIG_QASE WITH KEY PRUEFLOS = PRUEFLOS_R.
  IF SY-SUBRC NE 0.
    CLEAR: IT_BIG_QASE.
    REFRESH: IT_BIG_QASE.

    SELECT QASE~PRUEFLOS QASE~MERKNR VERWMERKM MKVERSION PROBENR STUECKNR MESSWERT MBEWERTG ATTRIBUT PRUEFBEMKT
      INTO CORRESPONDING FIELDS OF TABLE IT_BIG_QASE
      FROM QASE
      JOIN QAMV ON QAMV~PRUEFLOS EQ QASE~PRUEFLOS AND QAMV~VORGLFNR EQ QASE~VORGLFNR AND QAMV~MERKNR EQ QASE~MERKNR
     WHERE QASE~PRUEFLOS IN (PRUEFLOS_R, PRUEFLOS_C, PRUEFLOS_L).
  ENDIF.

  PERFORM GET_LAST_QASE USING PRUEFLOS_R CHANGING DEVICE WVTR_R OTR_R TIMES_R.

  IF BARRIER_POS CS 'R'.
    V_COUNT = ITAB-TIMES_R.
    IF V_COUNT IS NOT INITIAL.
      TIMES = V_COUNT.
      CONDENSE TIMES NO-GAPS.
    ENDIF.

    IF BARRIER_R NE V_PASS AND BARRIER_R NE V_NCR.
      TIMES_NOT_PAS = V_COUNT.
    ENDIF.

    APPEND LINES OF IT_QASE TO IT_DEVICE.
  ELSE.
    WVTR_R = '-'.
    OTR_R  = '-'.
  ENDIF.

  CLEAR: V_COUNT.

  PERFORM GET_LAST_QASE USING PRUEFLOS_C CHANGING DEVICE WVTR_C OTR_C TIMES_C.

  IF BARRIER_POS CS 'C'.
    V_COUNT = ITAB-TIMES_C.
    IF V_COUNT IS NOT INITIAL.
      IF TIMES IS INITIAL.
        TIMES = V_COUNT.
      ELSE.
        TIMES = TIMES && '|' && V_COUNT.
      ENDIF.
      CONDENSE TIMES NO-GAPS.
    ENDIF.
    IF BARRIER_C NE V_PASS AND BARRIER_C NE V_NCR.
      IF V_COUNT LT TIMES_NOT_PAS OR TIMES_NOT_PAS IS INITIAL.
        TIMES_NOT_PAS = V_COUNT.
      ENDIF.
    ENDIF.

    APPEND LINES OF IT_QASE TO IT_DEVICE.
  ELSE.
    WVTR_C = '-'.
    OTR_C  = '-'.
  ENDIF.

  CLEAR: V_COUNT.

  PERFORM GET_LAST_QASE USING PRUEFLOS_L CHANGING DEVICE WVTR_L OTR_L TIMES_L.

  IF BARRIER_POS CS 'L'.
    V_COUNT = ITAB-TIMES_L.
    IF V_COUNT IS NOT INITIAL.
      IF TIMES IS INITIAL.
        TIMES = V_COUNT.
      ELSE.
        TIMES = TIMES && '|' && V_COUNT.
      ENDIF.
      CONDENSE TIMES NO-GAPS.
    ENDIF.
    IF BARRIER_L NE V_PASS AND BARRIER_L NE V_NCR.
      IF V_COUNT LT TIMES_NOT_PAS OR TIMES_NOT_PAS IS INITIAL.
        TIMES_NOT_PAS = V_COUNT.
      ENDIF.
    ENDIF.

    APPEND LINES OF IT_QASE TO IT_DEVICE.
  ELSE.
    WVTR_L = '-'.
    OTR_L  = '-'.
  ENDIF.

  SORT IT_DEVICE BY PRUEFBEMKT.
  DELETE ADJACENT DUPLICATES FROM IT_DEVICE COMPARING PRUEFBEMKT.

  CLEAR DEVICE.
  LOOP AT IT_DEVICE.
    IF SY-TABIX NE 1.
      CONCATENATE DEVICE ', ' INTO DEVICE.
    ENDIF.

    CONCATENATE DEVICE IT_DEVICE-PRUEFBEMKT INTO DEVICE SEPARATED BY SPACE.
  ENDLOOP.
ENDFORM.                    "GET_WVTR_OTR

*&---------------------------------------------------------------------*
*&      Form  GET_LAST_QASE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PRUEFLOS   text
*      -->WVTR       text
*      -->OTR        text
*----------------------------------------------------------------------*
FORM GET_LAST_QASE USING PRUEFLOS CHANGING DEVICE WVTR OTR TIMES.
  CLEAR: IT_QASE, IT_WVTR, IT_OTR, V_WVTR, V_OTR, V_TIMES.
  REFRESH: IT_QASE, IT_WVTR, IT_OTR.

  "Get Data WVTR and OTR
  IT_QASE[] = IT_BIG_QASE[].
  DELETE IT_QASE WHERE PRUEFLOS NE PRUEFLOS.

  "Sort Data Recording to WVTR and OTR
  DELETE IT_QASE WHERE ATTRIBUT IS NOT INITIAL. "Deletion
  IT_WVTR[] = IT_QASE[].
  IT_OTR[]  = IT_QASE[].

  DELETE IT_WVTR WHERE VERWMERKM NS 'WVTR'.
  DELETE IT_OTR  WHERE VERWMERKM NS 'OTR' AND VERWMERKM NS 'O2TR'.

  "Sorting By Times and Cycle
  SORT IT_WVTR BY PROBENR DESCENDING STUECKNR DESCENDING.
  SORT IT_OTR  BY PROBENR DESCENDING STUECKNR DESCENDING.

  READ TABLE IT_WVTR INDEX 1.
  IF SY-SUBRC EQ 0.
    V_WVTR   = IT_WVTR-MESSWERT.
    WVTR     = V_WVTR.
    V_TIMES  = IT_WVTR-PROBENR.

    IF IT_WVTR-PRUEFBEMKT IS NOT INITIAL.
      DEVICE   = IT_WVTR-PRUEFBEMKT.
    ENDIF.
  ENDIF.

  READ TABLE IT_OTR INDEX 1.
  IF SY-SUBRC EQ 0.
    V_OTR    = IT_OTR-MESSWERT.
    OTR      = V_OTR.
    TIMES    = IT_OTR-PROBENR.

    IF IT_OTR-PRUEFBEMKT IS NOT INITIAL.
      DEVICE   = IT_OTR-PRUEFBEMKT.
    ENDIF.
  ENDIF.

  IF V_TIMES GT TIMES.
    TIMES = V_TIMES.
  ENDIF.
ENDFORM.                    "GET_WVTR_OTR

*&---------------------------------------------------------------------*
*&      Form  GET_SHIPMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->BL_STOCK_KG   text
*      -->JUDGEMENT     text
*      -->NCR_APPROVAL  text
*      -->CAN_BE_SHIP   text
*----------------------------------------------------------------------*
FORM GET_SHIPMENT USING BL_STOCK_KG JUDGEMENT NCR_APPROVAL CHANGING CAN_BE_SHIP.
  CLEAR: CAN_BE_SHIP.

  IF BL_STOCK_KG IS NOT INITIAL.
    BLOCKED_STATUS = 'Blocked'.
  ELSE.
    BLOCKED_STATUS = 'Not Blocked'.
  ENDIF.

  READ TABLE IT_RANK WITH KEY ALIAS = JUDGEMENT.
  IF SY-SUBRC EQ 0.
    READ TABLE IT_SHIPMENT WITH KEY TEXT1 = BLOCKED_STATUS TEXT2 = IT_RANK-VCODE TEXT3 = NCR_APPROVAL.
    IF SY-SUBRC EQ 0.
      CAN_BE_SHIP = IT_SHIPMENT-TEXT4.
    ENDIF.
  ELSE.
    READ TABLE IT_SHIPMENT WITH KEY TEXT1 = BLOCKED_STATUS TEXT2 = JUDGEMENT TEXT3 = NCR_APPROVAL.
    IF SY-SUBRC EQ 0.
      CAN_BE_SHIP = IT_SHIPMENT-TEXT4.
    ENDIF.
  ENDIF.

  CLEAR: WA_JUDGEMENT.

  SELECT * INTO CORRESPONDING FIELDS OF WA_JUDGEMENT
    FROM ZLOG_BARRIER
   WHERE MATNR    EQ ITAB-MATNR
     AND CHARG    EQ ITAB-CHARG
     AND DELETION EQ ''.
  ENDSELECT.

  IF SY-SUBRC EQ 0 AND WA_JUDGEMENT-CANBESHIP NE CAN_BE_SHIP.
    WA_JUDGEMENT-CANBESHIP    = CAN_BE_SHIP.
    WA_JUDGEMENT-AEDAT        = SY-DATUM.
    WA_JUDGEMENT-PSOTM        = SY-UZEIT.
    WA_JUDGEMENT-AENAM        = SY-UNAME.

    CALL FUNCTION 'TERMINAL_ID_GET'
      EXPORTING
        USERNAME             = SY-UNAME
      IMPORTING
        TERMINAL             = WA_JUDGEMENT-TERM2
      EXCEPTIONS
        MULTIPLE_TERMINAL_ID = 1
        NO_TERMINAL_FOUND    = 2
        OTHERS               = 3.

    IF SY-SUBRC NE 0.
      WA_JUDGEMENT-TERM2 = V_TERMINAL_JOB.
    ENDIF.

    UPDATE ZLOG_BARRIER
       SET CANBESHIP = WA_JUDGEMENT-CANBESHIP
           AEDAT     = WA_JUDGEMENT-AEDAT
           PSOTM     = WA_JUDGEMENT-PSOTM
           AENAM     = WA_JUDGEMENT-AENAM
           TERM2     = WA_JUDGEMENT-TERM2
     WHERE MATNR     = WA_JUDGEMENT-MATNR
       AND CHARG     = WA_JUDGEMENT-CHARG
       AND VERSION   = WA_JUDGEMENT-VERSION
       AND JUDGEMENT = WA_JUDGEMENT-JUDGEMENT.
    IF SY-SUBRC EQ 0.
      COMMIT WORK AND WAIT.
    ENDIF.
  ENDIF.
ENDFORM.                    " GET_SHIPMENT

*&---------------------------------------------------------------------*
*&      Form  GET_ESTIMATION_DATE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PRUEFLOS_R text
*      -->PRUEFLOS_C text
*      -->PRUEFLOS_L text
*      -->NEXT_WVTR  text
*      -->NEXT_OTR   text
*----------------------------------------------------------------------*
FORM GET_ESTIMATION_DATE USING WERKS BARRIER_POS PRUEFLOS_R PRUEFLOS_C PRUEFLOS_L TIMES_R TIMES_C TIMES_L CHANGING NEXT_WVTR NEXT_OTR.
  CLEAR: IT_QASR, IT_QASR_WVTR, IT_QASR_OTR, V_PRUEFLOS, V_TIMES, IT_SORT_DATE, V_DATE.
  REFRESH: IT_QASR, IT_QASR_WVTR, IT_QASR_OTR, IT_SORT_DATE.

  IT_QASE[] = IT_BIG_QASE[].
  "Sort Data Recording to WVTR and OTR
  DELETE IT_QASE WHERE ATTRIBUT IS NOT INITIAL. "Deletion

  IT_SORT_DATE[] = IT_SR_DATA[].

  DELETE IT_SORT_DATE WHERE GRADE NE '1' AND GRADE NE 'R'.
  DELETE IT_SORT_DATE WHERE ABLAD NE 'MS'.

  SORT IT_SORT_DATE BY BUDAT ASCENDING.

  READ TABLE IT_SORT_DATE INDEX 1.
  IF SY-SUBRC EQ 0.
    V_DATE = IT_SORT_DATE-BUDAT.
  ENDIF.

  "Get Data WVTR and OTR
  READ TABLE IT_BIG_QASR WITH KEY PRUEFLOS = PRUEFLOS_R.
  IF SY-SUBRC NE 0.
    CLEAR: IT_BIG_QASR.
    REFRESH: IT_BIG_QASR.

    SELECT QASR~PRUEFLOS QASR~MERKNR VERWMERKM PROBENR PRUEFDATUV
      INTO CORRESPONDING FIELDS OF TABLE IT_BIG_QASR
      FROM QASR
      JOIN QAMV ON QAMV~PRUEFLOS EQ QASR~PRUEFLOS AND QAMV~VORGLFNR EQ QASR~VORGLFNR AND QAMV~MERKNR EQ QASR~MERKNR
     WHERE QASR~PRUEFLOS IN (PRUEFLOS_R, PRUEFLOS_C, PRUEFLOS_L).
  ENDIF.

  IT_QASR[] = IT_BIG_QASR[].

  IF BARRIER_POS NS 'R'.
    READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|R|'.
    IF SY-SUBRC EQ 0.
      DELETE IT_QASR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS.
      DELETE IT_QASE WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS.
    ENDIF.
  ENDIF.

  IF BARRIER_POS NS 'C'.
    READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|C|'.
    IF SY-SUBRC EQ 0.
      DELETE IT_QASR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS.
      DELETE IT_QASE WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS.
    ENDIF.
  ENDIF.

  IF BARRIER_POS NS 'L'.
    READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|L|'.
    IF SY-SUBRC EQ 0.
      DELETE IT_QASR WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS.
      DELETE IT_QASE WHERE PRUEFLOS EQ IT_PRUEFLOS-PRUEFLOS.
    ENDIF.
  ENDIF.

  IF IT_QASR[] IS INITIAL.
    READ TABLE IT_EST_DATE WITH KEY VALUE = 'WVTR'.
    IF SY-SUBRC EQ 0.
      NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT1.
    ENDIF.

    READ TABLE IT_EST_DATE WITH KEY VALUE = 'OTR'.
    IF SY-SUBRC EQ 0.
      NEXT_OTR = V_DATE + IT_EST_DATE-TEXT1.
    ENDIF.
    EXIT.
  ENDIF.

  LOOP AT IT_QASR.
    IT_QASE-PRUEFDATUV = IT_QASR-PRUEFDATUV.
    MODIFY IT_QASE TRANSPORTING PRUEFDATUV WHERE PRUEFLOS   EQ IT_QASR-PRUEFLOS
                                             AND MERKNR     EQ IT_QASR-MERKNR
                                             AND VERWMERKM  EQ IT_QASR-VERWMERKM
                                             AND PROBENR    EQ IT_QASR-PROBENR.
  ENDLOOP.

  IT_WVTR[] = IT_QASE[].
  IT_OTR[]  = IT_QASE[].


  DELETE IT_WVTR WHERE VERWMERKM NS 'WVTR'.
  DELETE IT_OTR  WHERE VERWMERKM NS 'OTR' AND VERWMERKM NS 'O2TR'.

  "Sorting By Times and Cycle
  SORT IT_WVTR BY PRUEFLOS ASCENDING PROBENR DESCENDING STUECKNR DESCENDING.
  SORT IT_OTR  BY PRUEFLOS ASCENDING PROBENR DESCENDING STUECKNR DESCENDING.

  DELETE ADJACENT DUPLICATES FROM IT_WVTR COMPARING PRUEFLOS.
  DELETE ADJACENT DUPLICATES FROM IT_OTR  COMPARING PRUEFLOS.

  SORT IT_WVTR BY PROBENR ASCENDING STUECKNR DESCENDING.
  SORT IT_OTR  BY PROBENR ASCENDING STUECKNR DESCENDING.

  LOOP AT IT_WVTR.
    PERFORM GET_CALCULATION USING WERKS IT_WVTR-VERWMERKM IT_WVTR-MKVERSION IT_WVTR-MESSWERT CHANGING IT_WVTR-UD IT_WVTR-RANK.
    MODIFY IT_WVTR.
    CLEAR IT_WVTR.
  ENDLOOP.

  LOOP AT IT_OTR.
    PERFORM GET_CALCULATION USING WERKS IT_OTR-VERWMERKM IT_OTR-MKVERSION IT_OTR-MESSWERT CHANGING IT_OTR-UD IT_OTR-RANK.
    MODIFY IT_OTR.
    CLEAR IT_OTR.
  ENDLOOP.

  IF BARRIER_POS CS 'R'.
    READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|R|'.
    IF SY-SUBRC NE 0.
      IT_QASR-PRUEFLOS  = 0.
      IT_QASR-VERWMERKM = 'WVTROTR'.
      APPEND IT_QASR.
    ENDIF.
  ENDIF.

  IF BARRIER_POS CS 'C'.
    READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|C|'.
    IF SY-SUBRC NE 0.
      IT_QASR-PRUEFLOS  = 0.
      IT_QASR-VERWMERKM = 'WVTROTR'.
      APPEND IT_QASR.
    ENDIF.
  ENDIF.

  IF BARRIER_POS CS 'L'.
    READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|L|'.
    IF SY-SUBRC NE 0.
      IT_QASR-PRUEFLOS  = 0.
      IT_QASR-VERWMERKM = 'WVTROTR'.
      APPEND IT_QASR.
    ENDIF.
  ENDIF.

  "Sort Data Recording to WVTR and OTR
  IT_QASR_WVTR[] = IT_QASR[].
  IT_QASR_OTR[]  = IT_QASR[].

  DELETE IT_QASR_WVTR WHERE VERWMERKM NS 'WVTR'.
  DELETE IT_QASR_OTR  WHERE VERWMERKM NS 'OTR' AND VERWMERKM NS 'O2TR'.

  "Sorting By Times and Cycle
  SORT IT_QASR_WVTR BY PRUEFDATUV DESCENDING.
  SORT IT_QASR_OTR  BY PRUEFDATUV DESCENDING.

  "Sorting By Times and Cycle
  SORT IT_WVTR BY RANK DESCENDING PRUEFDATUV DESCENDING.
  SORT IT_OTR  BY RANK DESCENDING PRUEFDATUV DESCENDING.

  READ TABLE IT_EST_DATE WITH KEY VALUE = 'WVTR'.
  IF SY-SUBRC EQ 0.
    READ TABLE IT_WVTR INDEX 1.
    IF SY-SUBRC EQ 0 AND ( IT_WVTR-UD EQ V_FAIL OR IT_WVTR-UD EQ V_NOT ).
      IF IT_WVTR-PROBENR EQ 1.
        NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT2.
      ELSEIF IT_WVTR-PROBENR EQ 2.
        NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT3.
      ELSEIF IT_WVTR-PROBENR EQ 3.
        NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT4.
      ENDIF.
    ELSEIF IT_WVTR-UD  EQ V_PASS OR IT_WVTR-UD  EQ V_NCR.
      "Pengecekan jika kondisi sudah OK di posisi 1, tapi posisi 2 belum ada inspection Lot
      READ TABLE IT_QASR WITH KEY VERWMERKM = 'WVTROTR'.
      IF SY-SUBRC EQ 0.
        NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT1.
      ELSE.
        "Pengecekan jika kondisi sudah OK di posisi 1, tapi posisi 2 tidak ada MVTR
        IF BARRIER_POS CS 'R'.
          READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|R|'.
          IF SY-SUBRC EQ 0.
            READ TABLE IT_WVTR WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
            IF SY-SUBRC NE 0.
              NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT1.
            ENDIF.
          ENDIF.
        ENDIF.

        IF BARRIER_POS CS 'C'.
          READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|C|'.
          IF SY-SUBRC EQ 0.
            READ TABLE IT_WVTR WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
            IF SY-SUBRC NE 0.
              NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT1.
            ENDIF.
          ENDIF.
        ENDIF.

        IF BARRIER_POS CS 'L'.
          READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|L|'.
          IF SY-SUBRC EQ 0.
            READ TABLE IT_WVTR WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
            IF SY-SUBRC NE 0.
              NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT1.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ELSE.
      NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT1.
    ENDIF.
  ENDIF.

  READ TABLE IT_EST_DATE WITH KEY VALUE = 'OTR'.
  IF SY-SUBRC EQ 0.
    READ TABLE IT_OTR INDEX 1.
    IF SY-SUBRC EQ 0 AND ( IT_OTR-UD EQ V_FAIL OR IT_OTR-UD EQ V_NOT ).
      IF IT_OTR-PROBENR EQ 1.
        NEXT_OTR = V_DATE + IT_EST_DATE-TEXT2.
      ELSEIF IT_OTR-PROBENR EQ 2.
        NEXT_OTR = V_DATE + IT_EST_DATE-TEXT3.
      ELSEIF IT_OTR-PROBENR EQ 3.
        NEXT_OTR = V_DATE + IT_EST_DATE-TEXT4.
      ENDIF.
    ELSEIF IT_OTR-UD  EQ V_PASS OR IT_OTR-UD  EQ V_NCR.
      READ TABLE IT_QASR WITH KEY VERWMERKM = 'WVTROTR'.
      IF SY-SUBRC EQ 0.
        NEXT_OTR = V_DATE + IT_EST_DATE-TEXT1.
      ELSE.
        IF BARRIER_POS CS 'R'.
          READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|R|'.
          IF SY-SUBRC EQ 0.
            READ TABLE IT_OTR WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
            IF SY-SUBRC NE 0.
              NEXT_OTR = V_DATE + IT_EST_DATE-TEXT1.
            ENDIF.
          ENDIF.
        ENDIF.

        IF BARRIER_POS CS 'C'.
          READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|C|'.
          IF SY-SUBRC EQ 0.
            READ TABLE IT_OTR WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
            IF SY-SUBRC NE 0.
              NEXT_OTR = V_DATE + IT_EST_DATE-TEXT1.
            ENDIF.
          ENDIF.
        ENDIF.

        IF BARRIER_POS CS 'L'.
          READ TABLE IT_PRUEFLOS WITH KEY KTEXTLOS = '|L|'.
          IF SY-SUBRC EQ 0.
            READ TABLE IT_OTR WITH KEY PRUEFLOS = IT_PRUEFLOS-PRUEFLOS.
            IF SY-SUBRC NE 0.
              NEXT_OTR = V_DATE + IT_EST_DATE-TEXT1.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ELSE.
      NEXT_OTR = V_DATE + IT_EST_DATE-TEXT1.
    ENDIF.
  ENDIF.

  "Cek kondisi Fail 4 kali tapi Posisi lain masih outstanding
  READ TABLE IT_WVTR WITH KEY UD = V_FAIL PROBENR = 4.
  IF SY-SUBRC EQ 0.
    V_TIMES = 1.

    DO 3 TIMES.
      READ TABLE IT_WVTR WITH KEY UD = V_FAIL PROBENR = V_TIMES.
      IF SY-SUBRC EQ 0.
        READ TABLE IT_EST_DATE WITH KEY VALUE = 'WVTR'.
        IF SY-SUBRC EQ 0.
          IF IT_WVTR-PROBENR EQ 1.
            NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT2.
          ELSEIF IT_WVTR-PROBENR EQ 2.
            NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT3.
          ELSEIF IT_WVTR-PROBENR EQ 3.
            NEXT_WVTR = V_DATE + IT_EST_DATE-TEXT4.
          ENDIF.
        ENDIF.
      ENDIF.
      ADD 1 TO V_TIMES.
    ENDDO.
  ENDIF.

  READ TABLE IT_OTR WITH KEY UD = V_FAIL PROBENR = 4.
  IF SY-SUBRC EQ 0.
    V_TIMES = 1.

    DO 3 TIMES.
      READ TABLE IT_OTR WITH KEY UD = V_FAIL PROBENR = V_TIMES.
      IF SY-SUBRC EQ 0.
        READ TABLE IT_EST_DATE WITH KEY VALUE = 'OTR'.
        IF SY-SUBRC EQ 0.
          IF IT_OTR-PROBENR EQ 1.
            NEXT_OTR = V_DATE + IT_EST_DATE-TEXT2.
          ELSEIF IT_OTR-PROBENR EQ 2.
            NEXT_OTR = V_DATE + IT_EST_DATE-TEXT3.
          ELSEIF IT_OTR-PROBENR EQ 3.
            NEXT_OTR = V_DATE + IT_EST_DATE-TEXT4.
          ENDIF.
        ENDIF.
      ENDIF.
      ADD 1 TO V_TIMES.
    ENDDO.
  ENDIF.

ENDFORM.                "GET_ESTIMATION_DATE

*&---------------------------------------------------------------------*
*&      Form  GET_CALCULATION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->WERKS      text
*      -->MIC        text
*      -->VERSION    text
*      -->VALUE      text
*      -->UD         text
*----------------------------------------------------------------------*
FORM GET_CALCULATION USING WERKS MIC VERSION VALUE CHANGING UD RANK.
  CLEAR: IT_QPMK.
  SELECT SINGLE * FROM QPMK INTO CORRESPONDING FIELDS OF IT_QPMK WHERE ZAEHLER EQ WERKS AND MKMNR EQ MIC AND VERSION EQ VERSION.
  IF VALUE GE IT_QPMK-TOLERANZUN AND VALUE LE IT_QPMK-SOLLWERT.
    UD = V_PASS.
  ELSEIF VALUE GT IT_QPMK-SOLLWERT AND VALUE LE IT_QPMK-TOLERANZOB.
    UD = V_NCR.
  ELSE.
    UD = V_FAIL.
  ENDIF.

  READ TABLE IT_RANK WITH KEY VCODE = UD.
  IF SY-SUBRC EQ 0.
    RANK = IT_RANK-VALUATION.
  ENDIF.
ENDFORM.                    "GET_CALCULATION

