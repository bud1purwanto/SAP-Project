  CLEAR: V_NAME, THEAD, TLINE.
  REFRESH: TLINE.

  "Check change grade
  V_TEMP_MATNR = MATNR.
  V_TEMP_CHARG = CHARG.
  IF IT_SR_CG[] IS NOT INITIAL.
