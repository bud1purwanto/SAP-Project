      I_CALLBACK_USER_COMMAND  = 'F_USER_COMMAND'
      I_CALLBACK_PF_STATUS_SET = 'F_GUI_STATUS_PREVIEW'
      IS_LAYOUT                = WA_LAYOUT
      IT_FIELDCAT              = T_FIELDCAT[]
      IT_EVENTS                = T_EVENTS[]
      I_DEFAULT                = 'X'
      I_SAVE                   = 'A'
      IS_VARIANT               = WA_VARIANTE
      IS_PRINT                 = T_PRINT
      IT_SORT                  = T_SORT[]
      IT_EXCLUDING             = T_EXCLUDING[]
      I_BYPASSING_BUFFER       = 'X'
    TABLES
      T_OUTTAB                 = ITAB
    EXCEPTIONS
      PROGRAM_ERROR            = 1
      OTHERS                   = 2.
ENDFORM.                    " f_list_detail

*&---------------------------------------------------------------------*
*&      Form  F_USER_COMMAND
*&---------------------------------------------------------------------*
FORM F_USER_COMMAND USING FU_UCOMM LIKE SY-UCOMM
                          FU_SELFIELD TYPE SLIS_SELFIELD.

  CASE FU_UCOMM.
    WHEN 'REFRESH'.
      PERFORM GET_DATA.
    WHEN 'EXEC'.
      PERFORM COLLECT_DATA.
    WHEN 'XLSX'.
      PERFORM DOWNLOAD_TEMPLATE.
  ENDCASE.

  FU_SELFIELD-REFRESH = 'X'.

ENDFORM.                    "F_USER_COMMAND

*&---------------------------------------------------------------------*
*&      Form  DOWNLOAD_TEMPLATE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM DOWNLOAD_TEMPLATE .
  DATA : BEGIN OF IT_TEMPLATE OCCURS 0 ,
           MATNR          TYPE CHAR100, "Material No
           WERKS          TYPE CHAR100, "Plant
           LGORT          TYPE CHAR100, "Storage Location
           CHARG          TYPE CHAR100, "Batch
           TYPE           TYPE CHAR100, "Type (custom)
           THICKNESS      TYPE CHAR100, "Thick
           WIDTH          TYPE CHAR100, "Width
           LENGTH         TYPE CHAR100, "Length
           BL_STOCK_KG    TYPE CHAR100, "Blocked Stock (KG)
           BL_SR          TYPE CHAR100, "Blocked (SR)
           BL_REASON      TYPE CHAR100, "Blocked Reason
           BL_COMMENT     TYPE CHAR100, "Blocked Comment
           ROLL_DERV      TYPE CHAR100, "No Roll & Derivitive
           DERIVITIVE     TYPE CHAR100, "Derivitive
           POSITION       TYPE CHAR100, "Position
*           DEVICE         TYPE CHAR100, "Device
           BARRIER_POS    TYPE CHAR100, "Barrier Position
           TIMES          TYPE CHAR100, "Total Times
           BARRIER_R      TYPE CHAR100, "Barrier Result R
           BARRIER_C      TYPE CHAR100, "Barrier Result C
           BARRIER_L      TYPE CHAR100, "Barrier Result L
           JUDGEMENT      TYPE CHAR100, "Judgement
           NCR_APPROVAL   TYPE CHAR100, "NCR Approval
           WVTR_R         TYPE CHAR100, "WVTR R Position
           WVTR_C         TYPE CHAR100, "WVTR C Position
           WVTR_L         TYPE CHAR100, "WVTR L Position
           OTR_R          TYPE CHAR100, "OTR R Position
           OTR_C          TYPE CHAR100, "OTR C Position
           OTR_L          TYPE CHAR100, "OTR L Position
           END OF IT_TEMPLATE.

  DATA : WA_TEMPLATE LIKE IT_TEMPLATE.

  IF ITAB IS NOT INITIAL.
    WA_TEMPLATE-MATNR           = 'Material'.
    WA_TEMPLATE-WERKS           = 'Plant'.
    WA_TEMPLATE-LGORT           = 'Sloc'.
    WA_TEMPLATE-CHARG           = 'Batch'.
    WA_TEMPLATE-TYPE            = 'Type'.
    WA_TEMPLATE-THICKNESS       = 'Thick'.
    WA_TEMPLATE-WIDTH           = 'Width'.
    WA_TEMPLATE-LENGTH          = 'Length'.
    WA_TEMPLATE-BL_STOCK_KG     = 'Blocked Stock (Kg)'.
    WA_TEMPLATE-BL_SR           = 'Blocked Stock (Roll)'.
    WA_TEMPLATE-BL_REASON       = 'Blocked Reason'.
    WA_TEMPLATE-BL_COMMENT      = 'Blocked Comment'.
    WA_TEMPLATE-ROLL_DERV       = 'Roll'.
    WA_TEMPLATE-DERIVITIVE      = 'Derivative'.
    WA_TEMPLATE-POSITION        = 'Position'.
*    WA_TEMPLATE-DEVICE          = 'Device'.
    WA_TEMPLATE-BARRIER_POS     = 'Barrier Pos'.
    WA_TEMPLATE-TIMES           = 'Times'.
    WA_TEMPLATE-BARRIER_R       = 'Barrier R'.
    WA_TEMPLATE-BARRIER_C       = 'Barrier C'.
    WA_TEMPLATE-BARRIER_L       = 'Barrier L'.
    WA_TEMPLATE-JUDGEMENT       = 'Judgement'.
    WA_TEMPLATE-NCR_APPROVAL    = 'NCR Approval'.
    WA_TEMPLATE-WVTR_R          = 'WVTR-R'.
    WA_TEMPLATE-WVTR_C          = 'WVTR-C'.
    WA_TEMPLATE-WVTR_L          = 'WVTR-L'.
    WA_TEMPLATE-OTR_R           = 'OTR-R'.
    WA_TEMPLATE-OTR_C           = 'OTR-C'.
    WA_TEMPLATE-OTR_L           = 'OTR-L'.
    APPEND WA_TEMPLATE TO IT_TEMPLATE.

    LOOP AT ITAB WHERE ERR EQ ''.
      MOVE-CORRESPONDING ITAB TO WA_TEMPLATE.

*      WA_TEMPLATE-CHARG = '''' && WA_TEMPLATE-CHARG.

      CONDENSE WA_TEMPLATE-MATNR          .
      CONDENSE WA_TEMPLATE-WERKS          .
      CONDENSE WA_TEMPLATE-LGORT          .
      CONDENSE WA_TEMPLATE-CHARG          .
      CONDENSE WA_TEMPLATE-TYPE           .
      CONDENSE WA_TEMPLATE-THICKNESS      .
      CONDENSE WA_TEMPLATE-WIDTH          .
      CONDENSE WA_TEMPLATE-LENGTH         .
      CONDENSE WA_TEMPLATE-BL_STOCK_KG    .
      CONDENSE WA_TEMPLATE-BL_SR          .
      CONDENSE WA_TEMPLATE-BL_REASON      .
      CONDENSE WA_TEMPLATE-BL_COMMENT     .
      CONDENSE WA_TEMPLATE-ROLL_DERV      .
      CONDENSE WA_TEMPLATE-DERIVITIVE     .
      CONDENSE WA_TEMPLATE-POSITION       .
*      CONDENSE WA_TEMPLATE-DEVICE         .
      CONDENSE WA_TEMPLATE-BARRIER_POS    .
      CONDENSE WA_TEMPLATE-TIMES          .
      CONDENSE WA_TEMPLATE-BARRIER_R      .
      CONDENSE WA_TEMPLATE-BARRIER_C      .
      CONDENSE WA_TEMPLATE-BARRIER_L      .
      CONDENSE WA_TEMPLATE-JUDGEMENT      .
      CONDENSE WA_TEMPLATE-NCR_APPROVAL   .
      CONDENSE WA_TEMPLATE-WVTR_R         .
      CONDENSE WA_TEMPLATE-WVTR_C         .
      CONDENSE WA_TEMPLATE-WVTR_L         .
      CONDENSE WA_TEMPLATE-OTR_R          .
      CONDENSE WA_TEMPLATE-OTR_C          .
      CONDENSE WA_TEMPLATE-OTR_L          .

      APPEND WA_TEMPLATE TO IT_TEMPLATE.
    ENDLOOP.

    DATA : OBJFILE TYPE REF TO CL_GUI_FRONTEND_SERVICES,
           PICKEDFOLDER TYPE STRING,
           INITIALFOLDER TYPE STRING,
           LV_FILENAME TYPE STRING .

    CREATE OBJECT OBJFILE.
    OBJFILE->DIRECTORY_BROWSE( EXPORTING    INITIAL_FOLDER        = INITIALFOLDER
                               CHANGING     SELECTED_FOLDER       = PICKEDFOLDER
                               EXCEPTIONS   CNTL_ERROR            = 1
                                            ERROR_NO_GUI          = 2
                                            NOT_SUPPORTED_BY_GUI  = 3 ).

    LV_FILENAME = PICKEDFOLDER && '\' && 'Template_NCR' && '_' && SY-DATUM && '_' && SY-TIMLO && '.xls'.

    IF PICKEDFOLDER IS INITIAL.
      EXIT.
    ENDIF.

    CALL FUNCTION 'GUI_DOWNLOAD'
      EXPORTING
        FILENAME              = LV_FILENAME
        FILETYPE              = 'ASC'
        WRITE_FIELD_SEPARATOR = 'X' " FOR TAB-SEPARATED VALUES
      TABLES
        DATA_TAB              = IT_TEMPLATE
      EXCEPTIONS
        FILE_OPEN_ERROR       = 1
        FILE_WRITE_ERROR      = 2
        INVALID_FILESIZE      = 3
        INVALID_TABLE_WIDTH   = 4
        INVALID_TYPE          = 5
        NO_BATCH              = 6
        UNKNOWN_ERROR         = 7
        OTHERS                = 8.

    IF SY-SUBRC <> 0.
      MESSAGE 'Error during file download' TYPE 'S' DISPLAY LIKE 'E'.
    ELSE.
      CONCATENATE 'File downloaded in' LV_FILENAME INTO V_TEMP SEPARATED BY SPACE.
      MESSAGE V_TEMP TYPE 'S' DISPLAY LIKE 'S'.
    ENDIF.
  ENDIF.
ENDFORM.                    " DOWNLOAD_TEMPLATE

