*&---------------------------------------------------------------------*
*&      Form  CONNECT_SQL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM CONNECT_SQL.

  SAP_CON = S_CONN.

  SELECT SINGLE DBMS
         FROM DBCON
         INTO DBTYPE
         WHERE CON_NAME = SAP_CON.

  IF DBTYPE = 'MSS'.
    TRY .
      EXEC SQL.
        SET CONNECTION :SAP_CON
      ENDEXEC.

      EXEC SQL.
        CONNECT TO :SAP_CON
      ENDEXEC.

      IF SY-SUBRC <> 0.
        MESSAGE 'Not Connected..!!' TYPE 'I'.
        EXIT.
*      ELSE.
*        MESSAGE 'Database SQL Connected' TYPE 'I'.
      ENDIF.
    ENDTRY.
  ELSE.
    MESSAGE 'DBCO Connection not found..!!' TYPE 'I'.
    LEAVE LIST-PROCESSING.
  ENDIF.
ENDFORM.                    "CONNECT_SQL