                S_FILM   FOR AUSP-ATWRT,
                S_CHARG  FOR MCH1-CHARG.
SELECTION-SCREEN END OF BLOCK BLOCK1.

SELECTION-SCREEN BEGIN OF BLOCK BLOCK2 WITH FRAME TITLE TEXT-002.
PARAMETER: P_SCREEN RADIOBUTTON GROUP RB2 MODIF ID SCN USER-COMMAND AC DEFAULT 'X',
           P_OLAP   RADIOBUTTON GROUP RB2 MODIF ID OLP.
SELECTION-SCREEN END OF BLOCK BLOCK2.

SELECTION-SCREEN BEGIN OF BLOCK BLOCK3 WITH FRAME TITLE TEXT-003.
PARAMETERS: P_CONN  LIKE DBCON-CON_NAME MODIF ID CON.
SELECTION-SCREEN END OF BLOCK BLOCK3.

SELECTION-SCREEN BEGIN OF BLOCK BLOCK4 WITH FRAME TITLE TEXT-004 .
PARAMETERS: P_JOB   TYPE CHECK DEFAULT '' NO-DISPLAY.
SELECTION-SCREEN END OF BLOCK BLOCK4.

AT SELECTION-SCREEN OUTPUT.
  AUTHORITY-CHECK OBJECT 'Z_AGS' ID 'ZAGS' FIELD '1'.
  IF SY-SUBRC NE 0.
    LOOP AT SCREEN.
      IF SCREEN-GROUP1 = 'OLP'.
        SCREEN-INPUT = 0.
        SCREEN-ACTIVE = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ENDIF.

  IF P_SCREEN = 'X'.
    LOOP AT SCREEN.
      IF SCREEN-GROUP1 = 'CON'.
        SCREEN-INPUT = 0.
        SCREEN-ACTIVE = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ELSEIF P_OLAP = 'X'.
    LOOP AT SCREEN.
      IF SCREEN-GROUP1 = 'CON'.
        SCREEN-INPUT = 1.
        SCREEN-ACTIVE = 1.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ENDIF.


START-OF-SELECTION.
  IF P_OLAP EQ 'X'.
    IF SY-HOST = 'TRIASWIN2008' OR SY-HOST = 'SAPTRPKR' OR SY-HOST = 'SAPTRPWARU'.
      V_OS = 'WIN'.
    ELSE.
      V_OS = 'LINUX'.
    ENDIF.

    IF P_OLAP = 'X'.
      DATA: DBTYPE TYPE DBCON_DBMS.

      IF P_CONN IS INITIAL.
        MESSAGE 'Masukan DBCO Connection name...!' TYPE 'S' DISPLAY LIKE 'E'.
        LEAVE LIST-PROCESSING.
      ELSE.
        SELECT SINGLE DBMS FROM DBCON INTO DBTYPE WHERE CON_NAME EQ P_CONN.
        IF SY-SUBRC NE 0.
          MESSAGE 'DBCO Connection not found..!!' TYPE 'S' DISPLAY LIKE 'E'.
          LEAVE LIST-PROCESSING.
        ENDIF.
      ENDIF.
    ENDIF.

    IF V_OS EQ 'LINUX'.
      PERFORM F_SQL_JOB.
    ENDIF.
  ENDIF.

  IF ( P_SCREEN EQ 'X' OR ( P_OLAP EQ 'X' AND V_OS EQ 'WIN' ) ) AND P_JOB EQ ''.
    PERFORM GET_BASE_DATA.
    PERFORM GET_ADDITIONAL_DATA.
    PERFORM GET_CHAR_BASE.
    PERFORM FILL_SCRAP_DATA.
    PERFORM GET_SURFACE_DATA.

    IF P_SCREEN EQ 'X'.
      PERFORM DISPLAY_DATA.
    ELSEIF P_OLAP = 'X'.
      PERFORM F_SQL_SEND.
    ENDIF.
  ENDIF.

END-OF-SELECTION.
*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GET_BASE_DATA.
  DATA : LV_LIMIT_CG TYPE I VALUE 1.
  REFRESH: IT_AUSP, IT_OBJEK, IT_OBJEK2, IT_AUFNR_COM, IT_AUFNR_ORI, IT_ABLAD.
  CLEAR: IT_AUSP, IT_OBJEK, IT_OBJEK2, IT_AUFNR_COM, IT_AUFNR_ORI, IT_ABLAD.

  PERFORM GET_CABN.
  PERFORM GET_MAPPING.

  IF S_CHARG[] IS NOT INITIAL.
    R_BATCH[] = S_CHARG[].
  ENDIF.

  "Convert Roll to Batch
  IF S_NOROL[] IS NOT INITIAL OR S_ROLTYB[] IS NOT INITIAL.
    IF S_NOROL[] IS NOT INITIAL.
      SELECT ATWRT OBJEK APPENDING CORRESPONDING FIELDS OF TABLE IT_AUSP
        FROM AUSP
       WHERE AUSP~ATWRT IN S_NOROL
          AND AUSP~KLART EQ '023'
          AND AUSP~MAFID EQ 'O'
          AND AUSP~ATINN EQ V_ZZNOMORROLL %_HINTS ORACLE 'INDEX("AUSP" "AUSP~N1")'.
    ELSEIF S_ROLTYB[] IS NOT INITIAL.
      SELECT ATWRT OBJEK APPENDING CORRESPONDING FIELDS OF TABLE IT_AUSP
        FROM AUSP
       WHERE AUSP~ATWRT IN S_ROLTYB
          AND AUSP~KLART EQ '023'
          AND AUSP~MAFID EQ 'O'
          AND AUSP~ATINN EQ V_ZZNOROLLTOYOBO %_HINTS ORACLE 'INDEX("AUSP" "AUSP~N1")'.
    ENDIF.

    IF IT_AUSP[] IS NOT INITIAL.
      LOOP AT IT_AUSP.
        IT_AUSP-CUOBJ = IT_AUSP-OBJEK.
        MODIFY IT_AUSP.
        CLEAR IT_AUSP.
      ENDLOOP.

      SELECT CHARG AS LOW APPENDING CORRESPONDING FIELDS OF TABLE R_BATCH
        FROM MCH1
         FOR ALL ENTRIES IN IT_AUSP
       WHERE CUOBJ_BM EQ IT_AUSP-CUOBJ
         AND FVDT1    EQ '00000000'
         AND CHARG    IN R_BATCH %_HINTS  ORACLE 'INDEX("MCH1" "MCH1~Z06")'.
    ELSE.
      SY-SUBRC = 4.
    ENDIF.

    IF SY-SUBRC EQ 0.
      R_BATCH-SIGN   = 'I'.
      R_BATCH-OPTION = 'EQ'.
      MODIFY R_BATCH TRANSPORTING SIGN OPTION WHERE SIGN IS INITIAL.
    ELSE.
      CLEAR: R_BATCH.
      REFRESH: R_BATCH.
      R_BATCH-LOW     = 'XXXXXXXXXX'.
      R_BATCH-SIGN   = 'I'.
      R_BATCH-OPTION = 'EQ'.
      APPEND R_BATCH.
    ENDIF.
  ENDIF.

  "Filter Material
  SELECT MARA~MATNR AS LOW INTO CORRESPONDING FIELDS OF TABLE R_MATNR
    FROM MARA
    JOIN MARC ON MARC~MATNR EQ MARA~MATNR
   WHERE MARC~WERKS EQ S_WERKS
     AND MARA~MATKL LIKE '3%'
     AND MARA~LVORM = ''.

  IF R_MATNR[] IS NOT INITIAL.
    R_MATNR-SIGN    = 'I'.
    R_MATNR-OPTION  = 'EQ'.
    MODIFY R_MATNR TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  DELETE R_MATNR WHERE LOW CP '*O'. "Delete material O. Add by Fany (20.10.2026)

  PERFORM SET_INDICATOR USING 1 1 1 V_PROC_EX 'Get Slit Roll Data...'.

  "Get GRN SR
  SELECT MCH1~CUOBJ_BM AS OBJEK MCH1~CHARG MCH1~MATNR MKPF~BUDAT MSEG~WERKS MSEG~MBLNR MSEG~ZEILE
         MSEG~BWART MSEG~SMBLN MSEG~SMBLP MSEG~MENGE MSEG~AUFNR MSEG~ABLAD
    INTO CORRESPONDING FIELDS OF TABLE IT_OBJEK
    FROM MKPF
    JOIN MSEG ON MKPF~MBLNR EQ MSEG~MBLNR AND MKPF~MJAHR EQ MSEG~MJAHR
    JOIN MCH1 ON MSEG~CHARG EQ MCH1~CHARG
   WHERE MSEG~CHARG IN R_BATCH
     AND MKPF~BUDAT IN S_GSTRP
     AND MSEG~WERKS EQ S_WERKS
     AND MSEG~BWART EQ 101.

  DELETE IT_OBJEK WHERE MATNR NOT IN R_MATNR.

  IF IT_OBJEK[] IS NOT INITIAL.

    PERFORM SET_INDICATOR USING 1 1 2 V_PROC_EX 'Get Cancellation Data...'.

    "Get Data Cancellation
    SELECT MCH1~CUOBJ_BM AS OBJEK MCH1~CHARG MCH1~MATNR MSEG~BUDAT_MKPF AS BUDAT MSEG~WERKS MSEG~MBLNR MSEG~ZEILE
           MSEG~BWART  MSEG~SMBLN MSEG~SMBLP MSEG~MENGE MSEG~AUFNR MSEG~ABLAD
      INTO CORRESPONDING FIELDS OF TABLE IT_OBJEK2
      FROM MSEG
      JOIN MCH1 ON MCH1~CHARG EQ MSEG~CHARG
       FOR ALL ENTRIES IN IT_OBJEK
     WHERE MCH1~CHARG EQ IT_OBJEK-CHARG
       AND MSEG~BWART EQ 102 %_HINTS ORACLE 'INDEX("MSEG" "MSEG~Z07")'.

    DESCRIBE TABLE IT_OBJEK2 LINES V_TFILL.

    "Delete cancellation batch
    LOOP AT IT_OBJEK2.
      PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 3 V_PROC_EX 'Check SR Cancellation...'.

      DELETE IT_OBJEK WHERE MBLNR = IT_OBJEK2-SMBLN AND ZEILE = IT_OBJEK2-SMBLP.

      "Mark Cancellation
      IF SY-SUBRC EQ 0.
        R_CANCEL-LOW    = IT_OBJEK2-CHARG.
        R_CANCEL-SIGN   = 'I'.
        R_CANCEL-OPTION = 'EQ'.
        APPEND R_CANCEL.
        CLEAR R_CANCEL.
      ENDIF.
    ENDLOOP.

    LOOP AT IT_OBJEK WHERE AUFNR IS NOT INITIAL.
      R_AUFNR_SR-SIGN   = 'I'.
      R_AUFNR_SR-OPTION = 'EQ'.
      R_AUFNR_SR-LOW    = IT_OBJEK-AUFNR.
      COLLECT R_AUFNR_SR.
      CLEAR : R_AUFNR_SR.

      R_EXEC-LOW        = IT_OBJEK-CHARG.
      R_EXEC-SIGN       = 'I'.
      R_EXEC-OPTION     = 'EQ'.
      APPEND R_EXEC.
      CLEAR R_EXEC.
    ENDLOOP.
  ENDIF.

  "Mark Real Canellation (Not for Reexecute)
  DELETE R_CANCEL WHERE LOW IN R_EXEC.

  IF R_CANCEL[] IS INITIAL.
    R_CANCEL-LOW        = '*'.
    R_CANCEL-SIGN       = 'I'.
    R_CANCEL-OPTION     = 'EQ'.
    APPEND R_CANCEL.
    CLEAR R_CANCEL.
  ENDIF.

  PERFORM SET_INDICATOR USING 1 1 4 V_PROC_EX 'Get Scrap Data...'.

  "Filter Material JR
  SELECT MARA~MATNR AS LOW APPENDING CORRESPONDING FIELDS OF TABLE R_MATNR
    FROM MARA
    JOIN MARC ON MARC~MATNR EQ MARA~MATNR
   WHERE MARC~WERKS EQ S_WERKS
     AND MARA~MATKL LIKE '4%'
     AND MARA~LVORM = ''.

  IF R_MATNR[] IS NOT INITIAL.
    R_MATNR-SIGN    = 'I'.
    R_MATNR-OPTION  = 'EQ'.
    MODIFY R_MATNR TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  "Get Data Scrap
  REFRESH: IT_MSEG_SCRAP.
  SELECT MSEG~MBLNR MSEG~MJAHR MSEG~ZEILE MSEG~SMBLN MSEG~SMBLP MSEG~BWART MATNR CHARG
         MSEG~WERKS MSEG~LGORT MSEG~MENGE MSEG~AUFNR MSEG~ABLAD MSEG~BUDAT_MKPF AS BUDAT
    INTO CORRESPONDING FIELDS OF TABLE IT_MSEG_SCRAP
    FROM MKPF
    JOIN MSEG ON MKPF~MBLNR = MSEG~MBLNR AND MKPF~MJAHR = MSEG~MJAHR
   WHERE MSEG~BWART EQ 261
     AND MSEG~CHARG IN R_BATCH
     AND MKPF~BUDAT IN S_GSTRP
     AND MSEG~WERKS EQ S_WERKS
     AND MSEG~XBLNR_MKPF NOT LIKE 'SCR%'.

  DELETE IT_MSEG_SCRAP WHERE MATNR NOT IN R_MATNR.
  DELETE IT_MSEG_SCRAP WHERE CHARG IS INITIAL.

  IF IT_MSEG_SCRAP[] IS NOT INITIAL.
    PERFORM SET_INDICATOR USING 1 1 5 V_PROC_EX 'Get Scrap Cancellation...'.

    "Get Data Cancellation
    SELECT MSEG~MBLNR MSEG~MJAHR MSEG~ZEILE MSEG~SMBLN MSEG~SMBLP MSEG~BWART MATNR CHARG
           MSEG~WERKS MSEG~LGORT MSEG~MENGE MSEG~AUFNR MSEG~ABLAD MSEG~BUDAT_MKPF AS BUDAT
      INTO CORRESPONDING FIELDS OF TABLE IT_MSEG_SCRAP2
      FROM MSEG
       FOR ALL ENTRIES IN IT_MSEG_SCRAP
     WHERE MSEG~CHARG EQ IT_MSEG_SCRAP-CHARG
       AND MSEG~BWART EQ 262 %_HINTS ORACLE 'INDEX("MSEG" "MSEG~Z07")'.

    DESCRIBE TABLE IT_MSEG_SCRAP2 LINES V_TFILL.
    "Delete cancellation batch
    LOOP AT IT_MSEG_SCRAP2.
      PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 6 V_PROC_EX 'Check Scrap Cancellation...'.

      DELETE IT_MSEG_SCRAP WHERE MBLNR = IT_MSEG_SCRAP2-SMBLN AND ZEILE = IT_MSEG_SCRAP2-SMBLP.
    ENDLOOP.

    IF R_AUFNR_SR[] IS NOT INITIAL.
      DELETE IT_MSEG_SCRAP WHERE AUFNR IN R_AUFNR_SR.
    ENDIF.
  ENDIF.

  "Search Scrap based on Order & Vendor Batch
  LOOP AT IT_MSEG_SCRAP WHERE AUFNR IS NOT INITIAL.
    R_AUFNR_CX-SIGN     = 'I'.
    R_AUFNR_CX-OPTION   = 'EQ'.
    R_AUFNR_CX-LOW      = IT_MSEG_SCRAP-AUFNR.
    COLLECT R_AUFNR_CX.
    CLEAR : R_AUFNR_CX.
  ENDLOOP.

  PERFORM SET_INDICATOR USING 1 1 7 V_PROC_EX 'Collecting Scrap Data...'.

  IF R_AUFNR_CX[] IS NOT INITIAL.
    CLEAR: R_MILLOC.
    REFRESH: R_MILLOC.

    SELECT AFPO~MILL_OC_AUFNR_U AS LOW
      INTO CORRESPONDING FIELDS OF TABLE R_MILLOC
      FROM AFPO
     WHERE AFPO~AUFNR IN R_AUFNR_CX.

    R_MILLOC-SIGN       = 'I'.
    R_MILLOC-OPTION     = 'EQ'.
    MODIFY R_MILLOC TRANSPORTING SIGN OPTION WHERE SIGN = ''.
    DELETE R_MILLOC WHERE LOW = ''.

    SELECT MCH1~CUOBJ_BM AS OBJEK MCH1~MATNR MCH1~CHARG MCH1~ERSDA AS BUDAT MCH1~LICHA AS AUFNR
      INTO CORRESPONDING FIELDS OF TABLE IT_SCRAP
      FROM MCH1
     WHERE MCH1~LICHA IN R_AUFNR_CX
       AND MCH1~CHARG IN R_BATCH.
  ENDIF.

  IF R_MILLOC[] IS NOT INITIAL.
    SELECT MCH1~CUOBJ_BM AS OBJEK MCH1~MATNR MCH1~CHARG MCH1~ERSDA AS BUDAT MCH1~LICHA AS AUFNR
      APPENDING CORRESPONDING FIELDS OF TABLE IT_SCRAP
      FROM MCH1
     WHERE MCH1~LICHA IN R_MILLOC
       AND MCH1~CHARG IN R_BATCH.
  ENDIF.

  "Get Data Scrap CX
  IF R_AUFNR_CX[] IS NOT INITIAL.
    PERFORM SET_INDICATOR USING 1 1 8 V_PROC_EX 'Get CX Data...'.

    REFRESH: IT_CX.
    SELECT MSEG~MBLNR MSEG~MJAHR MSEG~ZEILE MSEG~SMBLN MSEG~SMBLP MSEG~BWART CHARG
           MSEG~WERKS MSEG~LGORT MSEG~MENGE MSEG~AUFNR MSEG~ABLAD MSEG~BUDAT_MKPF AS BUDAT
      INTO CORRESPONDING FIELDS OF TABLE IT_CX
      FROM MSEG
     WHERE MSEG~BWART IN (531, 532)
       AND AUFNR IN R_AUFNR_CX
       AND LGORT IN R_SLOCCX.

    IT_CX2[] = IT_CX[].
    DELETE IT_CX2 WHERE SMBLN IS INITIAL.

    DESCRIBE TABLE IT_CX2 LINES V_TFILL.
    "Delete cancellation batch
    LOOP AT IT_CX2.
      PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 9 V_PROC_EX 'Check CX Cancellation...'.

      DELETE IT_CX WHERE MBLNR = IT_CX2-SMBLN AND ZEILE = IT_CX2-SMBLP.
    ENDLOOP.

    DELETE IT_CX WHERE SMBLN IS NOT INITIAL OR BWART EQ 532.
  ENDIF.

  "Combine data SR & Scrap
  LOOP AT IT_SCRAP .
    "Pengecekan material CX untuk case pernah cancel
    IF IT_SCRAP-CHARG IN R_CANCEL.
      SELECT SINGLE AUFNR INTO IT_SCRAP-AUFNR2 FROM AFPO WHERE MILL_OC_AUFNR_U = IT_SCRAP-AUFNR.
      READ TABLE IT_CX WITH KEY AUFNR = IT_SCRAP-AUFNR2.
      IF SY-SUBRC NE 0.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF IT_SCRAP-MATNR CP '*O'.
      CONTINUE.
    ENDIF.

    READ TABLE IT_OBJEK WITH KEY CHARG = IT_SCRAP-CHARG.
    IF SY-SUBRC NE 0.
      MOVE-CORRESPONDING IT_SCRAP TO IT_OBJEK.

      IT_OBJEK-WERKS = S_WERKS.
      IT_OBJEK-SCRAP = 'X'.

      APPEND IT_OBJEK.
      CLEAR IT_OBJEK.
    ENDIF.
  ENDLOOP.
  "End Get Data CX

  IT_AUFNR_ORI[] = IT_OBJEK[].
  SORT IT_AUFNR_ORI BY AUFNR.
  DELETE ADJACENT DUPLICATES FROM IT_AUFNR_ORI COMPARING AUFNR.
  DELETE IT_AUFNR_ORI WHERE AUFNR IS INITIAL.

  "Get MS/SS
  IF IT_AUFNR_ORI[] IS NOT INITIAL.
    SELECT * FROM AFPO
      INTO CORRESPONDING FIELDS OF TABLE IT_AUFNR_COM
       FOR ALL ENTRIES IN IT_AUFNR_ORI
     WHERE MILL_OC_AUFNR_U = IT_AUFNR_ORI-AUFNR.

    DELETE IT_AUFNR_COM WHERE AUFNR IS INITIAL.

    IT_ORDER[] = IT_AUFNR_COM[].

    SORT IT_ORDER BY AUFNR.
    DELETE ADJACENT DUPLICATES FROM IT_ORDER COMPARING AUFNR.

    IF IT_ORDER[] IS NOT INITIAL.
      SELECT * FROM AFPO
      INTO CORRESPONDING FIELDS OF TABLE IT_ABLAD
       FOR ALL ENTRIES IN IT_ORDER
     WHERE AUFNR = IT_ORDER-AUFNR.
    ENDIF.

    DELETE IT_ABLAD WHERE ABLAD IS INITIAL.
  ENDIF.

  IF IT_OBJEK[] IS INITIAL.
    MESSAGE 'Data not found!' TYPE 'S' DISPLAY LIKE 'E'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  PERFORM SET_INDICATOR USING 1 1 10 V_PROC_EX 'Get Characteristic Data...'.

  "Get Characteristic
  SELECT AUSP~OBJEK AUSP~ATWRT AUSP~ATINN AUSP~ATFLV
    INTO CORRESPONDING FIELDS OF TABLE IT_CHARACTERISTIC
    FROM AUSP
     FOR ALL ENTRIES IN IT_OBJEK
   WHERE AUSP~KLART EQ '023'
     AND AUSP~MAFID EQ 'O'
     AND AUSP~OBJEK EQ IT_OBJEK-OBJEK
     AND AUSP~ATINN IN (V_ZZTYPE, V_ZZNOMORROLL, V_ZZNOROLLTOYOBO, V_ZZNOLOTTOYOBO, V_ZZCODE, V_ZZCRIT, V_ZZPRODLINE,
                        V_ZZWIDTH, V_ZZLENGTH, V_ZZCONVERSIONROLLKG, V_ZZDERIVATIVEMS, V_ZZPOSITIONMS, V_ZZTYBCOMBINATIONNO,
                        V_ZZEXLENGTH, V_ZZEXLENGTHASAL, V_ZZEXTRALENGTHASAL, V_ZZGRAMMAGE, V_ZZDERIVATIVESS, V_ZZPOSITIONSS).

  "Get Description Char
  SELECT CAWNT~ATINN ATWRT ATWTB
    INTO CORRESPONDING FIELDS OF TABLE IT_CHAR_DESC
    FROM CAWN
    JOIN CAWNT ON CAWN~ATINN  EQ CAWNT~ATINN AND CAWN~ATZHL EQ CAWNT~ATZHL
   WHERE CAWN~ATINN  IN (V_ZZCRIT, V_ZZCODE)
     AND CAWNT~SPRAS EQ 'E'.

  "Get Data Barrier
  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_ZLOG_BARRIER
    FROM ZLOG_BARRIER
     FOR ALL ENTRIES IN IT_OBJEK
   WHERE CHARG    EQ IT_OBJEK-CHARG
     AND DELETION EQ ''.

  IF IT_OBJEK[] IS NOT INITIAL.
    PERFORM SET_INDICATOR USING 1 1 11 V_PROC_EX 'Get Change Grade Data...'.
    DATA : T_SR TYPE TABLE OF ZQM_GET_BATCH_SR WITH HEADER LINE.
    LOOP AT IT_OBJEK.
      T_SR-CHARG = IT_OBJEK-CHARG.
      T_SR-MATNR = IT_OBJEK-MATNR.
      T_SR-BUDAT = IT_OBJEK-BUDAT.
      APPEND T_SR.
    ENDLOOP.
*    " Get data change grade NEW. Added by Fany (20.10.2026)
     CALL FUNCTION 'ZQM_GET_BATCH_CHANGE_GRADE'
        EXPORTING
          V_WERKS = S_WERKS
        TABLES
          T_SR = T_SR
          T_ZBATCHISTORY = IT_ZBATCHISTORY.

    IF IT_ZBATCHISTORY[] IS NOT INITIAL.
       "Get Data Barrier after change grade. Add by Fany (14.10.2026)
        SELECT * APPENDING CORRESPONDING FIELDS OF TABLE IT_ZLOG_BARRIER
          FROM ZLOG_BARRIER
           FOR ALL ENTRIES IN IT_ZBATCHISTORY
         WHERE CHARG    EQ IT_ZBATCHISTORY-CHARG
           AND DELETION EQ ''.
    ENDIF.

    CLEAR : IT_MBLNR.
    REFRESH : IT_MBLNR.
    IF IT_ZBATCHISTORY[] IS NOT INITIAL.
      "Get Characteristic Final
      SELECT AUSP~OBJEK
             CHARG
             AUSP~ATINN AS ATINN
             AUSP~ATWRT AS ATWRT
             AUSP~ATFLV AS ATFLV
        FROM MCH1
        JOIN AUSP  ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
        APPENDING CORRESPONDING FIELDS OF TABLE IT_CHARACTERISTIC
         FOR ALL ENTRIES IN IT_ZBATCHISTORY
       WHERE MATNR EQ IT_ZBATCHISTORY-MATNR
         AND CHARG EQ IT_ZBATCHISTORY-NCHARG
         AND KLART EQ '023'
         AND AUSP~ATINN IN (V_ZZTYPE, V_ZZNOMORROLL, V_ZZNOROLLTOYOBO, V_ZZNOLOTTOYOBO, V_ZZCODE, V_ZZCRIT, V_ZZPRODLINE,
                            V_ZZWIDTH, V_ZZLENGTH, V_ZZCONVERSIONROLLKG, V_ZZDERIVATIVEMS, V_ZZPOSITIONMS, V_ZZTYBCOMBINATIONNO,
                            V_ZZEXLENGTH, V_ZZEXLENGTHASAL, V_ZZEXTRALENGTHASAL, V_ZZGRAMMAGE, V_ZZDERIVATIVESS, V_ZZPOSITIONSS).

    ENDIF.
  ENDIF.

  CLEAR : V_COUNTER,V_TFILL.
  DESCRIBE TABLE IT_OBJEK LINES V_TFILL.

  "Remove SR after subcont. Added by Fany (21.09.2026)
  CLEAR : IT_MSEG.
  REFRESH : IT_MSEG.

  IF IT_OBJEK[] IS NOT INITIAL.
    SELECT AUFNR MBLNR MJAHR ZEILE CPUDT_MKPF CPUTM_MKPF SMBLN SJAHR SMBLP BWART LIFNR CHARG MENGE
       INTO CORRESPONDING FIELDS OF TABLE IT_MSEG
       FROM MSEG
      FOR ALL ENTRIES IN IT_OBJEK
      WHERE BWART IN (543, 541) "Mvt Subcont
        AND MBLNR EQ IT_OBJEK-MBLNR.

     SELECT AUFNR MBLNR MJAHR ZEILE CPUDT_MKPF CPUTM_MKPF SMBLN SJAHR SMBLP BWART LIFNR CHARG MENGE
       APPENDING CORRESPONDING FIELDS OF TABLE IT_MSEG
       FROM MSEG
      FOR ALL ENTRIES IN IT_OBJEK
      WHERE BWART IN (543, 541) "Mvt Subcont
        AND CHARG EQ IT_OBJEK-CHARG.

    IF IT_MSEG[] IS NOT INITIAL.
      LOOP AT IT_MSEG.
          READ TABLE IT_OBJEK WITH KEY CHARG = IT_MSEG-CHARG.
          IF SY-SUBRC EQ 0.
            DELETE IT_OBJEK WHERE CHARG = IT_MSEG-CHARG.
          ENDIF.

          READ TABLE IT_OBJEK WITH KEY MBLNR = IT_MSEG-MBLNR.
          IF SY-SUBRC EQ 0.
            DELETE IT_OBJEK WHERE MBLNR = IT_MSEG-MBLNR.
          ENDIF.
      ENDLOOP.

      CLEAR : IT_MSEG.
      REFRESH : IT_MSEG.
    ENDIF.
  ENDIF.

  LOOP AT IT_OBJEK.
    CLEAR: V_LINE, V_CODE, V_MOYE, V_SEQ, V_GRADE, V_DMS, V_PMS, V_DSS, V_PSS.

    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 12 V_PROC_EX 'Collecting Characteristic Data...'.

    READ TABLE IT_AUFNR_COM WITH KEY MILL_OC_AUFNR_U = IT_OBJEK-AUFNR.
    IF SY-SUBRC EQ 0.
      READ TABLE IT_ABLAD WITH KEY AUFNR = IT_AUFNR_COM-AUFNR.
      IF SY-SUBRC EQ 0.
        IF IT_ABLAD-ABLAD EQ 'MS'.
          WA_DISPLAY-ABLAD = 'First'.
        ELSEIF IT_ABLAD-ABLAD EQ 'SS'.
          WA_DISPLAY-ABLAD = 'Second'.
        ENDIF.
      ENDIF.
      WA_DISPLAY-AUFNR      = IT_AUFNR_COM-AUFNR.
    ELSE. "Set ABLAD for new change grade batch. Added by Fany (07.10.2026)
      READ TABLE IT_CHARACTERISTIC WITH KEY OBJEK = IT_OBJEK-OBJEK ATINN = V_ZZDERIVATIVEMS.
      IF SY-SUBRC EQ 0.
        WA_DISPLAY-ABLAD = 'First'.
      ENDIF.

      READ TABLE IT_CHARACTERISTIC WITH KEY OBJEK = IT_OBJEK-OBJEK ATINN = V_ZZDERIVATIVESS.
      IF SY-SUBRC EQ 0.
        WA_DISPLAY-ABLAD = 'Second'.
      ENDIF.

      WA_DISPLAY-AUFNR      = IT_OBJEK-AUFNR.
    ENDIF.

    WA_DISPLAY-CHARG      = IT_OBJEK-CHARG.
    WA_DISPLAY-WERKS      = IT_OBJEK-WERKS.
    WA_DISPLAY-MATNR      = IT_OBJEK-MATNR.
    WA_DISPLAY-PROD_DATE  = IT_OBJEK-BUDAT.

    "Change Grade
    READ TABLE IT_ZBATCHISTORY WITH KEY CHARG = WA_DISPLAY-CHARG.
    IF SY-SUBRC EQ 0.

      IF IT_ZBATCHISTORY-NCHARG IS NOT INITIAL.
        WA_DISPLAY-CHARG_OLD  = WA_DISPLAY-CHARG.
        WA_DISPLAY-CG         = 'X'.

        WA_DISPLAY-CHARG      = IT_ZBATCHISTORY-NCHARG.
      ENDIF.

      READ TABLE IT_CHARACTERISTIC WITH KEY CHARG = WA_DISPLAY-CHARG.
      IF SY-SUBRC EQ 0.
        IT_OBJEK-OBJEK = IT_CHARACTERISTIC-OBJEK.
      ENDIF.
    ENDIF.

    LOOP AT IT_CHARACTERISTIC WHERE OBJEK = IT_OBJEK-OBJEK.
      CASE IT_CHARACTERISTIC-ATINN.
        WHEN V_ZZTYPE.
          WA_DISPLAY-TYPE           = IT_CHARACTERISTIC-ATWRT.

          READ TABLE IT_KIND WITH KEY VALUE = WA_DISPLAY-TYPE.
          IF SY-SUBRC EQ 0.
            WA_DISPLAY-KIND = IT_KIND-TEXT1.
          ENDIF.
        WHEN V_ZZGRADE.
          WA_DISPLAY-GRADE          = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZNOROLLTOYOBO.
          WA_DISPLAY-ROLL_TYB       = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZNOLOTTOYOBO.
          WA_DISPLAY-LOT_TYB        = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZTYBCOMBINATIONNO.
          WA_DISPLAY-COMBINATIONNO  = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZPRODLINE.
          WA_DISPLAY-PRODLINE       = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZDERIVATIVEMS.
          WA_DISPLAY-DERIVATIVE_MS  = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZPOSITIONMS.
          WA_DISPLAY-POSITION_MS    = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZDERIVATIVESS.
          WA_DISPLAY-DERIVATIVE_SS  = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZPOSITIONSS.
          WA_DISPLAY-POSITION_SS    = IT_CHARACTERISTIC-ATWRT.
        WHEN V_ZZWIDTH.
          WA_DISPLAY-WIDTH          = IT_CHARACTERISTIC-ATFLV.
        WHEN V_ZZGRAMMAGE.
          WA_DISPLAY-GRAMMAGE       = IT_CHARACTERISTIC-ATFLV.
        WHEN V_ZZCODE.
          READ TABLE IT_CHAR_DESC WITH KEY ATWRT = IT_CHARACTERISTIC-ATWRT ATINN = V_ZZCODE.
          IF SY-SUBRC EQ 0.
            WA_DISPLAY-CODE         = IT_CHAR_DESC-ATWTB.
            WA_DISPLAY-CODE2        = IT_CHARACTERISTIC-ATWRT.
          ENDIF.
        WHEN V_ZZNOMORROLL.
          WA_DISPLAY-ROLL_SR_SAP    = IT_CHARACTERISTIC-ATWRT.

          SPLIT IT_CHARACTERISTIC-ATWRT AT SPACE INTO V_LINE V_CODE V_MOYE V_SEQ V_GRADE V_DMS V_PMS V_DSS V_PSS.
          IF IT_ABLAD-ABLAD EQ 'MS'.
            CONCATENATE V_LINE V_CODE V_MOYE V_SEQ V_DMS V_PMS INTO WA_DISPLAY-ROLL_SR SEPARATED BY SPACE.
          ELSE.
            CONCATENATE V_LINE V_CODE V_MOYE V_SEQ V_DMS V_PMS V_DSS V_PSS INTO WA_DISPLAY-ROLL_SR SEPARATED BY SPACE.
          ENDIF.
          CONCATENATE V_LINE V_CODE V_MOYE V_SEQ INTO WA_DISPLAY-INPUT_ROLL SEPARATED BY SPACE.
        WHEN V_ZZCRIT.
          READ TABLE IT_CHAR_DESC WITH KEY ATWRT = IT_CHARACTERISTIC-ATWRT ATINN = V_ZZCRIT.
          IF SY-SUBRC EQ 0.
            WA_DISPLAY-CRIT_GRADE   = IT_CHAR_DESC-ATWTB.
          ENDIF.
        WHEN V_ZZLENGTH.
          WA_DISPLAY-LENGTH = IT_CHARACTERISTIC-ATFLV.
        WHEN V_ZZCONVERSIONROLLKG.
          WA_DISPLAY-QTY = IT_CHARACTERISTIC-ATFLV.
        WHEN V_ZZEXLENGTH.
          IF WA_DISPLAY-EXTRA_LENGTH IS INITIAL.
            WA_DISPLAY-EXTRA_LENGTH = IT_CHARACTERISTIC-ATWRT.
            CONDENSE WA_DISPLAY-EXTRA_LENGTH NO-GAPS.
          ENDIF.
        WHEN V_ZZEXLENGTHASAL.
          IF WA_DISPLAY-EXTRA_LENGTH IS INITIAL.
            WA_DISPLAY-EXTRA_LENGTH = IT_CHARACTERISTIC-ATWRT.
            CONDENSE WA_DISPLAY-EXTRA_LENGTH NO-GAPS.
          ENDIF.
        WHEN V_ZZEXTRALENGTHASAL.
          IF WA_DISPLAY-EXTRA_LENGTH IS INITIAL.
            WA_DISPLAY-EXTRA_LENGTH = IT_CHARACTERISTIC-ATWRT.
            CONDENSE WA_DISPLAY-EXTRA_LENGTH NO-GAPS.
          ENDIF.
      ENDCASE.
    ENDLOOP.

    SPLIT IT_OBJEK-ABLAD AT '/' INTO IT_OBJEK-ABLAD V_TEMP.

*    IF WA_DISPLAY-CRIT_GRADE NE 'Rw - Rs'.
*      IF WA_DISPLAY-LENGTH EQ 0 OR WA_DISPLAY-LENGTH LT IT_OBJEK-ABLAD.
*        WA_DISPLAY-LENGTH = IT_OBJEK-ABLAD.
*
*        PERFORM GET_WEIGHT USING WA_DISPLAY-LENGTH WA_DISPLAY-WIDTH WA_DISPLAY-GRAMMAGE CHANGING WA_DISPLAY-QTY.
*      ENDIF.
*    ENDIF.

    "Case selisih Scrap
    IF IT_OBJEK-SCRAP EQ 'X'.
      WA_DISPLAY-QTY = ( WA_DISPLAY-LENGTH * WA_DISPLAY-WIDTH * WA_DISPLAY-GRAMMAGE ) / 1000000.

      READ TABLE IT_AUFNR_COM WITH KEY MILL_OC_AUFNR_U = IT_OBJEK-AUFNR.
      IF SY-SUBRC EQ 0.
        READ TABLE IT_CX WITH KEY AUFNR = IT_AUFNR_COM-AUFNR.
        IF SY-SUBRC EQ 0.
          WA_DISPLAY-PROD_DATE = IT_CX-BUDAT.
        ENDIF.
      ENDIF.
    ENDIF.

    CLEAR: V_CHARG.
    LV_LIMIT_CG = 1.
    V_CHARG = WA_DISPLAY-CHARG.
    DO. "Trace last batch after change grade. Add by Fany (14.10.2026)
         READ TABLE IT_ZBATCHISTORY INTO WA_ZBATCHISTORY WITH KEY  NCHARG = V_CHARG.
         IF SY-SUBRC NE 0.
            EXIT.
         ENDIF.

         V_MATNR = WA_ZBATCHISTORY-MATNR.
         V_CHARG = WA_ZBATCHISTORY-CHARG.

         LV_LIMIT_CG = LV_LIMIT_CG + 1.

         IF LV_LIMIT_CG > LINES( IT_ZBATCHISTORY ).
            EXIT.
         ENDIF.
     ENDDO.
*    IF WA_DISPLAY-CG IS INITIAL.
*      V_CHARG = WA_DISPLAY-CHARG.
*    ELSE.
*      V_CHARG = WA_DISPLAY-CHARG_OLD.
*    ENDIF.

    READ TABLE IT_ZLOG_BARRIER WITH KEY CHARG = V_CHARG.
    IF SY-SUBRC EQ 0.
      WA_DISPLAY-JUDGE = IT_ZLOG_BARRIER-JUDGEMENT.

      IF WA_DISPLAY-JUDGE EQ 'NCR'.
        IF IT_ZLOG_BARRIER-NCRAPPROVAL EQ 'Approved'.
          WA_DISPLAY-JUDGE = 'NCR PASS'.
        ELSEIF IT_ZLOG_BARRIER-NCRAPPROVAL EQ 'Not Approved'.
          WA_DISPLAY-JUDGE = 'SCRAP'.
        ELSEIF WA_DISPLAY-CRIT_GRADE = 'Scrap' AND WA_DISPLAY-CG IS INITIAL.
          WA_DISPLAY-JUDGE = 'NO DATA'.
        ELSE.
          WA_DISPLAY-JUDGE = 'NOT YET'.
        ENDIF.
      ENDIF.
    ELSE.
      READ TABLE IT_JUDGEMENT WITH KEY VALUE = 'NOT YET'.
      IF SY-SUBRC EQ 0.
        WA_DISPLAY-JUDGE = IT_JUDGEMENT-VALUE.
      ENDIF.

      IF WA_DISPLAY-CRIT_GRADE EQ 'Scrap' AND IT_OBJEK-SCRAP IS INITIAL.
        IT_OBJEK-SCRAP = 'X'.
      ENDIF.

      IF IT_OBJEK-SCRAP EQ 'X'.
        IF WA_DISPLAY-CG IS INITIAL.
          WA_DISPLAY-JUDGE = 'NO DATA'.
        ENDIF.
      ENDIF.
    ENDIF.


    PERFORM GET_PRODUCTION_NUMBER_TYB USING WA_DISPLAY-ROLL_TYB WA_DISPLAY-LOT_TYB WA_DISPLAY-PROD_DATE CHANGING WA_DISPLAY-ROLL_SR.

    APPEND WA_DISPLAY TO IT_DISPLAY.
    CLEAR: WA_DISPLAY, IT_DISPLAY.
  ENDLOOP.

  DELETE IT_DISPLAY WHERE CODE NOT IN S_FILM.

  "Delete batch after change grade. Add by Fany (14.10.2026)
  DELETE IT_DISPLAY WHERE CG = 'X'.

ENDFORM.                    " GET_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_PRODUCTION_NUMBER_TYB
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->NO_ROL_TOYOBO   text
*      -->NO_LOT_TOYOBO   text
*      -->PRODDATE        text
*      -->PRODUCTION_NUM  text
*----------------------------------------------------------------------*
FORM GET_PRODUCTION_NUMBER_TYB USING NO_ROL_TOYOBO NO_LOT_TOYOBO PRODDATE CHANGING PRODUCTION_NUM.
  CLEAR: V_CODE.

  CONCATENATE PRODDATE+3(1) PRODDATE+4(2) INTO V_CODE.

  IF NO_ROL_TOYOBO IS NOT INITIAL AND NO_LOT_TOYOBO IS NOT INITIAL.
    CONCATENATE V_CODE NO_ROL_TOYOBO NO_LOT_TOYOBO '000' INTO PRODUCTION_NUM.
  ELSE.
    CLEAR PRODUCTION_NUM.
  ENDIF.
ENDFORM.                    "GET_PRODUCTION_NUMBER_TYB

