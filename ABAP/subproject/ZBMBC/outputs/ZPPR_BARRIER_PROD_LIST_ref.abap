*&---------------------------------------------------------------------*
*&      Form  GET_ADDITIONAL_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GET_ADDITIONAL_DATA.
  DATA : LV_SUBRC TYPE SY-SUBRC.
  CLEAR : V_TFILL.
  DESCRIBE TABLE IT_DISPLAY LINES V_TFILL.

  REFRESH: IT_MSEG_ALL, IT_TRACE_DATA.
  CLEAR: IT_MSEG_ALL, IT_TRACE_DATA.

  LOOP AT IT_DISPLAY ASSIGNING <FS_DISPLAY> WHERE SCRAP IS INITIAL.
    CLEAR : WA_DETAIL, IT_DETAIL, IT_DETAIL2, LS_SUBRC.
    REFRESH : IT_DETAIL, IT_DETAIL2.

    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 13 V_PROC_EX 'Get Traceability Data...'.

    IF <FS_DISPLAY>-ABLAD EQ 'First'.
      READ TABLE IT_TRACE_DATA WITH KEY INPUT_ROLL = <FS_DISPLAY>-INPUT_ROLL
                                             ABLAD = 'First'.
      IF SY-SUBRC EQ 0.
        "Check Data udah tracing
        <FS_DISPLAY>-ROLL_EVAP    = IT_TRACE_DATA-ROLL_EVAP.
        <FS_DISPLAY>-PROD_EVAP    = IT_TRACE_DATA-PROD_EVAP.
        <FS_DISPLAY>-QTY_EVAP     = IT_TRACE_DATA-QTY_EVAP.
        <FS_DISPLAY>-ROLL_COAT    = IT_TRACE_DATA-ROLL_COAT.
        <FS_DISPLAY>-PROD_COAT    = IT_TRACE_DATA-PROD_COAT.
        <FS_DISPLAY>-QTY_COAT     = IT_TRACE_DATA-QTY_COAT.
        <FS_DISPLAY>-ROLL_BASE    = IT_TRACE_DATA-ROLL_BASE.
        <FS_DISPLAY>-PROD_BASE    = IT_TRACE_DATA-PROD_BASE.
        <FS_DISPLAY>-QTY_BASE     = IT_TRACE_DATA-QTY_BASE.
        <FS_DISPLAY>-MATNR_BASE   = IT_TRACE_DATA-MATNR_BASE.
        <FS_DISPLAY>-CHARG_BASE   = IT_TRACE_DATA-CHARG_BASE.
        <FS_DISPLAY>-CHARGJR      = IT_TRACE_DATA-CHARGJR.
        <FS_DISPLAY>-MATNRJR      = IT_TRACE_DATA-MATNRJR.
        <FS_DISPLAY>-CHARGJR_BASE = IT_TRACE_DATA-CHARGJR_BASE.
        <FS_DISPLAY>-INPUT_ROLL   = IT_TRACE_DATA-INPUT_ROLL.
        <FS_DISPLAY>-FRBNR        = IT_TRACE_DATA-FRBNR.
        <FS_DISPLAY>-CHARGJR      = IT_TRACE_DATA-CHARGJR.
        <FS_DISPLAY>-MATNRJR      = IT_TRACE_DATA-MATNRJR.
        <FS_DISPLAY>-INPUT_MATNR  = IT_TRACE_DATA-INPUT_MATNR.
        <FS_DISPLAY>-INPUT_CHARG  = IT_TRACE_DATA-INPUT_CHARG.
        <FS_DISPLAY>-INSTALL_DATE = IT_TRACE_DATA-INSTALL_DATE.
        <FS_DISPLAY>-OUT_DATE     = IT_TRACE_DATA-OUT_DATE.
      ELSE.
        LS_SUBRC = 4.
      ENDIF.
    ELSEIF <FS_DISPLAY>-ABLAD EQ 'Second'.
      READ TABLE IT_TRACE_DATA WITH KEY INPUT_ROLL    = <FS_DISPLAY>-INPUT_ROLL
                                        ABLAD         = 'Second'
                                        DERIVATIVE_MS = <FS_DISPLAY>-DERIVATIVE_MS
                                        POSITION_MS   = <FS_DISPLAY>-POSITION_MS.
      IF SY-SUBRC EQ 0.
        "Check Data udah tracing
        <FS_DISPLAY>-ROLL_EVAP    = IT_TRACE_DATA-ROLL_EVAP.
        <FS_DISPLAY>-PROD_EVAP    = IT_TRACE_DATA-PROD_EVAP.
        <FS_DISPLAY>-QTY_EVAP     = IT_TRACE_DATA-QTY_EVAP.
        <FS_DISPLAY>-ROLL_COAT    = IT_TRACE_DATA-ROLL_COAT.
        <FS_DISPLAY>-PROD_COAT    = IT_TRACE_DATA-PROD_COAT.
        <FS_DISPLAY>-QTY_COAT     = IT_TRACE_DATA-QTY_COAT.
        <FS_DISPLAY>-ROLL_BASE    = IT_TRACE_DATA-ROLL_BASE.
        <FS_DISPLAY>-PROD_BASE    = IT_TRACE_DATA-PROD_BASE.
        <FS_DISPLAY>-QTY_BASE     = IT_TRACE_DATA-QTY_BASE.
        <FS_DISPLAY>-MATNR_BASE   = IT_TRACE_DATA-MATNR_BASE.
        <FS_DISPLAY>-CHARG_BASE   = IT_TRACE_DATA-CHARG_BASE.
        <FS_DISPLAY>-CHARGJR      = IT_TRACE_DATA-CHARGJR.
        <FS_DISPLAY>-MATNRJR      = IT_TRACE_DATA-MATNRJR.
        <FS_DISPLAY>-CHARGJR_BASE = IT_TRACE_DATA-CHARGJR_BASE.
        <FS_DISPLAY>-INPUT_ROLL   = IT_TRACE_DATA-INPUT_ROLL.
        <FS_DISPLAY>-FRBNR        = IT_TRACE_DATA-FRBNR.
        <FS_DISPLAY>-CHARGJR      = IT_TRACE_DATA-CHARGJR.
        <FS_DISPLAY>-MATNRJR      = IT_TRACE_DATA-MATNRJR.
        <FS_DISPLAY>-INPUT_MATNR  = IT_TRACE_DATA-INPUT_MATNR.
        <FS_DISPLAY>-INPUT_CHARG  = IT_TRACE_DATA-INPUT_CHARG.
        <FS_DISPLAY>-INSTALL_DATE = IT_TRACE_DATA-INSTALL_DATE.
        <FS_DISPLAY>-OUT_DATE     = IT_TRACE_DATA-OUT_DATE.
      ELSE.
        LS_SUBRC = 4.
      ENDIF.
    ENDIF.

    IF LS_SUBRC EQ 4.
      WA_DETAIL-CHARG =  <FS_DISPLAY>-CHARG.
      WA_DETAIL-MATNR =  <FS_DISPLAY>-MATNR.
      APPEND WA_DETAIL TO IT_DETAIL.

      PERFORM GET_PREV_DATA.

      IF SY-SUBRC EQ 0.
        APPEND LINES OF IT_DETAIL TO IT_DETAIL2.
        PERFORM GET_ORIGINAL_ROLL.  "Untuk material O
        LOOP AT IT_DETAIL2.
          IF IT_DETAIL2-MATNR(2) CS 'JR' AND IT_DETAIL2-ATWRT(2) CS 'E1' .  "For EVA
            <FS_DISPLAY>-ROLL_EVAP  = IT_DETAIL2-ATWRT.
            <FS_DISPLAY>-PROD_EVAP  = IT_DETAIL2-CPUDT.
            <FS_DISPLAY>-QTY_EVAP   = IT_DETAIL2-MENGE.
            IF <FS_DISPLAY>-CHARGJR IS INITIAL.
              <FS_DISPLAY>-CHARGJR  = IT_DETAIL2-CHARG.
              <FS_DISPLAY>-MATNRJR  = IT_DETAIL2-MATNR.
            ENDIF.
          ELSEIF IT_DETAIL2-MATNR(2) CS 'JR' AND IT_DETAIL2-ATWRT(2) CS 'C1'.   "For Coating
            <FS_DISPLAY>-ROLL_COAT  = IT_DETAIL2-ATWRT.
            <FS_DISPLAY>-PROD_COAT  = IT_DETAIL2-CPUDT.
            <FS_DISPLAY>-QTY_COAT   = IT_DETAIL2-MENGE.
            <FS_DISPLAY>-CHARGJR    = IT_DETAIL2-CHARG.
            <FS_DISPLAY>-MATNRJR    = IT_DETAIL2-MATNR.
          ELSEIF IT_DETAIL2-MATNR(2) CS 'SR' AND IT_DETAIL2-AUFNR CS 'SUBCONTRACT'.   "For Material Base Film Outsource
            <FS_DISPLAY>-ROLL_BASE  = IT_DETAIL2-ATWRT.
            <FS_DISPLAY>-PROD_BASE  = IT_DETAIL2-CPUDT.
            <FS_DISPLAY>-QTY_BASE   = IT_DETAIL2-MENGE.
            <FS_DISPLAY>-MATNR_BASE = IT_DETAIL2-MATNR.
            <FS_DISPLAY>-CHARG_BASE = IT_DETAIL2-CHARG.

            READ TABLE IT_MSEG_ALL WITH KEY CHARG = <FS_DISPLAY>-CHARG_BASE.
            IF SY-SUBRC EQ 0.
              <FS_DISPLAY>-QTY_BASE = IT_MSEG_ALL-MENGE.
            ENDIF.
          ENDIF.

          IF IT_DETAIL2-MATNR(2) CS 'JR' AND IT_DETAIL2-WERKS NE 'TTE'.
            <FS_DISPLAY>-CHARGJR_BASE = IT_DETAIL2-CHARG.
          ENDIF.

          "Get Input Roll
          IF <FS_DISPLAY>-ABLAD EQ 'First'.
            READ TABLE IT_DETAIL2 WITH KEY MATNR = <FS_DISPLAY>-MATNR.
            IF SY-SUBRC EQ 0.
              CLEAR: V_MATNR.
              READ TABLE IT_ZBATCHISTORY WITH KEY NCHARG = IT_DETAIL2-CHARG.
              IF SY-SUBRC EQ 0.
                LV_SUBRC = SY-SUBRC.
                WHILE LV_SUBRC EQ 0.
                  READ TABLE IT_ZBATCHISTORY WITH KEY NCHARG = IT_ZBATCHISTORY-CHARG.
                  LV_SUBRC = SY-SUBRC.
                ENDWHILE.
                READ TABLE IT_DETAIL2 WITH KEY CHARG = IT_ZBATCHISTORY-CHARG.
                IF SY-SUBRC EQ 0.
                  V_MATNR = IT_DETAIL2-P_MATNR.
                ENDIF.
              ELSE.
                V_MATNR = IT_DETAIL2-P_MATNR.
              ENDIF.

              READ TABLE IT_DETAIL2 WITH KEY MATNR = V_MATNR.
              IF SY-SUBRC EQ 0.
                <FS_DISPLAY>-INPUT_ROLL = IT_DETAIL2-ATWRT.
                <FS_DISPLAY>-FRBNR      = IT_DETAIL2-FRBNR.
                <FS_DISPLAY>-CHARGJR    = IT_DETAIL2-CHARG.
                <FS_DISPLAY>-MATNRJR    = IT_DETAIL2-MATNR.

                <FS_DISPLAY>-INPUT_MATNR    = IT_DETAIL2-MATNR.
                <FS_DISPLAY>-INPUT_CHARG    = IT_DETAIL2-CHARG.
              ENDIF.
            ENDIF.
          ELSE.
            READ TABLE IT_DETAIL2 WITH KEY CHARG = <FS_DISPLAY>-CHARG.
            IF SY-SUBRC EQ 0.
              <FS_DISPLAY>-INPUT_MATNR    = IT_DETAIL2-P_MATNR.
              <FS_DISPLAY>-INPUT_CHARG    = IT_DETAIL2-P_CHARG.
            ENDIF.

            LOOP AT IT_DETAIL2 WHERE MATNR = <FS_DISPLAY>-MATNR.
              IF IT_DETAIL2-MATNR EQ IT_DETAIL2-P_MATNR.
                CONTINUE.
              ENDIF.

              CLEAR: V_MATNR.
              V_MATNR = IT_DETAIL2-P_MATNR.

              READ TABLE IT_DETAIL2 WITH KEY MATNR = V_MATNR.
              IF SY-SUBRC EQ 0.
                <FS_DISPLAY>-INPUT_ROLL = IT_DETAIL2-ATWRT.
                <FS_DISPLAY>-FRBNR      = IT_DETAIL2-FRBNR.
                <FS_DISPLAY>-CHARGJR    = IT_DETAIL2-CHARG.
                <FS_DISPLAY>-MATNRJR    = IT_DETAIL2-MATNR.
              ENDIF.
            ENDLOOP.
          ENDIF.
        ENDLOOP.
      ENDIF.

      IF <FS_DISPLAY>-PROD_COAT IS NOT INITIAL.
        IF <FS_DISPLAY>-PROD_EVAP IS NOT INITIAL.
          <FS_DISPLAY>-INSTALL_DATE   = <FS_DISPLAY>-PROD_EVAP.
        ELSE.
          <FS_DISPLAY>-INSTALL_DATE   = <FS_DISPLAY>-PROD_COAT.
        ENDIF.
        <FS_DISPLAY>-OUT_DATE       = <FS_DISPLAY>-PROD_COAT.
      ELSE.
        <FS_DISPLAY>-INSTALL_DATE   = <FS_DISPLAY>-PROD_EVAP.
        <FS_DISPLAY>-OUT_DATE       = <FS_DISPLAY>-PROD_EVAP.
      ENDIF.

      IF <FS_DISPLAY>-FRBNR IS INITIAL.
        LOOP AT IT_DETAIL2 WHERE FRBNR IS NOT INITIAL AND CHARG EQ <FS_DISPLAY>-INPUT_CHARG.
          <FS_DISPLAY>-FRBNR = IT_DETAIL2-FRBNR.
        ENDLOOP.
      ENDIF.

      MOVE-CORRESPONDING <FS_DISPLAY> TO IT_TRACE_DATA.
      APPEND IT_TRACE_DATA.
      CLEAR IT_TRACE_DATA.
    ENDIF.
  ENDLOOP.
*  DELETE IT_DISPLAY WHERE CHARGJR EQ '' AND MATNRJR EQ ''.

  IT_BASE_FILM[] = IT_DISPLAY[].
  SORT IT_BASE_FILM BY CHARG_BASE.
  DELETE ADJACENT DUPLICATES FROM IT_BASE_FILM COMPARING CHARG_BASE.
ENDFORM.                    " GET_ADDITIONAL_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_ORIGINAL_ROLL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GET_ORIGINAL_ROLL .
  LOOP AT IT_DETAIL2 WHERE MATNR CS 'SR' AND AUFNR EQ 'SUBCONTRACT'.
    REFRESH IT_DETAIL.
    IF IT_DETAIL2-P_CHARG IS NOT INITIAL.
      SELECT MCH1~MATNR AS MATNR
             MCH1~CHARG AS CHARG
             AUSP~ATWRT AS ATWRT
        INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL
        FROM MCH1
        JOIN AUSP ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
       UP TO 1 ROWS
       WHERE MCH1~CHARG EQ IT_DETAIL2-P_CHARG
         AND MCH1~FVDT1 EQ '00000000'
         AND AUSP~KLART EQ '023'
         AND AUSP~MAFID EQ 'O'
         AND AUSP~ATINN EQ V_ZZNOMORROLL
       ORDER BY MCH1~CHARG ASCENDING.
    ELSE.
      SELECT MCH1~MATNR AS MATNR
             MCH1~CHARG AS CHARG
             AUSP~ATWRT AS ATWRT
        INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL
        FROM MCH1
        JOIN AUSP ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
       UP TO 1 ROWS
       WHERE AUSP~ATWRT EQ IT_DETAIL2-ATWRT
         AND MCH1~FVDT1 EQ '00000000'
         AND AUSP~KLART EQ '023'
         AND AUSP~MAFID EQ 'O'
         AND AUSP~ATINN EQ V_ZZNOMORROLL
       ORDER BY MCH1~CHARG ASCENDING.
    ENDIF.

    PERFORM GET_PREV_DATA.
    READ TABLE IT_DETAIL2 WITH KEY MATNR = IT_DETAIL-MATNR CHARG = IT_DETAIL-CHARG.
    IF SY-SUBRC NE 0.
      APPEND LINES OF IT_DETAIL TO IT_DETAIL2.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " GET_ORIGINAL_ROLL

*&---------------------------------------------------------------------*
*&      Form  GET_PREV_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GET_PREV_DATA.
  LOOP AT IT_DETAIL ASSIGNING <FS_DETAIL>.
    CLEAR : IT_MSEG, IT_MSEG2.
    REFRESH : IT_MSEG, IT_MSEG2.

    DT_STATUS = 0 .
    SELECT AUFNR MBLNR MJAHR ZEILE CPUDT_MKPF CPUTM_MKPF SMBLN SJAHR SMBLP BWART LIFNR CHARG MENGE
      INTO CORRESPONDING FIELDS OF TABLE IT_MSEG
      FROM MSEG
     WHERE BWART IN (101, 102, 531, 532)
       AND MATNR EQ <FS_DETAIL>-MATNR
       AND CHARG EQ <FS_DETAIL>-CHARG %_HINTS  ORACLE 'INDEX("MSEG" "MSEG~Z07")'.

    IT_MSEG2[] = IT_MSEG[].
    DELETE IT_MSEG2 WHERE SMBLN IS INITIAL.
    LOOP AT IT_MSEG2.
      DELETE IT_MSEG WHERE MBLNR EQ IT_MSEG2-SMBLN AND MJAHR EQ IT_MSEG2-SJAHR AND ZEILE EQ IT_MSEG2-SMBLP.
    ENDLOOP.

    DELETE IT_MSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ 102.
    DELETE IT_MSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ 532.

    "Check if 101 is Scrap
    IF IT_MSEG[] IS INITIAL AND <FS_DISPLAY>-CRIT_GRADE EQ 'Scrap' AND <FS_DISPLAY>-AUFNR IS NOT INITIAL AND <FS_DISPLAY>-CHARG EQ <FS_DETAIL>-CHARG.
      SELECT AUFNR MBLNR MJAHR ZEILE CPUDT_MKPF CPUTM_MKPF SMBLN SJAHR SMBLP BWART LIFNR CHARG MENGE
        INTO CORRESPONDING FIELDS OF TABLE IT_MSEG
        FROM MSEG
       WHERE BWART IN (261, 262)
         AND AUFNR EQ <FS_DISPLAY>-AUFNR.

      IT_MSEG2[] = IT_MSEG[].
      DELETE IT_MSEG2 WHERE SMBLN IS INITIAL.
      LOOP AT IT_MSEG2.
        DELETE IT_MSEG WHERE MBLNR EQ IT_MSEG2-SMBLN AND MJAHR EQ IT_MSEG2-SJAHR AND ZEILE EQ IT_MSEG2-SMBLP.
      ENDLOOP.

      DELETE IT_MSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ 262.
    ENDIF.

    SORT IT_MSEG BY CPUDT_MKPF CPUTM_MKPF.

    APPEND LINES OF IT_MSEG TO IT_MSEG_ALL.

    CLEAR: VSTATUS, STS_PROCESS.
    READ TABLE IT_MSEG INDEX 1.
    VSTATUS = IT_MSEG-MBLNR.
    IT_DETAIL2-MENGE = IT_MSEG-MENGE.

    <FS_DETAIL>-AUFNR = IT_MSEG-AUFNR.
    <FS_DETAIL>-MBLNR = IT_MSEG-MBLNR.
    CLEAR : <FS_DETAIL>-CPUDT, <FS_DETAIL>-CPUTM.

    SELECT SINGLE CPUDT CPUTM FRBNR INTO (<FS_DETAIL>-CPUDT , <FS_DETAIL>-CPUTM, <FS_DETAIL>-FRBNR) FROM MKPF
    WHERE MBLNR = <FS_DETAIL>-MBLNR.

    IF <FS_DETAIL>-AUFNR IS INITIAL.
      IF <FS_DETAIL>-CPUDT IS INITIAL.
        <FS_DETAIL>-AUFNR = 'INITIAL'.
      ELSE.
        <FS_DETAIL>-AUFNR = 'SUBCONTRACT'.
      ENDIF.
      <FS_DETAIL>-ARBPL =  IT_MSEG-LIFNR.
    ENDIF.

    CLEAR VCOMBINE.
    SELECT SINGLE AUFNR FROM AFPO
      INTO VCOMBINE
     WHERE MILL_OC_AUFNR_U EQ <FS_DETAIL>-AUFNR %_HINTS  ORACLE 'INDEX("AFPO" "AFPO~Z01")'.

    IF VCOMBINE IS INITIAL.
      VCOMBINE = <FS_DETAIL>-AUFNR.
    ENDIF.

    CLEAR VBKTXT.
    SELECT SINGLE BKTXT INTO VBKTXT FROM MKPF
      WHERE MBLNR = <FS_DETAIL>-MBLNR.

    IF <FS_DETAIL>-AUFNR = 'SUBCONTRACT'.
      <FS_DETAIL>-ARBPL = IT_MSEG-LIFNR.
      CLEAR: IT_PREBATCH.
      REFRESH: IT_PREBATCH.
      SELECT MSEG~MATNR
             MSEG~CHARG
             MSEG~MBLNR
             MSEG~MJAHR
             MSEG~WERKS
             ZEILE
             AUFNR
             BKTXT
             CUOBJ_BM AS OBJEK
             FRBNR
        INTO CORRESPONDING FIELDS OF TABLE IT_PREBATCH
        FROM MKPF
        JOIN MSEG ON MSEG~MBLNR EQ MKPF~MBLNR
        JOIN MCH1 ON MCH1~CHARG EQ MSEG~CHARG
       WHERE MKPF~MBLNR EQ <FS_DETAIL>-MBLNR
         AND MSEG~BWART EQ '543'.

    ELSE.
      SELECT SINGLE CRHD~ARBPL
        INTO <FS_DETAIL>-ARBPL
        FROM CRHD
        JOIN AFRU ON CRHD~OBJID EQ AFRU~ARBID
       WHERE CRHD~OBJTY EQ 'A'
         AND AFRU~AUFNR EQ VCOMBINE
         AND AFRU~STOKZ EQ ''.

      CLEAR: IT_PREBATCH.
      REFRESH: IT_PREBATCH.
      SELECT  AUFM~MATNR
              AUFM~CHARG
              AUFM~MBLNR
              AUFM~MJAHR
              AUFM~WERKS
              ZEILE
              AUFNR
              BKTXT
              CUOBJ_BM AS OBJEK
              MENGE
              FRBNR
        INTO CORRESPONDING FIELDS OF TABLE IT_PREBATCH
        FROM AUFM
        JOIN MKPF ON AUFM~MBLNR EQ MKPF~MBLNR
        JOIN MCH1 ON MCH1~CHARG EQ AUFM~CHARG
       WHERE AUFM~AUFNR EQ VCOMBINE
         AND AUFM~BWART IN ('261', '901').
    ENDIF.

    SORT IT_PREBATCH BY CHARG.
    CLEAR : IT_NOROLL.
    REFRESH : IT_NOROLL.
    IF IT_PREBATCH[] IS NOT INITIAL.
      DELETE IT_PREBATCH WHERE OBJEK IS INITIAL.
      SELECT ATWRT OBJEK
        FROM AUSP
        INTO CORRESPONDING FIELDS OF TABLE IT_NOROLL
        FOR ALL ENTRIES IN IT_PREBATCH
        WHERE AUSP~KLART EQ '023'
          AND AUSP~MAFID EQ 'O'
          AND AUSP~ATINN EQ V_ZZNOMORROLL
          AND AUSP~OBJEK EQ IT_PREBATCH-OBJEK.

      IF IT_NOROLL[] IS NOT INITIAL.
        LOOP AT IT_PREBATCH.
          READ TABLE IT_NOROLL WITH KEY OBJEK = IT_PREBATCH-OBJEK.
          IF SY-SUBRC EQ 0.
            IT_PREBATCH-ATWRT = IT_NOROLL-ATWRT.
            MODIFY IT_PREBATCH.
          ENDIF.
        ENDLOOP.
      ENDIF.
    ENDIF.
    CLEAR PREVCHARG.

    SEQ_BATCH = 0.
    CLEAR : IT_MBLNR.
    REFRESH : IT_MBLNR.
    IF IT_PREBATCH[] IS NOT INITIAL.
      SELECT CHARG SJAHR MATNR MBLNR SMBLN SMBLP MJAHR ZEILE BWART MENGE INTO
        CORRESPONDING FIELDS OF TABLE IT_MBLNR
         FROM MSEG
        FOR ALL ENTRIES IN IT_PREBATCH
            WHERE MATNR EQ IT_PREBATCH-MATNR
            AND CHARG   EQ IT_PREBATCH-CHARG
            AND BWART   IN ('262', '902')
            AND SMBLN   EQ IT_PREBATCH-MBLNR
            AND SJAHR   EQ IT_PREBATCH-MJAHR
            AND SMBLP   EQ IT_PREBATCH-ZEILE.
    ENDIF.

    LOOP AT IT_PREBATCH ASSIGNING <FS_PREBATCH> WHERE BKTXT = VBKTXT.
      IF <FS_PREBATCH>-CHARG IS NOT INITIAL.
        DT_STATUS = 1.
        VMATNR = <FS_PREBATCH>-MATNR.
        VCHARG = <FS_PREBATCH>-CHARG.

        IF <FS_PREBATCH>-MATNR IS NOT INITIAL.
          MAT_O = <FS_PREBATCH>-MATNR.
          MAT_O_LEN = STRLEN( MAT_O ).
          TEMP_LEN  = MAT_O_LEN - 1.

          IF MAT_O(2) = 'SR' AND MAT_O+TEMP_LEN(1) = 'O'.
            SELECT SINGLE LICHA INTO (V_LICHA) FROM MCH1
               WHERE CHARG = <FS_PREBATCH>-CHARG AND MATNR = <FS_PREBATCH>-MATNR.

            IF SY-SUBRC EQ 0.
              <FS_PREBATCH>-P_CHARG = V_LICHA.
            ENDIF.
          ENDIF.
        ENDIF.

        CLEAR : MAT_O, MAT_O_LEN, TEMP_LEN, V_LICHA.
        CLEAR VSTATUS.

        READ TABLE IT_MBLNR WITH KEY CHARG = <FS_PREBATCH>-CHARG SMBLN = <FS_PREBATCH>-MBLNR SJAHR = <FS_PREBATCH>-MJAHR SMBLP = <FS_PREBATCH>-ZEILE.
        IF SY-SUBRC EQ 0 .
          V_STATUS = IT_MBLNR-MBLNR.
          DELETE IT_PREBATCH.
        ELSE.
          SELECT SINGLE CPUDT CPUTM INTO (<FS_PREBATCH>-CPUDT, <FS_PREBATCH>-CPUTM ) FROM MKPF
            WHERE MBLNR = <FS_PREBATCH>-MBLNR AND
                  MJAHR = <FS_PREBATCH>-MJAHR.

          IF PREVCHARG <> <FS_PREBATCH>-CHARG.
            READ TABLE IT_DETAIL WITH KEY CHARG = <FS_PREBATCH>-CHARG MATNR = <FS_PREBATCH>-MATNR.
            IF SY-SUBRC NE 0.
              IT_DETAIL-MATNR        = <FS_PREBATCH>-MATNR.
              IT_DETAIL-CHARG        = <FS_PREBATCH>-CHARG.
              IT_DETAIL-P_CHARG      = <FS_PREBATCH>-P_CHARG.
              IT_DETAIL-WERKS        = <FS_PREBATCH>-WERKS.
              IT_DETAIL-ATWRT        = <FS_PREBATCH>-ATWRT.
              IT_DETAIL-MBLNR        = <FS_PREBATCH>-MBLNR.
              IT_DETAIL-MJAHR        = <FS_PREBATCH>-MJAHR.
              IT_DETAIL-ZEILE        = <FS_PREBATCH>-ZEILE.
              IT_DETAIL-CPUDT        = <FS_PREBATCH>-CPUDT.
              IT_DETAIL-CPUTM        = <FS_PREBATCH>-CPUTM.
              IT_DETAIL-ATWRT        = <FS_PREBATCH>-ATWRT.
              IT_DETAIL-FRBNR        = <FS_PREBATCH>-FRBNR.
              IT_DETAIL-LEVEL        = <FS_DETAIL>-LEVEL + 1.
              APPEND IT_DETAIL.
            ENDIF.
          ENDIF.

          IF SEQ_BATCH = 0.
            READ TABLE IT_DETAIL2 WITH KEY CHARG = <FS_DETAIL>-CHARG MATNR = <FS_DETAIL>-MATNR.
            IF SY-SUBRC NE 0.
              IT_DETAIL2-MATNR       = <FS_DETAIL>-MATNR.
              IT_DETAIL2-ATWRT       = <FS_DETAIL>-ATWRT.
              IT_DETAIL2-CHARG       = <FS_DETAIL>-CHARG.
              IT_DETAIL2-WERKS       = <FS_DETAIL>-WERKS.
              IT_DETAIL2-AUFNR       = <FS_DETAIL>-AUFNR.
              IT_DETAIL2-MBLNR       = <FS_DETAIL>-MBLNR.
              IT_DETAIL2-ZEILE       = <FS_DETAIL>-ZEILE.
              IT_DETAIL2-MJAHR       = <FS_DETAIL>-MJAHR.
              IT_DETAIL2-CPUDT       = <FS_DETAIL>-CPUDT.
              IT_DETAIL2-CPUTM       = <FS_DETAIL>-CPUTM.
              IT_DETAIL2-ARBPL       = <FS_DETAIL>-ARBPL.
              IT_DETAIL2-FRBNR       = <FS_DETAIL>-FRBNR.
              IT_DETAIL2-P_CHARG     = <FS_PREBATCH>-CHARG.
              IT_DETAIL2-P_MATNR     = <FS_PREBATCH>-MATNR.
              IT_DETAIL2-P_ATWRT     = <FS_PREBATCH>-ATWRT.
              IT_DETAIL2-P_CPUDT     = <FS_PREBATCH>-CPUDT.
              IT_DETAIL2-P_CPUTM     = <FS_PREBATCH>-CPUTM.
              IT_DETAIL2-LEVEL       = <FS_DETAIL>-LEVEL.
              PREVCHARG              = <FS_PREBATCH>-CHARG.
              APPEND IT_DETAIL2.
              SEQ_BATCH = 1.
            ENDIF.
          ELSE.
            READ TABLE IT_DETAIL2 WITH KEY CHARG = <FS_DETAIL>-CHARG MATNR = <FS_DETAIL>-MATNR.
            IF SY-SUBRC NE 0.
              LOOP AT IT_DETAIL2 WHERE CHARG = <FS_DETAIL>-CHARG.
                IT_DETAIL2-MATNR     = <FS_DETAIL>-MATNR.
                IT_DETAIL2-ATWRT     = <FS_DETAIL>-ATWRT.
                IT_DETAIL2-CHARG     = <FS_DETAIL>-CHARG.
                IT_DETAIL2-AUFNR     = <FS_DETAIL>-AUFNR.
                IT_DETAIL2-MBLNR     = <FS_DETAIL>-MBLNR.
                IT_DETAIL2-ZEILE     = <FS_DETAIL>-ZEILE.
                IT_DETAIL2-MJAHR     = <FS_DETAIL>-MJAHR.
                IT_DETAIL2-CPUDT     = <FS_DETAIL>-CPUDT.
                IT_DETAIL2-CPUTM     = <FS_DETAIL>-CPUTM.
                IT_DETAIL2-ARBPL     = <FS_DETAIL>-ARBPL.
                IT_DETAIL2-FRBNR     = <FS_DETAIL>-FRBNR.
                IF PREVCHARG <> <FS_PREBATCH>-CHARG.
                  CONCATENATE IT_DETAIL2-P_CHARG ',' INTO IT_DETAIL2-P_CHARG.
                  CONCATENATE IT_DETAIL2-P_CHARG <FS_PREBATCH>-CHARG INTO IT_DETAIL2-P_CHARG SEPARATED BY SPACE.
                  CONCATENATE IT_DETAIL2-P_ATWRT ',' INTO IT_DETAIL2-P_ATWRT.
                  CONCATENATE IT_DETAIL2-P_ATWRT <FS_PREBATCH>-ATWRT INTO IT_DETAIL2-P_ATWRT SEPARATED BY SPACE.
                ENDIF.
                PREVCHARG = <FS_PREBATCH>-CHARG.
                MODIFY IT_DETAIL2.
              ENDLOOP.
            ENDIF.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.

    IF DT_STATUS = 1.
      DELETE IT_DETAIL.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " GET_PREV_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_SURFACE_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_SURFACE_DATA.
  CLEAR: V_TFILL, V_ROLL.
  REFRESH: IT_SURFACE, IT_CHAR, IT_INPT_RL.

  DESCRIBE TABLE IT_DISPLAY LINES V_TFILL.

  SORT IT_DISPLAY BY INPUT_ROLL ABLAD INPUT_CHARG DERIVATIVE_MS POSITION_MS DERIVATIVE_SS POSITION_SS PROD_DATE.

  DELETE IT_DISPLAY WHERE ABLAD IS INITIAL.

  IT_DISPLAY2[] = IT_DISPLAY[].

  IT_INPT_RL[] = IT_DISPLAY[].
  SORT IT_INPT_RL BY INPUT_MATNR INPUT_CHARG.
  DELETE ADJACENT DUPLICATES FROM IT_INPT_RL COMPARING INPUT_MATNR INPUT_CHARG.

  PERFORM SET_INDICATOR USING 1 1 15 V_PROC_EX 'Get Surface Data...'.

  IF IT_INPT_RL[] IS NOT INITIAL.
    SELECT
    CHARG
    AUSP~ATINN
    AUSP~ATWRT
    AUSP~ATFLV
    INTO CORRESPONDING FIELDS OF TABLE IT_CHAR
    FROM MCH1
    JOIN AUSP  ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
     FOR ALL ENTRIES IN IT_INPT_RL
   WHERE MATNR EQ IT_INPT_RL-INPUT_MATNR
     AND CHARG EQ IT_INPT_RL-INPUT_CHARG
     AND KLART EQ '023'
     AND AUSP~ATINN IN (V_ZZWIDTH, V_ZZGRAMMAGE).

    PERFORM GET_QTY_SCRAP.
  ENDIF.

  LOOP AT IT_DISPLAY.
    CLEAR : WA_DETAIL, IT_DETAIL, IT_DETAIL2, V_LINE, V_CODE, V_MOYE, V_SEQ, V_GRADE, V_DMS, V_PMS, V_DSS, V_PSS.
    REFRESH : IT_DETAIL, IT_DETAIL2.

    PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 16 V_PROC_EX 'Collecting Surface Data...'.

    "00
    IF V_ROLL NE IT_DISPLAY-INPUT_ROLL OR V_INPUT_CHARG NE IT_DISPLAY-INPUT_CHARG.

      IF IT_DISPLAY-ABLAD EQ 'First'.
        MOVE-CORRESPONDING IT_DISPLAY TO IT_SURFACE.

        CLEAR: IT_SURFACE-LOT_TYB, IT_SURFACE-ROLL_TYB, IT_SURFACE-ROLL_SR, IT_SURFACE-ROLL_SR_SAP, IT_SURFACE-JUDGE, IT_SURFACE-QTY, IT_SURFACE-LENGTH,
               IT_SURFACE-ROLL_SR, IT_SURFACE-CHARG, IT_SURFACE-COMBINATIONNO,
               IT_SURFACE-DERIVATIVE_SS, IT_SURFACE-POSITION_SS.

        READ TABLE IT_CHAR WITH KEY CHARG = IT_DISPLAY-CHARGJR ATINN = V_ZZWIDTH.
        IF SY-SUBRC EQ 0.
          IT_SURFACE-WIDTH = IT_CHAR-ATFLV.
        ENDIF.

        READ TABLE IT_CHAR WITH KEY CHARG = IT_DISPLAY-CHARGJR ATINN = V_ZZGRAMMAGE.
        IF SY-SUBRC EQ 0.
          V_GRAMMAGE = IT_CHAR-ATFLV.
        ENDIF.

        IF IT_DISPLAY-FRBNR IS INITIAL.
          LOOP AT IT_DISPLAY2 WHERE INPUT_CHARG = IT_DISPLAY-INPUT_CHARG AND FRBNR IS NOT INITIAL.
            IT_SURFACE-LENGTH      = IT_DISPLAY2-FRBNR.
            EXIT.
          ENDLOOP.
        ELSE.
          IT_SURFACE-LENGTH      = IT_DISPLAY-FRBNR.
        ENDIF.

        IT_SURFACE-DERIVATIVE_MS  = '00'.
        IT_SURFACE-POSITION_MS    = '01'.   "Secondary sengaja blank
        IT_SURFACE-CRIT_GRADE  = 'Scrap'.
        IT_SURFACE-JUDGE       = 'NO DATA'.
        IT_SURFACE-ROLL_SR_SAP = IT_DISPLAY-INPUT_ROLL.

        CONCATENATE IT_SURFACE-ROLL_SR_SAP 'E 00 01' INTO IT_SURFACE-ROLL_SR_SAP SEPARATED BY SPACE.

*        PERFORM GET_WEIGHT USING IT_SURFACE-LENGTH IT_SURFACE-WIDTH V_GRAMMAGE CHANGING IT_SURFACE-QTY.

        IT_SURFACE-QTY = ( IT_SURFACE-LENGTH * IT_SURFACE-WIDTH * V_GRAMMAGE ) / 1000000.

        APPEND IT_SURFACE.
      ENDIF.

      "99

      MOVE-CORRESPONDING IT_DISPLAY TO IT_SURFACE.
      CLEAR: IT_SURFACE-LOT_TYB, IT_SURFACE-ROLL_TYB, IT_SURFACE-ROLL_SR, IT_SURFACE-ROLL_SR_SAP, IT_SURFACE-JUDGE, IT_SURFACE-QTY,
             IT_SURFACE-LENGTH, IT_SURFACE-CHARG, IT_SURFACE-COMBINATIONNO,
             IT_SURFACE-DERIVATIVE_SS, IT_SURFACE-POSITION_SS.

      READ TABLE IT_CHAR WITH KEY CHARG = IT_DISPLAY-INPUT_CHARG ATINN = V_ZZWIDTH.
      IF SY-SUBRC EQ 0.
        IT_SURFACE-WIDTH = IT_CHAR-ATFLV.
      ENDIF.

      READ TABLE IT_CHAR WITH KEY CHARG = IT_DISPLAY-INPUT_CHARG ATINN = V_ZZGRAMMAGE.
      IF SY-SUBRC EQ 0.
        V_GRAMMAGE = IT_CHAR-ATFLV.
      ENDIF.

      IT_SURFACE-DERIVATIVE_MS  = '99'.
      IT_SURFACE-POSITION_MS    = '01'.   "Secondary sengaja blank
      IT_SURFACE-CRIT_GRADE  = 'Scrap'.
      IT_SURFACE-JUDGE       = 'NO DATA'.

      "Secondary
      IF IT_DISPLAY-ABLAD EQ 'Second'.
        IT_SURFACE-ROLL_SR_SAP = IT_DISPLAY-INPUT_ROLL.

        LOOP AT IT_MSEG WHERE CHARG = IT_SURFACE-INPUT_CHARG.
          CLEAR V_TEMP.

          SPLIT IT_MSEG-SGTXT AT ';' INTO V_TEMP V_DSS.

          IT_SURFACE-LENGTH = V_TEMP.
          IT_SURFACE-QTY    = IT_SURFACE-QTY + IT_MSEG-MENGE.
        ENDLOOP.
      ELSE.
        IT_SURFACE-ROLL_SR_SAP = IT_DISPLAY-INPUT_ROLL.

        LOOP AT IT_MSEG WHERE CHARG = IT_SURFACE-INPUT_CHARG.
          CLEAR V_TEMP.

          SPLIT IT_MSEG-SGTXT AT ';;' INTO V_TEMP V_DSS.

          IT_SURFACE-LENGTH = V_TEMP.
          IT_SURFACE-QTY    = IT_SURFACE-QTY + IT_MSEG-MENGE.
        ENDLOOP.
      ENDIF.

      "Calculate length scrap
      IF IT_SURFACE-QTY IS NOT INITIAL AND IT_SURFACE-WIDTH IS NOT INITIAL AND V_GRAMMAGE IS NOT INITIAL.
        IT_SURFACE-LENGTH = ( IT_SURFACE-QTY * 1000000 ) / ( IT_SURFACE-WIDTH * V_GRAMMAGE ) .
      ELSE.
        IT_SURFACE-LENGTH = 0.
      ENDIF.

      CONCATENATE IT_SURFACE-ROLL_SR_SAP 'E 99 01' INTO IT_SURFACE-ROLL_SR_SAP SEPARATED BY SPACE.

      APPEND IT_SURFACE.
    ENDIF.

    V_ROLL = IT_DISPLAY-INPUT_ROLL.
    V_INPUT_CHARG = IT_DISPLAY-INPUT_CHARG.
  ENDLOOP.

  APPEND LINES OF IT_SURFACE TO IT_DISPLAY.
  DELETE IT_DISPLAY WHERE DERIVATIVE_MS EQ '99' AND QTY EQ 0.
  SORT IT_DISPLAY BY ROLL_SR_SAP.
  DELETE ADJACENT DUPLICATES FROM IT_DISPLAY COMPARING ROLL_SR_SAP.

  SORT IT_DISPLAY BY INPUT_ROLL ABLAD INPUT_CHARG DERIVATIVE_MS POSITION_MS DERIVATIVE_SS POSITION_SS PROD_DATE.
ENDFORM.                    "GET_SURFACE_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_CHAR_BASE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_CHAR_BASE.
  IF IT_BASE_FILM[] IS NOT INITIAL.
    SELECT MATNR CHARG AUSP~ATWRT AUSP~ATINN AUSP~ATFLV
      INTO CORRESPONDING FIELDS OF TABLE IT_CHARACTERISTIC
      FROM MCH1
      JOIN AUSP ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
       FOR ALL ENTRIES IN IT_BASE_FILM
     WHERE MATNR EQ IT_BASE_FILM-MATNR_BASE
       AND CHARG EQ IT_BASE_FILM-CHARG_BASE
       AND AUSP~KLART EQ '023'
       AND AUSP~MAFID EQ 'O'
       AND AUSP~ATINN IN (V_ZZWIDTH, V_ZZLENGTH, V_ZZGRAMMAGE).

    DESCRIBE TABLE IT_BASE_FILM LINES V_TFILL.

    LOOP AT IT_BASE_FILM.
      PERFORM SET_INDICATOR USING SY-TABIX V_TFILL 14 V_PROC_EX 'Get Base Film Data...'.

      READ TABLE IT_CHARACTERISTIC WITH KEY CHARG = IT_BASE_FILM-CHARG_BASE ATINN = V_ZZWIDTH.
      IF SY-SUBRC EQ 0.
        IT_DISPLAY-WIDTH_BASE = IT_CHARACTERISTIC-ATFLV.
      ENDIF.

      READ TABLE IT_CHARACTERISTIC WITH KEY CHARG = IT_BASE_FILM-CHARG_BASE ATINN = V_ZZLENGTH.
      IF SY-SUBRC EQ 0.
        IT_DISPLAY-LENGTH_BASE = IT_CHARACTERISTIC-ATFLV.
      ENDIF.

      READ TABLE IT_CHARACTERISTIC WITH KEY CHARG = IT_BASE_FILM-CHARG_BASE ATINN = V_ZZGRAMMAGE.
      IF SY-SUBRC EQ 0.
        IF IT_BASE_FILM-QTY_BASE IS NOT INITIAL AND IT_DISPLAY-WIDTH_BASE IS NOT INITIAL AND IT_CHARACTERISTIC-ATFLV IS NOT INITIAL.
          IT_DISPLAY-LENGTH_BASE = ( IT_BASE_FILM-QTY_BASE * 1000000 ) / ( IT_DISPLAY-WIDTH_BASE * IT_CHARACTERISTIC-ATFLV ) .
        ELSE.
          IT_DISPLAY-LENGTH_BASE = 0.
        ENDIF.
      ENDIF.

      MODIFY IT_DISPLAY TRANSPORTING WIDTH_BASE LENGTH_BASE WHERE CHARG_BASE EQ IT_BASE_FILM-CHARG_BASE.
      CLEAR IT_DISPLAY.
    ENDLOOP.
  ENDIF.
ENDFORM.                    "GET_CHAR_BASE

*&---------------------------------------------------------------------*
*&      Form  FILL_SCRAP_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM FILL_SCRAP_DATA.
  REFRESH: IT_DISPLAY2.
  CLEAR: IT_DISPLAY2.

  IT_DISPLAY2[] = IT_DISPLAY[].

  DELETE IT_DISPLAY2 WHERE INPUT_ROLL IS INITIAL.

  LOOP AT IT_DISPLAY WHERE INPUT_ROLL IS INITIAL.
    READ TABLE IT_DISPLAY2 WITH KEY AUFNR = IT_DISPLAY-AUFNR.
    IF SY-SUBRC EQ 0.
      IT_DISPLAY-INPUT_ROLL     = IT_DISPLAY2-INPUT_ROLL.
      IT_DISPLAY-INSTALL_DATE   = IT_DISPLAY2-INSTALL_DATE.
      IT_DISPLAY-OUT_DATE       = IT_DISPLAY2-OUT_DATE.
      IT_DISPLAY-ROLL_BASE      = IT_DISPLAY2-ROLL_BASE.
      IT_DISPLAY-PROD_BASE      = IT_DISPLAY2-PROD_BASE.
      IT_DISPLAY-QTY_BASE       = IT_DISPLAY2-QTY_BASE.
      IT_DISPLAY-WIDTH_BASE     = IT_DISPLAY2-WIDTH_BASE.
      IT_DISPLAY-LENGTH_BASE    = IT_DISPLAY2-LENGTH_BASE.
      IT_DISPLAY-ROLL_EVAP      = IT_DISPLAY2-ROLL_EVAP.
      IT_DISPLAY-PROD_EVAP      = IT_DISPLAY2-PROD_EVAP.
      IT_DISPLAY-QTY_EVAP       = IT_DISPLAY2-QTY_EVAP.
      IT_DISPLAY-ROLL_COAT      = IT_DISPLAY2-ROLL_COAT.
      IT_DISPLAY-PROD_COAT      = IT_DISPLAY2-PROD_COAT.
      IT_DISPLAY-QTY_COAT       = IT_DISPLAY2-QTY_COAT.
      IT_DISPLAY-CHARGJR        = IT_DISPLAY2-CHARGJR.
      IT_DISPLAY-MATNRJR        = IT_DISPLAY2-MATNRJR.
      IT_DISPLAY-INPUT_CHARG    = IT_DISPLAY2-INPUT_CHARG.
      IT_DISPLAY-INPUT_MATNR    = IT_DISPLAY2-INPUT_MATNR.
    ELSE.
      IF IT_DISPLAY-ABLAD = 'First'.
        SPLIT IT_DISPLAY-ROLL_SR_SAP AT SPACE INTO V_LINE V_CODE V_MOYE V_SEQ V_GRADE V_DMS V_PMS V_DSS V_PSS.
        CONCATENATE V_LINE V_CODE V_MOYE V_SEQ INTO IT_DISPLAY-INPUT_ROLL SEPARATED BY SPACE.

        READ TABLE IT_DISPLAY2 WITH KEY INPUT_ROLL = IT_DISPLAY-INPUT_ROLL.
        IF SY-SUBRC EQ 0.
*          IT_DISPLAY-INPUT_CHARG  = IT_DISPLAY2-INPUT_CHARG.
          IT_DISPLAY-INSTALL_DATE = IT_DISPLAY2-INSTALL_DATE.
          IT_DISPLAY-OUT_DATE     = IT_DISPLAY2-OUT_DATE.
          IT_DISPLAY-ROLL_BASE    = IT_DISPLAY2-ROLL_BASE.
          IT_DISPLAY-PROD_BASE    = IT_DISPLAY2-PROD_BASE.
          IT_DISPLAY-QTY_BASE     = IT_DISPLAY2-QTY_BASE.
          IT_DISPLAY-WIDTH_BASE   = IT_DISPLAY2-WIDTH_BASE.
          IT_DISPLAY-LENGTH_BASE  = IT_DISPLAY2-LENGTH_BASE.
          IT_DISPLAY-ROLL_EVAP    = IT_DISPLAY2-ROLL_EVAP.
          IT_DISPLAY-PROD_EVAP    = IT_DISPLAY2-PROD_EVAP.
          IT_DISPLAY-QTY_EVAP     = IT_DISPLAY2-QTY_EVAP.
          IT_DISPLAY-ROLL_COAT    = IT_DISPLAY2-ROLL_COAT.
          IT_DISPLAY-PROD_COAT    = IT_DISPLAY2-PROD_COAT.
          IT_DISPLAY-QTY_COAT     = IT_DISPLAY2-QTY_COAT.
          IT_DISPLAY-CHARGJR      = IT_DISPLAY2-CHARGJR.
          IT_DISPLAY-MATNRJR      = IT_DISPLAY2-MATNRJR.
          IT_DISPLAY-INPUT_CHARG  = IT_DISPLAY2-INPUT_CHARG.
          IT_DISPLAY-INPUT_MATNR  = IT_DISPLAY2-INPUT_MATNR.
        ENDIF.
      ELSE.
        SPLIT IT_DISPLAY-ROLL_SR_SAP AT SPACE INTO V_LINE V_CODE V_MOYE V_SEQ V_GRADE V_DMS V_PMS V_DSS V_PSS.
        CONCATENATE V_LINE V_CODE V_MOYE V_SEQ INTO IT_DISPLAY-INPUT_ROLL SEPARATED BY SPACE.

        READ TABLE IT_DISPLAY2 WITH KEY INPUT_ROLL = IT_DISPLAY-INPUT_ROLL DERIVATIVE_MS = IT_DISPLAY-DERIVATIVE_MS POSITION_MS = IT_DISPLAY-POSITION_MS.
        IF SY-SUBRC EQ 0.
*          IT_DISPLAY-INPUT_CHARG  = IT_DISPLAY2-CHARG.
          IT_DISPLAY-INSTALL_DATE = IT_DISPLAY2-INSTALL_DATE.
          IT_DISPLAY-OUT_DATE     = IT_DISPLAY2-OUT_DATE.
          IT_DISPLAY-ROLL_BASE    = IT_DISPLAY2-ROLL_BASE.
          IT_DISPLAY-PROD_BASE    = IT_DISPLAY2-PROD_BASE.
          IT_DISPLAY-QTY_BASE     = IT_DISPLAY2-QTY_BASE.
          IT_DISPLAY-WIDTH_BASE   = IT_DISPLAY2-WIDTH_BASE.
          IT_DISPLAY-LENGTH_BASE  = IT_DISPLAY2-LENGTH_BASE.
          IT_DISPLAY-ROLL_EVAP    = IT_DISPLAY2-ROLL_EVAP.
          IT_DISPLAY-PROD_EVAP    = IT_DISPLAY2-PROD_EVAP.
          IT_DISPLAY-QTY_EVAP     = IT_DISPLAY2-QTY_EVAP.
          IT_DISPLAY-ROLL_COAT    = IT_DISPLAY2-ROLL_COAT.
          IT_DISPLAY-PROD_COAT    = IT_DISPLAY2-PROD_COAT.
          IT_DISPLAY-QTY_COAT     = IT_DISPLAY2-QTY_COAT.
          IT_DISPLAY-CHARGJR      = IT_DISPLAY2-CHARGJR.
          IT_DISPLAY-MATNRJR      = IT_DISPLAY2-MATNRJR.
          IT_DISPLAY-INPUT_CHARG  = IT_DISPLAY2-CHARG.
          IT_DISPLAY-INPUT_MATNR  = IT_DISPLAY2-MATNR.
        ENDIF.
      ENDIF.
    ENDIF.
    MODIFY IT_DISPLAY.
    CLEAR IT_DISPLAY.
  ENDLOOP.

  SORT IT_DISPLAY BY INPUT_ROLL ABLAD INPUT_CHARG DERIVATIVE_MS POSITION_MS DERIVATIVE_SS POSITION_SS PROD_DATE.
ENDFORM.                    "FILL_SCRAP_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_QTY_SCRAP
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->CHARG      text
*      -->AUFNR      text
*      -->LENGTH     text
*      -->QTY        text
*----------------------------------------------------------------------*
FORM GET_QTY_SCRAP.
  CLEAR : IT_MSEG, IT_MSEG2.
  REFRESH : IT_MSEG, IT_MSEG2.

  SELECT AUFNR MBLNR MJAHR ZEILE CPUDT_MKPF CPUTM_MKPF SMBLN SJAHR SMBLP BWART LIFNR CHARG MENGE XBLNR_MKPF SGTXT
    INTO CORRESPONDING FIELDS OF TABLE IT_MSEG
    FROM MSEG
    FOR ALL ENTRIES IN IT_INPT_RL
   WHERE BWART      IN ('261', '262')
     AND MATNR      EQ IT_INPT_RL-INPUT_MATNR
     AND CHARG      EQ IT_INPT_RL-INPUT_CHARG
     AND XBLNR_MKPF LIKE 'SCR%'.

  IT_MSEG2[] = IT_MSEG[].
  DELETE IT_MSEG2 WHERE SMBLN IS INITIAL.
  LOOP AT IT_MSEG2.
    DELETE IT_MSEG WHERE MBLNR EQ IT_MSEG2-SMBLN AND MJAHR EQ IT_MSEG2-SJAHR AND ZEILE EQ IT_MSEG2-SMBLP.
  ENDLOOP.

  DELETE IT_MSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '262'.
ENDFORM.                    "GET_QTY_SCRAP
*&---------------------------------------------------------------------*
*&      Form  CONVERT_DATE_INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->I_DATE
*      <--O_DATE
*----------------------------------------------------------------------*
FORM CONVERT_DATE_INPUT  USING    I_DATE
                         CHANGING O_DATE.
  DATA : BEGIN OF IT_SPLIT OCCURS 0,
           STR TYPE C LENGTH 4,
         END OF IT_SPLIT.
  CLEAR: O_DATE.

  SPLIT I_DATE AT '.' INTO TABLE IT_SPLIT.
  LOOP AT IT_SPLIT.
    O_DATE = IT_SPLIT-STR && O_DATE.
  ENDLOOP.
ENDFORM.                    " CONVERT_DATE_INPUT

*&---------------------------------------------------------------------*
*&      Form  SET_INDICATOR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->INDEX          text
*      -->COUNT_INDEX    text
*      -->PROCESS        text
*      -->COUNT_PROCESS  text
*      -->TEXT           text
*----------------------------------------------------------------------*
FORM SET_INDICATOR  USING INDEX COUNT_INDEX PROCESS COUNT_PROCESS TEXT.
  DATA: PERCENT TYPE P.
  CLEAR: PERCENT.
  PERCENT =  ( ( INDEX + ( COUNT_INDEX * PROCESS ) - COUNT_INDEX ) / ( COUNT_INDEX * COUNT_PROCESS ) )  * 100.

  CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
    EXPORTING
      PERCENTAGE = PERCENT
      TEXT       = TEXT.
ENDFORM.                    " SET_INDICATOR

*&---------------------------------------------------------------------*
*&      Form  GET_WEIGHT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->LENGTH     text
*      -->WIDTH      text
*      -->GRAMMAGE   text
*      -->WEIGHT     text
*----------------------------------------------------------------------*
FORM GET_WEIGHT USING LENGTH WIDTH GRAMMAGE CHANGING WEIGHT.
  DATA: GLOBALS         TYPE CUOV_00,
        MATCH           TYPE CUOV_01 OCCURS 0 WITH HEADER LINE,
        QUERY           TYPE CUOV_01 OCCURS 0 WITH HEADER LINE,
        ZZPEMBILANGBARU TYPE ATFLV,
        ZZPENYEBUTBARU  TYPE ATFLV.

  GLOBALS-DATE = SY-DATUM.

  QUERY-VARNAM  = 'ZZPEMBILANGASAL'.
  QUERY-ATFOR   = 'NUM'.
  QUERY-ATFLV   = LENGTH * WIDTH * GRAMMAGE.
  APPEND QUERY.

  QUERY-VARNAM  = 'ZZPENYEBUTASAL'.
  QUERY-ATFOR   = 'NUM'.
  QUERY-ATFLV   = 1000000.
  APPEND QUERY.

  CALL FUNCTION 'ZMM_CHARACTERISTIC_MKG'
    EXPORTING
      GLOBALS        = GLOBALS
    TABLES
      MATCH          = MATCH
      QUERY          = QUERY
    EXCEPTIONS
      FAIL           = 1
      INTERNAL_ERROR = 2
      OTHERS         = 3.

  IF SY-SUBRC EQ 0.
    READ TABLE MATCH WITH KEY VARNAM = 'ZZPEMBILANGBARU'.
    IF SY-SUBRC EQ 0.
      ZZPEMBILANGBARU = MATCH-ATFLV.
    ENDIF.

    READ TABLE MATCH WITH KEY VARNAM = 'ZZPENYEBUTBARU'.
    IF SY-SUBRC EQ 0.
      ZZPENYEBUTBARU = MATCH-ATFLV.
    ENDIF.
  ENDIF.

  WEIGHT = ZZPEMBILANGBARU / ZZPENYEBUTBARU.
ENDFORM.                    "GET_WEGHT

*&---------------------------------------------------------------------*
*&      Form  F_SQL_CONN
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM F_SQL_CONN.
  TRY.
      EXEC SQL.
        SET CONNECTION :P_CONN
      ENDEXEC.

      EXEC SQL.
        CONNECT TO :P_CONN AS 'DBAGS'
      ENDEXEC.
    CATCH CX_ROOT INTO O_CX.
      AGSCX_MSG = O_CX->GET_TEXT( ).

      IF AGSCX_MSG EQ 'Error creating a secondary database connection'.
        AGSCX_MSG = 'Please use server SAP Windows'.
      ENDIF.

      CONCATENATE 'Cannot establish the SQL connection: ' AGSCX_MSG INTO AGSCX_MSG SEPARATED BY SPACE.
      MESSAGE AGSCX_MSG TYPE 'S' DISPLAY LIKE 'E'.
      LEAVE LIST-PROCESSING.
  ENDTRY.
ENDFORM.                    "F_SQL_CONN

*&---------------------------------------------------------------------*
*&      Form  F_SQL_SEND
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM F_SQL_SEND.
  PERFORM F_SQL_CONN.
  PERFORM AGS_INSERT_LOG_SQL USING 'ZPP001_AGS' IT_DISPLAY[].
  PERFORM AGS_COMMIT_ROLLBACK.

  IF AGSCX_MSG IS NOT INITIAL.
    PERFORM F_UPDATEAGSDRC USING 'FAILED' R_ZDATA[].
    STOP.
  ENDIF.

  "Delete table temporary (X-table)
  CLEAR: AGSCX_MSG.
  TRY.
      EXEC SQL.
        DELETE FROM [DBO].[Y_ZEPP503]
      ENDEXEC.
    CATCH CX_ROOT INTO O_CX.
      AGSCX_MSG = O_CX->GET_TEXT( ).
      CONCATENATE 'Failed to truncate temp-table: ' AGSCX_MSG INTO AGSCX_MSG SEPARATED BY SPACE.
      MESSAGE AGSCX_MSG TYPE 'S' DISPLAY LIKE 'E'.
      LEAVE LIST-PROCESSING.
  ENDTRY.

  "Send report to SQL
  LOOP AT IT_DISPLAY.
    CLEAR: AGSCX_MSG.
    TRY.
        EXEC SQL.
          INSERT INTO [DBO].[Y_ZEPP503]
            ([PRODDATE],
            [INSTALDATE],
            [PRODOUTDATE],
            [KIND],
            [FILMTYPE],
            [SAPTYPE],
            [INPUTROLL],
            [COMBNO],
            [FIRSTSECOND],
            [DERIVATIVE_MS],
            [POSITION_MS],
            [DERIVATIVE_SS],
            [POSITION_SS],
            [WIDTH],
            [LENGTH],
            [WEIGTH],
            [CRITGRADE],
            [BATCHSR],
            [ORDER],
            [PRODUCTNO],
            [TOYOBONO],
            [TOYOBOLOT],
            [PRODUCTNOSAP],
            [JUDGE],
            [BASEFILMNO],
            [BASEFILMPRODDATE],
            [BASEFILMPRODWEIGHT],
            [BASEFILMPRODWIDTH],
            [BASEFILMPRODLENGTH],
            [EVA_JR_NO],
            [EVA_PRODDATE],
            [EVA_JR_WEIGHT],
            [COAT_JR_NO],
            [COAT_PRODDATE],
            [COAT_JR_WEIGHT])
          VALUES
            (:IT_DISPLAY-PROD_DATE,
             :IT_DISPLAY-INSTALL_DATE,
             :IT_DISPLAY-OUT_DATE,
             :IT_DISPLAY-KIND,
             :IT_DISPLAY-CODE,
             :IT_DISPLAY-CODE2,
             :IT_DISPLAY-INPUT_ROLL,
             :IT_DISPLAY-COMBINATIONNO,
             :IT_DISPLAY-ABLAD,
             :IT_DISPLAY-DERIVATIVE_MS,
             :IT_DISPLAY-POSITION_MS,
             :IT_DISPLAY-DERIVATIVE_SS,
             :IT_DISPLAY-POSITION_SS,
             :IT_DISPLAY-WIDTH,
             :IT_DISPLAY-LENGTH,
             :IT_DISPLAY-QTY,
             :IT_DISPLAY-CRIT_GRADE,
             :IT_DISPLAY-CHARG,
             :IT_DISPLAY-AUFNR,
             :IT_DISPLAY-ROLL_SR,
             :IT_DISPLAY-ROLL_TYB,
             :IT_DISPLAY-LOT_TYB,
             :IT_DISPLAY-ROLL_SR_SAP,
             :IT_DISPLAY-JUDGE,
             :IT_DISPLAY-ROLL_BASE,
             :IT_DISPLAY-PROD_BASE,
             :IT_DISPLAY-QTY_BASE,
             :IT_DISPLAY-WIDTH_BASE,
             :IT_DISPLAY-LENGTH_BASE,
             :IT_DISPLAY-ROLL_EVAP,
             :IT_DISPLAY-PROD_EVAP,
             :IT_DISPLAY-QTY_EVAP,
             :IT_DISPLAY-ROLL_COAT,
             :IT_DISPLAY-PROD_COAT,
             :IT_DISPLAY-QTY_COAT)
        ENDEXEC.
      CATCH CX_ROOT INTO O_CX.
        AGSCX_MSG = O_CX->GET_TEXT( ).
        CONCATENATE 'Failed to send data to SQL Server:' AGSCX_MSG INTO AGSCX_MSG SEPARATED BY SPACE.
        MESSAGE AGSCX_MSG TYPE 'S' DISPLAY LIKE 'E'.
        LEAVE LIST-PROCESSING.
    ENDTRY.
  ENDLOOP.

  IF AGSCX_MSG IS NOT INITIAL.
    VLOG_STATUS = '0'.
    PERFORM F_UPDATEAGSDRC USING 'FAILED' R_ZDATA[].
    PERFORM AGS_UPDATE_LOG USING VLOG_STATUS V_LOGMSG_RMCONS.
  ELSE.
    VLOG_STATUS = '1'.
    PERFORM AGS_UPDATE_LOG USING VLOG_STATUS V_LOGMSG_RMCONS.
    MESSAGE 'AGS logging complete.' TYPE 'S'.
  ENDIF.

  PERFORM AGS_COMMIT_ROLLBACK.
  PERFORM AGS_DISCONNECT.
ENDFORM.                    "F_SQL_SEND

*&---------------------------------------------------------------------*
*&      Form  F_SQL_JOB
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM F_SQL_JOB.
  "SET TARGET SERVER BASED ON CURRENT SERVER TO WINDOWS SERVER
  IF SY-HOST = 'trsteccdev' OR SY-HOST = 'TRIASWIN2008'.  "IF RUNNING SERVER IS AIX
    LV_JOBGROUP = 'TRIASWIN2008_TRD_01'.
    LV_TARGETSERVER = 'TRIASWIN2008_TRD_01'.
  ELSEIF SY-HOST = 'eccprodkr' OR SY-HOST = 'SAPTRPKR'. "IF RUNNING SERVER IS PRD
    LV_JOBGROUP  = 'SAPTRPKR_TRP_00'.
    LV_TARGETSERVER = 'SAPTRPKR_TRP_00'.
  ELSEIF SY-HOST = 'eccdevlinux'. "IF RUNNING SERVER IS DEV NC
    LV_JOBGROUP  = 'eccdevlinux_TRD_00'.
    LV_TARGETSERVER = 'eccdevlinux_TRD_00'.
  ELSE.
    MESSAGE 'Server Unknown, Contact IT for further information !' TYPE 'I'.
    RETURN.
  ENDIF.

  "Starting Job
  CALL FUNCTION 'JOB_OPEN'
    EXPORTING
      JOBGROUP         = LV_JOBGROUP
      JOBNAME          = LV_JOBNAME
    IMPORTING
      JOBCOUNT         = LV_JOBCOUNT
    EXCEPTIONS
      CANT_CREATE_JOB  = 1
      INVALID_JOB_DATA = 2
      JOBNAME_MISSING  = 3
      OTHERS           = 4.

  IF SY-SUBRC <> 0.
    MESSAGE 'Failed to create the Background Job, please contact IT.' TYPE 'I'.
    RETURN.
  ENDIF.

  SUBMIT ZPPR_BARRIER_PROD_LIST WITH S_GSTRP  IN S_GSTRP
                                WITH S_WERKS  EQ S_WERKS
                                WITH S_NOROL  IN S_NOROL
                                WITH S_ROLTYB IN S_ROLTYB
                                WITH S_FILM   IN  S_FILM
                                WITH S_CHARG  IN S_CHARG
                                WITH P_SCREEN EQ P_SCREEN
                                WITH P_OLAP   EQ P_OLAP
                                WITH P_JOB    EQ P_JOB
                                WITH P_CONN   EQ P_CONN
  VIA JOB LV_JOBNAME NUMBER LV_JOBCOUNT
  AND RETURN.

  "Ending Job
  CALL FUNCTION 'JOB_CLOSE'
    EXPORTING
      JOBCOUNT             = LV_JOBCOUNT
      JOBNAME              = LV_JOBNAME
      STRTIMMED            = 'X'
      TARGETSERVER         = LV_TARGETSERVER
    EXCEPTIONS
      CANT_START_IMMEDIATE = 1
      INVALID_STARTDATE    = 2
      JOBNAME_MISSING      = 3
      JOB_CLOSE_FAILED     = 4
      JOB_NOSTEPS          = 5
      JOB_NOTEX            = 6
      LOCK_FAILED          = 7
      INVALID_TARGET       = 8
      OTHERS               = 9.

  IF SY-SUBRC <> 0.
    MESSAGE 'Failed to start the Background Job, please contact IT.' TYPE 'I'.
    RETURN.
  ENDIF.

  LV_TIMER = 1.

  WHILE LV_TIMER LE 20.
    LV_ERROR = 'X'.

    CALL FUNCTION 'SHOW_JOBSTATE'
      EXPORTING
        JOBCOUNT         = LV_JOBCOUNT
        JOBNAME          = LV_JOBNAME
      IMPORTING
        FINISHED         = LV_FINISHED
      EXCEPTIONS
        JOBCOUNT_MISSING = 1
        JOBNAME_MISSING  = 2
        JOB_NOTEX        = 3
        OTHERS           = 4.

    IF SY-SUBRC <> 0.
      MESSAGE 'The Background Job is not finished successfully, please contact IT.' TYPE 'I'.
      EXIT.
    ENDIF.

    IF LV_FINISHED EQ 'X'.

      CALL FUNCTION 'BP_JOBLOG_READ'
        EXPORTING
          CLIENT                = SY-MANDT
          JOBCOUNT              = LV_JOBCOUNT
          JOBNAME               = LV_JOBNAME
        TABLES
          JOBLOGTBL             = LV_JOBMSG
        EXCEPTIONS
          CANT_READ_JOBLOG      = 1
          JOBCOUNT_MISSING      = 2
          JOBLOG_DOES_NOT_EXIST = 3
          JOBLOG_IS_EMPTY       = 4
          JOBLOG_NAME_MISSING   = 5
          JOBNAME_MISSING       = 6
          JOB_DOES_NOT_EXIST    = 7
          OTHERS                = 8.
      IF SY-SUBRC <> 0.
        MESSAGE 'Failed to read Background Job Log data!' TYPE 'I'.
      ENDIF.
      EXIT.
    ENDIF.

    WAIT UP TO 1 SECONDS.
    LV_TIMER = LV_TIMER + 1.
  ENDWHILE.

  IF LV_ERROR IS NOT INITIAL.   "cancel Job jika terdapat error
    " cek status Job
    CLEAR: LV_STATUS.
    CALL FUNCTION 'BP_JOB_STATUS_GET'
      EXPORTING
        JOBCOUNT                   = LV_JOBCOUNT
        JOBNAME                    = LV_JOBNAME
      IMPORTING
        STATUS                     = LV_STATUS
      EXCEPTIONS
        JOB_DOESNT_EXIST           = 1
        UNKNOWN_ERROR              = 2
        PARENT_CHILD_INCONSISTENCY = 3
        OTHERS                     = 4.

    IF SY-SUBRC <> 0.
      MESSAGE 'Proses di server tidak diketahui, mohon coba lagi.' TYPE 'I'.
    ELSE.
      " cancel Job jika status bukan 'Finished' dan bukan 'Canceled'
      IF LV_STATUS EQ 'Z'.

        CALL FUNCTION 'BP_JOB_ABORT'
          EXPORTING
            JOBCOUNT                   = LV_JOBCOUNT
            JOBNAME                    = LV_JOBNAME
          EXCEPTIONS
            CHECKING_OF_JOB_HAS_FAILED = 1
            JOB_ABORT_HAS_FAILED       = 2
            JOB_DOES_NOT_EXIST         = 3
            JOB_IS_NOT_ACTIVE          = 4
            NO_ABORT_PRIVILEGE_GIVEN   = 5
            OTHERS                     = 6.

        IF SY-SUBRC <> 0.
          IF SY-MSGTY NE 'S'.
            SY-MSGTY = 'S'.
          ENDIF.

          MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
                 WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
        ELSE.
          MESSAGE 'Terjadi kesalahan di server, mohon coba lagi' TYPE 'I'.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.                    "F_SQL_JOB

*&---------------------------------------------------------------------*
*&      Form  AGS_INSERT_LOG_SQL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PIN_TCODE     text
*      -->VALUE         text
*      -->(PIN_RMCONS)  text
*----------------------------------------------------------------------*
FORM AGS_INSERT_LOG_SQL
  USING PIN_TCODE TYPE C
        VALUE(PIN_RMCONS) TYPE STANDARD TABLE .

  CLEAR: VLOG_DATE,
         VLOG_TIME,
         VLOG_STATUS,
         VLOG_MSG,
         VLOG_TOTALRECORDS,
         VLOG_TCODE,
         VLOG_AGSTABLE,
         VLOG_TERMINAL,
         VLOG_TEMP.

  VLOG_DATE = SY-DATUM.               "-- set date
  WRITE SY-UZEIT TO VLOG_TIME.        "-- set time
  VLOG_TCODE = SY-TCODE.              "-- set tcode
  VLOG_STATUS = ''.                   "-- set initial log status

  "-- set computer name
  CALL FUNCTION 'GUI_GET_DESKTOP_INFO'
    EXPORTING
      TYPE   = '1'
    CHANGING
      RETURN = VLOG_TERMINAL.

  IF VLOG_TERMINAL IS INITIAL.
    VLOG_TERMINAL = 'BACKGROUND JOB'.
  ENDIF.

  PERFORM AGS_CONNECT_SQL.
  IF AGSCX_MSG IS NOT INITIAL.
    EXIT.
  ENDIF.

  "-- process log for AFPO
  "-- set table name for log
  VLOG_AGSTABLE = 'ZEPP503'.

  DESCRIBE TABLE PIN_RMCONS LINES VLOG_TOTALRECORDS.
  CONDENSE VLOG_TOTALRECORDS.

  "-- set message
  CONCATENATE VLOG_DATE VLOG_TIME VLOG_TCODE PIN_TCODE VLOG_AGSTABLE VLOG_TERMINAL INTO V_LOGMSG_RMCONS SEPARATED BY '|'.
  REPLACE ALL OCCURRENCES OF SUBSTRING ':' IN V_LOGMSG_RMCONS WITH ''. "-- remove time separator
  CONDENSE V_LOGMSG_RMCONS.

