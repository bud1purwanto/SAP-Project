  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZGRADE'.
  IF SY-SUBRC EQ 0.
    V_ZZGRADE = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZCRITERIA'.
  IF SY-SUBRC EQ 0.
    V_ZZCRIT = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZPRODLINE'.
  IF SY-SUBRC EQ 0.
    V_ZZPRODLINE = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZWIDTH'.
  IF SY-SUBRC EQ 0.
    V_ZZWIDTH = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZLENGTH'.
  IF SY-SUBRC EQ 0.
    V_ZZLENGTH = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZCONVERSIONROLLKG'.
  IF SY-SUBRC EQ 0.
    V_ZZCONVERSIONROLLKG = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZPOSITIONMS'.
  IF SY-SUBRC EQ 0.
    V_ZZPOSITIONMS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZDERIVATIVEMS'.
  IF SY-SUBRC EQ 0.
    V_ZZDERIVATIVEMS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZPOSITIONSS'.
  IF SY-SUBRC EQ 0.
    V_ZZPOSITIONSS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZDERIVATIVESS'.
  IF SY-SUBRC EQ 0.
    V_ZZDERIVATIVESS = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZTYBCOMBINATIONNO'.
  IF SY-SUBRC EQ 0.
    V_ZZTYBCOMBINATIONNO = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZGRAMMAGE'.
  IF SY-SUBRC EQ 0.
    V_ZZGRAMMAGE = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZEXLENGTH'.
  IF SY-SUBRC EQ 0.
    V_ZZEXLENGTH = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZEXLENGTHASAL'.
  IF SY-SUBRC EQ 0.
    V_ZZEXLENGTHASAL = IT_CABN-ATINN.
  ENDIF.

  READ TABLE IT_CABN WITH KEY ATNAM = 'ZZEXTRALENGTHASAL'.
  IF SY-SUBRC EQ 0.
    V_ZZEXTRALENGTHASAL = IT_CABN-ATINN.
  ENDIF.

  R_DESC-LOW = V_ZZCRIT.
  APPEND R_DESC.

  R_DESC-LOW = V_ZZCODE.
  APPEND R_DESC.

  IF R_DESC[] IS NOT INITIAL.
    R_DESC-SIGN   = 'I'.
    R_DESC-OPTION = 'EQ'.
    MODIFY R_DESC TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.
ENDFORM.                    "GET_CABN

*&---------------------------------------------------------------------*
*&      Form  GET_MAPPING
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_MAPPING.
  SELECT * INTO TABLE IT_MAP_CUTDATE
    FROM ZMAP_TYPE
   WHERE TCODE = SY-TCODE
     AND TYPE = 'BARRIER'
     AND OPT = 'CUT OVER'
     AND DELETION = ''.

  READ TABLE IT_MAP_CUTDATE INDEX 1.
  PERFORM CONVERT_DATE_INPUT USING IT_MAP_CUTDATE-VALUE CHANGING V_CUTDATE.

  "Edited by Dila 01.10.2025
  IF IT_MAP_CUTDATE[] IS NOT INITIAL.
    READ TABLE IT_MAP_CUTDATE INDEX 1.
    IF SY-SUBRC EQ 0.
      LOOP AT S_GSTRP.
        IF S_GSTRP-LOW LT V_CUTDATE.
          MESSAGE IT_MAP_CUTDATE-TEXT5 TYPE 'S' DISPLAY LIKE 'E'.
          LEAVE LIST-PROCESSING.
        ENDIF.
      ENDLOOP.
    ENDIF.
  ENDIF.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_JUDGEMENT
    FROM ZMAP_TYPE
   WHERE TYPE     EQ 'BARRIER'
     AND OPT      EQ 'JUDGEMENT'
     AND DELETION EQ ''.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_KIND
    FROM ZMAP_TYPE
   WHERE TYPE     EQ 'BARRIER'
     AND OPT      EQ 'KIND'
     AND DELETION EQ ''.

  SELECT VALUE AS LOW INTO CORRESPONDING FIELDS OF TABLE R_BWART
    FROM ZMAP_TYPE
   WHERE TYPE     EQ 'BARRIER'
     AND OPT      EQ 'MOVEMENT TYPE'
     AND TEXT1    EQ ''
     AND DELETION EQ ''.

  SELECT VALUE AS LOW INTO CORRESPONDING FIELDS OF TABLE R_BWARC
    FROM ZMAP_TYPE
   WHERE TYPE     EQ 'BARRIER'
     AND OPT      EQ 'MOVEMENT TYPE'
     AND TEXT1    EQ 'CANCEL'
     AND DELETION EQ ''.

  IF R_BWART[] IS NOT INITIAL.
    R_BWART-SIGN = 'I'.
    R_BWART-OPTION = 'EQ'.
    MODIFY R_BWART TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  IF R_BWARC[] IS NOT INITIAL.
    R_BWARC-SIGN = 'I'.
    R_BWARC-OPTION = 'EQ'.
    MODIFY R_BWARC TRANSPORTING OPTION SIGN WHERE SIGN = ''.
  ENDIF.

  SELECT DISTINCT ZCXLGORT AS LOW
     INTO CORRESPONDING FIELDS OF TABLE R_SLOCCX
     FROM ZTMAP_SLOCRR.

  IF SY-SUBRC = 0.
    R_SLOCCX-SIGN = 'I'.
    R_SLOCCX-OPTION = 'EQ'.
    MODIFY R_SLOCCX TRANSPORTING SIGN OPTION WHERE SIGN = ''.
    DELETE R_SLOCCX WHERE LOW = ''.
  ENDIF.
ENDFORM.                    "GET_MAPPING
