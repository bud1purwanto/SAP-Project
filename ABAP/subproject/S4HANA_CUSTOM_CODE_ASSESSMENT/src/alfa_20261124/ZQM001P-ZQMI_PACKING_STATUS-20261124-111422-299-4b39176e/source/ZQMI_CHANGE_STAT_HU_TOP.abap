*&---------------------------------------------------------------------*
*&  Include           ZQMI_CHANGE_STAT_HU_TOP
*&---------------------------------------------------------------------*
TABLES : VEKP, VEPO, HUSSTAT.
data: v_prog like Zproginfo-PGMNA value 'ZQMI_CHANGE_STAT_HU'.
DATA : ERMSG(100),
       PSTAT LIKE ZQM001-PSTAT,
       POBJNR(12),
       VENUM LIKE VEPO-VENUM,
       WAFIELD TYPE slis_fieldname,
       IT_ERROR  TYPE BAPIRET2 OCCURS 0 WITH HEADER LINE.

DATA: WA_XFIELDCAT TYPE SLIS_FIELDCAT_ALV.
DATA : IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE,
       WA_BDCMSGCOLL LIKE LINE OF IT_BDCMSGCOLL,
       IT_BDCMSGCOLLE LIKE STANDARD TABLE OF IT_BDCMSGCOLL.

TYPES : BEGIN OF TY_DATA,
          NO TYPE I,
          BOX TYPE checkbox, "plant selected/ HU NO
          EXIDV LIKE VEKP-EXIDV, "plants / HU NO
          PSTAT LIKE ZQM001-PSTAT, "QA Status
          PSTATD(10), "displayed status
          MATNR LIKE VEPO-MATNR, "Material
          CHARG LIKE VEPO-CHARG, "Batch SR
          LGORT LIKE VEPO-LGORT, "Sloc
          K(5),  "LIKE TJ30T-TXT04,"HU Status
          WERKS LIKE VEPO-WERKS, "Plant
          ERDAT LIKE VEKP-ERDAT, "Creation Date HU
          VENUM1 LIKE VEPO-VENUM,
          VENUM LIKE VEPO-VENUM, "Lower level HU
          OBJNR(12),
          STAT LIKE HUSSTAT-STAT,
       END OF  TY_DATA.

DATA : BEGIN OF ITVENUM OCCURS 0,
          VENUM LIKE VEPO-VENUM,
       END OF ITVENUM.

DATA : BEGIN OF ITUNVEL OCCURS 0,
          UNVEL LIKE VEPO-UNVEL,
       END OF ITUNVEL.
DATA : BEGIN OF ITLGORT OCCURS 0,
         VENUM LIKE VEPO-VENUM,
         LGORT LIKE VEPO-LGORT,
         CHARG  LIKE VEPO-CHARG,
       END OF ITLGORT.

DATA : ITRESULT  TYPE TABLE OF TY_DATA WITH HEADER LINE,
       WARESULT TYPE TY_DATA,
       CTR TYPE I.

DATA: LS_REF1 TYPE REF TO CL_GUI_ALV_GRID.

**************
TYPE-POOLS: SLIS.

* Data for listviewer
DATA: D_REPID      LIKE SY-REPID,
      T_FIELDCAT   TYPE SLIS_T_FIELDCAT_ALV WITH HEADER LINE,
      WA_KEYINFO   TYPE SLIS_KEYINFO_ALV,
      T_COLOR      TYPE SLIS_T_SPECIALCOL_ALV WITH HEADER LINE,
      WA_LAYOUT    TYPE SLIS_LAYOUT_ALV,
      T_PRINT      TYPE SLIS_PRINT_ALV,
      T_SORT       TYPE SLIS_T_SORTINFO_ALV WITH HEADER LINE,
      T_EXCLUDING  TYPE SLIS_T_EXTAB WITH HEADER LINE,
      T_EVENTS     TYPE SLIS_T_EVENT WITH HEADER LINE,
      T_EVENT_EXIT TYPE SLIS_T_EVENT_EXIT WITH HEADER LINE,
      T_LIST_TOP   TYPE SLIS_T_LISTHEADER,

* Variants
      WA_VARIANTE        LIKE DISVARIANT,
      WA_DEF_VARIANTE    LIKE DISVARIANT,
      D_VARIANT_EXIT(1) TYPE C.

DATA:
  GT_LIST_TOP_OF_PAGE TYPE SLIS_T_LISTHEADER,
  G_TOP_OF_PAGE  TYPE SLIS_FORMNAME VALUE 'TOP_OF_PAGE',
  GS_STARTDATE        LIKE SY-DATUM,
  GS_ENDDATE          LIKE SY-DATUM.
**************

DATA : OKCODE TYPE SY-UCOMM.
DATA : AD(1),
       MSGSPRA LIKE BDCMSGCOLL-MSGSPRA,
       MSGID LIKE BDCMSGCOLL-MSGID,
       MSGNR LIKE BDCMSGCOLL-MSGNR,
       ERRMSG(100),
       V_CHARG(10).
CONTROLS: TCHU TYPE TABLEVIEW USING SCREEN 0100.

*&SPWIZARD: DECLARATION OF TABLECONTROL 'THCU' ITSELF
CONTROLS: THCU TYPE TABLEVIEW USING SCREEN 0100.