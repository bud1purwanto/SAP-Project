         ZNOTE3 TYPE STRING,
       STATODO(1),
       LFART LIKE LIKP-LFART,
       END OF T_VEKP.

" Modified by William at 15.09.2026 (Define bulk cache for latest HU status from ZQM001 - generate by AI)
TYPES: BEGIN OF TY_ZQM001_CACHE_ZEXP,
         EXIDV LIKE ZQM001-EXIDV,
         PSTAT LIKE ZQM001-PSTAT,
