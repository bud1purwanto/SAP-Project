         HUSTAT LIKE HUSSTAT-STAT, "Add by Irma
         PRNT(001),
         VENUM    LIKE VEKP-VENUM,
         ERDAT    LIKE VEKP-ERDAT,
         UNVEL    LIKE VEPO-UNVEL,
         MAGRV    LIKE VEKP-MAGRV,
         ZSTAT(004),
         KTEXTMAT LIKE QALS-KTEXTMAT,
         CHARG    LIKE VEPO-CHARG,
         WERKS    LIKE VEPO-WERKS,
         MATNR    LIKE VEPO-MATNR,
         SONUM    LIKE VEPO-SONUM,
         MATKL    LIKE MARA-MATKL,
         SLROLL(030),
         JRROLL(030),
         PRUEFLOS LIKE QALS-PRUEFLOS,
         VCODE    LIKE QAVE-VCODE,
         VBELN    LIKE VEPO-VBELN,
         POSNR    LIKE VEPO-POSNR,
