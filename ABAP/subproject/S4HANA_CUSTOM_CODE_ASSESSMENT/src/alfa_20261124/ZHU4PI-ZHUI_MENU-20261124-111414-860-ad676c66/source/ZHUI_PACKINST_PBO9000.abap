MODULE STATUS_9000 OUTPUT.
  PERFORM F_CHECK_TCODE.
  PERFORM F_STATUS_9000.
ENDMODULE.                 " STATUS_9000  OUTPUT
*&---------------------------------------------------------------------*
*&      Form  F_CHECK_TCODE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM F_CHECK_TCODE .
  IMPORT FLAG_START FROM MEMORY ID 'ZHUI'.
  IF FLAG_START = ''.
     MESSAGE S002(ZMM) WITH 'Transaction' SY-TCODE 'does not exist'.
     LEAVE PROGRAM.
  ENDIF.
ENDFORM.                    " F_CHECK_TCODE