*&---------------------------------------------------------------------*
*&  Include           ZHUI_PACKINST_TOP
*&---------------------------------------------------------------------*
PROGRAM  ZHUI_PACKINST MESSAGE-ID ZMM.
INCLUDE ZHU_PACKINST_CONSTANTS.

TABLES:
  ZPACK_PCH.

TYPES:
  BEGIN OF TTAB_PINS.
        INCLUDE STRUCTURE ZPACK_PC.
TYPES:
    SELE TYPE FLAG,
  END OF TTAB_PINS.

** SCREEN VARS **
DATA:
  D_SOLDTO  TYPE KUNNR,
  D_SHIPTO  TYPE KUNNR,
  D_SOLDTO_T LIKE KNA1-NAME1,
  D_SHIPTO_T LIKE KNA1-NAME1,
  D_DISPMODE.


DATA:
  GS_COPY_FROM TYPE ZPINNR,
  GS_COPY_TO TYPE ZPINNR.

** PROCESS VARS **
DATA:
  ITAB_PINS_H    TYPE ZPACK_PCH,
  ITAB_PINS      TYPE STANDARD TABLE OF TTAB_PINS WITH HEADER LINE,
  D_ISFREESTOCK  TYPE FLAG,
  GS_COMPUTER_NAME TYPE STRING  ,
  ERRNO.

DATA:
  BEGIN OF ITAB_MATERIAL OCCURS 0,
    MATNR TYPE MATNR,
    VHART TYPE VHIART,
    MTART TYPE MTART,
    MEINS TYPE MEINS,
    MAKTX TYPE MAKTX,
    MAGRV TYPE MAGRV,
  END OF ITAB_MATERIAL.

DATA : FLAG_START.

LOAD-OF-PROGRAM.
  CALL FUNCTION 'POC_GET_COMPUTER_NAME'
    IMPORTING
      EX_COMPUTER_NAME = GS_COMPUTER_NAME.