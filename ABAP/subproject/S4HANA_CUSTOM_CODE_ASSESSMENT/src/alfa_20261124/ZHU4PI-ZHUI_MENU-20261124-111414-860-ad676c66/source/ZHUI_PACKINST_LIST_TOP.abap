*&---------------------------------------------------------------------*
*&  Include           ZHUI_PACKINST_LIST_TOP
*&---------------------------------------------------------------------*
REPORT  ZHUI_PACKINST_LIST .

INCLUDE ZHUI_PACKINST_CONSTANTS.
INCLUDE ZABAPALV.                  .    " global Data

TABLES:
  ZPACK_PCH,
  ZPACK_PC,
  AUSP,
  T001L.

DATA : BEGIN OF T_HELP OCCURS 0,
        PINNR TYPE ZPINNR,
        VBELN TYPE ZVBELN_PI,
        POSNR TYPE ZPOSNR_PI,
        PINST TYPE ZPINST,
        MATNR TYPE MATNR,
        DESCR TYPE TEXT50,
      END OF T_HELP.

DATA : IT_RETURN LIKE DDSHRETVAL OCCURS 0 WITH HEADER LINE.

SELECTION-SCREEN BEGIN OF BLOCK PINST WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS:
  S_PINNR   FOR ZPACK_PCH-PINNR MEMORY ID ZPI,
  S_VBELN   FOR ZPACK_PCH-VBELN MEMORY ID AUN,
  S_POSNR   FOR ZPACK_PCH-POSNR,
  S_WERKS   FOR ZPACK_PCH-WERKS OBLIGATORY,
  S_LGORT   FOR T001L-LGORT,
  S_TYPE    FOR AUSP-ATWRT,
  S_THICK   FOR AUSP-ATWRT.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 1(10) TEXT.
SELECTION-SCREEN POSITION 1.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 12(11) TEXT1.
SELECTION-SCREEN POSITION 9.
PARAMETERS : R1 AS CHECKBOX.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 12(11) TEXT2.
SELECTION-SCREEN POSITION 9.
PARAMETERS : R2 AS CHECKBOX.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 12(11) TEXT3.
SELECTION-SCREEN POSITION 9.
PARAMETERS : R3 AS CHECKBOX.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 12(11) TEXT4.
SELECTION-SCREEN POSITION 9.
PARAMETERS : R4 AS CHECKBOX.
SELECTION-SCREEN END OF LINE.

SELECT-OPTIONS:
S_PINST   FOR ZPACK_PCH-PINST NO-DISPLAY,
S_CRNAM   FOR ZPACK_PCH-CRNAM NO-EXTENSION NO INTERVALS,
S_CRDAT   FOR ZPACK_PCH-CRDAT.

SELECTION-SCREEN END OF BLOCK PINST.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR S_POSNR-LOW.
  PERFORM F4_SPOSNR .

AT SELECTION-SCREEN ON VALUE-REQUEST FOR S_POSNR-HIGH.
  PERFORM F4_SPOSNR .

AT SELECTION-SCREEN ON VALUE-REQUEST FOR  S_VBELN-LOW.
  PERFORM F4_SVBELN.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR S_VBELN-HIGH.
  PERFORM F4_SVBELN.

INITIALIZATION.
  TEXT   = 'Status :'.
  TEXT1  = 'Inactive'.
  TEXT2  = 'Active'.
  TEXT3  = 'In Progress'.
  TEXT4  = 'Completed'.


*-----------------------
* supporting variables
*-----------------------
  TYPES:
    BEGIN OF T_OUTPUT,
      PINNR    LIKE   ZPACK_PCH-PINNR,
      VBELN    LIKE   ZPACK_PCH-VBELN,
      POSNR    LIKE   ZPACK_PCH-POSNR,
      WERKS    LIKE   ZPACK_PCH-WERKS,
      LGORT    LIKE   ZPACK_PCH-LGORT,
      DESCR    LIKE   ZPACK_PCH-DESCR,
      PINST    LIKE   ZPACK_PCH-PINST,
      STATUS(11),
      SOLDTO   LIKE   KNA1-NAME1     ,
      SHIPTO   LIKE   KNA1-NAME1     ,
      CRNAM    LIKE   ZPACK_PCH-CRNAM,
      CRDAT    LIKE   ZPACK_PCH-CRDAT,
      CRTIM    LIKE   ZPACK_PCH-CRTIM,
      AENAM    LIKE   ZPACK_PCH-AENAM,
      AEDAT    LIKE   ZPACK_PCH-AEDAT,
      AETIM    LIKE   ZPACK_PCH-AETIM,
      ZZCRITERIABF LIKE ZPACK_PCH-ZZCRITERIABF,
      ZZCRITERIA1  LIKE ZPACK_PCH-ZZCRITERIA1,
      ZZCRITERIA2  LIKE ZPACK_PCH-ZZCRITERIA2,
      ZZCRITERIAR  LIKE ZPACK_PCH-ZZCRITERIAR,
      ZZCORE3   LIKE ZPACK_PCH-ZZCORE3,
      ZZCORE6   LIKE ZPACK_PCH-ZZCORE6,
      ZZSHEET   LIKE ZPACK_PCH-ZZSHEET,
      ZZTYPE(20),
      ZZTHICKNESS(20),
      MATNR    LIKE   ZPACK_PC-MATNR ,
      ZZCORE(20),
      ZZCRITERIA(20),
      PACKING(20),
    END OF T_OUTPUT,

    BEGIN OF T_OUTPUT_ITEM,
      PINNR    LIKE   ZPACK_PC-PINNR,
      ZINS01   LIKE   ZPACK_PC-ZINS01,
      ZINS02   LIKE   ZPACK_PC-ZINS02,
      ZINS03   LIKE   ZPACK_PC-ZINS03,
      MATNR    LIKE   ZPACK_PC-MATNR ,
      MAKTX    LIKE   MAKT-MAKTX     ,
      ZMENG    LIKE   ZPACK_PC-ZMENG ,
      MEINS    LIKE   ZPACK_PC-MEINS ,
    END OF T_OUTPUT_ITEM.

  DATA:
    ITAB_OUTPUT_ITEM TYPE TABLE OF T_OUTPUT_ITEM WITH HEADER LINE,
    ITAB_OUTPUT TYPE TABLE OF T_OUTPUT WITH HEADER LINE,
    ITAB_BDC    TYPE BDCDATA OCCURS 0  WITH HEADER LINE.

  DATA : VTENTRIES LIKE VTENTRIES OCCURS 0 WITH HEADER LINE.

  DATA :  LVL1,
          LVL2,
          LVL3,
          QTYBP TYPE P,
          QTY_BOX TYPE P,
          QTY_PALL TYPE P.

  DATA : BEGIN OF T_SIS OCCURS 0,
          INILVL TYPE ZPACK_PC-INILVL,
          ZMENG TYPE ZPACK_PC-ZMENG,
        END OF T_SIS.

  DATA: FLAG_OBLI TYPE STRING. "ADD NEW COMPANY
  DATA: TCODE LIKE SY-TCODE. "ADD NEW COMPANY