*&---------------------------------------------------------------------*
*&  Include           ZQMR_TRACEABILITY_TOP
*&---------------------------------------------------------------------*
TABLES: MCH1, AUSP, AUFM, MKPF, CRHD, MSEG, AFPO, VEKP, VEPO, KNA1.

DATA : BEGIN OF IT_DETAIL OCCURS 0,
  MATNR     LIKE MCH1-MATNR,
  ATWRT     LIKE AUSP-ATWRT,
  CHARG     LIKE MCH1-CHARG,
  AUFNR     LIKE AUFM-AUFNR,
  MBLNR     LIKE AUFM-MBLNR,
  BWART     LIKE AUFM-BWART,
  ZEILE     LIKE AUFM-ZEILE,
  MJAHR     LIKE AUFM-MJAHR,
  CPUDT     LIKE MKPF-CPUDT,
  CPUTM     LIKE MKPF-CPUTM,
  ARBPL(12) TYPE C,
  P_CHARG   TYPE C LENGTH 150,"LIKE AUFM-CHARG,
  P_MATNR   LIKE MCH1-MATNR,
  P_ATWRT   TYPE C LENGTH 150,"LIKE AUSP-ATWRT,
  P_CPUDT   LIKE MKPF-CPUDT,
  P_CPUTM   LIKE MKPF-CPUTM,
  LEVEL     TYPE I,
  EBELN     LIKE MSEG-EBELN,
  EBELP     LIKE MSEG-EBELP,
  BKTXT     LIKE MKPF-BKTXT,
END OF IT_DETAIL.

DATA : BEGIN OF IAFPO OCCURS 0,
    MILL_OC_AUFNR_U LIKE AFPO-MILL_OC_AUFNR_U,
  END OF IAFPO.

DATA : BEGIN OF IT_MSEG OCCURS 0,
  AUFNR       LIKE MSEG-AUFNR,
  MBLNR       LIKE MSEG-MBLNR,
  MJAHR       LIKE MSEG-MJAHR,
  ZEILE       LIKE MSEG-ZEILE,
  SMBLN       LIKE MSEG-SMBLN,
  SJAHR       LIKE MSEG-SJAHR,
  SMBLP       LIKE MSEG-SMBLP,
  CPUDT_MKPF  LIKE MSEG-CPUDT_MKPF,
  CPUTM_MKPF  LIKE MSEG-CPUTM_MKPF,
  EBELN       LIKE MSEG-EBELN,
  EBELP       LIKE MSEG-EBELP,
  MATNR       LIKE MSEG-MATNR,
  LIFNR       LIKE MSEG-LIFNR,
  BWART       LIKE MSEG-BWART,
  CHARG       LIKE MSEG-CHARG,
END OF IT_MSEG.

DATA: V_MAT2MAT TYPE I,
      V_ERROR TYPE I.

DATA: V_CHARGBF LIKE MCH1-CHARG.

"Mat to Mat
DATA: BEGIN OF IT_CHARG OCCURS 0,
    MATNR LIKE MCHA-MATNR,
    CHARG LIKE MCHA-CHARG,
    WERKS LIKE MCHA-WERKS,
END OF IT_CHARG.

DATA :  IT_CLBATCH      LIKE CLBATCH OCCURS 0 WITH HEADER LINE,
        IT_PREBATCH     LIKE IT_DETAIL OCCURS 0 WITH HEADER LINE,
        IT_MSEG2        LIKE IT_MSEG OCCURS 0 WITH HEADER LINE,
        IT_DETAIL2      LIKE IT_DETAIL OCCURS 0 WITH HEADER LINE,
        IT_HEADER       LIKE IT_DETAIL OCCURS 0 WITH HEADER LINE,
        IT_DATA_HEADER  LIKE IT_DETAIL OCCURS 0 WITH HEADER LINE,
        WA_DATA_HEADER  LIKE IT_DETAIL OCCURS 0 WITH HEADER LINE,
        IT_HEADER2      LIKE IT_HEADER OCCURS 0 WITH HEADER LINE,
        IT_DATA_HEADER2 LIKE IT_DATA_HEADER OCCURS 0 WITH HEADER LINE.

DATA: VATINN      LIKE AUSP-ATINN,
      VSTATUS     LIKE MSEG-MBLNR,
      VAUFNR      LIKE AUFM-AUFNR,
      VCHARG      LIKE AUFM-CHARG,
      PREVCHARG   LIKE AUFM-CHARG,
      VMATNR      LIKE MCH1-MATNR,
      VARIABEL    LIKE AUSP-ATWRT,
      VCOMBINE    LIKE AUFM-AUFNR,
      VBKTXT      LIKE MKPF-BKTXT,
      SEQ_BATCH   TYPE P,
      DT_STATUS   TYPE N,
      STS_PROCESS TYPE N,
      VSORT       TYPE N LENGTH 3,
      VLVL        TYPE N LENGTH 3.

DATA: BEGIN OF IT_DISPLAY OCCURS 0,
        MBLNR LIKE MSEG-MBLNR,
        MJAHR LIKE MSEG-MJAHR,
        ZEILE LIKE MSEG-ZEILE,
        MATNR LIKE MSEG-MATNR,
        CHARG LIKE MSEG-CHARG,
        KUNNR LIKE MSEG-KUNNR,
        NAME1 LIKE KNA1-NAME1,
        BUDAT_MKPF LIKE MSEG-BUDAT_MKPF,
        VBELN_IM LIKE MSEG-VBELN_IM,
        VBELP_IM LIKE MSEG-VBELP_IM,
        EXIDV LIKE VEKP-EXIDV,
        ATWTB LIKE CAWNT-ATWTB,
      END OF IT_DISPLAY.

DATA: BEGIN OF IT_FINAL OCCURS 0,
        MBLNR LIKE MSEG-MBLNR,
        MJAHR LIKE MSEG-MJAHR,
        ZEILE LIKE MSEG-ZEILE,
        BWART LIKE MSEG-BWART,
        MATNR LIKE MSEG-MATNR,
        CHARG LIKE MSEG-CHARG,
        SJAHR LIKE MSEG-SJAHR,
        SMBLN LIKE MSEG-SMBLN,
        SMBLP LIKE MSEG-SMBLP,
      END OF IT_FINAL.

DATA: BEGIN OF IT_ISSUE OCCURS 0,
        MBLNR LIKE MSEG-MBLNR,
        MJAHR LIKE MSEG-MJAHR,
        ZEILE LIKE MSEG-ZEILE,
        LINE_ID LIKE MSEG-LINE_ID,
        PARENT_ID LIKE MSEG-PARENT_ID,
        MATNR LIKE MSEG-MATNR,
        CHARG LIKE MSEG-CHARG,
        BWART LIKE MSEG-BWART,
        AUFNR LIKE MSEG-AUFNR,
        EBELN LIKE MSEG-EBELN,
        EBELP LIKE MSEG-EBELP,
        SJAHR LIKE MSEG-SJAHR,
        SMBLN LIKE MSEG-SMBLN,
        SMBLP LIKE MSEG-SMBLP,
      END OF IT_ISSUE.

DATA: BEGIN OF IT_ORDER OCCURS 0,
        AUFNR LIKE AFPO-AUFNR,
        MILL_OC_AUFNR_U LIKE AFPO-MILL_OC_AUFNR_U,
      END OF IT_ORDER.

DATA: BEGIN OF IT_ORDER2 OCCURS 0,
        AUFNR LIKE AFPO-AUFNR,
      END OF IT_ORDER2.

DATA: BEGIN OF IT_ORDER3 OCCURS 0,
        MBLNR LIKE MSEG-MBLNR,
        MJAHR LIKE MSEG-MJAHR,
        ZEILE LIKE MSEG-ZEILE,
        MATNR LIKE MSEG-MATNR,
        CHARG LIKE MSEG-CHARG,
        BWART LIKE MSEG-BWART,
        AUFNR LIKE MSEG-AUFNR,
        SJAHR LIKE MSEG-SJAHR,
        SMBLN LIKE MSEG-SMBLN,
        SMBLP LIKE MSEG-SMBLP,
      END OF IT_ORDER3.

DATA: IT_ISSUE_PO LIKE IT_ISSUE OCCURS 0 WITH HEADER LINE,
      IT_ISSUE_OR LIKE IT_ISSUE OCCURS 0 WITH HEADER LINE,
      IT_FINAL2 LIKE IT_FINAL OCCURS 0 WITH HEADER LINE,
      IT_FINAL3 LIKE IT_FINAL OCCURS 0 WITH HEADER LINE,
      IT_ISSUE2 LIKE IT_ISSUE OCCURS 0 WITH HEADER LINE,
      IT_LIST LIKE IT_ORDER3 OCCURS 0 WITH HEADER LINE.

DATA: X             TYPE N,
      CHECK         LIKE MCH1-CHARG,
      ITERATION(30) TYPE C,
      ORIROLL(300)  TYPE C,
      VTEXT(100)    TYPE C,
      VARBPL        LIKE CRHD-ARBPL.

TYPE-POOLS: SLIS.
DATA: GS_LAYOUT                 TYPE SLIS_LAYOUT_ALV,
      G_EXIT_CAUSED_BY_CALLER,
      GS_EXIT_CAUSED_BY_USER    TYPE SLIS_EXIT_BY_USER,
      GT_FIELDCAT               TYPE SLIS_T_FIELDCAT_ALV,
      G_REPID                   LIKE SY-REPID,
      Y_PRINT                   TYPE SLIS_PRINT_ALV,
      GS_SORT_INFO              TYPE  SLIS_SORTINFO_ALV.

DATA: GS_VARIANT LIKE DISVARIANT,
      G_SAVE.

DATA:
    GT_EVENTS       TYPE SLIS_T_EVENT,
    GT_LIST_TOP_OF_PAGE TYPE SLIS_T_LISTHEADER,
    G_STATUS_SET    TYPE SLIS_FORMNAME VALUE 'PF_STATUS_SET',
    G_USER_COMMAND  TYPE SLIS_FORMNAME VALUE 'USER_COMMAND',
    G_TOP_OF_PAGE TYPE SLIS_FORMNAME VALUE 'TOP_OF_PAGE',
    G_TOP_OF_LIST   TYPE SLIS_FORMNAME VALUE 'TOP_OF_LIST',
    G_END_OF_LIST   TYPE SLIS_FORMNAME VALUE 'END_OF_LIST',
    GT_SORT_INFO    TYPE  SLIS_T_SORTINFO_ALV.

FIELD-SYMBOLS: <FS_DETAIL> LIKE LINE OF IT_DETAIL,
               <FS_PREBATCH> LIKE LINE OF IT_PREBATCH.

SELECTION-SCREEN BEGIN OF BLOCK SELECTION WITH FRAME TITLE TEXT-001.
PARAMETERS: V_ATWRT TYPE AUSP-ATWRT.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 37(3) TEXT.
SELECTION-SCREEN END OF LINE.
PARAMETERS: V_CHARG TYPE MCH1-CHARG.
SELECTION-SCREEN END OF BLOCK SELECTION.

*-- Radio Button
SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-002.
PARAMETERS: R1 RADIOBUTTON GROUP RAD1 DEFAULT 'X'.
PARAMETERS: R2 RADIOBUTTON GROUP RAD1.
PARAMETERS: R3 RADIOBUTTON GROUP RAD1.
SELECTION-SCREEN END OF BLOCK B1.