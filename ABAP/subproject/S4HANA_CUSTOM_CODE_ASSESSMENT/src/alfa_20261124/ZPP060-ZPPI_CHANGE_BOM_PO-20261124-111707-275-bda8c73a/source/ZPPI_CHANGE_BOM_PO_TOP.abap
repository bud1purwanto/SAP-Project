  LOOP AT SCREEN.
    IF SCREEN-GROUP1 = 'ZEI'.
      SCREEN-ACTIVE = 0.
      SCREEN-REQUIRED = 0.
      SCREEN-INPUT = 0.
      SCREEN-OUTPUT = 0.
      SCREEN-INVISIBLE = 1.
      MODIFY SCREEN.
     ELSEIF SCREEN-GROUP1 = 'MAT'.
      SCREEN-ACTIVE = 0.
      SCREEN-REQUIRED = 0.
      SCREEN-INPUT = 0.
      SCREEN-OUTPUT = 0.
      SCREEN-INVISIBLE = 1.
      MODIFY SCREEN.
    ENDIF.
