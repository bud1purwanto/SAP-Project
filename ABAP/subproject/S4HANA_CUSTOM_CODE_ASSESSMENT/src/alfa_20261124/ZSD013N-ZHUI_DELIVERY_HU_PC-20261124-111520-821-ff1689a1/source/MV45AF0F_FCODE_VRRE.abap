*---------------------------------------------------------------------*
*       FORM FCODE_VRRE                                               *
*---------------------------------------------------------------------*
*       Aufruf Retourenlieferung zum Reparaturauftrag                 *
*---------------------------------------------------------------------*
FORM FCODE_VRRE USING H185F STRUCTURE T185F H185  STRUCTURE T185
                                            H185V STRUCTURE T185V.
TABLES: TVLK.
DATA: BEGIN OF BDCDATA OCCURS 10.
        INCLUDE STRUCTURE BDCDATA.
DATA: END OF BDCDATA.
DATA: DA_DATE LIKE LV50C-DATBI VALUE '99991231'.

  IF TVLK-LFART NE TVAK-LFARV.
    SELECT SINGLE * FROM TVLK WHERE LFART EQ TVAK-LFARV.
  ENDIF.
  IF TVLK-VBTYP NA VBTYP_LIRE.
*   Nur Retourenlieferarten sind erlaubt
    MESSAGE W863.
    LEAVE TO TRANSACTION 'VRRE'.
  ENDIF.

  SET PARAMETER ID 'ALT' FIELD TVAK-LFARV.

  REFRESH BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-PROGRAM = 'SAPMV50A'.
  BDCDATA-DYNPRO  = '0100'.
  BDCDATA-DYNBEGIN   = 'X'.
  APPEND BDCDATA.
*
  CLEAR BDCDATA.
  BDCDATA-FNAM = 'LV50C-VBELN'.
  BDCDATA-FVAL = VBAK-VBELN.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-FNAM = 'LIKP-VSTEL'.
  BDCDATA-FVAL = VBAP-VSTEL.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-FNAM = 'LV50C-DATBI'.
  WRITE DA_DATE TO BDCDATA-FVAL.
  APPEND  BDCDATA.

*
  CLEAR BDCDATA.
  BDCDATA-FNAM = 'BDC_OKCODE'.
  BDCDATA-FVAL = 'LIAR'.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-PROGRAM = 'SAPMV50A'.
  BDCDATA-DYNPRO  = '0103'.
  BDCDATA-DYNBEGIN   = 'X'.
  APPEND BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-FNAM = 'LIKP-LFART'.
  BDCDATA-FVAL = TVAK-LFARV.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-FNAM = 'LIKP-VKORG'.
  BDCDATA-FVAL = VBAK-VKORG.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-FNAM = 'RV50A-VTWEG'.
  BDCDATA-FVAL = VBAK-VTWEG.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-FNAM = 'RV50A-SPART'.
  BDCDATA-FVAL = VBAK-SPART.
  APPEND  BDCDATA.

*
  CLEAR BDCDATA.
  BDCDATA-FNAM = 'BDC_OKCODE'.
  BDCDATA-FVAL = 'UEKO'.
  APPEND  BDCDATA.

  CLEAR BDCDATA.
  BDCDATA-PROGRAM = 'SAPMV50A'.
  BDCDATA-DYNPRO  = '0220'.
  BDCDATA-DYNBEGIN   = 'X'.
  APPEND BDCDATA.

  CALL TRANSACTION 'VL01' USING BDCDATA
                          MODE   'E'
                          UPDATE 'A'. "AND SKIP FIRST SCREEN.

  LEAVE TO TRANSACTION 'VRRE'.
ENDFORM.