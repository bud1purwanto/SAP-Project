FORM NACHRICHTEN_ARCHIV_ANZEIGE.

DATA: BEGIN OF I_OBJECTCONN OCCURS 1.
        INCLUDE STRUCTURE OBJECTCONN.
DATA: END OF I_OBJECTCONN.
DATA: BEGIN OF I_PARAMETERS OCCURS 1.
        INCLUDE STRUCTURE PARAMETERS.
DATA: END OF I_PARAMETERS.
DATA: XOBJID LIKE TOA_DARA-OBJECT_ID.
DATA: BEGIN OF VBELN_MASK,
        VBELN LIKE VBAK-VBELN,
        MASK VALUE '*',
      END OF VBELN_MASK.

  REFRESH:  I_OBJECTCONN, I_PARAMETERS.
  CLEAR:    I_OBJECTCONN, I_PARAMETERS.

  VBELN_MASK-VBELN = VBAK-VBELN.
  XOBJID = VBELN_MASK.
* Ermitteln der Objektart
  PERFORM T681Z_SELECT USING TVAK-KAPPL SY-SUBRC.
* Aufruf Archivelink
  I_OBJECTCONN-OBJECTTYPE = T681Z-OJ_NAME.
  I_OBJECTCONN-OBJECTID = XOBJID.
  APPEND I_OBJECTCONN.

* Ermitteln des Businessobjekts aus dem Vertriebsbelegtyp
  CALL FUNCTION 'SD_OBJECT_TYPE_DETERMINE'
       EXPORTING
            I_DOCUMENT_TYPE   = VBAK-VBTYP
       IMPORTING
            E_BUSINESS_OBJECT = I_OBJECTCONN-OBJECTTYPE
       EXCEPTIONS
            OTHERS            = 0.

  IF NOT I_OBJECTCONN-OBJECTTYPE IS INITIAL.
    I_OBJECTCONN-OBJECTID = VBAK-VBELN.
    APPEND I_OBJECTCONN.
  ENDIF.

  CALL FUNCTION 'OBJECT_DISPLAY_CONNECTIONS'
       TABLES
            OBJECT     =  I_OBJECTCONN
            PARAMETER  =  I_PARAMETERS
       EXCEPTIONS
            NOT_FOUND  = 1
            OTHERS     = 2.

  IF SY-SUBRC NE 0.
    MESSAGE ID SY-MSGID TYPE 'I' NUMBER SY-MSGNO
            WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.

ENDFORM.