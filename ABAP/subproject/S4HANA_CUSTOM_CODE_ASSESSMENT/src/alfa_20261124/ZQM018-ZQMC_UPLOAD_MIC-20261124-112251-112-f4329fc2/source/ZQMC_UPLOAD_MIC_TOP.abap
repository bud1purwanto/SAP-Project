LOAD-OF-PROGRAM.
  INFO = 'Program Information'.

*************************Get file name*********************************
AT SELECTION-SCREEN ON VALUE-REQUEST FOR FILENAME.
*POPUP TO SELECT FILE NAME
  CALL FUNCTION 'WS_FILENAME_GET'
    EXPORTING
      DEF_PATH         = 'C:\'
      MASK             = ',*.*,*.*.'
      MODE             = 'O'
    IMPORTING
      FILENAME         = FILENAME
    EXCEPTIONS
      INV_WINSYS       = 1
      NO_BATCH         = 2
      SELECTION_CANCEL = 3
      SELECTION_ERROR  = 4
      OTHERS           = 5.

*************************Get file name*********************************