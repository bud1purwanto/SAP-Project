*&---------------------------------------------------------------------*
*&  Include           FV50XF0B_APO_SDFIELDS                            *
*&---------------------------------------------------------------------*

FORM APO_SDFIELDS
     TABLES ET_SDFIELDS      STRUCTURE ATPFIELD
            KSSK_TAB         STRUCTURE RMCLKSSK
     USING  BELEG            TYPE      VBELN
            POSITION         TYPE      POSNR
            BELEGTYP         TYPE      VBTYP
            METHODE          TYPE      UPDKZ_D
            KFDNA_CUOBJ      TYPE      APO_KFDNA
            KFDNA_CUOBJ_CH   TYPE      APO_KFDNA
            VALUE_CUOBJ      TYPE      CUOBJ_VA
            VALUE_CUOBJ_CH   TYPE      CUOBJ_CH.

* Fill (KFDNA =) DLVDMETH, DLVDPROD, DLVDLOC, DLVDCAT
  ET_SDFIELDS-DELNR = BELEG.
  ET_SDFIELDS-DELPS = POSITION.
  ET_SDFIELDS-KFDNA = 'DLVDMETH'.
  ET_SDFIELDS-VALUE = METHODE.
  APPEND ET_SDFIELDS.
  ET_SDFIELDS-DELNR = BELEG.
  ET_SDFIELDS-DELPS = POSITION.
  ET_SDFIELDS-KFDNA = 'DLVDPROD'.
  ET_SDFIELDS-VALUE = XLIPS-MATNR.
  APPEND ET_SDFIELDS.
  ET_SDFIELDS-DELNR = BELEG.
  ET_SDFIELDS-DELPS = POSITION.
  ET_SDFIELDS-KFDNA = 'DLVDLOC'.
  ET_SDFIELDS-VALUE = XLIPS-WERKS.
  APPEND ET_SDFIELDS.
  ET_SDFIELDS-DELNR = BELEG.
  ET_SDFIELDS-DELPS = POSITION.
  ET_SDFIELDS-KFDNA = 'DLVDCAT'.
  ET_SDFIELDS-VALUE = BELEGTYP.
  APPEND ET_SDFIELDS.
* Fill CUOBJ (KFDNA = APO_SD_LIPS_CUOBJ or APO_SD_CUOBJ)
  IF NOT VALUE_CUOBJ IS INITIAL.
    ET_SDFIELDS-DELNR = BELEG.
    ET_SDFIELDS-DELPS = POSITION.
    ET_SDFIELDS-KFDNA = KFDNA_CUOBJ.
    ET_SDFIELDS-VALUE = VALUE_CUOBJ.
    APPEND ET_SDFIELDS.
    CALL FUNCTION 'CUCB_GET_UPDATE_STATUS_OF_INST'
      EXPORTING
        INSTANCE                     = VALUE_CUOBJ
      EXCEPTIONS
        INVALID_INSTANCE             = 1
        INSTANCE_IS_A_CLASSIFICATION = 2
        NEW_INSTANCE                 = 3
        DB_INSTANCE                  = 4
        OTHERS                       = 5.
    IF SY-SUBRC EQ 3.
      ET_SDFIELDS-DELNR = BELEG.
      ET_SDFIELDS-DELPS = POSITION.
      ET_SDFIELDS-KFDNA = 'COISNEW'.
      ET_SDFIELDS-VALUE = CHARX.
      APPEND ET_SDFIELDS.
    ENDIF.
  ENDIF.
* cuobj_ch:
  IF NOT VALUE_CUOBJ_CH IS INITIAL.
    ET_SDFIELDS-DELNR = BELEG.
    ET_SDFIELDS-DELPS = POSITION.
    ET_SDFIELDS-KFDNA = KFDNA_CUOBJ_CH.
    ET_SDFIELDS-VALUE = VALUE_CUOBJ_CH.
    APPEND ET_SDFIELDS.

    READ TABLE KSSK_TAB WITH KEY CUOBJ = VALUE_CUOBJ_CH.
    IF  SY-SUBRC      IS INITIAL
    AND KSSK_TAB-VBKZ EQ CHARI.
      ET_SDFIELDS-DELNR = BELEG.
      ET_SDFIELDS-DELPS = POSITION.
      ET_SDFIELDS-KFDNA = 'CLISNEW'.
      ET_SDFIELDS-VALUE = CHARX.
      APPEND ET_SDFIELDS.
    ENDIF. "IF  SY-SUBRC      IS INITIAL
           "AND KSSK_TAB-VBKZ EQ CHARI.
  ENDIF. " IF NOT VALUE_CUOBJ_CH IS INITIAL.

ENDFORM.                    "APO_SDFIELDS