*----------------------------------------------------------------------*
*   INCLUDE MV50AF0C_CUA_FCODE_ITEM                                    *
*----------------------------------------------------------------------*
*  Activation of fcodes belonging to the item detail tabstrips
*
FORM CUA_FCODE_ITEM.

  IF TAXI_SCREEN_GROUP(1) EQ C_TAXI_SCRGRP_HEAD(1).

    PERFORM CUA_FCODE_ALLOW USING 'IFOR_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'IABW_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'IMAT_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'CHSP_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'IPIC_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'ILOA_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'IPRE_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'IFIN_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'ITEC_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'ITEX_T' NO.
    PERFORM CUA_FCODE_ALLOW USING 'IKON_T' NO.

  ELSE.

    PERFORM CUA_FCODE_ALLOW USING 'IFOR_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'IABW_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'IMAT_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'CHSP_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'IPIC_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'ILOA_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'IPRE_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'IFIN_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'ITEC_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'ITEX_T' YES.
    PERFORM CUA_FCODE_ALLOW USING 'IKON_T' YES.

  ENDIF.

  CHECK TAXI_SCREEN_GROUP(1) EQ C_TAXI_SCRGRP_ITEM(1) OR
        TAXI_SCREEN_GROUP(1) EQ C_TAXI_SCRGRP_BATCH(1).

  CASE TAXI_PANEL.
    WHEN 'IFOR'.
      PERFORM CUA_FCODE_ALLOW USING 'IFOR_T' NO.
    WHEN 'IABW'.
      PERFORM CUA_FCODE_ALLOW USING 'IABW_T' NO.
    WHEN 'IMAT'.
      PERFORM CUA_FCODE_ALLOW USING 'IMAT_T' NO.
    WHEN 'CHSP'.
      PERFORM CUA_FCODE_ALLOW USING 'CHSP_T' NO.
    WHEN 'IPIC'.
      PERFORM CUA_FCODE_ALLOW USING 'IPIC_T' NO.
    WHEN 'ILOA'.
      PERFORM CUA_FCODE_ALLOW USING 'ILOA_T' NO.
    WHEN 'IPRE'.
      PERFORM CUA_FCODE_ALLOW USING 'IPRE_T' NO.
    WHEN 'IFIN'.
      PERFORM CUA_FCODE_ALLOW USING 'IFIN_T' NO.
    WHEN 'ITEC'.
      PERFORM CUA_FCODE_ALLOW USING 'ITEC_T' NO.
    WHEN 'ITEX'.
      PERFORM CUA_FCODE_ALLOW USING 'ITEX_T' NO.
    WHEN 'IKON'.
      PERFORM CUA_FCODE_ALLOW USING 'IKON_T' NO.
  ENDCASE.

ENDFORM.
































