*---------------------------------------------------------------------*
*       FORM YVBBE_APO_REWORK                                         *
*---------------------------------------------------------------------*
FORM YVBBE_APO_REWORK.

  DATA:
    DA_LGMNG_NEW LIKE LIPS-LGMNG,
    DA_UMSOK LIKE T156B-UMSOK,
    DA_VBBED_NEWDEL LIKE VBBED.

  LOCAL: XLIKP, XLIPS, XVBAP, XVBUP, YLIPS, YVBUP.

  LOOP AT YVBBE WHERE UPDKZ EQ UPDKZ_DELETE
                  AND APOMOBILE IS INITIAL
                  AND SOBKZ NA 'VW'
                  AND VBTYP CA VBTYP_LINO.
    READ TABLE YLIPS WITH KEY MANDT = YVBBE-MANDT
                              VBELN = YVBBE-VBELN
                              POSNR = YVBBE-POSNR.
    CHECK SY-SUBRC EQ 0 AND NOT YLIPS-VGTYP IS INITIAL.
    IF YLIPS-UPDKZ EQ UPDKZ_DELETE.
      CHECK YLIPS-LGMNG NE 0.
      DA_LGMNG_NEW = 0.
    ELSE.
      READ TABLE XLIPS WITH KEY MANDT = YVBBE-MANDT
                                VBELN = YVBBE-VBELN
                                POSNR = YVBBE-POSNR.
      CHECK SY-SUBRC EQ 0 AND XLIPS-LGMNG NE YLIPS-LGMNG.
      READ TABLE YVBUP WITH KEY MANDT = YVBBE-MANDT
                                VBELN = YVBBE-VBELN
                                POSNR = YVBBE-POSNR.
      CHECK SY-SUBRC EQ 0 AND YVBUP-WBSTA NE CHARC.
      READ TABLE XVBUP WITH KEY MANDT = YVBBE-MANDT
                                VBELN = YVBBE-VBELN
                                POSNR = YVBBE-POSNR.
      CHECK SY-SUBRC EQ 0 AND XVBUP-WBSTA EQ CHARC.
      DA_LGMNG_NEW = XLIPS-LGMNG.
    ENDIF.
    YVBBE-APOMOBILE = CHAR0.            "R/3 Update; No Transfer to APO
    MODIFY YVBBE TRANSPORTING APOMOBILE.
    DA_VBBED_NEWDEL = YVBBE.
    DA_VBBED_NEWDEL-OMENG = DA_LGMNG_NEW.
    DA_VBBED_NEWDEL-VMENG = DA_LGMNG_NEW.
    DA_VBBED_NEWDEL-APOMOBILE = CHAR5.  "No R/3 Update; Transfer to APO
    APPEND DA_VBBED_NEWDEL TO YVBBE.
  ENDLOOP.

  LOOP AT XLIPS WHERE UPDKZ EQ UPDKZ_NEW
                  AND LGMNG GT 0
                  AND SOBKZ NA 'VW'
                  AND VGTYP CA VBTYP_VERK.
    READ TABLE XVBUP WITH KEY MANDT = XLIPS-MANDT
                              VBELN = XLIPS-VBELN
                              POSNR = XLIPS-POSNR.
    CHECK SY-SUBRC EQ 0 AND XVBUP-WBSTA EQ CHARC.
    CALL FUNCTION 'SD_SPECIAL_STOCK_ASSIGN'
         EXPORTING
              MOVEMENT_TYPE           = XLIPS-BWART
              RETURNS_ITEM            = CHARX
              SPECIAL_STOCK_TYPE      = XLIPS-SOBKZ
         IMPORTING
              STOCK_TYPE_TRANSFER     = DA_UMSOK
         EXCEPTIONS
              ITEM_CATEGORY_NOT_VALID = 01
              NOT_FOUND               = 02
              NO_MOVEMENT_TYPE        = 03
              NO_RETURNS_ITEM         = 04.
    CHECK SY-SUBRC NE 0 OR DA_UMSOK NA 'VW'.
    READ TABLE YVBBE WITH KEY MANDT = XLIPS-MANDT
                              VBELN = XLIPS-VGBEL
                              POSNR = XLIPS-VGPOS.
    IF SY-SUBRC EQ 0.
      CHECK YVBBE-APOMOBILE IS INITIAL.
    READ TABLE XVBAP WITH KEY MANDT = XLIPS-MANDT
                              VBELN = XLIPS-VGBEL
                              POSNR = XLIPS-VGPOS.
    CHECK SY-SUBRC EQ 0.
    ELSE.
      CHECK NOT XLIPS-UECHA IS INITIAL.
      READ TABLE YVBBE WITH KEY MANDT = XLIPS-MANDT
                                VBELN = XLIPS-VBELN
                                POSNR = XLIPS-UECHA.
      CHECK SY-SUBRC EQ 0 AND YVBBE-APOMOBILE CA ' 0'.
    ENDIF.
    READ TABLE XLIKP WITH KEY MANDT = XLIPS-MANDT
                              VBELN = XLIPS-VBELN.
    CHECK SY-SUBRC EQ 0.
    CLEAR DA_VBBED_NEWDEL.
    MOVE-CORRESPONDING XLIPS TO DA_VBBED_NEWDEL.
    IF XLIPS-CHARG IS INITIAL AND XLIPS-XCHPF IS INITIAL.
      DA_VBBED_NEWDEL-CHARG = XLIPS-BWTAR.
    ENDIF.
    DA_VBBED_NEWDEL-VBTYP = XLIKP-VBTYP.
    DA_VBBED_NEWDEL-OMENG = XLIPS-LGMNG.
    DA_VBBED_NEWDEL-VMENG = XLIPS-LGMNG.
    DA_VBBED_NEWDEL-VBELE = XLIPS-VBELV.
    DA_VBBED_NEWDEL-POSNE = XLIPS-POSNV.
    DA_VBBED_NEWDEL-AUART = XLIKP-LFART.
    DA_VBBED_NEWDEL-KUNNR = XLIKP-KUNAG.
    DA_VBBED_NEWDEL-NODIS = YVBBE-NODIS.
    DA_VBBED_NEWDEL-PSPEL = XLIPS-PS_PSP_PNR.
    DA_VBBED_NEWDEL-WADEL = CHARX.
    DA_VBBED_NEWDEL-UPDKZ = UPDKZ_NEW.
    DA_VBBED_NEWDEL-APOMOBILE = CHAR5.
    DA_VBBED_NEWDEL-LFDAT = XLIKP-LFDAT.
    DA_VBBED_NEWDEL-LFUHR = XLIKP-LFUHR.
    DA_VBBED_NEWDEL-KUNWE = XLIKP-KUNNR.
    APPEND DA_VBBED_NEWDEL TO YVBBE.
  ENDLOOP.

ENDFORM.