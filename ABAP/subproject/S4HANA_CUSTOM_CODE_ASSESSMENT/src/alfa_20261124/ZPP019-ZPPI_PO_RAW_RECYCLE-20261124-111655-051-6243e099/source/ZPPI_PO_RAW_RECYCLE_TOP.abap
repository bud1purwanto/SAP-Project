*&---------------------------------------------------------------------*
*&  Include           ZPPI_PO_RAW_RECYCLE_TOP
*&---------------------------------------------------------------------*

TABLES : MCHB, AUFK, ZTMAP_MATRECYCLE, VBAK, AFKO, MSEG, RESB.

* TYPE DECLARATIONS
TYPES : BEGIN OF TYDATA,
          MARK(1) TYPE C,
          MATNR       TYPE MCHB-MATNR, "MATERIAL KUPAS
          CHARG       TYPE MCHB-CHARG, "BACTH
          ZZTYPE      TYPE ATWTB,      "TYPE FILM
          CLABS       TYPE MCHB-CLABS, "QUANTITY
          CCLABS      TYPE MCHB-CLABS, "QUANTITY STOCK
          SLOCGI      TYPE MCHB-LGORT, "SLOC GI
          SLOCGR      TYPE MCHB-LGORT, "SLOC GR
          DESC        TYPE T001L-LGOBE, "SLOC GR DESC.
          AUFNR       TYPE AUFK-AUFNR, "PROCESS ORDER
          MTART       TYPE MARA-MTART, "MATERIAL TYPE
          RAR_A_MATNR TYPE ZTMAP_MATRECYCLE-RAR_A_MATNR, "RAW RECYCLE
          STATUS      TYPE BSVX-STTXT, "STATUS
          FLAG(1) TYPE C,
        END OF TYDATA,
       "TYPE FOR DISPLAY ORDER.
        BEGIN OF TYORDER,
          MARK(1) TYPE C,
          MATNR   LIKE RESB-MATNR,
          AUFNR   LIKE RESB-AUFNR,
          ZZTYPE  TYPE ATWTB,      "TYPE FILM
          CHARG   LIKE RESB-CHARG,
          WERKS   LIKE AUFK-WERKS,
          GLTRP   LIKE AFKO-GLTRP, "ORDER DATE
          BMENGE   LIKE AFKO-BMENGE, "ORDER QUANTITY
          LGORTGI LIKE RESB-LGORT, "SLOC GI
          LGORTGR LIKE RESB-LGORT, "SLOC GR
          RAWM    LIKE RESB-MATNR, "RAW MAT
          STAT    LIKE BSVX-STTXT,
          OBJNR   LIKE AUFK-OBJNR,
          BKTXT   LIKE MKPF-XBLNR,
          FLAG,
        END OF TYORDER,
        BEGIN OF TYMATDOC,
          MATDOC TYPE MBLNR,
          MJAHR  TYPE MJAHR,
          BWART  TYPE BWART,
        END OF TYMATDOC.

CONSTANTS : CMATNR    TYPE C LENGTH 11 VALUE 'RESBD-MATNR',
            CMENGE    TYPE C LENGTH 11 VALUE 'RESBD-MENGE',
            CPOSTP    TYPE C LENGTH 11 VALUE 'RESBD-POSTP',
            CLGORT    TYPE C LENGTH 11 VALUE 'RESBD-LGORT',
            CCHARG    TYPE C LENGTH 11 VALUE 'RESBD-CHARG',
            CVORNR    TYPE C LENGTH 11 VALUE 'RESBD-VORNR',
            CEINHEIT  TYPE C LENGTH 14 VALUE 'RESBD-EINHEIT'.

DATA : ITDATA      TYPE STANDARD TABLE OF TYDATA WITH HEADER LINE,
       WADATA      TYPE TYDATA,
       ITORDER     TYPE STANDARD TABLE OF TYORDER WITH HEADER LINE,
       TEMPORDER   TYPE STANDARD TABLE OF TYORDER WITH HEADER LINE,
       TEMPORDER2  TYPE STANDARD TABLE OF TYORDER WITH HEADER LINE,
       ITMATDOC    TYPE TABLE OF TYMATDOC WITH HEADER LINE,
       ITREFERENCE TYPE TABLE OF TYMATDOC WITH HEADER LINE,
       WA_ORDER    TYPE TYORDER,
       ITTEMP      TYPE STANDARD TABLE OF TYDATA WITH HEADER LINE,
       WATEMP      TYPE  TYDATA ,
       ITDATA2     TYPE STANDARD TABLE OF TYDATA WITH HEADER LINE,
       ITMATERIAL  TYPE STANDARD TABLE OF TYDATA WITH HEADER LINE,
       "Data for Range SLoc,
       RSLOC       TYPE RANGE OF MCHB-LGORT,
       WSLOC       LIKE LINE OF RSLOC,
       "DATA FOR BAPI_PROCORD_CREATE
       TORDER    LIKE BAPI_PI_ORDER_CREATE,
       ORDERO    LIKE BAPI_ORDER_KEY-ORDER_NUMBER,
       TORDERKEY TYPE TABLE OF BAPI_ORDER_KEY WITH HEADER LINE,
       GMHEADER  TYPE BAPI2017_GM_HEAD_01,
       GMITEM    TYPE TABLE OF BAPI2017_GM_ITEM_CREATE WITH HEADER LINE,
       THEADER   TYPE TABLE OF BAPI2017_GM_HEAD_RET    WITH HEADER LINE,
       ZCHAR     TYPE TABLE OF CLBATCH WITH HEADER LINE,
       MATDOC    TYPE BAPI2017_GM_HEAD_RET-MAT_DOC,
       IT_RET    TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
       "DATA FOR BDC
       IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE.

DATA : OK_CODE     TYPE SY-UCOMM,
       RAD1        TYPE CHAR1,
       RAD2        TYPE CHAR1,
       MSG         TYPE CHAR200,
       IS_ERROR(1) TYPE C,
       V_LINE      TYPE ATWTB,
       VMENGE      TYPE CHAR17,
       VPOSTP      TYPE CHAR17,
       VLGORT      TYPE CHAR17,
       VCHARG      TYPE CHAR17,
       VVORNR      TYPE CHAR17,
       VEINHEIT    TYPE CHAR17,
       COUNTER     TYPE I VALUE '1',
       VCLABS      TYPE C LENGTH 13,
       VBMENGE     TYPE MARD-LABST,
       VMATNR      TYPE CHAR17,
       OBJNR       TYPE AUFK-OBJNR,
       ATWRT       TYPE ATWRT,
       ATINN       TYPE ATINN,
       LS_SUBRC    TYPE SY-SUBRC,
       VLINE       TYPE I,
       MESSAGE(100) TYPE C,
       N(3),
       ANSWER,
       ZZNUMBER TYPE ZTMAP_SLOCRR-ZZNUMBER,
       "DATA FOR LOCKING OBJECT
       LOCKLIST    TYPE TABLE OF SEQG3,
       WLOCKLIST   TYPE SEQG3,
       LOCKOBJECT  TYPE EQEGRAARG,
       "DATA FOR STATUS ORDER
       CHC(1) TYPE C,
       CHP(1) TYPE C,
       CHR(1) TYPE C,
       CHT(1) TYPE C,
       L_ERRNO TYPE I,
       V_MBLNR TYPE MKPF-MBLNR,
       "LINES OF TABLECONTROL
       G_TCORDER_LINES  LIKE SY-LOOPC,
       G_TABCCTL_LINES  LIKE SY-LOOPC.


*&SPWIZARD: DECLARATION OF TABLECONTROL 'TCORDER' ITSELF
CONTROLS: TABCCTL TYPE TABLEVIEW USING SCREEN 0110,
          TCORDER TYPE TABLEVIEW USING SCREEN 0120.

* SELECTION SCREEN FOR SCREEN 110.
SELECTION-SCREEN BEGIN OF SCREEN 200 AS SUBSCREEN .
SELECT-OPTIONS : P_PLANT FOR MCHB-WERKS  NO INTERVALS NO-EXTENSION,
                 P_BATCH FOR MCHB-CHARG NO INTERVALS.
PARAMETERS     : P_DATE  TYPE SY-DATUM DEFAULT SY-DATUM,
                 P_NIK   TYPE XBLNR  OBLIGATORY.
SELECTION-SCREEN END OF SCREEN 200.

* SELECTION SCREEN FOR SCREEN 120.
SELECTION-SCREEN BEGIN OF SCREEN 121 AS SUBSCREEN.
SELECT-OPTIONS : P_MATNR FOR MSEG-MATNR NO INTERVALS NO-EXTENSION ,
                 P_AUFNR FOR AFKO-AUFNR NO INTERVALS NO-EXTENSION VISIBLE  LENGTH 18,
                 P_PERIOD FOR AFKO-GLTRP VISIBLE LENGTH 18.
SELECTION-SCREEN END OF SCREEN 121.

DATA : P_STATUS TYPE RANGE OF ZSTATUS WITH HEADER LINE,
       W_STATUS LIKE LINE OF P_STATUS,
       R_SLOC TYPE RANGE OF MCHB-LGORT,
       W_SLOC LIKE LINE OF R_SLOC.