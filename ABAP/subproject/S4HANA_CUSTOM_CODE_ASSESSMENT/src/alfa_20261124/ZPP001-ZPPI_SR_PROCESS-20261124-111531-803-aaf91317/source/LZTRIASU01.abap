FUNCTION Z_GET_PRODUCTION_DATE .
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(MATNR) TYPE  MCH1-MATNR
*"     REFERENCE(CHARG) TYPE  MCH1-CHARG
*"  EXPORTING
*"     REFERENCE(PDATE) TYPE  SY-DATUM
*"----------------------------------------------------------------------

  DATA: BEGIN OF ITAB OCCURS 0,
        MBLNR LIKE MSEG-MBLNR,
        SMBLN LIKE MSEG-SMBLN,
        BUDAT LIKE MSEG-BUDAT_MKPF,
  END OF ITAB.

  DATA: ITAB2 LIKE ITAB OCCURS 0  WITH HEADER LINE.

  SELECT MBLNR SMBLN BUDAT_MKPF INTO TABLE ITAB FROM MSEG
    WHERE BWART IN ('101', '102') AND MATNR = MATNR AND CHARG = CHARG.

  IF SY-SUBRC = 0.
    ITAB2[] = ITAB[].
    LOOP AT ITAB2 WHERE SMBLN NE ''.
      DELETE ITAB WHERE MBLNR = ITAB2-SMBLN.
    ENDLOOP.

    READ TABLE ITAB INDEX 1.
    PDATE = ITAB-BUDAT.
  ELSE.
    SELECT SINGLE ERSDA INTO PDATE FROM MCH1 WHERE MATNR = MATNR AND CHARG = CHARG.
  ENDIF.
ENDFUNCTION.