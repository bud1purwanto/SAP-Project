*&---------------------------------------------------------------------*
*&  Include           ZPPI_SALE_TOP
*&---------------------------------------------------------------------*

REPORT  ZPPI_SALE.

TABLES : MKPF, KNA1, LIKP.

DATA : ZMJAHR(4),
**       ZWADAT(10),
       ZNAME1(35),
       ZVKORG(4),
       ZVTWEG(2),
       ZSPART(2),
       ZWERKS(4),
       ZVSTEL(4),
       ZLGORT(4),
       ZNIK TYPE N LENGTH 8,
       ZPENGEMUDI(40),
       ZKENDARAAN(40),
       ZSKP(40),
       ZVTEXT1(20),
       ZVTEXT2(20),
       ZVTEXT3(20).

TYPES : BEGIN OF IT_MSEG,
          POSNR LIKE LIPS-POSNR,
          MBLNR LIKE MSEG-MBLNR,
          ZEILE LIKE MSEG-ZEILE,
          MATNR LIKE MSEG-MATNR,
          MENGE LIKE MSEG-MENGE,
          CMENGE(13),
          MEINS LIKE MSEG-MEINS,
          LGORT LIKE MSEG-LGORT,
          WERKS LIKE MSEG-WERKS,
        END OF IT_MSEG.

TYPES : BEGIN OF IT_BWART,
          BWART LIKE MSEG-BWART,
        END OF IT_BWART.

DATA : IT_MSEG TYPE IT_MSEG OCCURS 0 WITH HEADER LINE,
       WA_MSEG LIKE LINE OF IT_MSEG.
DATA : IT_MSEG_TEMP TYPE IT_MSEG OCCURS 0 WITH HEADER LINE.
DATA : IT_BWART TYPE IT_BWART OCCURS 0 WITH HEADER LINE.

"- Data for Upload
DATA : IT_DATES     TYPE BAPIDLVDEADLN OCCURS 0 WITH HEADER LINE,
       WA_DATES     LIKE LINE OF IT_DATES,
       IT_DLV_ITEMS TYPE BAPIDLVNOREFITEM OCCURS 0 WITH HEADER LINE,
       WA_DLV_ITEMS LIKE LINE OF IT_DLV_ITEMS,
       IT_RET       TYPE BAPIRET2 OCCURS 0 WITH HEADER LINE.

"- Data for Change
DATA : IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE.

"- Data for Create Text
DATA : IT_LINE TYPE TLINE OCCURS 0 WITH HEADER LINE,
       WA_LINE LIKE LINE OF IT_LINE.

"- Data for Log
DATA : IT_ERROR     TYPE ZTLOG_SALE OCCURS 0 WITH HEADER LINE,
       WA_ERROR     LIKE LINE OF IT_ERROR.

DATA : OPT LIKE CTU_PARAMS.

DATA : V_DD(2),
       V_MM(2),
       V_YY(4).

DATA  : V_DATE TYPE STRING.
DATA  : VDATE(10).
DATA  : V_KOSTK LIKE VBUK-KOSTK.
DATA  : V_DELIVERY LIKE LIKP-VBELN,
        V_NIK LIKE ZTLOG_SALE-ZNIK,
        CDELIVERY LIKE THEAD-TDNAME.

DATA  : NO TYPE I,
        P_DEC TYPE P LENGTH 11 DECIMALS 2.
DATA  : V_POSNR LIKE LIPS-POSNR.
DATA  : V_MENGE LIKE MSEG-MENGE.
DATA  : V_MBLNR LIKE MKPF-MBLNR.
DATA  : V_LGORT LIKE MSEG-LGORT.
DATA  : V_VBELN LIKE THEAD-TDNAME.
DATA  : V_INFO  LIKE THEAD-TDNAME.

DATA  : ZMATNR LIKE MSEG-MATNR.
DATA  : ZTEXT  TYPE STRING.