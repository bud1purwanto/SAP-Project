FUNCTION ZMM_CREATE_MAT_TO_MAT.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(MATNR_I) TYPE  MATNR
*"     REFERENCE(CHARG_I) TYPE  CHARG_D
*"     REFERENCE(WERKS_I) TYPE  WERKS_D
*"     REFERENCE(LGORT_I) TYPE  LGORT_D
*"     REFERENCE(MATNR_J) TYPE  MATNR
*"     REFERENCE(AUFNR) TYPE  AUFNR
*"     REFERENCE(SPJG) TYPE  P
*"     REFERENCE(SCRAP) TYPE  BOOLEAN OPTIONAL
*"     REFERENCE(QTY) TYPE  LABST OPTIONAL
*"     REFERENCE(TEXT) TYPE  SGTXT OPTIONAL
*"  EXPORTING
*"     REFERENCE(MBLNR) TYPE  MBLNR
*"     REFERENCE(MJAHR) TYPE  MJAHR
*"     REFERENCE(MATNR_O) TYPE  MATNR
*"     REFERENCE(CHARG_O) TYPE  CHARG_D
*"     REFERENCE(LENGTH_O) TYPE  I
*"     REFERENCE(QTY_O) TYPE  LABST
*"  TABLES
*"      MESSAGE STRUCTURE  BAPIRET2
*"----------------------------------------------------------------------

  "Data Create
  DATA: IT_BAPICHAT     LIKE STANDARD TABLE OF BAPIBATCHATT WITH HEADER LINE,
        IT_RETURN       LIKE STANDARD TABLE OF BAPIRET2 WITH HEADER LINE,
        V_MSG           TYPE C LENGTH 100.

  DATA: V_OUTPUT_BATCH  LIKE BAPIBATCHKEY-BATCH,
        V_OUTPUT_MATNR  LIKE BAPIBATCHKEY-MATERIAL,
        V_OUTPUT_PLANT  LIKE BAPIBATCHKEY-PLANT,
        V_OUTPUT_SLOC   LIKE BAPIBATCHSTOLOC-STGE_LOC.

  DATA: V_LENGTH_CONS   TYPE P,
        V_LENGTH_I      TYPE I,
        V_LENGTH_O      TYPE I.

  DATA: IT_LOG_GS       TYPE ZQM_LOG_GS,
        IT_LOG_CHANGE   TYPE ZLOG_CHANGE_SR.

  "Check Actual Weight and Characteristic
  DATA: V_WEIGHT_ACT    TYPE LABST,
        V_DIFF_QTY      TYPE LABST,
        V_DIFF_LENGTH   TYPE I.

  "Teco Order
  DATA: STAT            TYPE  CHAR11,
        IT_TECO_DERET   TYPE BAPI_ORDER_RETURN OCCURS 0 WITH HEADER LINE,
        IT_TECO_ORDERS  TYPE BAPI_ORDER_KEY OCCURS 0 WITH HEADER LINE.

  RANGES: R_CHAR FOR CABN-ATNAM.

  TABLES: *JEST, *TJ02T.

  CLEAR: MESSAGE.
  REFRESH: MESSAGE.

  IF MATNR_O IS INITIAL AND MATNR_J IS INITIAL.
    MESSAGE-TYPE = 'E'.
    MESSAGE-MESSAGE = 'Material Accent or Material JR must be filled!'.
    APPEND MESSAGE.
    EXIT.
  ENDIF.

  "Check input using material accent
  DATA: V_CHARG_VENDOR TYPE CHARG_D,
        V_MATNR_VENDOR TYPE MATNR,
        V_MATNR_MAPPING TYPE MATNR.

  SELECT SINGLE LICHA INTO V_CHARG_VENDOR FROM MCH1 WHERE CHARG EQ CHARG_I.
  IF V_CHARG_VENDOR IS NOT INITIAL.
    SELECT SINGLE MATNR INTO V_MATNR_VENDOR FROM MCH1 WHERE CHARG EQ V_CHARG_VENDOR.
    IF V_MATNR_VENDOR IS NOT INITIAL.
      SELECT SINGLE MATNR_ACC INTO V_MATNR_MAPPING FROM ZMAP_MAT_SBU WHERE MATNR_ACC EQ V_MATNR_VENDOR.
      IF V_MATNR_MAPPING IS INITIAL.
        CONCATENATE 'Material:' MATNR_I 'is material accent, please input base film!' INTO V_MSG SEPARATED BY SPACE.
        MESSAGE-TYPE = 'E'.
        MESSAGE-MESSAGE = V_MSG.
        APPEND MESSAGE.
        EXIT.
      ENDIF.
    ENDIF.
  ENDIF.

  DATA: V_AUART TYPE AUFART.

  SELECT SINGLE AUART INTO V_AUART FROM AUFK WHERE AUFNR EQ AUFNR.

  "Choose Material based on Accent or JR Output
  IF V_AUART EQ 'ZP09'.
    SELECT SINGLE MATNR_ACC INTO MATNR_O FROM ZMAP_MAT_SBU WHERE WERKS EQ WERKS_I AND MATNR_BF EQ MATNR_I AND MATNR_OUT EQ MATNR_J.
  ELSE.
    SELECT SINGLE MATNR_ACC INTO MATNR_O FROM ZMAP_MAT_SBU WHERE WERKS EQ WERKS_I AND MATNR_OUT EQ MATNR_J.
  ENDIF.

  IF MATNR_O IS INITIAL.
    V_MATNR_MAPPING = MATNR_I && '-' && MATNR_J.
    CONCATENATE 'Material Accent' V_MATNR_MAPPING 'Mapping not yet maintained in plant' WERKS_I INTO V_MSG SEPARATED BY SPACE.
    MESSAGE-TYPE = 'E'.
    MESSAGE-MESSAGE = V_MSG.
    APPEND MESSAGE.
    EXIT.
  ENDIF.

  DATA: V_MATNR_RR TYPE MATNR.

  IF SCRAP IS NOT INITIAL.
    SELECT SINGLE RAR_A_MATNR INTO V_MATNR_RR FROM ZTMAP_MATRECYCLE WHERE WERKS EQ WERKS_I AND MATNR EQ MATNR_I.
    IF V_MATNR_RR IS INITIAL.
      CONCATENATE 'Material RR Mapping for Material' MATNR_I 'not yet maintained!' INTO V_MSG SEPARATED BY SPACE.
      MESSAGE-TYPE = 'E'.
      MESSAGE-MESSAGE = V_MSG.
      APPEND MESSAGE.
      EXIT.
    ELSE.
      SELECT SINGLE MATNR INTO V_MATNR_RR FROM MARA WHERE MATNR EQ V_MATNR_RR.
      IF SY-SUBRC NE 0.
        CONCATENATE 'Material RR Master Data' MATNR_I 'not yet maintained!' INTO V_MSG SEPARATED BY SPACE.
        MESSAGE-TYPE = 'E'.
        MESSAGE-MESSAGE = V_MSG.
        APPEND MESSAGE.
        EXIT.
      ENDIF.
    ENDIF.
  ENDIF.

  CLEAR: V_MATNR_RR.
  SELECT SINGLE RAR_A_MATNR INTO V_MATNR_RR FROM ZTMAP_MATRECYCLE WHERE WERKS EQ WERKS_I AND MATNR EQ MATNR_J.
  IF V_MATNR_RR IS INITIAL.
    CONCATENATE 'Material RR Mapping for Material' MATNR_J 'not yet maintained!' INTO V_MSG SEPARATED BY SPACE.
    MESSAGE-TYPE = 'E'.
    MESSAGE-MESSAGE = V_MSG.
    APPEND MESSAGE.
    EXIT.
  ELSE.
    SELECT SINGLE MATNR INTO V_MATNR_RR FROM MARA WHERE MATNR EQ V_MATNR_RR.
    IF SY-SUBRC NE 0.
      CONCATENATE 'Material RR Master Data' MATNR_J 'not yet maintained!' INTO V_MSG SEPARATED BY SPACE.
      MESSAGE-TYPE = 'E'.
      MESSAGE-MESSAGE = V_MSG.
      APPEND MESSAGE.
      EXIT.
    ENDIF.
  ENDIF.

  "Check Order for SBU
  DATA: V_AUFNR_SBU TYPE AUFNR.
  SELECT SINGLE AUFK~AUFNR INTO V_AUFNR_SBU
    FROM AUFK JOIN AFPO ON AUFK~AUFNR EQ AFPO~AUFNR
   WHERE ZSBUORDER EQ AUFNR
     AND MATNR EQ MATNR_O
     AND WERKS EQ WERKS_I
     AND AUART EQ 'ZMMS'.
  IF V_AUFNR_SBU IS INITIAL.
    CONCATENATE 'Order Mat to Mat SBU-Asset for Material' MATNR_O 'not yet created!' INTO V_MSG SEPARATED BY SPACE.
    MESSAGE-TYPE = 'E'.
    MESSAGE-MESSAGE = V_MSG.
    APPEND MESSAGE.
    EXIT.
  ENDIF.

  "Check Std Margin + Cost
  CALL FUNCTION 'ZCO_PRICE_CHANGE'
    EXPORTING
      MATNR_BF  = MATNR_I
      MATNR_ACC = MATNR_O
      WERKS     = WERKS_I
      VALIDATE  = 'X'
    TABLES
      MESSAGE   = IT_RETURN.

  READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
  IF SY-SUBRC = 0.
    MESSAGE-TYPE        = IT_RETURN-TYPE.
    MESSAGE-ID          = IT_RETURN-ID.
    MESSAGE-NUMBER      = IT_RETURN-NUMBER.
    MESSAGE-MESSAGE     = IT_RETURN-MESSAGE.
    MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
    MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
    MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
    MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
    APPEND MESSAGE.
    EXIT.
  ENDIF.

  CLEAR: IT_RETURN.
  REFRESH: IT_RETURN.

  "Check Weight Stock Unrest
  SELECT SINGLE CLABS INTO V_WEIGHT_ACT
    FROM MCHB
   WHERE MATNR EQ MATNR_I
     AND WERKS EQ WERKS_I
     AND LGORT EQ LGORT_I
     AND CHARG EQ CHARG_I.

  "Check Material Accent Same Vendor but Different Material
  DATA: V_MATNR_ACC LIKE MARA-MATNR.
  SELECT SINGLE MATNR CHARG INTO (V_MATNR_ACC, CHARG_O) FROM MCH1 WHERE LICHA EQ CHARG_I AND MATNR EQ MATNR_O .

  "Material Accent not yet Created
  IF CHARG_O IS INITIAL OR V_MATNR_ACC NE MATNR_O.

    V_OUTPUT_MATNR = MATNR_O.
    V_OUTPUT_PLANT = WERKS_I.
    V_OUTPUT_SLOC  = LGORT_I.
    IT_BAPICHAT-VENDRBATCH = CHARG_I.

    CALL FUNCTION 'BAPI_BATCH_CREATE'
      EXPORTING
        MATERIAL             = V_OUTPUT_MATNR
        PLANT                = V_OUTPUT_PLANT
        BATCHSTORAGELOCATION = V_OUTPUT_SLOC
        BATCHATTRIBUTES      = IT_BAPICHAT
      IMPORTING
        BATCH                = V_OUTPUT_BATCH
      TABLES
        RETURN               = IT_RETURN.

    READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
    IF SY-SUBRC = 0.
      CONCATENATE 'Create Batch:' IT_RETURN-MESSAGE INTO V_MSG SEPARATED BY SPACE.
      MESSAGE-TYPE        = IT_RETURN-TYPE.
      MESSAGE-ID          = IT_RETURN-ID.
      MESSAGE-NUMBER      = IT_RETURN-NUMBER.
      MESSAGE-MESSAGE     = V_MSG.
      MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
      MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
      MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
      MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
      APPEND MESSAGE.
      EXIT.
    ELSE.
      CHARG_O = V_OUTPUT_BATCH.

      "Copy Inspection of SR accent
      SELECT SINGLE *
        INTO IT_LOG_GS
        FROM ZQM_LOG_GS
       WHERE ZQM_LOG_GS~CHARGAS EQ CHARG_I
         AND ZQM_LOG_GS~ROLLJR  NE ''.

      IF SY-SUBRC EQ 0.
        IT_LOG_GS-MATNR         = MATNR_O.
        IT_LOG_GS-ERDAT         = SY-DATUM.
        IT_LOG_GS-ERZET         = SY-UZEIT.
        IT_LOG_GS-USNAM         = SY-UNAME.
        IT_LOG_GS-CHARGAS       = CHARG_O.
        IT_LOG_GS-NOSEQ         = ''.
        IT_LOG_GS-NOREF         = '' .
        IT_LOG_GS-PREF          = ''.
        INSERT ZQM_LOG_GS FROM IT_LOG_GS.
        COMMIT WORK AND WAIT.
      ENDIF..

      REFRESH: IT_RETURN.
      CLEAR: IT_RETURN.
    ENDIF.

    WAIT UP TO '0.5' SECONDS.
  ENDIF.

  PERFORM VBGETDET USING MATNR_I CHARG_I WERKS_I 'ZZLENGTH' CHANGING V_LENGTH_I.
  PERFORM VBGETDET USING MATNR_O CHARG_O WERKS_I 'ZZLENGTH' CHANGING V_LENGTH_O.

  "Change Characteristic
  IF V_LENGTH_I NE V_LENGTH_O.

    CALL FUNCTION 'DB_COMMIT'.
    CALL FUNCTION 'DEQUEUE_ALL'
      EXPORTING
        _SYNCHRON = 'X'.
    COMMIT WORK AND WAIT.

    "Data Get Old Char
    DATA : IT_CLBATCH LIKE STANDARD TABLE OF CLBATCH WITH HEADER LINE,
           IT_CHAR    LIKE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_CHAR WITH HEADER LINE,
           V_CLINT    TYPE CLINT,
           V_TYPE     TYPE KLASSENART.

    CALL FUNCTION 'VB_INIT'
      EXPORTING
        INIT_RESET = 'X'.

    SELECT SINGLE CLINT KLART INTO (V_CLINT, V_TYPE)
      FROM MCH1
      JOIN KSSK ON KSSK~OBJEK EQ MCH1~CUOBJ_BM
     WHERE MATNR EQ MATNR_I
       AND CHARG EQ CHARG_I.

    "Characteristic non dependency
    SELECT ATNAM AS LOW INTO CORRESPONDING FIELDS OF R_CHAR
      FROM KSML
      JOIN CABN ON KSML~IMERK EQ CABN~ATINN
     WHERE KSML~CLINT EQ V_CLINT
       AND KSML~KLART EQ V_TYPE
       AND CABN~ATINP EQ ''.
      APPEND R_CHAR.
    ENDSELECT.

    R_CHAR-SIGN = 'I'.
    R_CHAR-OPTION = 'EQ'.
    MODIFY R_CHAR TRANSPORTING OPTION SIGN WHERE SIGN = ''.

    "Delete Characteristic can input but dependecies
    DELETE R_CHAR WHERE LOW EQ 'ZZCONVERSIONMTRKG'.
    DELETE R_CHAR WHERE LOW EQ 'ZZCONVERSIONROLLKG'.
    DELETE R_CHAR WHERE LOW EQ 'ZZWEIGTHTOTAL'.
    DELETE R_CHAR WHERE LOW EQ 'ZZTOTALM2'.
    DELETE R_CHAR WHERE LOW EQ 'ZZCONVERSIONKGM2'.
    DELETE R_CHAR WHERE LOW EQ 'ZZCONVERSIONROLLM2'.
    DELETE R_CHAR WHERE LOW EQ 'ZZCONVERSIONPACKG'.
    DELETE R_CHAR WHERE LOW EQ 'ZZNUMOFPACK'.

    CLEAR : IT_CLBATCH. REFRESH : IT_CLBATCH.

    CALL FUNCTION 'VB_INIT'
      EXPORTING
        INIT_RESET = 'X'.

    CALL FUNCTION 'VB_BATCH_GET_DETAIL'
      EXPORTING
        MATNR              = MATNR_I
        CHARG              = CHARG_I
        WERKS              = WERKS_I
        GET_CLASSIFICATION = 'X'
      TABLES
        CHAR_OF_BATCH      = IT_CLBATCH.

    LOOP AT IT_CLBATCH WHERE ATNAM IN R_CHAR.
      MOVE IT_CLBATCH-ATNAM TO IT_CHAR-CHARACT.
      CONDENSE IT_CHAR-CHARACT.
      MOVE IT_CLBATCH-ATWTB TO IT_CHAR-VALUE_CHAR.
      CONDENSE IT_CHAR-VALUE_CHAR.
      APPEND IT_CHAR.
    ENDLOOP.

    "Data Change Char
    DATA : IT_NUM   LIKE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_NUM WITH HEADER LINE,
           IT_CURR  LIKE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_CURR WITH HEADER LINE.

    DATA : V_CLASS  LIKE KLAH-CLASS,
           V_KLART  LIKE KLAH-KLART,
           V_OBTAB  LIKE TCLT-OBTAB,
           V_OBJKY  LIKE BAPI1003_KEY-OBJECT,
           V_STAT   LIKE BAPI1003_KEY-STATUS.

    CALL FUNCTION 'QMSP_MATERIAL_BATCH_CLASS_READ'
      EXPORTING
        I_MATNR      = MATNR_O
        I_CHARG      = CHARG_O
        I_WERKS      = WERKS_I
        I_MARA_LEVEL = 'X'
      IMPORTING
        E_CLASS      = V_CLASS
        E_KLART      = V_KLART
        E_OBTAB      = V_OBTAB
        E_OBJEC      = V_OBJKY.

    CALL FUNCTION 'DB_COMMIT'.
    CALL FUNCTION 'DEQUEUE_ALL'
      EXPORTING
        _SYNCHRON = 'X'.
    COMMIT WORK AND WAIT.

    CALL FUNCTION 'ENQUEUE_EMMCH1E'
      EXPORTING
        MODE_MCH1      = 'E'
        MANDT          = SY-MANDT
        MATNR          = MATNR_O
        CHARG          = CHARG_O
      EXCEPTIONS
        FOREIGN_LOCK   = 1
        SYSTEM_FAILURE = 2
        OTHERS         = 3.
    IF SY-SUBRC = 1.
      V_MSG = 'Batch Locked: ' && CHARG_O.
      MESSAGE-TYPE = 'E'.
      MESSAGE-MESSAGE = V_MSG && IT_RETURN-MESSAGE.
      APPEND MESSAGE.
      EXIT.
    ENDIF.

    CALL FUNCTION 'BAPI_OBJCL_CHANGE'
      EXPORTING
        OBJECTKEY          = V_OBJKY
        OBJECTTABLE        = V_OBTAB
        CLASSNUM           = V_CLASS
        CLASSTYPE          = V_KLART
      IMPORTING
        CLASSIF_STATUS     = V_STAT
      TABLES
        ALLOCVALUESNUMNEW  = IT_NUM
        ALLOCVALUESCHARNEW = IT_CHAR
        ALLOCVALUESCURRNEW = IT_CURR
        RETURN             = IT_RETURN.

    CALL FUNCTION 'DB_COMMIT'.
    CALL FUNCTION 'DEQUEUE_ALL'
      EXPORTING
        _SYNCHRON = 'X'.
    COMMIT WORK AND WAIT.

    READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
    IF SY-SUBRC = 0.
      CONCATENATE 'Change Batch:' CHARG_O IT_RETURN-MESSAGE INTO V_MSG SEPARATED BY SPACE.
      MESSAGE-TYPE        = IT_RETURN-TYPE.
      MESSAGE-ID          = IT_RETURN-ID.
      MESSAGE-NUMBER      = IT_RETURN-NUMBER.
      MESSAGE-MESSAGE     = V_MSG.
      MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
      MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
      MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
      MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
      APPEND MESSAGE.
      EXIT.
    ENDIF.
  ENDIF.

  REFRESH: IT_RETURN.
  CLEAR: IT_RETURN.

  "Transfer Posting
  DATA: IT_HEADER     TYPE BAPI2017_GM_HEAD_01,
        IT_CODE       TYPE BAPI2017_GM_CODE,
        IT_MATDOC     TYPE BAPI2017_GM_HEAD_RET,
        IT_ITEM       TYPE BAPI2017_GM_ITEM_CREATE OCCURS 0 WITH HEADER LINE.

  "Get Weight
  DATA: V_ZZGRAMMAGE  LIKE CABN-ATINN,
        V_ZZCODE      LIKE CABN-ATINN,
        V_LENGTH      TYPE I,
        V_WIDTH       TYPE I,
        V_VTINT       LIKE CUVTAB_VALC-VTINT,
        V_SLNID       LIKE CUVTAB_VALC-SLNID,
        V_VALUE       LIKE CUVTAB_VALN-VAL_FROM,
        V_WEIGHT_AWAL TYPE P DECIMALS 2,
        V_WEIGHT_SISA TYPE P DECIMALS 2,
        V_WEIGHT      TYPE P DECIMALS 2.

  "Transaction Code
  IT_CODE-GM_CODE       = '06'. "Posting GI/GR
  "Header
  IT_HEADER-PSTNG_DATE  = SY-DATUM.
  IT_HEADER-DOC_DATE    = SY-DATUM.
  IT_HEADER-PR_UNAME    = SY-UNAME.
  IT_HEADER-HEADER_TXT  = CHARG_I.

  "For Slitting
  IF TEXT IS NOT INITIAL.
    IT_HEADER-HEADER_TXT  = TEXT.
  ENDIF.

  "Get Weight from Qty
  IF QTY IS NOT INITIAL.
    IT_ITEM-ENTRY_QNT = QTY.
  ELSE.
    "Get Weight from Length
    PERFORM VBGETDET USING MATNR_I CHARG_I WERKS_I 'ZZLENGTH' CHANGING V_LENGTH.
    PERFORM VBGETDET USING MATNR_I CHARG_I WERKS_I 'ZZWIDTH' CHANGING V_WIDTH.

    SELECT SINGLE ATINN INTO V_ZZGRAMMAGE FROM CABN WHERE ATNAM = 'ZZGRAMMAGE'.
    SELECT SINGLE ATINN INTO V_ZZCODE FROM CABN WHERE ATNAM = 'ZZCODE'.

    SELECT SINGLE VTINT SLNID INTO (V_VTINT, V_SLNID) FROM CUVTAB_VALC WHERE ATINN EQ V_ZZCODE AND VALC EQ MATNR_I+2(3).
    SELECT SINGLE VAL_FROM INTO V_VALUE FROM CUVTAB_VALN
     WHERE VTINT EQ V_VTINT
       AND SLNID EQ V_SLNID
       AND ATINN EQ V_ZZGRAMMAGE.

    PERFORM GET_WEIGHT USING V_LENGTH V_WIDTH V_VALUE CHANGING V_WEIGHT_AWAL.
    PERFORM GET_WEIGHT USING SPJG V_WIDTH V_VALUE CHANGING V_WEIGHT_SISA.

    V_WEIGHT          = V_WEIGHT_AWAL - V_WEIGHT_SISA.
    QTY_O             = V_WEIGHT.

    "Scrap Calculation
    IF SCRAP IS NOT INITIAL.
      CLEAR: V_DIFF_QTY, V_DIFF_LENGTH.

      V_DIFF_LENGTH = V_LENGTH.
      V_DIFF_QTY    = V_WEIGHT_ACT - V_WEIGHT_AWAL.

      "Tolerance different between actual weight and characteristic
      IF V_DIFF_QTY LT 0 AND V_DIFF_QTY GE '-0.1'.
        WHILE V_DIFF_QTY LE 0.
          V_DIFF_LENGTH     = V_DIFF_LENGTH - 1.
          PERFORM GET_WEIGHT USING V_DIFF_LENGTH V_WIDTH V_VALUE CHANGING V_WEIGHT_AWAL.
          V_DIFF_QTY        = V_WEIGHT_ACT - V_WEIGHT_AWAL.
        ENDWHILE .
        V_WEIGHT          = V_WEIGHT_AWAL - V_WEIGHT_SISA.
        QTY_O             = V_WEIGHT.
      ENDIF.

      IT_ITEM-ENTRY_QNT = V_WEIGHT_AWAL.
    ELSE.
      IT_ITEM-ENTRY_QNT = V_WEIGHT.
    ENDIF.
  ENDIF.

  IT_ITEM-QUANTITY = IT_ITEM-ENTRY_QNT.
  SELECT SINGLE MEINS MEINS INTO (IT_ITEM-ENTRY_UOM, IT_ITEM-BASE_UOM)
    FROM MARA
   WHERE MATNR EQ MATNR_I.

  "Item
  IT_ITEM-MATERIAL      = MATNR_I.
  IT_ITEM-PLANT         = WERKS_I.
  IT_ITEM-BATCH         = CHARG_I.
  IT_ITEM-STGE_LOC      = LGORT_I.
  IT_ITEM-MOVE_TYPE     = '261'.
  IT_ITEM-ORDERID       = V_AUFNR_SBU.
  APPEND IT_ITEM.

  "Item
  IT_ITEM-MATERIAL      = MATNR_O.
  IT_ITEM-PLANT         = WERKS_I.
  IT_ITEM-BATCH         = CHARG_O.
  IT_ITEM-STGE_LOC      = LGORT_I.
  IT_ITEM-MOVE_TYPE     = '531'.
  IT_ITEM-ORDERID       = V_AUFNR_SBU.
  APPEND IT_ITEM.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
    EXPORTING
      GOODSMVT_HEADER  = IT_HEADER
      GOODSMVT_CODE    = IT_CODE
    IMPORTING
      GOODSMVT_HEADRET = IT_MATDOC
    TABLES
      GOODSMVT_ITEM    = IT_ITEM
      RETURN           = IT_RETURN.

  READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
  IF SY-SUBRC = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

    CONCATENATE 'Transfer Posting:' IT_RETURN-MESSAGE INTO V_MSG SEPARATED BY SPACE.
    MESSAGE-TYPE        = IT_RETURN-TYPE.
    MESSAGE-ID          = IT_RETURN-ID.
    MESSAGE-NUMBER      = IT_RETURN-NUMBER.
    MESSAGE-MESSAGE     = V_MSG.
    MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
    MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
    MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
    MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
    APPEND MESSAGE.
    EXIT.
  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        WAIT = 'X'.

    MBLNR = IT_MATDOC-MAT_DOC.
    MJAHR = IT_MATDOC-DOC_YEAR.

    CLEAR LENGTH_O.

    "Set Text in Batch Accent for History
    PERFORM VBGETDET USING MATNR_I CHARG_I WERKS_I 'ZZLENGTH' CHANGING V_LENGTH.
    V_LENGTH_CONS = V_LENGTH - SPJG.

    CALL FUNCTION 'ZMM_TEXT_MAT_TO_MAT'
      EXPORTING
        MATNR    = MATNR_O
        CHARG    = CHARG_O
        WERKS    = WERKS_I
        LENGTH_I = V_LENGTH_CONS
      IMPORTING
        LENGTH_O = V_LENGTH_CONS.

    LENGTH_O = V_LENGTH_CONS.

*    CLEAR: STAT, IT_RETURN, IT_TECO_ORDERS, IT_TECO_DERET.
*    REFRESH: IT_RETURN, IT_TECO_ORDERS, IT_TECO_DERET.
*
*    "If order not yet TECO
*    PERFORM GET_ORDER_STATUS USING V_AUFNR_SBU CHANGING STAT.
*    IF STAT NE 'TECO'.
*      "TECO Order
*      IT_TECO_ORDERS-ORDER_NUMBER = V_AUFNR_SBU.
*      APPEND IT_TECO_ORDERS.
*
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
*        EXPORTING
*          INPUT  = IT_TECO_ORDERS
*        IMPORTING
*          OUTPUT = IT_TECO_ORDERS.
*
*      CALL FUNCTION 'BAPI_PROCORD_COMPLETE_TECH'
*        EXPORTING
*          SCOPE_COMPL_TECH   = '1'
*          WORK_PROCESS_GROUP = 'COWORK_BAPI'
*          WORK_PROCESS_MAX   = 99
*        IMPORTING
*          RETURN             = IT_RETURN
*        TABLES
*          ORDERS             = IT_TECO_ORDERS
*          DETAIL_RETURN      = IT_TECO_DERET.
*
*      READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
*      IF SY-SUBRC = 0.
*        CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
*
*        CONCATENATE 'TECO M2M:' IT_RETURN-MESSAGE INTO V_MSG SEPARATED BY SPACE.
*        MESSAGE-TYPE        = IT_RETURN-TYPE.
*        MESSAGE-ID          = IT_RETURN-ID.
*        MESSAGE-NUMBER      = IT_RETURN-NUMBER.
*        MESSAGE-MESSAGE     = V_MSG.
*        MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
*        MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
*        MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
*        MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
*        APPEND MESSAGE.
*        EXIT.
*      ELSE.
*        CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
*          EXPORTING
*            WAIT = 'X'.
*      ENDIF.
*    ENDIF.
  ENDIF.
ENDFUNCTION.


*&---------------------------------------------------------------------*
*&      Form  GET_WEIGHT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->LENGTH     text
*      -->WIDTH      text
*      -->GRAMMAGE   text
*      -->WEIGHT     text
*----------------------------------------------------------------------*
FORM GET_WEIGHT USING LENGTH WIDTH GRAMMAGE CHANGING WEIGHT.
  DATA: GLOBALS         TYPE CUOV_00,
        MATCH           TYPE CUOV_01 OCCURS 0 WITH HEADER LINE,
        QUERY           TYPE CUOV_01 OCCURS 0 WITH HEADER LINE,
        ZZPEMBILANGBARU TYPE ATFLV,
        ZZPENYEBUTBARU  TYPE ATFLV.

  GLOBALS-DATE = SY-DATUM.

  QUERY-VARNAM  = 'ZZPEMBILANGASAL'.
  QUERY-ATFOR   = 'NUM'.
  QUERY-ATFLV   = LENGTH * WIDTH * GRAMMAGE.
  APPEND QUERY.

  QUERY-VARNAM  = 'ZZPENYEBUTASAL'.
  QUERY-ATFOR   = 'NUM'.
  QUERY-ATFLV   = 1000000.
  APPEND QUERY.

  CALL FUNCTION 'ZMM_CHARACTERISTIC_MKG'
    EXPORTING
      GLOBALS        = GLOBALS
    TABLES
      MATCH          = MATCH
      QUERY          = QUERY
    EXCEPTIONS
      FAIL           = 1
      INTERNAL_ERROR = 2
      OTHERS         = 3.

  IF SY-SUBRC EQ 0.
    READ TABLE MATCH WITH KEY VARNAM = 'ZZPEMBILANGBARU'.
    IF SY-SUBRC EQ 0.
      ZZPEMBILANGBARU = MATCH-ATFLV.
    ENDIF.

    READ TABLE MATCH WITH KEY VARNAM = 'ZZPENYEBUTBARU'.
    IF SY-SUBRC EQ 0.
      ZZPENYEBUTBARU = MATCH-ATFLV.
    ENDIF.
  ENDIF.

  WEIGHT = ZZPEMBILANGBARU / ZZPENYEBUTBARU.
ENDFORM.                    "GET_WEGHT

*&---------------------------------------------------------------------*
*&      Form  GET_ORDER_STATUS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ORDER      text
*      -->STAT       text
*----------------------------------------------------------------------*
FORM GET_ORDER_STATUS USING ORDER CHANGING STAT.
  DATA: OBJEK(22),
        ITAB  LIKE JSTAT OCCURS 2 WITH HEADER LINE.

  CONCATENATE 'OR' ORDER INTO OBJEK.
  CALL FUNCTION 'STATUS_READ'
    EXPORTING
      OBJNR       = OBJEK
      ONLY_ACTIVE = 'X'
    TABLES
      STATUS      = ITAB.

  SELECT SINGLE * FROM TJ02T INTO *TJ02T WHERE TXT04 = 'TECO' AND SPRAS = 'EN'.
  IF SY-SUBRC = 0.
    SELECT SINGLE * FROM JEST INTO *JEST WHERE OBJNR = OBJEK
                                           AND STAT  = *TJ02T-ISTAT
                                           AND INACT = ' '.
    IF SY-SUBRC = 0.
      STAT = *TJ02T-TXT04.
      EXIT.
    ENDIF.
  ENDIF.
ENDFORM.                    "GET_ORDER_STATUS

*&---------------------------------------------------------------------*
*&      Form  VBGETDET
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMATNR     text
*      -->ZCHARG     text
*      -->ZWERKS     text
*      -->ZATNAM     text
*      -->ZATWTB     text
*----------------------------------------------------------------------*
FORM VBGETDET USING ZMATNR ZCHARG ZWERKS ZATNAM CHANGING ZATWTB.
  DATA: ZCLBATCH LIKE STANDARD TABLE OF CLBATCH WITH HEADER LINE,
        ZTEMP LIKE AUSP-ATWRT.
  CLEAR : ZCLBATCH. REFRESH : ZCLBATCH.
  CALL FUNCTION 'VB_INIT'
    EXPORTING
      INIT_RESET = 'X'.

  CALL FUNCTION 'VB_BATCH_GET_DETAIL'
    EXPORTING
      MATNR              = ZMATNR
      CHARG              = ZCHARG
      WERKS              = ZWERKS
      GET_CLASSIFICATION = 'X'
    TABLES
      CHAR_OF_BATCH      = ZCLBATCH.
  READ TABLE ZCLBATCH WITH KEY ATNAM = ZATNAM.
  IF SY-SUBRC = 0.
    MOVE ZCLBATCH-ATWTB TO ZTEMP.
  ELSE.
    ZTEMP = ''.
  ENDIF.
  REPLACE ALL OCCURRENCES OF ',' IN ZTEMP WITH ''.
  CONDENSE ZTEMP NO-GAPS.
  ZATWTB = ZTEMP.
  EXIT.
ENDFORM.                    "VBGETDET