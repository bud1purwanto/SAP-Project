*&      Form  BDC_QA11
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZLOT       text
*      -->ZMENGE     text
*      -->ZNIK       text
*----------------------------------------------------------------------*
FORM BDC_QA11 USING ZLOT ZMENGE ZNIK.
  DATA : DLOT TYPE C LENGTH 12,
         DMENGE TYPE C LENGTH 17.

  MOVE ZLOT TO DLOT.
  MOVE ZMENGE TO DMENGE.
  REPLACE ALL OCCURRENCES OF ',' IN DMENGE WITH ''.
  CLEAR : IT_BDCDATA. REFRESH : IT_BDCDATA.
  PERFORM BDC_DYNPRO      USING 'SAPMQEVA' '0100'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'QALS-PRUEFLOS'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '/00'.
  PERFORM BDC_FIELD       USING 'QALS-PRUEFLOS'
                                DLOT.

  PERFORM BDC_DYNPRO      USING 'SAPMQEVA' '0200'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=BB'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'RQEVA-VCODE'.
  PERFORM BDC_FIELD       USING 'RQEVA-VCODE'
                                'X'.

  PERFORM BDC_DYNPRO      USING 'SAPLSPO1' '0100'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=YES'.

  PERFORM BDC_DYNPRO      USING 'SAPMQEVA' '0200'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=BU'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'RQEVA-VMENGE01'.
  PERFORM BDC_FIELD       USING 'RQEVA-VMENGE01'
                                DMENGE.

  PERFORM BDC_DYNPRO      USING 'SAPLSPO1' '0500'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=OPT1'.

  PERFORM BDC_DYNPRO      USING 'SAPLSPO4' '0300'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'SVALD-VALUE(01)'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=FURT'.
  IF VTRANS IS NOT INITIAL.
    PERFORM BDC_FIELD       USING 'SVALD-VALUE(01)'
                                '9999999'.
  ELSE.
    PERFORM BDC_FIELD       USING 'SVALD-VALUE(01)'
                                '19'.
  ENDIF.

  PERFORM BDC_TRANSACTION USING 'QA11'.
ENDFORM.                    "BDC_QA11

*&---------------------------------------------------------------------*
*&      Form  BDC_MB02
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMBLNR     text
*      -->ZMJAHR     text
*      -->ZJMROL     text
*----------------------------------------------------------------------*
FORM BDC_MB02 USING ZMBLNR ZMJAHR ZJMROL.
  DATA : ZVGART LIKE MKPF-VGART.

  SELECT SINGLE VGART INTO ZVGART
    FROM MKPF
  WHERE MBLNR = ZMBLNR AND
        MJAHR = ZMJAHR.

  CLEAR : IT_BDCDATA. REFRESH : IT_BDCDATA.

  PERFORM BDC_DYNPRO      USING 'SAPMM07M' '0460'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=KK'.
  PERFORM BDC_FIELD       USING 'RM07M-MBLNR'
                                ZMBLNR.
  PERFORM BDC_FIELD       USING 'RM07M-MJAHR'
                                ZMJAHR.
  PERFORM BDC_FIELD       USING 'XFULL'
                                'X'.

  IF ZVGART EQ 'WR' OR ZVGART EQ 'WF'.
    PERFORM BDC_DYNPRO      USING 'SAPMM07M' '0290'.
  ELSE.
    PERFORM BDC_DYNPRO      USING 'SAPMM07M' '0490'.
  ENDIF.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=BU'.
  PERFORM BDC_FIELD       USING 'MKPF-BKTXT'
                                ZJMROL.
  PERFORM BDC_TRANSACTION USING 'MB02'.

  CLEAR DMESSAGE.
  CONCATENATE 'Change Material Document' ZMBLNR 'berhasil' INTO DMESSAGE SEPARATED BY SPACE.
  PERFORM CHK_ER USING DMESSAGE 'ZBRETURN' CHANGING DSTATUS.
ENDFORM.                    "BDC_MB02

*&---------------------------------------------------------------------*
*&      Form  BAPI_MB02
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMBLNR     text
*      -->ZMJAHR     text
*      -->ZJMROL     text
*      -->WLENGTH    text
*----------------------------------------------------------------------*
FORM BAPI_MB02 USING ZMBLNR ZMJAHR ZJMROL WLENGTH.
  REFRESH : ZMKPF, ZMSEG.

  DATA : VLENGTH TYPE C LENGTH 18,
         VMENGE TYPE C LENGTH 18,
         DSPJG TYPE C LENGTH 40.

  SELECT *
    INTO CORRESPONDING FIELDS OF TABLE ZMKPF
  FROM MKPF
    WHERE MBLNR = ZMBLNR AND
          MJAHR = ZMJAHR.

  LOOP AT ZMKPF.
    ZMKPF-BKTXT = ZJMROL.
    MODIFY ZMKPF.
  ENDLOOP.

  CALL FUNCTION 'MB_READ_MATERIAL_POSITION'
    EXPORTING
      MBLNR  = ZMBLNR
      MJAHR  = ZMJAHR
      TRTYP  = 'A'
    TABLES
      SEQTAB = ZMSEG.

  IF WLENGTH IS NOT INITIAL.
*    CLEAR : VMENGE.
*    SELECT SINGLE MENGE INTO VMENGE
*      FROM MSEG
*    WHERE MBLNR = ZMBLNR AND
*          MJAHR = ZMJAHR AND
*          BWART = '101'.

*    IF VMENGE IS NOT INITIAL.
    LOOP AT ZMSEG WHERE BWART = '101'.
      MOVE FTXTPJ TO VLENGTH.
      CONDENSE VLENGTH.
      MOVE ZMSEG-MENGE TO VMENGE.
      CONDENSE VMENGE.
      CONCATENATE VLENGTH '-' VMENGE INTO ZMSEG-SGTXT SEPARATED BY SPACE.
      MODIFY ZMSEG.
    ENDLOOP.
*    ELSE.
    "Mat to Mat Add Cancel for Trial
    LOOP AT ZMSEG WHERE BWART = '261' OR BWART = '901'.
      READ TABLE RE_INPT WITH KEY CHARG = ZMSEG-CHARG.
      IF SY-SUBRC = 0.
        IF ZMSEG-SGTXT IS INITIAL.
          IF RE_INPT-SLENGTH NE 0.
            MOVE RE_INPT-SLENGTH TO ZMSEG-SGTXT.
            MODIFY ZMSEG.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.
*    ENDIF.
  ENDIF.

  CALL FUNCTION 'MB_CHANGE_DOCUMENT'
    TABLES
      ZMKPF = ZMKPF
      ZMSEG = ZMSEG.

  PERFORM BAPI_COMMIT.

  CLEAR DMESSAGE.
  CONCATENATE 'Change Material Document' ZMBLNR 'berhasil' INTO DMESSAGE SEPARATED BY SPACE.
  PERFORM CHK_ER USING DMESSAGE '' CHANGING DSTATUS.
ENDFORM.                    "BAPI_MB02
*&---------------------------------------------------------------------*
*&      Form  CONVERSION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMATNR     text
*      -->ZBATCH     text
*      -->ZWERKS     text
*      -->ZCONV      text
*      -->ZATWTB     text
*----------------------------------------------------------------------*
FORM CONVERSION USING ZMATNR ZBATCH ZWERKS ZCONV CHANGING ZATWTB.
  DATA : DATWTB LIKE CLBATCH-ATWTB.

  PERFORM VBGETDET USING ZMATNR ZBATCH ZWERKS ZCONV CHANGING DATWTB.
  IF ZCONV = 'ZZCONVERSIONPACKG'.
    REPLACE ALL OCCURRENCES OF 'Kg/PAC' IN DATWTB WITH ''.
  ELSEIF ZCONV = 'ZZCONVERSIONROLLKG'.
    REPLACE ALL OCCURRENCES OF 'Kg/Rol' IN DATWTB WITH ''.
  ENDIF.

  SHIFT DATWTB RIGHT DELETING TRAILING SPACE.
  SHIFT DATWTB LEFT DELETING LEADING SPACE.
  REPLACE ALL OCCURRENCES OF ',' IN DATWTB WITH ''.
  MOVE DATWTB TO ZATWTB.
ENDFORM.                    "CONVERSION

*&---------------------------------------------------------------------*
*&      Form  AUTH
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZWERKS     text
*      -->ZARBPL     text
*      -->ZPERNR     text
*      -->ZCOND      text
*      -->ZSTATUS    text
*----------------------------------------------------------------------*
FORM AUTH USING ZWERKS ZARBPL ZPERNR ZCOND CHANGING ZSTATUS.
  DATA : DOBJID LIKE HRP1001-OBJID,
         DPERNR LIKE HRP1001-OBJID.

  SELECT SINGLE HRP1001~OBJID INTO DOBJID
    FROM HRP1001
  JOIN CRHD ON CRHD~HROID = HRP1001~SOBID
    WHERE WERKS = ZWERKS AND
          ARBPL = ZARBPL AND
          SCLAS = 'A' AND
          HRP1001~OBJID = ZPERNR.

  MOVE DOBJID TO DPERNR.
  IF VTRANS IS NOT INITIAL.
    IF ZPERNR NE DOBJID.
      CLEAR : DMESSAGE.
      CONCATENATE 'NIK' ZPERNR 'tidak diperbolehkan untuk mengeksekusi' INTO DMESSAGE SEPARATED BY SPACE.

      IF ZCOND = 'CRT'.
        CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
          EXPORTING
            TEXTLINE1 = DMESSAGE.
        DERROR = 1.
      ELSE.
        PERFORM APD_ER_MSG USING DMESSAGE.
        ZSTATUS = 'P'.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.                    "AUTH

