FORM CHK_STOCK USING ZCHARG ZSLOC.
  DATA : DCLABS LIKE MCHB-CLABS,
         ZMESSAGE TYPE STRING.

  SELECT SINGLE CLABS INTO DCLABS
    FROM MCHB
  WHERE CHARG = ZCHARG AND
        LGORT = ZSLOC.

