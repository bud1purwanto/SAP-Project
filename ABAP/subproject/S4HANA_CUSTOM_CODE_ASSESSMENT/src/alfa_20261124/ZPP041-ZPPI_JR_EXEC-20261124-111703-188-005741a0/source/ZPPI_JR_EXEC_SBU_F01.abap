*      SELECT SINGLE TEXT INTO LMSG-MSGV1
*        FROM T100
*      WHERE SPRSL = 'E' AND
*            ARBGB = ZAFFW-MSGID AND
*            MSGNR = ZAFFW-MSGNO.
*
*      CLEAR: DLGT,STRLGT,DMESSAGE,CLGT,IERRM.
*      MOVE LMSG-MSGV1 TO DMESSAGE.
*
*      STRLGT = STRLEN( DMESSAGE ).
