*      -->ZCODE      text
*      -->ZAUFNR     text
*      -->ZMATSLIP   text
*      -->ZMATDOC    text
*      -->ZMATYEAR   text
*----------------------------------------------------------------------*
FORM GDSMVT_CRT USING ZMAT ZPLANT ZSLOC ZQTY ZGBLOC ZCHARG ZMTYPE ZCODE ZAUFNR ZMATSLIP CHANGING ZMATDOC ZMATYEAR.
  CLEAR : ZGHEAD, ZGITEM, ZBRETURN.
  REFRESH : ZGHEAD, ZGITEM, ZBRETURN.
  ZGHEAD-PSTNG_DATE = AUFK-SDATE.
  ZGHEAD-DOC_DATE = AUFK-SDATE.
  IF ZMATSLIP IS NOT INITIAL.
    ZGHEAD-REF_DOC_NO = ZMATSLIP.
  ENDIF.
  APPEND ZGHEAD.

  MOVE ZMAT TO ZGITEM-MATERIAL.
  MOVE ZPLANT TO ZGITEM-PLANT.
  MOVE ZSLOC TO ZGITEM-STGE_LOC.
  MOVE ZCHARG TO ZGITEM-BATCH.
  ZGITEM-MOVE_TYPE = ZMTYPE."'311'.
  MOVE ZQTY TO ZGITEM-ENTRY_QNT.
  ZGITEM-ENTRY_UOM = 'KG'.
  MOVE ZGBLOC TO ZGITEM-MOVE_STLOC.
  IF ZAUFNR NE ''.
    MOVE ZAUFNR TO ZGITEM-ORDERID.
  ENDIF.
  APPEND ZGITEM.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
