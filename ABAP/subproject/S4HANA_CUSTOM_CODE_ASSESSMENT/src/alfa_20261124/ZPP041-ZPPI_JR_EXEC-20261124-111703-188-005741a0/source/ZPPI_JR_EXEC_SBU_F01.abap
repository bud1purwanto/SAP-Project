*              REPLACE ALL OCCURRENCES OF '&' IN DMESSAGE(CLGT) WITH '4'.
*              IERRM = IERRM + 1.
*          ENDCASE.
*        ENDIF.
*        DLGT = DLGT + 1.
*      ENDDO.
*
