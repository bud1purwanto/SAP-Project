*      -->ZWERKS     text
*----------------------------------------------------------------------*
FORM GT_WRK_CTR USING ZCHARG CHANGING ZARBPL ZWERKS.
  DATA : DAUFNR LIKE AFKO-AUFNR.

  SELECT SINGLE AUFNR WERKS
    INTO (DAUFNR,ZWERKS)
  FROM MSEG
    WHERE CHARG = ZCHARG
      AND BWART = '101'. "Added by AKBAR 14.11.2019 (Filter Non JR NA)

  SELECT SINGLE ARBPL INTO ZARBPL
    FROM CRHD
  JOIN AFVC ON AFVC~ARBID = CRHD~OBJID
  JOIN AFKO ON AFKO~AUFPL = AFVC~AUFPL
    WHERE AUFNR = DAUFNR.
ENDFORM.                    "GT_WRK_CTR

*&---------------------------------------------------------------------*
*&      Form  RECALCULATE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM RECALCULATE.
  DATA : DATWTB LIKE CLBATCH-ATWTB,
         DSTAT TYPE CLBATCH-ATWTB,
         DLABST TYPE EKPO-NETPR,
         DSEQ TYPE I,
         DCHAR TYPE C.
  CLEAR : DTBPQTY, FTXTQTYTBP, FTXTQTYACT, FTXTQTYACTNA, DTBPQTY, FTXTACTROL, FTXTACTROLNA, FTXTTBPROL, FTXTACTLNGT, FTXTACTLNGTNA, TXTMIN1,TXTMIN2,TXTMIN3.
  REFRESH ZZMSEGD.
  PERFORM RD_GDMVT USING '' AUFK-AUFNR.

*  LENGTH***********************************************************************
  LOOP AT ZZMSEGD.
    CHECK ZZMSEGD-SGTXT IS NOT INITIAL.
    CLEAR : DSEQ, DCHAR.
    CONDENSE ZZMSEGD-SGTXT.
    WHILE DCHAR NE '-'.
      DSEQ = DSEQ + 1.
      DCHAR = ZZMSEGD-SGTXT+DSEQ.
    ENDWHILE.
    DATWTB = ZZMSEGD-SGTXT(DSEQ).
    REPLACE ALL OCCURRENCES OF ',' IN DATWTB WITH ''.

    CLEAR : DSTAT.
    PERFORM VBGETDET USING ZZMSEGD-MATNR ZZMSEGD-CHARG ZZMSEGD-WERKS 'ZZGRADEJR' CHANGING DSTAT.
*    READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZGRADEJR'.
*    IF SY-SUBRC = 0.
    PERFORM GT_CHR_VAL USING DSTAT 'ZZGRADEJR' CHANGING ZCLBATCH-ATWTB.
    MOVE ZCLBATCH-ATWTB TO DSTAT.
    CONDENSE DSTAT.
*    ENDIF.
    IF DSTAT = 'OK'.
      FTXTACTLNGT = FTXTACTLNGT + DATWTB.
      FTXTACTROL = FTXTACTROL + 1.
      FTXTQTYACT = FTXTQTYACT + ZZMSEGD-MENGE.
    ELSEIF DSTAT = 'NK'.
      FTXTACTLNGTNA = FTXTACTLNGTNA + DATWTB.
      FTXTACTROLNA = FTXTACTROLNA + 1.
      FTXTQTYACTNA = FTXTQTYACTNA + ZZMSEGD-MENGE.
    ENDIF.
  ENDLOOP.

*  TO BE PRODUCE#################################
  DROLTBP = FTXTPLNROL - FTXTACTROL.
  IF DROLTBP LT 0.
    FTXTTBPROL = ABS( DROLTBP ).
    TXTMIN2 = '-'.
    CONDENSE TXTMIN2.
  ELSE.
    FTXTTBPROL = DROLTBP.
  ENDIF.

  DTBPQTY = FTXTQTY - FTXTQTYACT.
  IF DTBPQTY LT 0.
    FTXTQTYTBP = ABS( DTBPQTY ).
    TXTMIN1 = '-'.
    CONDENSE TXTMIN1.
  ELSE.
    FTXTQTYTBP = DTBPQTY.
  ENDIF.

  FTXTTBPLNGT = FTXTPLNLNGT - FTXTACTLNGT.
  IF FTXTTBPLNGT LT 0.
    FTXTTBPLNGT = ABS( FTXTTBPLNGT ).
    TXTMIN3 = '-'.
    CONDENSE TXTMIN3.
  ENDIF.


*  UPDATE STATUS ORDER
*  PERFORM UPD_STATUS USING AUFK-AUFNR CHANGING BSVX-STTXT.

  IF DOBJNR IS INITIAL.
    SELECT SINGLE OBJNR INTO DOBJNR
      FROM AUFK
    WHERE AUFNR = AUFK-AUFNR.
  ENDIF.
  PERFORM GET_STAT_ORDER USING DOBJNR AUFK-AUFNR CHANGING BSVX-STTXT.
ENDFORM.                    "RECALCULATE

