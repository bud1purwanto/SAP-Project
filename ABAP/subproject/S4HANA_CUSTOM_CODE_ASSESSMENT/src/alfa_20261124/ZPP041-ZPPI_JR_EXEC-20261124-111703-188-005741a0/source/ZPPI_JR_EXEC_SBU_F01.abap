*        IF DMESSAGE+DLGT(1) = '&'.
*          CASE IERRM.
*            WHEN 0.
*              CLGT = DLGT + 1.
*              REPLACE ALL OCCURRENCES OF '&' IN DMESSAGE(CLGT) WITH '1'.
*              IERRM = IERRM + 1.
*            WHEN 1.
*              CLGT = DLGT + 1.
*              REPLACE ALL OCCURRENCES OF '&' IN DMESSAGE(CLGT) WITH '2'.
*              IERRM = IERRM + 1.
*            WHEN 2.
