  ELSEIF ZTCODE = 'ZPP026A' OR ZTCODE = 'ZPP026F' OR ZTCODE = 'ZPP041A' OR ZTCODE = 'ZPP041F' OR ZTCODE = 'ZPP041P' OR ZTCODE = 'ZPP026P'.
    IF ZTYPE IS INITIAL.
      SET TITLEBAR 'ZCOAT'.
    ELSE.
      SET TITLEBAR 'ZCOAT2'.
    ENDIF.
  ELSEIF ZTCODE = 'ZPP026Z' OR ZTCODE = 'ZPP026W' OR ZTCODE = 'ZPP041Z' OR ZTCODE = 'ZPP041W'.
