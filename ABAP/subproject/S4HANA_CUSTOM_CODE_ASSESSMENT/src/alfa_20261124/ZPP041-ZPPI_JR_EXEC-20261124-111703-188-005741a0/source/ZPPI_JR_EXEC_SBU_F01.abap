ENDFORM.                    "CRT_BATCH

*&---------------------------------------------------------------------*
*&      Form  GDSMVT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GDSMVT USING ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB ZBATCH ZGAMNG ZGMEIN.
  DATA : XVORNR TYPE AFVC-VORNR,
         NVORNR TYPE AFVC-VORNR,
         DPLNME LIKE AFKO-PLNME,
         DSUMNG LIKE MSEG-MENGE.

*  CALCULATE VALUE TO BE AUTO FINAL CONFIRMATION***************************
  REFRESH : ZZMSEG.
  PERFORM COMMIT.

  SELECT MBLNR MJAHR MENGE BWART
    INTO CORRESPONDING FIELDS OF TABLE ZZMSEG
  FROM MSEG
    WHERE AUFNR = ZAUFNR AND
          BWART IN ('101','102').

  LOOP AT ZZMSEG.
    IF ZZMSEG-BWART = '101'.
      DSUMNG = DSUMNG + ZZMSEG-MENGE.
    ELSE.
      DSUMNG = DSUMNG - ZZMSEG-MENGE.
    ENDIF.
  ENDLOOP.

  DSUMNG = DSUMNG + ZATWTB.
*  **********************************************************************

  SELECT SINGLE PLNME INTO DPLNME
    FROM AFKO
  WHERE AUFNR = ZAUFNR.

*  PHASE********
  SELECT MAX( VORNR ) MIN( VORNR )
    INTO (XVORNR,NVORNR)
  FROM AFVC
    JOIN AFKO ON AFKO~AUFPL = AFVC~AUFPL
  WHERE PHFLG = 'X' AND
        AUFNR = ZAUFNR.
*    **********

  CLEAR : ZGDSMVT, ZTIMETICKET, ZRETURN, RECBPROD, ZLINK, ZMIGO.
  REFRESH : ZGDSMVT, ZTIMETICKET, ZRETURN, ZLINK, ZMIGO.

  PERFORM APD_GDMVT USING ZAUFNR ZATWTB DPLNME ZBATCH XVORNR ZGMEIN.
*  FOR MIGO***********************
  ZMIGO[] = ZGDSMVT[].
  DELETE ZGDSMVT WHERE MOVE_TYPE NE '101'.
  DELETE ZMIGO WHERE MOVE_TYPE EQ '101'.
*  ******************
*  MIGO 101**##########################################################
  DATA : ZMATDOC LIKE BAPI2017_GM_HEAD_RET-MAT_DOC,
         ZMATYEAR LIKE BAPI2017_GM_HEAD_RET-DOC_YEAR.

  CLEAR : ZGHEAD, ZGITEM, ZBRETURN, ZAFWI, ZAFWI2.
  REFRESH : ZGHEAD, ZGITEM, ZBRETURN, ZAFWI, ZAFWI2.
  ZGHEAD-PSTNG_DATE = AUFK-SDATE.
  ZGHEAD-DOC_DATE = AUFK-SDATE.
  APPEND ZGHEAD.

  LOOP AT ZGDSMVT.
    MOVE ZGDSMVT-MATERIAL TO ZGITEM-MATERIAL.
    MOVE ZGDSMVT-PLANT TO ZGITEM-PLANT.
    MOVE ZGDSMVT-STGE_LOC TO ZGITEM-STGE_LOC.
    MOVE ZGDSMVT-BATCH TO ZGITEM-BATCH.
    MOVE ZGDSMVT-MOVE_TYPE TO ZGITEM-MOVE_TYPE.
    MOVE ZGDSMVT-ENTRY_QNT TO ZGITEM-ENTRY_QNT.
    MOVE ZGDSMVT-ENTRY_UOM TO ZGITEM-ENTRY_UOM.
    MOVE ZGDSMVT-MOVE_STLOC TO ZGITEM-MOVE_STLOC.
    ZGITEM-ORDERID = ZAUFNR.
    ZGITEM-MVT_IND = 'F'.
    APPEND ZGITEM.
  ENDLOOP.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
    EXPORTING
      GOODSMVT_HEADER  = ZGHEAD
      GOODSMVT_CODE    = '02'
    IMPORTING
      MATERIALDOCUMENT = ZMATDOC
      MATDOCUMENTYEAR  = ZMATYEAR
    TABLES
      GOODSMVT_ITEM    = ZGITEM
      RETURN           = ZBRETURN.

  IF ZMATDOC IS NOT INITIAL.
    PERFORM BAPI_COMMIT.
    ZAFWI-MBLNR = ZMATDOC.
    ZAFWI-MJAHR = ZMATYEAR.
    APPEND ZAFWI.
  ELSE.
    PERFORM BAPI_ROLLBACK.
  ENDIF.

  PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
  PERFORM COMMIT.
*  ##############################################################

  IF XVORNR = NVORNR.
    IF DSUMNG GE FTXTQTY.
      PERFORM APD_TKT USING XVORNR ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB DPLNME 'F' ZMATDOC.
    ELSE.
      PERFORM APD_TKT USING XVORNR ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB DPLNME ''ZMATDOC.
    ENDIF.
*    PERFORM APD_GDMVT USING ZAUFNR 'T' ZATWTB DPLNME ZBATCH XVORNR ZGMEIN.
  ELSE. " Kalo phase ada 2
    IF DSUMNG GE FTXTQTY.
      PERFORM APD_TKT USING XVORNR ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB DPLNME 'F' ZMATDOC.
      PERFORM APD_TKT USING NVORNR ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB DPLNME 'F' ZMATDOC.
    ELSE.
      PERFORM APD_TKT USING XVORNR ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB DPLNME '' ZMATDOC.
      PERFORM APD_TKT USING NVORNR ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB DPLNME '' ZMATDOC.
    ENDIF.
*    PERFORM APD_GDMVT USING ZAUFNR 'X' ZATWTB DPLNME ZBATCH XVORNR ZGMEIN.
*    PERFORM APD_GDMVT USING ZAUFNR 'N' ZATWTB DPLNME ZBATCH NVORNR ZGMEIN.
  ENDIF.

  CHECK DSTATUS NE 'E'.
  CLEAR : DRUECK, DRMZHL.
  REFRESH : ZRETURN.
*  WAIT UP TO '3' SECONDS.

  CALL FUNCTION 'BAPI_PROCORDCONF_CREATE_TT'
    TABLES
      TIMETICKETS        = ZTIMETICKET
*     GOODSMOVEMENTS     = ZGDSMVT
*     LINK_CONF_GOODSMOV = ZLINK
      DETAIL_RETURN      = ZRETURN.

  PERFORM BAPI_COMMIT.
  MOVE ZRETURN-CONF_NO TO DRUECK.
  MOVE ZRETURN-CONF_CNT TO DRMZHL.
  PERFORM COMMIT.

  PERFORM CHK_ER USING 'Process Order Confirmation berhasil' 'ZRETURN' CHANGING DSTATUS.
  CHECK DSTATUS NE 'E'.

*  WAIT UP TO 2 SECONDS.

  IF LINES( ZMIGO ) GT 0.
    PERFORM MIGO USING ZAUFNR.
  ENDIF.

  CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
    EXPORTING
      PERCENTAGE = 50
      TEXT       = 'Menunggu proses konfirmasi...'.

ENDFORM.                    "GDSMVT

*&---------------------------------------------------------------------*
*&      Form  VBGETDET
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMATNR     text
*      -->ZCHARG     text
*      -->ZWERKS     text
*      -->ZATNAM     text
*      -->ZATWTB     text
*----------------------------------------------------------------------*
FORM VBGETDET USING ZMATNR ZCHARG ZWERKS ZATNAM CHANGING ZATWTB.
  CLEAR : ZCLBATCH. REFRESH : ZCLBATCH.
  CALL FUNCTION 'VB_INIT'
    EXPORTING
      INIT_RESET = 'X'.

  CALL FUNCTION 'VB_BATCH_GET_DETAIL'
    EXPORTING
      MATNR              = ZMATNR
      CHARG              = ZCHARG
      WERKS              = ZWERKS
      GET_CLASSIFICATION = 'X'
    TABLES
      CHAR_OF_BATCH      = ZCLBATCH.
  READ TABLE ZCLBATCH WITH KEY ATNAM = ZATNAM.
  IF SY-SUBRC = 0.
    MOVE ZCLBATCH-ATWTB TO ZATWTB.
  ELSE.
    ZATWTB = ''.
  ENDIF.
  EXIT.
ENDFORM.                    "VBGETDET

*&---------------------------------------------------------------------*
*&      Form  CHG_CHAR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMAT       text
*      -->ZPLANT     text
*      -->ZBATCH     text
*----------------------------------------------------------------------*
FORM CHG_CHAR USING ZMAT ZPLANT ZBATCH.
  DATA :DCLASS LIKE KLAH-CLASS,
        DKLART LIKE KLAH-KLART,
        DOBTAB LIKE TCLT-OBTAB,
        DOBJKY LIKE BAPI1003_KEY-OBJECT,
        DSTAT LIKE BAPI1003_KEY-STATUS,
        WCOND TYPE C.

  DATA : DMAT LIKE MCHA-MATNR,
         DCHARG LIKE MCHA-CHARG,
         DWERKS LIKE MCHA-WERKS.

  DATA : ZOBJKYTBL LIKE STANDARD TABLE OF BAPI1003_OBJECT_KEYS WITH HEADER LINE,
         ZNUM LIKE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_NUM WITH HEADER LINE,
         ZCURR LIKE STANDARD TABLE OF BAPI1003_ALLOC_VALUES_CURR WITH HEADER LINE.
*  GET CLASS AND CLASS TYPE**********************************

  PERFORM COMMIT.
  MOVE ZMAT TO DMAT.
  MOVE ZBATCH TO DCHARG.
  MOVE ZPLANT TO DWERKS.

  CALL FUNCTION 'QMSP_MATERIAL_BATCH_CLASS_READ'
    EXPORTING
      I_MATNR      = DMAT
      I_CHARG      = DCHARG
      I_WERKS      = DWERKS
      I_MARA_LEVEL = 'X'
    IMPORTING
      E_CLASS      = DCLASS
      E_KLART      = DKLART
      E_OBTAB      = DOBTAB
      E_OBJEC      = DOBJKY.
****UPDATE CHARACTERISTIC******************************
  PERFORM COMMIT.

*  DATA : DCOUNT TYPE I.
*  SELECT COUNT(*) INTO DCOUNT
*    FROM INOB
*  WHERE OBJEK = DOBJKY.
*
*  IF DCOUNT = 0.
*    WAIT UP TO '3' SECONDS.
*  ENDIF.
  WHILE WCOND IS INITIAL.
    CALL FUNCTION 'ENQUEUE_EMMCH1E'
      EXPORTING
        MODE_MCH1      = 'E'
        MANDT          = SY-MANDT
        MATNR          = ZMAT
        CHARG          = ZBATCH
      EXCEPTIONS
        FOREIGN_LOCK   = 1
        SYSTEM_FAILURE = 2
        OTHERS         = 3.
    IF SY-SUBRC = 0.
      WCOND = 'X'.
    ENDIF.
  ENDWHILE.

  CALL FUNCTION 'BAPI_OBJCL_CHANGE'
    EXPORTING
      OBJECTKEY          = DOBJKY "C 50
      OBJECTTABLE        = DOBTAB "C 30
      CLASSNUM           = DCLASS "C 18
      CLASSTYPE          = DKLART "C 3
    IMPORTING
      CLASSIF_STATUS     = DSTAT
    TABLES
      ALLOCVALUESNUMNEW  = ZNUM
      ALLOCVALUESCHARNEW = ZCHAR
      ALLOCVALUESCURRNEW = ZCURR
      RETURN             = ZBRETURN.

  PERFORM BAPI_COMMIT.
  PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
ENDFORM.                    "CHG_CHAR

*&---------------------------------------------------------------------*
*&      Form  CHG_BATCH
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMAT       text
*      -->ZPLANT     text
*      -->ZBATCH     text
*      -->ZJMROL     text
*----------------------------------------------------------------------*
FORM UPD_MAT_LOT USING ZMAT ZPLANT ZBATCH CHANGING ZJMROL ZARBPL ZMON ZSEQ.
  CLEAR : ZCHAR. REFRESH : ZCHAR.
  DATA : DMYR(003),
         DATWTB3 TYPE N LENGTH 3,
         DATWTB2 LIKE CAWNT-ATWTB,
         DATWTB1 LIKE CAWNT-ATWTB,
         DSEQ LIKE ZSEQNUM-ZSEQNO,
         DMON LIKE ZSEQNUM-ZMONTH,
         RMON LIKE DMON,
         DATWRT LIKE CAWN-ATWRT,
         DATWRT2 LIKE CAWN-ATWRT,
         CSEQ(003),
         DATWTB LIKE CLBATCH-ATWTB,
         DJMROL TYPE C LENGTH 20,
         DINSME LIKE MARDH-INSME,
         DPRUEFLOS LIKE QALS-PRUEFLOS,
         DSLENGTH LIKE CLBATCH-ATWTB,
         SAUFNR LIKE MSEG-AUFNR.

  DATA : BEGIN OF ZZSEQNUM,
          ARBPL LIKE ZSEQNUM-ARBPL,
          ZMONTH LIKE ZSEQNUM-ZMONTH,
          ZSEQNO LIKE ZSEQNUM-ZSEQNO,
         END OF ZZSEQNUM.

  DATA : ZMSEG LIKE STANDARD TABLE OF MSEG WITH HEADER LINE,
         ZMSEGD LIKE STANDARD TABLE OF ZMSEG WITH HEADER LINE.

  CHECK DSTATUS NE 'E'.

  PERFORM COMMIT.

  IF RCREATED = 1.
*     SALIN TANGGAL DAN SEQ************************************************************
    DATA : ZATWTB LIKE CAWNT-ATWTB,
           ZATWTB1 LIKE CAWNT-ATWTB,
           ZATWTB2 LIKE CAWNT-ATWTB.
    CLEAR : RSEQ, RRMON.
    IF AFKO-PLNBEZ IS NOT INITIAL.
*      PERFORM VBGETDET USING AFKO-PLNBEZ FCHARG AUFK-WERKS 'ZZNOMORROLL' CHANGING ZATWTB.
      PERFORM VBGETDET2 USING AFKO-PLNBEZ FCHARG AUFK-WERKS 'ZZNOMORROLL' 'ZZMONTHYEAR' 'ZZSEQUENCENBR' CHANGING ZATWTB ZATWTB1 ZATWTB2. " add for new company Extend Field Roll Number
    ENDIF.
    CONDENSE ZATWTB1. "ZATWTB.  add for new company Extend Field Roll Number
    CONDENSE ZATWTB2. "         add for new company Extend Field Roll Number
    RRMON = ZATWTB1. "RRMON = ZATWTB+6(3). add for new company Extend Field Roll Number
    RSEQ = ZATWTB2.  "RSEQ = ZATWTB+10(3). add for new company Extend Field Roll Number
*      ***********************************************************************************
    MOVE RSEQ TO CSEQ.
  ELSE.
    SELECT SINGLE ZMONTH ZSEQNO
      INTO (DMON,DSEQ)
    FROM ZSEQNUM
      WHERE ARBPL = CRHD-ARBPL.

    IF DSEQ IS INITIAL.
      DSEQ = 1.
      ZZSEQNUM-ARBPL = CRHD-ARBPL.
      ZZSEQNUM-ZMONTH = AUFK-SDATE+4(2).
      ZZSEQNUM-ZSEQNO = DSEQ.
      INSERT INTO ZSEQNUM VALUES ZZSEQNUM.
    ELSE.
      MOVE AUFK-SDATE+4(2) TO RMON.
      IF DMON NE RMON.
        DSEQ = 1.
        DMON = RMON.
      ELSE.
        DSEQ = DSEQ + 1.
      ENDIF.
      ZSEQNUM-ARBPL = CRHD-ARBPL.
      ZSEQNUM-ZSEQNO = DSEQ.
      ZSEQNUM-ZMONTH = DMON.
      UPDATE ZSEQNUM.
    ENDIF.
    MOVE DSEQ TO CSEQ.
  ENDIF.
*  **
  ZSEQ = DSEQ - 1. "UNTUK REVERSE KALO TERCANCEL
  ZMON = DMON.
  ZARBPL = CRHD-ARBPL.

  PERFORM VBGETDET USING ZMAT ZBATCH ZPLANT 'ZZCODE' CHANGING DATWTB2.
  PERFORM GT_CHR_VAL USING DATWTB2 'ZZCODE' CHANGING DATWRT2.

  READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZPRODLINE'. "TABLE BERASAL DARI FORM VBGETDET
  IF SY-SUBRC = 0.
    MOVE ZCLBATCH-ATWTB TO DATWTB1.
  ENDIF.

  PERFORM GT_CHR_VAL USING DATWTB1 'ZZPRODLINE' CHANGING DATWRT.

  MOVE DSEQ TO DATWTB3.
  IF RCREATED = 1.
    DMYR = RRMON.
    MOVE RSEQ TO DATWTB3.
  ELSE.
    CONCATENATE AUFK-SDATE+4(2) AUFK-SDATE+3(1) INTO DMYR.
  ENDIF.
  CONCATENATE DATWRT DATWRT2 DMYR DATWTB3 INTO ZJMROL SEPARATED BY SPACE.
  CONDENSE ZJMROL.
*  **
  PERFORM VB_GD_TAB USING ZMAT ZBATCH ZPLANT.

  CONCATENATE AUFK-SDATE+4(2) AUFK-SDATE+3(1) INTO DMYR.
  DELETE ZCHAR WHERE CHARACT = 'ZZMONTHYEAR'.
  DELETE ZCHAR WHERE CHARACT = 'ZZSEQUENCENBR'.
  DELETE ZCHAR WHERE CHARACT = 'ZZGRADEJR'.
  DELETE ZCHAR WHERE CHARACT = 'ZZNOMORROLL'.

  ZCHAR-CHARACT = 'ZZMONTHYEAR'.
  MOVE DMYR TO ZCHAR-VALUE_CHAR.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZSEQUENCENBR'.
  MOVE DATWTB3 TO ZCHAR-VALUE_CHAR.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZGRADEJR'.
  IF DANSWR = 2.
    MOVE 'NK' TO ZCHAR-VALUE_CHAR.
  ELSE.
    MOVE 'OK' TO ZCHAR-VALUE_CHAR.
  ENDIF.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZNOMORROLL'.
  MOVE ZJMROL TO ZCHAR-VALUE_CHAR.
  APPEND ZCHAR.

  PERFORM CHG_CHAR USING ZMAT ZPLANT ZBATCH.
  COMMIT WORK.

  MOVE LSEQ TO LMSG-LINENO.
  APPEND LMSG.
***UPDATE LENGTH AND SCRAP***********************************
  CHECK DSTATUS NE 'E'.

  CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
    EXPORTING
      PERCENTAGE = 75
      TEXT       = 'Proses pembuatan nomor roll dan Goods Movement...'.

  PERFORM COMMIT.
  DATA : TMPATWTB TYPE C LENGTH 18,
         TMPMATNR TYPE MARD-MATNR.

  LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL.
    PERFORM COMMIT.
    CLEAR : ZCHAR. REFRESH : ZCHAR.
*   EDIT LENGTH IN MSC2N ****************************************
    CHECK RE_INPT-PLNBEZ IS NOT INITIAL.

    CLEAR : DJMROL, DSLENGTH.
    MOVE ZJMROL TO DJMROL.
    DSLENGTH = RE_INPT-SLENGTH.
    CONDENSE DSLENGTH.
*    CONCATENATE DJMROL DSLENGTH INTO DJMROL SEPARATED BY SPACE. " MENAMBAHKAN LENGTH

*  UPDATE SCRAP************************************************
    IF RE_INPT-SCRAP IS NOT INITIAL.
      CLEAR : DATWTB,TMPATWTB,TMPMATNR.
      PERFORM CONVERSION USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT 'ZZCONVERSIONROLLKG' CHANGING TMPATWTB.

      "Check Unrest Stock**********************************
      PERFORM CHK_STOCK USING RE_INPT-CHARG RE_INPT-LGORT.
*      **************************************************
      CHECK DSTATUS NE 'E'.
      "Check apakah SLoc sudah di maintain
      MOVE RE_INPT-PLNBEZ TO TMPMATNR.
      PERFORM CHECK_SLOC USING RE_INPT-LGORT TMPMATNR ZPLANT.

      CHECK DSTATUS NE 'E'.
      PERFORM COMMIT.

      CLEAR : VSCMENGE, ZTBMATNR.
      PERFORM GDSMVT_SCRAP USING RE_INPT-PLNBEZ RE_INPT-NCONVROLL RE_INPT-CHARG AUFK-AUFNR ZPLANT RE_INPT-LGORT JRLGORT SLOCCX ZBATCH RE_INPT-SPJG CHANGING ZAFWI-MBLNR ZAFWI-MJAHR VSCMENGE ZTBMATNR.
      PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
      APPEND ZAFWI.

      "Mat to Mat Rollback stock if still exist
      IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
        CLEAR: ZBRETURN.
        REFRESH: ZBRETURN.
        CALL FUNCTION 'ZMM_ROLLBACK_MAT_TO_MAT'
          EXPORTING
            MATNR_I = RE_INPT-MATNR_ASAL
            CHARG_I = RE_INPT-CHARG_ASAL
            WERKS_I = ZPLANT
            LGORT_I = RE_INPT-LGORT
            MATNR_O = RE_INPT-PLNBEZ
            CHARG_O = RE_INPT-CHARG
            AUFNR   = AUFK-AUFNR
          IMPORTING
            MBLNR   = ZAFWI_MTM-MBLNR
            MJAHR   = ZAFWI_MTM-MJAHR
          TABLES
            MESSAGE = ZBRETURN.

        PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
        APPEND ZAFWI_MTM.
      ENDIF.

*      IF VSCMENGE IS NOT INITIAL.
*        PERFORM GDSMVT_CRT USING ZTBMATNR ZPLANT JRLGORT VSCMENGE SLOCGB '' '311' '04' '' '' CHANGING ZAFWI-MBLNR ZAFWI-MJAHR.
*        PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
*        APPEND ZAFWI.
*      ENDIF.
*      PERFORM ZPP019 USING ZPLANT RE_INPT-CHARG SCRLOC FTXTPERNR TMPATWTB DJMROL RE_INPT-OSCRAP.
*    ELSE.
*      PERFORM BDC_MB02 USING ZZMSEGD-MBLNR ZZMSEGD-MJAHR ZJMROL.
    ENDIF.
  ENDLOOP.

  CHECK DSTATUS NE 'E'.
  PERFORM COMMIT.
*  UPDATE 531 TO SLOC***************************************************
  APPEND LINES OF ZMIGO TO ZGDSMVT.
  LOOP AT ZGDSMVT WHERE MOVE_TYPE = '531'.
    CHECK ZGDSMVT-ENTRY_QNT GT 0.
    PERFORM GDSMVT_CRT USING ZGDSMVT-MATERIAL ZGDSMVT-PLANT WSLOC ZGDSMVT-ENTRY_QNT SLOCGB '' '311' '04' '' '' CHANGING ZAFWI-MBLNR ZAFWI-MJAHR.
    APPEND ZAFWI.
  ENDLOOP.
*  *******************************************************************

  CHECK DSTATUS NE 'E'.
  PERFORM COMMIT.
  IF DANSWR = 2.   "N/A Process*####################################################################################
    PERFORM RD_GDMVT USING ZBATCH AUFK-AUFNR.
    READ TABLE ZZMSEGD INDEX 1.
    IF SY-SUBRC = 0.
      SELECT SINGLE PRUEFLOS INTO DPRUEFLOS
        FROM QALS
      WHERE CHARG = ZBATCH.
      PERFORM UPT_QA02 USING ZBATCH 'NA'.
      PERFORM CHK_ER USING 'Change Inspection Lot berhasil' 'ZBRETURN' CHANGING DSTATUS.
      CHECK DSTATUS NE 'E'.

      PERFORM COMMIT.
      PERFORM BDC_QA11 USING DPRUEFLOS ZZMSEGD-MENGE FTXTPERNR.
      PERFORM CHK_ER USING 'Record Usage Decision Berhasil' 'ZBRETURN' CHANGING DSTATUS.
    ENDIF.

*  CHECK Inspection STOCK******************************************
    CLEAR : DINSME.
    PERFORM CHK_STOCK USING ZBATCH FTXTLOC.
    CHECK DSTATUS NE 'E'.

**********************************************************************
    CLEAR : DLGORT, DATWTB.
    IF AUFK-AUART = 'ZP11'.
      PERFORM CONVERSION USING ZMAT ZBATCH ZPLANT 'ZZCONVERSIONPACKG' CHANGING DATWTB.
    ELSE.
      PERFORM CONVERSION USING ZMAT ZBATCH ZPLANT 'ZZCONVERSIONROLLKG' CHANGING DATWTB.
    ENDIF.
    LOOP AT ZGDSMVT WHERE MOVE_TYPE = '101'.
      PERFORM GDSMVT_CRT USING ZGDSMVT-MATERIAL ZGDSMVT-PLANT ZGDSMVT-STGE_LOC ZGDSMVT-ENTRY_QNT GSLOC ZBATCH '311' '04' '' '' CHANGING ZAFWI-MBLNR ZAFWI-MJAHR.
      PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
      APPEND ZAFWI.
    ENDLOOP.
    PERFORM ZPP019 USING ZPLANT ZBATCH GSLOC FTXTPERNR DATWTB '' ''.
    CHECK DSTATUS NE 'E'.

*    CREATE NEW MATDOC*************************
    CLEAR : ZTBMATNR.
    SELECT SINGLE AUFNR INTO SAUFNR
      FROM RESB
    WHERE CHARG = ZBATCH.

    SELECT SINGLE MATNR INTO ZTBMATNR
      FROM MSEG
    WHERE AUFNR = SAUFNR AND
          BWART = '531'.
  ENDIF."##########################################################################################################

*  MB02****************************************
  CLEAR : BSTATUS. " SUPAYA TIDAK KE REVERSE
  CHECK DSTATUS NE 'E'.
  DELETE ZAFWI WHERE MBLNR IS INITIAL.
  CLEAR DJMROL.
  MOVE ZJMROL TO DJMROL.

  "Change Mat to Mat
  IF ZAFWI_MTM[] IS NOT INITIAL.
    APPEND LINES OF ZAFWI_MTM TO ZAFWI.
  ENDIF.

  LOOP AT ZAFWI.
    PERFORM COMMIT.
    PERFORM BAPI_MB02 USING ZAFWI-MBLNR ZAFWI-MJAHR DJMROL 'X'.
    COMMIT WORK AND WAIT.
  ENDLOOP.
*  **********************************************
  PERFORM RECALCULATE.

*  ***Kasus Recreate Batch************************************************
  IF FCHARG IS NOT INITIAL.
    DATA : DLOC TYPE MCHB-LGORT.
    SELECT SINGLE LGORT INTO DLOC
      FROM MCHB
    WHERE CHARG = FCHARG.
    PERFORM RCRT_BATCH USING ZMAT ZPLANT DLOC FTXTWINDER FCHARG.
  ENDIF.

*  print label #######################################################
  RANGES: TORD FOR AFPO-ABLAD.

  TORD-SIGN   = 'I'.
  TORD-OPTION = 'EQ'.
  TORD-LOW = ZBATCH.
  APPEND TORD.

  SUBMIT ZMMR_LABELJR WITH P_CHARG IN TORD
                            WITH P_NDLOG = 'X' AND RETURN.
*#######################################################################*
ENDFORM.                    "CHG_BATCH

*&---------------------------------------------------------------------*
*&      Form  CCL_BATCH
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZBATCH     text
*      -->ZAUFNR     text
*      -->ZAUART     text
*      -->ZREASON    text
*      -->ZNIK       text
*----------------------------------------------------------------------*
FORM CCL_BATCH USING ZBATCH ZAUFNR ZAUART ZREASON ZNIK.
  DATA : ZMATNR LIKE MCHA-MATNR,
         ZWERKS LIKE MCHA-WERKS,
         ZATWTB LIKE CLBATCH-ATWTB,
         PATWTB TYPE P DECIMALS 3,
         ZRUECK LIKE AFRU-RUECK,
         ZLOCK LIKE BAPI_CORU_PARAM-LOCKED,
         ZCINSM LIKE MCHB-CINSM,
         ZATWRT LIKE CAWN-ATWRT,
         ZPRUEFLOS LIKE QALS-PRUEFLOS,
         NAUFNR LIKE MSEG-AUFNR,
         NMATNR LIKE MSEG-MATNR,
         NLGORT LIKE MSEG-LGORT,
         DNA TYPE BOOLEAN,
         DLENGTH TYPE I,
         NLENGTH TYPE P,
         DMBLNR LIKE MSEG-MBLNR,
         DBKTXT LIKE MKPF-BKTXT,
         DAUART TYPE AUFK-AUART,
         ZMTART LIKE MARA-MTART.  " ADD NEW COMPANY cancel batch Raw Mat

  CLEAR : DSTATUS. REFRESH : ZZMSEG, ZZMSEG_CHAR.

  PERFORM COMMIT.
  SELECT SINGLE MATNR WERKS
    INTO (ZMATNR,ZWERKS)
  FROM MCHB
    WHERE CHARG = ZBATCH.

  CHECK ZMATNR IS NOT INITIAL.
  SELECT SINGLE RUECK INTO ZRUECK
    FROM AFRU
  WHERE AUFNR = ZAUFNR AND
        STOKZ NE 'X'.

  CHECK DSTATUS NE 'E'.
  "CHECK QUALITY INSPECTION**########################################################################################
  CLEAR : ZATWTB, DMESSAGE.
  PERFORM VBGETDET USING ZMATNR ZBATCH ZWERKS 'ZZGRADEJR' CHANGING ZATWTB.
  PERFORM GT_CHR_VAL USING ZATWTB 'ZZGRADEJR' CHANGING ZATWTB.
  IF ZATWTB = 'OK'.
    SELECT SINGLE CINSM INTO ZCINSM
      FROM MCHB
    WHERE CHARG = ZBATCH.

    DMESSAGE = 'Inspection Quality tidak mencukupi untuk di reversed'.
  ELSEIF ZATWTB = 'NK'.
    SELECT SINGLE MSEG~AUFNR INTO NAUFNR
      FROM MSEG JOIN AUFK ON MSEG~AUFNR = AUFK~AUFNR
    WHERE MSEG~CHARG = ZBATCH AND
          MSEG~BWART IN ('261','901') AND
          AUFK~AUART IN ('ZRR1','ZRR2'). "ADD TES JR NA

    SELECT SINGLE MATNR LGORT
      INTO (NMATNR, NLGORT)
    FROM MSEG
      WHERE BWART = '531' AND
            AUFNR = NAUFNR.

    CLEAR : ZATWTB.
    PERFORM VBGETDET USING ZMATNR ZBATCH ZWERKS 'ZZNOMORROLL' CHANGING ZATWTB.

*    SELECT SINGLE LGORT INTO NLGORT      "DISABLE FOR NEW COMPANY
*      FROM MSEG
*    JOIN MKPF ON MKPF~MBLNR = MSEG~MBLNR AND
*                 MKPF~MJAHR = MSEG~MJAHR
*    WHERE MSEG~BWART = '311' AND
*          MKPF~BKTXT = ZATWTB AND
*          UMMAT = NMATNR AND
*          UMLGO = NLGORT AND
*          WERKS = ZWERKS.

    SELECT SINGLE LABST INTO ZCINSM
      FROM MARD
    WHERE MATNR = NMATNR AND
          LGORT = NLGORT AND
          WERKS = ZWERKS.

    DMESSAGE = 'Unrestricted Stock tidak mencukupi untuk di reversed'.
  ENDIF.

  IF ZATWTB IS NOT INITIAL.
    IF ZAUART = 'ZP11'.
      PERFORM CONVERSION USING ZMATNR ZBATCH ZWERKS 'ZZCONVERSIONPACKG' CHANGING PATWTB.
    ELSE.
      PERFORM CONVERSION USING ZMATNR ZBATCH ZWERKS 'ZZCONVERSIONROLLKG' CHANGING PATWTB.
    ENDIF.

    IF PATWTB > ZCINSM.
      PERFORM APD_ER_MSG USING DMESSAGE.
    ENDIF.
  ENDIF.

  CHECK DSTATUS NE 'E'.
*  ITUNG JUMLAH STOCK BATCH INPUTAN#*****************************************
  CLEAR : ZATWTB.
  PERFORM VBGETDET USING ZMATNR ZBATCH ZWERKS 'ZZNOMORROLL' CHANGING ZATWTB.
  IF ZATWTB IS NOT INITIAL.
*    CONDENSE ZATWTB.
    DLENGTH = STRLEN( ZATWTB ).
    CONCATENATE ZATWTB '%' INTO DBKTXT.

    REFRESH ZMKPF.
    SELECT DISTINCT MBLNR MJAHR BKTXT
      INTO CORRESPONDING FIELDS OF TABLE ZMKPF
    FROM MKPF
      WHERE BKTXT LIKE DBKTXT.

    CLEAR : DMBLNR, NAUFNR, NMATNR, NLGORT, DMESSAGE.
    LOOP AT ZMKPF.
      CLEAR DMESSAGE.
      REFRESH ZZMSEGD.
      IF STRLEN( ZMKPF-BKTXT ) GE DLENGTH.
        DMBLNR = ZMKPF-MBLNR.
*        MEMINDAHKAN STATUS BARU***********************************
        REPLACE ALL OCCURRENCES OF ZATWTB IN ZMKPF-BKTXT WITH ''.

        SELECT SINGLE AUFNR INTO NAUFNR
          FROM MSEG
        WHERE MBLNR = ZMKPF-MBLNR.

        IF NAUFNR EQ ''. "ADD FOR NEW COMPANY
          CONTINUE.
