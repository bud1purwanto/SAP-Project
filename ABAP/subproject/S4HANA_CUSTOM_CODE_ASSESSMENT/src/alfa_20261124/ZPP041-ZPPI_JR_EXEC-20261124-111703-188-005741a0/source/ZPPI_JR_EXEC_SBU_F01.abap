                                  'QALS-PRUEFLOS'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '/00'.
    PERFORM BDC_FIELD       USING 'QALS-PRUEFLOS'
                                  ZPRUEFLOS.

    PERFORM BDC_DYNPRO      USING 'SAPMQEVA' '0200'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '=+FC1'.
    PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                  'RQEVA-MHD_01'.
    PERFORM BDC_FIELD       USING 'RQEVA-VCODE'
                                  'X'.

    PERFORM BDC_DYNPRO      USING 'SAPLSPO1' '0500'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '=OPT1'.

    PERFORM BDC_DYNPRO      USING 'SAPMQEVA' '0200'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '=BU'.
    PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                  'RQEVA-MHD_01'.
    PERFORM BDC_TRANSACTION USING 'QA12'.

    CLEAR : IT_BDCDATA. REFRESH IT_BDCDATA.
    PERFORM BDC_DYNPRO      USING 'RQEVAC50' '1000'.
    PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                  'PRUEFLOS'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '=ONLI'.
    PERFORM BDC_FIELD       USING 'PRUEFLOS'
                                  ZPRUEFLOS.

    PERFORM BDC_DYNPRO      USING 'RQEVAC50' '1000'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '/EENDE'.
    PERFORM BDC_TRANSACTION USING 'ZQM031'.

    PERFORM CHK_ER USING 'Record Usage Decision Berhasil' 'ZBRETURN' CHANGING DSTATUS.
  ENDIF.

  CHECK DSTATUS NE 'E'.

  "Cancel JR NA 101
  PERFORM VBGETDET USING ZMATNR ZBATCH ZWERKS 'ZZGRADEJR' CHANGING ZATWTB.
  PERFORM GT_CHR_VAL USING ZATWTB 'ZZGRADEJR' CHANGING ZATWTB.
  IF ZATWTB = 'NK'.
    LOOP AT TMPMSEG WHERE BWART EQ '101'.
