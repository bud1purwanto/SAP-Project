*&---------------------------------------------------------------------*
*&      Form  GET_RSC
*&---------------------------------------------------------------------*
*       Form untuk memunculkan popup Resource
*----------------------------------------------------------------------*
*<-- SO_ARBPL-LOW Mendapatkan nilai Resource
*<-- SO_ARBPL-HIGH Mendapatkan nilai Resource
*----------------------------------------------------------------------*
FORM GET_RSC CHANGING ZVAL.
  SELECT DISTINCT CRHD~ARBPL
    INTO CORRESPONDING FIELDS OF TABLE ZCRHD
  FROM CRHD
    JOIN AFVC ON CRHD~OBJID = AFVC~ARBID
    JOIN AFKO ON AFKO~AUFPL = AFVC~AUFPL
    JOIN AUFK ON AUFK~AUFNR = AFKO~AUFNR
  WHERE AUTYP = '40'.

  SORT ZCRHD BY ARBPL.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD     = 'ARBPL'
      WINDOW_TITLE = 'Resource Help List'
      VALUE_ORG    = 'S'
    TABLES
      VALUE_TAB    = ZCRHD
      RETURN_TAB   = IT_RETURN.

  IF SY-SUBRC = 0.
    ZVAL = IT_RETURN-FIELDVAL.
  ENDIF.
ENDFORM.                    "GET_RSC

*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA.
  SELECT DISTINCT AUFK~WERKS AUFK~AUFNR AFKO~PLNBEZ AFKO~GSTRP AFKO~GSUZP AUFK~OBJNR AUFK~AUART CRHD~ARBPL AFKO~GAMNG AUFK~AUTYP AS ICON
    INTO CORRESPONDING FIELDS OF TABLE IT_EXEC
  FROM CRHD
    JOIN AFVC ON CRHD~OBJID = AFVC~ARBID
    JOIN AFKO ON AFKO~AUFPL = AFVC~AUFPL
    JOIN AUFK ON AUFK~AUFNR = AFKO~AUFNR
  WHERE CRHD~ARBPL IN SO_ARBPL AND
        AFKO~GSTRP IN SO_GSTRP.

  DELETE IT_EXEC WHERE ICON NE '40'.
  IT_EXEC-ICON = ''.
  MODIFY IT_EXEC TRANSPORTING ICON WHERE ICON NE ''.

  DELETE IT_EXEC WHERE
  AUART NE 'ZP01'
  AND AUART NE 'ZP02'
  AND AUART NE 'ZP03'
  AND AUART NE 'ZP04'
  AND AUART NE 'ZP05'
  AND AUART NE 'ZP06'
  AND AUART NE 'ZP07'
  AND AUART NE 'ZP08'
  AND AUART NE 'ZP09'
  AND AUART NE 'ZP10'
  AND AUART NE 'ZP11'
  AND AUART NE 'ZP12'     "ADDED EXLAM 11.01.2019 - ADD ORDER TYPE ZP12
  " Added by William at 24.07.2022 (OPP7 CPP1)
  AND AUART NE 'ZP13'
  AND AUART NE 'ZP14'
  AND AUART NE 'ZP15'
  AND AUART NE 'ZP16'
  AND AUART NE 'ZP17'
  AND AUART NE 'ZP18'
  " End added by William at 24.07.2022 (OPP7 CPP1)
  AND AUART NE 'ZTR1'
  AND AUART NE 'ZTR2'
  AND AUART NE 'ZTR3'
  AND AUART NE 'ZTR4'
  AND AUART NE 'ZTR5'
  AND AUART NE 'ZTR6'
  AND AUART NE 'ZTR7'    "ADDED EXLAM 11.01.2019 - ADD ORDER TYPE ZTR7
  " Added by William at 24.07.2022 (OPP7 CPP1)
  AND AUART NE 'ZTR8'
  AND AUART NE 'ZTR9'
  AND AUART NE 'ZTRA'
  AND AUART NE 'ZTRB'
  AND AUART NE 'ZTRC'
  " End added by William at 24.07.2022 (OPP7 CPP1)
  "Added by Ryan at 05.01.2025 (Laminator #2 #3)
  AND AUART NE 'ZTRD'
  "END added by Ryan at 05.01.2025 (Laminator #2 #3)
  .

  LOOP AT IT_EXEC.
    SELECT SINGLE ISTAT TXT30 TXT04 "COMPLETE STATUS
      INTO (IT_EXEC-ISTAT,IT_EXEC-TXT30, IT_EXEC-TXT04)
    FROM TJ02T
      JOIN JEST ON JEST~STAT = TJ02T~ISTAT
    WHERE OBJNR = IT_EXEC-OBJNR AND
          SPRAS = 'E' AND
          INACT NE 'X' AND
          TXT04 = 'TECO'.
    MODIFY IT_EXEC.
  ENDLOOP.

  DELETE IT_EXEC WHERE TXT04 = 'TECO'.

  LOOP AT IT_EXEC.
    SELECT SINGLE MAKTX
      INTO IT_EXEC-MAKTX
    FROM MAKT
      WHERE MATNR = IT_EXEC-PLNBEZ.

    PERFORM GET_STAT_ORDER USING IT_EXEC-OBJNR IT_EXEC-AUFNR CHANGING IT_EXEC-TXT30.

    IF IT_EXEC-TXT30 = 'Completed'.
      IT_EXEC-ICON = '@08@'.
    ELSE.
      IT_EXEC-ICON = '@0A@'.
    ENDIF.

    MODIFY IT_EXEC.
  ENDLOOP.

  SORT IT_EXEC BY AUFNR.
ENDFORM.                    "GET_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_DATA_ORD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA_ORD.
  CLEAR : IT_ORDER.
  REFRESH : IT_ORDER.
  LOOP AT IT_EXEC WHERE BOX = 'X'.

*    GET BATCH, CONFIRM, COUNTER***************************
    REFRESH : GMSEG, RMSEG.
    SELECT MBLNR SMBLN BWART CHARG SMBLN MJAHR ZEILE
      INTO CORRESPONDING FIELDS OF TABLE RMSEG
    FROM MSEG
      WHERE AUFNR = IT_EXEC-AUFNR AND
            BWART IN ('101', '102').

    GMSEG[] = RMSEG[].
    DELETE RMSEG WHERE BWART = '101'.
    LOOP AT RMSEG.
      DELETE GMSEG WHERE MBLNR = RMSEG-SMBLN.
    ENDLOOP.
    DELETE GMSEG WHERE BWART = '102'.

    LOOP AT GMSEG.
      IT_ORDER-AUFNR = IT_EXEC-AUFNR.
      IT_ORDER-PLNBEZ = IT_EXEC-PLNBEZ.
      IT_ORDER-MAKTX = IT_EXEC-MAKTX.
      IT_ORDER-AUART = IT_EXEC-AUART.
      IT_ORDER-WERKS = IT_EXEC-WERKS.
      IT_ORDER-GSTRP  = IT_EXEC-GSTRP.
      IT_ORDER-GSUZP = IT_EXEC-GSUZP.
      IT_ORDER-OBJNR = IT_EXEC-OBJNR.
      IT_ORDER-ARBPL = IT_EXEC-ARBPL.

      SELECT SINGLE GAMNG GMEIN
        INTO (IT_ORDER-GAMNG,IT_ORDER-GMEIN)
      FROM AFKO
        WHERE AUFNR = IT_EXEC-AUFNR.

      CLEAR : IT_ORDER-CHARG, IT_ORDER-RUECK, IT_ORDER-RMZHL, IT_ORDER-STOKZ, IT_ORDER-ATWTB, IT_ORDER-TSTAT, IT_ORDER-DESC.
      IT_ORDER-CHARG = GMSEG-CHARG.

      SELECT SINGLE RUECK RMZHL
        INTO (IT_ORDER-RUECK,IT_ORDER-RMZHL)
      FROM AFRU
        WHERE LTXA1 = GMSEG-MBLNR." AND
*              MJAHR = GMSEG-MJAHR AND
*              MBLPO = GMSEG-ZEILE.

      SELECT SINGLE STOKZ ISM01
        INTO (IT_ORDER-STOKZ,IT_ORDER-ISM01)
      FROM AFRU
       WHERE RUECK = IT_ORDER-RUECK AND
             RMZHL = IT_ORDER-RMZHL.

      IF IT_ORDER-RUECK IS INITIAL.
        SELECT SINGLE RUECK RMZHL STOKZ
          INTO (IT_ORDER-RUECK,IT_ORDER-RMZHL, IT_ORDER-STOKZ)
        FROM AFRU
          WHERE WABLNR = GMSEG-MBLNR.
      ENDIF.

******************************************
**    NO JR***************************
      CLEAR : ZCLBATCH. REFRESH : ZCLBATCH.
      IF IT_ORDER-CHARG IS NOT INITIAL.
        PERFORM VBGETDET USING IT_EXEC-PLNBEZ IT_ORDER-CHARG IT_EXEC-WERKS 'ZZNOMORROLL' CHANGING IT_ORDER-ATWTB.
        READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZTREATMENT'.
        IF SY-SUBRC = 0.
          IT_ORDER-TRTMT = ZCLBATCH-ATWTB.
        ELSE.
          CLEAR IT_ORDER-TRTMT.
        ENDIF.

        READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZLENGTH'.
        IF SY-SUBRC = 0.
          IT_ORDER-ZZPJG = ZCLBATCH-ATWTB.
        ELSE.
          CLEAR IT_ORDER-ZZPJG.
        ENDIF.

        READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZWIDTH'.
        IF SY-SUBRC = 0.
          IT_ORDER-ZZLBR = ZCLBATCH-ATWTB.
        ELSE.
          CLEAR IT_ORDER-ZZLBR.
        ENDIF.

        READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZGRADEJR'.
        IF SY-SUBRC = 0.
          IT_ORDER-ZSTAT = ZCLBATCH-ATWTB.
        ELSE.
          CLEAR IT_ORDER-ZSTAT.
        ENDIF.
      ENDIF.
************SYSTEM STATUS********************************
      CALL FUNCTION 'AIP9_STATUS_READ'
        EXPORTING
          I_OBJNR = IT_ORDER-OBJNR
        IMPORTING
          E_SYSST = IT_ORDER-TSTAT.
*
************SLOC********************************
      SELECT SINGLE LGORT INTO IT_ORDER-LGORT
        FROM MCHB
      WHERE MATNR = IT_ORDER-PLNBEZ AND
            WERKS = IT_ORDER-WERKS AND
            CHARG = IT_ORDER-CHARG.
*
******keterangan winder***********************************************
      PERFORM GT_WINDER USING IT_ORDER-CHARG IT_ORDER-PLNBEZ CHANGING IT_ORDER-DESC.

      APPEND IT_ORDER.
    ENDLOOP.
  ENDLOOP.

  CHECK IT_ORDER IS NOT INITIAL.
  DELETE IT_ORDER WHERE STOKZ = 'X'.
  DELETE IT_ORDER WHERE CHARG = ''.
  CLEAR : WA_LAYOUT.
  SORT IT_ORDER BY ATWTB.
ENDFORM.                    "GET_DATA_ORD

*&---------------------------------------------------------------------*
*&      Form  APD_TKT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZPHASE     text
*----------------------------------------------------------------------*
FORM APD_TKT USING ZPHASE ZAUFNR ZARBPL ZWERKS ZTIME ZATWTB ZPLNME ZSTAT ZMBLNR.
  DATA : T1 TYPE T,
         T2 TYPE T,
         LMNTPCS TYPE I,
         LMNTSUP TYPE I,
         DY TYPE I,
         ESDATE TYPE D.

  ZTIMETICKET-ORDERID = ZAUFNR.
  ZTIMETICKET-PHASE = ZPHASE.
  ZTIMETICKET-POSTG_DATE = AUFK-SDATE.
  ZTIMETICKET-PLANT = ZWERKS.
  ZTIMETICKET-RESOURCE = ZARBPL.

  ZTIMETICKET-FIN_CONF = ZSTAT.

  ZTIMETICKET-CONF_QUAN_UNIT = ZPLNME.

  IF AUFK-AUART = 'ZP10'.
    ZTIMETICKET-YIELD = ZATWTB.
    ZTIMETICKET-CONF_ACTI_UNIT1 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY1 = FTXTSTUP + FTXTPCS.
    ZTIMETICKET-CONF_ACTI_UNIT2 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY2 = FTXTSTUP + FTXTPCS.
    ZTIMETICKET-CONF_ACTI_UNIT3 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY3 = FTXTSTUP + FTXTPCS.
    ZTIMETICKET-CONF_ACTI_UNIT4 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY4 = FTXTSTUP + FTXTPCS.
    ZTIMETICKET-CONF_ACTI_UNIT5 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY5 = FTXTSTUP + FTXTPCS.
    ZTIMETICKET-CONF_ACTI_UNIT6 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY6 = FTXTSTUP + FTXTPCS.
  ELSE.
    ZTIMETICKET-YIELD = ZATWTB.
    ZTIMETICKET-CONF_ACTI_UNIT1 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY1 = ZTIME + FTXTSTUP.
    ZTIMETICKET-CONF_ACTI_UNIT2 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY2 = ZTIME + FTXTSTUP.
    ZTIMETICKET-CONF_ACTI_UNIT3 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY3 = ZTIME + FTXTSTUP.
    ZTIMETICKET-CONF_ACTI_UNIT4 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY4 = ZTIME + FTXTSTUP.
    ZTIMETICKET-CONF_ACTI_UNIT5 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY5 = ZTIME + FTXTSTUP.
    ZTIMETICKET-CONF_ACTI_UNIT6 = 'MIN'.
    ZTIMETICKET-CONF_ACTIVITY6 = ZTIME + FTXTSTUP.
  ENDIF.

  MOVE AUFK-ERFZEIT TO T1.
  MOVE FTXTPCS TO LMNTPCS.
  MOVE FTXTSTUP TO LMNTSUP.
  LMNTPCS = ( LMNTSUP + LMNTPCS ) * 60.
  T2 = T1 - LMNTPCS.
  DY = T2 - T1.
  IF DY GE 0. "BERKURANG 1 HARI
    ESDATE = AUFK-SDATE - 1.
  ELSE.
    ESDATE = AUFK-SDATE.
  ENDIF.

  ZTIMETICKET-EXEC_START_DATE = ESDATE.
  ZTIMETICKET-EXEC_START_TIME = T2.
  ZTIMETICKET-EXEC_FIN_DATE = AUFK-SDATE.
  ZTIMETICKET-EXEC_FIN_TIME = AUFK-ERFZEIT.
  ZTIMETICKET-PERS_NO = FTXTPERNR.

  ZTIMETICKET-CONF_TEXT = ZMBLNR.
  APPEND ZTIMETICKET.
ENDFORM.                    "APD_TKT

*&---------------------------------------------------------------------*
*&      Form  APD_GDMVT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZAUFNR     text
*      -->ZTYP       text
*      -->ZATWTB     text
*      -->ZPLNME     text
*      -->ZBATCH     text
*      -->ZPHASE     text
*      -->ZGMEIN     text
*----------------------------------------------------------------------*
FORM APD_GDMVT USING ZAUFNR ZATWTB ZPLNME ZBATCH ZPHASE ZGMEIN.
  DATA : DLINE TYPE I,
         ZCODE LIKE AUFK-ZCODE.

*  IF ZTYP NE 'N'.
  ZGDSMVT-MATERIAL = AFKO-PLNBEZ.
  ZGDSMVT-PLANT = AUFK-WERKS.
  ZGDSMVT-STGE_LOC = FTXTLOC.
  ZGDSMVT-MOVE_STLOC = FTXTLOC.
  ZGDSMVT-BATCH = ZBATCH.
  ZGDSMVT-MOVE_BATCH = ZBATCH.
  ZGDSMVT-MOVE_TYPE = '101'.
  ZGDSMVT-ENTRY_QNT = ZATWTB.
  ZGDSMVT-ENTRY_UOM = 'KG'."ZGMEIN.
  ZGDSMVT-MVT_IND = 'F'.
*    ZGDSMVT-NO_MORE_GR = 'X'.
  APPEND ZGDSMVT.

  DLINE = DLINE + 1.
  ZLINK-INDEX_CONFIRM = '1'.
  MOVE DLINE TO ZLINK-INDEX_GOODSMOV.
  APPEND ZLINK.
*  ENDIF.

  CHECK AUFK-AUART NE 'ZP01' AND AUFK-AUART NE 'ZP02' AND AUFK-AUART NE 'ZP10' AND AUFK-AUART NE 'ZP11' AND AUFK-AUART NE 'ZTR1' AND AUFK-AUART NE 'ZTR3' "SELAIN BOPP DAN BOPET PERLU GI
    " Added by William at 24.07.2022 (OPP7 CPP1)
    AND AUFK-AUART NE 'ZP13' AND AUFK-AUART NE 'ZP15' AND AUFK-AUART NE 'ZP17'
    AND AUFK-AUART NE 'ZTR8' AND AUFK-AUART NE 'ZTR9' AND AUFK-AUART NE 'ZTRA' AND AUFK-AUART NE 'ZTRB' AND AUFK-AUART NE 'ZTRC'.
  " End added by William at 24.07.2022 (OPP7 CPP1)
  DATA : ZRESB LIKE STANDARD TABLE OF RESB WITH HEADER LINE,
         ZMSEG LIKE STANDARD TABLE OF MSEG WITH HEADER LINE,
         ZMSEGD LIKE STANDARD TABLE OF ZMSEG WITH HEADER LINE.

  DATA : TGI TYPE P DECIMALS 3,
         DGI TYPE P DECIMALS 3,
         DTOT TYPE P DECIMALS 3,
         SBTOT TYPE P DECIMALS 3,
         DRSNUM LIKE AFKO-RSNUM,
         DSEQUENCE TYPE I VALUE 0,
         DATWTB LIKE CLBATCH-ATWTB,
         DATWTB2 LIKE CLBATCH-ATWTB,
         DATWTB3 LIKE CLBATCH-ATWTB,
         DATWTB4 LIKE CLBATCH-ATWTB,
         PATWTB LIKE AFPO-WEMNG,
         PATWTB2 LIKE AFPO-WEMNG,
         PATWTB3 LIKE AFPO-WEMNG,
         PATWTB4 LIKE AFPO-WEMNG,
         DBMENGE LIKE AFKO-BMENGE,
         DPOSNR LIKE RESB-POSNR,
         DMEINS LIKE RESB-MEINS,
         DRSPOS LIKE RESB-RSPOS,
         VCALC TYPE P DECIMALS 2,
         VBWART TYPE RESB-BWART.

  DATA : DNUM TYPE P LENGTH 4 DECIMALS 0.
  IF AUFK-AUART = 'ZTR2' OR AUFK-AUART = 'ZTR4' OR AUFK-AUART = 'ZTR5' OR AUFK-AUART = 'ZTR6'
    "Added by Ryan at 05.01.2025 (Laminator #2 #3)
     OR AUFK-AUART = 'ZTRD'.
    "END added by Ryan at 05.01.2025 (Laminator #2 #3)
    VBWART = '901'.
  ELSE.
    VBWART = '261'.
  ENDIF.
*************************************************************************
*  CHECK ZTYP NE 'X'. "MEMBATASI AGAR PHASE YG PLG BARU TIDAK MASUK
  SELECT MATNR WERKS BDMNG MEINS LGORT POSNR RSPOS BWART
    INTO CORRESPONDING FIELDS OF TABLE ZRESB
  FROM RESB
    WHERE AUFNR = ZAUFNR.
  SORT ZRESB BY RSPOS ASCENDING.

  SELECT SINGLE RSNUM BMENGE
    INTO (DRSNUM,DBMENGE)
  FROM AFKO
    WHERE AUFNR = ZAUFNR.

  "Mat to Mat Reservation
  LOOP AT ZRESB.
    READ TABLE RE_INPT WITH KEY MATNR_ASAL = ZRESB-MATNR.
    IF SY-SUBRC EQ 0.
      ZRESB-MATNR = RE_INPT-PLNBEZ.
      MODIFY ZRESB.
    ENDIF.
  ENDLOOP.

  LOOP AT ZRESB WHERE BWART = '261' OR BWART = '901'.
    ZGDSMVT-MATERIAL = ZRESB-MATNR.
    ZGDSMVT-PLANT = ZRESB-WERKS.
    READ TABLE RE_INPT WITH KEY PLNBEZ = ZRESB-MATNR CKINPT = ''.
    IF SY-SUBRC = 0.
      ZGDSMVT-STGE_LOC = RE_INPT-LGORT.
      ZGDSMVT-BATCH = RE_INPT-CHARG.
      ZGDSMVT-QUANTITY = RE_INPT-SCONVROLL.
      ZGDSMVT-ENTRY_QNT = RE_INPT-SCONVROLL.

      LOOP AT RE_INPT WHERE CHARG = RE_INPT-CHARG. "MENANDAKAN SUDAH DIMASUKKAN KE DALAM GOODSMOVMENT
        RE_INPT-CKINPT = 'X'.
        MODIFY RE_INPT.
      ENDLOOP.
    ELSE.
      ZGDSMVT-STGE_LOC = ZRESB-LGORT.
      ZGDSMVT-BATCH = ZRESB-CHARG.
      ZRESB-BDMNG = ZRESB-BDMNG / DBMENGE * ZATWTB.
      ZGDSMVT-QUANTITY = ZRESB-BDMNG.
      ZGDSMVT-ENTRY_QNT = ZRESB-BDMNG.
    ENDIF.

    ZGDSMVT-MOVE_TYPE = VBWART. "'261'.
    ZGDSMVT-DELIV_ITEM_TO_SEARCH = ZRESB-POSNR.
    ZGDSMVT-ACTIVITY = ZPHASE.
    ZGDSMVT-ORDERID = ZAUFNR.
    ZGDSMVT-RESERV_NO = DRSNUM.
    DSEQUENCE = DSEQUENCE + 1.
    ZGDSMVT-RES_ITEM = ZRESB-RSPOS.
    ZGDSMVT-WITHDRAWN = 'X'.
    ZGDSMVT-REF_DOC_IT = '1'.

    ZGDSMVT-ENTRY_UOM = ZRESB-MEINS.
    ZGDSMVT-NO_MORE_GR = 'X'.
*    ZGDSMVT-WITHDRAWN = 'X'.
    ZGDSMVT-MVT_IND = ''.
    ZGDSMVT-STCK_TYPE = ''.
    APPEND ZGDSMVT.

    DLINE = DLINE + 1.
    ZLINK-INDEX_CONFIRM = '1'.
    MOVE DLINE TO ZLINK-INDEX_GOODSMOV.
    APPEND ZLINK.
    MOVE ZRESB-POSNR TO DNUM. "BUAT ITUNG DELIV NO 531
  ENDLOOP.

  "MEMASUKKAN SISA BATCH YANG BELUM MASUK*********************************
  LOOP AT RE_INPT WHERE CKINPT = '' AND PLNBEZ IS NOT INITIAL.
    ZGDSMVT-MATERIAL = RE_INPT-PLNBEZ.
    ZGDSMVT-PLANT = AUFK-WERKS.
    ZGDSMVT-STGE_LOC = RE_INPT-LGORT.
    ZGDSMVT-BATCH = RE_INPT-CHARG.
    ZGDSMVT-QUANTITY = RE_INPT-SCONVROLL.
    ZGDSMVT-ENTRY_QNT = RE_INPT-SCONVROLL.
    ZGDSMVT-MOVE_TYPE = VBWART."'261'.
    CLEAR : DPOSNR, DRSPOS, DMEINS.
    SELECT SINGLE POSNR RSPOS MEINS
      INTO (DPOSNR, DRSPOS, DMEINS)
    FROM RESB
      WHERE AUFNR = ZAUFNR AND
            MATNR = RE_INPT-PLNBEZ.

    "Mat to Mat UoM
    IF SY-SUBRC NE 0.
      SELECT SINGLE POSNR RSPOS MEINS
        INTO (DPOSNR, DRSPOS, DMEINS)
      FROM RESB
        WHERE AUFNR = ZAUFNR AND
              MATNR = RE_INPT-MATNR_ASAL.
    ENDIF.

    MOVE DPOSNR TO ZGDSMVT-DELIV_ITEM_TO_SEARCH.
    MOVE DRSPOS TO ZGDSMVT-RES_ITEM.
    MOVE DMEINS TO ZGDSMVT-ENTRY_UOM.

    ZGDSMVT-ACTIVITY = ZPHASE.
    ZGDSMVT-ORDERID = ZAUFNR.
    ZGDSMVT-RESERV_NO = DRSNUM.
    DSEQUENCE = DSEQUENCE + 1.
    ZGDSMVT-WITHDRAWN = 'X'.
    ZGDSMVT-REF_DOC_IT = '1'.
    ZGDSMVT-NO_MORE_GR = 'X'.

    ZGDSMVT-MVT_IND = ''.
    ZGDSMVT-STCK_TYPE = ''.
    APPEND ZGDSMVT.

    DLINE = DLINE + 1.
    ZLINK-INDEX_CONFIRM = '1'.
    MOVE DLINE TO ZLINK-INDEX_GOODSMOV.
    APPEND ZLINK.
  ENDLOOP.
*  *********************************************************************

*CHECK ACTUAL GOODS MOVEMENT*******************************************
*  IF ZTYP NE 'N'. "MEMBATASI AGAR PHASE YG PLG LAMA TIDAK MASUK
  LOOP AT ZGDSMVT WHERE MOVE_TYPE = '261' OR MOVE_TYPE = '901'.
    DGI = DGI + ZGDSMVT-ENTRY_QNT.
  ENDLOOP.

  CLEAR DTOT.
*  IF AUFK-AUART = 'ZP01' OR AUFK-AUART = 'ZP02' OR AUFK-AUART = 'ZP10' OR AUFK-AUART = 'ZP11' OR AUFK-AUART = 'ZTR1' OR AUFK-AUART = 'ZTR3'.
*    DTOT = DGI - ZATWTB.
  IF AUFK-AUART = 'ZP03' OR AUFK-AUART = 'ZP04' OR AUFK-AUART = 'ZP05' OR AUFK-AUART = 'ZP06' OR AUFK-AUART = 'ZTR2' OR AUFK-AUART = 'ZTR5'
  OR AUFK-AUART = 'ZP14' OR AUFK-AUART = 'ZP16' OR AUFK-AUART = 'ZP18'. " Added by William at 24.07.2022 (OPP7 CPP1)
    LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL.
      CLEAR : VCALC.
      VCALC = ( ( RE_INPT-OLENGTH - RE_INPT-SPJG ) * RE_INPT-OWIDTH * RE_INPT-GRM ) / 1000000. "FTXTZWIDTH * RE_INPT-GRM ) / 1000000.
      CALL FUNCTION 'Z_MMUR_ROUND_FOR_FRACT5'
        EXPORTING
          I_VALUE        = VCALC
          I_DECIMALS     = 2
        IMPORTING
*         O_NOMINATOR    = ZPBBARU
*         O_DENOMINATOR  = ZPYBARU
          O_VALUE        = VCALC
        EXCEPTIONS
          INPUT_INVALID  = 1
          OUTPUT_INVALID = 2
          OVERFLOW       = 3
          OTHERS         = 4.
      DTOT = DTOT + VCALC.
    ENDLOOP.
    DTOT = DTOT - ( ( FTXTPJ *  FTXTZWIDTH * RE_INPT-GRM ) / 1000000 ).
  ELSEIF AUFK-AUART = 'ZP09' OR AUFK-AUART = 'ZTR6'
  "Added by Ryan at 05.01.2025 (Laminator #2 #3)
        OR AUFK-AUART = 'ZTRD'
  "END added by Ryan at 05.01.2025 (Laminator #2 #3)
    .
    LOOP AT IT_FILM.
      CLEAR SBTOT.
      LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL AND TFILM = IT_FILM-TFILM.
        CLEAR : VCALC.
        VCALC = ( ( RE_INPT-OLENGTH - RE_INPT-SPJG ) * RE_INPT-OWIDTH * RE_INPT-GRM ) / 1000000."* FTXTZWIDTH * RE_INPT-GRM ) / 1000000.
        CALL FUNCTION 'Z_MMUR_ROUND_FOR_FRACT5'
          EXPORTING
            I_VALUE        = VCALC
            I_DECIMALS     = 2
          IMPORTING
*           O_NOMINATOR    = ZPBBARU
*           O_DENOMINATOR  = ZPYBARU
            O_VALUE        = VCALC
          EXCEPTIONS
            INPUT_INVALID  = 1
            OUTPUT_INVALID = 2
            OVERFLOW       = 3
            OTHERS         = 4.
        SBTOT = SBTOT + VCALC.
      ENDLOOP.
      SBTOT = SBTOT - ( ( FTXTPJ *  FTXTZWIDTH * RE_INPT-GRM ) / 1000000 ).
      DTOT = DTOT + SBTOT.
    ENDLOOP.
  ELSEIF AUFK-AUART = 'ZP07' OR AUFK-AUART = 'ZP08' OR AUFK-AUART = 'ZTR4'.
    CLEAR DGI.
    LOOP AT ZGDSMVT WHERE MOVE_TYPE = '261' OR MOVE_TYPE = '901' AND BATCH IS NOT INITIAL.
      DGI = DGI + ZGDSMVT-ENTRY_QNT.
    ENDLOOP.
    DTOT = DGI - ZATWTB.
  ENDIF.

*  BREAK-POINT.
  IF AUFK-AUART NE 'ZP07' AND AUFK-AUART NE 'ZP08' AND AUFK-AUART NE 'ZTR4'.
*- update by Alf: case 531 to be 261 - 101
    CLEAR: DTOT.
    LOOP AT ZGDSMVT WHERE BATCH NE ''.
      IF ZGDSMVT-MOVE_TYPE = '261' OR ZGDSMVT-MOVE_TYPE = '901'.
        DTOT = DTOT + ZGDSMVT-ENTRY_QNT.
      ELSEIF ZGDSMVT-MOVE_TYPE = '101'.
        DTOT = DTOT - ZGDSMVT-ENTRY_QNT.
      ELSE.
      ENDIF.
    ENDLOOP.

    IF DTOT > 0.
      CLEAR ZGDSMVT.
      RECBPROD = 'X'. "531 AKTIF
      DNUM = DNUM + 10.
      SELECT SINGLE ZCODE INTO ZCODE
        FROM AUFK
      WHERE AUFNR = ZAUFNR.

      SELECT SINGLE RAR_A_MATNR INTO ZGDSMVT-MATERIAL
        FROM ZTMAP_MATRECYCLE
      WHERE WERKS = AUFK-WERKS AND
            FILMT = ZCODE.
      MOVE ZGDSMVT-MATERIAL TO ZTBMATNR. " UNTUK GOODSMOVEMENT NA

      ZGDSMVT-PLANT = AUFK-WERKS.
      ZGDSMVT-STGE_LOC = WSLOC.
      ZGDSMVT-MOVE_TYPE = '531'.
      ZGDSMVT-ENTRY_QNT = DTOT.
      ZGDSMVT-ENTRY_UOM = 'KG'.
      ZGDSMVT-MVT_IND = ''.
      ZGDSMVT-STCK_TYPE = ''.
      ZGDSMVT-RESERV_NO = ''.
      APPEND ZGDSMVT.

      DLINE = DLINE + 1.
      ZLINK-INDEX_CONFIRM = '1'.
      MOVE DLINE TO ZLINK-INDEX_GOODSMOV.
      APPEND ZLINK.
    ENDIF.
  ENDIF.
ENDFORM.                    "APD_GDMVT

*&---------------------------------------------------------------------*
*&      Form  CRT_BATCH
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMAT       text
*      -->ZPLANT     text
*      -->ZSLOC      text
*      -->ZWINDER    text
*      -->ZPROD      text
*      -->ZCOD       text
*      -->ZLEN       text
*      -->ZTRT       text
*      -->ZSPEED     text
*      -->ZBATCH     text
*----------------------------------------------------------------------*

FORM CRT_BATCH USING ZMAT ZPLANT ZSLOC ZWINDER ZPROD ZCOD ZLEN ZWIDTH ZTRT ZSPEED ZAUFNR ZBSTAT CHANGING ZBATCH.
  DATA : DATWTB LIKE CLBATCH-ATWTB,
         IATWTB TYPE I,
         PATWTB LIKE AFPO-WEMNG,
         PBP LIKE FTXTQTYTBP,
         DGAMNG TYPE C LENGTH 17,
         DGMEIN TYPE C LENGTH 3,
         DBDMNG LIKE RESB-BDMNG,
         DCLABS LIKE MCHB-CLABS.

  DATA : ZAFFW LIKE STANDARD TABLE OF AFFW WITH HEADER LINE,
         IT_ZTMAP LIKE STANDARD TABLE OF ZTMAP_SLOCRR WITH HEADER LINE.

  CLEAR : ZBRETURN, ERMSG, DSTATUS.
  REFRESH : ZBRETURN, ERMSG, ZINFO.

  RE_INPT[] = IT_INPT[].
  CLEAR : IT_INPT, DMESSAGE. REFRESH IT_INPT. " SUPAYA TIDAK KE LOCK BATCH

  CLEAR : GSLOC, SCRLOC, WSLOC, SLOCGB.
*  SELECT SINGLE ZNALGORT ZRRLGORT ZWPLGORT ZRRLGORT ZSLLGORT
*    INTO (GSLOC,SCRLOC, WSLOC, SLOCGB, SLOCCX)
*  FROM ZTMAP_SLOCRR
*    WHERE ZLINE = AUFK-ZLINE.

  SELECT ZZNUMBER ZLINE ZNALGORT ZRRLGORT ZWPLGORT ZRRLGORT ZSLLGORT ZJRLGORT
    INTO CORRESPONDING FIELDS OF TABLE IT_ZTMAP
  FROM ZTMAP_SLOCRR
    WHERE ZLINE = AUFK-ZLINE.
  SORT IT_ZTMAP BY ZZNUMBER ASCENDING.

  READ TABLE IT_ZTMAP INDEX 1.
  IF SY-SUBRC = 0.
    GSLOC = IT_ZTMAP-ZNALGORT.
    SCRLOC = IT_ZTMAP-ZRRLGORT.
    WSLOC = IT_ZTMAP-ZWPLGORT.
    SLOCGB = IT_ZTMAP-ZRRLGORT.
    SLOCCX = IT_ZTMAP-ZSLLGORT.
    JRLGORT = IT_ZTMAP-ZJRLGORT.
  ENDIF.

  CALL FUNCTION 'ENQUEUE_EMMARAE'
    EXPORTING
      MODE_MARA      = 'E'
      MANDT          = SY-MANDT
      MATNR          = ZMAT
    EXCEPTIONS
      FOREIGN_LOCK   = 1
      SYSTEM_FAILURE = 2
      OTHERS         = 3.
  IF SY-SUBRC = 1.
    CLEAR : DMESSAGE.
    CONCATENATE 'Material ' ZMAT ' sedang dipergunakan.' INTO DMESSAGE SEPARATED BY SPACE.
    PERFORM APD_ER_MSG USING DMESSAGE.
    DSTATUS = 'X'.

  ENDIF.

  CHECK DSTATUS NE 'X'.
  IF DANSWR = 2.
    PERFORM CHECK_SLOC USING GSLOC ZMAT ZPLANT. " CHECK SLOC NA APAKAH SUDAH DI MAINTAIN
    IF DSTATUS = 'E'.
      DSTATUS = 'X'.
    ENDIF.

    PERFORM CHECK_SLOC USING SLOCGB ZMAT ZPLANT. " CHECK SLOC GABUNGAN APAKAH SUDAH DI MAINTAIN
    IF DSTATUS = 'E'.
      DSTATUS = 'X'.
    ENDIF.
  ENDIF.

  CHECK DSTATUS NE 'X'.
*  CHECK APAKAH BATCH SEDANG DIPERGUNAKAN ATAU TIDAK*******************************************
  LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL.
    CHECK RE_INPT-PLNBEZ IS NOT INITIAL.
    CALL FUNCTION 'ENQUEUE_EMMCH1E'
      EXPORTING
        MODE_MCH1      = 'E'
        MANDT          = SY-MANDT
        MATNR          = RE_INPT-PLNBEZ
        CHARG          = RE_INPT-CHARG
      EXCEPTIONS
        FOREIGN_LOCK   = 1
        SYSTEM_FAILURE = 2
        OTHERS         = 3.
    IF SY-SUBRC = 1.
      CLEAR : DMESSAGE.
      CONCATENATE 'Batch ' RE_INPT-PLNBEZ ' sedang dipergunakan.' INTO DMESSAGE SEPARATED BY SPACE.
      PERFORM APD_ER_MSG USING DMESSAGE.
      DSTATUS = 'X'.
    ENDIF.
  ENDLOOP.

  CHECK DSTATUS NE 'X' AND DSTATUS NE 'E'.

  "Mat to Mat Document
  REFRESH: ZAFWI_MTM, IT_MESSAGE.

  BSTATUS = 'CS'.
  LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL.
    PERFORM VBGETDET USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT 'ZZSCRAP' CHANGING RE_INPT-OSCRAP.
*    READ TABLE ZCLBATCH WITH KEY ATNAM = 'ZZSCRAP'.
*    IF SY-SUBRC = 0.
*      MOVE ZCLBATCH-ATWTB TO RE_INPT-OSCRAP.
    PERFORM GT_CHR_VAL USING RE_INPT-OSCRAP 'ZZSCRAP' CHANGING RE_INPT-OSCRAP.
*    ENDIF.

    PERFORM CONVERSION USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT 'ZZCONVERSIONROLLKG' CHANGING RE_INPT-OCONVROLL.

*    UPDATE CHARACTERISTIC BATCH INPUTAN####################################
    PERFORM VB_GD_TAB USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT.

    DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
    DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.

    ZCHAR-CHARACT = 'ZZLENGTH'.
    MOVE RE_INPT-SPJG TO ZCHAR-VALUE_CHAR.
    CONDENSE ZCHAR-VALUE_CHAR.
    APPEND ZCHAR.
    ZCHAR-CHARACT = 'ZZSCRAP'.
    MOVE 'OK' TO ZCHAR-VALUE_CHAR.
    CONDENSE ZCHAR-VALUE_CHAR.
    APPEND ZCHAR.

*     Update character scrap**************************************
    IF RE_INPT-SCRAP IS NOT INITIAL.
      DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.
      ZCHAR-CHARACT = 'ZZSCRAP'.
      MOVE 'SC' TO ZCHAR-VALUE_CHAR.
      APPEND ZCHAR.
    ENDIF.

    "Check SBU Asset difference Mat to Mat
    IF AUFK-AUART+0(3) NE 'ZTR' AND ( ZPLANT EQ '1000' OR ZPLANT EQ '2000' ) AND ( RE_INPT-PLNBEZ+5(1) NE 'O'
                                                                               AND RE_INPT-PLNBEZ+5(1) NE 'X' ).
      CLEAR: V_SBU_AI, V_SBU_AO.

      IF RE_INPT-PLNBEZ+0(2) EQ 'JR'.
        V_SR = 'SR' && RE_INPT-PLNBEZ+2(10).
      ELSE.
        V_SR = RE_INPT-PLNBEZ.
      ENDIF.
      SELECT SINGLE SBU_ASSET INTO V_SBU_AI
          FROM ZMAPPG
          JOIN T001K ON T001K~BUKRS EQ ZMAPPG~BUKRS
         WHERE MATNR EQ V_SR
           AND BWKEY EQ ZPLANT.

      IF V_SBU_AI IS INITIAL.
        CLEAR DMESSAGE.
        CONCATENATE 'SBU Asset for base film' RE_INPT-PLNBEZ 'not yet maintained' INTO DMESSAGE SEPARATED BY SPACE.
        PERFORM APD_ER_MSG USING DMESSAGE.
        DSTATUS = 'E'.
      ENDIF.

      CLEAR V_SR.
      V_SR = 'SR' && ZMAT+2(10).
      SELECT SINGLE SBU_ASSET INTO V_SBU_AO
          FROM ZMAPPG
          JOIN T001K ON T001K~BUKRS EQ ZMAPPG~BUKRS
         WHERE MATNR EQ V_SR
           AND BWKEY EQ ZPLANT.

      IF V_SBU_AO IS INITIAL.
        CLEAR DMESSAGE.
        CONCATENATE 'SBU Asset for JR' ZMAT 'not yet maintained' INTO DMESSAGE SEPARATED BY SPACE.
        PERFORM APD_ER_MSG USING DMESSAGE.
        DSTATUS = 'E'.
      ENDIF.
    ENDIF.

    CHECK DSTATUS NE 'E'.

    "Exclude Order Type Trial for Mat to Mat and different SBU Asset
    IF AUFK-AUART+0(3) NE 'ZTR' AND V_SBU_AI NE V_SBU_AO AND ( ZPLANT EQ '1000' OR ZPLANT EQ '2000' ) AND ( RE_INPT-PLNBEZ+5(1) NE 'O'
                                                                                                        AND RE_INPT-PLNBEZ+5(1) NE 'X' ).
      "Mat to Mat
      DATA: V_MATNR_O  LIKE MSEG-MATNR,
            V_CHARG_O  LIKE MSEG-CHARG,
            V_LENGTH_O TYPE I,
            V_WEIGHT_O TYPE LABST.

      CLEAR: V_WEIGHT_O, V_CHARG_O, V_CHARG_O, V_CHARG_O.

      CALL FUNCTION 'ZMM_CREATE_MAT_TO_MAT'
        EXPORTING
          MATNR_I  = RE_INPT-PLNBEZ
          CHARG_I  = RE_INPT-CHARG
          WERKS_I  = ZPLANT
          LGORT_I  = RE_INPT-LGORT
          MATNR_J  = ZMAT
          AUFNR    = ZAUFNR
          SPJG     = RE_INPT-SPJG
          SCRAP    = RE_INPT-SCRAP
        IMPORTING
          MBLNR    = ZAFWI_MTM-MBLNR
          MJAHR    = ZAFWI_MTM-MJAHR
          MATNR_O  = V_MATNR_O
          CHARG_O  = V_CHARG_O
          LENGTH_O = V_LENGTH_O
          QTY_O    = V_WEIGHT_O
        TABLES
          MESSAGE  = IT_MESSAGE.

      "Apabila terjadi error mat tot mat
      READ TABLE IT_MESSAGE WITH KEY TYPE = 'E'.
      IF SY-SUBRC EQ 0.
        CLEAR : DMESSAGE.
        PERFORM APD_ER_MSG USING IT_MESSAGE-MESSAGE.
        DSTATUS = 'E'.
      ELSE.
        RE_INPT-CHARG_ASAL = RE_INPT-CHARG.
        RE_INPT-MATNR_ASAL = RE_INPT-PLNBEZ.
        RE_INPT-CHARG  = V_CHARG_O.
        RE_INPT-PLNBEZ = V_MATNR_O.
        RE_INPT-LENGTH_AKSEN = V_LENGTH_O.
        APPEND ZAFWI_MTM.
      ENDIF.
    ENDIF.

    CHECK DSTATUS NE 'E'.

    PERFORM CHG_CHAR USING RE_INPT-PLNBEZ ZPLANT RE_INPT-CHARG.
*    ########################################################################
    CLEAR DOLENGTH.
    PERFORM CONVERSION USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT 'ZZCONVERSIONROLLKG' CHANGING RE_INPT-NCONVROLL.
    RE_INPT-SCONVROLL = RE_INPT-OCONVROLL - RE_INPT-NCONVROLL.
    PERFORM VBGETDET USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT 'ZZLENGTH' CHANGING DOLENGTH.
    REPLACE ALL OCCURRENCES OF ',' IN DOLENGTH WITH ''.
    MOVE DOLENGTH TO RE_INPT-NLENGTH.
    RE_INPT-SLENGTH = RE_INPT-OLENGTH - RE_INPT-NLENGTH.

    "Mat to Mat set Weight from Transfer Posting
    IF V_WEIGHT_O IS NOT INITIAL.
      RE_INPT-SCONVROLL = V_WEIGHT_O.

      "add by ryan, 02-12-2024
      CLEAR V_WEIGHT_O.
    ENDIF.

    "JIKA GAGAL
    IF RE_INPT-SLENGTH LT 0.
      CLEAR : DMESSAGE, BSTATUS.
      CONCATENATE 'Sisa panjang batch' RE_INPT-CHARG 'melebihi panjang aktual' INTO DMESSAGE SEPARATED BY SPACE.
      PERFORM APD_ER_MSG USING DMESSAGE.

*      BALIKIN CHARACTERISTIC LAMA***********************************
      PERFORM VB_GD_TAB USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT.

      DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
      DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.

      ZCHAR-CHARACT = 'ZZLENGTH'.
      MOVE RE_INPT-OLENGTH TO ZCHAR-VALUE_CHAR.
      CONDENSE ZCHAR-VALUE_CHAR.
      APPEND ZCHAR.
      ZCHAR-CHARACT = 'ZZSCRAP'.
      MOVE RE_INPT-OSCRAP TO ZCHAR-VALUE_CHAR.
      CONDENSE ZCHAR-VALUE_CHAR.
      APPEND ZCHAR.

      PERFORM CHG_CHAR USING RE_INPT-PLNBEZ ZPLANT RE_INPT-CHARG.
      DSTATUS = 'W'.
    ENDIF.
    MODIFY RE_INPT.
  ENDLOOP.
*************************************************************************************************
  PERFORM COMMIT.
  CHECK DSTATUS NE 'E' AND DSTATUS NE 'W'.
  PERFORM CHECK_SLOC USING ZSLOC ZMAT ZPLANT.
  CHECK DSTATUS NE 'E'.

  "CREATE BATCH
  PERFORM CREATE_BATCH USING ZMAT ZPLANT ZSLOC ZWINDER CHANGING ZBATCH.

  CHECK DSTATUS NE 'E'.
* EDIT CHARACTERISTIC IN MSC2N
  CLEAR : ZCHAR. REFRESH : ZCHAR.
  IF ZBSTAT = 'R'.
    PERFORM VB_GD_TAB USING MCHB-MATNR MCHB-CHARG MCHB-WERKS.
    DELETE ZCHAR WHERE CHARACT = 'ZZPRODLINE'.
    DELETE ZCHAR WHERE CHARACT = 'ZZCODE'.
    DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
    DELETE ZCHAR WHERE CHARACT = 'ZZWIDTH'.
    DELETE ZCHAR WHERE CHARACT = 'ZZTREATMENT'.
    DELETE ZCHAR WHERE CHARACT = 'ZZSPEED'.
  ENDIF.

  ZCHAR-CHARACT = 'ZZPRODLINE'.
  ZCHAR-VALUE_CHAR = ZPROD.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZCODE'.
  ZCHAR-VALUE_CHAR = ZCOD.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZLENGTH'.
  ZCHAR-VALUE_CHAR = ZLEN.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZWIDTH'.
  ZCHAR-VALUE_CHAR = ZWIDTH.
  APPEND ZCHAR.
  ZCHAR-CHARACT = 'ZZTREATMENT'.
  ZCHAR-VALUE_CHAR = ZTRT.
  APPEND ZCHAR.

  "Start of CKI Update -----------------------------------------------------------------------------------------
  PERFORM ADDITIONAL_CKI USING ZPLANT.
  PERFORM ADDITIONAL_CKI2 USING ZMAT ZPLANT ZBATCH.
  "End of CKI Update -----------------------------------------------------------------------------------------

  IF AUFK-AUART = 'ZP11'.

    DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
    DELETE ZCHAR WHERE CHARACT = 'ZZLENGTHSHT'.
    DELETE ZCHAR WHERE CHARACT = 'ZZNUMBEROFSHEET'.

    ZCHAR-CHARACT = 'ZZNUMBEROFSHEET'.
    ZCHAR-VALUE_CHAR = AUFK-ZNOSHEET.
    APPEND ZCHAR.

    ZCHAR-CHARACT = 'ZZLENGTHSHT'.
    ZCHAR-VALUE_CHAR = ZLEN.
    APPEND ZCHAR.
  ENDIF.
  IF FTXTSPD IS NOT INITIAL.
    ZCHAR-CHARACT = 'ZZSPEED'.
    ZCHAR-VALUE_CHAR = ZSPEED.
    APPEND ZCHAR.
  ENDIF.
  PERFORM CHG_CHAR USING ZMAT ZPLANT ZBATCH.
******************************************************

  CALL FUNCTION 'SAPGUI_PROGRESS_INDICATOR'
    EXPORTING
      PERCENTAGE = 25
      TEXT       = 'Menunggu proses pembuatan batch...'.

  PERFORM CHK_ER USING 'Pengisian Character Berhasil' 'ZBRETURN' CHANGING DSTATUS.
  CHECK DSTATUS NE 'E'.

*  EDIT COR2***********************************
  IF AUFK-AUART = 'ZP11'.
    PERFORM CONVERSION USING ZMAT ZBATCH ZPLANT 'ZZCONVERSIONPACKG' CHANGING PATWTB.
  ELSE.
    PERFORM CONVERSION USING ZMAT ZBATCH ZPLANT 'ZZCONVERSIONROLLKG' CHANGING PATWTB.
  ENDIF.

**COR6*************************************************
  PERFORM GDSMVT USING ZAUFNR CRHD-ARBPL ZPLANT FTXTPCS PATWTB ZBATCH DGAMNG DGMEIN.
  CHECK DSTATUS NE 'E'.

*  JIKA GOODSMOVEMENT ERROR*********************************
*  DATA : DMBLNR LIKE MSEG-MBLNR.
*  SELECT SINGLE MBLNR INTO DMBLNR
*    FROM MSEG
*  WHERE CHARG = ZBATCH AND
*        BWART = '101'.
*
*  SELECT MSGID MSGNO MSGTY MSGV1 MSGV2 MSGV3 MSGV4 AUFNR
*    INTO CORRESPONDING FIELDS OF TABLE ZAFFW
*  FROM AFFW
*    WHERE RUECK = DRUECK AND
*          MSGTY = 'E' AND
*          RMZHL = DRMZHL.
*
*  SORT ZAFFW BY MSGID MSGNO.
*  DELETE ADJACENT DUPLICATES FROM ZAFFW COMPARING MSGID MSGNO.
*  IF LINES( ZAFFW ) > 0.
**    DSTATUS = 'E'.
*    DATA : STRLGT TYPE I,
*           DLGT TYPE I,
*           IERRM TYPE I,
*           CLGT TYPE I.
*
