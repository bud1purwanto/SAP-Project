*      -->ZATWRT     text
*----------------------------------------------------------------------*
FORM GT_CHR_VAL USING ZATWTB ZCHAR CHANGING ZATWRT.
  DATA : DATINN LIKE CAWNT-ATINN.

  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING
      INPUT  = ZCHAR
    IMPORTING
      OUTPUT = DATINN.

  SELECT SINGLE ATWRT INTO ZATWRT
    FROM CAWN
  JOIN CAWNT ON CAWN~ATINN = CAWNT~ATINN AND
                 CAWN~ATZHL = CAWNT~ATZHL
   WHERE ATWTB = ZATWTB AND
         CAWNT~SPRAS = 'E' AND
         CAWNT~ATINN = DATINN.
ENDFORM.                    "GT_CHR_VAL

