FORM CHK_SLOC.
  DATA : ZSLOC TYPE C LENGTH 4.
  SELECT SINGLE ZSLOCJR
    INTO (ZSLOC)
  FROM ZTMAP_SLOC_JR_GR
    WHERE ZLINE = AUFK-ZLINE AND
          ZSLOCJR = FTXTLOC.

  IF ZSLOC IS INITIAL.
    CLEAR : DMESSAGE.
    CONCATENATE 'Sloc' FTXTLOC 'tidak dapat dilakukan GR pada line' AUFK-ZLINE INTO DMESSAGE SEPARATED BY SPACE.

    CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
      EXPORTING
        TEXTLINE1 = DMESSAGE.
    DERROR = 1.
    PERFORM APD_ER_MSG USING DMESSAGE.
  ENDIF.
ENDFORM.                    "CHK_SLOC

*&---------------------------------------------------------------------*
*&      Form  UPD_STATUS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZAUFNR     text
*      -->ZSTATUS    text
*----------------------------------------------------------------------*
FORM UPD_STATUS USING ZAUFNR CHANGING ZSTATUS.
  DATA : DOBJNR TYPE AUFK-OBJNR,
         DTXT04 TYPE TJ02T-TXT04.

  SELECT SINGLE OBJNR INTO DOBJNR
    FROM AUFK
  WHERE AUFNR = ZAUFNR.

  SELECT SINGLE TXT04 "COMPLETE STATUS
    INTO (DTXT04)
  FROM TJ02T
    JOIN JEST ON JEST~STAT = TJ02T~ISTAT
  WHERE OBJNR = DOBJNR AND
        SPRAS = 'E' AND
        INACT NE 'X' AND
        TXT04 IN ('CNF','DLV').


  IF DTXT04 IS INITIAL. "JIKA BELUM COMPLETE
    SELECT SINGLE TXT04
      INTO (DTXT04)
    FROM TJ02T
      JOIN JEST ON JEST~STAT = TJ02T~ISTAT
    WHERE OBJNR = DOBJNR AND
          SPRAS = 'E' AND
          INACT NE 'X' AND
          TXT04 IN ('PCNF','PDLV','GMPS').
  ENDIF.

  IF DTXT04 IS INITIAL. "JIKA MASIH BELUM DIPROGRESS
    SELECT SINGLE TXT04
    INTO (DTXT04)
  FROM TJ02T
    JOIN JEST ON JEST~STAT = TJ02T~ISTAT
  WHERE OBJNR = DOBJNR AND
        SPRAS = 'E' AND
        INACT NE 'X' AND
        TXT04 IN ('CRTD','REL').
  ENDIF.

  CASE DTXT04.
    WHEN 'CRTD'.
      ZSTATUS = 'Created'.
    WHEN 'REL'.
      ZSTATUS = 'Created'.
    WHEN 'CNF'.
      ZSTATUS = 'Completed'.
    WHEN 'DLV'.
      ZSTATUS = 'Completed'.
    WHEN OTHERS.
      ZSTATUS = 'In Progress'.
  ENDCASE.
ENDFORM.                    "UPD_STATUS

*&---------------------------------------------------------------------*
*&      Form  REVERSE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZPLANT     text
*      -->ZMATNR     text
*      -->ZBATCH     text
*----------------------------------------------------------------------*
FORM REVERSE USING ZPLANT ZMATNR ZBATCH.
  LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL.
    IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
      PERFORM COMMIT.
      PERFORM VB_GD_TAB USING RE_INPT-MATNR_ASAL RE_INPT-CHARG_ASAL ZPLANT.

      DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
      DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.

      ZCHAR-CHARACT = 'ZZLENGTH'.
      MOVE RE_INPT-OLENGTH TO ZCHAR-VALUE_CHAR.
      CONDENSE ZCHAR-VALUE_CHAR.
      APPEND ZCHAR.
      ZCHAR-CHARACT = 'ZZSCRAP'.
      MOVE RE_INPT-OSCRAP TO ZCHAR-VALUE_CHAR.
      CONDENSE ZCHAR-VALUE_CHAR.
      APPEND ZCHAR.

      PERFORM CHG_CHAR USING RE_INPT-MATNR_ASAL ZPLANT RE_INPT-CHARG_ASAL.
    ENDIF.

    "Mat to Mat Change Characteristic Batch Aksen
    PERFORM COMMIT.
    PERFORM VB_GD_TAB USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT.

    DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
    DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.
    ZCHAR-CHARACT = 'ZZLENGTH'.

    DATA: V_LENGTH TYPE P.

    IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
*      MOVE V_LENGTH TO ZCHAR-VALUE_CHAR.
      CALL FUNCTION 'ZMM_TEXT_MAT_TO_MAT'
        EXPORTING
          MATNR    = RE_INPT-PLNBEZ
          CHARG    = RE_INPT-CHARG
          WERKS    = ZPLANT
          LENGTH_I = RE_INPT-SLENGTH
          CANC     = 'X'
        IMPORTING
          LENGTH_O = V_LENGTH.

      MOVE V_LENGTH TO ZCHAR-VALUE_CHAR.
    ELSE.
      MOVE RE_INPT-OLENGTH TO ZCHAR-VALUE_CHAR.
    ENDIF.

    CONDENSE ZCHAR-VALUE_CHAR.
    APPEND ZCHAR.

    ZCHAR-CHARACT = 'ZZSCRAP'.
    MOVE RE_INPT-OSCRAP TO ZCHAR-VALUE_CHAR.
    CONDENSE ZCHAR-VALUE_CHAR.
    APPEND ZCHAR.

    PERFORM CHG_CHAR USING RE_INPT-PLNBEZ ZPLANT RE_INPT-CHARG.

    DSTATUS = 'R'.
    COMMIT WORK AND WAIT.
  ENDLOOP.

  IF ZBATCH IS NOT INITIAL.
    PERFORM REV_GDSMVT USING ZMATNR ZBATCH ZPLANT '' ''.
  ELSE.
    "Cancel Mat to Mat Gagal JR
    LOOP AT ZAFWI_MTM.
      TMPMSEG-MBLNR = ZAFWI_MTM-MBLNR.
      TMPMSEG-MJAHR = ZAFWI_MTM-MJAHR.
      TMPMSEG-BWART = '993'.
      APPEND TMPMSEG.
    ENDLOOP.
  ENDIF.
  "Add 993 for Mat to Mat
  LOOP AT TMPMSEG WHERE BWART EQ '101' OR BWART EQ '993'.
    CLEAR : ZBRETURN. REFRESH : ZBRETURN.
    CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
      EXPORTING
        MATERIALDOCUMENT = TMPMSEG-MBLNR
        MATDOCUMENTYEAR  = TMPMSEG-MJAHR
      TABLES
        RETURN           = ZBRETURN.
    PERFORM BAPI_COMMIT.
    PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
  ENDLOOP.

  DATA : ZLOCK LIKE BAPI_CORU_PARAM-LOCKED.
  IF DRUECK IS NOT INITIAL.
    CALL FUNCTION 'BAPI_PROCORDCONF_CANCEL'
      EXPORTING
        CONFIRMATION        = DRUECK
        CONFIRMATIONCOUNTER = DRMZHL
        POSTG_DATE          = SY-DATUM
        CONF_TEXT           = ''
      IMPORTING
        RETURN              = ZCRETURN
        LOCKED              = ZLOCK.
    PERFORM BAPI_COMMIT.
    PERFORM CHK_ER USING '' 'ZCRETURN' CHANGING DSTATUS.
  ENDIF.
ENDFORM.                    "REVERSE

*&---------------------------------------------------------------------*
*&      Form  VLD_LENGTH
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZLENGTH    text
*      -->ZWIDTH     text
*----------------------------------------------------------------------*
FORM VLD_LENGTH USING ZLENGTH ZWIDTH.
  DATA : DLENGTH TYPE P,
         DWIDTH TYPE P,
         CLENGTH TYPE P, "GABUNGAN
         OLENGTH TYPE P, "OLD
         STOT TYPE P,
         VLINE TYPE I,
         TLINE TYPE I.

  CLEAR : DERROR.

  LOOP AT IT_INPT WHERE CHARG IS NOT INITIAL AND TFILM IS INITIAL.
    CLEAR DMESSAGE.
    CONCATENATE 'Batch' IT_INPT-CHARG 'tidak memiliki kode film yang sesuai' INTO DMESSAGE SEPARATED BY SPACE.
    CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
      EXPORTING
        TEXTLINE1 = DMESSAGE.
    DERROR = 1.
  ENDLOOP.
*  jika ada batch inputan yang double******************************
  TMP_INPT[] = IT_INPT[].
  TMP_INPT2[] = IT_INPT[].
  SORT TMP_INPT BY CHARG.
  DELETE ADJACENT DUPLICATES FROM TMP_INPT COMPARING CHARG.
  DELETE TMP_INPT WHERE CHARG IS INITIAL.
  DELETE TMP_INPT2 WHERE CHARG IS INITIAL.
  DESCRIBE TABLE TMP_INPT2 LINES VLINE.
  DESCRIBE TABLE TMP_INPT LINES TLINE.

  IF VLINE GT TLINE.
    CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
      EXPORTING
        TEXTLINE1 = 'Batch inputan yang sama tidak dapat diinput'.
    DERROR = 1.
  ENDIF.

  CHECK DERROR IS INITIAL.
  LOOP AT IT_INPT WHERE CHARG IS NOT INITIAL.
    DLENGTH = IT_INPT-OLENGTH + DLENGTH.
    DWIDTH = IT_INPT-OWIDTH + DWIDTH.
  ENDLOOP.
  OLENGTH = DLENGTH.

  CHECK DERROR IS INITIAL.
  IF FTXTPJ IS NOT INITIAL.
    IF DLENGTH NE 0.
      IF FTXTPJ GE DLENGTH.
        CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
          EXPORTING
            TEXTLINE1 = 'Jumlah panjang aktual lebih besar dari jumlah panjang inputan'.
        DERROR = 1.
      ENDIF.
    ENDIF.
  ELSE.
    IF ZLENGTH GE DLENGTH.
      CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
        EXPORTING
          TEXTLINE1 = 'Jumlah panjang planning lebih besar dari jumlah panjang inputan'.
      DERROR = 1.
    ENDIF.
  ENDIF.

  CHECK DERROR IS INITIAL.
  LOOP AT IT_INPT WHERE CHARG IS NOT INITIAL.
    IF IT_INPT-OLENGTH LT IT_INPT-SPJG.
      CLEAR DMESSAGE.
      CONCATENATE 'Sisa panjang' IT_INPT-CHARG 'lebih besar dari panjang awal inputan' INTO DMESSAGE SEPARATED BY SPACE.
      CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
        EXPORTING
          TEXTLINE1 = DMESSAGE.
      DERROR = 1.
    ENDIF.
  ENDLOOP.

  CHECK DERROR IS INITIAL.
  CLEAR : DLENGTH.
  LOOP AT IT_INPT WHERE CHARG IS NOT INITIAL.
    DLENGTH = IT_INPT-SPJG + DLENGTH.
  ENDLOOP.

  IF IT_INPT IS NOT INITIAL.
*    IF AUFK-AUART NE 'ZP09'.
    CLENGTH = OLENGTH - DLENGTH.
    IF CLENGTH LT FTXTPJ.
      CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
        EXPORTING
*         TITEL        = ' '
          TEXTLINE1    = 'Jumlah panjang yang dikonsumsi harus lebih besar'
          TEXTLINE2    = 'daripada panjang Jumbo Roll aktual'
*         START_COLUMN = 25
*         START_ROW    =                                                                  6
        .
      DERROR = 1.
    ENDIF.
*    ENDIF.
    CHECK DERROR IS INITIAL.
    CLEAR : CLENGTH.
    CLENGTH = FTXTPJ + DLENGTH.
    IF CLENGTH GE OLENGTH.
      CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
        EXPORTING
          TEXTLINE1 = 'Jumlah panjang aktual dan sisa panjang tidak boleh'
          TEXTLINE2 = 'melebihi panjang batch inputan'.
      DERROR = 1.
    ENDIF.
  ENDIF.

  CHECK DERROR IS INITIAL.
  IF IT_INPT IS NOT INITIAL.
    IF FTXTPJ IS INITIAL.
      MOVE ZLENGTH TO FTXTPJ.
    ENDIF.

    CHECK DERROR IS INITIAL.
    IF FTXTLBR IS NOT INITIAL.
      IF FTXTLBR GT DWIDTH.
        CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
          EXPORTING
            TEXTLINE1 = 'Jumlah lebar aktual lebih besar dari jumlah lebar batch inputan'.
        DERROR = 1.
      ENDIF.
    ELSE.
      IF ZWIDTH GT DWIDTH.
        CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
          EXPORTING
            TEXTLINE1 = 'Jumlah lebar planning lebih besar dari jumlah lebar batch inputan'.
        DERROR = 1.
      ENDIF.
    ENDIF.
  ENDIF.


  CHECK DERROR IS INITIAL.
  CHECK AUFK-AUART = 'ZP09' OR AUFK-AUART = 'ZTRD'.
  CLEAR : IT_FILM. REFRESH : IT_FILM.
  IT_FILM[] = IT_INPT[].
  SORT IT_FILM BY TFILM.
  DELETE ADJACENT DUPLICATES FROM IT_FILM COMPARING TFILM.
  DELETE IT_FILM WHERE PLNBEZ IS INITIAL.

  IF IT_FILM[] IS NOT INITIAL.
    LOOP AT IT_FILM WHERE PLNBEZ IS NOT INITIAL.
      CLEAR STOT.
      LOOP AT IT_INPT WHERE TFILM = IT_FILM-TFILM.
        STOT = STOT + ( IT_INPT-OLENGTH - IT_INPT-SPJG ).
      ENDLOOP.

      CONDENSE IT_FILM-TFILM.
      IF FTXTPJ GT STOT.
        CLEAR DMESSAGE.
        CONCATENATE 'Panjang untuk tipe film' IT_FILM-TFILM 'kurang dari panjang aktual' INTO DMESSAGE SEPARATED BY SPACE.
        CALL FUNCTION 'POPUP_TO_DISPLAY_TEXT'
          EXPORTING
            TEXTLINE1 = DMESSAGE(70)
            TEXTLINE2 = DMESSAGE+70.
        DERROR = 1.
      ENDIF.
      IF DERROR = 1.
        EXIT.
      ENDIF.
    ENDLOOP.
  ENDIF.
ENDFORM.                    "VLD_LENGTH

