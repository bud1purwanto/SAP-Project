FORM VLD_ERR USING ZMSG.
  LSEQ = LSEQ + 1.
  LMSG-MSGID = '00'.
  LMSG-MSGTY = 'E'.
  LMSG-MSGNO = '1'.
  MOVE ZMSG TO LMSG-MSGV1.
  MOVE ZMSG+50 TO LMSG-MSGV2.
  MOVE LSEQ TO LMSG-LINENO.
  APPEND LMSG.
  DERROR = 1.
ENDFORM.                    "VLD_ERR

*&---------------------------------------------------------------------*
*&      Form  MIGO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZAUFNR     text
*----------------------------------------------------------------------*
FORM MIGO USING ZAUFNR.
  DATA : ZMATDOC LIKE BAPI2017_GM_HEAD_RET-MAT_DOC,
         ZMATYEAR LIKE BAPI2017_GM_HEAD_RET-DOC_YEAR.

  CLEAR : ZGHEAD, ZGITEM, ZBRETURN.
  REFRESH : ZGHEAD, ZGITEM, ZBRETURN.
  ZGHEAD-PSTNG_DATE = SY-DATUM.
  ZGHEAD-DOC_DATE = SY-DATUM.
  APPEND ZGHEAD.

  LOOP AT ZMIGO WHERE BATCH IS NOT INITIAL.
    MOVE ZMIGO-MATERIAL TO ZGITEM-MATERIAL.
    MOVE ZMIGO-PLANT TO ZGITEM-PLANT.
    MOVE ZMIGO-STGE_LOC TO ZGITEM-STGE_LOC.
    MOVE ZMIGO-BATCH TO ZGITEM-BATCH.
    MOVE ZMIGO-MOVE_TYPE TO ZGITEM-MOVE_TYPE.
    MOVE ZMIGO-ENTRY_QNT TO ZGITEM-ENTRY_QNT.
    MOVE ZMIGO-ENTRY_UOM TO ZGITEM-ENTRY_UOM.
    MOVE ZMIGO-MOVE_STLOC TO ZGITEM-MOVE_STLOC.
    ZGITEM-ORDERID = ZAUFNR.
    APPEND ZGITEM.
  ENDLOOP.

  LOOP AT ZMIGO WHERE MOVE_TYPE = '531'.
    MOVE ZMIGO-MATERIAL TO ZGITEM-MATERIAL.
    MOVE ZMIGO-PLANT TO ZGITEM-PLANT.
    MOVE ZMIGO-STGE_LOC TO ZGITEM-STGE_LOC.
    MOVE ZMIGO-BATCH TO ZGITEM-BATCH.
    MOVE ZMIGO-MOVE_TYPE TO ZGITEM-MOVE_TYPE.
    MOVE ZMIGO-ENTRY_QNT TO ZGITEM-ENTRY_QNT.
    MOVE ZMIGO-ENTRY_UOM TO ZGITEM-ENTRY_UOM.
    MOVE ZMIGO-MOVE_STLOC TO ZGITEM-MOVE_STLOC.
    ZGITEM-ORDERID = ZAUFNR.
    APPEND ZGITEM.
  ENDLOOP.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
    EXPORTING
      GOODSMVT_HEADER  = ZGHEAD
      GOODSMVT_CODE    = '03'
    IMPORTING
      MATERIALDOCUMENT = ZMATDOC
      MATDOCUMENTYEAR  = ZMATYEAR
    TABLES
      GOODSMVT_ITEM    = ZGITEM
      RETURN           = ZBRETURN.

  IF ZMATDOC IS NOT INITIAL.
    PERFORM BAPI_COMMIT.
    ZAFWI-MBLNR = ZMATDOC.
    ZAFWI-MJAHR = ZMATYEAR.
    APPEND ZAFWI.
  ELSE.
    PERFORM BAPI_ROLLBACK.
  ENDIF.

  PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
***********************************************
  PERFORM COMMIT.
ENDFORM.                    "MIGO

*&---------------------------------------------------------------------*
*&      Form  GET_STAT_ORDER
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZOBJNR     text
*      -->ZAUFNR     text
*      -->ZSTAT      text
*----------------------------------------------------------------------*
FORM GET_STAT_ORDER USING ZOBJNR ZAUFNR CHANGING ZSTAT.
  DATA : DSTTXT LIKE BSVX-STTXT,
         VPSMNG LIKE AFPO-PSMNG,
         VWEMNG LIKE AFPO-WEMNG.

  CALL FUNCTION 'AIP9_STATUS_READ'
    EXPORTING
      I_OBJNR = ZOBJNR
    IMPORTING
      E_SYSST = DSTTXT.

  IF DSTTXT CP '*PCNF*' OR DSTTXT CP '*PDLV*' OR DSTTXT CP '*GMPS*'.
    ZSTAT = 'In Progress'.
  ELSEIF DSTTXT CP '*CRTD*' OR DSTTXT CP '*REL*'.
    ZSTAT = 'Created'.
  ENDIF.

  IF ZAUFNR IS NOT INITIAL.
    SELECT SINGLE PSMNG WEMNG
      INTO (VPSMNG,VWEMNG)
    FROM AFPO
      WHERE AUFNR = ZAUFNR.

    IF VPSMNG LE VWEMNG.
      ZSTAT = 'Completed'.
    ENDIF.
  ENDIF.
ENDFORM.                    "GET_STAT_ORDER

*&---------------------------------------------------------------------*
*&      Form  REV_GDSMVT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMATNR     text
*      -->ZBATCH     text
*      -->ZWERKS     text
*      -->ZAUFNR     text
*      -->ZNIK       text
*----------------------------------------------------------------------*
FORM REV_GDSMVT USING ZMATNR ZBATCH ZWERKS ZAUFNR ZNIK.
  DATA : ZATWTB LIKE CLBATCH-ATWTB,
         ZATWRT LIKE CAWN-ATWRT,
         DSLOC LIKE MSEG-LGORT,
         DSLOCR LIKE MSEG-LGORT,
         ZMBLNR LIKE MSEG-MBLNR,
         ZMJAHR LIKE MSEG-MJAHR.

  DATA : BEGIN OF TMSEG OCCURS 0,
            MBLNR LIKE MSEG-MBLNR,
            MJAHR LIKE MSEG-MJAHR,
            BUDAT_MKPF LIKE MSEG-BUDAT_MKPF,
         END OF TMSEG.

  REFRESH TMPMSEG.

  "Cancel Mat to Mat when Reserve
  IF BSTATUS IS NOT INITIAL.
    IF ZAFWI_MTM[] IS NOT INITIAL.
      DELETE ADJACENT DUPLICATES FROM ZAFWI_MTM COMPARING MBLNR MJAHR.
      APPEND LINES OF ZAFWI_MTM TO ZAFWI.
    ENDIF.
  ENDIF.

  IF LINES( ZAFWI ) > 0.
    SELECT DISTINCT MBLNR MJAHR MATNR UMMAT WERKS LGORT MENGE CHARG BWART AUFNR PARENT_ID BUDAT_MKPF
      INTO CORRESPONDING FIELDS OF TABLE TMPMSEG
    FROM MSEG
      FOR ALL ENTRIES IN ZAFWI
    WHERE MBLNR = ZAFWI-MBLNR AND
          MJAHR = ZAFWI-MJAHR.

    CLEAR : GSLOC, SCRLOC, WSLOC, SLOCGB, ZATWTB.
    PERFORM VBGETDET USING ZMATNR ZBATCH ZWERKS 'ZZPRODLINE' CHANGING ZATWTB.
    PERFORM GT_CHR_VAL USING ZATWTB 'ZZPRODLINE' CHANGING ZATWRT.
    SELECT SINGLE ZNALGORT ZJRLGORT ZWPLGORT ZRRLGORT
      INTO (GSLOC,SCRLOC, WSLOC, SLOCGB)
    FROM ZTMAP_SLOCRR
      WHERE ZLINE = ZATWRT.

    SORT TMPMSEG BY MBLNR MJAHR.
    DELETE ADJACENT DUPLICATES FROM TMPMSEG COMPARING MBLNR MJAHR.

    CLEAR: R_AUFNR_MTM.
    REFRESH: R_AUFNR_MTM.
    SELECT AUFNR AS LOW INTO CORRESPONDING FIELDS OF R_AUFNR_MTM
      FROM AUFK
       FOR ALL ENTRIES IN TMPMSEG
     WHERE AUFNR EQ TMPMSEG-AUFNR
       AND AUART EQ 'ZMMS'.
      R_AUFNR_MTM-SIGN = 'I'.
      R_AUFNR_MTM-OPTION = 'EQ'.
      APPEND R_AUFNR_MTM.
    ENDSELECT.

    "Cancel Mat to Mat Sort Last Cancel
    DATA: TMPMSEG_MTM LIKE STANDARD TABLE OF MSEG WITH HEADER LINE.
    TMPMSEG_MTM[] = TMPMSEG[].
    DELETE TMPMSEG WHERE AUFNR IN R_AUFNR_MTM.
    DELETE TMPMSEG_MTM WHERE AUFNR NOT IN R_AUFNR_MTM.
    "Additional for Rollback Mat to Mat
    SORT TMPMSEG_MTM BY MBLNR DESCENDING MJAHR DESCENDING.
    APPEND LINES OF TMPMSEG_MTM TO TMPMSEG.
    "Mat to Mat Backposting
    IF V_DIFF_MONTH EQ 'X'.
      TMPMSEG-BUDAT_MKPF = SY-DATUM.
      MODIFY TMPMSEG TRANSPORTING BUDAT_MKPF WHERE BUDAT_MKPF IS NOT INITIAL.
    ENDIF.

    IF ZAUFNR IS NOT INITIAL.
*  CANCEL SCRAP/NA************************************************************
      DATA : DDATE TYPE C LENGTH 10.
      CONCATENATE SY-DATUM+6(2) '.' SY-DATUM+4(2) '.' SY-DATUM(4) INTO DDATE.

      LOOP AT TMPMSEG WHERE CHARG IS NOT INITIAL AND AUFNR NE ZAUFNR.
        CLEAR : ZATWTB, DAUART.
        SELECT SINGLE AUART INTO DAUART
          FROM AUFK
        WHERE AUFNR = TMPMSEG-AUFNR AND
              AUART IN ('ZRR1','ZRR2').

        PERFORM COMMIT.
        CHECK DAUART IS NOT INITIAL.
        PERFORM VBGETDET USING TMPMSEG-MATNR TMPMSEG-CHARG TMPMSEG-WERKS 'ZZGRADEJR' CHANGING ZATWTB.
        PERFORM GT_CHR_VAL USING ZATWTB 'ZZGRADEJR' CHANGING ZATWTB.
        IF ZATWTB EQ 'NK'." AND ZATWTB IS NOT INITIAL.
          PERFORM CCL_ZPP019 USING TMPMSEG-AUFNR TMPMSEG-WERKS TMPMSEG-CHARG DDATE ZNIK.
          DELETE TMPMSEG WHERE AUFNR = TMPMSEG-AUFNR.
        ENDIF.
      ENDLOOP.
    ENDIF.

    "Mat to Mat add MVT Cancel Posting Date based on Mat to Mat date
    LOOP AT TMPMSEG WHERE BWART = '311'.
      CLEAR : ZBRETURN, DAUART. REFRESH : ZBRETURN.
      SELECT SINGLE AUART INTO DAUART
        FROM AUFK
      WHERE AUFNR = TMPMSEG-AUFNR AND
            AUART IN ('ZRR1','ZRR2').

      IF DAUART IS NOT INITIAL.
        CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
          EXPORTING
            MATERIALDOCUMENT    = TMPMSEG-MBLNR
            MATDOCUMENTYEAR     = TMPMSEG-MJAHR
            GOODSMVT_PSTNG_DATE = TMPMSEG-BUDAT_MKPF
          TABLES
            RETURN              = ZBRETURN.
        PERFORM BAPI_COMMIT.
        PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
      ELSE.
        TMSEG-MBLNR = TMPMSEG-MBLNR.
        TMSEG-MJAHR = TMPMSEG-MJAHR.
        TMSEG-BUDAT_MKPF = TMPMSEG-BUDAT_MKPF.
        APPEND TMSEG.
      ENDIF.
    ENDLOOP.

    LOOP AT TMSEG.
      CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
        EXPORTING
          MATERIALDOCUMENT    = TMSEG-MBLNR
          MATDOCUMENTYEAR     = TMSEG-MJAHR
          GOODSMVT_PSTNG_DATE = TMSEG-BUDAT_MKPF
        TABLES
          RETURN              = ZBRETURN.
      PERFORM BAPI_COMMIT.
      PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
    ENDLOOP.

    "Mat to Mat Price Change when different price
    IF R_AUFNR_MTM[] IS NOT INITIAL.
      LOOP AT TMPMSEG WHERE AUFNR IN R_AUFNR_MTM.
        CALL FUNCTION 'ZCO_PRICE_CHANGE'
          EXPORTING
            MBLNR   = TMPMSEG-MBLNR
            MJAHR   = TMPMSEG-MJAHR
            CANC    = 'X'
          TABLES
            MESSAGE = ZBRETURN.
        PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
      ENDLOOP.
    ENDIF.

    CHECK DSTATUS NE 'E'.

    REFRESH : TMSEG.
    LOOP AT TMPMSEG WHERE BWART NE '311' AND BWART NE '101'.
      CLEAR : ZBRETURN, DAUART. REFRESH : ZBRETURN.
      SELECT SINGLE AUART INTO DAUART
        FROM AUFK
      WHERE AUFNR = TMPMSEG-AUFNR AND
            AUART IN ('ZRR1','ZRR2').

      IF DAUART IS NOT INITIAL.
        CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
          EXPORTING
            MATERIALDOCUMENT    = TMPMSEG-MBLNR
            MATDOCUMENTYEAR     = TMPMSEG-MJAHR
            GOODSMVT_PSTNG_DATE = TMPMSEG-BUDAT_MKPF
          TABLES
            RETURN              = ZBRETURN.
        PERFORM BAPI_COMMIT.
        PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
      ELSE.
        TMSEG-MBLNR = TMPMSEG-MBLNR.
        TMSEG-MJAHR = TMPMSEG-MJAHR.
        TMSEG-BUDAT_MKPF = TMPMSEG-BUDAT_MKPF.
        APPEND TMSEG.
      ENDIF.
    ENDLOOP.

    LOOP AT TMSEG.
      CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
        EXPORTING
          MATERIALDOCUMENT    = TMSEG-MBLNR
          MATDOCUMENTYEAR     = TMSEG-MJAHR
          GOODSMVT_PSTNG_DATE = TMSEG-BUDAT_MKPF
        TABLES
          RETURN              = ZBRETURN.
      PERFORM BAPI_COMMIT.
      PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
    ENDLOOP.
  ENDIF.

  "Mat to Mat Price Change when different price set to default
  IF R_AUFNR_MTM[] IS NOT INITIAL.
    LOOP AT TMPMSEG WHERE AUFNR IN R_AUFNR_MTM.
      CALL FUNCTION 'ZCO_PRICE_CHANGE'
        EXPORTING
          MBLNR   = TMPMSEG-MBLNR
          MJAHR   = TMPMSEG-MJAHR
        TABLES
          MESSAGE = ZBRETURN.
      PERFORM CHK_ER USING '' 'ZBRETURN' CHANGING DSTATUS.
    ENDLOOP.
  ENDIF.

ENDFORM.                    "REV_GDSMVT

