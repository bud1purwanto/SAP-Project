      FROM AFRU
    WHERE LTXA1 = ZZMSEGD-MBLNR AND
          RUECK = ZRUECK.

    IF SY-SUBRC = 0.
      CALL FUNCTION 'BAPI_PROCORDCONF_CANCEL'
        EXPORTING
          CONFIRMATION        = ZRUECK
          CONFIRMATIONCOUNTER = COUNTER
          POSTG_DATE          = SY-DATUM
          CONF_TEXT           = ZREASON
