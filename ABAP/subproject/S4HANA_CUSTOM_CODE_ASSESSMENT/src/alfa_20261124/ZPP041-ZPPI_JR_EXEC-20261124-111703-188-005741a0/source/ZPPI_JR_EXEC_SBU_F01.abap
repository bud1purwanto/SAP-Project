  PERFORM BDC_DYNPRO      USING 'SAPLCHRG' '1000'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=SNST'.

  PERFORM BDC_DYNPRO      USING 'SAPLCHRG' '1000'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=CLAS'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'DFBATCH-KZTXT'.
  PERFORM BDC_FIELD       USING 'DFBATCH-KZTXT'
                                ZWINDER.

  PERFORM BDC_DYNPRO      USING 'SAPLCHRG' '1000'.
