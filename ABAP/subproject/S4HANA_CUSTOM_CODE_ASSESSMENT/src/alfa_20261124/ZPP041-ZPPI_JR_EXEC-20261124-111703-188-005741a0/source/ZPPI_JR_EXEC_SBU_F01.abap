*&---------------------------------------------------------------------*
*&      Form  F_LEPAS_CORE_RTP
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_BATCH    text
*      -->P_DWERKS   text
*----------------------------------------------------------------------*
FORM F_LEPAS_CORE_RTP USING P_BATCH P_DWERKS.
  DATA: LT_ZCORER LIKE STANDARD TABLE OF ZCORER WITH HEADER LINE,
        WA_ZCORER LIKE LINE OF LT_ZCORER,
        WA_ZCORER2 LIKE LINE OF LT_ZCORER,
        LV_MAX_SEQ LIKE ZCORER-SEQNO,
        LV_TERMINAL LIKE ZCORER-ZUSER,
        LV_IP LIKE USR41-TERMINAL.

  IF P_BATCH IS INITIAL.
    RETURN.
  ENDIF.

  CALL FUNCTION 'TERMINAL_ID_GET'
    EXPORTING
      USERNAME             = SY-UNAME
    IMPORTING
      TERMINAL             = LV_IP
    EXCEPTIONS
      MULTIPLE_TERMINAL_ID = 1
      NO_TERMINAL_FOUND    = 2
      OTHERS               = 3.

  CONCATENATE: SY-UNAME ';' LV_IP INTO LV_TERMINAL.

  "Step 1: Cek apakah Roll sudah terikat dengan Core RTP
*  SELECT MAX( SEQNO ) INTO LV_MAX_SEQ FROM ZCORER WHERE CHARG = P_BATCH.
  SELECT MAX( SEQNO ) INTO LV_MAX_SEQ FROM ZCORER WHERE CHARG = P_BATCH AND WERKS = P_DWERKS. "Change by Jarwo 16.07.2019
  IF LV_MAX_SEQ > 0.
    CLEAR: LT_ZCORER, WA_ZCORER, WA_ZCORER2.
    REFRESH: LT_ZCORER.

    SELECT SINGLE * INTO WA_ZCORER FROM ZCORER WHERE SEQNO = LV_MAX_SEQ.
    IF SY-SUBRC = 0.
*      SELECT SINGLE * INTO WA_ZCORER2 FROM ZCORER WHERE COREID = WA_ZCORER-COREID AND CHARG = 'MASTER'.
      SELECT SINGLE * INTO WA_ZCORER2 FROM ZCORER WHERE COREID = WA_ZCORER-COREID AND CHARG = 'MASTER' AND WERKS = P_DWERKS. "Change by Jarwo 16.07.2019
      IF SY-SUBRC = 0.
        "Cek status terakhir dari Core
        IF WA_ZCORER2-STATUS = 'R' OR WA_ZCORER2-STATUS = 'B'.
          "Cek batch terakhir yang terikat Core ID tersebut.
          SELECT * INTO CORRESPONDING FIELDS OF TABLE LT_ZCORER UP TO 1 ROWS
          FROM ZCORER
          WHERE
            COREID = WA_ZCORER2-COREID AND
            CHARG <> 'MASTER' AND
            CHARG <> '' AND
            WERKS = P_DWERKS  "Add by Jarwo 16.07.2019
          ORDER BY SEQNO DESCENDING.

          "Ambil Batch terakhir dr Core ID yg bersangkutan.
          READ TABLE LT_ZCORER INDEX 1.

          "Cek apakah Batch yang akan di-Cancel sama dengan Batch terakhir yang terikat Core ID.
          "Jika maka perlu dilepas.
          IF LT_ZCORER-CHARG = P_BATCH.
            CLEAR: LV_MAX_SEQ.
            SELECT MAX( SEQNO ) INTO LV_MAX_SEQ FROM ZCORER.

            WA_ZCORER-SEQNO = LV_MAX_SEQ + 1.
            WA_ZCORER-COREID = LT_ZCORER-COREID.
            WA_ZCORER-CHARG = ''.
            WA_ZCORER-STATUS = 'U'.
            WA_ZCORER-ERSDA = SY-DATUM.
            WA_ZCORER-ERZET = SY-UZEIT.
            WA_ZCORER-ZUSER = LV_TERMINAL.
            WA_ZCORER-REMARK = 'Cancel JR.'.

            MODIFY ZCORER FROM WA_ZCORER.
            COMMIT WORK.

            CLEAR: WA_ZCORER.
*            SELECT SINGLE * INTO WA_ZCORER FROM ZCORER WHERE COREID = LT_ZCORER-COREID AND CHARG = 'MASTER'.
            SELECT SINGLE * INTO WA_ZCORER FROM ZCORER WHERE COREID = LT_ZCORER-COREID AND CHARG = 'MASTER' AND WERKS = P_DWERKS. "Change by Jarwo 16.07.2019
            WA_ZCORER-STATUS = 'U'.
            WA_ZCORER-ERSDA = SY-DATUM.
            WA_ZCORER-ERZET = SY-UZEIT.
            WA_ZCORER-ZUSER = LV_TERMINAL.
            MODIFY ZCORER FROM WA_ZCORER.
            COMMIT WORK.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
  ENDIF.
ENDFORM.                    "F_LEPAS_CORE_RTP


*&---------------------------------------------------------------------*
*&      Form  GET_DIFFERENT_PERIOD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ROLL       text
*      -->DIFF       text
*----------------------------------------------------------------------*
FORM GET_DIFFERENT_PERIOD USING ROLL.
  REFRESH: ZZMSEG, ZZMSEGD.
  CLEAR: ZZMSEG, ZZMSEGD, V_DIFF_MONTH.

  DATA: V_ANSWER.

  SELECT DISTINCT MSEG~MBLNR MSEG~MJAHR SMBLN BWART BUDAT_MKPF
    INTO CORRESPONDING FIELDS OF TABLE ZZMSEG
    FROM MSEG
    JOIN MKPF ON MKPF~MBLNR EQ MSEG~MBLNR AND MKPF~MJAHR EQ MSEG~MJAHR
   WHERE BKTXT = ROLL
     AND BWART IN ('101','102','261','262','531','532','311','312','901','902').

  ZZMSEGD[] = ZZMSEG[].
  DELETE ZZMSEGD WHERE SMBLN IS INITIAL.
  LOOP AT ZZMSEGD.
    DELETE ZZMSEG WHERE MBLNR EQ ZZMSEGD-SMBLN AND MJAHR EQ ZZMSEGD-SJAHR.
  ENDLOOP.
  DELETE ZZMSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '102'.
  DELETE ZZMSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '262'.
  DELETE ZZMSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '532'.
  DELETE ZZMSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '312'.
  DELETE ZZMSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '902'.
  DELETE ZZMSEG WHERE SMBLN IS NOT INITIAL OR BWART EQ '994'.

  READ TABLE ZZMSEG INDEX 1.
  IF SY-SUBRC EQ 0.
    CALL FUNCTION 'MONTHS_BETWEEN_TWO_DATES'
      EXPORTING
        I_DATUM_BIS = ZZMSEG-BUDAT_MKPF
        I_DATUM_VON = SY-DATUM
      IMPORTING
        E_MONATE    = V_DIFF_MONTH.
  ENDIF.

  IF V_DIFF_MONTH NE '0'.
    CALL FUNCTION 'POPUP_TO_CONFIRM'
      EXPORTING
        TITLEBAR              = 'Confirmation'
        TEXT_QUESTION         = 'Cancellation of different month, are you sure want to execute?'
        TEXT_BUTTON_1         = 'Yes'
        TEXT_BUTTON_2         = 'No'
        DEFAULT_BUTTON        = '2'
        DISPLAY_CANCEL_BUTTON = ''
      IMPORTING
        ANSWER                = V_ANSWER.

    IF V_ANSWER = 1.
      V_DIFF_MONTH = 'X'.
    ELSE.
      LEAVE SCREEN.
    ENDIF.
  ENDIF.
ENDFORM.                    "GET_DIFFERENT_PERIOD

*&---------------------------------------------------------------------*
*&      Form  ADDITIONAL_CKI
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM ADDITIONAL_CKI USING ZPLANT.
  DATA: IT_MAPPING LIKE ZMAP_TYPE OCCURS 0 WITH HEADER LINE,
        IT_CHAR LIKE ZMAP_TYPE OCCURS 0 WITH HEADER LINE.
  DATA: LOTNUMB TYPE I VALUE 0,
        LOTNUMB2 TYPE I VALUE 1,
        LOTNUMB_J_SUB TYPE I VALUE 0,
        LOTNUMB_J_TEMP TYPE STRING,
        LOTNUMB_J_PRT TYPE I VALUE 1,
        V_PREVMATNR TYPE AFKO-PLNBEZ,
        V_MAXJOIN TYPE I VALUE 3,
        V_MAXLAYER TYPE I VALUE 3,
        LOTCHAR TYPE ATNAM VALUE 'ZZNOLOTSUBCONT',
        LOTCHAR_COUNT TYPE ATNAM,
        LOTCHAR_COUNT_J TYPE ATNAM,
        LOTVAL  TYPE ATWRT,
        V_ATWRT TYPE ATWRT,
        V_MATKL TYPE MATKL,
        V_COUNT_PRINT TYPE I.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MAPPING
    FROM ZMAP_TYPE
   WHERE TCODE    EQ SY-TCODE
     AND TYPE     EQ 'MATERIAL GROUP'
     AND OPT      EQ 'SUBCONTRACTING'
     AND DELETION EQ ''.

  IF IT_MAPPING[] IS INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MAPPING
      FROM ZMAP_TYPE
     WHERE PROG     EQ SY-CPROG
       AND TYPE     EQ 'MATERIAL GROUP'
       AND OPT      EQ 'SUBCONTRACTING'
       AND DELETION EQ ''.
  ENDIF.

  IF IT_MAPPING[] IS INITIAL.
    EXIT.
  ENDIF.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_CHAR
    FROM ZMAP_TYPE
   WHERE TCODE    EQ SY-TCODE
     AND TYPE     EQ 'CHARACTERISTIC'
     AND OPT      EQ 'SUBCONTRACTING'
     AND DELETION EQ ''.

  IF IT_CHAR[] IS INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_CHAR
    FROM ZMAP_TYPE
   WHERE PROG     EQ SY-CPROG
     AND TYPE     EQ 'CHARACTERISTIC'
     AND OPT      EQ 'SUBCONTRACTING'
     AND DELETION EQ ''.
  ENDIF.

  CLEAR: V_COUNT_PRINT.
  SORT RE_INPT BY PLNBEZ.
  LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL .
    CLEAR: V_MATKL, V_ATWRT, LOTNUMB, LOTVAL.

    "Get Material group inputan
    IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
      SELECT SINGLE MATKL INTO V_MATKL FROM MARA WHERE MATNR EQ RE_INPT-MATNR_ASAL.
    ELSE.
      SELECT SINGLE MATKL INTO V_MATKL FROM MARA WHERE MATNR EQ RE_INPT-PLNBEZ.
    ENDIF.

    "Check value same or not
    READ TABLE IT_MAPPING WITH KEY VALUE = V_MATKL.
    IF SY-SUBRC NE 0.
      CONTINUE.
    ENDIF.


    IF V_PREVMATNR IS INITIAL.
      V_PREVMATNR = RE_INPT-PLNBEZ.
    ENDIF.

    IF V_PREVMATNR NE RE_INPT-PLNBEZ.
      IF IT_MAPPING-TEXT1 IS NOT INITIAL AND IT_MAPPING-TEXT5 EQ 'PRINTING'.
      ELSE.
        ADD 1 TO LOTNUMB2.
        CLEAR : LOTNUMB_J_SUB.
      ENDIF.
    ENDIF.

    LOTNUMB = 0.
    DO 9 TIMES.
      CLEAR: V_ATWRT, LOTVAL.
      CLEAR: LOTNUMB_J_TEMP.

      "Check no lot inputan
      ADD 1 TO LOTNUMB.
      IF LOTNUMB GT 1.
        LOTCHAR_COUNT = LOTCHAR && LOTNUMB.
      ELSE.
        LOTCHAR_COUNT = LOTCHAR.
      ENDIF.

      "Check Value
      IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
        PERFORM VBGETDET USING RE_INPT-MATNR_ASAL RE_INPT-CHARG_ASAL ZPLANT LOTCHAR_COUNT CHANGING V_ATWRT.
      ELSE.
        PERFORM VBGETDET USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT LOTCHAR_COUNT CHANGING V_ATWRT.
      ENDIF.
      IF V_ATWRT IS NOT INITIAL.
        LOTVAL = V_ATWRT.
      ENDIF.

      CLEAR: ZCHAR-VALUE_CHAR.
      IF LOTVAL IS NOT INITIAL.
        ADD 1 TO LOTNUMB_J_SUB.
        "Check mapping, fill No Lot 1 on Output
        IF IT_MAPPING-TEXT1 IS NOT INITIAL AND IT_MAPPING-TEXT5 EQ 'PRINTING'.
          ADD 1 TO V_COUNT_PRINT.
          IF V_COUNT_PRINT EQ 1.
            LOTCHAR_COUNT_J = LOTCHAR.
          ELSEIF  V_COUNT_PRINT GT 1.
            LOTNUMB_J_PRT = ( V_MAXJOIN * V_COUNT_PRINT ) - 2.
            LOTCHAR_COUNT_J = LOTCHAR &&  LOTNUMB_J_PRT.
          ENDIF.
        ELSE.
          LOTNUMB_J_TEMP = V_MAXJOIN - LOTNUMB2.
          IF LOTNUMB_J_SUB EQ 1.
            LOTCHAR_COUNT_J = LOTCHAR && LOTNUMB2.
          ELSE.
            LOTNUMB_J_TEMP   = ( V_MAXJOIN * LOTNUMB_J_SUB ) - LOTNUMB_J_TEMP .
            LOTCHAR_COUNT_J = LOTCHAR && LOTNUMB_J_TEMP(1).
          ENDIF.
        ENDIF.

        "Check char output of lot exist or not
        SELECT SINGLE ATNAM INTO ZCHAR-CHARACT FROM CABN WHERE ATNAM EQ LOTCHAR_COUNT_J.
        IF SY-SUBRC EQ 0.
          V_PREVMATNR = RE_INPT-PLNBEZ.

          ZCHAR-VALUE_CHAR = LOTVAL.
          ZCHAR-CHARACT = LOTCHAR_COUNT_J.
          APPEND ZCHAR.
        ENDIF.
      ENDIF.
    ENDDO.

    IF IT_CHAR[] IS INITIAL.
      EXIT.
    ENDIF.

    "Duplicate characteristic from input
    LOOP AT IT_CHAR.
      READ TABLE ZCHAR WITH KEY CHARACT = IT_CHAR-VALUE.
      IF SY-SUBRC NE 0.
        CLEAR: ZCHAR-VALUE_CHAR.
        PERFORM VBGETDET USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT IT_CHAR-VALUE CHANGING ZCHAR-VALUE_CHAR.
        IF ZCHAR-VALUE_CHAR IS NOT INITIAL.
          "Char with mark check with matgroup with mark (ex: SKU fill from Printing)
          IF IT_CHAR-TEXT3 IS NOT INITIAL AND IT_CHAR-TEXT3 NE IT_MAPPING-TEXT3.
            CONTINUE.
          ENDIF.
          ZCHAR-CHARACT = IT_CHAR-VALUE.
          APPEND ZCHAR.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDLOOP.

  CLEAR: LOTNUMB, LOTCHAR, LOTCHAR_COUNT.

  LOTCHAR = 'ZZSPLICE-'.

  LOOP AT IT_JOIN WHERE JOINT1 IS NOT INITIAL OR JOINT2 IS NOT INITIAL OR JOINT3 IS NOT INITIAL.
    ADD 1 TO LOTNUMB.

    LOTCHAR_COUNT = LOTCHAR && LOTNUMB.
    READ TABLE ZCHAR WITH KEY CHARACT = LOTCHAR_COUNT.
    IF SY-SUBRC NE 0.
      ZCHAR-CHARACT    = LOTCHAR_COUNT.

      IF IT_JOIN-JOINT1 IS NOT INITIAL.
        ZCHAR-VALUE_CHAR = IT_JOIN-JOINT1.
      ELSEIF IT_JOIN-JOINT2 IS NOT INITIAL.
        ZCHAR-VALUE_CHAR = IT_JOIN-JOINT2.
      ELSEIF IT_JOIN-JOINT3 IS NOT INITIAL.
        ZCHAR-VALUE_CHAR = IT_JOIN-JOINT3.
      ENDIF.

      APPEND ZCHAR.
    ENDIF.

*    "Insert Join 1 to Characteristic JR
*    IF IT_JOIN-JOINT1 IS NOT INITIAL.
*      READ TABLE ZCHAR WITH KEY CHARACT = 'ZZSPLICE-1'.
*      IF SY-SUBRC NE 0.
*        ZCHAR-CHARACT    = 'ZZSPLICE-1'.
*        ZCHAR-VALUE_CHAR = IT_JOIN-JOINT1.
*        APPEND ZCHAR.
*      ENDIF.
*    ENDIF.
*
*    "Insert Join 2 to Characteristic JR
*    IF IT_JOIN-JOINT2 IS NOT INITIAL.
*      READ TABLE ZCHAR WITH KEY CHARACT = 'ZZSPLICE-2'.
*      IF SY-SUBRC NE 0.
*        ZCHAR-CHARACT    = 'ZZSPLICE-2'.
*        ZCHAR-VALUE_CHAR = IT_JOIN-JOINT2.
*        APPEND ZCHAR.
*      ENDIF.
*    ENDIF.
*
*    "Insert Join 3 to Characteristic JR
*    IF IT_JOIN-JOINT3 IS NOT INITIAL.
*      READ TABLE ZCHAR WITH KEY CHARACT = 'ZZSPLICE-3'.
*      IF SY-SUBRC NE 0.
*        ZCHAR-CHARACT    = 'ZZSPLICE-3'.
*        ZCHAR-VALUE_CHAR = IT_JOIN-JOINT3.
*        APPEND ZCHAR.
*      ENDIF.
*    ENDIF.
  ENDLOOP.
ENDFORM.                    "ADDITIONAL_CKI

