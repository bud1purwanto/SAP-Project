*&---------------------------------------------------------------------*
*&      Form  GDSMVT_SCRAP
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMATNR     text
*      -->ZQTY       text
*      -->ZCHARG     text
*      -->ZAUFNR     text
*      -->ZPLANT     text
*      -->ZSLOC      text
*      -->ZMLOC      text
*      -->ZLLOC      text
*      -->ZBATCH     text
*      -->ZSPJG      text
*      -->ZMATDOC    text
*      -->ZMATYEAR   text
*      -->SCMENGE    text
*      -->ZSCMATNR   text
*----------------------------------------------------------------------*
FORM GDSMVT_SCRAP USING ZMATNR ZQTY ZCHARG ZAUFNR ZPLANT ZSLOC ZMLOC ZLLOC ZBATCH ZSPJG CHANGING ZMATDOC ZMATYEAR SCMENGE ZSCMATNR.
  CLEAR : ZGHEAD, ZGITEM, ZBRETURN.
  REFRESH : ZGHEAD, ZGITEM, ZBRETURN.

  DATA : BEGIN OF T_AUFNR OCCURS 0,
           AUFNR LIKE MSEG-AUFNR,
           OBJNR LIKE AUFK-OBJNR,
           STTXT LIKE BSVX-STTXT,
         END OF T_AUFNR.

  DATA : BEGIN OF ZDSCRAP OCCURS 0,
           MBLNR LIKE MSEG-MBLNR,
           MJAHR LIKE MSEG-MJAHR,
           MENGE LIKE MSEG-MENGE,
           AUFNR LIKE MSEG-AUFNR,
           AUART LIKE AUFK-AUART,
           SMENGE TYPE P DECIMALS 3,
         END OF ZDSCRAP.

  DATA : ZDSCRAP2 LIKE STANDARD TABLE OF ZDSCRAP WITH HEADER LINE.

  DATA : TOTMENGE LIKE MSEG-MENGE,
         TEMPMENGE TYPE P DECIMALS 3,
         DSPJG TYPE C LENGTH 40,
         MATRR LIKE ZTMAP_MATRECYCLE-RAR_A_MATNR.

  DATA : VBWART LIKE MSEG-BWART.

  DATA: V_FDATE LIKE SY-DATUM,  "ADDED BY FATHIR ON 19.05.2021 - get PO by current month
        V_EDATE LIKE SY-DATUM.
  CLEAR: V_FDATE, V_EDATE.

  CALL FUNCTION 'OIL_MONTH_GET_FIRST_LAST' "ADDED BY FATHIR ON 19.05.2021 - get PO by current month
   EXPORTING
     I_MONTH           = SY-DATUM+4(2)
     I_YEAR            = SY-DATUM(4)
   IMPORTING
     E_FIRST_DAY       = V_FDATE  " first date of the month-year
     E_LAST_DAY        = V_EDATE  " end date of the month-year
   EXCEPTIONS
     WRONG_DATE        = 1
     OTHERS            = 2.

  IF AUFK-AUART = 'ZTR2' OR AUFK-AUART = 'ZTR4' OR AUFK-AUART = 'ZTR5' OR AUFK-AUART = 'ZTR6' OR AUFK-AUART = 'ZTRD'.
    VBWART = '901'.
  ELSE.
    VBWART = '261'.
  ENDIF.

  MOVE ZSPJG TO DSPJG.
  CONDENSE DSPJG.
  CONCATENATE ZAUFNR '-' DSPJG INTO DSPJG.

  "Mat to Mat Scrap
  IF RE_INPT-CHARG_ASAL IS INITIAL.
    SELECT SINGLE RAR_A_MATNR INTO MATRR
      FROM ZTMAP_MATRECYCLE
    WHERE MATNR = ZMATNR AND
          WERKS = ZPLANT.
  ELSE.
    SELECT SINGLE RAR_A_MATNR INTO MATRR
      FROM ZTMAP_MATRECYCLE
    WHERE MATNR = RE_INPT-MATNR_ASAL AND
          WERKS = ZPLANT.
  ENDIF.

******GET ORDER NO******************************
  SELECT DISTINCT AUFNR
    INTO CORRESPONDING FIELDS OF TABLE T_AUFNR
  FROM MSEG
    WHERE CHARG = ZCHARG AND
          SGTXT NE '' AND
          BWART IN ('261','901') AND
          BUDAT_MKPF BETWEEN V_FDATE AND V_EDATE. "ADDED BY FATHIR ON 19.05.2021 - get PO by current month
****GET OBJECT NO & STATUS****************************
  LOOP AT T_AUFNR.
    SELECT SINGLE OBJNR INTO T_AUFNR-OBJNR
      FROM AUFK
    WHERE AUFNR = T_AUFNR-AUFNR.

    CALL FUNCTION 'AIP9_STATUS_READ'
      EXPORTING
        I_OBJNR = T_AUFNR-OBJNR
      IMPORTING
        E_SYSST = T_AUFNR-STTXT.
    MODIFY T_AUFNR.
  ENDLOOP.
******DELETE WHERE STATUS = CLOSED********************
  DELETE T_AUFNR WHERE STTXT CP '*CLSD*'.

  ZGHEAD-PSTNG_DATE = AUFK-SDATE.
  ZGHEAD-DOC_DATE = AUFK-SDATE.
  APPEND ZGHEAD.

  TEMPMENGE = ZQTY.

  IF LINES( T_AUFNR ) > 0.
****GET ALL 101********************************
    SELECT MSEG~MBLNR MSEG~MJAHR MSEG~MENGE MSEG~AUFNR AUART
      INTO CORRESPONDING FIELDS OF TABLE ZDSCRAP
    FROM MKPF
      JOIN MSEG ON MSEG~MBLNR = MKPF~MBLNR AND
                   MSEG~MJAHR = MKPF~MJAHR
      JOIN AUFK ON AUFK~AUFNR = MSEG~AUFNR
      FOR ALL ENTRIES IN T_AUFNR
    WHERE MSEG~AUFNR = T_AUFNR-AUFNR AND
          BKTXT NE '' AND
          BWART = '101' AND
          AUART NOT IN ('ZTR01','ZTR02','ZTR03','ZTR04','ZTR05','ZTR06').

    SELECT MSEG~MBLNR MSEG~MJAHR MSEG~MENGE MSEG~AUFNR AUART "HANYA DIGUNAKAN MENGE-NYA SAJA
      INTO CORRESPONDING FIELDS OF TABLE ZDSCRAP2
    FROM MSEG
      JOIN AUFK ON AUFK~AUFNR = MSEG~AUFNR
    WHERE CHARG = ZBATCH AND
          BWART = '101' AND
          AUART NOT IN ('ZTR01','ZTR02','ZTR03','ZTR04','ZTR05','ZTR06').

    IF ZDSCRAP IS INITIAL AND ZDSCRAP2 IS INITIAL.
      SELECT MSEG~MBLNR MSEG~MJAHR MSEG~MENGE MSEG~AUFNR AUART "HANYA DIGUNAKAN MENGE-NYA SAJA
        INTO CORRESPONDING FIELDS OF TABLE ZDSCRAP2
      FROM MSEG
        JOIN AUFK ON AUFK~AUFNR = MSEG~AUFNR
      WHERE CHARG = ZBATCH AND
            BWART = '101'.
    ENDIF.
*  ***SUM MENGE*********
    LOOP AT ZDSCRAP.
      TOTMENGE = TOTMENGE + ZDSCRAP-MENGE.
    ENDLOOP.

    LOOP AT ZDSCRAP2.
      TOTMENGE = TOTMENGE + ZDSCRAP2-MENGE.
    ENDLOOP.

    LOOP AT ZDSCRAP.
      ZDSCRAP-SMENGE = ZDSCRAP-MENGE / TOTMENGE * ZQTY.
      MODIFY ZDSCRAP.
      TEMPMENGE = TEMPMENGE - ZDSCRAP-SMENGE.

      CLEAR : ZGITEM.
      MOVE ZMATNR TO ZGITEM-MATERIAL.
      MOVE ZPLANT TO ZGITEM-PLANT.
      MOVE ZSLOC TO ZGITEM-STGE_LOC.
      MOVE ZCHARG TO ZGITEM-BATCH.
      MOVE VBWART TO ZGITEM-MOVE_TYPE."'261' TO ZGITEM-MOVE_TYPE.
      MOVE ZDSCRAP-SMENGE TO ZGITEM-ENTRY_QNT.
      ZGITEM-ENTRY_UOM = 'KG'.
      MOVE ZDSCRAP-AUFNR TO ZGITEM-ORDERID.
*      ZGITEM-MVT_IND = 'F'.
      MOVE DSPJG TO ZGITEM-ITEM_TEXT.
      APPEND ZGITEM.

      CLEAR : ZGITEM.
      MOVE MATRR TO ZGITEM-MATERIAL.
      MOVE ZPLANT TO ZGITEM-PLANT.
      MOVE ZMLOC TO ZGITEM-STGE_LOC.
*      MOVE ZMLOC TO ZGITEM-MOVE_STLOC.
*      MOVE '' TO ZGITEM-BATCH.
      MOVE '531' TO ZGITEM-MOVE_TYPE.
      MOVE ZDSCRAP-SMENGE TO ZGITEM-ENTRY_QNT.
      ZGITEM-ENTRY_UOM = 'KG'.
      MOVE ZDSCRAP-AUFNR TO ZGITEM-ORDERID.
      MOVE DSPJG TO ZGITEM-ITEM_TEXT.
      APPEND ZGITEM.
    ENDLOOP.
  ENDIF.

  CLEAR : ZGITEM.
  MOVE ZMATNR TO ZGITEM-MATERIAL.
  MOVE ZPLANT TO ZGITEM-PLANT.
  MOVE ZSLOC TO ZGITEM-STGE_LOC.
  MOVE ZCHARG TO ZGITEM-BATCH.
  MOVE VBWART TO ZGITEM-MOVE_TYPE."'261' TO ZGITEM-MOVE_TYPE.
  MOVE TEMPMENGE TO ZGITEM-ENTRY_QNT.
  ZGITEM-ENTRY_UOM = 'KG'.
  MOVE ZAUFNR TO ZGITEM-ORDERID.
*  ZGITEM-MVT_IND = 'F'.
  MOVE DSPJG TO ZGITEM-ITEM_TEXT.
  APPEND ZGITEM.

  CLEAR : ZGITEM, DMESSAGE.
  MOVE MATRR TO ZGITEM-MATERIAL.
  MOVE MATRR TO ZSCMATNR.
  MOVE ZPLANT TO ZGITEM-PLANT.
  MOVE ZMLOC TO ZGITEM-STGE_LOC.
*  MOVE '' TO ZGITEM-BATCH.
*  MOVE ZMLOC TO ZGITEM-MOVE_STLOC.
  MOVE '531' TO ZGITEM-MOVE_TYPE.
  MOVE TEMPMENGE TO ZGITEM-ENTRY_QNT.
  ZGITEM-ENTRY_UOM = 'KG'.
  MOVE ZAUFNR TO ZGITEM-ORDERID.
  MOVE DSPJG TO ZGITEM-ITEM_TEXT.
  APPEND ZGITEM.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
    EXPORTING
      GOODSMVT_HEADER  = ZGHEAD
      GOODSMVT_CODE    = '03'
    IMPORTING
      MATERIALDOCUMENT = ZMATDOC
      MATDOCUMENTYEAR  = ZMATYEAR
    TABLES
      GOODSMVT_ITEM    = ZGITEM
      RETURN           = ZBRETURN.

  IF ZMATDOC IS NOT INITIAL.
    CONCATENATE 'Change Material Document' ZMATDOC 'berhasil' INTO DMESSAGE SEPARATED BY SPACE.
    PERFORM BAPI_COMMIT.
  ELSE.
    PERFORM BAPI_ROLLBACK.
  ENDIF.

  PERFORM CHK_ER USING DMESSAGE 'ZBRETURN' CHANGING DSTATUS.
  LOOP AT ZGITEM WHERE MOVE_TYPE = '261' OR MOVE_TYPE = '901'.
    SCMENGE = SCMENGE + ZGITEM-ENTRY_QNT.
  ENDLOOP.
*    UPDATE CHARACTERISTIC BATCH INPUTAN####################################
  "Mat to Mat Scrap Ubah Characteristic Batch Input
  IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
    PERFORM VB_GD_TAB USING RE_INPT-MATNR_ASAL RE_INPT-CHARG_ASAL ZPLANT.
  ELSE.
    PERFORM VB_GD_TAB USING RE_INPT-PLNBEZ RE_INPT-CHARG ZPLANT.
  ENDIF.

  DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
  DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.

  ZCHAR-CHARACT = 'ZZLENGTH'.
  MOVE '' TO ZCHAR-VALUE_CHAR.
  CONDENSE ZCHAR-VALUE_CHAR.
  APPEND ZCHAR.

  ZCHAR-CHARACT = 'ZZSCRAP'.
  MOVE 'SC' TO ZCHAR-VALUE_CHAR.
  APPEND ZCHAR.

  IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
    PERFORM CHG_CHAR USING RE_INPT-MATNR_ASAL ZPLANT RE_INPT-CHARG_ASAL.
  ELSE.
    PERFORM CHG_CHAR USING RE_INPT-PLNBEZ ZPLANT RE_INPT-CHARG.
  ENDIF.

  IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
    RE_INPT-LENGTH_AKSEN = RE_INPT-LENGTH_AKSEN + RE_INPT-SPJG.

    CALL FUNCTION 'ZMM_TEXT_MAT_TO_MAT'
      EXPORTING
        MATNR    = RE_INPT-PLNBEZ
        CHARG    = RE_INPT-CHARG
        WERKS    = ZPLANT
        LENGTH_I = RE_INPT-SPJG.

    MODIFY RE_INPT.
  ENDIF.
*    ########################################################################
ENDFORM.                    "GDSMVT_SCRAP

