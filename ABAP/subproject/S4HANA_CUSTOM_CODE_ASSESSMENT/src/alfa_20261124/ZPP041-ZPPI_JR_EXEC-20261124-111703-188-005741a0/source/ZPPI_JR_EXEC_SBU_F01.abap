     OR ZTCODE = 'ZPP0265' OR ZTCODE = 'ZPP0266' OR ZTCODE = 'ZPP0411' OR ZTCODE = 'ZPP0412'
     OR ZTCODE = 'ZPP0413' OR ZTCODE = 'ZPP0414' OR ZTCODE = 'ZPP0415' OR ZTCODE = 'ZPP0416'
     OR ZTCODE = 'ZPP0417' OR ZTCODE = 'ZPP0267'. " Added by William at 29.07.2022 (OPP7 CPP1)
    IF ZTYPE IS INITIAL.
      SET TITLEBAR 'ZBOPP'.
    ELSE.
      SET TITLEBAR 'ZBOPP2'.
    ENDIF.
*  ELSEIF ZTCODE = 'ZPP026C' OR ZTCODE = 'ZPP026D' OR ZTCODE = 'ZPP026E' OR ZTCODE = 'ZPP026G'
*     OR ZTCODE = 'ZPP026H' OR ZTCODE = 'ZPP041C' OR ZTCODE = 'ZPP041D' OR ZTCODE = 'ZPP041E'
*     OR ZTCODE = 'ZPP041G' OR ZTCODE = 'ZPP041H'.

*      ADD BY REY 26-10-2017
  ELSEIF ZTCODE = 'ZPP026C' OR ZTCODE = 'ZPP026D' OR ZTCODE = 'ZPP026E' OR ZTCODE = 'ZPP026G'
    OR ZTCODE = 'ZPP026H' OR ZTCODE = 'ZPP026I' OR ZTCODE = 'ZPP026J' OR ZTCODE = 'ZPP026Q'
    OR ZTCODE = 'ZPP026R' OR ZTCODE = 'ZPP026S' OR ZTCODE = 'ZPP026V' OR ZTCODE = 'ZPP041C'
    OR ZTCODE = 'ZPP041D' OR ZTCODE = 'ZPP041E' OR ZTCODE = 'ZPP041G' OR ZTCODE = 'ZPP041H'
    OR ZTCODE = 'ZPP041I' OR ZTCODE = 'ZPP041J' OR ZTCODE = 'ZPP041Q' OR ZTCODE = 'ZPP041R'
    OR ZTCODE = 'ZPP041S' OR ZTCODE = 'ZPP041V'.
    IF ZTYPE IS INITIAL.
      SET TITLEBAR 'ZMETALIZING'.
    ELSE.
      SET TITLEBAR 'ZMETALIZING2'.
    ENDIF.
    "add new company
  ELSEIF ZTCODE = 'ZPP026Z3' OR ZTCODE = 'ZPP041Z3'.
    IF ZTYPE IS INITIAL.
      SET TITLEBAR 'ZBOPET_TTA'.
    ELSE.
      SET TITLEBAR 'ZBOPET_TTA2'.
    ENDIF.
  ELSEIF ZTCODE = 'ZPP041P1' OR ZTCODE = 'ZPP026P1'.  " Added by William at 29.07.2022 (OPP7 CPP1)
