FORM VB_GD_TAB USING ZMAT ZBATCH ZPLANT.
  CLEAR : ZCLBATCH. REFRESH : ZCLBATCH.
  CALL FUNCTION 'VB_INIT'
    EXPORTING
      INIT_RESET = 'X'.

  CALL FUNCTION 'VB_BATCH_GET_DETAIL'
    EXPORTING
      MATNR              = ZMAT
      CHARG              = ZBATCH
      WERKS              = ZPLANT
      GET_CLASSIFICATION = 'X'
    TABLES
      CHAR_OF_BATCH      = ZCLBATCH.

  LOOP AT ZCLBATCH.
    MOVE ZCLBATCH-ATNAM TO ZCHAR-CHARACT.
    CONDENSE ZCHAR-CHARACT.
    MOVE ZCLBATCH-ATWTB TO ZCHAR-VALUE_CHAR.
    CONDENSE ZCHAR-VALUE_CHAR.
    APPEND ZCHAR.
  ENDLOOP.
ENDFORM.                    "VB_GD_TAB

*&---------------------------------------------------------------------*
*&      Form  RD_GDMVT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZBATCH     text
*      -->ZAUFNR     text
*----------------------------------------------------------------------*
FORM RD_GDMVT USING ZBATCH ZAUFNR.
  CLEAR : ZZMSEG,ZZMSEGD.
  REFRESH : ZZMSEG,ZZMSEGD.
  IF ZBATCH IS NOT INITIAL.
    SELECT MBLNR MJAHR ZEILE SMBLN BWART CHARG APLZL MENGE MATNR CHARG WERKS SGTXT
      INTO CORRESPONDING FIELDS OF TABLE ZZMSEG
    FROM MSEG
      WHERE CHARG = ZBATCH AND
            BWART IN ('101','102').
  ELSE.
    SELECT MBLNR MJAHR ZEILE SMBLN BWART CHARG APLZL MENGE MATNR CHARG WERKS SGTXT
      INTO CORRESPONDING FIELDS OF TABLE ZZMSEG
    FROM MSEG
      WHERE AUFNR = ZAUFNR AND
            BWART IN ('101','102').
  ENDIF.
  ZZMSEGD[] = ZZMSEG[].
  LOOP AT ZZMSEG WHERE BWART = '102'.
    DELETE ZZMSEGD WHERE MBLNR = ZZMSEG-SMBLN.
  ENDLOOP.
  DELETE ZZMSEGD WHERE BWART = '102'.
ENDFORM.                    "RD_GDMVT

*&---------------------------------------------------------------------*
*&      Form  CHK_ER
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZMSG       text
*      -->ZTBL       text
*      -->ZSTATUS    text
*----------------------------------------------------------------------*
FORM CHK_ER USING ZMSG ZTBL CHANGING ZSTATUS.
  DATA : DMSG TYPE C LENGTH 100.
  MOVE ZMSG TO DMSG.
  IF ZTBL = 'ZBRETURN'.
    READ TABLE ZBRETURN WITH KEY TYPE = 'E'.
    IF SY-SUBRC = 0.
      LOOP AT ZBRETURN WHERE TYPE = 'E'.
        LSEQ = LSEQ + 1.
        LMSG-MSGID = '00'.
        LMSG-MSGTY = 'E'.
        LMSG-MSGNO = '1'.
        MOVE ZBRETURN-MESSAGE TO LMSG-MSGV1.
        MOVE ZBRETURN-MESSAGE+50 TO LMSG-MSGV2.
        MOVE LSEQ TO LMSG-LINENO.
        APPEND LMSG.
      ENDLOOP.
      ZSTATUS = 'E'.
    ELSE.
      IF ZMSG IS NOT INITIAL.
        LSEQ = LSEQ + 1.
        LMSG-MSGID = '00'.
        LMSG-MSGTY = 'S'.
        LMSG-MSGNO = '1'.
        MOVE DMSG TO LMSG-MSGV1.
        MOVE DMSG+50 TO LMSG-MSGV2.
        MOVE LSEQ TO LMSG-LINENO.
        APPEND LMSG.
      ENDIF.
      ZSTATUS = 'S'.
    ENDIF.
  ELSEIF ZTBL = 'ZRETURN'.
    READ TABLE ZRETURN WITH KEY TYPE = 'E'.
    IF SY-SUBRC = 0.
      LOOP AT ZRETURN WHERE TYPE = 'E'.
        LSEQ = LSEQ + 1.
        LMSG-MSGID = '00'.
        LMSG-MSGTY = 'E'.
        LMSG-MSGNO = '1'.
        MOVE ZRETURN-MESSAGE TO LMSG-MSGV1.
        MOVE ZRETURN-MESSAGE+50 TO LMSG-MSGV2.
        MOVE LSEQ TO LMSG-LINENO.
        APPEND LMSG.
      ENDLOOP.
      ZSTATUS = 'E'.
    ELSE.
      IF ZMSG IS NOT INITIAL.
        LSEQ = LSEQ + 1.
        LMSG-MSGID = '00'.
        LMSG-MSGTY = 'S'.
        LMSG-MSGNO = '1'.
        MOVE DMSG TO LMSG-MSGV1.
        MOVE DMSG+50 TO LMSG-MSGV2.
        MOVE LSEQ TO LMSG-LINENO.
        APPEND LMSG.
        ZSTATUS = 'S'.
      ENDIF.
    ENDIF.
  ELSEIF ZTBL = ''.
    IF ZMSG IS NOT INITIAL.
      LSEQ = LSEQ + 1.
      LMSG-MSGID = '00'.
      LMSG-MSGTY = 'S'.
      LMSG-MSGNO = '1'.
      MOVE DMSG TO LMSG-MSGV1.
      MOVE DMSG+50 TO LMSG-MSGV2.
      MOVE LSEQ TO LMSG-LINENO.
      APPEND LMSG.
    ENDIF.
    ZSTATUS = 'S'.
  ENDIF.

ENDFORM.                    "CHK_ER

*&---------------------------------------------------------------------*
*&      Form  ZPP019
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZWERKS     text
*      -->ZCHARG     text
*      -->ZLGORT     text
*      -->ZNIK       text
*      -->ZATWTB     text
*      -->ZJMROL     text
*      -->ZSCRAP     text
*----------------------------------------------------------------------*
FORM ZPP019 USING ZWERKS ZCHARG ZLGORT ZNIK ZATWTB ZJMROL ZSCRAP.
  DATA : DDATE TYPE C LENGTH 10,
         ZQTY(018),
         DAUFNR TYPE STRING,
         DMSG TYPE STRING,
         CAUFNR LIKE RESB-AUFNR,
         DATWTB TYPE C.

  CLEAR : IT_BDCDATA. REFRESH : IT_BDCDATA.

  CONDENSE ZATWTB.
  MOVE ZATWTB TO ZQTY.
  CONCATENATE SY-DATUM+6(2) '.' SY-DATUM+4(2) '.' SY-DATUM(4) INTO DDATE.

  SELECT SINGLE AUFNR INTO CAUFNR
    FROM RESB
  WHERE CHARG = ZCHARG.
  MOVE ZSCRAP TO DATWTB.

  IF DATWTB = 'S'.
    CLEAR DMESSAGE.
    CONCATENATE 'Batch' ZCHARG 'sudah pernah dieksekusi menjadi Scrap' INTO DMESSAGE SEPARATED BY SPACE.
    PERFORM APD_ER_MSG USING DMESSAGE.
  ENDIF.

  CHECK DSTATUS NE 'E'.

  PERFORM BDC_DYNPRO      USING 'ZPPI_PO_RAW_RECYCLE' '0100'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'RAD1'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=GO'.
  PERFORM BDC_FIELD       USING 'RAD1'
                                'X'.

  PERFORM BDC_DYNPRO      USING 'ZPPI_PO_RAW_RECYCLE' '0110'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=EXE'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'P_BATCH-LOW'.
  PERFORM BDC_FIELD       USING 'P_PLANT-LOW'
                                ZWERKS.
  PERFORM BDC_FIELD       USING 'P_BATCH-LOW'
                                ZCHARG.
  PERFORM BDC_FIELD       USING 'P_DATE'
                                DDATE.
  PERFORM BDC_FIELD       USING 'P_NIK'
                                ZNIK.
  PERFORM BDC_DYNPRO      USING 'ZPPI_PO_RAW_RECYCLE' '0110'.
  PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                'WADATA-MATNR(01)'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=CREATE'.
*  PERFORM BDC_FIELD       USING 'WADATA-CLABS(01)'
*                                ZQTY.
*  IF CAUFNR IS INITIAL.
*    PERFORM BDC_FIELD       USING 'WADATA-SLOCGR(01)'
*                                  ZLGORT.
*  ENDIF.
  PERFORM BDC_FIELD       USING 'WADATA-MARK(01)'
                                'X'.
  PERFORM BDC_DYNPRO      USING 'ZPPI_PO_RAW_RECYCLE' '0110'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=POSTING'.
  PERFORM BDC_DYNPRO      USING 'SAPLSPO1' '0500'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=OPT1'.
  PERFORM BDC_DYNPRO      USING 'ZPPI_PO_RAW_RECYCLE' '0110'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=TECO'.
  PERFORM BDC_DYNPRO      USING 'SAPLSPO1' '0500'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=OPT1'.
  PERFORM BDC_DYNPRO      USING 'ZPPI_PO_RAW_RECYCLE' '0110'.
  PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                '=EXIT'.
*  BREAK-POINT.
  PERFORM BDC_TRANSACTION USING 'ZPP019'.


  CHECK DSTATUS NE 'E'.
  MOVE ZBRETURN-MESSAGE TO DAUFNR.
  REPLACE ALL OCCURRENCES OF 'TECO Process Order ' IN DAUFNR WITH ''.
  REPLACE ALL OCCURRENCES OF ' Berhasil!' IN DAUFNR WITH ''.
  CONDENSE DAUFNR.

  CONCATENATE 'Pengupasan Roll batch' ZCHARG 'dengan order' DAUFNR 'berhasil' INTO DMSG SEPARATED BY SPACE.
  PERFORM CHK_ER USING DMSG 'ZBRETURN' CHANGING DSTATUS.

  CLEAR : ZZMSEGD, ZAFWI. REFRESH : ZZMSEGD.
  SELECT MBLNR MJAHR
    INTO CORRESPONDING FIELDS OF TABLE ZZMSEGD
  FROM MSEG
    WHERE AUFNR = DAUFNR.

  IF ZJMROL IS INITIAL.
    LOOP AT ZZMSEGD.
      ZAFWI-MBLNR = ZZMSEGD-MBLNR.
      ZAFWI-MJAHR = ZZMSEGD-MJAHR.
      APPEND ZAFWI.
    ENDLOOP.
  ELSE.
    LOOP AT ZZMSEGD.
      PERFORM BAPI_MB02 USING ZZMSEGD-MBLNR ZZMSEGD-MJAHR ZJMROL ''.
*      PERFORM BDC_MB02 USING ZZMSEGD-MBLNR ZZMSEGD-MJAHR ZJMROL.
    ENDLOOP.
  ENDIF.
ENDFORM.                    "ZPP019

