  CLEAR DSTATUS.
ENDFORM.                    "CCL_BATCH

*&---------------------------------------------------------------------*
*&      Form  CCL_CHARACTERISTIC
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM CCL_CHARACTERISTIC.
  DATA : VLENGTH TYPE I,
         NLENGTH TYPE P,
         ZATWTB LIKE CLBATCH-ATWTB,
         ZMTART LIKE MARA-MTART.

  LOOP AT ZZMSEG_CHAR WHERE CHARG IS NOT INITIAL.
    CLEAR : NLENGTH, ZATWTB, ZMTART.  " ADD NEW COMPANY cancel batch Raw Mat

    "Mat to Mat Cancel Characteristic
    DATA: V_CHARG_I LIKE MCH1-CHARG,
          V_MATNR_I LIKE MARA-MATNR,
          V_CHARG_O LIKE MCH1-CHARG,
          V_MATNR_O LIKE MARA-MATNR,
          V_WERKS_I LIKE MCHA-WERKS.

    SELECT SINGLE LICHA INTO V_CHARG_I FROM MCH1 WHERE CHARG EQ ZZMSEG_CHAR-CHARG.
    IF V_CHARG_I IS NOT INITIAL.
      SELECT SINGLE MATNR WERKS INTO (V_MATNR_I, V_WERKS_I) FROM MCHA WHERE CHARG EQ V_CHARG_I.
      IF SY-SUBRC EQ 0.
        V_MATNR_O   = ZZMSEG_CHAR-MATNR.
        V_CHARG_O   = ZZMSEG_CHAR-CHARG.
        ZZMSEG_CHAR-MATNR = V_MATNR_I.
        ZZMSEG_CHAR-CHARG = V_CHARG_I.
      ENDIF.
    ENDIF.

    CONDENSE ZZMSEG_CHAR-SGTXT.
    VLENGTH = STRLEN( ZZMSEG_CHAR-SGTXT ). "KASUS SCRAP
*    CHECK VLENGTH < 14.
    PERFORM VBGETDET USING ZZMSEG_CHAR-MATNR ZZMSEG_CHAR-CHARG ZZMSEG_CHAR-WERKS 'ZZLENGTH' CHANGING ZATWTB.
    REPLACE ALL OCCURRENCES OF ',' IN ZATWTB WITH ''.
    MOVE ZATWTB TO NLENGTH.
    IF VLENGTH GT 13.
      NLENGTH = NLENGTH + ZZMSEG_CHAR-SGTXT+13.
    ELSE.
      NLENGTH = NLENGTH + ZZMSEG_CHAR-SGTXT.
    ENDIF.

    PERFORM VB_GD_TAB USING ZZMSEG_CHAR-MATNR ZZMSEG_CHAR-CHARG ZZMSEG_CHAR-WERKS.

    DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
    ZCHAR-CHARACT = 'ZZLENGTH'.
    MOVE NLENGTH TO ZCHAR-VALUE_CHAR.
    CONDENSE ZCHAR-VALUE_CHAR.
    APPEND ZCHAR.

    READ TABLE ZCHAR WITH KEY CHARACT = 'ZZSCRAP'.
    IF SY-SUBRC = 0.
      DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.
      ZCHAR-CHARACT = 'ZZSCRAP'.
      MOVE '' TO ZCHAR-VALUE_CHAR.
      CONDENSE ZCHAR-VALUE_CHAR.
      APPEND ZCHAR.
    ENDIF.

    SELECT SINGLE MTART INTO ZMTART FROM MARA WHERE MATNR EQ ZZMSEG_CHAR-MATNR. " ADD NEW COMPANY cancel batch Raw Mat
    IF ZMTART NE 'ZRAW'.
      PERFORM CHG_CHAR USING ZZMSEG_CHAR-MATNR ZZMSEG_CHAR-WERKS ZZMSEG_CHAR-CHARG.

      "Mat to Mat Cancel Characteristic Batch Aksen
      IF V_CHARG_O IS NOT INITIAL.
        PERFORM VB_GD_TAB USING V_MATNR_O V_CHARG_O ZZMSEG_CHAR-WERKS.

        DATA: V_PANJANG TYPE P,
              V_CHAR TYPE C LENGTH 10.

        IF VLENGTH GT 13.
          V_CHAR = ZZMSEG_CHAR-SGTXT+13.
        ELSE.
          V_CHAR = ZZMSEG_CHAR-SGTXT.
        ENDIF.
        MOVE V_CHAR TO V_PANJANG.

        CALL FUNCTION 'ZMM_TEXT_MAT_TO_MAT'
          EXPORTING
            MATNR    = V_MATNR_O
            CHARG    = V_CHARG_O
            WERKS    = V_WERKS_I
            LENGTH_I = V_PANJANG
            CANC     = 'X'
          IMPORTING
            LENGTH_O = V_PANJANG.

        DELETE ZCHAR WHERE CHARACT = 'ZZLENGTH'.
        ZCHAR-CHARACT = 'ZZLENGTH'.
        MOVE V_PANJANG TO ZCHAR-VALUE_CHAR.
        CONDENSE ZCHAR-VALUE_CHAR.
        APPEND ZCHAR.

        READ TABLE ZCHAR WITH KEY CHARACT = 'ZZSCRAP'.
        IF SY-SUBRC = 0.
          DELETE ZCHAR WHERE CHARACT = 'ZZSCRAP'.
          ZCHAR-CHARACT = 'ZZSCRAP'.
          MOVE '' TO ZCHAR-VALUE_CHAR.
          CONDENSE ZCHAR-VALUE_CHAR.
          APPEND ZCHAR.
        ENDIF.

        PERFORM CHG_CHAR USING V_MATNR_O ZZMSEG_CHAR-WERKS V_CHARG_O.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                    "CCL_CHARACTERISTIC

*&---------------------------------------------------------------------*
*&      Form  UPT_QA02
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->ZBATCH     text
*      -->ZCFM       text
*----------------------------------------------------------------------*
FORM UPT_QA02 USING ZBATCH ZCFM.
  DATA : ZQALS LIKE STANDARD TABLE OF QALS WITH HEADER LINE.

  DATA : DPRUEFLOS TYPE C LENGTH 12.

  SELECT PRUEFLOS
    INTO CORRESPONDING FIELDS OF TABLE ZQALS
  FROM QALS
    WHERE CHARG = ZBATCH.

  LOOP AT ZQALS.
    CLEAR : IT_BDCDATA,DPRUEFLOS. REFRESH : IT_BDCDATA.
    MOVE ZQALS-PRUEFLOS TO DPRUEFLOS.
    PERFORM BDC_DYNPRO      USING 'SAPLQPL1' '0100'.
    PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                  'QALS-PRUEFLOS'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '/00'.
    PERFORM BDC_FIELD       USING 'QALS-PRUEFLOS'
                                  DPRUEFLOS.
    PERFORM BDC_DYNPRO      USING 'SAPLQPL1' '0200'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '=AWST'.

    PERFORM BDC_DYNPRO      USING 'SAPLBSVA' '0201'.
    IF ZCFM = 'OK'.
      PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                    'J_STMAINT-ANWS(01)'.
      PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                    '=OKAY'.
      PERFORM BDC_FIELD       USING 'J_STMAINT-ANWS(01)'
                                    'X'.
    ELSE.
      PERFORM BDC_FIELD       USING 'BDC_CURSOR'
                                    'J_STMAINT-ANWS(02)'.
      PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                    '=OKAY'.
      PERFORM BDC_FIELD       USING 'J_STMAINT-ANWS(02)'
                                    'X'.
    ENDIF.

    PERFORM BDC_DYNPRO      USING 'SAPLQPL1' '0200'.
    PERFORM BDC_FIELD       USING 'BDC_OKCODE'
                                  '=BU'.
    PERFORM BDC_TRANSACTION USING 'QA02'.
*    COMMIT WORK.
  ENDLOOP.
ENDFORM.                    "UPT_QA02

