*      -->ZMATNR     text
*      -->ZWERKS     text
*----------------------------------------------------------------------*
FORM CHECK_SLOC USING ZSLOC ZMATNR ZWERKS.
  DATA : DCOUNT TYPE I,
         DMESSAGE TYPE STRING.

  SELECT COUNT(*) INTO DCOUNT
      FROM MARD
   WHERE LGORT = ZSLOC AND
         MATNR = ZMATNR AND
         WERKS = ZWERKS.

  IF DCOUNT = 0.
    CONCATENATE 'Material ' ZMATNR 'belum di maintain dalam SLoc' ZSLOC INTO DMESSAGE SEPARATED BY SPACE.
    PERFORM APD_ER_MSG USING DMESSAGE.
  ENDIF.

ENDFORM.                    "CHECK_SLOC

