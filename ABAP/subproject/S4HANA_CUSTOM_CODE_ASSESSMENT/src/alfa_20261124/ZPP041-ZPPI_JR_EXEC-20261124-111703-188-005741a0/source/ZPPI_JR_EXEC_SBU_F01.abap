*----------------------------------------------------------------------*
FORM ADDITIONAL_CKI2 USING ZMAT ZPLANT ZBATCH.
  DATA: IT_MAPPING LIKE ZMAP_TYPE OCCURS 0 WITH HEADER LINE.
  DATA: V_NAME     LIKE THEAD-TDNAME,
        THEAD      LIKE THEAD,
        TLINE      LIKE TLINE OCCURS 0 WITH HEADER LINE,
        V_INDEX    TYPE SY-TABIX,
        V_LENGTH   TYPE P,
        V_DELLEN   TYPE TLINE-TDLINE,
        V_CHARG    TYPE CHARG_D,
        V_MATKL TYPE MATKL.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MAPPING
    FROM ZMAP_TYPE
   WHERE TCODE    EQ SY-TCODE
     AND TYPE     EQ 'MATERIAL GROUP'
     AND OPT      EQ 'SUBCONTRACTING'
     AND DELETION EQ ''.

  IF IT_MAPPING[] IS INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MAPPING
      FROM ZMAP_TYPE
     WHERE PROG     EQ SY-CPROG
       AND TYPE     EQ 'MATERIAL GROUP'
       AND OPT      EQ 'SUBCONTRACTING'
       AND DELETION EQ ''.
  ENDIF.

  IF IT_MAPPING[] IS INITIAL.
    EXIT.
  ENDIF.

  V_NAME+0(10) = ZMAT.
  V_NAME+22(10) = ZBATCH.

  THEAD-TDID      = 'VERM'.
  THEAD-TDSPRAS   = SY-LANGU.
  THEAD-TDNAME    = V_NAME.
  THEAD-TDOBJECT  = 'CHARGE'.

  CALL FUNCTION 'READ_TEXT'
    EXPORTING
      CLIENT                  = SY-MANDT
      ID                      = THEAD-TDID
      LANGUAGE                = THEAD-TDSPRAS
      NAME                    = THEAD-TDNAME
      OBJECT                  = THEAD-TDOBJECT
    TABLES
      LINES                   = TLINE
    EXCEPTIONS
      ID                      = 1
      LANGUAGE                = 2
      NAME                    = 3
      NOT_FOUND               = 4
      OBJECT                  = 5
      REFERENCE_CHECK         = 6
      WRONG_ACCESS_TO_ARCHIVE = 7
      OTHERS                  = 8.

  IF TLINE[] IS INITIAL.
    TLINE-TDFORMAT = '*'.
    TLINE-TDLINE   = ''.
    APPEND TLINE.
  ENDIF.

  LOOP AT RE_INPT WHERE CHARG IS NOT INITIAL.
    "Get Material group inputan
    CLEAR: V_MATKL, V_CHARG.

    "Get Material group inputan
    IF RE_INPT-CHARG_ASAL IS NOT INITIAL.
      SELECT SINGLE MATKL INTO V_MATKL FROM MARA WHERE MATNR EQ RE_INPT-MATNR_ASAL.
      V_CHARG = RE_INPT-CHARG_ASAL.
    ELSE.
      SELECT SINGLE MATKL INTO V_MATKL FROM MARA WHERE MATNR EQ RE_INPT-PLNBEZ.
      V_CHARG = RE_INPT-CHARG.
    ENDIF.

    "Check value same or not
    READ TABLE IT_MAPPING WITH KEY VALUE = V_MATKL.
    IF SY-SUBRC NE 0.
      CONTINUE.
    ENDIF.

    "Set Length
    TLINE-TDFORMAT = '*'.
    IF RE_INPT-SCRAP EQ 'X'.
      TLINE-TDLINE   = V_CHARG && ':' && RE_INPT-OLENGTH.
    ELSE.
      TLINE-TDLINE   = V_CHARG && ':' && RE_INPT-SLENGTH.
    ENDIF.
    CONDENSE TLINE-TDLINE NO-GAPS.
    APPEND TLINE.
  ENDLOOP.

  IF TLINE[] IS NOT INITIAL.
    CALL FUNCTION 'SAVE_TEXT'
      EXPORTING
        HEADER          = THEAD
        SAVEMODE_DIRECT = 'X'
      TABLES
        LINES           = TLINE
      EXCEPTIONS
        ID              = 1
        LANGUAGE        = 2
        NAME            = 3
        OBIECT          = 4
        OTHERS          = 5.
  ENDIF.
ENDFORM.                    "ADDITIONAL_CKI2