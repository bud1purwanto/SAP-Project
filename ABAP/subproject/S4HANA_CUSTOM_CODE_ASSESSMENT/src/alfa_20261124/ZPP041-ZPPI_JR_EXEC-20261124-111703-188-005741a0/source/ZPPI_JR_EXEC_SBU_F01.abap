         OR ZTCODE = 'ZPP041L2' OR ZTCODE = 'ZPP041L3'  "add by Ryan, 05.03.2025, Laminator #2 #3, Anna
         OR ZTCODE = 'ZPP026L2' OR ZTCODE = 'ZPP026L3'.  "end by Ryan, 05.03.2025, Laminator #2 #3, Anna
