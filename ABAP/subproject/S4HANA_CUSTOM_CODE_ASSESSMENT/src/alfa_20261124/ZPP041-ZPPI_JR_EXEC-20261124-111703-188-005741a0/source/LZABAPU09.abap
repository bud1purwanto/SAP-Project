FUNCTION ZCO_PRICE_CHANGE.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(MBLNR) TYPE  MBLNR OPTIONAL
*"     REFERENCE(MJAHR) TYPE  MJAHR OPTIONAL
*"     REFERENCE(MATNR_BF) TYPE  MATNR OPTIONAL
*"     REFERENCE(MATNR_ACC) TYPE  MATNR OPTIONAL
*"     REFERENCE(WERKS) TYPE  WERKS_D OPTIONAL
*"     REFERENCE(CANC) TYPE  BOOLEAN OPTIONAL
*"     REFERENCE(VALIDATE) TYPE  BOOLEAN OPTIONAL
*"  EXPORTING
*"     VALUE(BELNR) TYPE  CK_BELNR
*"     VALUE(GJAHR) TYPE  CK_KJAHR
*"  TABLES
*"      MESSAGE STRUCTURE  BAPIRET2
*"----------------------------------------------------------------------

  DATA: BEGIN OF T_CKMLPP,
        KALNR         TYPE CKMLPP-KALNR,
        BDATJ         TYPE CKMLPP-BDATJ,
        POPER         TYPE CKMLPP-POPER,
        UNTPER        TYPE CKMLPP-UNTPER,
        LBKUM         TYPE CKMLPP-LBKUM,
        BDATJ2        TYPE CKMLPP-BDATJ,
        POPER2        TYPE CKMLPP-POPER,
        MEINS         TYPE CKMLPP-MEINS,
        STATUS        TYPE CKMLPP-STATUS,
  END OF T_CKMLPP.

  DATA: BEGIN OF T_CKMLCR,
        KALNR         TYPE CKMLCR-KALNR,
        BDATJ         TYPE CKMLCR-BDATJ,
        POPER         TYPE CKMLCR-POPER,
        UNTPER        TYPE CKMLCR-UNTPER,
        EBPRD_EA      TYPE CKMLCR-EBPRD_EA,
        EBKDM_EA      TYPE CKMLCR-EBKDM_EA,
        EBPRD_MA      TYPE CKMLCR-EBPRD_MA,
        EBKDM_MA      TYPE CKMLCR-EBKDM_MA,
        CURTP         TYPE CKMLCR-CURTP,
        SALK3         TYPE CKMLCR-SALK3,
        SALKV         TYPE CKMLCR-SALKV,
        VPRSV         TYPE CKMLCR-VPRSV,
        STPRS         TYPE CKMLCR-STPRS,
        PVPRS         TYPE CKMLCR-PVPRS,
        PEINH         TYPE CKMLCR-PEINH,
        BDATJ2        TYPE CKMLCR-BDATJ,
        POPER2        TYPE CKMLCR-POPER,
   END OF T_CKMLCR.

  "Data Create
  DATA: IT_RETURN     LIKE STANDARD TABLE OF BAPIRET2 WITH HEADER LINE,
        IT_ZSTDCOST   LIKE ZCKMLPRKEPH OCCURS 0 WITH HEADER LINE,
        IT_ZSTDMRGN   LIKE ZSTDMARGIN OCCURS 0 WITH HEADER LINE,
        V_MSG         TYPE C LENGTH 100.

  "Price Change
  DATA: MATERIAL      TYPE BAPI_MATVAL_KEY-MATERIAL,
        VALUATIONAREA TYPE BAPI_MATVAL_KEY-VAL_AREA,
        VALUATIONTYPE TYPE BAPI_MATVAL_KEY-VAL_TYPE,
        PRICEDATE     TYPE BAPI_MATVAL_PRICEDATE OCCURS 0 WITH HEADER LINE,
        PRICEDOCUMENT LIKE BAPI_PRICECHANGE_DOCUMENT ,
        PRICES        LIKE BAPI_MATVAL_PRICES OCCURS 0 WITH HEADER LINE.

  DATA: IT_CKMLPP     LIKE T_CKMLPP OCCURS 0 WITH HEADER LINE,
        IT_CKMLCR     LIKE T_CKMLCR OCCURS 0 WITH HEADER LINE,
        WA_CKMLPP     LIKE T_CKMLPP,
        LS_CKMLPP     LIKE T_CKMLPP OCCURS 0 WITH HEADER LINE,
        V_KALNR       TYPE CK_KALNR,
        V_MLAST       TYPE CK_ML_ABST,
        V_PRC_CD      TYPE C LENGTH 4,
        V_BDATJ       TYPE BDATJ,
        V_POPER       TYPE POPER,
        V_BUDAT       TYPE BUDAT,
        V_DMBTR       TYPE DMBTR,
        V_MENGE       TYPE MENGE_D,
        V_AWKEY       TYPE AWKEY,
        V_BELNR       TYPE BELNR_D,
        V_GJAHR       TYPE GJAHR,
        V_BUKRS       TYPE BUKRS,
        V_DMBE2       TYPE DMBE2,
        PR_NOW_USD    TYPE BAPI_MATVAL_PRICES-PRICE,
        PR_NOW_IDR    TYPE BAPI_MATVAL_PRICES-PRICE,
        PR_STD_USD    TYPE P DECIMALS 2,
        PR_STD_IDR    TYPE P DECIMALS 0,
        BAPI_USD      TYPE P LENGTH 15 DECIMALS 2,
        BAPI_IDR      TYPE P LENGTH 15 DECIMALS 0.

  DATA: MATNR_I       TYPE MATNR,
        MATNR_O       TYPE MATNR,
        WERKS_I       TYPE WERKS_D.

  V_POPER = SY-DATUM+4(2).
  V_BDATJ = SY-DATUM+0(4).

  CLEAR: MESSAGE.
  REFRESH: MESSAGE.

  IF MBLNR IS NOT INITIAL AND MJAHR IS NOT INITIAL.
    SELECT SINGLE MATNR WERKS INTO (MATNR_I, WERKS_I) FROM MSEG WHERE MBLNR EQ MBLNR AND MJAHR EQ MJAHR AND BWART EQ '261'.
    SELECT SINGLE MATNR WERKS INTO (MATNR_O, WERKS_I) FROM MSEG WHERE MBLNR EQ MBLNR AND MJAHR EQ MJAHR AND BWART EQ '531'.
    IF MATNR_I IS INITIAL OR MATNR_O IS INITIAL.
      SELECT SINGLE MATNR WERKS INTO (MATNR_I, WERKS_I) FROM MSEG WHERE MBLNR EQ MBLNR AND MJAHR EQ MJAHR AND BWART EQ '262'.
      SELECT SINGLE MATNR WERKS INTO (MATNR_O, WERKS_I) FROM MSEG WHERE MBLNR EQ MBLNR AND MJAHR EQ MJAHR AND BWART EQ '532'.
    ENDIF.
  ELSEIF MATNR_BF IS NOT INITIAL AND MATNR_ACC IS NOT INITIAL AND WERKS IS NOT INITIAL.
*  ELSEIF MATNR_ACC IS NOT INITIAL AND WERKS IS NOT INITIAL.
    MATNR_I = MATNR_BF.
    MATNR_O = MATNR_ACC.
    WERKS_I = WERKS.
  ELSE.
    MESSAGE-TYPE    = 'E'.
    MESSAGE-MESSAGE = 'Please input matdoc or material for Mat to Mat!'.
    APPEND MESSAGE.
    EXIT.
  ENDIF.

  CONSTANTS: Y_PERIODENVERSCHIEBER TYPE CKM0_VORGANG VALUE CKM0_VORGANG-PERIODENVERSCHIEBER.

  DATA: V_STD_PRICE LIKE ZCKMLPRKEPH-ZTOTALWOP,
        V_STD_MARGIN LIKE ZSTDMARGIN-ZSTDMRGN.

  "When based on Standart Cost Table
  SELECT SINGLE ZTOTALWOP INTO V_STD_PRICE
    FROM ZCKMLPRKEPH
   WHERE MATNR EQ MATNR_O
     AND BWKEY EQ WERKS_I
     AND BDATJ EQ V_BDATJ
     AND POPER EQ V_POPER
     AND CURTP EQ 30.

  IF V_STD_PRICE IS INITIAL.
    "Get Std Cost Period Before
    SELECT * FROM ZCKMLPRKEPH INTO CORRESPONDING FIELDS OF TABLE IT_ZSTDCOST UP TO 1 ROWS
     WHERE MATNR EQ MATNR_O
       AND BWKEY EQ WERKS_I
       AND ( BDATJ < V_BDATJ OR ( BDATJ = V_BDATJ AND POPER <= V_POPER ) )
       AND CURTP EQ 30
     ORDER BY BDATJ DESCENDING POPER DESCENDING.

    READ TABLE IT_ZSTDCOST INDEX 1.
    IF SY-SUBRC EQ 0.
      V_STD_PRICE = IT_ZSTDCOST-ZTOTALWOP.
    ELSE.
      CONCATENATE 'Price: Standard cost for material' MATNR_O 'is not defined!' INTO V_MSG SEPARATED BY SPACE.
      MESSAGE-TYPE    = 'E'.
      MESSAGE-MESSAGE = V_MSG.
      APPEND MESSAGE.
      EXIT.
    ENDIF.
  ENDIF.

  SELECT SINGLE ZSTDMRGN INTO V_STD_MARGIN
    FROM ZSTDMARGIN
   WHERE MATNR_ACC EQ MATNR_O
     AND BWKEY EQ WERKS_I
     AND BDATJ EQ V_BDATJ
     AND POPER EQ V_POPER
     AND CURTP EQ 30.

  IF SY-SUBRC NE 0.
    SELECT * FROM ZSTDMARGIN INTO CORRESPONDING FIELDS OF TABLE IT_ZSTDMRGN UP TO 1 ROWS
   WHERE MATNR_ACC EQ MATNR_O
     AND BWKEY     EQ WERKS_I
     AND ( BDATJ < V_BDATJ OR ( BDATJ = V_BDATJ AND POPER <= V_POPER ) )
     AND CURTP EQ 30
   ORDER BY BDATJ DESCENDING POPER DESCENDING.

    READ TABLE IT_ZSTDMRGN INDEX 1.
    IF SY-SUBRC EQ 0.
      V_STD_MARGIN = IT_ZSTDMRGN-ZSTDMRGN.
    ELSE.
      CONCATENATE 'Price: Internal margin for material' MATNR_O 'is not defined! Please check also for Standard Cost.' INTO V_MSG SEPARATED BY SPACE.
      MESSAGE-TYPE    = 'E'.
      MESSAGE-MESSAGE = V_MSG.
      APPEND MESSAGE.
      EXIT.
    ENDIF.
  ENDIF.

  "GET ACTUAL PRICE
  SELECT SINGLE KALNR MLAST INTO (V_KALNR, V_MLAST) FROM CKMLHD WHERE MATNR EQ MATNR_O AND BWKEY EQ WERKS_I.
  SELECT SINGLE KALNR BDATJ POPER UNTPER STATUS LBKUM
    FROM CKMLPP INTO CORRESPONDING FIELDS OF WA_CKMLPP
   WHERE KALNR = V_KALNR
     AND BDATJ = V_BDATJ
     AND POPER = V_POPER
     AND UNTPER = '000'.

  IF SY-SUBRC NE 0.
    "No record found for given period, look for earlier period.
    SELECT KALNR BDATJ POPER UNTPER STATUS LBKUM
      FROM CKMLPP INTO CORRESPONDING FIELDS OF TABLE LS_CKMLPP UP TO 1 ROWS
     WHERE KALNR = V_KALNR
       AND ( BDATJ < V_BDATJ OR ( BDATJ = V_BDATJ AND POPER <= V_POPER ) )
       AND UNTPER = '000'
     ORDER BY BDATJ DESCENDING POPER DESCENDING.

    IF SY-SUBRC = 0.
      READ TABLE LS_CKMLPP INDEX 1 INTO WA_CKMLPP.
      IF SY-SUBRC EQ 0.
        CALL FUNCTION 'CKML_F_GET_NEW_STATUS'
          EXPORTING
            I_VORGANG    = Y_PERIODENVERSCHIEBER
            I_OLD_STATUS = WA_CKMLPP-STATUS
          IMPORTING
            O_NEW_STATUS = WA_CKMLPP-STATUS.

        WA_CKMLPP-BDATJ2 = V_BDATJ.
        WA_CKMLPP-POPER2 = V_POPER.
        APPEND WA_CKMLPP TO IT_CKMLPP.
      ENDIF.
    ENDIF.
  ELSE.
    WA_CKMLPP-BDATJ2 = V_BDATJ.
    WA_CKMLPP-POPER2 = V_POPER.
    APPEND WA_CKMLPP TO IT_CKMLPP.
  ENDIF.

  IF NOT IT_CKMLPP[] IS INITIAL.
    SELECT KALNR BDATJ POPER UNTPER CURTP PEINH SALK3 SALKV
           EBPRD_EA EBPRD_MA EBKDM_EA EBKDM_MA
           VPRSV  STPRS PVPRS
      FROM CKMLCR
    INTO CORRESPONDING FIELDS OF TABLE IT_CKMLCR
    FOR ALL ENTRIES IN IT_CKMLPP
      WHERE KALNR  EQ IT_CKMLPP-KALNR
        AND BDATJ  EQ IT_CKMLPP-BDATJ
        AND POPER  EQ IT_CKMLPP-POPER
        AND UNTPER EQ IT_CKMLPP-UNTPER.
  ENDIF.

  LOOP AT IT_CKMLCR.
    CONCATENATE IT_CKMLCR-VPRSV V_MLAST INTO V_PRC_CD.
    IF V_PRC_CD = 'V2'.
      IF IT_CKMLCR-CURTP EQ 30.
        PR_NOW_USD = IT_CKMLCR-PVPRS.
      ELSEIF IT_CKMLCR-CURTP EQ 10.
        PR_NOW_IDR = IT_CKMLCR-PVPRS * 100.
      ENDIF.
    ELSE.
      IF IT_CKMLCR-CURTP EQ 30.
        PR_NOW_USD = IT_CKMLCR-STPRS.
      ELSEIF IT_CKMLCR-CURTP EQ 10.
        PR_NOW_IDR = IT_CKMLCR-STPRS * 100.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF PR_NOW_USD IS INITIAL.
    CONCATENATE 'Price: Standard price for material' MATNR_O 'is not set!' INTO V_MSG SEPARATED BY SPACE.
    MESSAGE-TYPE    = 'E'.
    MESSAGE-MESSAGE = V_MSG.
    APPEND MESSAGE.
    EXIT.
  ENDIF.

  IF VALIDATE EQ 'X'.
    EXIT.
  ENDIF.

  "GET STANDARD PRICE
  "When based on Amount / Qty Matdoc
  IF CANC EQ 'X'.
    SELECT SINGLE BUDAT_MKPF MENGE DMBTR INTO (V_BUDAT, V_MENGE, V_DMBTR) FROM MSEG WHERE MBLNR EQ MBLNR AND MJAHR EQ MJAHR AND MATNR EQ MATNR_O.
    IF SY-SUBRC EQ 0.
      PR_STD_IDR = ( V_DMBTR / V_MENGE ) * 100.
    ENDIF.

    CLEAR: V_AWKEY, V_BUKRS, V_BELNR, V_GJAHR, V_DMBE2.
    CONCATENATE MBLNR MJAHR INTO V_AWKEY.

    SELECT SINGLE AWKEY BUKRS BELNR GJAHR INTO (V_AWKEY, V_BUKRS, V_BELNR, V_GJAHR) FROM BKPF WHERE AWKEY EQ V_AWKEY AND BLART EQ 'WA'.
    IF SY-SUBRC EQ 0.
      SELECT SINGLE DMBE2 INTO V_DMBE2 FROM BSEG WHERE BUKRS EQ V_BUKRS AND BELNR EQ V_BELNR AND GJAHR EQ V_GJAHR AND MATNR EQ MATNR_O AND KTOSL NE 'AUM'.
      PR_STD_USD = V_DMBE2 / V_MENGE.
    ENDIF.
  ELSE.
    "When based on Std Cost Table
    PR_STD_USD = V_STD_PRICE + V_STD_MARGIN.
    PERFORM GET_IDR USING MATNR_O WERKS_I PR_STD_USD CHANGING PR_STD_IDR.
  ENDIF.

  "Set Different Price
  IF PR_STD_USD IS NOT INITIAL.
    IF PR_NOW_USD NE PR_STD_USD.
      BAPI_USD = PR_STD_USD.
    ENDIF.
  ENDIF.

  IF PR_STD_IDR IS NOT INITIAL.
    IF PR_NOW_IDR NE PR_STD_IDR.
      BAPI_IDR = PR_STD_IDR.
    ENDIF.
  ENDIF.

  "If there are different, get BAPI Change Price
  IF BAPI_IDR IS NOT INITIAL OR BAPI_USD IS NOT INITIAL.
    MATERIAL      = MATNR_O.
    VALUATIONAREA = WERKS_I.
    VALUATIONTYPE = ''.

    PRICEDATE-FISC_YEAR_SRC   = SY-DATUM(4).
    PRICEDATE-FISC_PERIOD_SRC = SY-DATUM+4(2).
    PRICEDATE-PRICE_DATE_SRC  = SY-DATUM.
    PRICEDATE-FISC_YEAR       = SY-DATUM(4).
    PRICEDATE-FISC_PERIOD     = SY-DATUM+4(2).
    PRICEDATE-PRICE_DATE      = SY-DATUM.
    APPEND PRICEDATE.

    IF BAPI_USD IS NOT INITIAL.
      PRICES-VALUATION_VIEW     = 0.
      PRICES-CURR_TYPE          = 30.
      PRICES-PRICE              = BAPI_USD.
      PRICES-CURRENCY           = 'USD'.
      PRICES-CURRENCY_ISO       = ''.
      PRICES-PRICE_UNIT         = 1.
      APPEND PRICES.
    ENDIF.

    IF BAPI_IDR IS NOT INITIAL.
      PRICES-VALUATION_VIEW     = 0.
      PRICES-CURR_TYPE          = 10.
      PRICES-PRICE              = BAPI_IDR.
      PRICES-CURRENCY           = 'IDR'.
      PRICES-CURRENCY_ISO       = ''.
      PRICES-PRICE_UNIT         = 1.
      APPEND PRICES.
    ENDIF.

    CALL FUNCTION 'DB_COMMIT'.
    CALL FUNCTION 'DEQUEUE_ALL'
      EXPORTING
        _SYNCHRON = 'X'.
    COMMIT WORK AND WAIT.

    CALL FUNCTION 'BAPI_MATVAL_PRICE_CHANGE'
      EXPORTING
        MATERIAL            = MATERIAL
        VALUATIONAREA       = VALUATIONAREA
        VALUATIONTYPE       = VALUATIONTYPE
        PRICEDATE           = PRICEDATE
      IMPORTING
        PRICECHANGEDOCUMENT = PRICEDOCUMENT
      TABLES
        PRICES              = PRICES
        RETURN              = IT_RETURN.

    READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
    IF SY-SUBRC = 0.
      CONCATENATE 'Price Change: ' IT_RETURN-MESSAGE INTO MESSAGE-MESSAGE SEPARATED BY SPACE.
      MESSAGE-TYPE        = IT_RETURN-TYPE.
      MESSAGE-ID          = IT_RETURN-ID.
      MESSAGE-NUMBER      = IT_RETURN-NUMBER.
      MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
      MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
      MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
      MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
      APPEND MESSAGE.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
        EXPORTING
          WAIT = 'X'.

      WAIT UP TO '0.5' SECONDS.
    ENDIF.
  ENDIF.

ENDFUNCTION.

*&---------------------------------------------------------------------*
*&      Form  GET_IDR
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->MATNR      text
*      -->WERKS      text
*      -->DATE       text
*      -->INPUT      text
*      -->OUTPUT     text
*----------------------------------------------------------------------*
FORM GET_IDR USING MATNR WERKS INPUT CHANGING OUTPUT.
  DATA: IT_MLCRP LIKE MLCRP OCCURS 0 WITH HEADER LINE,
        V_KALNR  TYPE CK_KALNR,
        V_MLAST  TYPE CK_ML_ABST,
        V_PRC_CD(4),
        V_PRICE_USD TYPE P LENGTH 15 DECIMALS 3,
        V_PRICE_IDR TYPE P LENGTH 15 DECIMALS 3.

  SELECT SINGLE KALNR MLAST INTO (V_KALNR, V_MLAST) FROM CKMLHD WHERE MATNR EQ MATNR AND BWKEY EQ WERKS.
  SELECT MLHD~BELNR MLCRP~CURTP PVPRS_NEW STPRS_NEW VPRSV_NEW
    INTO CORRESPONDING FIELDS OF TABLE IT_MLCRP UP TO 4 ROWS
    FROM MLHD
   	JOIN MLIT         ON MLIT~BELNR   EQ MLHD~BELNR   AND MLIT~KJAHR EQ MLHD~KJAHR
   	JOIN MLCRP        ON MLIT~BELNR   EQ MLCRP~BELNR  AND MLIT~KJAHR EQ MLCRP~KJAHR AND MLIT~POSNR EQ MLCRP~POSNR
   WHERE MLIT~MATNR   EQ MATNR
     AND MLIT~BWKEY   EQ WERKS
     AND MLHD~AWTYP   EQ 'PRCHG'
     AND MLHD~BLDAT   LE SY-DATUM
   ORDER BY BLDAT DESCENDING.

  DELETE IT_MLCRP INDEX 1.
  DELETE IT_MLCRP INDEX 1.

  LOOP AT IT_MLCRP.
    CONCATENATE IT_MLCRP-VPRSV_NEW V_MLAST INTO V_PRC_CD.
    IF V_PRC_CD = 'V2'.
      IF IT_MLCRP-CURTP EQ 30.
        V_PRICE_USD = IT_MLCRP-PVPRS_NEW.
      ELSEIF IT_MLCRP-CURTP EQ 10.
        V_PRICE_IDR = IT_MLCRP-PVPRS_NEW * 100.
      ENDIF.
    ELSE.
      IF IT_MLCRP-CURTP EQ 30.
        V_PRICE_USD = IT_MLCRP-STPRS_NEW.
      ELSEIF IT_MLCRP-CURTP EQ 10.
        V_PRICE_IDR = IT_MLCRP-STPRS_NEW * 100.
      ENDIF.
    ENDIF.
  ENDLOOP.

  IF V_PRICE_USD EQ INPUT.
    OUTPUT = V_PRICE_IDR.
  ENDIF.
ENDFORM.                    "GET_IDR