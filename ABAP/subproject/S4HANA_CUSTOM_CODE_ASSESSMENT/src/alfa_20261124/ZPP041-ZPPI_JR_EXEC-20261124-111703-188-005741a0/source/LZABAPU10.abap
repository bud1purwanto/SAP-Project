FUNCTION ZMM_ROLLBACK_MAT_TO_MAT.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(MATNR_I) TYPE  MATNR
*"     REFERENCE(CHARG_I) TYPE  CHARG_D
*"     REFERENCE(WERKS_I) TYPE  WERKS_D
*"     REFERENCE(LGORT_I) TYPE  LGORT_D
*"     REFERENCE(MATNR_O) TYPE  MATNR
*"     REFERENCE(CHARG_O) TYPE  CHARG_D
*"     REFERENCE(AUFNR) TYPE  AUFNR
*"  EXPORTING
*"     REFERENCE(MBLNR) TYPE  MBLNR
*"     REFERENCE(MJAHR) TYPE  MJAHR
*"  TABLES
*"      MESSAGE STRUCTURE  BAPIRET2
*"----------------------------------------------------------------------

  "Data Create
  DATA: IT_RETURN       LIKE STANDARD TABLE OF BAPIRET2 WITH HEADER LINE,
        V_MSG           TYPE C LENGTH 100.

  CLEAR: MESSAGE, IT_RETURN.
  REFRESH: MESSAGE, IT_RETURN.

  "Transfer Posting
  DATA: IT_HEADER     TYPE BAPI2017_GM_HEAD_01,
        IT_CODE       TYPE BAPI2017_GM_CODE,
        IT_MATDOC     TYPE BAPI2017_GM_HEAD_RET,
        IT_ITEM       TYPE BAPI2017_GM_ITEM_CREATE OCCURS 0 WITH HEADER LINE.

  "Check Order for SBU
  DATA: V_AUFNR_SBU TYPE AUFNR.
  SELECT SINGLE AUFK~AUFNR INTO V_AUFNR_SBU
    FROM AUFK JOIN AFPO ON AUFK~AUFNR EQ AFPO~AUFNR
   WHERE ZSBUORDER EQ AUFNR
     AND MATNR EQ MATNR_O
     AND WERKS EQ WERKS_I
     AND AUART EQ 'ZMMS'.

  "Transaction Code
  IT_CODE-GM_CODE       = '06'. "Posting GI/GR
  "Header
  IT_HEADER-PSTNG_DATE  = SY-DATUM.
  IT_HEADER-DOC_DATE    = SY-DATUM.
  IT_HEADER-PR_UNAME    = SY-UNAME.
  IT_HEADER-HEADER_TXT  = CHARG_I.

  CLEAR: IT_ITEM-ENTRY_QNT.

  "Scrap move all stock
  SELECT SINGLE CLABS INTO IT_ITEM-ENTRY_QNT
    FROM MCHB
   WHERE MATNR EQ MATNR_O
     AND CHARG EQ CHARG_O
     AND WERKS EQ WERKS_I
     AND LGORT EQ LGORT_I.

  "If zero then exit
  IF IT_ITEM-ENTRY_QNT IS INITIAL.
    EXIT.
  ENDIF.

  IT_ITEM-QUANTITY = IT_ITEM-ENTRY_QNT.
  SELECT SINGLE MEINS MEINS INTO (IT_ITEM-ENTRY_UOM, IT_ITEM-BASE_UOM)
    FROM MARA
   WHERE MATNR EQ MATNR_O.

  "Item
  IT_ITEM-MATERIAL      = MATNR_I.
  IT_ITEM-PLANT         = WERKS_I.
  IT_ITEM-BATCH         = CHARG_I.
  IT_ITEM-STGE_LOC      = LGORT_I.
  IT_ITEM-MOVE_TYPE     = '262'.
  IT_ITEM-ORDERID       = V_AUFNR_SBU.
  APPEND IT_ITEM.

  "Item
  IT_ITEM-MATERIAL      = MATNR_O.
  IT_ITEM-PLANT         = WERKS_I.
  IT_ITEM-BATCH         = CHARG_O.
  IT_ITEM-STGE_LOC      = LGORT_I.
  IT_ITEM-MOVE_TYPE     = '532'.
  IT_ITEM-ORDERID       = V_AUFNR_SBU.
  APPEND IT_ITEM.

  CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
    EXPORTING
      GOODSMVT_HEADER  = IT_HEADER
      GOODSMVT_CODE    = IT_CODE
    IMPORTING
      GOODSMVT_HEADRET = IT_MATDOC
    TABLES
      GOODSMVT_ITEM    = IT_ITEM
      RETURN           = IT_RETURN.

  READ TABLE IT_RETURN WITH KEY TYPE = 'E'.
  IF SY-SUBRC = 0.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.

    CONCATENATE 'Rollback Posting:' IT_RETURN-MESSAGE INTO V_MSG SEPARATED BY SPACE.
    MESSAGE-TYPE        = IT_RETURN-TYPE.
    MESSAGE-ID          = IT_RETURN-ID.
    MESSAGE-NUMBER      = IT_RETURN-NUMBER.
    MESSAGE-MESSAGE     = V_MSG.
    MESSAGE-MESSAGE_V1  = IT_RETURN-MESSAGE_V1.
    MESSAGE-MESSAGE_V2  = IT_RETURN-MESSAGE_V2.
    MESSAGE-MESSAGE_V3  = IT_RETURN-MESSAGE_V3.
    MESSAGE-MESSAGE_V4  = IT_RETURN-MESSAGE_V4.
    APPEND MESSAGE.
    EXIT.
  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
      EXPORTING
        WAIT = 'X'.

    MBLNR = IT_MATDOC-MAT_DOC.
    MJAHR = IT_MATDOC-DOC_YEAR.

  ENDIF.
ENDFUNCTION.