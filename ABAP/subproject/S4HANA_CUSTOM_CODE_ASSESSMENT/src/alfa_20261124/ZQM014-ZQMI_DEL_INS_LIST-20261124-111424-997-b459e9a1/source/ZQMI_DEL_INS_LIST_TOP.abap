TABLES : QALS, LIPS, QASE.
data: v_prog like Zproginfo-PGMNA value 'ZQMI_DEL_INS_LIST'.
DATA: LS_REF1 TYPE REF TO CL_GUI_ALV_GRID.
DATA : OKCODE TYPE SY-UCOMM.
CONTROLS: TCDEL TYPE TABLEVIEW USING SCREEN 0100.
DATA : G_TCOUT_LINES  LIKE SY-LOOPC.
DATA  RET_CODE LIKE SY-SUBRC.
DATA : ZTEXT TYPE STRING.

*&SPWIZARD: DECLARATION OF TABLECONTROL 'TCPOP' ITSELF
CONTROLS: TCPOP TYPE TABLEVIEW USING SCREEN 0150.

TYPES : BEGIN OF TY_LIST,
          NO TYPE I,
          VBELN LIKE QALS-LS_VBELN, "Delivery Order
          PRUEFLOS LIKE QALS-PRUEFLOS, "Inspection Lot
          ENSTEHDAT LIKE QALS-ENSTEHDAT, " Inpsection Date
          VNAME(12), " LIKE QAVE-VNAME, "Inspector
          VCODE LIKE QAVE-VCODE, "Usage Desicion
          WERK LIKE QALS-WERK,
        END OF TY_LIST,

        BEGIN OF TY_EXEC,
          NO TYPE I,
          VBELN LIKE QALS-LS_VBELN, "Delivery Order
          PRUEFLOS LIKE QALS-PRUEFLOS, "Inspection Lot
          ENSTEHDAT LIKE QALS-ENSTEHDAT, " Inpsection Date
          USDEC LIKE QAVE-VCODE, "Usage Decision
          EXIDV LIKE VEKP-EXIDV, "Hu No
          VENUM LIKE VEKP-VENUM,
          STAT35 LIKE QALS-STAT35,
          POSNR LIKE VEPO-POSNR, "Qty 1 HU
          RESOK(1), "Result OK
          RESNOK(1), "Result NOT OK
          INSPE(12), " LIKE QAVE-VNAME, "Inspector / Nomor Induk Karyawan
          SDATA(10), "Source Data
          STATUS(1), "Error/Not Error
          WERK LIKE QALS-WERK,
          MAGRV LIKE VEKP-MAGRV,
        END OF TY_EXEC.

DATA : IT_LIST TYPE TY_LIST OCCURS 0 WITH HEADER LINE,
       WA_LIST LIKE LINE OF IT_LIST,
       IT_EXEC TYPE TY_EXEC OCCURS 0 WITH HEADER LINE,
       IT_EXEC2 TYPE TY_EXEC OCCURS 0 WITH HEADER LINE,
       IT_EXPAR TYPE TY_EXEC OCCURS 0 WITH HEADER LINE,
       IT_EXERR TYPE TY_EXEC OCCURS 0 WITH HEADER LINE,
       IT_EXEC2NOK TYPE TY_EXEC OCCURS 0 WITH HEADER LINE,
       WA_EXEC LIKE LINE OF IT_EXEC,
       WA_QAVE TYPE QAVE.

DATA : CTR TYPE I,
       VCODE LIKE QAVE-VCODE,
       P_FILE LIKE RLGRAP-FILENAME,
       VENUM LIKE VEPO-VENUM,
       EXIDV LIKE VEKP-EXIDV,
       WERK LIKE QALS-WERK.

*internal table for data uploded and downloaded from PDA in EXECUTION PROCESS
DATA : BEGIN OF IT_FPDA OCCURS 0,  "FROM PDA
        INSPE(12),"INSPECTOR NIK
        VBELN(10), "DELIVERY ORDER
        PRUEFLOS(12), "INSPECTION LOT
        EXIDV(10), "HU No.
        POSNR(6), "QTY 1 HU
        RESOK(1), "Result OK
       END OF IT_FPDA.
*internal table for converting uploaded data into table control
DATA : IT_EFPDA TYPE TY_EXEC OCCURS 0 WITH HEADER LINE.

DATA : BEGIN OF IT_TPDA OCCURS 0, "TO PDA
        VBELN(10), "DELIVERY ORDER
        PRUEFLOS(12), "INSPECTION LOT
        EXIDV(10), "HU No.
        POSNR(6), "QTY 1 HU
       END OF IT_TPDA.

DATA : R(1). "status hasil upload from PDA
*internal table for counting qty
TYPES : BEGIN OF TY_VEPO,
           PEXIDV LIKE VEKP-EXIDV,
           VENUM LIKE VEPO-VENUM,
           UNVEL LIKE VEPO-UNVEL,
           QTY TYPE I,
        END OF TY_VEPO.

DATA : BEGIN OF IT_VEKP OCCURS 0, "level Pallet
        NO TYPE I,
        EXIDV LIKE VEKP-EXIDV,
        VENUM LIKE VEKP-VENUM,
       END OF IT_VEKP,
       IT_VEPO TYPE TY_VEPO OCCURS 0 WITH HEADER LINE,
       IT_VEPOR TYPE TY_VEPO OCCURS 0 WITH HEADER LINE,
       IT_VEPOR1 TYPE TY_VEPO OCCURS 0 WITH HEADER LINE,
       IT_HUQTY TYPE TY_VEPO OCCURS 0 WITH HEADER LINE,
       WA_VEPO LIKE STANDARD TABLE OF VEPO WITH HEADER LINE.

DATA : IT_ZTDELINSP_I TYPE ZTDELINSP_I OCCURS 0 WITH HEADER LINE,
       WA_ZTDELINSP_I LIKE LINE OF IT_ZTDELINSP_I.

*list unprocessed INSLOT
DATA : BEGIN OF IT_INSLOT OCCURS 0,
        INSLOT(40),
       END OF IT_INSLOT,
       WA_INSLOT LIKE LINE OF IT_INSLOT.

DATA : FIELDS LIKE HELP_VALUE OCCURS 0 WITH HEADER LINE.

DATA : BEGIN OF IT_INERR OCCURS 0.
          INCLUDE TYPE TY_EXEC.
DATA :  VANSWER(1).
DATA:     ERROR(200).
DATA:  END OF IT_INERR,
       WA_INERR LIKE LINE OF IT_INERR.

DATA : BEGIN OF IT_ERROR OCCURS 0,
        ERROR(150),
       END OF IT_ERROR,
       WA_ERROR LIKE LINE OF IT_ERROR.

DATA : IT_EXEC3 TYPE TY_EXEC OCCURS 0 WITH HEADER LINE,
       IT_QALT TYPE QALT OCCURS 0 WITH HEADER LINE,
       WA_QALT LIKE LINE OF IT_QALT.

*UNTUK UD YANG STATUSNYA HOLD
DATA :  IT_HOLD TYPE TY_EXEC OCCURS 0 WITH HEADER LINE.

DATA : IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE,
       WA_BDCMSGCOLLD LIKE LINE OF IT_BDCMSGCOLL,
       BEGIN OF IT_BDCMSGCOLLD OCCURS 0,
         VBELN(10).
         INCLUDE STRUCTURE BDCMSGCOLL.
DATA : END OF IT_BDCMSGCOLLD.
DATA : BEGIN OF IT_POPMSG OCCURS 0,
          FLAG(1),
          NO TYPE I,
          DATA(20),
          MESSAGE(100),
       END OF IT_POPMSG,
       WA_POPMSG LIKE LINE OF IT_POPMSG.

DATA : BEGIN OF IT_ERRINSPECTOR OCCURS 0,
        PRUEFLOS(12),
        ERRROR(150),
       END OF IT_ERRINSPECTOR,
       WA_ERRINSPECTOR LIKE LINE OF IT_ERRINSPECTOR.

