       ABSTA LIKE VBUP-ABSTA,
       GBSTA LIKE VBUP-GBSTA,
       AUART LIKE VBAK-AUART,
       ST TYPE C,
       TCUOBJ LIKE VBAP-CUOBJ.
DATA : OKCODE TYPE SY-UCOMM,
       ATWTB1 TYPE C  LENGTH 30,
       ATWTB2 TYPE C  LENGTH 30.
DATA: BEGIN OF T_ERRORS OCCURS 0,
        TYPE(1),
        MSG(100),
        VBELN LIKE LIKP-VBELN,
        LGNUM LIKE LIKP-LGNUM,
      END OF T_ERRORS.
DATA: IT_LIPS LIKE LIPS OCCURS 0  WITH HEADER LINE.
DATA : IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE.
DATA : OPT LIKE CTU_PARAMS.

DATA : BEGIN OF ITAB_DATA OCCURS 10,
          POST_DATE(10),
          MOV_TYPE(04),
          PLANT(04),
          SLOC(04),
          SPEC_STOCK(01),
          SO_STOCK(10),
          SOITEM_STOCK(06),
          SALES_ORDER(10),
          SALES_ORDER_ITEM(06),
          ISSUE_SLOC(04),
          MATERIAL(18),
          QUANT(16),
          UOM(03),
          BATCH(10),
          OBATCH TYPE STRING,
          KALAB LIKE MSKA-KALAB,
          KAEIN LIKE MSKA-KAEIN, "Added by Annisa Wibowo at 27.07.2022 for Tcode ZSD008A Restricted
          VENUM LIKE VEPO-VENUM,
          SONUM LIKE VEPO-SONUM,
          EXIDV LIKE VEKP-EXIDV,
          UEVEL LIKE VEKP-UEVEL,
          UNVEL LIKE VEPO-UNVEL,
          LGORT LIKE T320-LGORT,
          WN TYPE C,
          BOX TYPE CHECKBOX,
          PSTAT LIKE ZQM001-PSTAT,
       END OF ITAB_DATA.
DATA: BEGIN OF IT_REPORT OCCURS 10,
        BUDAT  TYPE  CHAR10,
        MATNR  LIKE  MARA-MATNR,
        CHARG  LIKE  MCHB-CHARG,
        WERKS  LIKE  MSEG-WERKS,
        LGORT  LIKE  MSEG-LGORT,
        MENGE  TYPE  CHAR16,
        MEINS  LIKE  MSEG-MEINS,
        SONU1  LIKE  VBAP-VBELN,
        SOIT1  LIKE  VBAP-POSNR,
        SONU2  LIKE  VBAP-VBELN,
        SOIT2  LIKE  VBAP-POSNR,
      END OF IT_REPORT.
DATA: BEGIN OF IT_ATNAM OCCURS 0,
      ATNAM TYPE C LENGTH 30,
      ATBEZ LIKE CABNT-ATBEZ.
DATA: END OF IT_ATNAM.
DATA: BEGIN OF ERRMSG OCCURS 10.
        INCLUDE STRUCTURE BAPIRET2.
DATA: END OF ERRMSG.
DATA: BEGIN OF ITAB OCCURS 10.
        INCLUDE STRUCTURE BAPI2017_GM_ITEM_CREATE.
DATA: END OF ITAB.
DATA: BEGIN OF GMHEAD.
        INCLUDE STRUCTURE BAPI2017_GM_HEAD_01.
DATA: END OF GMHEAD.

DATA: BEGIN OF GMCODE.
        INCLUDE STRUCTURE BAPI2017_GM_CODE.
DATA: END OF GMCODE.
DATA: BEGIN OF MTHEAD.
        INCLUDE STRUCTURE BAPI2017_GM_HEAD_RET.
DATA: END OF MTHEAD.
DATA: BEGIN OF IT_SOPOP OCCURS 0.
        INCLUDE STRUCTURE SVAL.
DATA: END OF IT_SOPOP.
DATA: ITAB_DATA1 LIKE STANDARD TABLE OF ITAB_DATA WITH HEADER LINE,
      ITAB_DATA2 LIKE STANDARD TABLE OF ITAB_DATA WITH HEADER LINE,
      ITAB_LOG LIKE STANDARD TABLE OF ITAB_DATA WITH HEADER LINE,
      ITAB_LOG1 LIKE STANDARD TABLE OF ITAB_DATA WITH HEADER LINE,
      CONFIG LIKE STANDARD TABLE OF CONF_OUT WITH HEADER LINE,
      TBATCH LIKE STANDARD TABLE OF CLBATCH WITH HEADER LINE.

