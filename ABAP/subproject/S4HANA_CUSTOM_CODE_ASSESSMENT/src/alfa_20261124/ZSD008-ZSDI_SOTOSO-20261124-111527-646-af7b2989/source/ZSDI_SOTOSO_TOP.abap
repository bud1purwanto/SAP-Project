TABLES: MSEG,VEPO,VEKP.
INCLUDE OLE2INCL.
DATA : DATASET1 TYPE STRING,
       FLAG(1),
       ERRFLAG,
       V_MSG LIKE BAPIRET2-MESSAGE,
       V_INDEX TYPE I,
       RETURNCODE(1) TYPE C,
       TVENUM LIKE VEPO-SONUM,
       TEXIDV LIKE VEKP-EXIDV,
       TSO LIKE VBAP-VBELN,
       TSOITEM LIKE VBAP-POSNR,
       STAT TYPE C,
       TERR TYPE C LENGTH 50,
       MSG1 TYPE C LENGTH 50,
       MSG2 TYPE C LENGTH 50,
       V_PROG LIKE ZPROGINFO-PGMNA VALUE 'ZSDI_SOTOSO',
