TABLES : VEKP, VEPO.

TYPES : BEGIN OF TYDATA,
          EXIDV    LIKE VEKP-EXIDV, "NO HANDLING UNIT
          SLOCT    LIKE VEPO-UNVEL, "SLOC TUJUAN
          SLOCA    LIKE VEKP-LGORT, "SLOC AWAL
          STATUS   LIKE TJ30T-TXT04, "USER STATUS
          WERKS    LIKE VEPO-WERKS,  "PLANT
          MATDOC   TYPE MBLNR, "MATDOC NO.
          MARK(1)  TYPE C,
          KET      TYPE STRING, " Modified by William at 19.02.2026 (longer messages)
          CELLCOLOR TYPE LVC_T_SCOL,
        END OF TYDATA.

TYPES : BEGIN OF TYDATA1,
          EXIDV    LIKE VEKP-EXIDV, "NO HANDLING UNIT
          SLOCT    LIKE VEPO-UNVEL, "SLOC TUJUAN
          SLOCA    LIKE VEKP-LGORT, "SLOC AWAL
          STATUS   LIKE TJ30T-TXT04, "USER STATUS
          WERKS    LIKE VEPO-WERKS,  "PLANT
          MATDOC   TYPE MBLNR, "MATDOC NO.
          MARK(1)  TYPE C,
          KET      TYPE STRING, " Modified by William at 19.02.2026 (longer messages)
        END OF TYDATA1.

TYPES : BEGIN OF TYSLOC,
          SLOC LIKE ZHU_MAPP-LGOR2,
        END OF TYSLOC.

DATA : BEGIN OF ITTAB,
          EXIDV LIKE VEKP-EXIDV, "NO HANDLING UNIT
          SLOCT LIKE VEKP-LGORT, "SLOC TUJUAN
          MATDOC TYPE SYMSGV, "MATDOC NO.
       END OF ITTAB.

DATA : ITDATA TYPE TABLE OF TYDATA WITH HEADER LINE,
       ITALV TYPE TABLE OF TYDATA WITH HEADER LINE,
       ITAB TYPE TYDATA1 OCCURS 0 WITH HEADER LINE ,
       ITAB1 TYPE TYDATA OCCURS 0 WITH HEADER LINE ,
       WADATA TYPE TYDATA,
       WA_DATA TYPE TYDATA1,
       WA_PSOURCE TYPE ZPACK_PCL,
       T_PSOURCE TYPE TABLE OF ZPACK_PCL,
       ITSLOCT TYPE TABLE OF TYSLOC WITH HEADER LINE.


DATA : OKCODE TYPE SY-UCOMM.
*&SPWIZARD: DECLARATION OF TABLECONTROL 'TCHU' ITSELF
CONTROLS: TCHU TYPE TABLEVIEW USING SCREEN 0100.

DATA  : P_FILE  TYPE STRING,
        FNAME   TYPE STRING,
        FPATH   TYPE IBIPPARMS-PATH,
        VENUM   TYPE VEKP-VENUM,
        VMATNR  TYPE MARA-MATNR,
        UNVEL TYPE VEPO-UNVEL,
        OBJNR   TYPE HUSTOBJ-OBJNR,
        VLGNUM TYPE MLGT-LGNUM,
        MESSAGE(100) TYPE C,
        EKS(3)  TYPE C, "EKSTENSION.
        DD      TYPE C LENGTH 2,
        MM      TYPE C LENGTH 2,
        YYYY    TYPE C LENGTH 4,
        DATE    TYPE C LENGTH 8.

"DATA FOR LOCKING OBJECT
DATA :  LOCKLIST TYPE TABLE OF SEQG3,
        WLOCKLIST TYPE SEQG3,
        LOCKOBJECT TYPE EQEGRAARG.

DATA : P1(1) TYPE C ,
       P2(1) TYPE C.
*       P3(1) TYPE C ,
*       P4(1) TYPE C .

"DATA FOR BDC
DATA : IT_BDCDATA LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE.

"Call BAPI
DATA : IF_EVENT TYPE HUWBEVENT VALUE '0006',
       IF_TCODE TYPE SYTCODE VALUE 'VLMOVE',
       IT_EXTERNAL_ID TYPE  HUM_EXIDV_T WITH HEADER LINE,
       IT_MOVE_TO TYPE HUM_DATA_MOVE_TO_T WITH HEADER LINE,
       ET_MESSAGES TYPE HUITEM_MESSAGES_T WITH HEADER LINE,
       ES_MESSAGE  TYPE TABLE OF HUITEM_MESSAGES WITH HEADER LINE,
       THEADER     TYPE TABLE OF BAPI2017_GM_HEAD_RET WITH HEADER LINE,
       IT_RET      TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
       LS_SUBRC    TYPE SY-SUBRC.

" VARIABEL RANGE TO SAVE DATA SLOC FROM TABLE ZHU_MAPP
DATA : TSLOC TYPE RANGE OF ZHU_MAPP-LGOR2,
       WSLOC LIKE LINE OF TSLOC.

DATA  : VLINE TYPE I,
        MJAHR TYPE MJAHR.

DATA  L_ERRNO TYPE I.

