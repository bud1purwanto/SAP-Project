*&---------------------------------------------------------------------*
*&  Include           ZMM_GRN_PO_CKI_GET_CHAR_VAL
*&---------------------------------------------------------------------*
FORM GET_CHAR_VAL USING
  BATCH_NUM LIKE VM07M-LICHA
  MATNR LIKE MSEG-MATNR
  NEW_BATCH LIKE MSEG-CHARG.

  DATA :  OBJECT_ID LIKE AUSP-OBJEK,
          NO_ROLL_TYB LIKE AUSP-ATWRT,
          NO_LOT_TYB LIKE AUSP-ATWRT,
          PACKING LIKE AUSP-ATWRT,
          PACKINGCODE LIKE AUSP-ATWRT,
          NO_ROLL LIKE AUSP-ATWRT,
          V_PROGRESS TYPE N VALUE 0,
          V_COUNT(10) TYPE N,
          V_TEXT(132) TYPE C,
          BDCDATA LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
          MODE(1) TYPE C VALUE 'N',
          L_TA_MSG TYPE STANDARD TABLE OF BDCMSGCOLL WITH HEADER LINE,
          UPDATE(1) TYPE C VALUE 'S'.

  DATA: BDC_DATA LIKE BDCDATA OCCURS 1000 WITH HEADER LINE,
        WA_L_TA_MSG LIKE BDCMSGCOLL.

  DEFINE BDC_DYNPRO.
    CLEAR &1.
    &1-PROGRAM = &2.
    &1-DYNPRO = &3.
    &1-DYNBEGIN = 'X'.
    APPEND &1.
  END-OF-DEFINITION.

  DEFINE BDC_FIELD.
    CLEAR &1.
    &1-FNAM = &2.
    &1-FVAL = &3.
    APPEND &1.
  END-OF-DEFINITION.

  SELECT SINGLE MCH1~CUOBJ_BM INTO OBJECT_ID
    FROM MCH1
    WHERE MCH1~CHARG = BATCH_NUM.

  SELECT SINGLE AUSP~ATWRT INTO NO_ROLL_TYB
    FROM AUSP JOIN CABN ON AUSP~ATINN = CABN~ATINN
    WHERE CABN~ATNAM EQ 'ZZNOROLLTOYOBO'
    AND AUSP~OBJEK EQ OBJECT_ID.

  SELECT SINGLE AUSP~ATWRT INTO NO_LOT_TYB
    FROM AUSP JOIN CABN ON AUSP~ATINN = CABN~ATINN
    WHERE CABN~ATNAM EQ 'ZZNOLOTTOYOBO'
    AND AUSP~OBJEK EQ OBJECT_ID.

  SELECT SINGLE AUSP~ATWRT INTO PACKING
    FROM AUSP JOIN CABN ON AUSP~ATINN = CABN~ATINN
    WHERE CABN~ATNAM EQ 'ZZPACKING'
    AND AUSP~OBJEK EQ OBJECT_ID.

  SELECT SINGLE AUSP~ATWRT INTO PACKINGCODE
    FROM AUSP JOIN CABN ON AUSP~ATINN = CABN~ATINN
    WHERE CABN~ATNAM EQ 'ZZPACKINGCODE'
    AND AUSP~OBJEK EQ OBJECT_ID.

  SELECT SINGLE AUSP~ATWRT INTO NO_ROLL
    FROM AUSP JOIN CABN ON AUSP~ATINN = CABN~ATINN
    WHERE CABN~ATNAM EQ 'ZZNOMORROLL'
    AND AUSP~OBJEK EQ OBJECT_ID.

    REFRESH BDC_DATA[].

    BDC_DYNPRO   BDC_DATA 'SAPMM03S'             '0105'.
    BDC_FIELD    BDC_DATA 'BDC_OKCODE'           '/00'.
    BDC_FIELD    BDC_DATA 'RM03S-MATNR'          MATNR.
    BDC_FIELD    BDC_DATA 'RM03S-CHARG'          NEW_BATCH.

    BDC_DYNPRO   BDC_DATA 'SAPMM03S'             '0200'.
    BDC_FIELD    BDC_DATA 'BDC_OKCODE'           '=CLAS'.

    BDC_DYNPRO   BDC_DATA 'SAPLCTMS'              '0109'.
    BDC_FIELD    BDC_DATA 'BDC_OKCODE'            '=BACK'.

    BDC_FIELD    BDC_DATA 'RCTMS-MNAME(01)'       'ZZPACKING'.
    BDC_FIELD    BDC_DATA 'RCTMS-MWERT(01)'       PACKING.
    BDC_FIELD    BDC_DATA 'RCTMS-MNAME(02)'       'ZZPACKINGCODE'.
    BDC_FIELD    BDC_DATA 'RCTMS-MWERT(02)'       PACKINGCODE.
    BDC_FIELD    BDC_DATA 'RCTMS-MNAME(03)'       'ZZSPECIALTOUCH-1'.
    BDC_FIELD    BDC_DATA 'RCTMS-MWERT(03)'       NO_ROLL.

    BDC_FIELD    BDC_DATA 'RCTMS-MNAME(04)'       'ZZNOROLLTOYOBO'.
    BDC_FIELD    BDC_DATA 'RCTMS-MWERT(04)'       NO_ROLL_TYB.
    BDC_FIELD    BDC_DATA 'RCTMS-MNAME(05)'       'ZZNOLOTTOYOBO'.
    BDC_FIELD    BDC_DATA 'RCTMS-MWERT(05)'       NO_LOT_TYB.

    BDC_DYNPRO   BDC_DATA 'SAPMM03S'              '0200'.
    BDC_FIELD    BDC_DATA 'BDC_OKCODE'            '=BU'.

    CALL TRANSACTION 'MSC2' USING BDC_DATA MODE MODE UPDATE UPDATE MESSAGES INTO L_TA_MSG.

    COMMIT WORK AND WAIT.

ENDFORM.                    "GET_CHAR_VAL