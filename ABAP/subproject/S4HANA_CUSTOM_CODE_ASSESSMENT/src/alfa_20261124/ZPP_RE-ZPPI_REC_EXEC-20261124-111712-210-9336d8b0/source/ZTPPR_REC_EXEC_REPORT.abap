*&---------------------------------------------------------------------*
*& Report  ZPPR_REC_EXEC_REPORT
*&
*&---------------------------------------------------------------------*
*&
*&
*&---------------------------------------------------------------------*

REPORT  ZTPPR_REC_EXEC_REPORT.
INCLUDE ZINCL_ERP_SQL.
TABLES: MSEG, AUFK, MKPF, ZERROR_LOG.


DATA: BEGIN OF IT_DISPLAY OCCURS 0,
        AUFNR LIKE AUFK-AUFNR,
        MATNR LIKE MARA-MATNR,
        BWART LIKE MSEG-BWART,
        BUDAT LIKE MKPF-BUDAT,
        BLDAT LIKE MKPF-BLDAT,
        CPUDT LIKE MKPF-CPUDT,
        CPUTM LIKE MKPF-CPUTM,
        USNAM TYPE C LENGTH 13,
        WERKS LIKE MSEG-WERKS,
        LGORT LIKE MSEG-LGORT,
        MENGE LIKE MSEG-MENGE,
        MEINS LIKE MSEG-MEINS,
        WEMPF TYPE WEMPF,
        LINE  TYPE ZSPR_LINE,
        FILM  TYPE ZZFILM,
        TGL   TYPE DATS,
        MBLNR LIKE MSEG-MBLNR,
        MJAHR LIKE MSEG-MJAHR,
        SMBLN LIKE MSEG-SMBLN,
        ABLAD TYPE MSEG-ABLAD,
        SGTXT TYPE MSEG-SGTXT,
        BKTXT TYPE MKPF-BKTXT,
        GRUND TYPE MSEG-GRUND,
        VTERMINAL TYPE C LENGTH 30,
        VGROUP TYPE ZGROUP-ZZGROUP,
      END OF IT_DISPLAY.

DATA: IT_DISPLAY2 LIKE IT_DISPLAY OCCURS 0 WITH HEADER LINE.
FIELD-SYMBOLS: <FS_DISPLAY2> LIKE LINE OF IT_DISPLAY2.

TYPES: BEGIN OF TYPE_CHAR,
     VALUE_CHAR TYPE ATWRT,
     DESCRIPTION TYPE ATWTB,
END OF TYPE_CHAR.

DATA ITAB_CHAR TYPE STANDARD TABLE OF TYPE_CHAR WITH HEADER LINE.
DATA IT_RETVAL TYPE STANDARD TABLE OF DDSHRETVAL WITH HEADER LINE.
DATA IT_VALS TYPE TABLE OF BAPICHARACTVALUESDESCR WITH HEADER LINE.
DATA D_RETVAL TYPE STANDARD TABLE OF BAPIRET2 WITH HEADER LINE.

TYPE-POOLS: SLIS.
DATA: GS_LAYOUT TYPE SLIS_LAYOUT_ALV,
      G_EXIT_CAUSED_BY_CALLER,
      GS_EXIT_CAUSED_BY_USER TYPE SLIS_EXIT_BY_USER,
      GT_FIELDCAT TYPE SLIS_T_FIELDCAT_ALV WITH HEADER LINE,
      G_REPID LIKE SY-REPID,
      Y_PRINT TYPE SLIS_PRINT_ALV.

DATA:
      GT_EVENTS TYPE SLIS_T_EVENT,
      GT_LIST_TOP_OF_PAGE TYPE SLIS_T_LISTHEADER,
      G_STATUS_SET TYPE SLIS_FORMNAME VALUE 'PF_STATUS_SET',
      G_USER_COMMAND TYPE SLIS_FORMNAME VALUE 'USER_COMMAND',
      G_TOP_OF_PAGE TYPE SLIS_FORMNAME VALUE 'TOP_OF_PAGE',
      G_TOP_OF_LIST TYPE SLIS_FORMNAME VALUE 'TOP_OF_LIST',
      G_END_OF_LIST TYPE SLIS_FORMNAME VALUE 'END_OF_LIST'.

DATA : GS_VARIANT LIKE DISVARIANT, G_SAVE.


SELECTION-SCREEN BEGIN OF BLOCK BLOCK1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS :   ZAUFNR FOR MSEG-AUFNR OBLIGATORY,
                   ZPOSDT FOR MKPF-BUDAT NO-DISPLAY,
                   ZBWART FOR MSEG-BWART  NO-DISPLAY,
                   ZUSNAM FOR MSEG-USNAM_MKPF  NO-DISPLAY NO INTERVALS NO-EXTENSION,
                   ZMATNR FOR MSEG-MATNR  NO-DISPLAY,
                   ZPLANT FOR MSEG-WERKS  NO-DISPLAY,
                   ZLGORT FOR MSEG-LGORT  NO-DISPLAY,
                   ZWEMPF FOR MSEG-WEMPF  NO-DISPLAY NO INTERVALS,
                   ZMBLNR FOR MSEG-MBLNR  NO-DISPLAY,
                   ZMJAHR FOR MSEG-MJAHR  NO-DISPLAY,
                   ZFILM  FOR ZERROR_LOG-FILM  NO-DISPLAY NO INTERVALS NO-EXTENSION,
                   ZLINE  FOR ZERROR_LOG-LINE  NO-DISPLAY NO INTERVALS NO-EXTENSION.
SELECTION-SCREEN END OF BLOCK BLOCK1.


*AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZBWART-LOW.
*  PERFORM GET_BWART.
*
*AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZBWART-HIGH.
*  PERFORM GET_BWART.
*
*AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZFILM-LOW.
*  PERFORM GET_FILM.
*
*AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZLINE-LOW.
*  PERFORM GET_LINE.
*
*AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZWEMPF-LOW.
*  PERFORM GET_ZWEMPF.
*
*AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZLGORT-LOW.
*  PERFORM GET_SO_LGORT.


START-OF-SELECTION.
  PERFORM CHECK_SERVER.
  PERFORM GET_DETAIL.
  INSERT_LOG_SQL IT_DISPLAY2 AUFNR 'ZTPP_RE'.

  IF IT_DISPLAY2[] IS INITIAL.
    VARSTATUS = '0'. "VARMSG = ''.
    PERFORM UPDATE_LOG_SQL.
  ELSE.
    PERFORM INSERT_SQL.
    PERFORM UPDATE_LOG_SQL.
  ENDIF.

*&---------------------------------------------------------------------*
*&      Form  GET_DETAIL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DETAIL.
*  LV =  100 / 0.
  IF ZBWART-LOW EQ ' ' AND ZBWART-HIGH EQ ' '.

    SELECT MSEG~AUFNR MSEG~MATNR MSEG~BWART MKPF~BUDAT MKPF~BLDAT MKPF~CPUDT MKPF~CPUTM MKPF~BKTXT MSEG~WERKS
           MSEG~LGORT MSEG~MENGE MSEG~MEINS MSEG~WEMPF MSEG~ABLAD MSEG~MBLNR MSEG~MJAHR MSEG~SMBLN MSEG~SGTXT
           MSEG~GRUND
     INTO CORRESPONDING FIELDS OF TABLE IT_DISPLAY
     FROM MSEG
     JOIN MKPF ON MKPF~MBLNR = MSEG~MBLNR
     JOIN AUFK ON AUFK~AUFNR = MSEG~AUFNR
    WHERE MSEG~AUFNR IN ZAUFNR
    AND   MSEG~BUDAT_MKPF IN ZPOSDT
    AND   MSEG~BWART IN ('101', '102', '261', '262')
*   AND   MSEG~USNAM_MKPF IN ZUSNAM
    AND   MSEG~MATNR IN ZMATNR
    AND   MSEG~WERKS IN ZPLANT
    AND   MSEG~LGORT IN ZLGORT
    AND   MSEG~WEMPF IN ZWEMPF
    AND   MSEG~MBLNR IN ZMBLNR
    AND   MSEG~MJAHR IN ZMJAHR
    AND   AUFK~AUART IN ('ZR01', 'ZR02').

    IF ZUSNAM IS NOT INITIAL.
      LOOP AT IT_DISPLAY WHERE BKTXT+12(13) = ZUSNAM-LOW.
        IT_DISPLAY-USNAM = IT_DISPLAY-BKTXT+12(13).
        IT_DISPLAY-FILM = IT_DISPLAY-SGTXT+0(3).
        IT_DISPLAY-LINE = IT_DISPLAY-SGTXT+4(1).
        IT_DISPLAY-VTERMINAL = IT_DISPLAY-SGTXT+6(30).
        APPEND IT_DISPLAY TO IT_DISPLAY2.
      ENDLOOP.
    ELSE.
      LOOP AT IT_DISPLAY.
        IT_DISPLAY-USNAM = IT_DISPLAY-BKTXT+12(13).
        IT_DISPLAY-FILM = IT_DISPLAY-SGTXT+0(3).
        IT_DISPLAY-LINE = IT_DISPLAY-SGTXT+4(1).
        IT_DISPLAY-VTERMINAL = IT_DISPLAY-SGTXT+6(30).
        APPEND IT_DISPLAY TO IT_DISPLAY2.
      ENDLOOP.
    ENDIF.

    IF ZFILM-LOW IS NOT INITIAL AND ZLINE-LOW IS INITIAL.
      LOOP AT IT_DISPLAY2 WHERE FILM NE ZFILM-LOW.
        DELETE IT_DISPLAY2.
      ENDLOOP.
    ELSEIF ZFILM-LOW IS INITIAL AND ZLINE-LOW IS NOT INITIAL.
      LOOP AT IT_DISPLAY2 WHERE LINE NE ZLINE-LOW.
        DELETE IT_DISPLAY2.
      ENDLOOP.
    ELSEIF ZFILM-LOW IS NOT INITIAL AND ZLINE-LOW IS NOT INITIAL.
      LOOP AT IT_DISPLAY2 WHERE FILM NE ZFILM-LOW AND LINE NE ZLINE-LOW.
        DELETE IT_DISPLAY2.
      ENDLOOP.
    ENDIF.

*    PERFORM SCREEN_OR_OLAPS.
*    PERFORM DISPLAY.

  ELSEIF ZBWART-LOW EQ '101'  OR ZBWART-LOW EQ '102' OR ZBWART-LOW EQ '261' OR ZBWART-LOW EQ '262' OR ZBWART-LOW EQ ' '.
    IF ZBWART-HIGH EQ '101' OR ZBWART-HIGH EQ '102' OR ZBWART-HIGH EQ'261' OR ZBWART-HIGH EQ '262' OR ZBWART-HIGH EQ ' '.

      SELECT MSEG~AUFNR MSEG~MATNR MSEG~BWART MKPF~BUDAT MKPF~BLDAT MKPF~CPUDT MKPF~CPUTM MKPF~BKTXT MSEG~WERKS
             MSEG~LGORT MSEG~MENGE MSEG~MEINS MSEG~WEMPF MSEG~ABLAD MSEG~MBLNR MSEG~MJAHR MSEG~SMBLN MSEG~SGTXT
             MSEG~GRUND
       INTO CORRESPONDING FIELDS OF TABLE IT_DISPLAY
       FROM MSEG
       JOIN MKPF ON MKPF~MBLNR = MSEG~MBLNR
       JOIN AUFK ON AUFK~AUFNR = MSEG~AUFNR
      WHERE MSEG~AUFNR IN ZAUFNR
      AND   MSEG~BUDAT_MKPF IN ZPOSDT
      AND   MSEG~BWART IN ZBWART
*   AND   MSEG~USNAM_MKPF IN ZUSNAM
      AND   MSEG~MATNR IN ZMATNR
      AND   MSEG~WERKS IN ZPLANT
      AND   MSEG~LGORT IN ZLGORT
      AND   MSEG~WEMPF IN ZWEMPF
      AND   MSEG~MBLNR IN ZMBLNR
      AND   MSEG~MJAHR IN ZMJAHR
      AND   AUFK~AUART IN ('ZR01', 'ZR02').

      IF ZUSNAM IS NOT INITIAL.
        LOOP AT IT_DISPLAY WHERE BKTXT+12(13) = ZUSNAM-LOW.
          IT_DISPLAY-USNAM = IT_DISPLAY-BKTXT+12(13).
          IT_DISPLAY-FILM = IT_DISPLAY-SGTXT+0(3).
          IT_DISPLAY-LINE = IT_DISPLAY-SGTXT+4(1).
          IT_DISPLAY-VTERMINAL = IT_DISPLAY-SGTXT+6(30).
          APPEND IT_DISPLAY TO IT_DISPLAY2.
        ENDLOOP.
      ELSE.
        LOOP AT IT_DISPLAY.
          IT_DISPLAY-USNAM = IT_DISPLAY-BKTXT+12(13).
          IT_DISPLAY-FILM = IT_DISPLAY-SGTXT+0(3).
          IT_DISPLAY-LINE = IT_DISPLAY-SGTXT+4(1).
          IT_DISPLAY-VTERMINAL = IT_DISPLAY-SGTXT+6(30).
          APPEND IT_DISPLAY TO IT_DISPLAY2.
        ENDLOOP.
      ENDIF.

      IF ZFILM-LOW IS NOT INITIAL AND ZLINE-LOW IS INITIAL.
        LOOP AT IT_DISPLAY2 WHERE FILM NE ZFILM-LOW.
          DELETE IT_DISPLAY2.
        ENDLOOP.
      ELSEIF ZFILM-LOW IS INITIAL AND ZLINE-LOW IS NOT INITIAL.
        LOOP AT IT_DISPLAY2 WHERE LINE NE ZLINE-LOW.
          DELETE IT_DISPLAY2.
        ENDLOOP.
      ELSEIF ZFILM-LOW IS NOT INITIAL AND ZLINE-LOW IS NOT INITIAL.
        LOOP AT IT_DISPLAY2 WHERE FILM NE ZFILM-LOW AND LINE NE ZLINE-LOW.
          DELETE IT_DISPLAY2.
        ENDLOOP.
      ENDIF.

    ELSE.

      MESSAGE 'Please Input Movement Type 101, 102, 261, 262' TYPE 'S'.

    ENDIF.
  ELSE.

    MESSAGE 'Please Input Movement Type 101, 102, 261, 262' TYPE 'S'.

  ENDIF.

  LOOP AT IT_DISPLAY2.

    SELECT SINGLE ZZGROUP INTO IT_DISPLAY2-VGROUP
      FROM ZGROUP
      WHERE ZZTANGGAL = IT_DISPLAY2-CPUDT
      AND   ZZJAM_MASUK <= IT_DISPLAY2-CPUTM
      AND   ZZJAM_KELUAR >= IT_DISPLAY2-CPUTM.

    MODIFY IT_DISPLAY2 TRANSPORTING VGROUP WHERE MBLNR = IT_DISPLAY2-MBLNR.
  ENDLOOP.


  IT_DISPLAY2-BUDAT = '19000101'.
  MODIFY IT_DISPLAY2 TRANSPORTING BUDAT WHERE BUDAT = 00000000.
  IT_DISPLAY2-BLDAT = '19000101'.
  MODIFY IT_DISPLAY2 TRANSPORTING BLDAT WHERE BLDAT = 00000000.
  IT_DISPLAY2-CPUDT = '19000101'.
  MODIFY IT_DISPLAY2 TRANSPORTING CPUDT WHERE CPUDT = 00000000.

ENDFORM.                    "GET_DETAIL


*&---------------------------------------------------------------------*
*&      Form  GET_BWART
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_BWART.
  DATA: BEGIN OF IT_DETAIL OCCURS 0,
          BWART TYPE MSEG-BWART,
          DESC  TYPE MAKT-MAKTX,
        END OF IT_DETAIL.

  IT_DETAIL-BWART = '101'.
  IT_DETAIL-DESC  = 'GR Goods Receipt'.
  APPEND IT_DETAIL.
  IT_DETAIL-BWART = '102'.
  IT_DETAIL-DESC  = 'GR for PO Reversal'.
  APPEND IT_DETAIL.
  IT_DETAIL-BWART = '261'.
  IT_DETAIL-DESC  = 'GR for Order'.
  APPEND IT_DETAIL.
  IT_DETAIL-BWART = '262'.
  IT_DETAIL-DESC  = 'RE for Order'.
  APPEND IT_DETAIL.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD     = 'BWART'
      WINDOW_TITLE = 'MvT Help List'
      VALUE_ORG    = 'S'
      DYNPPROG     = SY-REPID
      DYNPNR       = SY-DYNNR
      DYNPROFIELD  = 'BWART'
    TABLES
      VALUE_TAB    = IT_DETAIL.

ENDFORM.                    "GET_BWART

*&---------------------------------------------------------------------*
*&      Form  GET_FILM
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_FILM.
  CLEAR: IT_VALS, D_RETVAL, ITAB_CHAR, IT_RETVAL.
  REFRESH: IT_VALS, D_RETVAL, ITAB_CHAR, IT_RETVAL.


  CALL FUNCTION 'BAPI_CHARACT_GETDETAIL'
    EXPORTING
      CHARACTNAME        = 'ZZCODE'
    TABLES
      CHARACTVALUESDESCR = IT_VALS
      RETURN             = D_RETVAL.

  LOOP AT IT_VALS.
    MOVE-CORRESPONDING IT_VALS TO ITAB_CHAR.
    APPEND ITAB_CHAR.
  ENDLOOP.

  SORT ITAB_CHAR.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD        = 'VALUE_CHAR'
      DYNPPROG        = SY-REPID
      DYNPNR          = SY-DYNNR
      DYNPROFIELD     = 'VALUE_CHAR'
      VALUE_ORG       = 'S'
    TABLES
      VALUE_TAB       = ITAB_CHAR
      RETURN_TAB      = IT_RETVAL
    EXCEPTIONS
      PARAMETER_ERROR = 1
      NO_VALUES_FOUND = 2
      OTHERS          = 3.


ENDFORM.                    "GET_FILM


*&---------------------------------------------------------------------*
*&      Form  GET_LINE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_LINE.
  CLEAR: IT_VALS, D_RETVAL, ITAB_CHAR, IT_RETVAL.
  REFRESH: IT_VALS, D_RETVAL, ITAB_CHAR, IT_RETVAL.

  CALL FUNCTION 'BAPI_CHARACT_GETDETAIL'
    EXPORTING
      CHARACTNAME        = 'ZZPRODLINE'
    TABLES
      CHARACTVALUESDESCR = IT_VALS
      RETURN             = D_RETVAL.

  LOOP AT IT_VALS.
    MOVE-CORRESPONDING IT_VALS TO ITAB_CHAR.
    APPEND ITAB_CHAR.
  ENDLOOP.

  SORT ITAB_CHAR.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD        = 'VALUE_CHAR'
      DYNPPROG        = SY-REPID
      DYNPNR          = SY-DYNNR
      DYNPROFIELD     = 'VALUE_CHAR'
      VALUE_ORG       = 'S'
    TABLES
      VALUE_TAB       = ITAB_CHAR
      RETURN_TAB      = IT_RETVAL
    EXCEPTIONS
      PARAMETER_ERROR = 1
      NO_VALUES_FOUND = 2
      OTHERS          = 3.



ENDFORM.                    "GET_LINE

*&---------------------------------------------------------------------*
*&      Form  GET_ZWEMPF
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_ZWEMPF.

  DATA: BEGIN OF IT_DETAIL2 OCCURS 0,
            WERKS TYPE CRHD-WERKS,
            ARBPL TYPE CRHD-ARBPL,
        END OF IT_DETAIL2.

  DATA: DYNFIELDS TYPE TABLE OF DYNPREAD WITH HEADER LINE.

  DYNFIELDS-FIELDNAME = 'ZPLANT-LOW'.
  APPEND DYNFIELDS.

  CALL FUNCTION 'DYNP_VALUES_READ'
    EXPORTING
      DYNAME               = SY-CPROG
      DYNUMB               = SY-DYNNR
      TRANSLATE_TO_UPPER   = 'X'
    TABLES
      DYNPFIELDS           = DYNFIELDS
    EXCEPTIONS
      INVALID_ABAPWORKAREA = 1
      INVALID_DYNPROFIELD  = 2
      INVALID_DYNPRONAME   = 3
      INVALID_DYNPRONUMMER = 4
      INVALID_REQUEST      = 5
      NO_FIELDDESCRIPTION  = 6
      INVALID_PARAMETER    = 7
      UNDEFIND_ERROR       = 8
      DOUBLE_CONVERSION    = 9
      STEPL_NOT_FOUND      = 10
      OTHERS               = 11.


  READ TABLE DYNFIELDS WITH KEY FIELDNAME = 'ZPLANT-LOW'.
  ZPLANT-LOW = DYNFIELDS-FIELDVALUE.

  SELECT ZTMAP_SLOCREC~WERKS ZTMAP_SLOCREC~ARBPL
    INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL2
    FROM ZTMAP_SLOCREC
    WHERE ZTMAP_SLOCREC~WERKS = ZPLANT-LOW.

  SORT IT_DETAIL2 BY WERKS ARBPL.
  DELETE ADJACENT DUPLICATES FROM IT_DETAIL2.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD     = 'ARBPL'
      WINDOW_TITLE = 'Resource Help List'
      VALUE_ORG    = 'S'
      DYNPPROG     = SY-REPID
      DYNPNR       = SY-DYNNR
      DYNPROFIELD  = 'ARBPL'
    TABLES
      VALUE_TAB    = IT_DETAIL2.

ENDFORM.                    "GET_ZWEMPF

*&---------------------------------------------------------------------*
*&      Form  GET_SO_LGORT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_SO_LGORT.

  DATA: BEGIN OF IT_DETAIL OCCURS 0,
            WERKS TYPE CRHD-WERKS,
            ARBPL TYPE CRHD-ARBPL,
            LGORT TYPE LGORT_D,
*          ZRRLGORT TYPE LGORT_D,
        END OF IT_DETAIL.

  DATA: DYNFIELDS LIKE DYNPREAD OCCURS 0 WITH HEADER LINE,
        IT_DETAIL2 LIKE IT_DETAIL OCCURS 0 WITH HEADER LINE.

  DYNFIELDS-FIELDNAME = 'ZPLANT-LOW'.
  APPEND DYNFIELDS.
  DYNFIELDS-FIELDNAME = 'ZWEMPF-LOW'.
  APPEND DYNFIELDS.

  CALL FUNCTION 'DYNP_VALUES_READ'
    EXPORTING
      DYNAME               = SY-CPROG
      DYNUMB               = SY-DYNNR
      TRANSLATE_TO_UPPER   = 'X'
    TABLES
      DYNPFIELDS           = DYNFIELDS
    EXCEPTIONS
      INVALID_ABAPWORKAREA = 1
      INVALID_DYNPROFIELD  = 2
      INVALID_DYNPRONAME   = 3
      INVALID_DYNPRONUMMER = 4
      INVALID_REQUEST      = 5
      NO_FIELDDESCRIPTION  = 6
      INVALID_PARAMETER    = 7
      UNDEFIND_ERROR       = 8
      DOUBLE_CONVERSION    = 9
      STEPL_NOT_FOUND      = 10
      OTHERS               = 11.

  READ TABLE DYNFIELDS WITH KEY FIELDNAME = 'ZPLANT-LOW'.
  ZPLANT-LOW = DYNFIELDS-FIELDVALUE.
  READ TABLE DYNFIELDS WITH KEY FIELDNAME = 'ZWEMPF-LOW'.
  ZWEMPF-LOW = DYNFIELDS-FIELDVALUE.

  SELECT ZTMAP_SLOCREC~WERKS ZTMAP_SLOCREC~ARBPL ZTMAP_SLOCREC~LGORT_RCYL AS LGORT
    INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL
    FROM  ZTMAP_SLOCREC
    WHERE ZTMAP_SLOCREC~WERKS = ZPLANT-LOW.
*       AND   ZTMAP_SLOCREC~ARBPL = ZWEMPF-LOW.

  SELECT ZTMAP_SLOCREC~WERKS ZTMAP_SLOCREC~ARBPL ZTMAP_SLOCREC~ZRRLGORT AS LGORT
    INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL2
    FROM  ZTMAP_SLOCREC
    WHERE ZTMAP_SLOCREC~WERKS = ZPLANT-LOW.

  APPEND LINES OF IT_DETAIL TO IT_DETAIL2.

  SORT IT_DETAIL2 BY WERKS ARBPL LGORT.
  DELETE ADJACENT DUPLICATES FROM IT_DETAIL2.

  CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
    EXPORTING
      RETFIELD     = 'ZRRLGORT'
      WINDOW_TITLE = 'Resource Help List'
      VALUE_ORG    = 'S'
      DYNPPROG     = SY-REPID
      DYNPNR       = SY-DYNNR
      DYNPROFIELD  = 'ZRRLGORT'
    TABLES
      VALUE_TAB    = IT_DETAIL2.

ENDFORM.                    "GET_SO_LGORT

*&---------------------------------------------------------------------*
*&      Form  INSERT_SQL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM INSERT_SQL.

  LOOP AT IT_DISPLAY2.
    EXEC SQL.
      INSERT INTO TMP.RPT_ZPP_RE_REC
      ([Order],
       Material,
       MvmtType,
       PstngDate,
       DocDate,
       Entered,
       Time,
       UserName,
       Plant,
       StorLoc,
       Quantity,
       Unit,
       Recipient,
       Line,
       Film,
       MatDoc1,
       MatYear,
       MatDoc2,
       UnlPoint,
       Text,
       HeaderText,
       Reason,
       TerminalName,
       Group,
       LastUpdated)
      VALUES
      (:IT_DISPLAY2-AUFNR,
       :IT_DISPLAY2-MATNR,
       :IT_DISPLAY2-BWART,
       :IT_DISPLAY2-BUDAT,
       :IT_DISPLAY2-BLDAT,
       :IT_DISPLAY2-CPUDT,
       :IT_DISPLAY2-CPUTM,
       :IT_DISPLAY2-USNAM,
       :IT_DISPLAY2-WERKS,
       :IT_DISPLAY2-LGORT,
       :IT_DISPLAY2-MENGE,
       :IT_DISPLAY2-MEINS,
       :IT_DISPLAY2-WEMPF,
       :IT_DISPLAY2-LINE,
       :IT_DISPLAY2-FILM,
       :IT_DISPLAY2-MBLNR,
       :IT_DISPLAY2-MJAHR,
       :IT_DISPLAY2-SMBLN,
       :IT_DISPLAY2-ABLAD,
       :IT_DISPLAY2-SGTXT,
       :IT_DISPLAY2-BKTXT,
       :IT_DISPLAY2-GRUND,
       :IT_DISPLAY2-VTERMINAL,
       :IT_DISPLAY2-VGROUP,
       :VARDATETIME)
    ENDEXEC.
  ENDLOOP.

  IF SY-SUBRC = 0.
    EXEC SQL.
      COMMIT WORK
    ENDEXEC.
    VARSTATUS = '1'. VARMSG = ''.
  ELSE.
    VARSTATUS = '0'. VARMSG = ''.
  ENDIF.


ENDFORM.                    "INSERT_SQL