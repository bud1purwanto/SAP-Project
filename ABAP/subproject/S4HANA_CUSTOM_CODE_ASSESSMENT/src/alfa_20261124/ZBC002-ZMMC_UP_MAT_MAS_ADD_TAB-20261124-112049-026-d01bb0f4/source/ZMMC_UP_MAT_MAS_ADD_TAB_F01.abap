*&---------------------------------------------------------------------*
*&  Include           ZMMC_UP_MAT_MAS_ADD_TAB_F01
*&---------------------------------------------------------------------*
INCLUDE Z_PROG_INFO.
AT SELECTION-SCREEN.
  CASE SY-UCOMM.
    WHEN 'INFO'.
      PERFORM F_PROG_INFO USING V_PROG.
    WHEN OTHERS.
      IF ROT1 EQ 'X'.
        SUBMIT ZMMC_EXT_CLASS VIA SELECTION-SCREEN AND RETURN.
      ELSEIF ROT2 EQ 'X'.
        SUBMIT ZMMC_PROP VIA SELECTION-SCREEN AND RETURN.
      ELSEIF ROT3 EQ 'X'.
        SUBMIT ZMMC_CONF_PROF VIA SELECTION-SCREEN AND RETURN.
      ELSEIF ROT4 EQ 'X'.
        SUBMIT ZMMC_CONF_VAR VIA SELECTION-SCREEN AND RETURN.
      ELSEIF ROT5 EQ 'X'.
        SUBMIT ZPPC_UPLOAD_QMVIEW VIA SELECTION-SCREEN AND RETURN.
      ELSEIF ROT6 EQ 'X'.
        SUBMIT ZPPC_UPLOAD_INSPECTIONSETUP VIA SELECTION-SCREEN AND RETURN.
      ENDIF.
  ENDCASE.