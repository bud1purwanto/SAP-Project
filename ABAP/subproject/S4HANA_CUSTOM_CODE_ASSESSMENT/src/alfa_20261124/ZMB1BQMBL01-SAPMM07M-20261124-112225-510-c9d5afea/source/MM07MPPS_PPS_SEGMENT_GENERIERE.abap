*eject
*---------------------------------------------------------------------*
*       FORM PPS_SEGMENT_GENERIEREN                                   *
*---------------------------------------------------------------------*
*       Die Tabelle zum Fortschreiben des PPS-Auftrages wird erstellt.*
*---------------------------------------------------------------------*
FORM PPS_SEGMENT_GENERIEREN.

ENHANCEMENT-POINT EHP605_MM07MPPS_PPS_SEGMENT_01 SPOTS ES_SAPMM07M STATIC .

  CHECK NOT XMSEG-AUFNR IS INITIAL.

ENHANCEMENT-POINT EHP605_MM07MPPS_PPS_SEGMENT_03 SPOTS ES_SAPMM07M .

  XAUFM-BUDAT = XMKPF-BUDAT.
  XAUFM-BLDAT = XMKPF-BLDAT.
  CLEAR: XFABE, ZFABE.
  IF XMSEG-KZBEW = F.
*   IF NOT MBVAL IS INITIAL.
*     MESSAGE E324.
*   ENDIF.
    MOVE-CORRESPONDING XMSEG TO XFABE.
    XFABE-POSNR = XMSEG-AUFPS.
    XFABE-BUZEI = XMSEG-ZEILE.
    XFABE-BUDAT = MKPF-BUDAT.
    XFABE-DMBTR = XVM07M-AWEWR.
    XFABE-MENGE = XMSEG-BSTMG.
    XFABE-MEINS = XMSEG-BSTME.
    XFABE-BMENGE = XMSEG-MENGE.
    XFABE-BMEINS = XMSEG-MEINS.

ENHANCEMENT-POINT EHP605_MM07MPPS_PPS_SEGMENT_02 SPOTS ES_SAPMM07M .

    APPEND XFABE.
*   if xmseg-dmbtr is initial.
* Da  das RW-Interface schon aufgerufen falls BUSTW <> initial
"$$
"$$
"$$
"$$

ENHANCEMENT-SECTION     PPS_SEGMENT_GENERIEREN_02 SPOTS ES_SAPMM07M.
    IF XMSEG-DMBTR IS INITIAL
       AND ( XMSEG-BUSTW IS INITIAL OR UPD_RW IS INITIAL ) .
      ZFABE = XFABE.
      ZFABE-DMBTR = XMSEG-DMBTR.
      ZFABE-GLVOR = RW_VORGANG.
      APPEND ZFABE.
    ENDIF.
END-ENHANCEMENT-SECTION.
ENHANCEMENT-POINT PPS_SEGMENT_GENERIEREN_01 SPOTS ES_SAPMM07M.
  ENDIF.
  MOVE-CORRESPONDING XMSEG TO XAUFM.
ENHANCEMENT-POINT MM07MPPS_PPS_SEGMENT_GENERI_01 SPOTS ES_SAPMM07M STATIC.

ENHANCEMENT-POINT MM07MPPS_PPS_SEGMENT_GENERI_02 SPOTS ES_SAPMM07M.

* we have to fill always the stock WBS element in table AUFM. This
* was requested by PP, PS, PM (see OSS 0000055226 2000)
  XAUFM-PS_PSP_PNR = XMSEG-MAT_PSPNR.                   "note 316211
  XAUFM-KDAUF = XMSEG-MAT_KDAUF.                        "note 316211
  XAUFM-KDPOS = XMSEG-MAT_KDPOS.                        "note 330186
  APPEND XAUFM.

ENDFORM.