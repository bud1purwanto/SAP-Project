*eject
*---------------------------------------------------------------------*
*       FORM PFSTATUS_SETZEN                                          *
*---------------------------------------------------------------------*
*       Der PF-Status wird für das Dynpro gesetzt.                    *
*       Dies nur dann, wenn Dynpro hell durchlaufen wird.             *
*---------------------------------------------------------------------*
FORM PFSTATUS_SETZEN.

  REFRESH EXCL.
  PFSTA = NEW_PFSTA.
  TIT   = NEW_TIT.
  PFSTA-PFST1 = T063-PFSTA.
  TIT-KZVAR   = T063-KZTIT.
  IF NOT FCAUSW-XLIST IS INITIAL.
    IF NOT FCAUSW-XSELP IS INITIAL AND PFSTA NE 'HOHO'.
      AUFSETZEN_1 = AUFSETZEN - M_ZEILE.
    ELSE.
      AUFSETZEN_1 = AUFSETZEN.
    ENDIF.
    IF AUFSETZEN_1 IS INITIAL.
      AUFSETZEN_1 = AUFSETZEN = 1.
    ENDIF.
  ENDIF.
  CLEAR: RM07M-POSNR, RM07M-POSNM, RM07M-SLASH.
  IF NOT FCAUSW-XBEAP IS INITIAL AND FCAUSW-XLIST IS INITIAL.
    RM07M-POSNR = MSEG-ZEILE.
    IF M_ZEILE > 0.
      RM07M-POSNM = M_ZEILE.
      RM07M-SLASH = SLASCH.
    ENDIF.
    IF T158-TRTYP = H.
      IF FCAUSW-XNEUP IS INITIAL.
        SET TITLEBAR TIT WITH RM07M-POSNR RM07M-SLASH RM07M-POSNM.
      ELSE.
        SET TITLEBAR TIT WITH MSEG-ZEILE.
      ENDIF.
    ELSE.
      SET TITLEBAR TIT WITH MKPF-MBLNR RM07M-POSNR RM07M-SLASH
                            RM07M-POSNM.
    ENDIF.
  ELSE.
    IF T158-TRTYP = H.
      IF FCAUSW-XNEUP IS INITIAL.
        IF FCAUSW-XSELP IS INITIAL.
          IF M_ZEILE > 0.
            RM07M-POSNR = AUFSETZEN_1.
            RM07M-POSNM = M_ZEILE.
            RM07M-SLASH = SLASCH.
          ENDIF.
        ELSE.
          IF F_ZEILE > 0.
            RM07M-POSNR = AUFSETZEN_1.
            RM07M-POSNM = F_ZEILE.
            RM07M-SLASH = SLASCH.
          ENDIF.
        ENDIF.
      ENDIF.
      SET TITLEBAR TIT.
      IF NOT RM07M-POSNR IS INITIAL AND
         ( T158-KZBEW = B OR T158-KZBEW = F ).
        SET TITLEBAR TIT WITH RM07M-POSNR RM07M-SLASH RM07M-POSNM.
      ENDIF.
    ELSE.
      IF M_ZEILE > 0.
        RM07M-POSNR = AUFSETZEN_1.
        RM07M-POSNM = M_ZEILE.
        RM07M-SLASH = SLASCH.
      ENDIF.
      SET TITLEBAR TIT WITH MKPF-MBLNR.
    ENDIF.
  ENDIF.
  IF NOT XSELE IS INITIAL AND FCAUSW-XLIST IS INITIAL.
    PFSTA-PFST2 = S.
  ENDIF.

  IF DM07M-KNTTP IS INITIAL OR T158-TRTYP NE H
     OR NOT MSEG-WEUNB IS INITIAL
     OR ( NOT DM07M-XHISTMA IS INITIAL AND MSEG-XMACC IS INITIAL ).    "MAA2
   EXCL-FUNKTION = CCOD-KONB.
    APPEND EXCL.
  ENDIF.
  IF MSEG-EVERS IS INITIAL.
    EXCL-FUNKTION = CCOD-VERS.
    APPEND EXCL.
  ENDIF.
  IF T156-KZWES = S.
    EXCL-FUNKTION = 'NBNK'.
    APPEND EXCL.
  ENDIF.
  IF MSEG-QINSPST NE 1.
    EXCL-FUNKTION = CCOD-QINS.
  ENDIF.
  IF MSEG-MATNR IS INITIAL.
    EXCL-FUNKTION = 'EVER'.
    APPEND EXCL.
  ENDIF.
  IF T158-TRTYP EQ H.
    IF ( VM07M-XCHPF IS INITIAL AND DM07M-UMXCH IS INITIAL ) OR
       VM07M-XSTOR = 2 OR
       ( DM07M-KZWSO CA 'AB' AND PFSTA = 'HPHP' ).        "1364645
      EXCL-FUNKTION = CCOD-CLAS.
      APPEND EXCL.
    ENDIF.
  ELSE.
    IF MSEG-CHARG IS INITIAL AND MSEG-UMCHA IS INITIAL OR
       ( DM07M-KZWSO CA 'AB' AND PFSTA = 'HPHP' ).        "1364645
      EXCL-FUNKTION = CCOD-CLAS.
      APPEND EXCL.
    ENDIF.
  ENDIF.
  IF DM07M-SERNP IS INITIAL OR T156-KZWES = S.
    EXCL-FUNKTION = CCOD-NSER.
    APPEND EXCL.
  ENDIF.
  IF ( NOT FCAUSW-XLIST IS INITIAL AND FCAUSW-XAENP IS INITIAL
                                   AND FCAUSW-XNEUP IS INITIAL )
     AND ANF_BILD IS INITIAL.
    EXCL-FUNKTION = FCOD-AB.
    APPEND EXCL.
  ENDIF.
                                       "ALRK014884 SW Begin
  IF NOT FCAUSW-XBEAP IS INITIAL AND FCAUSW-XLIST IS INITIAL.
    DATA: L_UMWSO LIKE DM07M-KZWSO.                         "ALRK115218
    PERFORM READ_KZWSO(SAPFM07M) CHANGING  DM07M-KZWSO      "ALRK115218
                                           L_UMWSO.         "ALRK115218
    IF DM07M-KZWSO IS INITIAL AND L_UMWSO IS INITIAL.       "ALRK115218
      EXCL-FUNKTION = CCOD-MGUM.
      APPEND EXCL.
    ELSE.
      DATA: X_NO_ALTME.
      PERFORM READ_MARM_WITH_ATINN CHANGING X_NO_ALTME.
      IF NOT X_NO_ALTME IS INITIAL.
        EXCL-FUNKTION = CCOD-MGUM.
        APPEND EXCL.
      ENDIF.
    ENDIF.
  ELSE.
    EXCL-FUNKTION = CCOD-MGUM.
    APPEND EXCL.
  ENDIF.                               "ALRK014884 SW End
  IF T158-KZBEW = B AND NOT FCAUSW-XLIST IS INITIAL.
    CASE SICHT.
      WHEN '  '.
        EXCL-FUNKTION = 'SI00'.
      WHEN '00'.
        EXCL-FUNKTION = 'SI00'.
      WHEN '01'.
        EXCL-FUNKTION = 'SI01'.
      WHEN '02'.
        EXCL-FUNKTION = 'SI02'.
      WHEN '03'.
        EXCL-FUNKTION = 'SI03'.
      WHEN '04'.
        EXCL-FUNKTION = 'SI04'.
    ENDCASE.
    APPEND EXCL.
  ENDIF.
  IF T158-TRTYP = A AND NOT SY-CALLD IS INITIAL.
    EXCL-FUNKTION = 'EB02'.
    APPEND EXCL.
    EXCL-FUNKTION = 'EEN5'.
    APPEND EXCL.
  ENDIF.

  PERFORM J_1B_NF_DOCUMENT_FUNC_CHECK. "localization Brazil

  IF PFSTA EQ 'H0HPS' OR PFSTA EQ 'HBHPS' OR PFSTA EQ 'HPHPS'.
    IF SY-BINPT IS INITIAL.
      EXCL-FUNKTION = 'NFUL'.
      APPEND EXCL.
      EXCL-FUNKTION = 'NFBL'.
      APPEND EXCL.
      EXCL-FUNKTION = 'NFRL'.
      APPEND EXCL.
      EXCL-FUNKTION = 'NFPL'.
      APPEND EXCL.
    ENDIF.
  ENDIF.

ENHANCEMENT-POINT PFSTATUS_SETZEN_02 SPOTS ES_SAPMM07M.
  SET PF-STATUS PFSTA EXCLUDING EXCL.

ENHANCEMENT-POINT PFSTATUS_SETZEN_01 SPOTS ES_SAPMM07M.
ENDFORM.