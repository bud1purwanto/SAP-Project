*------------ Für Anzeige und Pflege werden Nachrichten gelesen -------*
FORM NACHRICHTEN_LESEN.

  CHECK T158-TRTYP NE H.
  NAST_KEY-MBLNR = MSEG-MBLNR.
  NAST_KEY-MJAHR = MSEG-MJAHR.
  NAST_KEY-ZEILE = 0000.
  NAST_KEY_TO-MBLNR = MSEG-MBLNR.
  NAST_KEY_TO-MJAHR = MSEG-MJAHR.
  NAST_KEY_TO-ZEILE = 9999.
  CONDENSE NAST_KEY NO-GAPS.
  CONDENSE NAST_KEY_TO NO-GAPS.
  MSG_OBJKY = NAST_KEY.
  MSG_OBJKY_TO = NAST_KEY_TO.
  CALL FUNCTION 'RV_MESSAGES_READ'
       EXPORTING
            MSG_KAPPL = 'ME'
            MSG_OBJKY = MSG_OBJKY
            MSG_OBJKY_TO = MSG_OBJKY_TO.

  CALL FUNCTION 'RV_MESSAGES_GET'
       EXPORTING
            MSG_KAPPL = 'ME'
       TABLES
            TAB_XNAST = XNAST
            TAB_YNAST = YNAST.

ENDFORM.