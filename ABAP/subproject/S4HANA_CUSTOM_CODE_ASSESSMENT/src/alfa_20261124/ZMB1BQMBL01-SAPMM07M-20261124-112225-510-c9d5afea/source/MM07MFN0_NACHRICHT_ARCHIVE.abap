*----- archivierte Belege anzeigen ------------------------------------*
FORM NACHRICHT_ARCHIVE.

  DATA: BEGIN OF XOBJECT OCCURS 0,
        OBJECT LIKE SAPB-SAPOBJID.
  DATA: END OF XOBJECT.
  XOBJECT-OBJECT       = MKPF-MBLNR.
  XOBJECT-OBJECT+10(4) = MKPF-MJAHR.
  APPEND XOBJECT.

  CALL FUNCTION 'ARCHIV_DISPLAY_META'
       EXPORTING  SAP_OBJECT = 'BUS2017'
                  OBJECT_ID  = XOBJECT-OBJECT
       EXCEPTIONS OTHERS     = 1.
  IF NOT SY-SUBRC IS INITIAL.
     MESSAGE ID SY-MSGID TYPE 'I' NUMBER SY-MSGNO
             WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.

ENDFORM.