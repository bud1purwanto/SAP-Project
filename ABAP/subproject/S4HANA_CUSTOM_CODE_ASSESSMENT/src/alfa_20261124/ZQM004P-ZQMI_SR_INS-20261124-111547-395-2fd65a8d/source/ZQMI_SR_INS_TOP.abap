*&---------------------------------------------------------------------*
*&  Include           ZQMI_SR_INS_TOP
*&---------------------------------------------------------------------*
TABLES :AUFK, CAWN ,ZQM_LOG_GS,HRP1001.
DATA : BEGIN OF T_BDC OCCURS 0,
      MBLNR LIKE MSEG-MBLNR,
      SMBLN LIKE MSEG-SMBLN,
      MATNR LIKE MSEG-MATNR,
      WERKS LIKE MSEG-WERKS,
      CHARG LIKE MSEG-CHARG,
      MENGE LIKE MSEG-MENGE,
      TMENGE TYPE C LENGTH 16,
      AUFNR2 LIKE MSEG-AUFNR,
      AUFNR LIKE MSEG-AUFNR,
      ZEILE LIKE MSEG-ZEILE,
      SMBLP LIKE MSEG-SMBLP.
DATA : END OF T_BDC.
DATA: BEGIN OF T_ORDER OCCURS 0,
        MATNR LIKE MSEG-MATNR,    "Matno original order
        MATNRJR LIKE MSEG-MATNR,    "Matno JR
        MATNRIN LIKE MSEG-MATNR,    "Matno Batch Input
        CHARG LIKE MSEG-CHARG,    "JR batch
        PLOS2 LIKE QALS-PRUEFLOS, "Inspection lot combine order
        CHARGA LIKE MSEG-CHARG,    "Assign batch
        INPUT1 LIKE MSEG-CHARG,
        INPUT2 LIKE MSEG-CHARG,
        INPUT3 LIKE MSEG-CHARG,
        INPUT4 LIKE MSEG-CHARG,
        AUFNR LIKE MSEG-AUFNR,
        PLINE TYPE C LENGTH 30,
        JRCODE TYPE C LENGTH 30,
        JRMOY TYPE C LENGTH 30,
        JRSEQ TYPE C LENGTH 30,
        ROLLJR TYPE C LENGTH 30,
        ERDAT TYPE DATS,
        ERZET TYPE TIMS,
        USNAM TYPE C LENGTH 10,
        NONIK LIKE ZQM_LOG_GS-NONIK,
        WERKS LIKE MSEG-WERKS,
        PRUEFLOSREF TYPE C LENGTH 11,
        FLAG TYPE FLAG,          "Flag for already scanned
        FLAG_SAVE TYPE FLAG,     "Flag for saved
      END OF T_ORDER.
DATA : BEGIN OF JRBATCH OCCURS 0,
       AUFNR LIKE MSEG-AUFNR,
       CHARG LIKE MSEG-CHARG.
DATA : END OF JRBATCH.
DATA : BEGIN OF T_QMLOG OCCURS 0.
        INCLUDE TYPE ZQM_LOG_GS.
DATA: ROLLN1 TYPE C LENGTH 30,
      ROLLN2 TYPE C LENGTH 30,
      ROLLN3 TYPE C LENGTH 30,
      ROLLN4 TYPE C LENGTH 30,
      SLICE1 TYPE C LENGTH 30,
      SLICE2 TYPE C LENGTH 30,
      SLICE3 TYPE C LENGTH 30,
      BATCH TYPE C LENGTH 10,
      DATE LIKE QALS-ENSTEHDAT.
DATA : END OF T_QMLOG.
DATA : IT_BDCDATA    LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE,
       TBATCH LIKE STANDARD TABLE OF CLBATCH WITH HEADER LINE,
       T_ORDER2 LIKE STANDARD TABLE OF ZQM_LOG_GS WITH HEADER LINE,
       T_VALID LIKE STANDARD TABLE OF T_BDC WITH HEADER LINE,
       T_ORDER1 LIKE STANDARD TABLE OF T_ORDER WITH HEADER LINE.
DATA : T_LOG LIKE ZQM_LOG_GS OCCURS 0 WITH HEADER LINE,
       WA LIKE T_LOG.
*       T_QMLOG LIKE ZQM_LOG_GS OCCURS 0 WITH HEADER LINE.
 DATA : BATCH LIKE ZPACK00-CHARGDC,
        BATCH10(18),
        PRUEFLOS LIKE QALS-PRUEFLOS,
        C,
        G_ZORDER_LINES  LIKE SY-LOOPC,
        OK_CODE LIKE SY-UCOMM,
        V_TAB_SIZE LIKE SY-TABIX, V_ERROR(01),
        PSTAT TYPE C,
        V_TOT_REC LIKE SY-TABIX,
        SBDC TYPE C.
DATA: V_PROG LIKE ZPROGINFO-PGMNA VALUE 'ZQMI_SR_INS'.

SELECTION-SCREEN BEGIN OF BLOCK X3 WITH FRAME TITLE H01.
PARAMETERS: P_STAT1 RADIOBUTTON GROUP RAD1 DEFAULT 'X'.
PARAMETERS: P_STAT2 RADIOBUTTON GROUP RAD1.
SELECTION-SCREEN END OF BLOCK X3.
SELECTION-SCREEN BEGIN OF BLOCK X1 WITH FRAME TITLE TEXT-A03.
SELECT-OPTIONS: P_NIK FOR HRP1001-OBJID NO-EXTENSION NO INTERVALS.
SELECTION-SCREEN END OF BLOCK X1.
SELECTION-SCREEN BEGIN OF BLOCK X2 WITH FRAME TITLE TEXT-A02.
SELECT-OPTIONS:
                P_ERDAT FOR ZQM_LOG_GS-ERDAT OBLIGATORY DEFAULT SY-DATUM TO SY-DATUM,   " Printed Date
                S_WERK1 FOR AUFK-WERKS,
                S_CHAR1 FOR ZQM_LOG_GS-CHARGJR,
                S_PLINE FOR CAWN-ATWRT." DEFAULT '1' TO 'Z' MATCHCODE OBJECT ZPLINE.

SELECT-OPTIONS:
                S_CODE FOR ZQM_LOG_GS-JRCODE NO-EXTENSION NO INTERVALS,
                S_MONYE FOR ZQM_LOG_GS-JRMOY NO-EXTENSION NO INTERVALS,
                S_SEQUE FOR ZQM_LOG_GS-JRSEQ NO-EXTENSION NO INTERVALS.
SELECTION-SCREEN SKIP 1.
*PARAMETERS :    P_BATCH AS CHECKBOX.
SELECTION-SCREEN END OF BLOCK X2.
SELECTION-SCREEN SKIP 2.
SELECTION-SCREEN PUSHBUTTON /12(79) INFO USER-COMMAND INFO.

*&SPWIZARD: DECLARATION OF TABLECONTROL 'TCSLIT' ITSELF
CONTROLS: TCSLIT TYPE TABLEVIEW USING SCREEN 9100.