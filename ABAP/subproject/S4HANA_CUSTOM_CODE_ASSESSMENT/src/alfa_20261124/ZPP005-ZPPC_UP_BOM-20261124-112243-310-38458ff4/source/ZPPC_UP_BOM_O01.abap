*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE USER_COMMAND_0100 INPUT.
  CASE SY-UCOMM.
    WHEN 'BACK'.
      LEAVE PROGRAM .
    WHEN 'EXIT'.
      LEAVE PROGRAM.
    WHEN 'UPLOAD'.
      PERFORM F_UPLOAD_BOM.
      P_FILE = FPATH.
  ENDCASE.
ENDMODULE.                 " USER_COMMAND_0100  INPUT

*&---------------------------------------------------------------------*
*&      Module  STATUS_0200  OUTPUT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
MODULE STATUS_0200 OUTPUT.
  SET PF-STATUS 'PF200'.
  SET TITLEBAR 'T200B'.

ENDMODULE.                 " STATUS_0200  OUTPUT