*&---------------------------------------------------------------------*
*&  Include           ZHUI_TRS_HU_DP2_TOP
*&---------------------------------------------------------------------*

TABLES : VEKP, VEPO, ZHU_MAPP.

"TYPES FOR DATA HU
TYPES : BEGIN OF TYDATA,
          HUNO   LIKE VEKP-EXIDV, "HU NO.
          SLOCA  LIKE VEPO-LGORT, "Sloc Asal
          PLANTA LIKE VEPO-WERKS, "Plant Asal
          SLOCT  LIKE VEPO-LGORT, "Sloc Tujuan
          PLANTT LIKE VEPO-WERKS, "Plant Tujuan
          MATDOC   TYPE SYMSGV, "MATDOC NO.
          KET    TYPE STRING, " Modified by William at 20.02.2026 (longer messages)
          CELLCOLOR TYPE LVC_T_SCOL,
        END OF TYDATA.

"TYPES FOR DELIVERY
TYPES : BEGIN OF TYODO,
          VBELN TYPE LIKP-VBELN, "NO ODO
          CHARG TYPE LIPS-CHARG, "BATCH.
        END OF TYODO.

"TYPES FOR HU ITEM
TYPES : BEGIN OF TYITEM,
          VENUM LIKE VEPO-VENUM,
          EXIDV LIKE VEKP-EXIDV,
*          SLOCT LIKE VEPO-LGORT,
        END OF TYITEM.

DATA :  DD      TYPE C LENGTH 2,
  MM      TYPE C LENGTH 2,
  YYYY    TYPE C LENGTH 4,
  DATE    TYPE C LENGTH 8.

"TYPES FOR TABLE RANGE SLOC IN ZHU_MAPP.
TYPES : BEGIN OF TYSLOC,
          SLOC LIKE ZHU_MAPP-LGOR1,
          DESC  TYPE T001L-LGOBE,
        END OF TYSLOC.

"DATA FOR RANGE SLOC IN ZHU_MAPP
DATA : ITSLOC TYPE TABLE OF TYSLOC WITH HEADER LINE,
       RSLOCA TYPE RANGE OF ZHU_MAPP-LGOR1,
       RSLOCT TYPE RANGE OF ZHU_MAPP-LGOR2,
       WSLOC LIKE LINE OF RSLOCA.
DATA : TYPE LIKE ZHU_MAPP-TYPES.
DATA : TSLOC  LIKE VEPO-LGORT. "Target Sloc
DATA : TODO TYPE TABLE OF TYODO WITH HEADER LINE.
DATA : ITITEM TYPE TABLE OF TYITEM WITH HEADER LINE,
       ITTEMP TYPE TABLE OF TYITEM WITH HEADER LINE,
       ITTEMP2 TYPE TABLE OF TYITEM WITH HEADER LINE,
       WAITEM TYPE TYITEM,
        WA_PSOURCE TYPE ZPACK_PCL,
       T_PSOURCE TYPE TABLE OF ZPACK_PCL..

"DATA FOR HU
DATA : ITDATA TYPE TABLE OF TYDATA WITH HEADER LINE,
       WADATA TYPE TYDATA.
"HELP DATA
DATA : VENUM     TYPE VEKP-VENUM,
       OBJNR     TYPE HUSTOBJ-OBJNR,
       STATUS    TYPE TJ30T-TXT04, "USER STATUS
       MATNR     TYPE VEPO-MATNR.

"DATA FOR BDC
DATA : IT_BDCDATA LIKE BDCDATA OCCURS 0 WITH HEADER LINE,
       IT_BDCMSGCOLL LIKE BDCMSGCOLL OCCURS 0 WITH HEADER LINE.


"DATA FOR SELECTION SCREEN 100
DATA : RW(1) TYPE C , "WARU
       RK(1) TYPE C , "KRIAN
       RJ(1) TYPE C.  "JAKARTA

"DATA FOR USER COMMAND IN SCREEN
DATA : OKCODE TYPE SY-UCOMM.

"ADDITIONAL DATA
DATA :   UNVEL TYPE VEPO-UNVEL,
         PSTAT TYPE ZQM001-PSTAT,
         PLANT TYPE VEPO-WERKS,
         PLANA TYPE VEPO-WERKS,
         SLOCA TYPE VEPO-LGORT,
         INDICATOR(1) TYPE C,
         BATCH TYPE VEPO-CHARG,
         VAEDAT TYPE ZQM001-AEDAT,
         VAETIME TYPE ZQM001-AETIME.

"Call BAPI
DATA : IF_EVENT TYPE HUWBEVENT ,"VALUE '0006',
       IF_TCODE TYPE SYTCODE VALUE 'VLMOVE',
       IT_EXTERNAL_ID TYPE  HUM_EXIDV_T WITH HEADER LINE,
       IT_MOVE_TO TYPE HUM_DATA_MOVE_TO_T WITH HEADER LINE,
       ET_MESSAGES TYPE HUITEM_MESSAGES_T WITH HEADER LINE,
       ES_MESSAGE TYPE TABLE OF HUITEM_MESSAGES WITH HEADER LINE.

"DATA FOR BDC
CONSTANTS : CUMLGO TYPE C LENGTH 14 VALUE 'LEMOVPOS-UMLGO'.
DATA : VUMLGO TYPE CHAR18,
       COUNTER TYPE I VALUE '1',
       COUNTER2 TYPE I,
       SUM TYPE I,
       N(3),
       VSTAT(1) TYPE C,
       VLINE TYPE I,
       V_CANC_ODO(1) TYPE C.


