DATA : TA_BATCH TYPE TABLE OF CLBATCH,
       WA_BATCH LIKE LINE OF TA_BATCH,
       TA_ITEM TYPE TABLE OF TYPES1,
       WA_ITEM LIKE LINE OF TA_ITEM,
       TA_ITEM2 TYPE TABLE OF TYPES1,
       WA_ITEM2 LIKE LINE OF TA_ITEM2,
       TA_ORI TYPE TABLE OF TYPES1.

DATA : V_CHARG TYPE MSEG-CHARG,
       LINE TYPE P.

DATA: BEGIN OF ELEM OCCURS 1.
        INCLUDE STRUCTURE GGAEL.
DATA:   TBEG TYPE T,                   "// not send
        MODIF(1),                      "// 'X' = modif, 'D' = deleted
      END OF ELEM.
DATA: BEGIN OF LGEL OCCURS 1.
        INCLUDE STRUCTURE GGAEL.
DATA: END OF LGEL.

DATA: BEGIN OF ITEM OCCURS 1.
        INCLUDE STRUCTURE GGAIT.
DATA:   NEWNUM LIKE SY-TABIX,          "// for moving ITEMS
        MODIF(1),                      "// `X` (change), 'D' (delete)
      END OF ITEM.

DATA: BEGIN OF MIST OCCURS 1.
        INCLUDE STRUCTURE GGAMI.
DATA:   TBEG TYPE T,                   "// not send
        MODIF(1),                      "// 'X' = modif, 'D' = deleted
      END OF MIST.
DATA: BEGIN OF LGMS OCCURS 1.
        INCLUDE STRUCTURE GGAMI.
DATA: END OF LGMS.

DATA: BEGIN OF MSGT OCCURS 1.
        INCLUDE STRUCTURE GGABA.
DATA: END OF MSGT.


DATA: T TYPE T,
      D TYPE D,
      DATE_NULL TYPE D VALUE '18991230',
      DATE TYPE I,
      TIME TYPE TIMS,
      MBLNR TYPE MSEG-MBLNR,
      MJAHR TYPE MSEG-MJAHR,
      ZEILE TYPE MSEG-ZEILE,
      ITEMNO TYPE I,
      ZZWIDTH TYPE STRING,
      CHARG TYPE MSEG-CHARG,
      ZZLENGTH TYPE STRING,
      STAT TYPE JEST-STAT.

DATA : IT_RETURN LIKE DDSHRETVAL OCCURS 0 WITH HEADER LINE.
DATA: BEGIN OF IT_ZLINE OCCURS 0,
      ZLINE TYPE ZLINE,
      END OF IT_ZLINE.


SELECTION-SCREEN BEGIN OF BLOCK BLOCK1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS  : ZLINE FOR AUFK-ZLINE,
                  TANGGAL  FOR AFKO-GSTRP OBLIGATORY ,
                  S_AUFNR  FOR AUFK-AUFNR.
SELECTION-SCREEN END OF BLOCK BLOCK1.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZLINE-LOW.
  PERFORM F4_ZLINE .

AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZLINE-HIGH.
  PERFORM F4_ZLINE .