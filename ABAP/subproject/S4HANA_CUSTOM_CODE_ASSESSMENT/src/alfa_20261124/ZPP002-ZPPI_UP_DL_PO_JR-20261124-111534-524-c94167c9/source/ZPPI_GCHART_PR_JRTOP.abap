        AUART TYPE AUFK-AUART,
        ZLINE TYPE AUFK-ZLINE,
        ZCODE TYPE AUFK-ZCODE,
        ZWIDTH TYPE AUFK-ZWIDTH,
        ZLENGTH TYPE AUFK-ZLENGTH,
        ZZWIDTH TYPE AUFK-ZWIDTH,
