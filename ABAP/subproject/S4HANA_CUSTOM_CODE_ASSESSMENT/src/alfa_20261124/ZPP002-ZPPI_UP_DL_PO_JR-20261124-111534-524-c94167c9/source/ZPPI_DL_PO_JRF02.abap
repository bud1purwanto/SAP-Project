*&---------------------------------------------------------------------*
*&      Form  F_IMPORT_EXCEL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM F_IMPORT_EXCEL .
  DATA : P_FILE TYPE STRING.
  DATA: L_FOLDER TYPE STRING,
        COMPUTER_NAME TYPE STRING,
        NUM TYPE P.

  DATA : BEGIN OF INT_HEAD OCCURS 0,
         FILED1(40) TYPE C,                     " Header Data
         END OF INT_HEAD.

  DATA : BEGIN OF T_EXCEL OCCURS 0,
           WERKS(4), "PLANT
           ZLINE(10), "PRODUCTION LINE
           AUFNR(12), "ORDER
           ZCODE(20), " CODE FILM
           ZZCODE(30), " TYPE / THCICKNESS
           ZWIDTH(20), " WIDTH
           ZLENGTH(20), " LENGTH
           ZTREAT(10), " TREATMENT
           GAMNG(15), " Quantity Plan PO(Roll/Pac)
           ZCUSTM(20), " CUSTOMER
           GSTRP(10),  " START DATE
           GSUZP(10),  " START TIME
           WEMNG(15), "Qty GR(Roll/Pac)
           ZZWIDTH(20), "TOTAL WIDTH ACTUAL
           LENGTH_H(20), " total length gr actual
           ZZLENGTH(20), "TOTAL LENGTH ACTUAL
           WEIGHT_H(10), " total weight gr actual
           TOT_CONVERSION(15), "ZZCONVERSION1(15), " TOTAL WEIGHT ACTUAL
           ISTAT2(15),   "Status
           CHARG(10) TYPE P, "BATCH
           WIDTH(10), "TOTAL WIDTH ACTUAL
           LENGTH_I(20), " length gr actual
           LENGTH(20), "TOTAL LENGTH ACTUAL
           WEIGHT_I(20), " weight gr actual
           ZZCONVERSION1(15), "MENGE(15), " TOTAL WEIGHT ACTUAL
           ZZNOMORROLL(20), " NOMOR ROLL
           IEDD(10),  " ACTUAL PRODUCTION FINISH DATE
           IEDZ(10), " ACTUAL PRODUCTION FINIHS TIME,
           ISM01(10), " PROCESS TIME
           ZZGRADEJR(20),  " STATUS JR
           STOCK(30),
           AUART(4),
         END OF T_EXCEL.


  CALL METHOD CL_GUI_FRONTEND_SERVICES=>DIRECTORY_BROWSE
    EXPORTING
      WINDOW_TITLE    = 'Select Folder Path'
      INITIAL_FOLDER  = 'D:\'
    CHANGING
      SELECTED_FOLDER = L_FOLDER.

  CALL FUNCTION 'POC_GET_COMPUTER_NAME'
    IMPORTING
      EX_COMPUTER_NAME = COMPUTER_NAME
    EXCEPTIONS
      GUI_ERROR        = 1
      OTHERS           = 2.

  CONCATENATE L_FOLDER '\' SY-DATUM '-' SY-UZEIT '-' COMPUTER_NAME '.XLS' INTO P_FILE.

  SORT IT_DETAIL BY GSTRP GSUZP AUFNR ASCENDING.
  SORT IT_REPORT8 BY GSTRP GSUZP ASCENDING.

  LOOP AT IT_DETAIL.
    NUM = 0.
    LOOP AT IT_REPORT8 WHERE AUFNR = IT_DETAIL-AUFNR.
      NUM = NUM + 1.
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*        EXPORTING
*          INPUT  = IT_REPORT8-ZWIDTH
*        IMPORTING
*          OUTPUT = IT_REPORT8-ZWIDTH.
*
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*        EXPORTING
*          INPUT  = IT_REPORT8-ZZWIDTH
*        IMPORTING
*          OUTPUT = IT_REPORT8-ZZWIDTH.
*
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*        EXPORTING
*          INPUT  = IT_REPORT8-WIDTH
*        IMPORTING
*          OUTPUT = IT_REPORT8-WIDTH.
*
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*        EXPORTING
*          INPUT  = IT_REPORT8-ZLENGTH
*        IMPORTING
*          OUTPUT = IT_REPORT8-ZLENGTH.
*
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*        EXPORTING
*          INPUT  = IT_REPORT8-ZZLENGTH
*        IMPORTING
*          OUTPUT = IT_REPORT8-ZZLENGTH.
*
*      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
*        EXPORTING
*          INPUT  = IT_REPORT8-LENGTH
*        IMPORTING
*          OUTPUT = IT_REPORT8-LENGTH.

      IF NUM > 1.
        CLEAR :  IT_REPORT8-WERKS,IT_REPORT8-ZLINE,IT_REPORT8-AUFNR,IT_REPORT8-ZCODE,IT_REPORT8-ZZCODE,IT_REPORT8-ZWIDTH,
          IT_REPORT8-ZLENGTH,IT_REPORT8-ZTREAT,IT_REPORT8-GAMNG,IT_REPORT8-ZCUSTM,IT_REPORT8-GSTRP,IT_REPORT8-GSUZP,
          IT_REPORT8-WEMNG,IT_REPORT8-ZZWIDTH,IT_REPORT8-ZZLENGTH,IT_REPORT8-ISTAT2,IT_REPORT8-TOT_CONVERSION,
          IT_REPORT8-WEIGHT_H,IT_REPORT8-LENGTH_H.
        MODIFY IT_REPORT8.
      ENDIF.
      MOVE-CORRESPONDING IT_REPORT8 TO T_EXCEL.
      IF IT_REPORT8-TOT_CONVERSION = ''.
        T_EXCEL-TOT_CONVERSION = ''.
      ENDIF.
      IF IT_REPORT8-ZZLENGTH = ''.
        T_EXCEL-ZZLENGTH = ''.
      ENDIF.
      IF IT_REPORT8-ZZWIDTH = ''.
        T_EXCEL-ZZWIDTH = ''.
      ENDIF.
      IF IT_REPORT8-ZWIDTH = ''.
        T_EXCEL-ZWIDTH = ''.
      ENDIF.
      IF IT_REPORT8-ZLENGTH = ''.
        T_EXCEL-ZLENGTH = ''.
      ENDIF.

      IF IT_REPORT8-GAMNG = 0.
        T_EXCEL-GAMNG = ''.
      ENDIF.

      IF IT_REPORT8-GSTRP = 0.
        T_EXCEL-GSTRP = ''.
      ELSE.
        CONCATENATE IT_REPORT8-GSTRP+6(2) IT_REPORT8-GSTRP+4(2) IT_REPORT8-GSTRP+0(4) INTO T_EXCEL-GSTRP SEPARATED BY '/'.
      ENDIF.

      IF IT_REPORT8-GSUZP = 0.
        T_EXCEL-GSUZP = ''.
      ELSE.
        CONCATENATE IT_REPORT8-GSUZP+0(2) IT_REPORT8-GSUZP+2(2) IT_REPORT8-GSUZP+4(2) INTO  T_EXCEL-GSUZP SEPARATED BY ':'.
      ENDIF.

      IF IT_REPORT8-WEMNG = 0.
        T_EXCEL-WEMNG  = ''.
      ENDIF.

      IF IT_REPORT8-IEDZ = 0.
        T_EXCEL-IEDZ = ''.
      ELSE.
        CONCATENATE IT_REPORT8-IEDZ+0(2) IT_REPORT8-IEDZ+2(2) IT_REPORT8-IEDZ+4(2) INTO  T_EXCEL-IEDZ SEPARATED BY ':'.
      ENDIF.

      IF IT_REPORT8-IEDD = 0.
        T_EXCEL-IEDD = ''.
      ELSE.
        CONCATENATE IT_REPORT8-IEDD+6(2) IT_REPORT8-IEDD+4(2) IT_REPORT8-IEDD+0(4) INTO  T_EXCEL-IEDD SEPARATED BY '/'.
      ENDIF.

      IF IT_REPORT8-LENGTH_H = ''.
        T_EXCEL-LENGTH_H = ''.
      ENDIF.

      IF IT_REPORT8-WEIGHT_H = ''.
        T_EXCEL-WEIGHT_H = ''.
      ENDIF.

      APPEND T_EXCEL.
    ENDLOOP.
  ENDLOOP.

  INT_HEAD-FILED1 = 'Plant'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Production Line'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'PO No.'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Code Film'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.


  INT_HEAD-FILED1 = 'Type / Thickness'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Width'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Length'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.


  INT_HEAD-FILED1 = 'Treatment'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Quantity Plan PO(Roll/Pac)'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.


  INT_HEAD-FILED1 = 'Customer'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Start Date'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Start Time'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Qty GR(Roll/Pac)'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.


  INT_HEAD-FILED1 = 'Total Width Actual'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Total Length GR'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Total Length Actual'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Total Weight GR'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Total Weight Actual'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Status'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Batch'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Width Actual'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Length GR'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Length Actual'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Weight GR'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Weight Actual'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Nomor Roll'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Actual Production Finish Date'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Actual Production Finish Time'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Process Time'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Status JR'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Stock'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.

  INT_HEAD-FILED1 = 'Order Type'.
  APPEND INT_HEAD.
  CLEAR INT_HEAD.


  CALL FUNCTION 'GUI_DOWNLOAD'
    EXPORTING
      FILENAME                = P_FILE
      FILETYPE                = 'ASC'
      WRITE_FIELD_SEPARATOR   = 'X'
      CONFIRM_OVERWRITE       = 'X'
      SHOW_TRANSFER_STATUS    = 'X'
    TABLES
      DATA_TAB                = T_EXCEL
      FIELDNAMES              = INT_HEAD
    EXCEPTIONS
      FILE_WRITE_ERROR        = 1
      NO_BATCH                = 2
      GUI_REFUSE_FILETRANSFER = 3
      INVALID_TYPE            = 4
      NO_AUTHORITY            = 5
      UNKNOWN_ERROR           = 6
      HEADER_NOT_ALLOWED      = 7
      SEPARATOR_NOT_ALLOWED   = 8
      FILESIZE_NOT_ALLOWED    = 9
      HEADER_TOO_LONG         = 10
      DP_ERROR_CREATE         = 11
      DP_ERROR_SEND           = 12
      DP_ERROR_WRITE          = 13
      UNKNOWN_DP_ERROR        = 14
      ACCESS_DENIED           = 15
      DP_OUT_OF_MEMORY        = 16
      DISK_FULL               = 17
      DP_TIMEOUT              = 18
      FILE_NOT_FOUND          = 19
      DATAPROVIDER_EXCEPTION  = 20
      CONTROL_FLUSH_ERROR     = 21
      OTHERS                  = 22.

  IF SY-SUBRC <> 0.
    MESSAGE W002(ZMM) WITH 'Download Error'.
    RETURN.
  ENDIF.


ENDFORM.                    " F_IMPORT_EXCEL