       TOLENG TYPE P DECIMALS 3,
       TOCON TYPE P DECIMALS 3,
       MBLNR TYPE MSEG-MBLNR,
       LENGTH(20),
       WEIGHT(20),
       LENGTH_GR TYPE P ,
       WEIGHT_GR TYPE P DECIMALS 3.

SELECTION-SCREEN BEGIN OF BLOCK BLOCK1 WITH FRAME TITLE TEXT.
SELECT-OPTIONS  : ZLINE FOR AUFK-ZLINE,
                  AUFNR FOR AUFK-AUFNR,
                  ZCODE FOR AUFK-ZCODE,
                  GSTRP FOR AFKO-GSTRP,
                  ISDD  FOR AFRU-ISDD.
SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT 3(7) TEXT1.
SELECTION-SCREEN POSITION 1.
PARAMETERS : R1 AS CHECKBOX.

SELECTION-SCREEN COMMENT 18(11) TEXT2.
SELECTION-SCREEN POSITION 16.
PARAMETERS : R2 AS CHECKBOX.

SELECTION-SCREEN COMMENT 37(9) TEXT3.
SELECTION-SCREEN POSITION 35.
PARAMETERS : R3 AS CHECKBOX.

SELECTION-SCREEN COMMENT 54(5) TEXT4.
SELECTION-SCREEN POSITION 52.
PARAMETERS : R4 AS CHECKBOX.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN END OF BLOCK BLOCK1.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZLINE-LOW.
  PERFORM F4_ZLINE .

AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZLINE-HIGH.
  PERFORM F4_ZLINE .

AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZCODE-LOW.
  PERFORM F4_ZCODE .

AT SELECTION-SCREEN ON VALUE-REQUEST FOR ZCODE-HIGH.
  PERFORM F4_ZCODE .