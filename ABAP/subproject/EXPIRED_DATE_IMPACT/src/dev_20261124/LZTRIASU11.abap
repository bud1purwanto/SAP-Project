FUNCTION ZITI_MKPF.
*"--------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(CPUDT1) TYPE  CPUDT OPTIONAL
*"     VALUE(CPUDT2) TYPE  CPUDT OPTIONAL
*"--------------------------------------------------------------------
  DATA: BEGIN OF IT_MKPF OCCURS 0.
          INCLUDE TYPE MKPF.
  DATA: LFART LIKE LIKP-LFART,
  END OF IT_MKPF.

  DATA: BEGIN OF IT_MSEG OCCURS 0.
          INCLUDE TYPE MSEG.
  DATA: MTART LIKE MARA-MTART,
        MATKL LIKE MARA-MATKL,
      ZZTYPE LIKE AUSP-ATWRT,
      ZZTHICKNESS LIKE AUSP-ATWRT,
      ZZLENGTH LIKE AUSP-ATWRT,
      ZZWIDTH LIKE AUSP-ATWRT,
      ZZCORE LIKE AUSP-ATWRT,
      ZZTREATMENT LIKE AUSP-ATWRT,
      ZZCRITERIA LIKE AUSP-ATWRT,
      ZZNOMORROLL LIKE AUSP-ATWRT,
  END OF IT_MSEG.

  DATA: V_ATFLV TYPE P LENGTH 8 DECIMALS 2. "LIKE AUSP-ATFLV.


  RANGES: P_CPUDT FOR MKPF-CPUDT.


  P_CPUDT-SIGN = 'I'.
  P_CPUDT-OPTION = 'BT'.
  P_CPUDT-LOW = CPUDT1.
  P_CPUDT-HIGH = CPUDT2.
  APPEND P_CPUDT.


*-- connect SQL
  EXEC SQL.
    CONNECT TO 'TRIAS88' AS 'DBTRIAL'
  ENDEXEC.

  EXEC SQL.
    SET CONNECTION 'DBTRIAL'
  ENDEXEC.

*  EXEC SQL.
*    DELETE FROM ZMKPF
*    DELETE FROM ZMSEG
*  ENDEXEC.


*01--- exec RAW
  REFRESH: IT_MKPF, IT_MSEG.

  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MKPF
    FROM ( MKPF JOIN MSEG ON MKPF~MBLNR = MSEG~MBLNR ) JOIN MARA ON MSEG~MATNR = MARA~MATNR
    WHERE MKPF~CPUDT IN P_CPUDT AND MARA~MTART = 'ZRAW'
    AND MSEG~BWART IN ('101', '102', '261', '262', '301', '302').

  DELETE ADJACENT DUPLICATES FROM IT_MKPF COMPARING MBLNR.

  LOOP AT IT_MKPF.
    SELECT * APPENDING TABLE IT_MSEG FROM MSEG
      WHERE MBLNR = IT_MKPF-MBLNR.
  ENDLOOP.


  LOOP AT IT_MKPF.
    EXEC SQL.
