  :IT_MSEG-SHKZG, :IT_MSEG-WAERS, :IT_MSEG-DMBTR, :IT_MSEG-BNBTR, :IT_MSEG-BUALT, :IT_MSEG-SHKUM, :IT_MSEG-DMBUM, :IT_MSEG-BWTAR,
  :IT_MSEG-MENGE, :IT_MSEG-MEINS, :IT_MSEG-ERFMG, :IT_MSEG-ERFME, :IT_MSEG-BPMNG, :IT_MSEG-BPRME, :IT_MSEG-EBELN, :IT_MSEG-EBELP,
  :IT_MSEG-LFBJA, :IT_MSEG-LFBNR, :IT_MSEG-LFPOS, :IT_MSEG-SJAHR, :IT_MSEG-SMBLN, :IT_MSEG-SMBLP, :IT_MSEG-ELIKZ, :IT_MSEG-SGTXT,
