  :IT_MSEG-TBPOS, :IT_MSEG-XBLVS, :IT_MSEG-VSCHN, :IT_MSEG-NSCHN, :IT_MSEG-DYPLA, :IT_MSEG-UBNUM, :IT_MSEG-TBPRI, :IT_MSEG-TANUM,
  :IT_MSEG-WEANZ, :IT_MSEG-GRUND, :IT_MSEG-EVERS, :IT_MSEG-EVERE, :IT_MSEG-IMKEY, :IT_MSEG-KSTRG, :IT_MSEG-PAOBJNR, :IT_MSEG-PRCTR,
  :IT_MSEG-PS_PSP_PNR, :IT_MSEG-NPLNR, :IT_MSEG-AUFPL, :IT_MSEG-APLZL, :IT_MSEG-AUFPS, :IT_MSEG-VPTNR, :IT_MSEG-FIPOS, :IT_MSEG-SAKTO,
  :IT_MSEG-BSTMG, :IT_MSEG-BSTME, :IT_MSEG-XWSBR, :IT_MSEG-EMLIF, :IT_MSEG-EXBWR, :IT_MSEG-VKWRT, :IT_MSEG-AKTNR, :IT_MSEG-ZEKKN,
  :IT_MSEG-VFDAT, :IT_MSEG-CUOBJ_CH, :IT_MSEG-EXVKW, :IT_MSEG-PPRCTR, :IT_MSEG-RSART, :IT_MSEG-GEBER, :IT_MSEG-FISTL, :IT_MSEG-MATBF,
  :IT_MSEG-UMMAB, :IT_MSEG-BUSTM, :IT_MSEG-BUSTW, :IT_MSEG-MENGU, :IT_MSEG-WERTU, :IT_MSEG-LBKUM, :IT_MSEG-SALK3, :IT_MSEG-VPRSV,
  :IT_MSEG-FKBER, :IT_MSEG-DABRBZ, :IT_MSEG-VKWRA, :IT_MSEG-DABRZ, :IT_MSEG-XBEAU, :IT_MSEG-LSMNG, :IT_MSEG-LSMEH, :IT_MSEG-KZBWS,
  :IT_MSEG-QINSPST, :IT_MSEG-URZEI, :IT_MSEG-J_1BEXBASE, :IT_MSEG-MWSKZ, :IT_MSEG-TXJCD, :IT_MSEG-EMATN, :IT_MSEG-J_1AGIRUPD, :IT_MSEG-VKMWS,
  :IT_MSEG-HSDAT, :IT_MSEG-BERKZ, :IT_MSEG-MAT_KDAUF, :IT_MSEG-MAT_KDPOS, :IT_MSEG-MAT_PSPNR, :IT_MSEG-XWOFF, :IT_MSEG-BEMOT, :IT_MSEG-PRZNR,
  :IT_MSEG-LLIEF, :IT_MSEG-LSTAR, :IT_MSEG-XOBEW, :IT_MSEG-GRANT_NBR, :IT_MSEG-ZUSTD_T156M, :IT_MSEG-SPE_GTS_STOCK_TY, :IT_MSEG-KBLNR,
  :IT_MSEG-KBLPOS, :IT_MSEG-XMACC, :IT_MSEG-VGART_MKPF, :IT_MSEG-BUDAT_MKPF, :IT_MSEG-CPUDT_MKPF, :IT_MSEG-CPUTM_MKPF, :IT_MSEG-USNAM_MKPF,
  :IT_MSEG-XBLNR_MKPF, :IT_MSEG-TCODE2_MKPF, :IT_MSEG-VBELN_IM, :IT_MSEG-VBELP_IM, :IT_MSEG-/BEV2/ED_KZ_VER, :IT_MSEG-/BEV2/ED_USER,
  :IT_MSEG-/BEV2/ED_AEDAT, :IT_MSEG-/BEV2/ED_AETIM, :IT_MSEG-DISUB_OWNER, :IT_MSEG-COMPL_MARK, :IT_MSEG-FZGLS_MARK, :IT_MSEG-ETANP_MARK,
  :IT_MSEG-POPUP_MARK, :IT_MSEG-OINAVNW, :IT_MSEG-OICONDCOD, :IT_MSEG-CONDI,
  :IT_MSEG-ZZTYPE, :IT_MSEG-ZZTHICKNESS, :IT_MSEG-ZZLENGTH, :IT_MSEG-ZZWIDTH, :IT_MSEG-ZZCORE, :IT_MSEG-ZZTREATMENT,
  :IT_MSEG-ZZCRITERIA, :IT_MSEG-ZZNOMORROLL)
    ENDEXEC.
  ENDLOOP.

  REFRESH: IT_MKPF, IT_MSEG.

ENDFUNCTION.