    ENDEXEC.
  ENDLOOP.


  LOOP AT IT_MSEG.
    EXEC SQL.
      INSERT INTO ZMSEG(CLIENT, MATERIALDOC,
  MATDOCYEAR, MATDOCITEM, LINEID, PARENTID, LEVEL, ORIGLINEITM, MOVEMENTTYPE, AUTOCREATED, MATERIAL, PLANT,
  STORLOCATION, BATCH, STOCKTYPE, STATUSKEY, BATCHRESTR, SPECIALSTOCK, VENDOR, CUSTOMER, SALESORDER, SALESORDITEM,
  SORDERSCHEDULE, DISTRIBUTION, DEBITCREDIT, CURRENCY, AMOUNTINLC, DELIVERYCOSTS, AMOUNT, DCINDREVAL, REVALUATION, VALUATIONTYPE,
