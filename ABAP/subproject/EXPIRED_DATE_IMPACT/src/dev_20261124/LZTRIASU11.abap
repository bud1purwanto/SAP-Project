  GRNONVALUATED, NOOFPALLETS, WAREHOUSENO, STORAGETYPE, STORAGEBIN, STOCKCATEGORY, MOVEMENTTYPE2, TRNUMBER, TRITEM, POSTINGINWM,
  INTSTPSTSRC, INTERPOSTDEST, DYNAMICBIN, POSTINGCHGENO, TRNSFRPRIORITY, TONUMBER, NOOFGRSLIPS, REASONFORMVMT,
  SHIPPINGINSTR, COMPLIANCE, REALESTATEKEY, COSTOBJECT, PROFITSEGMENT, PROFITCENTER, WBSELEMENT, NETWORK, PLANNOFOPER, COUNTER,
  ITEMNUMBER, PARTNER, COMMITMENTITEM, GLACCOUNT, QTYINOUN, ORDERUNIT, REVGRDESPIR, VENDOR2, EXTAMOUNTLC, SALVALINCVAT,
  PROMOTION, SEQNOACCASS, SLEDBBD, INTOBJECTNO, SALESVALUE, PARTNERPC, RECORDTYPE, FUND, FUNDSCENTER, STOCKMAT,
  RECEIVINGMAT2, QUANTITYSTRING, VALUESTRING, QTYUPDATING, VALUEUPDATE, VALUATEDSTOCK, TOTALVALUE, PRICECONTROL,
  FUNCTIONALAREA, REFERENCEDATE, SALVALWOVAT, REFERENCEDATE2, AUTOMATICPO, DELNOTEQTY, DELNOTEUNIT, VALUATION,
  STATUSGRDOC, ORIGLINEITM2, ALTBASEAMNT, TAXCODE, TAXJUR, MPNMATERIAL, GIREVALOK, TAXCODE2, DATEOFMANUF, STAGINGIND,
  SALESORDER2, SALESORDITEM2, WBSELEMENT2, CALCNOFVALOPEN, ACCTGINDICATOR, BUSINESSPROC, SUPPLVENDOR, ACTIVITYTYPE,
  VENDORSTKVAL, GRANTS, STOCKTYPEMOD, GTSSTOCKTYPE, EARMARKEDFUNDS, DOCUMENTITEM, MULTIACCTASSGT, TRANSEVTYPE,
  POSTINGDATE, ENTEREDON, ENTEREDAT, USERNAME1, REFERENCE, TRANSACTIONCODE, DELIVERY, ITEM2, EDSTATUS, USERNAME2,
  CHANGEDON, TIME, OWNEROFSTOCK, COMPLIND, DONOTADJCRQ, ADJUSTITEM, DIALOGBOX, NONDEDUCTIBLE, CONDKEY1, CONDKEY2,
  TYPE, THICK, WIDTH, LENGTH, CORE, TREATMENT, CRITGRADE, ROLLNO)

