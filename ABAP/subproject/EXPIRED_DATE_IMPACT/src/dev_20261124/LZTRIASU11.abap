  TYPE, THICK, WIDTH, LENGTH, CORE, TREATMENT, CRITGRADE, ROLLNO)

    VALUES(:IT_MSEG-MANDT, :IT_MSEG-MBLNR, :IT_MSEG-MJAHR, :IT_MSEG-ZEILE, :IT_MSEG-LINE_ID, :IT_MSEG-PARENT_ID, :IT_MSEG-LINE_DEPTH,
