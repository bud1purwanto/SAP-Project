           :IT_MKPF-CPUDT, :IT_MKPF-CPUTM, :IT_MKPF-AEDAT, :IT_MKPF-USNAM, :IT_MKPF-TCODE, :IT_MKPF-XBLNR, :IT_MKPF-BKTXT, :IT_MKPF-FRATH,
           :IT_MKPF-FRBNR, :IT_MKPF-WEVER, :IT_MKPF-XABLN, :IT_MKPF-AWSYS, :IT_MKPF-BLA2D, :IT_MKPF-TCODE2, :IT_MKPF-BFWMS, :IT_MKPF-EXNUM,
           :IT_MKPF-SPE_BUDAT_UHR, :IT_MKPF-SPE_BUDAT_ZONE, :IT_MKPF-LE_VBELN, :IT_MKPF-SPE_LOGSYS,
           :IT_MKPF-SPE_MDNUM_EWM, :IT_MKPF-GTS_CUSREF_NO, :IT_MKPF-FLS_RSTO, :IT_MKPF-MSR_ACTIVE, :IT_MKPF-KNUMV, :IT_MKPF-XCOMPL, :IT_MKPF-LFART)
    ENDEXEC.
  ENDLOOP.


  LOOP AT IT_MSEG.
    EXEC SQL.
      INSERT INTO ZMSEG(CLIENT, MATERIALDOC,
  MATDOCYEAR, MATDOCITEM, LINEID, PARENTID, LEVEL, ORIGLINEITM, MOVEMENTTYPE, AUTOCREATED, MATERIAL, PLANT,
