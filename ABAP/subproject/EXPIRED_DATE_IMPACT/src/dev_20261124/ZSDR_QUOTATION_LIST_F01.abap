    DATA: V_WEEK1(2), V_YEAR(4), V_IDX(1), V_TEXT(10).
    V_WEEK1 = IT_QUOT-ZREQDLV+4(2).
    V_YEAR = IT_QUOT-ZREQDLV(4).
    V_IDX = V_WEEK1+1(1).

    IF V_IDX = 1.
      V_TEXT = 'st'.
    ELSEIF V_IDX = 2.
      V_TEXT = 'nd'.
    ELSEIF V_IDX = 3.
      V_TEXT = 'rd'.
    ELSEIF V_IDX = '4' OR
