    ENDIF.

    IF Z_KPEIN NE 0.
      V_RESULT = Z_AMOUNT / Z_KPEIN.
    ELSE.
      V_RESULT = Z_AMOUNT.
    ENDIF.

    IF Z_CURRL NE  Z_CURR.
