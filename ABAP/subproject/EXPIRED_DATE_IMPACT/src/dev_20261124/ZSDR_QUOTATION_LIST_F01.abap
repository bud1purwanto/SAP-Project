       'PRODH3'   ''  ''  ''  20   'Prod Hie. 3'    ''   ''  ''  '',
       'KWMENG'   ''  ''  ''  10   'Order Qty'    ''   ''  ''  '',
       'VRKME'   ''  ''  ''  10   'UoM'    ''   ''  ''  '',
       'NTGEW'   ''  ''  ''  15   'Net Weight (Kg)'    ''   ''  ''  '',
       'BRGEW'   ''  ''  ''  15   'Gross Weight (Kg)'    ''   ''  ''  '',
       'ZTOTPRICE'   ''  ''  ''  15   'Total Unit Price'    ''   ''  ''  '',
       'KBETR'   ''  ''  ''  10   'Unit Price'    ''   ''  ''  '',
       'ZSHP'   ''  ''  ''  15   'Shortage Payment (-)'    ''   ''  ''  '',
       'ZIN1'   ''  ''  ''  15   'Insurance(+)'    ''   ''  ''  '',
