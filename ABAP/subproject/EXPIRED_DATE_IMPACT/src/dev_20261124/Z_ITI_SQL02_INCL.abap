DATA : T_RBKP LIKE STANDARD TABLE OF RBKP,
       T_RSEG LIKE STANDARD TABLE OF RSEG.
FORM GET_DATA_RESERVATION USING VALUE(P_DATE) TYPE STANDARD TABLE CHANGING W_RBKP LIKE T_RBKP W_RSEG LIKE T_RSEG.
  SELECT * INTO TABLE W_RBKP FROM RBKP WHERE CPUDT IN P_DATE.

  IF W_RBKP[] IS NOT INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE W_RSEG
    FROM RSEG FOR ALL ENTRIES IN W_RBKP
    WHERE RSEG~MANDT = W_RBKP-MANDT AND
        RSEG~BELNR = W_RBKP-BELNR AND
        RSEG~GJAHR = W_RBKP-GJAHR.
  ENDIF.

ENDFORM.                    "GET_DATA_BSEG

"ADD BY WHIKA 07 JAN 2016
DATA : T_ZEKKO LIKE STANDARD TABLE OF ZPOUTS WITH HEADER LINE.
FORM GET_LIST_PO_OPEN TABLES IT_EKKO LIKE T_ZEKKO[] USING VALUE(P_ZBSART) TYPE STANDARD TABLE.
 DATA : BEGIN OF IT_TEMP01 OCCURS 0,
          EBELN TYPE EKKO-EBELN, "Purchasing Doc.
          EBELP TYPE EKPO-EBELP,
          WAERS TYPE EKKO-WAERS,
          BATXT TYPE T161T-BATXT,
          NAME1 TYPE LFA1-NAME1,
          AEDAT TYPE EKKO-AEDAT,
          TEXT1 TYPE T052U-TEXT1,
          BEZEI TYPE TINCT-BEZEI,
          EKOTX TYPE T024E-EKOTX,
          EKNAM TYPE T024-EKNAM,
          MENGE TYPE EKPO-MENGE,
          MEINS TYPE EKPO-MEINS,
          NETPR TYPE EKPO-NETPR,
          EINDT TYPE EKET-EINDT,
          ZNAME1 TYPE T001W-NAME1,
          BSART TYPE EKKO-BSART,
          MAKTX TYPE MAKT-MAKTX,
          PEINH TYPE EKPO-PEINH,
          BPRME TYPE EKPO-BPRME,
          LMEIN TYPE EKPO-LMEIN,
          CHARG TYPE EKET-CHARG, "Batch Number
          MATNR TYPE EKPO-MATNR,
          UMREZ TYPE EKPO-UMREZ,
          ZLAGMG(13) TYPE C,
          ZBDESC(50) TYPE C, "Batch Deskription
         END OF IT_TEMP01.

  DATA : IT_ZEKKO TYPE ZPOUTS OCCURS 0 WITH HEADER LINE.

  DATA : IT_INLINES TYPE TLINE OCCURS 0 WITH HEADER LINE,
         IT_LINES LIKE TLINE OCCURS 0 WITH HEADER LINE,
         FINLINE_COUNT  LIKE SY-STEPL.
  DATA : ZC_ALINEA TYPE I,
         ZC_LINE TYPE I.

  DATA: BEGIN OF HTEXT,                   "Struktur für Textparameter
          TDOBJECT LIKE THEAD-TDOBJECT,
          TDID     LIKE THEAD-TDID,
          TDNAME   LIKE THEAD-TDNAME,
          TDSPRAS  LIKE THEAD-TDSPRAS,
        END OF  HTEXT.

  DATA: CURRENCY LIKE TCURC-WAERS,
        AMMOUNT LIKE WMTO_S-AMOUNT,
        DISPLAY LIKE WMTO_S-AMOUNT.

    SELECT EK~EBELN EP~EBELP EK~WAERS TT~BATXT LF~NAME1 EK~AEDAT TU~TEXT1 TC~BEZEI TE~EKOTX T0~EKNAM
      EP~MENGE EP~MEINS EP~NETPR EE~EINDT TW~NAME1 EK~BSART MK~MAKTX EP~PEINH EP~BPRME EP~LMEIN EE~CHARG EP~MATNR EP~UMREZ
      INTO TABLE IT_TEMP01
      FROM EKKO AS EK
      JOIN T161T AS TT ON TT~BSART = EK~BSART AND TT~SPRAS = 'EN'
      JOIN LFA1 AS LF ON LF~LIFNR = EK~LIFNR AND LF~SPRAS = 'EN'
      JOIN T052U AS TU ON TU~ZTERM = EK~ZTERM AND TU~SPRAS = 'EN'
      LEFT JOIN TINCT AS TC ON TC~INCO1 = EK~INCO1 AND TC~SPRAS = 'EN'
      JOIN T024E AS TE ON TE~EKORG = EK~EKORG
      JOIN T024 AS T0 ON T0~EKGRP = EK~EKGRP
      JOIN EKPO AS EP ON EP~EBELN = EK~EBELN
      JOIN EKET AS EE ON EP~EBELN = EE~EBELN AND EK~EBELN = EE~EBELN AND EP~EBELP = EE~EBELP
      JOIN T001W AS TW ON TW~WERKS = EP~WERKS AND TW~SPRAS = 'EN'
      LEFT JOIN MAKT AS MK ON MK~MATNR = EP~MATNR
      WHERE EK~FRGKE = '1' AND
            EP~ELIKZ <> 'X' AND
            EP~LOEKZ <> 'L' AND
            EK~BSART IN P_ZBSART.

LOOP AT IT_TEMP01.
    HTEXT-TDID   = 'VERM'.
    FINLINE_COUNT = 1.
    HTEXT-TDOBJECT = 'CHARGE'.
    HTEXT-TDNAME = IT_TEMP01-MATNR.
    HTEXT-TDNAME+22(10) = IT_TEMP01-CHARG.
    CLEAR IT_INLINES. CLEAR IT_LINES.
    REFRESH IT_INLINES. REFRESH IT_LINES.
    CALL FUNCTION 'READ_TEXT_INLINE'
      EXPORTING
        ID              = HTEXT-TDID
        INLINE_COUNT    = FINLINE_COUNT
        LANGUAGE        = SY-LANGU
        NAME            = HTEXT-TDNAME
        OBJECT          = HTEXT-TDOBJECT
      TABLES
        INLINES         = IT_INLINES
        LINES           = IT_LINES
      EXCEPTIONS
        ID              = 1
        LANGUAGE        = 2
        NAME            = 3
        NOT_FOUND       = 4
        OBJECT          = 5
        REFERENCE_CHECK = 6
        OTHERS          = 7.
    READ TABLE IT_INLINES INDEX 1.
    IT_TEMP01-ZBDESC = IT_INLINES-TDLINE.
    MODIFY IT_TEMP01 TRANSPORTING ZBDESC.

    CLEAR : CURRENCY, AMMOUNT.
    CURRENCY = IT_TEMP01-WAERS.
    AMMOUNT = IT_TEMP01-NETPR.

    CALL FUNCTION 'CURRENCY_AMOUNT_SAP_TO_DISPLAY'
     EXPORTING
          CURRENCY        = CURRENCY
          AMOUNT_INTERNAL = AMMOUNT
    IMPORTING
         AMOUNT_DISPLAY   = DISPLAY
    EXCEPTIONS
         INTERNAL_ERROR   = 1
         OTHERS           = 2.

    CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
    EXPORTING
    INPUT          = IT_TEMP01-MEINS
    IMPORTING
    OUTPUT         = IT_TEMP01-MEINS
    EXCEPTIONS
    UNIT_NOT_FOUND = 01.

    MODIFY IT_TEMP01 TRANSPORTING MEINS.

    CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
    EXPORTING
    INPUT          = IT_TEMP01-LMEIN
    IMPORTING
    OUTPUT         = IT_TEMP01-LMEIN
    EXCEPTIONS
    UNIT_NOT_FOUND = 01.

    MODIFY IT_TEMP01 TRANSPORTING LMEIN.

    CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
    EXPORTING
    INPUT          = IT_TEMP01-BPRME
    IMPORTING
    OUTPUT         = IT_TEMP01-BPRME
    EXCEPTIONS
    UNIT_NOT_FOUND = 01.

    MODIFY IT_TEMP01 TRANSPORTING BPRME.

    MOVE-CORRESPONDING IT_TEMP01 TO IT_EKKO.
    IT_EKKO-ZMENGE = IT_TEMP01-MENGE.
    IT_EKKO-NETPR = DISPLAY.
    IT_EKKO-ZLAGMG = IT_TEMP01-MENGE * IT_TEMP01-UMREZ.
*    IT_EKKO-MEINS = UNIT_INT.
    APPEND IT_EKKO.
    CLEAR IT_EKKO.
  ENDLOOP.
ENDFORM.