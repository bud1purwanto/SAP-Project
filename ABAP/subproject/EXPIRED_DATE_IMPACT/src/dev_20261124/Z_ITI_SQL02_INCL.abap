*----------------------------------------------------------------------*
FORM GET_DATA_PURCHASE_REQUISITION USING VALUE(TEMP_BANFN) TYPE EBAN-BANFN CHANGING W_EBAN LIKE T_EBAN W_EBKN LIKE T_EBKN.
  "------------------------------SELECT EBAN
  SELECT MANDT BANFN BNFPO BSART BSTYP BSAKZ LOEKZ STATU ESTKZ FRGKZ FRGZU FRGST EKGRP ERNAM ERDAT AFNAM TXZ01 MATNR EMATN WERKS LGORT BEDNR MATKL RESWK MENGE MEINS BUMNG
         BADAT LPEIN LFDAT FRGDT WEBAZ PREIS PEINH PSTYP KNTTP KZVBR KFLAG VRTKZ TWRKZ WEPOS WEUNB REPOS LIFNR FLIEF EKORG VRTYP KONNR KTPNR INFNR ZUGBA QUNUM QUPOS DISPO
         SERNR BVDAT BATOL BVDRK EBELN EBELP BEDAT BSMNG LBLNI BWTAR XOBLR EBAKZ RSNUM SOBKZ ARSNR ARSPS FIXKZ BMEIN REVLV VORAB PACKNO KANBA BPUEB CUOBJ FRGGR FRGRL AKTNR
         CHARG UMSOK VERID FIPOS FISTL GEBER KZKFG SATNR MNG02 DAT01 ATTYP ADRNR ADRN2 KUNNR EMLIF LBLKZ KZBWS WAERS IDNLF GSFRG MPROF KZFME SPRAS TECHS MFRPN MFRNR EMNFR
         FORDN FORDP PLIFZ BERID UZEIT FKBER GRANT_NBR MEMORY BANPR RLWRT BLCKD REVNO BLCKT BESWK EPROFILE EPREFDOC EPREFITM GMMNG WRTKZ RESLO KBLNR KBLPOS PRIO_URG PRIO_REQ
         MEMORYTYPE ANZSN MHDRZ IPRKZ NODISP SRM_CONTRACT_ID SRM_CONTRACT_ITM BUDGET_PD ZZNOTIFICATION ZZPORETUR ZZITEMPO ADVCODE STACODE BANFN_CS BNFPO_CS ITEM_CS BSMNG_SND
         ADMOI ADPRI LPRIO ADACN SERRU DISUB_SOBKZ DISUB_PSPNR DISUB_KUNNR DISUB_VBELN DISUB_POSNR DISUB_OWNER IUID_RELEVANT
  INTO TABLE W_EBAN
  FROM EBAN
  WHERE BANFN = TEMP_BANFN.

  IF W_EBAN[] IS NOT INITIAL.
      "------------------------------SELECT EBKN
      SELECT EBKN~MANDT EBKN~BANFN EBKN~BNFPO EBKN~ZEBKN EBKN~LOEKZ EBKN~ERDAT EBKN~ERNAM EBKN~MENGE EBKN~VPROZ EBKN~SAKTO EBKN~GSBER EBKN~KOSTL     EBKN~PROJN EBKN~VBELN EBKN~VBELP
             EBKN~VETEN EBKN~ANLN1 EBKN~ANLN2 EBKN~AUFNR EBKN~WEMPF EBKN~ABLAD EBKN~KOKRS EBKN~XBKST EBKN~XBAUF EBKN~XBPRO EBKN~KSTRG EBKN~PAOBJNR     EBKN~PRCTR EBKN~PS_PSP_PNR EBKN~NPLNR
             EBKN~AUFPL EBKN~IMKEY EBKN~APLZL EBKN~VPTNR EBKN~FIPOS EBKN~RECID EBKN~FISTL EBKN~GEBER EBKN~FKBER EBKN~DABRZ EBKN~NETWR EBKN~AUFPL_ORD     EBKN~APLZL_ORD EBKN~KBLNR EBKN~KBLPOS
             EBKN~LSTAR EBKN~PRZNR EBKN~GRANT_NBR EBKN~FM_SPLIT_BATCH EBKN~FM_SPLIT_BEGRU EBKN~BUDGET_PD EBKN~EGRUP EBKN~VNAME EBKN~TCOBJNR     EBKN~DATEOFSERVICE EBKN~NOTAXCORR EBKN~DIFFOPTRATE
             EBKN~HASDIFFOPTRATE
      INTO TABLE W_EBKN
      FROM EBKN FOR ALL ENTRIES IN W_EBAN
      WHERE EBKN~MANDT = W_EBAN-MANDT AND
            EBKN~BANFN = W_EBAN-BANFN AND
            EBKN~BNFPO = W_EBAN-BNFPO.
   ENDIF.
ENDFORM.                    "GET_DATA_PURCHASE_REQUISITION

FORM GET_DATA_PURCHASE_REQUISITION2 USING VALUE(P_DATE) TYPE STANDARD TABLE CHANGING W_EBAN LIKE T_EBAN W_EBKN LIKE T_EBKN.
  SELECT * INTO TABLE W_EBAN FROM EBAN WHERE ERDAT IN P_DATE. "CHANGED ON
  SELECT * APPENDING TABLE W_EBAN FROM EBAN WHERE BADAT IN P_DATE. "CREATED ON
  SORT W_EBAN BY BANFN BNFPO.
  DELETE ADJACENT DUPLICATES FROM W_EBAN COMPARING BANFN BNFPO.

  IF W_EBAN[] IS NOT INITIAL.
    SELECT * INTO TABLE W_EBKN FROM EBKN
    FOR ALL ENTRIES IN W_EBAN
    WHERE EBKN~MANDT = W_EBAN-MANDT AND
          EBKN~BANFN = W_EBAN-BANFN AND
          EBKN~BNFPO = W_EBAN-BNFPO.
  ENDIF.

ENDFORM.

