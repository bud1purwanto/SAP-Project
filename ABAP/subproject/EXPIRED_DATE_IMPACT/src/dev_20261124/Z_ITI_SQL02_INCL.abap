DATA : T_MLHD LIKE STANDARD TABLE OF MLHD,
       T_MLIT LIKE STANDARD TABLE OF MLIT,
       T_MLPP LIKE STANDARD TABLE OF MLPP,
       T_MLCR LIKE STANDARD TABLE OF MLCR.

*&---------------------------------------------------------------------*
*&      Form  GET_DATA_MATERIAL_LEDGER
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->VALUE      text
*      -->(PV_CPUDT) text
*      -->VALUE      text
*      -->(Y_KJAHR)  text
*      -->W_MLHD     text
*      -->W_MLIT     text
*      -->W_MLPP     text
*      -->W_MLCR     text
*----------------------------------------------------------------------*
FORM GET_DATA_MATERIAL_LEDGER USING VALUE(PV_CPUDT) TYPE STANDARD TABLE
                                    VALUE(Y_KJAHR) TYPE STANDARD TABLE
                              CHANGING W_MLHD LIKE T_MLHD
                                       W_MLIT LIKE T_MLIT
                                       W_MLPP LIKE T_MLPP
                                       W_MLCR LIKE T_MLCR.

  "------------------------------SELECT MLHD
  SELECT  MANDT BELNR KJAHR VGART AWTYP AWREF AWORG AWSYS STORNO UMBEW BLDAT CPUDT CPUTM USNAM TCODE GLVOR LOGSYS PVERS XCOBL_CONS BKTXT KONGR
  INTO TABLE W_MLHD
  FROM MLHD
  WHERE CPUDT IN PV_CPUDT AND KJAHR IN Y_KJAHR.

    IF W_MLHD[] IS NOT INITIAL.
  "------------------------------SELECT MLIT
      SELECT MLIT~MANDT MLIT~BELNR MLIT~KJAHR MLIT~POSNR MLIT~URZEILE MLIT~MATNR MLIT~BWTAR MLIT~BWKEY MLIT~KALNR MLIT~MEINS MLIT~SPART MLIT~GSBER
            MLIT~BWMOD MLIT~BUKRS MLIT~KTOPL MLIT~MLAST MLIT~PSART MLIT~BELNR_EA MLIT~KJAHR_EA MLIT~BELNR_MA MLIT~KJAHR_MA MLIT~ASCHEMA MLIT~PTYP     MLIT~PTYP_KAT MLIT~PTYP_BVALT MLIT~PTYP_PROC MLIT~BEWARTGRP MLIT~KATEGORIE MLIT~BVALT MLIT~PROCESS
MLIT~CSPLIT MLIT~VBELN MLIT~VBELP MLIT~PSPNR   MLIT~LIFNR MLIT~KZBWS MLIT~XOBEW MLIT~SOBKZ MLIT~XABRERR MLIT~BELNR_CONS MLIT~KJAHR_CONS MLIT~BELNR_WIP MLIT~KJAHR_WIP
      INTO TABLE W_MLIT
      FROM MLIT FOR ALL ENTRIES IN W_MLHD
      WHERE MLIT~BELNR = W_MLHD-BELNR AND MLIT~KJAHR = W_MLHD-KJAHR.
      ENDIF.

  IF W_MLIT[] IS NOT INITIAL.
  "------------------------------SELECT MLPP
     SELECT MLPP~MANDT MLPP~BELNR MLPP~KJAHR MLPP~POSNR MLPP~BDATJ MLPP~POPER MLPP~BUDAT MLPP~PERART MLPP~LBKUM MLPP~LBKUM_OLD MLPP~UNTPER MLPP~BKLAS    MLPP~XKONCHK MLPP~STATUS MLPP~MODIF
            MLPP~XVNB MLPP~XWIP MLPP~XOBJWIP MLPP~XNOPL MLPP~XCKMM MLPP~XCLEAN
     INTO TABLE W_MLPP
     FROM MLPP FOR ALL ENTRIES IN W_MLIT
     WHERE MLPP~BELNR = W_MLIT-BELNR AND MLPP~POSNR = W_MLIT-POSNR AND MLPP~KJAHR = W_MLIT-KJAHR.
  ENDIF.

  IF W_MLPP[] IS NOT INITIAL.
  "------------------------------SELECT MLCR
      SELECT MLCR~MANDT MLCR~BELNR MLCR~KJAHR MLCR~POSNR MLCR~BDATJ MLCR~POPER MLCR~CURTP MLCR~WAERS MLCR~SALK3 MLCR~SALK3_OLD
            MLCR~SALKV MLCR~SALKV_OLD MLCR~PEINH MLCR~PVPRS_OLD MLCR~STPRS_OLD MLCR~VPRSV_OLD MLCR~BNBTR MLCR~EXBWR MLCR~VKWRT
            MLCR~VKWRA MLCR~EXVKW MLCR~VKSAL_OLD
      INTO TABLE W_MLCR
      FROM MLCR FOR ALL ENTRIES IN W_MLPP
      WHERE MLCR~BELNR = W_MLPP-BELNR AND
        MLCR~KJAHR = W_MLPP-KJAHR AND
        MLCR~POSNR = W_MLPP-POSNR AND
        MLCR~BDATJ = W_MLPP-BDATJ AND
        MLCR~POPER = W_MLPP-POPER.
   ENDIF.

ENDFORM.                    "GET_DATA_MATERIAL_LEDGER


DATA : T_VBAK LIKE STANDARD TABLE OF VBAK,
       T_VBAP LIKE STANDARD TABLE OF VBAP.
*&---------------------------------------------------------------------*
*&      Form  GET_DATA_VBAK
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->VALUE      text
*      -->(P_DATE)   text
*      -->W_VBAK     text
*      -->W_VBAP     text
*----------------------------------------------------------------------*
FORM GET_DATA_VBAK USING VALUE(P_DATE) TYPE STANDARD TABLE CHANGING W_VBAK LIKE T_VBAK W_VBAP LIKE T_VBAP.

  SELECT * INTO TABLE W_VBAP FROM VBAP WHERE ERDAT IN P_DATE.
  SELECT * APPENDING TABLE W_VBAP FROM VBAP WHERE AEDAT IN P_DATE.
  SORT W_VBAP BY VBELN POSNR.
  DELETE ADJACENT DUPLICATES FROM W_VBAP COMPARING VBELN POSNR.

  SELECT * INTO TABLE W_VBAK FROM VBAK WHERE ERDAT IN P_DATE.
  SELECT * APPENDING TABLE W_VBAK FROM VBAK WHERE AEDAT IN P_DATE.
  SORT W_VBAK BY VBELN.
  DELETE ADJACENT DUPLICATES FROM W_VBAK COMPARING VBELN.

ENDFORM.                    "GET_DATA_VBAK

DATA : T_BKPF LIKE STANDARD TABLE OF BKPF,
       T_BSEG LIKE STANDARD TABLE OF BSEG.
*&---------------------------------------------------------------------*
*&      Form  GET_DATA_BSEG
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->VALUE      text
*      -->(P_DATE)   text
*      -->W_BKPF     text
*      -->W_BSEG     text
*----------------------------------------------------------------------*
FORM GET_DATA_BSEG USING VALUE(P_DATE) TYPE STANDARD TABLE CHANGING W_BKPF LIKE T_BKPF W_BSEG LIKE T_BSEG.
  SELECT * INTO TABLE W_BKPF FROM BKPF WHERE BUDAT IN P_DATE.

  IF W_BKPF[] IS NOT INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE W_BSEG
    FROM BSEG FOR ALL ENTRIES IN W_BKPF
    WHERE BSEG~MANDT = W_BKPF-MANDT AND
        BSEG~BUKRS = W_BKPF-BUKRS AND
        BSEG~BELNR = W_BKPF-BELNR AND
        BSEG~GJAHR = W_BKPF-GJAHR.
  ENDIF.

ENDFORM.                    "GET_DATA_BSEG

