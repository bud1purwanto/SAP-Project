*&---------------------------------------------------------------------*
*&      Form  GET_MSEG
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->VALUE      text
*      -->(PV_BUDAT) text
*      -->W_MSEG     text
*----------------------------------------------------------------------*

DATA : T_EBAN01 LIKE STANDARD TABLE OF ZEBAN01 WITH HEADER LINE,
       T_ITEXT LIKE STANDARD TABLE OF MATERIAL_LONGTEXT WITH HEADER LINE.
FORM GET_LIST_PR_OPEN TABLES IT_ITEXT LIKE T_ITEXT[] IT_EBAN01 LIKE T_EBAN01[] USING VALUE(P_BSART) TYPE STANDARD TABLE.
  DATA : BEGIN OF IT_TEMP OCCURS 0,
            CHARG TYPE EBAN-CHARG,
            MATNR TYPE EBAN-MATNR,
            BADAT TYPE EBAN-BADAT,
            BANFN TYPE EBAN-BANFN, "PR NUMBER
            MAKTX TYPE MAKT-MAKTX, "MAT. TEXT
            MENGE TYPE EBAN-MENGE, "QUANTITY
            PREIS TYPE EBAN-PREIS, "VALUATION PRICE
            WGBEZ TYPE T023T-WGBEZ, "MAT GROUP DESC
            LFDAT TYPE EBAN-LFDAT, "DELIVERY DATE
            WAERS TYPE EBAN-WAERS, "CURRENCY
            MEINS TYPE EBAN-MEINS, "UNIT OF MEASURE
            NAME1 TYPE T001W-NAME1, "PLANT
            BNFPO TYPE EBAN-BNFPO, "REQUISITION ITEM NUMBER
            KNTTX TYPE T163I-KNTTX, "DESCRIPTION FOR ACCOUNT ASSIGNMENT CATEGORIES
            PTEXT TYPE T163Y-PTEXT, "TEXT ITEM FOR CATEGORY
            AFNAM TYPE EBAN-AFNAM, "REQUISITIONER
            STRAS TYPE T001W-STRAS, "HOUSE NUMBER AND STREET
            SAKTO TYPE EBKN-SAKTO,
            BSART TYPE EBAN-BSART,
            TXT50 TYPE SKAT-TXT50, "G/L ACCOUNT LONG TEXT
            ZBDESC(50) TYPE C, "BATCH DESCRIPTION
         END OF IT_TEMP.
  DATA : IT_INLINES TYPE TLINE OCCURS 0 WITH HEADER LINE,
         IT_LINES LIKE TLINE OCCURS 0 WITH HEADER LINE,
         FINLINE_COUNT  LIKE SY-STEPL.
  DATA : ZC_ALINEA TYPE I,
         ZC_LINE TYPE I.
  DATA : V_DISPCURR LIKE TCURC-WAERS,
         V_INTVAL LIKE WMTO_S-AMOUNT,
         V_DISPVAL LIKE WMTO_S-AMOUNT,
         ZBDESC(132).

  DATA: BEGIN OF HTEXT,                   "Struktur für Textparameter
          TDOBJECT LIKE THEAD-TDOBJECT,
          TDID     LIKE THEAD-TDID,
          TDNAME   LIKE THEAD-TDNAME,
          TDSPRAS  LIKE THEAD-TDSPRAS,
        END OF  HTEXT.

  SELECT EB~CHARG EB~MATNR EB~BADAT EB~BANFN MK~MAKTX EB~MENGE EB~PREIS T3~WGBEZ EB~LFDAT EB~WAERS EB~MEINS TW~NAME1 EB~BNFPO
          T1~KNTTX T2~PTEXT
          EB~AFNAM TW~STRAS EK~SAKTO EB~BSART
  INTO TABLE IT_TEMP
  FROM EBAN AS EB
  JOIN MARA AS MR ON MR~MATNR = EB~MATNR
  JOIN MAKT AS MK ON MK~MATNR = MR~MATNR
  LEFT JOIN EBKN AS EK ON EK~BANFN = EB~BANFN AND EK~BNFPO = EB~BNFPO
  JOIN T001W AS TW ON TW~WERKS = EB~WERKS AND TW~SPRAS = 'EN'
  LEFT JOIN T163I AS T1 ON T1~KNTTP = EB~KNTTP AND T1~SPRAS = 'EN'
  LEFT JOIN T163Y AS T2 ON T2~PSTYP = EB~PSTYP AND T2~SPRAS = 'EN'
  LEFT JOIN T023T AS T3 ON T3~MATKL = MR~MATKL AND T3~SPRAS = 'EN'
  WHERE MR~MTART = 'ZRAW' AND
        EB~FRGKZ = 'X' AND
        EB~BSART IN P_BSART AND
        EB~LOEKZ <> 'X'.

  LOOP AT IT_TEMP.
    IF IT_TEMP-SAKTO IS NOT INITIAL.
      SELECT SINGLE TXT50 INTO IT_TEMP-TXT50 FROM SKAT WHERE SPRAS = 'EN' AND SAKNR = IT_TEMP-SAKTO.
    ENDIF.
    MODIFY IT_TEMP TRANSPORTING TXT50.

    CLEAR : V_DISPCURR, V_DISPVAL, V_INTVAL.
    V_DISPCURR = IT_TEMP-WAERS.
    V_INTVAL = IT_TEMP-PREIS.
    CALL FUNCTION 'CURRENCY_AMOUNT_SAP_TO_DISPLAY'
      EXPORTING
        CURRENCY              = V_DISPCURR
        AMOUNT_INTERNAL       = V_INTVAL
     IMPORTING
       AMOUNT_DISPLAY        = V_DISPVAL
    EXCEPTIONS
       INTERNAL_ERROR        = 1
       OTHERS                = 2.
    IT_TEMP-PREIS = V_DISPVAL.
    MODIFY IT_TEMP TRANSPORTING PREIS.

    CLEAR ZBDESC.
    CALL FUNCTION 'Z_GET_BATCH_DESC'
      EXPORTING
        CHARG         = IT_TEMP-CHARG
        MATNR         = IT_TEMP-MATNR
     IMPORTING
       ZDESC         = ZBDESC.
    IT_TEMP-ZBDESC = ZBDESC.
    MODIFY IT_TEMP TRANSPORTING ZBDESC.

    CLEAR HTEXT-TDNAME.
    CLEAR IT_LINES.
    REFRESH IT_LINES.
    HTEXT-TDID   = 'B01'.
    HTEXT-TDOBJECT = 'EBAN'.
    CONCATENATE IT_TEMP-BANFN IT_TEMP-BNFPO INTO HTEXT-TDNAME.
    CALL FUNCTION 'READ_TEXT'
      EXPORTING
        ID                            = HTEXT-TDID
        LANGUAGE                      = SY-LANGU
        NAME                          = HTEXT-TDNAME
        OBJECT                        = HTEXT-TDOBJECT
      TABLES
        LINES                         = IT_LINES
      EXCEPTIONS
       ID                            = 1
       LANGUAGE                      = 2
       NAME                          = 3
       NOT_FOUND                     = 4
       OBJECT                        = 5
       REFERENCE_CHECK               = 6
       WRONG_ACCESS_TO_ARCHIVE       = 7
       OTHERS                        = 8.

    ZC_ALINEA = 0.
    ZC_LINE = 0.
    LOOP AT IT_LINES.
      IF IT_LINES-TDFORMAT = '*'.
        ADD 1 TO ZC_ALINEA.
        ZC_LINE = 1.
      ELSE.
        ADD 1 TO ZC_LINE.
      ENDIF.
      IT_ITEXT-TDLINE = IT_LINES-TDLINE.
      IT_ITEXT-MATNR = HTEXT-TDNAME.
      IT_ITEXT-AUFPL = ZC_ALINEA.
      IT_ITEXT-APLZL = ZC_LINE.
      APPEND IT_ITEXT.
      CLEAR IT_ITEXT.
    ENDLOOP.

    MOVE-CORRESPONDING IT_TEMP TO IT_EBAN01.
    IT_EBAN01-ZMENGE = IT_TEMP-MENGE.
    IT_EBAN01-ZPREIS = IT_TEMP-PREIS.
    APPEND IT_EBAN01.
    CLEAR IT_EBAN01.
  ENDLOOP.
ENDFORM.
