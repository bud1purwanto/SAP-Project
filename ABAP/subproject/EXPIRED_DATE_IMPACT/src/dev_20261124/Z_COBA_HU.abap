  "--------------------------------FUNCTION F01------------------
*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA.
  DATA : KNKLI TYPE KNKK-KNKLI.
  "--------------------------------------GET HU--------------------------------
  IF S_EXIDV[] IS NOT INITIAL.
    SELECT
    VEKP~EXIDV
    VEKP~MAGRV
    VEPO~VENUM
    VEPO~UNVEL
    INTO CORRESPONDING FIELDS OF TABLE IT_VEKP_TEMP
    FROM VEKP
    INNER JOIN VEPO ON VEPO~VENUM = VEKP~VENUM
    WHERE VEKP~EXIDV IN S_EXIDV.

  ELSE.
    SELECT
    VEKP~EXIDV
    VEKP~MAGRV
    VEPO~VENUM
    VEPO~UNVEL
    INTO CORRESPONDING FIELDS OF TABLE IT_VEKP_TEMP
    FROM VEKP
    INNER JOIN VEPO ON VEPO~VENUM = VEKP~VENUM
    WHERE VEKP~EXIDV IN S_EXIDV
      AND VEPO~WERKS IN S_WERKS
      AND VEPO~LGORT IN S_LGORT
      AND VEPO~MATNR IN S_MATNR
      AND VEPO~CHARG IN S_CHARG.
  ENDIF.


  LOOP AT IT_VEKP_TEMP ASSIGNING <FS_VEKP_TEMP>  WHERE UNVEL EQ ''.
    IF <FS_VEKP_TEMP>-MAGRV NE 'TRS' AND <FS_VEKP_TEMP>-MAGRV NE 'LCL'.
      <FS_VEKP_TEMP>-UNVEL = <FS_VEKP_TEMP>-VENUM.
    ENDIF.
  ENDLOOP.

  DELETE IT_VEKP_TEMP WHERE UNVEL = ''.

  IF IT_VEKP_TEMP[] IS NOT INITIAL.
    SELECT
    VEKP~EXIDV
    VEKP~MAGRV
    VEPO~VENUM
    VEPO~UNVEL
    INTO CORRESPONDING FIELDS OF TABLE IT_VEKP
    FROM VEKP
    INNER JOIN VEPO ON VEPO~VENUM = VEKP~VENUM
    FOR ALL ENTRIES IN IT_VEKP_TEMP
    WHERE VEPO~VENUM = IT_VEKP_TEMP-UNVEL.
  ENDIF.

  LOOP AT IT_VEKP ASSIGNING <FS_VEKP> WHERE UNVEL EQ ''.
    <FS_VEKP>-UNVEL = <FS_VEKP>-VENUM.
  ENDLOOP.

  IF IT_VEKP[] IS NOT INITIAL.
    SELECT
      VEKP~EXIDV
      VEKP~VENUM
      VEKP~MAGRV
      VEKP~ERUHR
      VEKP~UEVEL
      VEPO~UNVEL
      VEPO~WERKS
      VEPO~LGORT
      VEPO~MATNR
      VEPO~CHARG
      VEPO~SONUM
      VEPO~VEMNG
      VEPO~WDATU
      VEPO~BESTQ
      VEPO~SOBKZ
      VEPO~VBELN AS ZVBELN
      VEPO~POSNR AS ZPOSNR
      VEKP~STATUS
      INTO CORRESPONDING FIELDS OF TABLE IT_HU2
      FROM VEKP
      INNER JOIN VEPO ON VEKP~VENUM = VEPO~VENUM
      FOR ALL ENTRIES IN IT_VEKP
      WHERE VEPO~VENUM = IT_VEKP-UNVEL
        AND VEPO~WERKS IN S_WERKS
        AND VEPO~LGORT IN S_LGORT
        AND VEPO~MATNR IN S_MATNR
        AND VEPO~CHARG IN S_CHARG.
*        %_HINTS ORACLE 'INDEX("VEPO" "VEPO~Z02")'.

  ENDIF.

  DELETE IT_HU2 WHERE ( MAGRV = 'BOX' OR MAGRV = 'PLT' ) AND ( STATUS EQ '0050' OR STATUS EQ '0001' OR STATUS EQ '0060' ).
  DELETE IT_HU2 WHERE ( MAGRV = 'TRS' OR MAGRV = 'LCL' ) AND ( STATUS EQ '0050' OR STATUS EQ '0060' ) .

  "-----------PLACE HU NUMBER MATCH WITH TYPE BOX/PLT/TRS/LCL--------------
  LOOP AT IT_HU2 ASSIGNING <FS_HU2> WHERE MAGRV = 'BOX' OR MAGRV = 'TRS' OR MAGRV = 'LCL'.
    IF IT_HU2-MAGRV = 'BOX'.
      <FS_HU2>-ZEXIDV = IT_HU2-EXIDV.
      <FS_HU2>-EXIDV = ''.
    ELSE.
      <FS_HU2>-ZZEXIDV = IT_HU2-EXIDV.
      <FS_HU2>-EXIDV = ''.
    ENDIF.
  ENDLOOP.

  "----------------FIND PARENT----------------
  SELECT
    VEKP~EXIDV
    VEKP~MAGRV
    VEPO~VENUM
    VEPO~UNVEL
    VEKP~UEVEL
    VEPO~CHARG
  INTO CORRESPONDING FIELDS OF TABLE IT_TEMP2
  FROM VEKP
  INNER JOIN VEPO ON VEPO~VENUM = VEKP~VENUM
  FOR ALL ENTRIES IN IT_HU2
  WHERE VEPO~VENUM = IT_HU2-UEVEL.

  LOOP AT IT_TEMP2.
     CLEAR IT_HU2.
    IT_HU2-VENUM2 = IT_TEMP2-UEVEL.
    IT_HU2-EXIDV = IT_TEMP2-EXIDV.
    MODIFY IT_HU2 TRANSPORTING VENUM2 EXIDV WHERE VENUM = IT_TEMP2-UNVEL AND MAGRV = 'BOX'.
    IT_HU2-ZZEXIDV = IT_TEMP2-EXIDV.
    MODIFY IT_HU2 TRANSPORTING ZZEXIDV WHERE VENUM = IT_TEMP2-UNVEL AND MAGRV = 'PLT'.
  ENDLOOP.

  IT_HU_TEMP[] = IT_HU2[].
  DELETE IT_HU_TEMP WHERE VENUM2 EQ ''.

  CLEAR IT_TEMP2[].
  REFRESH IT_TEMP2[].
  IF IT_HU_TEMP[] IS NOT INITIAL.
    SELECT  VEKP~EXIDV
          VEKP~MAGRV
          VEPO~VENUM
          VEPO~UNVEL
          VEKP~UEVEL
          VEPO~CHARG
    INTO CORRESPONDING FIELDS OF TABLE IT_TEMP2
    FROM VEKP
    INNER JOIN VEPO ON VEPO~VENUM = VEKP~VENUM
    FOR ALL ENTRIES IN IT_HU_TEMP
    WHERE VEPO~VENUM = IT_HU_TEMP-VENUM2.

    LOOP AT IT_TEMP2.
      CLEAR IT_HU2.
      IT_HU2-ZZEXIDV = IT_TEMP2-EXIDV.
      MODIFY IT_HU2 TRANSPORTING ZZEXIDV WHERE VENUM2 = IT_TEMP2-VENUM.
    ENDLOOP.
  ENDIF.

  DELETE IT_HU2 WHERE ZZEXIDV NE '' AND EXIDV EQ ''.

  IT_HU[] = IT_HU2[].

  "-------------------FIND WAREHOUSE NUMBER AND STORAGE BIN------------------
  "--------IF PLT <> ''----------------------------
  DELETE IT_HU2 WHERE EXIDV EQ ''.

  SELECT VEKP~EXIDV LEIN~LGPLA LEIN~LGNUM VEKP~ERDAT VEKP~VENUM
  INTO TABLE IT_LEIN
  FROM VEKP
  LEFT JOIN LEIN ON LEIN~LENUM = VEKP~EXIDV
  FOR ALL ENTRIES IN IT_HU2
  WHERE VEKP~EXIDV = IT_HU2-EXIDV.

  DELETE IT_LEIN WHERE LGNUM NOT IN S_LGNUM.
  DELETE IT_LEIN WHERE LGPLA NOT IN S_LGPLA.
  LOOP AT IT_LEIN.
    CLEAR IT_HU.
    IT_HU-LGNUM = IT_LEIN-LGNUM.
    IT_HU-LGPLA = IT_LEIN-LGPLA.
    IT_HU-ERDAT = IT_LEIN-ERDAT.

    CLEAR : V_OBJNR.
    CONCATENATE 'HU' IT_LEIN-VENUM INTO V_OBJNR.
    SELECT SINGLE TJ30T~TXT04
        INTO IT_HU-TXT04
        FROM TJ30T
        INNER JOIN HUSTOBJ ON TJ30T~STSMA = HUSTOBJ~STSMA
        INNER JOIN HUSSTAT ON HUSTOBJ~OBJNR = HUSSTAT~OBJNR
        WHERE HUSSTAT~INACT EQ ''
          AND HUSSTAT~STAT = TJ30T~ESTAT
          AND HUSSTAT~OBJNR = V_OBJNR.

    MODIFY IT_HU TRANSPORTING LGNUM LGPLA ERDAT TXT04 WHERE EXIDV = IT_LEIN-LENUM.
  ENDLOOP.
  "-----------------IF PLT = '' --------------------------
  CLEAR : IT_HU2[],IT_LEIN[].
  REFRESH : IT_HU2[],IT_LEIN[].
  IT_HU2[] = IT_HU[].
  DELETE IT_HU2 WHERE EXIDV NE ''.

  IF IT_HU2[] IS NOT INITIAL.
  SELECT LEIN~LENUM LEIN~LGPLA LEIN~LGNUM
  INTO TABLE IT_LEIN
  FROM LEIN
  FOR ALL ENTRIES IN IT_HU2
  WHERE LEIN~LENUM = IT_HU2-ZEXIDV AND
        LEIN~LGNUM IN S_LGNUM AND
        LEIN~LGPLA IN S_LGPLA.

  LOOP AT IT_LEIN.
    CLEAR IT_HU.
    IT_HU-LGNUM = IT_LEIN-LGNUM.
    IT_HU-LGPLA = IT_LEIN-LGPLA.
    MODIFY IT_HU TRANSPORTING LGNUM LGPLA  WHERE ZEXIDV = IT_LEIN-LENUM.
  ENDLOOP.
  ENDIF.

  IF S_VBELN[] IS NOT INITIAL.
    DELETE IT_HU WHERE SOBKZ NE 'E'.
  ENDIF.

  "-------------------------LOOP IT_HU-------------------
  LOOP AT IT_HU ASSIGNING <FS_HU>.

    IF <FS_HU>-SOBKZ EQ 'E'.
      <FS_HU>-VBELN = <FS_HU>-SONUM(10).
      <FS_HU>-POSNR = <FS_HU>-SONUM+10(6).
    ENDIF.

      IF <FS_HU>-VBELN NOT IN S_VBELN.
         DELETE IT_HU.
         CONTINUE.
      ENDIF.
      IF <FS_HU>-POSNR NOT IN S_POSNR.
         DELETE IT_HU.
         CONTINUE.
      ENDIF.

    IF <FS_HU>-SOBKZ EQ 'E'.
      CLEAR IT_SOBKZ_E.
      IT_SOBKZ_E-VBELN = <FS_HU>-VBELN.
      IT_SOBKZ_E-POSNR = <FS_HU>-POSNR.
      APPEND IT_SOBKZ_E.
    ELSEIF <FS_HU>-SOBKZ EQ 'W'.
      CLEAR IT_SOBKZ_W.
      IT_SOBKZ_W-VBELN = <FS_HU>-ZVBELN.
      IT_SOBKZ_W-POSNR = <FS_HU>-ZPOSNR.
      APPEND IT_SOBKZ_W.
    ELSEIF <FS_HU>-SOBKZ EQ 'O'.
      CLEAR IT_SOBKZ_O.
      IT_SOBKZ_O-MATNR = <FS_HU>-MATNR.
      IT_SOBKZ_O-CHARG = <FS_HU>-CHARG.
      APPEND IT_SOBKZ_O.
    ENDIF.

    "-------- Qty Roll
    <FS_HU>-ZQTYROL = '1'.

    "-----------------------PRODUCTION DATE----------------------
    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
      EXPORTING
        MATNR = <FS_HU>-MATNR
        CHARG = <FS_HU>-CHARG
      IMPORTING
        PDATE = <FS_HU>-ERSDA.


    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = <FS_HU>-EXIDV
      IMPORTING
        OUTPUT = <FS_HU>-EXIDV.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = <FS_HU>-ZEXIDV
      IMPORTING
        OUTPUT = <FS_HU>-ZEXIDV.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = <FS_HU>-ZZEXIDV
      IMPORTING
        OUTPUT = <FS_HU>-ZZEXIDV.

    "-----------------------CHARATERISTIC-------------------
    IF <FS_HU>-CHARG NE  ''.
      CALL FUNCTION 'ZCHARACTERISTICS'
        EXPORTING
          I_VAL_MATNR  = <FS_HU>-MATNR
          I_VAL_CHARGE = <FS_HU>-CHARG
        TABLES
          T_VAL_TAB    = IT_CHAR
        EXCEPTIONS
          NO_OBJECT    = 1
          T_L_E1       = 2
          T_L_E2       = 3.
      IF SY-SUBRC EQ 0.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZTYPE'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZTYPE =  <FS_CHAR>-ATWRT.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZTHICKNESS'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          MOVE <FS_CHAR>-ATFLV TO ATFLV1.
          <FS_HU>-ZZTHICKNESS =  ATFLV1.
        ENDIF.


        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZWIDTH'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          MOVE <FS_CHAR>-ATFLV TO ATFLV2.
          <FS_HU>-ZZWIDTH =  ATFLV2.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZLENGTHSHT'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          MOVE <FS_CHAR>-ATFLV TO ATFLV2.
          <FS_HU>-ZZLENGTH =  ATFLV2.
        ELSE.
          READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZLENGTH'  ASSIGNING <FS_CHAR>.
          IF SY-SUBRC = 0.
            MOVE <FS_CHAR>-ATFLV TO ATFLV2.
            <FS_HU>-ZZLENGTH =  ATFLV2.
          ENDIF.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZNOMORROLL'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZNOMORROLL =  <FS_CHAR>-ATWRT.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZALIAS'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZALIAS =  <FS_CHAR>-ATWRT.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZEXPIREDLIVE'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          IF <FS_HU>-ERSDA NE '00000000'.
            <FS_HU>-ZZEXPIREDLIVE =  <FS_HU>-ERSDA + <FS_CHAR>-ATFLV.
          ENDIF.
        ENDIF.


        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZCORE'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZCORE =  <FS_CHAR>-ATWTB.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZCRITERIA'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZCRITERIA =  <FS_CHAR>-ATWTB.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZPACKING'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZPACKING =  <FS_CHAR>-ATWTB.
        ENDIF.

        READ TABLE IT_CHAR  WITH  KEY ATNAM = 'ZZTREATMENT'  ASSIGNING <FS_CHAR>.
        IF SY-SUBRC = 0.
          <FS_HU>-ZZTREATMENT =  <FS_CHAR>-ATWTB.
        ENDIF.

      ENDIF.

    ENDIF.
  ENDLOOP.

  "-----GR HU DATE--------------
  SELECT MSEG~BUDAT_MKPF MSEG~CHARG
    INTO TABLE IT_WDATU
    FROM MSEG
    FOR ALL ENTRIES IN IT_HU
    WHERE MSEG~CHARG = IT_HU-CHARG
      AND MSEG~BWART = '311'
      AND MSEG~SHKZG = 'S'
      AND ( MSEG~LGORT LIKE '18%' OR MSEG~LGORT LIKE '28%' OR MSEG~LGORT LIKE '38%' )
      AND MSEG~UMLGO NOT LIKE '18%'
      AND MSEG~UMLGO NOT LIKE '28%'
      AND MSEG~UMLGO NOT LIKE '38%'.
  SORT IT_WDATU BY WDATU CHARG DESCENDING.
  DELETE ADJACENT DUPLICATES FROM IT_WDATU COMPARING WDATU CHARG.

  LOOP AT IT_WDATU.
    CLEAR IT_HU.
    IT_HU-WDATU = IT_WDATU-WDATU.
    MODIFY IT_HU TRANSPORTING WDATU WHERE CHARG = IT_WDATU-CHARG.
  ENDLOOP.

  SORT IT_SOBKZ_E BY VBELN POSNR.
  DELETE ADJACENT DUPLICATES FROM IT_SOBKZ_E COMPARING VBELN POSNR.
  SORT IT_SOBKZ_W BY VBELN POSNR.
  DELETE ADJACENT DUPLICATES FROM IT_SOBKZ_W COMPARING VBELN POSNR.
  SORT IT_SOBKZ_O BY MATNR CHARG.
  DELETE ADJACENT DUPLICATES FROM IT_SOBKZ_O COMPARING MATNR CHARG.

  "---------------IF SOBKZ = 'E'
  SELECT VBAK~VBELN VBAP~POSNR VBAK~AUART VBAP~PSTYV TVAKT~BEZEI
  INTO CORRESPONDING FIELDS OF TABLE IT_SO
  FROM VBAK
  JOIN VBAP ON VBAK~VBELN = VBAP~VBELN
  JOIN TVAKT ON TVAKT~AUART = VBAK~AUART AND TVAKT~SPRAS EQ 'E'
  FOR ALL ENTRIES IN IT_SOBKZ_E
  WHERE VBAK~VBELN = IT_SOBKZ_E-VBELN
  AND   VBAP~POSNR = IT_SOBKZ_E-POSNR.

  IT_SO-SOBKZ = 'E'.
  MODIFY IT_SO TRANSPORTING SOBKZ WHERE SOBKZ = ''.

  "---------------IF SOBKZ = 'W'
  SELECT LIPS~VBELN LIPS~POSNR LIPS~PSTYV MSKU~KULAB
  APPENDING CORRESPONDING FIELDS OF TABLE IT_SO
  FROM LIPS
  JOIN MSKU ON MSKU~CHARG = LIPS~CHARG
              AND MSKU~WERKS = LIPS~WERKS
              AND MSKU~MATNR = LIPS~MATNR
  FOR ALL ENTRIES IN IT_SOBKZ_W
  WHERE LIPS~VBELN = IT_SOBKZ_W-VBELN
    AND LIPS~POSNR = IT_SOBKZ_W-POSNR.

  IT_SO-SOBKZ = 'W'.
  MODIFY IT_SO TRANSPORTING SOBKZ WHERE SOBKZ NE 'E'.

  "---------------IF SOBKZ = 'O'
  SELECT MSLB~MATNR MSLB~CHARG MSLB~LBLAB
  APPENDING CORRESPONDING FIELDS OF TABLE IT_SO
  FROM MSLB
  FOR ALL ENTRIES IN IT_SOBKZ_O
  WHERE MSLB~MATNR = IT_SOBKZ_O-MATNR
        AND MSLB~CHARG = IT_SOBKZ_O-CHARG.

  IT_SO-SOBKZ = 'O'.
  MODIFY IT_SO TRANSPORTING SOBKZ WHERE SOBKZ NE 'E' AND SOBKZ NE 'W'.

  IF S_AUART[] IS NOT INITIAL.
      LOOP AT IT_SO WHERE AUART NOT IN S_AUART.
        DELETE IT_HU WHERE VBELN = IT_SO-VBELN.
        DELETE IT_SO WHERE VBELN = IT_SO-VBELN.
      ENDLOOP.
  ENDIF.

  LOOP AT IT_SO.
    CLEAR IT_HU.
    IF IT_SO-SOBKZ = 'E'.
      IT_HU-AUART = IT_SO-AUART.
      IT_HU-PSTYV = IT_SO-PSTYV.
      IT_HU-BEZEI = IT_SO-BEZEI.

*      IF IT_HU-AUART NOT IN S_AUART.
*        DELETE IT_HU WHERE AUART = IT_SO-AUART.
*        DELETE IT_SO WHERE AUART = IT_SO-AUART.
*        CONTINUE.
*      ENDIF.

      MODIFY IT_HU TRANSPORTING AUART PSTYV BEZEI WHERE VBELN = IT_SO-VBELN AND POSNR = IT_SO-POSNR AND SOBKZ = 'E'.

      CLEAR : IT_XVBPA.
      REFRESH : IT_XVBPA.
      CALL FUNCTION 'SD_PARTNER_READ'
        EXPORTING
          F_VBELN  = IT_SO-VBELN
          OBJECT   = 'VBPA'
        TABLES
          I_XVBADR = IT_XVBADR
          I_XVBPA  = IT_XVBPA.

      "- Customer Name
      READ TABLE IT_XVBPA  WITH KEY PARVW = 'AG'.
      IF SY-SUBRC = 0.
        IT_HU-NAME1 = IT_XVBPA-NAME1.
      ENDIF.

      "- Customer Code
      READ TABLE IT_XVBPA  WITH KEY PARVW = 'AG'.
      IF SY-SUBRC = 0.
        IT_HU-KUNNR = IT_XVBPA-KUNNR.
      ENDIF.

      "-Customer Group
      CLEAR : KNKLI.
      SELECT SINGLE KNKLI INTO KNKLI
      FROM KNKK
      WHERE KUNNR = IT_XVBPA-KUNNR.

      "- Baseline Date
      REFRESH : IT_BSID.
      CLEAR : IT_BSID.
      SELECT BSID~ZFBDT BSID~ZBD1T BSID~KUNNR BSID~WRBTR BSID~SHKZG
        INTO CORRESPONDING FIELDS OF TABLE IT_BSID
        FROM BSID
        INNER JOIN KNA1 ON BSID~KUNNR = KNA1~KUNNR
        JOIN KNKK ON KNA1~KUNNR = KNKK~KUNNR
          WHERE KNA1~KTOKD IN ('ZLAF', 'ZLOE', 'ZLTP')
*            AND BSID~KUNNR = <FS_HU>-KUNNR
            AND KNKK~KNKLI = KNKLI
            AND BSID~ZBD1T >= 0.

      SORT IT_BSID ASCENDING BY ZBD1T.
      LOOP AT IT_BSID ASSIGNING <FS_BSID>.
        IF <FS_BSID>-SHKZG EQ 'H'.
          <FS_BSID>-WRBTR = <FS_BSID>-WRBTR * -1.
        ENDIF.

        <FS_BSID>-DUEDT = <FS_BSID>-ZFBDT + <FS_BSID>-ZBD1T.
      ENDLOOP.

      DELETE IT_BSID  WHERE WRBTR LE 0.
      SORT IT_BSID ASCENDING BY DUEDT.
      READ TABLE IT_BSID  INDEX 1 ASSIGNING <FS_BSID> .
      IF SY-SUBRC = 0.
        V_BLOCK = SY-DATUM - <FS_BSID>-DUEDT.
      ELSE.
        V_BLOCK = 0.
      ENDIF.

      IF V_BLOCK >= 30.
       IT_HU-ZZBLOCK = 'BLOCKED'.
      ELSE.
        IT_HU-ZZBLOCK = ''.
      ENDIF.

      IF IT_SO-VBELN EQ ''.
        IT_HU-ZZBLOCK = ''.
      ENDIF.

      "- Sales Employee
      READ TABLE IT_XVBPA  WITH KEY PARVW = 'VE'.
      IF SY-SUBRC = 0.
        IT_HU-ZNAME1 = IT_XVBPA-NAME1.
      ENDIF.

      "- PO Number
      SELECT SINGLE VBKD~BSTKD
        INTO IT_HU-BSTKD
        FROM VBKD
        WHERE VBKD~VBELN = IT_SO-VBELN.

      "- PI Number
      CLEAR : IT_LINE, V_VBELV.
      REFRESH : IT_LINE.
      V_VBELV = IT_SO-VBELN.
      CALL FUNCTION 'READ_TEXT'
        EXPORTING
          CLIENT                  = SY-MANDT
          ID                      = 'Z101'
          LANGUAGE                = SY-LANGU
          NAME                    = V_VBELV
          OBJECT                  = 'VBBK'
        TABLES
          LINES                   = IT_LINE
        EXCEPTIONS
          ID                      = 1
          LANGUAGE                = 2
          NAME                    = 3
          NOT_FOUND               = 4
          OBJECT                  = 5
          REFERENCE_CHECK         = 6
          WRONG_ACCESS_TO_ARCHIVE = 7
          OTHERS                  = 8.
      IF SY-SUBRC <> 0.
*       Implement suitable error handling here
      ENDIF.

      READ TABLE IT_LINE INDEX 1.
      IF SY-SUBRC = 0.
        IT_HU-ZPINUM = IT_LINE-TDLINE.
      ENDIF.

      SELECT SINGLE VBEP~EDATU
      INTO IT_HU-VDATU
      FROM VBEP
      WHERE VBEP~VBELN = IT_SO-VBELN
      AND   VBEP~POSNR = IT_SO-POSNR.
      IF SY-SUBRC = 0.
        IF IT_HU-VDATU = SY-DATUM .
          IT_HU-DELUS = 'Hari Ini'.
        ELSEIF IT_HU-VDATU > SY-DATUM.
          CLEAR : V_TEXT1.
          IF IT_HU-VDATU+4(2) = SY-DATUM+4(2).
            CONCATENATE 'Sesudah Tanggal' SY-DATUM+6(2) INTO V_TEXT1 SEPARATED BY SPACE.
          ELSE.
            CONCATENATE 'Sesudah Bulan' SY-DATUM+4(2) INTO V_TEXT1 SEPARATED BY SPACE.
          ENDIF.
          IT_HU-DELUS = V_TEXT1.

        ELSEIF IT_HU-VDATU < SY-DATUM.
          CLEAR : V_TEXT1.
          IF IT_HU-VDATU+4(2) = SY-DATUM+4(2).
            CONCATENATE 'Sebelum Tanggal' SY-DATUM+6(2) INTO V_TEXT1 SEPARATED BY SPACE.
          ELSE.
            CONCATENATE 'Sebelum Bulan' SY-DATUM+4(2) INTO V_TEXT1 SEPARATED BY SPACE.
          ENDIF.
          IT_HU-DELUS = V_TEXT1.
        ENDIF.
      ENDIF.

      MODIFY IT_HU TRANSPORTING NAME1 KUNNR ZNAME1 BSTKD ZPINUM ZZBLOCK WHERE VBELN = IT_SO-VBELN.
      MODIFY IT_HU TRANSPORTING VDATU DELUS WHERE VBELN = IT_SO-VBELN AND POSNR = IT_SO-POSNR.
    ELSEIF IT_SO-SOBKZ = 'W'.
      IF  ( IT_SO-PSTYV EQ 'ZKEC' OR IT_SO-PSTYV EQ 'ZKEN' OR IT_SO-PSTYV EQ 'ZKRC' OR IT_SO-PSTYV EQ 'ZKRN' OR
                                  IT_SO-PSTYV EQ 'ZKAC' OR IT_SO-PSTYV EQ 'ZKAN' ) OR ( IT_SO-KULAB = 0 ).
        DELETE IT_HU WHERE VBELN = IT_SO-VBELN AND POSNR = IT_SO-POSNR AND SOBKZ = 'W'.
        CONTINUE.
      ELSE.
        IT_HU-PSTYV = IT_SO-PSTYV.
        MODIFY IT_HU TRANSPORTING PSTYV WHERE VBELN = IT_SO-VBELN AND POSNR = IT_SO-POSNR AND SOBKZ = 'W'.
      ENDIF.
    ELSEIF IT_SO-SOBKZ = 'O' AND IT_SO-LBLAB = 0.
      DELETE IT_HU WHERE MATNR = IT_SO-MATNR AND CHARG = IT_SO-CHARG AND SOBKZ = 'O'.
      CONTINUE.
    ENDIF.
  ENDLOOP.

*  "- HU
