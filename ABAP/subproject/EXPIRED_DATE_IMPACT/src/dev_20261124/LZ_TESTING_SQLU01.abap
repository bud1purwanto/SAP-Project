FUNCTION ZPP_EXEC_JR.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  TABLES
*"      IT_CHAR STRUCTURE  ZCHAR00 OPTIONAL
*"      GOODSMVT STRUCTURE  ZEXECJR OPTIONAL
*"      RETURN STRUCTURE  BAPIRET2 OPTIONAL
*"      CONFIRMATION STRUCTURE  ZCONF OPTIONAL
*"      MSEG STRUCTURE  MSEG OPTIONAL
*"      MKPF STRUCTURE  MKPF OPTIONAL
*"      AFRU STRUCTURE  AFRU OPTIONAL
*"----------------------------------------------------------------------

  DATA :DCLASS TYPE KLAH-CLASS,
        DKLART TYPE KLAH-KLART,
        DOBTAB TYPE TCLT-OBTAB,
        DOBJKY TYPE BAPI1003_KEY-OBJECT,
        DSTAT TYPE BAPI1003_KEY-STATUS,
        WCOND TYPE C.

  DATA : FBATCH TYPE BAPIBATCHKEY-BATCH,
         ZBAPICHAT TYPE STANDARD TABLE OF ZCHAR00 WITH HEADER LINE,
         ZBRETURN TYPE STANDARD TABLE OF BAPIRET2 WITH HEADER LINE,
         ZNUM TYPE BAPI1003_ALLOC_VALUES_NUM OCCURS 0,
         ZCURR TYPE BAPI1003_ALLOC_VALUES_CURR OCCURS 0,
         I_CHAR TYPE BAPI1003_ALLOC_VALUES_CHAR OCCURS 0 WITH HEADER LINE,
         CUOBJ TYPE MCH1-CUOBJ_BM.
*         DSTATUS TYPE C.

  DATA : ZGHEAD TYPE BAPI2017_GM_HEAD_01 OCCURS 0 WITH HEADER LINE,
         ZGITEM TYPE BAPI2017_GM_ITEM_CREATE OCCURS 0 WITH HEADER LINE,
         ZMATDOC TYPE BAPI2017_GM_HEAD_RET-MAT_DOC,
         ZMATYEAR TYPE BAPI2017_GM_HEAD_RET-DOC_YEAR,
         ZGRRETURN TYPE BAPIRET2 OCCURS 0 WITH HEADER LINE,
         ZERROR TYPE BAPIRET2 OCCURS 0 WITH HEADER LINE.

  DATA: ZTIMETICKET TYPE BAPI_PI_TIMETICKET1 OCCURS 0 WITH HEADER LINE,
        ZCONFRETURN TYPE BAPI_CORU_RETURN OCCURS 0 WITH HEADER LINE.

  DATA : WA_GOODSMVT TYPE ZEXECJR,
         WA_CONFIRMATION TYPE ZCONF,
         WA_CHAR TYPE ZCHAR00.

  CLEAR : WA_GOODSMVT,WA_CHAR,WA_CONFIRMATION,ZMATDOC,ZTIMETICKET,ZCONFRETURN,ZBRETURN,ZGITEM,ZGRRETURN.
  CLEAR : DCLASS,DKLART,DOBTAB,DOBJKY,DSTAT,FBATCH,ZNUM,ZCURR,ZBAPICHAT,CUOBJ.
  REFRESH : ZGHEAD,ZGITEM,ZCURR,ZNUM,I_CHAR,ZBAPICHAT,ZBRETURN,ZGRRETURN,ZCONFRETURN,ZTIMETICKET.

  LOOP AT GOODSMVT INTO WA_GOODSMVT WHERE MOVE_TYPE = '101'.

    "CREATE BATCH
    READ TABLE GOODSMVT INDEX 1.

    CALL FUNCTION 'BAPI_BATCH_CREATE'
      EXPORTING
        MATERIAL             = WA_GOODSMVT-MATERIAL
        PLANT                = WA_GOODSMVT-PLANT
        BATCHSTORAGELOCATION = WA_GOODSMVT-STGE_LOC
        BATCH                = WA_GOODSMVT-BATCH
      IMPORTING
        BATCH                = FBATCH
      TABLES
        RETURN               = ZBRETURN.
    PERFORM BAPI_COMMIT.

    LOOP AT ZBRETURN.
      MOVE-CORRESPONDING ZBRETURN TO ZERROR.
      APPEND ZERROR.
    ENDLOOP.

    CALL FUNCTION 'QMSP_MATERIAL_BATCH_CLASS_READ'
      EXPORTING
        I_MATNR      = WA_GOODSMVT-MATERIAL
        I_CHARG      = FBATCH
        I_WERKS      = WA_GOODSMVT-PLANT
        I_MARA_LEVEL = 'X'
      IMPORTING
        E_CLASS      = DCLASS
        E_KLART      = DKLART
        E_OBTAB      = DOBTAB
        E_OBJEC      = DOBJKY.

    READ TABLE IT_CHAR INTO WA_CHAR WITH KEY CHARG = WA_GOODSMVT-BATCH.
*  READ TABLE IT_CHAR INDEX 1.

    SELECT SINGLE CUOBJ_BM INTO CUOBJ FROM MCH1 WHERE CHARG = WA_GOODSMVT-BATCH AND MATNR = WA_GOODSMVT-MATERIAL.

    I_CHAR-CHARACT = 'ZZCODE'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR01.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZTYPE'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR02.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZTHICKNESS'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR03.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZLENGTH'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR04.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZWIDTH'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR05.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZTREATMENT'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR07.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZNOMORROLL'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR09.
    APPEND I_CHAR. CLEAR I_CHAR.

    I_CHAR-CHARACT = 'ZZGRADEJR'.
    I_CHAR-VALUE_CHAR = WA_CHAR-CHAR10.
    APPEND I_CHAR. CLEAR I_CHAR.

    CALL FUNCTION 'VB_INIT'
      EXPORTING
        INIT_RESET
        ='X'.

    CALL FUNCTION 'BAPI_OBJCL_CHANGE'
      EXPORTING
        OBJECTKEY          = DOBJKY
        OBJECTTABLE        = DOBTAB
        CLASSNUM           = DCLASS
        CLASSTYPE          = DKLART
      IMPORTING
        CLASSIF_STATUS     = DSTAT
      TABLES
        ALLOCVALUESNUMNEW  = ZNUM
        ALLOCVALUESCHARNEW = I_CHAR
        ALLOCVALUESCURRNEW = ZCURR
        RETURN             = ZBRETURN.
    PERFORM BAPI_COMMIT.
    "END CREATE BATCH

    LOOP AT ZBRETURN.
      MOVE-CORRESPONDING ZBRETURN TO ZERROR.
      APPEND ZERROR.
    ENDLOOP.

    "Goods Receipt

*  READ TABLE GOODSMVT WITH KEY MOVE_TYPE = '101'.
    ZGITEM-MATERIAL = WA_GOODSMVT-MATERIAL.
    ZGITEM-PLANT = WA_GOODSMVT-PLANT.
    ZGITEM-STGE_LOC = WA_GOODSMVT-STGE_LOC.
    ZGITEM-BATCH = WA_GOODSMVT-BATCH.
    ZGITEM-MOVE_TYPE = WA_GOODSMVT-MOVE_TYPE.
    ZGITEM-ENTRY_QNT = WA_GOODSMVT-ENTRY_QNT..
    ZGITEM-ENTRY_UOM = WA_GOODSMVT-ENTRY_UOM."WA_GOODSMVT-ENTRY_UOM'.
    ZGITEM-ORDERID = WA_GOODSMVT-ORDERID.
    ZGITEM-ITEM_TEXT = WA_GOODSMVT-TEXT.
    ZGITEM-MOVE_STLOC = WA_GOODSMVT-STGE_LOC.
    ZGITEM-MVT_IND = 'F'.
    ZGITEM-QUANTITY = 1.
    ZGITEM-BASE_UOM = 'ROL'.
    APPEND ZGITEM.

    READ TABLE CONFIRMATION INTO WA_CONFIRMATION WITH KEY ORDERID = GOODSMVT-ORDERID.
    ZGHEAD-PSTNG_DATE = WA_CONFIRMATION-POSTG_DATE."'20160714'.
    ZGHEAD-DOC_DATE = WA_CONFIRMATION-POSTG_DATE."'20160714'.
    APPEND ZGHEAD.
    CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
      EXPORTING
        GOODSMVT_HEADER  = ZGHEAD
        GOODSMVT_CODE    = '02'
      IMPORTING
        MATERIALDOCUMENT = ZMATDOC
        MATDOCUMENTYEAR  = ZMATYEAR
      TABLES
        GOODSMVT_ITEM    = ZGITEM
        RETURN           = ZGRRETURN.
    PERFORM BAPI_COMMIT.
    "End Goods Receipt
    LOOP AT ZGRRETURN.
      MOVE-CORRESPONDING ZGRRETURN TO ZERROR.
      APPEND ZERROR.
    ENDLOOP.
*    "start confirmation
*
**READ TABLE CONFIRMATION WITH KEY ORDERID = ''.
**    READ TABLE CONFIRMATION INTO WA_CONFIRMATION INDEX 1.

    ZTIMETICKET-ORDERID = WA_CONFIRMATION-ORDERID.
    ZTIMETICKET-PHASE = WA_CONFIRMATION-PHRASE.
    ZTIMETICKET-POSTG_DATE = WA_CONFIRMATION-POSTG_DATE."SY-DATUM."'20160714'."WA_CONFIRMATION-POSTG_DATE.
    ZTIMETICKET-PLANT = WA_CONFIRMATION-PLANT.
    ZTIMETICKET-RESOURCE = WA_CONFIRMATION-RESOURCES.
    ZTIMETICKET-FIN_CONF = WA_CONFIRMATION-FIN_CONF.
    ZTIMETICKET-CONF_QUAN_UNIT = WA_CONFIRMATION-CONF_QUAN_UNIT.
    ZTIMETICKET-YIELD = WA_CONFIRMATION-YIELD.
    ZTIMETICKET-CONF_ACTI_UNIT1  = WA_CONFIRMATION-CONF_ACTI_UNIT1.
    ZTIMETICKET-CONF_ACTIVITY1 = WA_CONFIRMATION-CONF_ACTIVITY1.
    ZTIMETICKET-CONF_ACTI_UNIT2 = WA_CONFIRMATION-CONF_ACTI_UNIT2.
    ZTIMETICKET-CONF_ACTIVITY2 = WA_CONFIRMATION-CONF_ACTIVITY2.
    ZTIMETICKET-CONF_ACTI_UNIT3 = WA_CONFIRMATION-CONF_ACTI_UNIT3.
    ZTIMETICKET-CONF_ACTIVITY3 = WA_CONFIRMATION-CONF_ACTIVITY3.
    ZTIMETICKET-CONF_ACTI_UNIT4 = WA_CONFIRMATION-CONF_ACTI_UNIT4.
    ZTIMETICKET-CONF_ACTIVITY4 = WA_CONFIRMATION-CONF_ACTIVITY4.
    ZTIMETICKET-CONF_ACTI_UNIT5 = WA_CONFIRMATION-CONF_ACTI_UNIT5.
    ZTIMETICKET-CONF_ACTIVITY5 = WA_CONFIRMATION-CONF_ACTIVITY5.
    ZTIMETICKET-CONF_ACTI_UNIT6 = WA_CONFIRMATION-CONF_ACTI_UNIT6.
    ZTIMETICKET-CONF_ACTIVITY6 = WA_CONFIRMATION-CONF_ACTIVITY6.
    ZTIMETICKET-EXEC_START_DATE  = WA_CONFIRMATION-EXEC_START_DATE."SY-DATUM."'20160714'."WA_CONFIRMATION-EXEC_START_DATE .
    ZTIMETICKET-EXEC_START_TIME = WA_CONFIRMATION-EXEC_START_TIME."SY-UZEIT."'000000'."WA_CONFIRMATION-EXEC_START_TIME.
    ZTIMETICKET-EXEC_FIN_DATE = WA_CONFIRMATION-EXEC_FIN_DATE."SY-DATUM."'20160714'."WA_CONFIRMATION-EXEC_FIN_DATE.
    ZTIMETICKET-EXEC_FIN_TIME  = WA_CONFIRMATION-EXEC_FIN_TIME."SY-UZEIT."'000000'."WA_CONFIRMATION-EXEC_FIN_TIME.
    ZTIMETICKET-PERS_NO = WA_CONFIRMATION-PERS_NO.
    ZTIMETICKET-CONF_TEXT = ZMATDOC.
    APPEND ZTIMETICKET.


*ZTIMETICKET-ORDERID = '100000053080'.
*ZTIMETICKET-PHASE = '0020'.
*ZTIMETICKET-POSTG_DATE = '20160714'.
*ZTIMETICKET-PLANT = '2000'.
*ZTIMETICKET-RESOURCE = 'JROPP04'.
*ZTIMETICKET-FIN_CONF = ''.
*ZTIMETICKET-CONF_QUAN_UNIT = 'KG'.
*ZTIMETICKET-YIELD = '0.081'.
*ZTIMETICKET-CONF_ACTI_UNIT1  = 'MIN'.
*ZTIMETICKET-CONF_ACTIVITY1   = '120'.
*ZTIMETICKET-CONF_ACTI_UNIT2  = 'MIN'.
*ZTIMETICKET-CONF_ACTIVITY2   = '120'.
*ZTIMETICKET-CONF_ACTI_UNIT3  = 'MIN'.
*ZTIMETICKET-CONF_ACTIVITY3   = '120'.
*ZTIMETICKET-CONF_ACTI_UNIT4  = 'MIN'.
*ZTIMETICKET-CONF_ACTIVITY4   = '120'.
*ZTIMETICKET-CONF_ACTI_UNIT5  = 'MIN'.
*ZTIMETICKET-CONF_ACTIVITY5   = '120'.
*ZTIMETICKET-CONF_ACTI_UNIT6  = 'MIN'.
*ZTIMETICKET-CONF_ACTIVITY6   = '120'.
*ZTIMETICKET-EXEC_START_DATE  = '20160714'.
*ZTIMETICKET-EXEC_START_TIME  = '060000'.
*ZTIMETICKET-EXEC_FIN_DATE    = '20160714'.
*ZTIMETICKET-EXEC_FIN_TIME    = '080000'.
*ZTIMETICKET-PERS_NO          = '26'.
*ZTIMETICKET-CONF_TEXT        = '5009'.
*APPEND ZTIMETICKET.


    CALL FUNCTION 'BAPI_PROCORDCONF_CREATE_TT'
      TABLES
        TIMETICKETS   = ZTIMETICKET
        DETAIL_RETURN = ZCONFRETURN.

    PERFORM BAPI_COMMIT.

    LOOP AT ZCONFRETURN.
      MOVE-CORRESPONDING ZCONFRETURN TO ZERROR.
      APPEND ZERROR.
    ENDLOOP.

    DATA : IT_MSEG TYPE MSEG OCCURS 0 WITH HEADER LINE,
           IT_MKPF TYPE MKPF OCCURS 0 WITH HEADER LINE,
           IT_AFRU TYPE AFRU OCCURS 0 WITH HEADER LINE.

    IF ZMATDOC IS NOT INITIAL.
      SELECT * FROM MKPF APPENDING TABLE IT_MKPF WHERE MBLNR = ZMATDOC.
      SELECT * FROM MSEG APPENDING TABLE IT_MSEG WHERE MBLNR = ZMATDOC.
    ENDIF.

    IF ZCONFRETURN-CONF_NO IS NOT INITIAL.
      SELECT * FROM AFRU APPENDING TABLE IT_AFRU WHERE RUECK = ZCONFRETURN-CONF_NO AND RMZHL = ZCONFRETURN-CONF_CNT.
    ENDIF.

    CLEAR : WA_GOODSMVT,WA_CHAR,WA_CONFIRMATION,ZMATDOC,ZTIMETICKET,ZCONFRETURN,ZBRETURN,ZGITEM,ZGRRETURN.
    CLEAR : DCLASS,DKLART,DOBTAB,DOBJKY,DSTAT,FBATCH,ZNUM,ZCURR,ZBAPICHAT,CUOBJ.
    REFRESH : ZGHEAD,ZGITEM,ZCURR,ZNUM,I_CHAR,ZBAPICHAT,ZBRETURN,ZGRRETURN,ZCONFRETURN,ZTIMETICKET.

  ENDLOOP.

  IT_MKPF-BUDAT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING BUDAT WHERE BUDAT = 00000000.
  IT_MKPF-BLDAT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING BLDAT WHERE BLDAT = 00000000.
  IT_MKPF-CPUDT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING CPUDT WHERE CPUDT = 00000000.
  IT_MKPF-AEDAT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING AEDAT WHERE AEDAT = 00000000.

  IT_MSEG-VFDAT = '19000101'.
  MODIFY IT_MSEG TRANSPORTING VFDAT WHERE VFDAT = 00000000.
  IT_MSEG-DABRBZ = '19000101'.
  MODIFY IT_MSEG TRANSPORTING DABRBZ WHERE DABRBZ = 00000000.
  IT_MSEG-DABRZ = '19000101'.
  MODIFY IT_MSEG TRANSPORTING DABRZ WHERE DABRZ = 00000000.
  IT_MSEG-HSDAT = '19000101'.
  MODIFY IT_MSEG TRANSPORTING HSDAT WHERE HSDAT = 00000000.
  IT_MSEG-BUDAT_MKPF = '19000101'.
  MODIFY IT_MSEG TRANSPORTING BUDAT_MKPF WHERE BUDAT_MKPF = 00000000.
  IT_MSEG-CPUDT_MKPF = '19000101'.
  MODIFY IT_MSEG TRANSPORTING CPUDT_MKPF WHERE CPUDT_MKPF = 00000000.
  IT_MSEG-/BEV2/ED_AEDAT = '19000101'.
  MODIFY IT_MSEG TRANSPORTING /BEV2/ED_AEDAT WHERE /BEV2/ED_AEDAT = 00000000.


  IT_AFRU-ERSDA = '19000101'.	MODIFY IT_AFRU TRANSPORTING ERSDA WHERE ERSDA = 00000000.
  IT_AFRU-LAEDA = '19000101'.	MODIFY IT_AFRU TRANSPORTING LAEDA WHERE LAEDA = 00000000.
  IT_AFRU-BUDAT = '19000101'.	MODIFY IT_AFRU TRANSPORTING BUDAT WHERE BUDAT = 00000000.
  IT_AFRU-ISDD = '19000101'.  MODIFY IT_AFRU TRANSPORTING ISDD WHERE ISDD = 00000000.
  IT_AFRU-IERD = '19000101'.  MODIFY IT_AFRU TRANSPORTING IERD WHERE IERD = 00000000.
  IT_AFRU-ISBD = '19000101'.  MODIFY IT_AFRU TRANSPORTING ISBD WHERE ISBD = 00000000.
  IT_AFRU-IEBD = '19000101'.  MODIFY IT_AFRU TRANSPORTING IEBD WHERE IEBD = 00000000.
  IT_AFRU-ISAD = '19000101'.  MODIFY IT_AFRU TRANSPORTING ISAD WHERE ISAD = 00000000.
  IT_AFRU-IEDD = '19000101'.  MODIFY IT_AFRU TRANSPORTING IEDD WHERE IEDD = 00000000.
  IT_AFRU-PEDD = '19000101'.  MODIFY IT_AFRU TRANSPORTING PEDD WHERE PEDD = 00000000.
  IT_AFRU-EXERD = '19000101'.	MODIFY IT_AFRU TRANSPORTING EXERD WHERE EXERD = 00000000.


  MSEG[] = IT_MSEG[].
  MKPF[] = IT_MKPF[].
  AFRU[] = IT_AFRU[].
  RETURN[] = ZERROR[].

ENDFUNCTION.

