*       text
*----------------------------------------------------------------------*
FORM GET_TEMPLATE_RECIPE.
  DATA: ARBPL_TMP TYPE CRHD-ARBPL.

  SELECT  M~PLNNR M~MATNR M~WERKS M~PLNAL O~VORNR O~VORNR O~PHFLG O~PHSEQ O~STEUS O~BMSCH
          O~MEINH O~VGW01 O~VGE01 O~VGW02 O~VGE02 O~VGW03 O~VGE03 O~VGW04 O~VGE04 O~VGW05 O~VGE05 O~VGW06 O~VGE06
          C~KTEXT O~EKORG O~PLIFZ O~MATKL O~EKGRP O~LIFNR O~PEINH O~PREIS O~SAKTO O~WAERS O~ARBID O~PVZKN O~PLNKN
  INTO CORRESPONDING FIELDS OF TABLE IT_DATA_RECIPE
  FROM MAPL AS M INNER JOIN PLKO AS C ON C~PLNNR = M~PLNNR AND C~PLNAL = M~PLNAL
            LEFT OUTER JOIN PLAS AS A ON A~PLNNR = M~PLNNR AND A~PLNAL = M~PLNAL
            JOIN PLPO AS O ON O~PLNNR = A~PLNNR AND O~PLNKN = A~PLNKN
*            INNER JOIN PLKO AS C ON C~PLNNR = M~PLNNR AND C~PLNAL = M~PLNAL
    WHERE M~MATNR IN S_MATNR AND M~WERKS IN S_WERKS AND M~PLNTY = '2'.

  UNASSIGN <FS_DATA_RECIPE>.
  LOOP AT IT_DATA_RECIPE  ASSIGNING <FS_DATA_RECIPE> WHERE PVZKN IS NOT INITIAL.
    CLEAR WA_DATA_RECIPE.
    READ TABLE IT_DATA_RECIPE WITH KEY  PLNNR = <FS_DATA_RECIPE>-PLNNR
                                        PLNKN = <FS_DATA_RECIPE>-PVZKN
    INTO WA_DATA_RECIPE.

    <FS_DATA_RECIPE>-VORNR2 = WA_DATA_RECIPE-VORNR.
  ENDLOOP.

  LOOP AT IT_DATA_RECIPE WHERE ARBID IS NOT INITIAL AND ARBPL IS INITIAL.
    SELECT SINGLE ARBPL INTO ARBPL_TMP
              FROM CRHD WHERE OBJID = IT_DATA_RECIPE-ARBID.

    LOOP AT IT_DATA_RECIPE WHERE MATNR EQ IT_DATA_RECIPE-MATNR AND PLNAL EQ IT_DATA_RECIPE-PLNAL.
      IT_DATA_RECIPE-ARBPL = ARBPL_TMP.
      MODIFY IT_DATA_RECIPE TRANSPORTING ARBPL. "WHERE ARBID = IT_DATA_RECIPE-ARBID.
    ENDLOOP.


*    SELECT SINGLE ARBPL INTO IT_DATA_RECIPE-ARBPL
*      FROM CRHD WHERE OBJID = IT_DATA_RECIPE-ARBID.
*    MODIFY IT_DATA_RECIPE TRANSPORTING ARBPL WHERE ARBID = IT_DATA_RECIPE-ARBID.
  ENDLOOP.

  UNASSIGN <FS_DATA_RECIPE>.
  LOOP AT IT_DATA_RECIPE ASSIGNING <FS_DATA_RECIPE>.
    IF <FS_DATA_RECIPE>-VGW01 > 0.
      <FS_DATA_RECIPE>-CVGW01 = <FS_DATA_RECIPE>-VGW01.
    ENDIF.
    IF <FS_DATA_RECIPE>-VGW02 > 0.
      <FS_DATA_RECIPE>-CVGW02 = <FS_DATA_RECIPE>-VGW02.
    ENDIF.
    IF <FS_DATA_RECIPE>-VGW03 > 0.
      <FS_DATA_RECIPE>-CVGW03 = <FS_DATA_RECIPE>-VGW03.
    ENDIF.
    IF <FS_DATA_RECIPE>-VGW04 > 0.
      <FS_DATA_RECIPE>-CVGW04 = <FS_DATA_RECIPE>-VGW04.
    ENDIF.
    IF <FS_DATA_RECIPE>-VGW05 > 0.
      <FS_DATA_RECIPE>-CVGW05 = <FS_DATA_RECIPE>-VGW05.
    ENDIF.
    IF <FS_DATA_RECIPE>-VGW06 > 0.
      <FS_DATA_RECIPE>-CVGW06 = <FS_DATA_RECIPE>-VGW06.
    ENDIF.

    IF <FS_DATA_RECIPE>-PLIFZ > 0.
      <FS_DATA_RECIPE>-CPLIFZ = <FS_DATA_RECIPE>-PLIFZ.
    ENDIF.
    IF <FS_DATA_RECIPE>-PEINH > 0.
      <FS_DATA_RECIPE>-CPEINH = <FS_DATA_RECIPE>-PEINH.
    ENDIF.
    IF <FS_DATA_RECIPE>-PREIS > 0.
      <FS_DATA_RECIPE>-CPREIS = <FS_DATA_RECIPE>-PREIS.
    ENDIF.

  ENDLOOP.

  SELECT  M~PLNNR M~MATNR M~WERKS M~PLNAL C~KTEXT
   APPENDING CORRESPONDING FIELDS OF TABLE IT_DATA_RECIPE
   FROM MAPL AS M INNER JOIN PLKO AS C ON C~PLNNR = M~PLNNR AND C~PLNAL = M~PLNAL
     WHERE M~MATNR IN S_MATNR AND M~WERKS IN S_WERKS AND M~PLNTY = '2' AND ( M~PLNAL = '91' OR M~PLNAL = '92' ).

  SORT IT_DATA_RECIPE BY MATNR WERKS PLNAL VORNR VORNR2.
ENDFORM.                    "GET_TEMPLATE_RECIPE
