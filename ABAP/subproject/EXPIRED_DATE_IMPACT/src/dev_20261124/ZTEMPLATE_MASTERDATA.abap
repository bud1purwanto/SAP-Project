*&---------------------------------------------------------------------*
*&      Form  GET_TEMPLATE_BOM
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_TEMPLATE_BOM.

  SELECT MAST~MATNR MAST~WERKS MAST~STLAN MAST~STLAL STKO~DATUV STKO~STKTX
         STKO~BMENG STKO~BMEIN
  INTO CORRESPONDING FIELDS OF TABLE IT_DATA_BOM2
  FROM ( MAST INNER JOIN STKO ON MAST~STLNR EQ STKO~STLNR AND MAST~STLAL EQ STKO~STLAL
            LEFT OUTER JOIN STAS ON STKO~STLNR EQ STAS~STLNR AND STKO~STLAL EQ STAS~STLAL )
            WHERE MAST~MATNR IN S_MATNR
           AND MAST~WERKS IN S_WERKS.

  SELECT MAST~STLNR MAST~MATNR MAST~WERKS MAST~STLAN MAST~STLAL STKO~BMENG STKO~BMEIN STKO~STLAL STKO~STLNR STAS~STLAL STAS~STLNR
         STPO~IDNRK STPO~MENGE STPO~MEINS STPO~STLKN STPO~STLNR STPO~STLTY STKO~DATUV STKO~STKTX STPO~LGORT STPO~REKRS
 INTO CORRESPONDING FIELDS OF TABLE IT_DATA_BOM
 FROM MAST INNER JOIN STKO ON MAST~STLNR EQ STKO~STLNR AND MAST~STLAL EQ STKO~STLAL
           LEFT OUTER JOIN STAS ON STKO~STLNR EQ STAS~STLNR AND STKO~STLAL EQ STAS~STLAL
           INNER JOIN STPO ON STAS~STLNR EQ STPO~STLNR AND STAS~STLKN EQ STPO~STLKN AND STPO~STLTY = STAS~STLTY
    FOR ALL ENTRIES IN IT_DATA_BOM2
           WHERE MAST~MATNR EQ IT_DATA_BOM2-MATNR
           AND MAST~WERKS EQ IT_DATA_BOM2-WERKS.

  LOOP AT IT_DATA_BOM.
    DELETE IT_DATA_BOM2 WHERE MATNR EQ IT_DATA_BOM-MATNR AND WERKS EQ IT_DATA_BOM-WERKS AND STLAL EQ IT_DATA_BOM-STLAL AND STLAN EQ IT_DATA_BOM-STLAN.
  ENDLOOP.

  APPEND LINES OF IT_DATA_BOM2 TO IT_DATA_BOM.

  SORT IT_DATA_BOM BY MATNR WERKS STLAN STLAL.


*  SELECT MAST~STLNR MAST~MATNR MAST~WERKS MAST~STLAN MAST~STLAL STKO~BMENG STKO~BMEIN STKO~STLAL STKO~STLNR STAS~STLAL STAS~STLNR
*             STPO~IDNRK STPO~MENGE STPO~MEINS STPO~STLKN STPO~STLNR STPO~STLTY STKO~DATUV STKO~STKTX
*    INTO CORRESPONDING FIELDS OF TABLE IT_DATA_BOM
*      FROM ( MAST
*             INNER JOIN STKO
*             ON  STKO~STLAL = MAST~STLAL
*             AND STKO~STLNR = MAST~STLNR
*             INNER JOIN STAS
*             ON  STAS~STLAL = STKO~STLAL
*             AND STAS~STLNR = STKO~STLNR
*             INNER JOIN STPO
*             ON  STPO~STLKN = STAS~STLKN
*             AND STPO~STLNR = STAS~STLNR
*             AND STPO~STLTY = STAS~STLTY )
*           WHERE MAST~MATNR IN S_MATNR
*             AND MAST~WERKS IN S_WERKS .
ENDFORM.                    "GET_TEMPLATE_BOM


