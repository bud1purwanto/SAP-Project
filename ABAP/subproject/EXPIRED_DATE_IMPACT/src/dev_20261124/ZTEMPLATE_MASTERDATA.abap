FORM GET_TEMPLATE_MIC.
  CLEAR: IT_MIC. REFRESH: IT_MIC.
  SELECT QPMK~ZAEHLER QPMK~MKMNR QPMK~GUELTIGAB QPMK~STEUERKZ QPMK~LOEKZ QPMK~KONSISTENT QPMT~KURZTEXT
         QPMK~SORTFELD QPMK~MERKGEW QPMK~MASSEINHSW QPMK~SOLLWERT QPMK~TOLERANZUN QPMK~TOLERANZOB
         QPMK~STELLEN QPMZ~AUSWMENGE1 QPMZ~AUSWMGWRK1
    INTO CORRESPONDING FIELDS OF TABLE IT_MIC
    FROM QPMK LEFT JOIN QPMZ ON QPMK~ZAEHLER = QPMZ~ZAEHLER
     AND QPMK~MKMNR = QPMZ~MKMNR
     AND QPMK~VERSION = QPMZ~VERSION
    JOIN QPMT ON QPMK~ZAEHLER = QPMT~ZAEHLER
     AND QPMK~MKMNR = QPMT~MKMNR
     AND QPMK~VERSION = QPMT~VERSION
    WHERE QPMK~ZAEHLER IN S_WERKS
      AND QPMK~MKMNR IN S_MKMNR
      AND QPMT~SPRACHE = 'E'.

  SELECT * FROM T006A INTO CORRESPONDING FIELDS OF TABLE IT_MOM
   FOR ALL ENTRIES IN IT_MIC
   WHERE T006A~MSEHI = IT_MIC-MASSEINHSW
     AND T006A~SPRAS = 'E'.

  UNASSIGN <FS_IT_MIC>.
  LOOP AT IT_MIC ASSIGNING <FS_IT_MIC>.
    PERFORM CONV_FLOAT_TO_NUM USING <FS_IT_MIC>-SOLLWERT CHANGING <FS_IT_MIC>-SOLLWERTV.
    PERFORM CONV_FLOAT_TO_NUM USING <FS_IT_MIC>-TOLERANZUN CHANGING <FS_IT_MIC>-TOLERANZUNV.
    PERFORM CONV_FLOAT_TO_NUM USING <FS_IT_MIC>-TOLERANZOB CHANGING <FS_IT_MIC>-TOLERANZOBV.

    READ TABLE IT_MOM WITH KEY MSEHI = <FS_IT_MIC>-MASSEINHSW.
    IF SY-SUBRC = 0.
      <FS_IT_MIC>-MASSEINHSW2 = IT_MOM-MSEH6.
    ENDIF.

    "Quant or Qual
    IF <FS_IT_MIC>-STEUERKZ(1) = 'X'.
      <FS_IT_MIC>-STEU1A = 'X'.
    ELSE.
      <FS_IT_MIC>-STEU1B = 'X'.
    ENDIF.

    "Lower Spec
    IF <FS_IT_MIC>-STEUERKZ+4(1) = 'X'.
      <FS_IT_MIC>-STEU5 = 'X'.
    ENDIF.

    "Upper Spec
    IF <FS_IT_MIC>-STEUERKZ+3(1) = 'X'.
      <FS_IT_MIC>-STEU4 = 'X'.
    ENDIF.

    "Target Value
    IF <FS_IT_MIC>-STEUERKZ+5(1) = 'X'.
      <FS_IT_MIC>-STEU6 = 'X'.
    ENDIF.

    "Ref to Char Attribute
    IF <FS_IT_MIC>-STEUERKZ+2(1) = 'X'.
      <FS_IT_MIC>-STEU3 = 'X'.
    ENDIF.

    "Sampling proc.
    IF <FS_IT_MIC>-STEUERKZ+15(1) = 'X'.
      <FS_IT_MIC>-STEU16 = 'X'.
    ENDIF.

    "SPC charac.
    IF <FS_IT_MIC>-STEUERKZ+24(1) = 'X'.
      <FS_IT_MIC>-STEU25 = 'X'.
    ENDIF.

    "Additive sample
    IF <FS_IT_MIC>-STEUERKZ+12(1) = 'X'.
      <FS_IT_MIC>-STEU13 = 'X'.
    ENDIF.

    "Destructive inspection
    IF <FS_IT_MIC>-STEUERKZ+13(1) = 'X'.
      <FS_IT_MIC>-STEU14 = 'X'.
    ENDIF.

    "Recording type
    IF <FS_IT_MIC>-STEUERKZ+8(1) = ' '.
      <FS_IT_MIC>-STEU9A = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+8(1) = '+'.
      <FS_IT_MIC>-STEU9B = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+8(1) = '-'.
      <FS_IT_MIC>-STEU9C = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+8(1) = '*'.
      <FS_IT_MIC>-STEU9D = 'X'.
    ENDIF.

    "Defects recording
    IF <FS_IT_MIC>-STEUERKZ+22(1) = 'X'.
      <FS_IT_MIC>-STEU23 = 'X'.
    ENDIF.

    "Charac. req.
    IF <FS_IT_MIC>-STEUERKZ+10(1) = 'X'.
      <FS_IT_MIC>-STEU11A = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+10(1) = ' '.
      <FS_IT_MIC>-STEU11B = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+10(1) = '+'.
      <FS_IT_MIC>-STEU11C = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+10(1) = '-'.
      <FS_IT_MIC>-STEU11D = 'X'.
    ENDIF.

    "Scope
    IF <FS_IT_MIC>-STEUERKZ+6(1) = ' '.
      <FS_IT_MIC>-STEU7A = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+6(1) = '='.
      <FS_IT_MIC>-STEU7B = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+6(1) = '<'.
      <FS_IT_MIC>-STEU7C = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+6(1) = '>'.
      <FS_IT_MIC>-STEU7D = 'X'.
    ENDIF.

    "Documentation
    IF <FS_IT_MIC>-STEUERKZ+9(1) = ' '.
      <FS_IT_MIC>-STEU10A = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+9(1) = '.'.
      <FS_IT_MIC>-STEU10B = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+9(1) = '+'.
      <FS_IT_MIC>-STEU10C = 'X'.
    ENDIF.

    "Long term inspection
    IF <FS_IT_MIC>-STEUERKZ+7(1) = 'X'.
      <FS_IT_MIC>-STEU8 = 'X'.
    ENDIF.

    "Scrap Share/Q score
    IF <FS_IT_MIC>-STEUERKZ+16(1) = 'X'.
      <FS_IT_MIC>-STEU17 = 'X'.
    ENDIF.

    "RR Change Docs
    IF <FS_IT_MIC>-STEUERKZ+23(1) = 'X'.
      <FS_IT_MIC>-STEU24 = 'X'.
    ENDIF.

    "Test Equipment
    IF <FS_IT_MIC>-STEUERKZ+21(1) = 'X'.
      <FS_IT_MIC>-STEU22 = 'X'.
    ENDIF.

    "Record measured Values
    IF <FS_IT_MIC>-STEUERKZ+1(1) = 'X'.
      <FS_IT_MIC>-STEU2 = 'X'.
    ENDIF.

    "Print
    IF <FS_IT_MIC>-STEUERKZ+25(1) = ' '.
      <FS_IT_MIC>-STEU26A = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+25(1) = 'X'.
      <FS_IT_MIC>-STEU26B = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+25(1) = '*'.
      <FS_IT_MIC>-STEU26C = 'X'.
    ENDIF.

    "Formula
    IF <FS_IT_MIC>-STEUERKZ+14(1) = 'X'.
      <FS_IT_MIC>-STEU15A = 'X'.
    ELSEIF <FS_IT_MIC>-STEUERKZ+14(1) = ' '.
      <FS_IT_MIC>-STEU15B = 'X'.
    ENDIF.

  ENDLOOP.

  IF IT_MIC[] IS INITIAL.
    MESSAGE 'Data not Found!' TYPE 'I'.
  ENDIF.
ENDFORM.                    "GET_TEMPLATE_MIC

