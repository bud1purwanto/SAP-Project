FORM GET_TEMPLATE_MATERIAL.
  DATA: IT_TVKWZ LIKE TVKWZ OCCURS 0  WITH HEADER LINE.

  SELECT  MARC~MATNR MARC~WERKS MARC~MTVFP MARC~XCHPF MARC~LADGR MARC~PRCTR MARC~EKGRP MARC~KAUTB MARC~WEBAZ MARC~INSMK MARC~USEQU MARC~KORDB MARC~STAWN MARC~DISGR MARC~DISMM
           MARC~MINBE MARC~DISPO MARC~DISLS MARC~BSTMI MARC~BSTMA MARC~MABST MARC~BESKZ MARC~SOBSL MARC~PLIFZ MARC~DZEIT MARC~FHORI MARC~EISBE MARC~BSTRF MARC~LGPRO MARC~LGFSB MARC~PERKZ
           MARC~STRGR MARC~VRMOD MARC~VINT1 MARC~VINT2 MARC~ALTSL MARC~SBDKZ MARC~KAUSF MARC~AUSME MARC~FRTME MARC~FEVOR MARC~SFCPF MARC~UNETO MARC~UEETO MARC~SERNP MARC~NCOST
           MARC~AWSLS MARC~LOSGR MARC~STLAL MARC~STLAN MARC~PLNNR MARC~APLAL MARC~PLNTY MARC~SOBSK "TVKWZ~VKORG
   INTO CORRESPONDING FIELDS OF TABLE IT_DATA_MATERIAL
     FROM MARC "JOIN TVKWZ ON MARC~WERKS EQ TVKWZ~WERKS
     WHERE MARC~MATNR IN S_MATNR AND MARC~WERKS IN S_WERKS. "AND TVKWZ~VTWEG EQ '00'.

  IF SY-SUBRC = 0.
    SELECT * INTO TABLE IT_TVKWZ FROM TVKWZ.
  ENDIF.

  UNASSIGN <FS_DATA_MATERIAL>.
  LOOP AT IT_DATA_MATERIAL ASSIGNING <FS_DATA_MATERIAL>.
    READ TABLE IT_TVKWZ WITH KEY WERKS = <FS_DATA_MATERIAL>-WERKS.
    IF SY-SUBRC = 0.
      <FS_DATA_MATERIAL>-VKORG = IT_TVKWZ-VKORG.
    ENDIF.

    IF <FS_DATA_MATERIAL>-WERKS = '2000'.
      LGNUM = 'K01'.
    ELSEIF <FS_DATA_MATERIAL>-WERKS = '1000'.
      LGNUM = 'W01'.
    ELSEIF <FS_DATA_MATERIAL>-WERKS = 'TTA2'.
      LGNUM = 'AK1'.
    ELSEIF <FS_DATA_MATERIAL>-WERKS = 'TTE2'.
      LGNUM = 'EK1'.
    ENDIF.

    SELECT SINGLE LGNUM LVSME LTKZA LTKZE LGBKZ
     FROM MLGN
     INTO (<FS_DATA_MATERIAL>-LGNUM, <FS_DATA_MATERIAL>-LVSME, <FS_DATA_MATERIAL>-LTKZA, <FS_DATA_MATERIAL>-LTKZE, <FS_DATA_MATERIAL>-LGBKZ)
     WHERE MATNR = <FS_DATA_MATERIAL>-MATNR AND LGNUM = LGNUM.

    SELECT SINGLE MBRSH MTART SPRAS MAKTX MEINS MATKL BISMT SPART BRGEW GEWEI NTGEW MAGRV VHART TRAGR
                  BSTME EKWSL RAUBE MHDRZ MHDHB MEINS MTPOS_MARA
    INTO (<FS_DATA_MATERIAL>-MBRSH, <FS_DATA_MATERIAL>-MTART, <FS_DATA_MATERIAL>-SPRAS, <FS_DATA_MATERIAL>-MAKTX, <FS_DATA_MATERIAL>-MEINS,
          <FS_DATA_MATERIAL>-MATKL, <FS_DATA_MATERIAL>-BISMT, <FS_DATA_MATERIAL>-SPART, <FS_DATA_MATERIAL>-BRGEW,
          <FS_DATA_MATERIAL>-GEWEI, <FS_DATA_MATERIAL>-NTGEW, <FS_DATA_MATERIAL>-MAGRV, <FS_DATA_MATERIAL>-VHART, <FS_DATA_MATERIAL>-TRAGR,
          <FS_DATA_MATERIAL>-BSTME, <FS_DATA_MATERIAL>-EKWSL, <FS_DATA_MATERIAL>-RAUBE, <FS_DATA_MATERIAL>-MHDRZ, <FS_DATA_MATERIAL>-MHDHB,MEINS, <FS_DATA_MATERIAL>-MAGRV2)
    FROM MARA INNER JOIN MAKT ON MARA~MATNR = MAKT~MATNR
    WHERE MARA~MATNR = <FS_DATA_MATERIAL>-MATNR.

    SELECT SINGLE LGPBE INTO <FS_DATA_MATERIAL>-LGPBE
      FROM MARD WHERE MATNR = <FS_DATA_MATERIAL>-MATNR AND WERKS = <FS_DATA_MATERIAL>-WERKS.

    SELECT SINGLE UMREN MEINH UMREZ KZWSO
      INTO (<FS_DATA_MATERIAL>-UMREN, <FS_DATA_MATERIAL>-MEINH, <FS_DATA_MATERIAL>-UMREZ, <FS_DATA_MATERIAL>-KZWSO)
      FROM MARM WHERE MATNR = <FS_DATA_MATERIAL>-MATNR AND MEINH <> MEINS AND UMREZ EQ '1' AND UMREN EQ '1'.

    SELECT SINGLE BWTTY BWTAR BWKEY BKLAS VPRSV VERPR PEINH STPRS MLAST
                  EKALR MLMAA HKMAT HRKFT KOSGR
      INTO (<FS_DATA_MATERIAL>-BWTTY, <FS_DATA_MATERIAL>-BWTAR, <FS_DATA_MATERIAL>-BWKEY, <FS_DATA_MATERIAL>-BKLAS, <FS_DATA_MATERIAL>-VPRSV, <FS_DATA_MATERIAL>-VERPR, <FS_DATA_MATERIAL>-PEINH, <FS_DATA_MATERIAL>-STPRS, <FS_DATA_MATERIAL>-MLAST,
            <FS_DATA_MATERIAL>-EKALR, <FS_DATA_MATERIAL>-MLMAA, <FS_DATA_MATERIAL>-HKMAT, <FS_DATA_MATERIAL>-HRKFT, <FS_DATA_MATERIAL>-KOSGR)
      FROM MBEW
      WHERE MATNR = <FS_DATA_MATERIAL>-MATNR  AND BWKEY = <FS_DATA_MATERIAL>-WERKS.

    SELECT SINGLE LGTYP
      INTO <FS_DATA_MATERIAL>-LGTYP
      FROM MLGT
      WHERE MATNR = <FS_DATA_MATERIAL>-MATNR AND LGNUM = <FS_DATA_MATERIAL>-LGNUM.

    SELECT SINGLE ALAND TAXM1
      INTO (<FS_DATA_MATERIAL>-ALAND,<FS_DATA_MATERIAL>-TAXKM)
      FROM MLAN
      WHERE MATNR = <FS_DATA_MATERIAL>-MATNR.

    SELECT SINGLE TATYP FROM TSTL INTO <FS_DATA_MATERIAL>-TATYP
      WHERE TALND = <FS_DATA_MATERIAL>-ALAND.

    SELECT SINGLE VTWEG VRKME SKTOF VERSG KONDM KTGRM MTPOS PRODH MVGR1 MVGR2 MVGR3 MVGR4 MVGR5 "DWERK
      FROM MVKE
      INTO (<FS_DATA_MATERIAL>-VTWEG, <FS_DATA_MATERIAL>-VRKME, <FS_DATA_MATERIAL>-SKTOF, <FS_DATA_MATERIAL>-VERSG, <FS_DATA_MATERIAL>-KONDM,
            <FS_DATA_MATERIAL>-KTGRM, <FS_DATA_MATERIAL>-MTPOS, <FS_DATA_MATERIAL>-PRODH, <FS_DATA_MATERIAL>-MVGR1, <FS_DATA_MATERIAL>-MVGR2, <FS_DATA_MATERIAL>-MVGR3, <FS_DATA_MATERIAL>-MVGR4, <FS_DATA_MATERIAL>-MVGR5) "<FS_DATA_MATERIAL>-DWERK,
      WHERE MATNR = <FS_DATA_MATERIAL>-MATNR AND VKORG = <FS_DATA_MATERIAL>-VKORG.

  ENDLOOP.

  "------------ TAMBAH REY
  SORT IT_DATA_MATERIAL BY MATNR.

  LOOP AT IT_DATA_MATERIAL.

    IF IT_DATA_MATERIAL-MATKL IN R_SRGROUP.

      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = 'X'.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = 'X'.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IF IT_DATA_MATERIAL-BESKZ EQ 'E'.
        IT_DATA_MATERIAL-SICHT_E = ''.
      ELSEIF IT_DATA_MATERIAL-BESKZ EQ 'X'.
        IT_DATA_MATERIAL-SICHT_E = ''.
      ELSE.
        IT_DATA_MATERIAL-SICHT_E = 'X'.
      ENDIF.

      IT_DATA_MATERIAL-VERPR = ''.
      IT_DATA_MATERIAL-STPRS = ''.

    ENDIF.

    IF IT_DATA_MATERIAL-MATKL IN R_JRGROUP.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_E = ''.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = 'X'.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.

      IT_DATA_MATERIAL-VERPR = ''.
      IT_DATA_MATERIAL-STPRS = ''.

    ENDIF.

    IF IT_DATA_MATERIAL-MATKL IN R_MIXGROUP.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_E = ''.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = 'X'.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.

    ENDIF.

    IF IT_DATA_MATERIAL-MATKL EQ RAWREC.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = 'X'.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = ''.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.

    ENDIF.

    IF IT_DATA_MATERIAL-MATKL EQ RECYCLE.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = 'X'.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.

    ENDIF.

    IF IT_DATA_MATERIAL-MATKL EQ WASTEFILM.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_E = ''.
      IT_DATA_MATERIAL-SICHT_D = ''.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = ''.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.

    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZSNF'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = 'X'.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = 'X'.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZOPS'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = ''.
      IT_DATA_MATERIAL-SICHT_D = ''.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = ''.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = ''.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = ''.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZSRV'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = ''.
      IT_DATA_MATERIAL-SICHT_D = ''.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = ''.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = ''.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = ''.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZPCK'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZRAW'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZRTP'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.
      IT_DATA_MATERIAL-SICHT_D = ''.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = 'X'.
      IT_DATA_MATERIAL-SICHT_B = ''.
      IT_DATA_MATERIAL-SICHT_G = ''.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-MTART EQ 'ZSUT' OR IT_DATA_MATERIAL-MTART EQ 'ZSCO' OR IT_DATA_MATERIAL-MTART EQ 'ZSME' OR IT_DATA_MATERIAL-MTART EQ 'ZSGE' OR IT_DATA_MATERIAL-MTART EQ 'ZSEL'.
      IT_DATA_MATERIAL-SICHT_K = 'X'.
      IT_DATA_MATERIAL-SICHT_E = 'X'.
      IT_DATA_MATERIAL-SICHT_D = 'X'.
      IT_DATA_MATERIAL-SICHT_A = ''.
      IT_DATA_MATERIAL-SICHT_L = 'X'.
      IT_DATA_MATERIAL-SICHT_S = ''.
      IT_DATA_MATERIAL-SICHT_Q = ''.
      IT_DATA_MATERIAL-SICHT_B = 'X'.
      IT_DATA_MATERIAL-SICHT_G = 'X'.
      IT_DATA_MATERIAL-SICHT_V = 'X'.
    ENDIF.

    IF IT_DATA_MATERIAL-SPRAS EQ 'E'.
      IT_DATA_MATERIAL-SPRAS = 'EN'.
    ENDIF.

    CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
      EXPORTING
        INPUT  = IT_DATA_MATERIAL-MEINS
      IMPORTING
        OUTPUT = IT_DATA_MATERIAL-MEINS.

    IF IT_DATA_MATERIAL-SICHT_V NE 'X'.
      IT_DATA_MATERIAL-VKORG = ''. "SALES ORG
      IT_DATA_MATERIAL-VTWEG = ''. "DISTRI CHANNEL
      IT_DATA_MATERIAL-TATYP = ''. "TAX
      IT_DATA_MATERIAL-ALAND = ''. "COUNTRY

    ENDIF.

    SELECT MATNR VKORG DWERK
    FROM MVKE
    INTO CORRESPONDING FIELDS OF TABLE IT_DATA_MATERIAL_TMP1
    WHERE MATNR = IT_DATA_MATERIAL-MATNR.

    LOOP AT IT_DATA_MATERIAL_TMP1 WHERE MATNR EQ IT_DATA_MATERIAL-MATNR AND VKORG EQ IT_DATA_MATERIAL-VKORG.
      IT_DATA_MATERIAL-DWERK = IT_DATA_MATERIAL_TMP1-DWERK.
    ENDLOOP.


    IF IT_DATA_MATERIAL-SICHT_V EQ 'X'.
      IF IT_DATA_MATERIAL_TMP1[] IS INITIAL.
        IT_DATA_MATERIAL-VKORG = 'BlmM'.

      ELSE.
        LOOP AT IT_DATA_MATERIAL_TMP1.
          R_VKORG_TMP-SIGN = 'I'.
          R_VKORG_TMP-OPTION = 'EQ'.
          R_VKORG_TMP-LOW = IT_DATA_MATERIAL_TMP1-VKORG.
          APPEND R_VKORG_TMP.
          CLEAR R_VKORG_TMP.
        ENDLOOP.

        IF IT_DATA_MATERIAL-VKORG NOT IN R_VKORG_TMP.
          IT_DATA_MATERIAL-VKORG = 'Slh'.
        ENDIF.

        REFRESH R_VKORG_TMP.
        CLEAR R_VKORG_TMP.
      ENDIF.
    ENDIF.

    IT_DATA_MATERIAL-MGV_MATERIAL_EXTERNAL = IT_DATA_MATERIAL-MATNR.
    MODIFY IT_DATA_MATERIAL.


  ENDLOOP.


  "------------- END TAMBAH REY

ENDFORM.                    "GET_TEMPLATE_MATERIAL

