FORM GET_TEMPLATE_PROFILE.
  DATA: TGL(2),
        BLN(2),
        THN(4).
  SELECT OBJEK ERSDT PRIO PRFID KLART
    FROM CUCO
    INTO CORRESPONDING FIELDS OF TABLE IT_DATA_PROFILE
    WHERE OBJEK IN S_MATNR AND OBTAB = 'MARA'.

  LOOP AT IT_DATA_PROFILE.
    THN = IT_DATA_PROFILE-ERSDT(4).
    BLN = IT_DATA_PROFILE-ERSDT+4(2).
    TGL = IT_DATA_PROFILE-ERSDT+6(2).

    CONCATENATE TGL BLN THN INTO IT_DATA_PROFILE-ERSDT_STR SEPARATED BY '.'.

    CLEAR: THN, BLN, TGL.
    MODIFY IT_DATA_PROFILE.
  ENDLOOP.



