        ENDIF.
        CTR = 5.
        MODIFY IT_DATA_PROPORTION TRANSPORTING MEINH4 PLANVALUE4 ATINN4 CPLANVALUE4 WHERE MATNR = IT_MARM-MATNR.
      ENDIF.
    ENDIF.
  ENDLOOP.
