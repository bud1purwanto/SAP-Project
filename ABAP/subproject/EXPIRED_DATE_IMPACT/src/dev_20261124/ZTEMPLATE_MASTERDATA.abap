FORM GET_TEMPLATE_INSPLAN.
  CLEAR: IT_INSPLAN.
  REFRESH: IT_INSPLAN.

  SELECT MAPL~MATNR MAPL~WERKS MAPL~PLNNR MAPL~PLNAL MAPL~DATUV
         PLKO~KTEXT PLKO~VERWE PLKO~STATU PLKO~VAGRP PLKO~LOSVN PLKO~LOSBS
         PLPO~VORNR PLPO~STEUS CRHD~ARBPL
         PLMK~MERKNR PLMK~VERWMERKM PLMK~MKVERSION PLMK~STICHPRVER
    INTO CORRESPONDING FIELDS OF TABLE IT_INSPLAN
    FROM MAPL JOIN PLKO ON MAPL~PLNTY = PLKO~PLNTY AND MAPL~PLNNR = PLKO~PLNNR
        AND MAPL~PLNAL = PLKO~PLNAL AND MAPL~ZAEHL = PLKO~ZAEHL
        JOIN PLPO ON PLKO~PLNTY = PLPO~PLNTY AND PLKO~PLNNR = PLPO~PLNNR AND PLKO~ZAEHL = PLPO~ZAEHL
        JOIN PLMK ON MAPL~PLNTY = PLMK~PLNTY AND MAPL~PLNNR = PLMK~PLNNR AND MAPL~ZAEHL = PLMK~PLNKN
        JOIN CRHD ON PLPO~ARBID = CRHD~OBJID
        WHERE MAPL~MATNR IN S_MATNR
        AND MAPL~WERKS IN S_WERKS
        AND MAPL~PLNTY EQ 'Q'
        AND MAPL~LOEKZ EQ ''
        AND PLKO~LOEKZ EQ ''.

