FORM GET_TEMPLATE_CLASSIFICATION.
  SELECT MARA~MATNR MARA~MTART MARA~MBRSH INOB~KLART KLAH~CLASS KLAH~CLINT
      INTO CORRESPONDING FIELDS OF TABLE IT_CLASS
      FROM MARA
        JOIN INOB ON MARA~MATNR = INOB~OBJEK
        JOIN KSSK ON INOB~CUOBJ = KSSK~OBJEK
        JOIN KLAH ON KSSK~CLINT = KLAH~CLINT
      WHERE MARA~MATNR IN S_MATNR AND INOB~OBTAB = 'MARA'.

  LOOP AT IT_CLASS.
    CLEAR IT_DATA_CLASSIFICATION.
    READ TABLE IT_DATA_CLASSIFICATION WITH KEY MATNR = IT_CLASS-MATNR.

    IF SY-SUBRC NE 0.
      MOVE-CORRESPONDING IT_CLASS TO IT_DATA_CLASSIFICATION.
      IT_DATA_CLASSIFICATION-CLASS1 = IT_CLASS-CLASS.
      IT_DATA_CLASSIFICATION-KLART1 = IT_CLASS-KLART.
      IT_DATA_CLASSIFICATION-ATINN1 = 'ZZCODE'.
      IT_DATA_CLASSIFICATION-ATWRT1 = IT_CLASS-MATNR+2(3).
      APPEND IT_DATA_CLASSIFICATION.
    ELSE.
      MOVE-CORRESPONDING IT_CLASS TO IT_DATA_CLASSIFICATION.
      IT_DATA_CLASSIFICATION-CLASS2 = IT_CLASS-CLASS.
      IT_DATA_CLASSIFICATION-KLART2 = IT_CLASS-KLART.
      IT_DATA_CLASSIFICATION-ATINN2 = 'ZZCODE'.
      IT_DATA_CLASSIFICATION-ATWRT2 = IT_CLASS-MATNR+2(3).
      MODIFY IT_DATA_CLASSIFICATION TRANSPORTING CLASS2 KLART2 ATINN2 ATWRT2 WHERE MATNR = IT_CLASS-MATNR.
    ENDIF.

  ENDLOOP.


ENDFORM.                    "GET_TEMPLATE_CLASSIFICATION
