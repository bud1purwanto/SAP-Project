  "----- TAMBAH REY
*&---------------------------------------------------------------------*
*&      Form  SETMatGroup
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM SETMATGROUP.
  CLEAR: V_LOW_TMP,V_HIGH_TMP.
  V_LOW_TMP = 400001.
  V_HIGH_TMP = 400014.

  R_JRGROUP-SIGN = 'I'.
  R_JRGROUP-OPTION = 'EQ'.
  R_JRGROUP-LOW = V_LOW_TMP.
  CONDENSE R_JRGROUP-LOW.
  APPEND R_JRGROUP.
  CLEAR R_JRGROUP.

  WHILE V_LOW_TMP < V_HIGH_TMP.
    V_LOW_TMP = V_LOW_TMP + 1.

    R_JRGROUP-SIGN = 'I'.
    R_JRGROUP-OPTION = 'EQ'.
    R_JRGROUP-LOW = V_LOW_TMP.
    CONDENSE R_JRGROUP-LOW.
    APPEND R_JRGROUP.
    CLEAR R_JRGROUP.
  ENDWHILE.

  CLEAR: V_LOW_TMP,V_HIGH_TMP.
  V_LOW_TMP = 400101.
  V_HIGH_TMP = 400106.

  R_MIXGROUP-SIGN = 'I'.
  R_MIXGROUP-OPTION = 'EQ'.
  R_MIXGROUP-LOW = V_LOW_TMP.
  CONDENSE R_MIXGROUP-LOW.
  APPEND R_MIXGROUP.
  CLEAR R_MIXGROUP.

  WHILE V_LOW_TMP < V_HIGH_TMP.
    V_LOW_TMP = V_LOW_TMP + 1.

    R_MIXGROUP-SIGN = 'I'.
    R_MIXGROUP-OPTION = 'EQ'.
    R_MIXGROUP-LOW = V_LOW_TMP.
    CONDENSE R_MIXGROUP-LOW.
    APPEND R_MIXGROUP.
    CLEAR R_MIXGROUP.
  ENDWHILE.

  CLEAR: V_LOW_TMP,V_HIGH_TMP.
  V_LOW_TMP = 300001.
  V_HIGH_TMP = 300014.

  R_SRGROUP-SIGN = 'I'.
  R_SRGROUP-OPTION = 'EQ'.
  R_SRGROUP-LOW = V_LOW_TMP.
  CONDENSE R_SRGROUP-LOW.
  APPEND R_SRGROUP.
  CLEAR R_SRGROUP.

  WHILE V_LOW_TMP < V_HIGH_TMP.
    V_LOW_TMP = V_LOW_TMP + 1.

    R_SRGROUP-SIGN = 'I'.
    R_SRGROUP-OPTION = 'EQ'.
    R_SRGROUP-LOW = V_LOW_TMP.

    CONDENSE R_SRGROUP-LOW.
    APPEND R_SRGROUP.
    CLEAR R_SRGROUP.
  ENDWHILE.

  RECYCLE = 'B00501'.
  RAWREC = 'B00503'.
  WASTEFILM = 'B00504'.

ENDFORM.                    "SETMatGroup
"----- END TAMBAH REY

