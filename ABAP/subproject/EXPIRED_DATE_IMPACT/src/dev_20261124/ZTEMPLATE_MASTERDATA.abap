*&---------------------------------------------------------------------*
*&      Form  GET_TEMPLATE_PROPORTION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_TEMPLATE_PROPORTION.
  DATA: DESCATINN TYPE STRING.
  SELECT MATNR UMREN UMREZ MEINH ATINN
    FROM MARM
    INTO CORRESPONDING FIELDS OF TABLE IT_MARM
    WHERE MATNR IN S_MATNR AND ATINN <> 0 ORDER BY MATNR.

  LOOP AT IT_MARM.
    CLEAR IT_DATA_PROPORTION.


    CALL FUNCTION 'CONVERSION_EXIT_ATINN_OUTPUT'
      EXPORTING
        INPUT  = IT_MARM-ATINN
      IMPORTING
        OUTPUT = DESCATINN.

    READ TABLE IT_DATA_PROPORTION WITH KEY MATNR = IT_MARM-MATNR.

    IF SY-SUBRC NE 0.
      IT_DATA_PROPORTION-MATNR = IT_MARM-MATNR.
      IT_DATA_PROPORTION-MEINH1 = IT_MARM-MEINH.
      IT_DATA_PROPORTION-PLANVALUE1 = IT_MARM-UMREZ / IT_MARM-UMREN.
      IT_DATA_PROPORTION-ATINN1 = DESCATINN."IT_MARM-ATINN.
      CTR = 2.
*      IT_DATA_PROPORTION-CPLANVALUE1 = IT_DATA_PROPORTION-PLANVALUE1.
      IF IT_DATA_PROPORTION-MEINH1 EQ 'ROL' .
        IT_DATA_PROPORTION-CPLANVALUE1 = 1.
      ELSE.
        IT_DATA_PROPORTION-CPLANVALUE1 = IT_DATA_PROPORTION-PLANVALUE1.
      ENDIF.

      APPEND IT_DATA_PROPORTION.
    ELSE.
      IF CTR = 2.
        IT_DATA_PROPORTION-MEINH2 = IT_MARM-MEINH.
        IT_DATA_PROPORTION-PLANVALUE2 = IT_MARM-UMREZ / IT_MARM-UMREN.
        IT_DATA_PROPORTION-ATINN2 = DESCATINN."IT_MARM-ATINN.
*        IT_DATA_PROPORTION-CPLANVALUE2 = IT_DATA_PROPORTION-PLANVALUE2.

        IF IT_DATA_PROPORTION-MEINH2 EQ 'ROL' .
          IT_DATA_PROPORTION-CPLANVALUE2 = 1.
        ELSE.
          IT_DATA_PROPORTION-CPLANVALUE2 = IT_DATA_PROPORTION-PLANVALUE2.
        ENDIF.

        CTR = 3.
        MODIFY IT_DATA_PROPORTION TRANSPORTING MEINH2 PLANVALUE2 ATINN2 CPLANVALUE2 WHERE MATNR = IT_MARM-MATNR.
      ELSEIF CTR = 3.
        IT_DATA_PROPORTION-MEINH3 = IT_MARM-MEINH.
        IT_DATA_PROPORTION-PLANVALUE3 = IT_MARM-UMREZ / IT_MARM-UMREN.
        IT_DATA_PROPORTION-ATINN3 = DESCATINN."IT_MARM-ATINN.
