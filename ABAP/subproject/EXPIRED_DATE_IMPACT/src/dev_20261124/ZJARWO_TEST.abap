FORM EXECUTE_SQL.
  VARPROGRAM = 'ZTPPR_PRO_MOVEMENT_HDR'.
*  CONCATENATE SY-DATUM SY-UZEIT VNM1 INTO VARID.
  INSERT_LOG_SQL IT_MKPF MBLNR VNM1.
  IF IT_MKPF[] IS INITIAL.
    VARSTATUS = '0'. "VARMSG = ''.
    PERFORM UPDATE_LOG_SQL.
  ELSE.
    PERFORM INSERT_SQL_HDR.
    PERFORM UPDATE_LOG_SQL.
  ENDIF.

  VARPROGRAM = 'ZTPPR_PRO_MOVEMENT_DTL'.
*  CONCATENATE SY-DATUM SY-UZEIT VNM2 INTO VARID.
  INSERT_LOG_SQL IT_MSEG MBLNR VNM2.
  IF IT_MSEG[] IS INITIAL.
    VARSTATUS = '0'. "VARMSG = ''.
    PERFORM UPDATE_LOG_SQL.
  ELSE.
    PERFORM INSERT_SQL_DTL.
    PERFORM UPDATE_LOG_SQL.
  ENDIF.

ENDFORM.                    "EXECUTE_SQL