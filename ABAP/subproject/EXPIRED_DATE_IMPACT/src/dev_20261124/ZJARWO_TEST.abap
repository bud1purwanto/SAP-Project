REPORT  ZJARWO_TEST.

INCLUDE ZINCL_ERP_SQL.
TABLES : AUFK,MKPF,MARA, MSEG.

DATA : BEGIN OF IT_MBLNR OCCURS 0,
         MBLNR TYPE MKPF-MBLNR,
       END OF IT_MBLNR.

TYPES : BEGIN OF T_AUFNR,
          AUFNR TYPE AUFK-AUFNR,
          AUART TYPE AUFK-AUART,
END OF T_AUFNR.

DATA : IT_AUFNR TYPE T_AUFNR OCCURS 0,
       IT_AUFNR02 TYPE T_AUFNR OCCURS 0.

DATA : IT_MKPF TYPE MKPF OCCURS 0 WITH HEADER LINE,
       IT_MSEG TYPE MSEG OCCURS 0 WITH HEADER LINE.

DATA : FNAME TYPE STRING,
      VNM1(10) TYPE C,
      VNM2(10) TYPE C.

SELECTION-SCREEN BEGIN OF BLOCK BLOCK02 WITH FRAME TITLE TEXT-002.
SELECT-OPTIONS : S_BKTXT FOR MKPF-BKTXT.
SELECTION-SCREEN END OF BLOCK BLOCK02.


START-OF-SELECTION.
  PERFORM CHECK_SERVER.
  PERFORM GET_DATA_COID.
  VNM1 = 'HDR_COID'. VNM2 = 'DTL_COID'.
  PERFORM EXECUTE_SQL.

END-OF-SELECTION.


*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA_COID.
  CLEAR : IT_MBLNR, IT_MSEG, IT_MKPF.
  REFRESH : IT_MBLNR, IT_MSEG, IT_MKPF.

  SELECT * FROM MKPF INTO TABLE IT_MKPF WHERE BKTXT IN S_BKTXT.

  IF IT_MKPF[] IS NOT INITIAL.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MSEG FROM MSEG
     FOR ALL ENTRIES IN IT_MKPF
      WHERE MSEG~MBLNR = IT_MKPF-MBLNR AND
            MSEG~BWART = '531'.
  ENDIF.

  IF IT_MSEG[] IS NOT INITIAL.
    SELECT * FROM MKPF INTO TABLE IT_MKPF
      FOR ALL ENTRIES IN IT_MSEG
      WHERE MBLNR = IT_MSEG-MBLNR.
  ENDIF.

  IT_MKPF-BUDAT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING BUDAT WHERE BUDAT = 00000000.
  IT_MKPF-BLDAT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING BLDAT WHERE BLDAT = 00000000.
  IT_MKPF-CPUDT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING CPUDT WHERE CPUDT  = 00000000.
  IT_MKPF-AEDAT = '19000101'.
  MODIFY IT_MKPF TRANSPORTING AEDAT WHERE AEDAT = 00000000.
  IT_MSEG-VFDAT = '19000101'.
  MODIFY IT_MSEG TRANSPORTING VFDAT WHERE VFDAT = 00000000.
  IT_MSEG-DABRBZ = '19000101'.
  MODIFY IT_MSEG TRANSPORTING DABRBZ WHERE DABRBZ = 00000000.
  IT_MSEG-DABRZ = '19000101'.
  MODIFY IT_MSEG TRANSPORTING DABRZ WHERE DABRZ = 00000000.
  IT_MSEG-HSDAT = '19000101'.
  MODIFY IT_MSEG TRANSPORTING HSDAT WHERE HSDAT  = 00000000.
  IT_MSEG-BUDAT_MKPF = '19000101'.
  MODIFY IT_MSEG TRANSPORTING BUDAT_MKPF WHERE BUDAT_MKPF = 00000000.
  IT_MSEG-BUDAT_MKPF = '19000101'.
  MODIFY IT_MSEG TRANSPORTING BUDAT_MKPF WHERE BUDAT_MKPF = 00000000.
  IT_MSEG-/BEV2/ED_AEDAT = '19000101'.
  MODIFY IT_MSEG TRANSPORTING /BEV2/ED_AEDAT WHERE /BEV2/ED_AEDAT = 00000000.
ENDFORM.                    "GET_DATA

