*&---------------------------------------------------------------------*
*&      Form  CHK_MATNUMC
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CHK_MATNUMC .
  DATA : MATNR(18), MATNR1(18), INT TYPE I, INT1 TYPE I,
         HTYPE  LIKE  DD01V-DATATYPE,
         STRING_OUT(100).
  LOOP AT IT_MATERIAL WHERE MATNR NE ''.
    CLEAR : MATNR, HTYPE, STRING_OUT, MATNR1, INT1, INT.
    MATNR = IT_MATERIAL-MATNR . "FGTHT / 978789
    CALL FUNCTION 'NUMERIC_CHECK'
      EXPORTING
        STRING_IN  = MATNR
      IMPORTING
        STRING_OUT = STRING_OUT
        HTYPE      = HTYPE.
    IF HTYPE EQ 'NUMC'.
      INT = STRLEN( MATNR ).
      IF INT < 18.
        INT1 = 18 - INT.
        MATNR1 = MATNR.
        DO INT1 TIMES.
          CONCATENATE '0' MATNR1 INTO MATNR1.
        ENDDO.
        IT_MATERIAL-MATNR = MATNR1.
        MODIFY IT_MATERIAL.
      ENDIF.
    ENDIF.
  ENDLOOP.
ENDFORM.                    " CHK_MATNUMC