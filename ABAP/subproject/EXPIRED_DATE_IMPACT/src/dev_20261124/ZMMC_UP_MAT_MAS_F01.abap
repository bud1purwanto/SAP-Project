FORM FILL_HEADDATA.
  LOOP AT IT_MATERIAL INTO WA_MATERIAL WHERE MATNR = WA_MATERIALT-MATNR AND
                                             WERKS_D = WA_MATERIALT-WERKS_D AND
                                             LGORT_D = WA_MATERIALT-LGORT_D AND
                                             VKORG = WA_MATERIALT-VKORG AND
                                             VTWEG = WA_MATERIALT-VTWEG AND
                                             LGNUM = WA_MATERIALT-LGNUM AND
                                             LGTYP = WA_MATERIALT-LGTYP.


    HEADDATA-MATERIAL          = WA_MATERIAL-MATNR.
    HEADDATA-IND_SECTOR        = WA_MATERIAL-MBRSH.
    HEADDATA-MATL_TYPE         = WA_MATERIAL-MTART.
    HEADDATA-BASIC_VIEW        = WA_MATERIAL-SICHT_K.
    HEADDATA-SALES_VIEW        = WA_MATERIAL-SICHT_V.
    HEADDATA-PURCHASE_VIEW     = WA_MATERIAL-SICHT_E.
    HEADDATA-MRP_VIEW          = WA_MATERIAL-SICHT_D.
*    HEADDATA-FORECAST_VIEW     = WA_MATERIAL-SICHT_P.
    HEADDATA-WORK_SCHED_VIEW   = WA_MATERIAL-SICHT_A.
*    HEADDATA-PRT_VIEW          = WA_MATERIAL-SICHT_F.
    HEADDATA-STORAGE_VIEW      = WA_MATERIAL-SICHT_L.
    HEADDATA-WAREHOUSE_VIEW    = WA_MATERIAL-SICHT_S.
    HEADDATA-QUALITY_VIEW      = WA_MATERIAL-SICHT_Q.
    HEADDATA-ACCOUNT_VIEW      = WA_MATERIAL-SICHT_B.
    HEADDATA-COST_VIEW         = WA_MATERIAL-SICHT_G.
*    HEADDATA-INP_FLD_CHECK     = WA_MATERIAL-FLDPRF.
*    HEADDATA-MATERIAL_EXTERNAL = WA_MATERIAL-MGV_MATERIAL_EXTERNAL. " IRMA ON 3-12-2012
    APPEND HEADDATA.
  ENDLOOP.
  SORT HEADDATA BY MATERIAL.
  DELETE ADJACENT DUPLICATES FROM HEADDATA COMPARING ALL FIELDS.
ENDFORM.                    "FILL_HEADDATA

