*************************Get file name*********************************
AT SELECTION-SCREEN ON VALUE-REQUEST FOR FILENAME.
*POPUP TO SELECT FILE NAME
  CALL FUNCTION 'WS_FILENAME_GET'
    EXPORTING
      DEF_PATH         = 'C:\'
      MASK             = ',*.*,*.*.'
      MODE             = 'O'
    IMPORTING
      FILENAME         = FILENAME
    EXCEPTIONS
      INV_WINSYS       = 1
      NO_BATCH         = 2
      SELECTION_CANCEL = 3
      SELECTION_ERROR  = 4
      OTHERS           = 5.
*************************Get file name*********************************

START-OF-SELECTION.

AT SELECTION-SCREEN.
  CASE SY-UCOMM.
    WHEN 'INFO'.
      PERFORM F_PROG_INFO USING V_PROG.
    WHEN OTHERS.
      CLEAR CTR.
      CLEAR : IT_MATERIALN, IT_MATERIALNN, IT_MATERIAL.
      REFRESH : IT_MATERIALN, IT_MATERIALNN, IT_MATERIAL.
      PERFORM UPLOAD_DATA.
      CLEAR : WA_MATERIAL, WA_RETURNMESSAGES.

      CLEAR: IT_MATERIALT, IT_MATERIALE.
      REFRESH: IT_MATERIALT, IT_MATERIALE.
      CLEAR WA_MATERIALT.

*        BACA SEMUA NILAI INTERNAL
      CLEAR IT_LOG. REFRESH IT_LOG.
      PERFORM CHK_MATNUMC.
      PERFORM READ_INTERNALVALUE.

      CLEAR CTR.
      IT_MATERIALNN[] = IT_MATERIAL[].
      IT_MATERIALT[] = IT_MATERIAL[].

      SORT IT_MATERIALT BY MATNR. " WERKS_D.
      DELETE ADJACENT DUPLICATES FROM IT_MATERIALT COMPARING MATNR WERKS_D LGORT_D VKORG VTWEG LGNUM LGTYP.
      DELETE IT_MATERIALT WHERE MATNR EQ ''.

      CLEAR : CTR.
      LOOP AT IT_MATERIALNN INTO WA_MATERIAL.
*          CTR = CTR + 1.
        DO.
          CLEAR LINE.
          CTR = CTR + 1.
          LOOP AT IT_MATERIALE WHERE LINE = CTR.
            LINE = IT_MATERIALE-LINE.
            EXIT.
          ENDLOOP.
          IF LINE EQ ''.
            EXIT.
          ENDIF.
        ENDDO.

        IF CTR > 0.
          MOVE-CORRESPONDING WA_MATERIAL TO IT_MATERIALN.
          IT_MATERIALN-LINE = CTR.
*          ELSE.
*            MOVE-CORRESPONDING WA_MATERIAL TO IT_MATERIALN.
*            IT_MATERIALN-LINE = WA_MATERIAL-LINE ."CTR.
        ENDIF.
        APPEND IT_MATERIALN.
      ENDLOOP.

      LOOP AT IT_MATERIALT INTO WA_MATERIALT.
        CLEAR : LINE, LX, CTR, IT_LINE, NOERR.
        REFRESH IT_LINE.

        DATA: VBUKRS LIKE T001-BUKRS. "tambahan pengecekann company code
        SELECT SINGLE T001~BUKRS INTO VBUKRS FROM T001W
          JOIN T001K ON T001W~BWKEY = T001K~BWKEY JOIN T001 ON T001K~BUKRS = T001~BUKRS
          WHERE T001W~WERKS = WA_MATERIALT-WERKS_D AND T001~XPROD = 'X'.

        IF SY-SUBRC <> 0.
          IT_MATERIALN-STAT = GCF_E1.
          IT_MATERIALN-MESSAGE = 'Company code is not activated from inputted plant'.
          MODIFY IT_MATERIALN TRANSPORTING STAT MESSAGE WHERE MATNR = WA_MATERIALT-MATNR.
          CONTINUE.
        ENDIF.

        LOOP AT IT_MATERIALN WHERE MATNR = WA_MATERIALT-MATNR AND
                                                   WERKS_D = WA_MATERIALT-WERKS_D AND
                                                   LGORT_D = WA_MATERIALT-LGORT_D AND
                                                   VKORG = WA_MATERIALT-VKORG AND
                                                   VTWEG = WA_MATERIALT-VTWEG AND
                                                   LGNUM = WA_MATERIALT-LGNUM AND
                                                   LGTYP = WA_MATERIALT-LGTYP.
          CLEAR : LX, LINE.
          LINE = IT_MATERIALN-LINE.
          LX = LINE.
          IT_LINE-LINE = LX.
          APPEND IT_LINE.
        ENDLOOP.

        PERFORM INIT.
        PERFORM FILL_HEADDATA.
        PERFORM FILL_PLANTDATA.
        PERFORM FILL_CLIENTDATA.
        PERFORM FILL_STORAGELOCATIONDATA.
        PERFORM FILL_TAXCLASSIFICATION.
        PERFORM FILL_SALESDATA.
        PERFORM FILL_WAREHOUSENUMBERDATA.
        PERFORM FILL_VALUATIONDATA.
        PERFORM FILL_MATERIALDESCRIPTION.
        PERFORM FILL_UNITSOFMEASURE.
        PERFORM FILL_STORAGETYPEDATA.
        PERFORM FILL_PRTDATA.
        PERFORM SAVE_DATA.

        LOOP AT RETURNMESSAGES WHERE TYPE EQ 'E'.
          CTR = CTR + 1.
          EXIT.
        ENDLOOP.

        CLEAR IND.
        IF CTR = 0.
          CALL FUNCTION 'BAPI_TRANSACTION_COMMIT'
            EXPORTING
              WAIT   = 'X'
            IMPORTING
              RETURN = RETURNCOMMIT.
          CLEAR NOERR.
          LOOP AT IT_LINE.
            CLEAR LINE.
            LINE = IT_LINE-LINE.
            LOOP AT IT_MATERIALN WHERE LINE = LINE.
              CLEAR: MESSAGES, V_QMATV, MESSAGES2.
              IT_MATERIALN-STAT = GCF_S1.
              MESSAGES = 'Success'.
              LOOP AT RETURNMESSAGES WHERE TYPE EQ 'S'.
                CONCATENATE MESSAGES RETURNMESSAGES-MESSAGE INTO MESSAGES SEPARATED BY ','.
              ENDLOOP.

              SELECT SINGLE QMATV FROM MARC INTO V_QMATV
                WHERE MATNR = IT_MATERIALN-MATNR
                  AND QMATV = 'X'.

              IF SY-SUBRC = 0.
                IT_MATERIALN-STAT = GCF_W1.
                MESSAGES2 = 'Inspection setup exists, please added manually'.
                CONCATENATE MESSAGES MESSAGES2 INTO MESSAGES SEPARATED BY ','.
              ENDIF.

              IT_MATERIALN-NOERR = NOERR + 1.
              IT_MATERIALN-MESSAGE = MESSAGES.
              MODIFY IT_MATERIALN.
              EXIT.
            ENDLOOP.
          ENDLOOP.
        ELSE.
          LOOP AT IT_LINE.
            CLEAR LINE.
            LINE = IT_LINE-LINE.
            CLEAR: WA_MATERIALN, NOERR.
            LOOP AT IT_MATERIALN WHERE LINE = LINE.
              IT_MATERIALN-NOERR = NOERR + 1.
              IT_MATERIALN-STAT = GCF_E1.
              IT_MATERIALN-MESSAGE = 'Error'.
              MODIFY IT_MATERIALN.
              WA_MATERIALN = IT_MATERIALN.
            ENDLOOP.

            LOOP AT IT_LINE.
              CLEAR : LX, MSG.
              LX = IT_LINE-LINE.

              SORT RETURNMESSAGES BY TYPE MESSAGE.
              DELETE ADJACENT DUPLICATES FROM RETURNMESSAGES COMPARING TYPE MESSAGE.
              LOOP AT RETURNMESSAGES INTO WA_RETURNMESSAGES WHERE TYPE EQ 'E'.
                APPEND WA_RETURNMESSAGES TO IT_RETURNMESSAGES.
                CLEAR MSG.
                WA_MATERIALN-NOERR = NOERR + 1.
                WA_MATERIALN-MESSAGE = WA_RETURNMESSAGES-MESSAGE.
                APPEND WA_MATERIALN TO IT_MATERIALN.
              ENDLOOP.
            ENDLOOP.
          ENDLOOP.
        ENDIF.
      ENDLOOP.

      SORT IT_MATERIALN BY LINE. "NOERR LINE
      DELETE ADJACENT DUPLICATES FROM IT_MATERIALN COMPARING LINE MESSAGE MATNR.
      IF IT_MATERIALE[] IS NOT INITIAL.
        LOOP AT IT_MATERIALE INTO WA_MATERIALN.
          WA_MATERIALN-NOERR = 1.
          APPEND WA_MATERIALN TO IT_MATERIALN.
        ENDLOOP.
        SORT IT_MATERIALN BY LINE. "NOERR LINE
      ENDIF.

*       added on 13-11-2012
      DELETE IT_MATERIALN WHERE MESSAGE EQ 'Error'.
      PERFORM DISPLAY_REPORT.
  ENDCASE.
