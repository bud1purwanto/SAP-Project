  DATA : MATLTYPE LIKE BAPIMATDOA-MATL_TYPE,
         MBRSH LIKE MARA-MBRSH,
         MTART LIKE MARA-MTART,
         IT_MAT LIKE STANDARD TABLE OF IT_MATERIAL,
         MESSAGE TYPE CHAR100.
  CLEAR: CTR, MATLTYPE, MBRSH, MTART, MESSAGE.
  CLEAR IT_MAT. REFRESH IT_MAT.
  IT_MAT[] = IT_MATERIAL[].

  LOOP AT IT_MATERIAL.
    CLEAR : MEINS, GEWEI , LRMEI , VRKME , BSTME , AUSME , FRTME ,
         LVSME , MATNR, MAKTX, LX, MATLTYPE, WA_MATERIAL, MESSAGE.
    CTR = CTR +  1.
    WA_MATERIAL = IT_MATERIAL.
    MEINS  =  IT_MATERIAL-MEINS.
    GEWEI  = IT_MATERIAL-GEWEI.
    LRMEI = IT_MATERIAL-LRMEI.
    VRKME = IT_MATERIAL-VRKME.
    BSTME = IT_MATERIAL-BSTME.
    AUSME = IT_MATERIAL-AUSME.
    FRTME = IT_MATERIAL-FRTME.
    LVSME = IT_MATERIAL-LVS_LVSME.
    MATNR = IT_MATERIAL-MATNR.
    CONDENSE : GEWEI, LRMEI.

*CEK TERLEBIH DAHULU, ADA ERROR INTERNAL ATAU GA
    IF MATNR  NE ''.
      CALL FUNCTION 'CONVERSION_EXIT_MATN1_INPUT'
        EXPORTING
          INPUT        = MATNR
        IMPORTING
          OUTPUT       = MATNR
        EXCEPTIONS
          LENGTH_ERROR = 1
          OTHERS       = 2.
      IF SY-SUBRC <> 0.
*   Implement suitable error handling here
      ENDIF.
      IT_MATERIAL-MATNR = MATNR.
    ENDIF.

    CLEAR MATNR_EXT.
    MATNR_EXT = IT_MATERIAL-MGV_MATERIAL_EXTERNAL.
    IF MATNR_EXT  NE ''.
      CALL FUNCTION 'CONVERSION_EXIT_MATNL_INPUT' "CONVERSION_EXIT_MATN1_INPUT
          EXPORTING
            INPUT              = MATNR_EXT
         IMPORTING
           OUTPUT             = MATNR_EXT
         EXCEPTIONS
           LENGTH_ERROR       = 1
           OTHERS             = 2
                  .
      IF SY-SUBRC <> 0.
*   Implement suitable error handling here
      ENDIF.
      IT_MATERIAL-MGV_MATERIAL_EXTERNAL = MATNR_EXT.
    ENDIF.

    IF MEINS NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = MEINS
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = MEINS
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-MEINS = MEINS.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF GEWEI NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = GEWEI
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = GEWEI
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-GEWEI = GEWEI.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-GEWEI = GEWEI.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF LRMEI NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = LRMEI
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = LRMEI
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-LRMEI = LRMEI.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-LRMEI = LRMEI.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF VRKME NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = VRKME
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = VRKME
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-VRKME = VRKME.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-VRKME = VRKME.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF BSTME NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = BSTME
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = BSTME
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-BSTME = BSTME.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-BSTME = BSTME.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF AUSME NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = AUSME
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = AUSME
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-AUSME = AUSME.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-AUSME = AUSME.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF FRTME NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = FRTME
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = FRTME
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-FRTME = FRTME.
      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-FRTME = FRTME.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

    IF LVSME NE ''.
      CLEAR MESSAGE.
      CALL FUNCTION 'ZCONVERSION_EXIT_CUNIT_INPUT'
        EXPORTING
          INPUT          = LVSME
          LANGUAGE       = SY-LANGU
        IMPORTING
          OUTPUT         = LVSME
          MESSAGE        = MESSAGE
        EXCEPTIONS
          UNIT_NOT_FOUND = 1
          OTHERS         = 2.
*    IT_MATERIAL-LVS_LVSME = LVSME.

      IF MESSAGE EQ ''.
* Implement suitable error handling here
        IT_MATERIAL-LVS_LVSME = LVSME.
      ELSE.
        CLEAR WA_MATERIALN.
        MOVE-CORRESPONDING WA_MATERIAL TO WA_MATERIALN.
        WA_MATERIALN-LINE = CTR.
        WA_MATERIALN-STAT = GCF_E1.
        WA_MATERIALN-MESSAGE = MESSAGE.
        APPEND WA_MATERIALN TO IT_MATERIALE.
        DELETE IT_MATERIAL.
        CONTINUE.
      ENDIF.
    ENDIF.

*  CREATE NOMOR MATERIAL JIKA TIDAK ADA ERROR
    IF WA_MATERIAL-MATNR EQ ''.
      MAKTX = IT_MATERIAL-MAKTX.
      SELECT SINGLE MATNR
        INTO MATNR
        FROM MAKT
        WHERE MAKTX EQ MAKTX AND SPRAS EQ 'EN'.
      IF MATNR EQ '' OR MATNR EQ '000000000000000000'.
        IF IT_MATERIAL-WERKS_D NE ''. " AND IT_MATERIAL-LGORT_D NE ''.
          CLEAR : MATNR, MATLTYPE.
          MATLTYPE = IT_MATERIAL-MTART.
          "CEK DALAM INTERNAL TABEL APAKAH NOMORNYA SUDAH PERNAH DIBENTUK
          LOOP AT IT_MAT INTO WA_MATERIAL
                  WHERE MAKTX EQ MAKTX AND
*                                  MTART EQ IT_MATERIAL-MTART AND
                                    MATNR NE ''.
            MATNR = WA_MATERIAL-MATNR.
            MATLTYPE = WA_MATERIAL-MTART.
            EXIT.
          ENDLOOP.

          IF MATNR EQ ''.
            PERFORM GET_MATERIAL USING MATNR MATLTYPE.
          ELSE.
            IT_MATERIAL-MTART = MATLTYPE.
          ENDIF.
        ELSE.
          CLEAR MSG.
          LX = CTR.
          CONCATENATE 'MATERIAL in line ' LX 'is not valid with no material description.' INTO MSG SEPARATED BY SPACE.
        ENDIF.
        IT_MATERIAL-MATNR = MATNR.
      ELSE.
        IT_MATERIAL-MATNR = MATNR.
        SELECT SINGLE MBRSH MTART
          INTO (MBRSH, MTART)
          FROM MARA
          WHERE MATNR EQ MATNR.

        IF MBRSH NE ''.
          IT_MATERIAL-MBRSH = MBRSH.
        ENDIF.
        IF MTART NE ''.
          IT_MATERIAL-MTART = MTART.
        ENDIF.
      ENDIF.
*  ELSEIF IT_MATERIAL-MATNR NE IT_MATERIAL-MGV_MATERIAL_EXTERNAL. "COMMENT
*    IT_MATERIAL-MGV_MATERIAL_EXTERNAL = IT_MATERIAL-MATNR.
    ENDIF.

*  CLEAR IT_MATERIAL-MGV_MATERIAL_EXTERNAL. " BY IRMA ON 3-12-2012
    MODIFY IT_MATERIAL.
    CLEAR IT_MAT. REFRESH IT_MAT.
    IT_MAT[] = IT_MATERIAL[].
  ENDLOOP.

ENDFORM.                    " READ_INTERNALVALUE


*&---------------------------------------------------------------------*
*&      Form  CEK_DDESCRIPTION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CEK_DDESCRIPTION .
  DATA : IT_MATERIALDES LIKE STANDARD TABLE OF IT_MATERIAL WITH HEADER LINE,
         IT_MATERIALDET LIKE STANDARD TABLE OF IT_MATERIAL WITH HEADER LINE.
  CLEAR: IT_MATERIALDES, IT_MATERIALDET.
  REFRESH: IT_MATERIALDES, IT_MATERIALDET.
  IT_MATERIALDES[] = IT_MATERIAL[].
  SORT IT_MATERIALDES BY MAKTX WERKS_D LGORT_D.
  DELETE ADJACENT DUPLICATES FROM IT_MATERIALDES COMPARING MAKTX WERKS_D LGORT_D.

  CLEAR CTR.
  LOOP AT IT_MATERIALDES.
    CLEAR CTR .
    LOOP AT IT_MATERIAL WHERE MAKTX EQ IT_MATERIALDES-MAKTX  AND
                              WERKS_D EQ IT_MATERIALDES-WERKS_D AND
                              LGORT_D EQ IT_MATERIALDES-LGORT_D AND
                              ( MTART EQ 'ZSCO' OR
                                MTART EQ 'ZSEC' OR
                                MTART EQ 'ZSGE' OR
                                MTART EQ 'ZSME' OR
                                MTART EQ 'ZSCT'). "+KE6 KONDISI
      CTR = CTR + 1.
    ENDLOOP.
    IF CTR > 1.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF CTR > 1.
    MESSAGE 'Ada beberapa material dengan deskripsi yang sama!' TYPE 'W'.
    LEAVE TO TRANSACTION SY-TCODE.
  ENDIF.

  CLEAR CTR.
  LOOP AT IT_MATERIAL.
    CLEAR CTR.
    LOOP AT IT_MATERIAL WHERE MATNR NE IT_MATERIAL-MGV_MATERIAL_EXTERNAL.
      CTR = CTR + 1.
      EXIT.
    ENDLOOP.
    IF CTR > 1.
      EXIT.
    ENDIF.
  ENDLOOP.

  IF CTR > 1.
    MESSAGE 'Samakan material dengan nilai externalnya!' TYPE 'W'.
    LEAVE TO TRANSACTION SY-TCODE .
  ENDIF.
ENDFORM.                    " CEK_DDESCRIPTION

