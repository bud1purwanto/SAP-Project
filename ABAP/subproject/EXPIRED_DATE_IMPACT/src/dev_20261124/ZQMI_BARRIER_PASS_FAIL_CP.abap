                                         OR FIELDNAME EQ 'BARRIER_POS'
                                         OR FIELDNAME EQ 'COMB_NO'
                                         OR FIELDNAME EQ 'PACKING'
                                         OR FIELDNAME EQ 'TREATMENT'
                                         OR FIELDNAME EQ 'CORE'
                                         OR FIELDNAME EQ 'GRADE'
                                         OR FIELDNAME EQ 'KATEGORI'
                                         OR FIELDNAME EQ 'CRITERIA'
                                         OR FIELDNAME EQ 'ALIAS'
                                         OR FIELDNAME EQ 'TIPE_LABEL'
                                         OR FIELDNAME EQ 'EXPIRED_DATE'
                                         OR FIELDNAME EQ 'GR_DATE'
                                         OR FIELDNAME EQ 'SPECIAL_TOUCH'
                                         OR FIELDNAME EQ 'VENDOR_BATCH'
                                         OR FIELDNAME EQ 'PRODUCTION_NUM'.

  T_FIELDCAT-JUST = 'R'.
  MODIFY T_FIELDCAT TRANSPORTING JUST WHERE FIELDNAME EQ 'THICKNESS'
                                         OR FIELDNAME EQ 'WIDTH'
                                         OR FIELDNAME EQ 'LENGTH'
                                         OR FIELDNAME EQ 'BL_STOCK_KG'
                                         OR FIELDNAME EQ 'BL_SR'
                                         OR FIELDNAME EQ 'MVTR_R'
                                         OR FIELDNAME EQ 'MVTR_C'
                                         OR FIELDNAME EQ 'MVTR_L'
                                         OR FIELDNAME EQ 'OTR_R'
                                         OR FIELDNAME EQ 'OTR_C'
                                         OR FIELDNAME EQ 'OTR_L'
