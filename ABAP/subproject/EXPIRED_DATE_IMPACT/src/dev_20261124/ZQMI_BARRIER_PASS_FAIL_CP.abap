    'MVTR_L'          ''  ''   '' '10'   'MVTR-L'                '' '' '' '',
    'OTR_R'           ''  ''   '' '10'   'OTR-R'                 '' '' '' '',
    'OTR_C'           ''  ''   '' '10'   'OTR-C'                 '' '' '' '',
    'OTR_L'           ''  ''   '' '10'   'OTR-L'                 '' '' '' ''.
  ENDIF.

  PERFORM F_ALV_FIELDCATG_ICON USING 'ITAB' :
    'COMB_NO'          ''  ''  '' '10'   'Comb. No'           '' '' '' '',
    'PACKING'          ''  ''  '' '10'   'Packing'            '' '' '' '',
