                                         OR FIELDNAME EQ 'MATNR'
                                         OR FIELDNAME EQ 'WERKS'
                                         OR FIELDNAME EQ 'LGORT'
                                         OR FIELDNAME EQ 'CHARG'
                                         OR FIELDNAME EQ 'LGPLA'
                                         OR FIELDNAME EQ 'EXIDV'
                                         OR FIELDNAME EQ 'TYPE'
                                         OR FIELDNAME EQ 'BL_REASON'
                                         OR FIELDNAME EQ 'BL_COMMENT'
                                         OR FIELDNAME EQ 'ROLL_DERV'
                                         OR FIELDNAME EQ 'DERIVITIVE'
