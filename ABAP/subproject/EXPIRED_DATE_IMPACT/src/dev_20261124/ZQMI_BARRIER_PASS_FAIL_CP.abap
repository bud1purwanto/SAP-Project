    'ROLL_DERV'       ''  ''   '' '25'   'No Roll'               '' '' '' '',
    'DERIVITIVE'      ''  ''   '' '6'    'Derivative'            '' '' '' '',
    'POSITION'        ''  ''   '' '6'    'Position'              '' '' '' '',
    'DEVICE'          ''  ''   'X' '10'   'Device'              '' '' '' '',
    'BARRIER_POS'     ''  ''   '' '12'   'Barrier Position'      '' '' '' '',
    'TIMES'           ''  ''   '' '6'    'Times'                 '' '' '' '',
    'BARRIER_R'       ''  ''   '' '13'   'Barrier Result R'      '' '' '' '',
    'BARRIER_C'       ''  ''   '' '13'   'Barrier Result C'      '' '' '' '',
