*&---------------------------------------------------------------------*
*
* REFERENCE : ZMMR_LABELROL_INCL
* CREATED ON 7-11-2016
* NEW LABEL GUDANG GARAM
*----------------------------------------------------------------------*

REPORT ZLABELROL_A132.
TABLES: MCHB.

DATA: V_FORMNAME  TYPE TDSFNAME  VALUE  'ZLABELROL_A132',
       V_FUNCNAME  TYPE RS38L_FNAM.

DATA: V_TAB    TYPE API_VALI OCCURS 0 WITH HEADER LINE.
DATA: CONTROL_PARAMETERS TYPE SSFCTRLOP,
      OUTPUT_OPTIONS TYPE SSFCOMPOP.

DATA: BEGIN OF IT_CHARG OCCURS 0,
  CHARG LIKE MCHB-CHARG,
  MATNR LIKE MCHB-MATNR,
  END OF IT_CHARG.

DATA: V_VBELN LIKE MSKA-VBELN,
       V_POSNR LIKE MSKA-POSNR,
       V_SONUM_ITEM(17),
       V_DERIVATIVEMS LIKE API_VALI-ATWTB,
       V_POSITIONMS LIKE API_VALI-ATWTB,
       V_DERIVATIVESS LIKE API_VALI-ATWTB,
       V_POSITIONSS LIKE API_VALI-ATWTB,
       V_GRADE LIKE API_VALI-ATWRT,
       VBARCTEXTTRIAS(30),
       VBARCODETRIAS(20),
       VTYPE(10),
       VCORE(20),
       VROLL(50),
       VNWEIGHT(10),
       VTHICK(20),
       VINSIDE(20),
       VOUTSIDE(20),
       V_LIVE TYPE P,
       V_POSTDATE TYPE MKPF-BUDAT,
       V_EXPDATE TYPE MKPF-BUDAT,
       VUSED(10),
       VWIDTH(10),
       VLENGTH(10),
       VPOINT(5) TYPE C,
       VPARTNO TYPE VBAP-KDMAT,
       VJOINT TYPE C.

DATA: ITAB LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE,
      ITAB2 LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE.

DATA: V_COPY TYPE P,
      V_CHARG LIKE MCHA-CHARG,
      V_ROW TYPE P.

CLEAR: VTYPE,VWIDTH,VLENGTH,VNWEIGHT,VROLL,VCORE,VTHICK,VUSED,VINSIDE,VOUTSIDE,
      VBARCTEXTTRIAS,VBARCODETRIAS,V_SONUM_ITEM,VPARTNO, VJOINT.

SELECT-OPTIONS: P_CHARG FOR MCHB-CHARG NO-DISPLAY.
PARAMETER: V_MATNR LIKE MCHB-MATNR NO-DISPLAY,
           V_COPIES(3) NO-DISPLAY.

SELECT CHARG MATNR INTO TABLE IT_CHARG FROM MCH1
  WHERE CHARG IN P_CHARG.
DELETE ADJACENT DUPLICATES FROM IT_CHARG COMPARING CHARG.


LOOP AT IT_CHARG.
  CLEAR: VTYPE,VWIDTH,VLENGTH,VNWEIGHT,VROLL,VCORE,VTHICK,VUSED,VINSIDE,VOUTSIDE,VBARCTEXTTRIAS,VBARCODETRIAS,V_SONUM_ITEM,VPARTNO,VJOINT.

  IF IT_CHARG-CHARG IS NOT INITIAL AND IT_CHARG-MATNR IS NOT INITIAL.
    REFRESH V_TAB.
    CLEAR V_TAB.
    CALL FUNCTION 'QC01_BATCH_VALUES_READ'
      EXPORTING
        I_VAL_MATNR    = IT_CHARG-MATNR
        I_VAL_CHARGE   = IT_CHARG-CHARG
      TABLES
        T_VAL_TAB      = V_TAB
      EXCEPTIONS
        NO_CLASS       = 1
        INTERNAL_ERROR = 2
        NO_VALUES      = 3
        NO_CHARS       = 4
        OTHERS         = 5.
  ENDIF.

  CLEAR V_TAB-ATWRT.
  READ TABLE V_TAB WITH KEY ATNAM = 'ZZLABEL'.
  IF V_TAB-ATWRT NE 'A132'.
    CONTINUE.
  ENDIF.

  SELECT SINGLE VBELN POSNR INTO (V_VBELN, V_POSNR) FROM MSKA
  WHERE MATNR = IT_CHARG-MATNR AND CHARG = IT_CHARG-CHARG AND ( KALAB > 0 OR KAINS > 0 OR KASPE > 0 ).

  IF SY-SUBRC = 0.
    SELECT SINGLE KDMAT INTO VPARTNO FROM VBAP WHERE VBELN = V_VBELN AND POSNR = V_POSNR.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = V_VBELN
      IMPORTING
        OUTPUT = V_VBELN.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = V_POSNR
      IMPORTING
        OUTPUT = V_POSNR.

    CONCATENATE V_VBELN V_POSNR INTO V_SONUM_ITEM SEPARATED BY '/'.
  ENDIF.

  V_DERIVATIVEMS = '00'.
  V_POSITIONMS = '00'.
  V_DERIVATIVESS = '00'.
  V_POSITIONSS = '00'.

  LOOP AT V_TAB.
    IF V_TAB-ATNAM = 'ZZDERIVATIVEMS'.
      V_DERIVATIVEMS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZPOSITIONMS'.
      V_POSITIONMS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZDERIVATIVESS'.
      V_DERIVATIVESS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZPOSITIONSS'.
      V_POSITIONSS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZGRADE'.
      V_GRADE = V_TAB-ATWRT.

    ELSEIF V_TAB-ATNAM = 'ZZCODE'.
      VTYPE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZALIAS'.
      VTYPE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZWIDTH'.
      VWIDTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZLENGTH'.
      VLENGTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZCORE'.
      CONCATENATE V_TAB-ATWRT '"' INTO VCORE.
    ELSEIF V_TAB-ATNAM = 'ZZTHICKNESS'.
      VTHICK = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZNOMORROLL'.
      VROLL = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZCONVERSIONROLLKG'.
      WRITE V_TAB-ATFLV TO VNWEIGHT EXPONENT 0 DECIMALS 2.
      CONDENSE VNWEIGHT.
    ELSEIF V_TAB-ATNAM = 'ZZINSIDE'.
      VINSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZOUTSIDE'.
      VOUTSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZSPLICE-1'.
      VJOINT = 'Y'.
    ELSEIF V_TAB-ATNAM = 'ZZEXPIREDLIVE'.
      V_LIVE = V_TAB-ATWTB.
    ENDIF.
  ENDLOOP.

  CONCATENATE IT_CHARG-CHARG V_DERIVATIVEMS V_POSITIONMS V_DERIVATIVESS  V_POSITIONSS INTO VBARCODETRIAS.

  CALL FUNCTION 'CONVERSION_EXIT_BAS36_OUTPUT'
    EXPORTING
      INPUT          = VBARCODETRIAS
    IMPORTING
      OUTPUT         = VBARCODETRIAS
    EXCEPTIONS
      INVALID_FORMAT = 1
      OTHERS         = 2.

  CONCATENATE IT_CHARG-CHARG '-' VBARCODETRIAS INTO VBARCTEXTTRIAS.

  IF V_LIVE NE ''.
    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
      EXPORTING
        MATNR = IT_CHARG-MATNR
        CHARG = IT_CHARG-CHARG
      IMPORTING
        PDATE = V_POSTDATE.

    IF SY-SUBRC = 0.
      V_EXPDATE = V_POSTDATE + V_LIVE.
      CONCATENATE V_EXPDATE+0(4) '.' V_EXPDATE+4(2) INTO VUSED.
    ENDIF.
  ENDIF.

  ITAB-VVBELN        = V_VBELN .
  ITAB-VPOSNR        = V_POSNR .
  ITAB-VSONUM_ITEM   = V_SONUM_ITEM.
  ITAB-VDERIVATIVEMS = V_DERIVATIVEMS .
  ITAB-VPOSITIONMS   = V_POSITIONMS .
  ITAB-VDERIVATIVESS = V_DERIVATIVESS .
  ITAB-VPOSITIONSS   = V_POSITIONSS .
  ITAB-VGRADE        = V_GRADE .
  ITAB-VBARCTEXTTRIAS = VBARCTEXTTRIAS.
  ITAB-VBARCODETRIAS  = VBARCODETRIAS.
  ITAB-VTYPE          = VTYPE.
  ITAB-VCORE          = VCORE.
  ITAB-VROLL          = VROLL.
  ITAB-VNWEIGHT       = VNWEIGHT.
  ITAB-VTHICK         = VTHICK.
  ITAB-VINSIDE        = VINSIDE.
  ITAB-VOUTSIDE       = VOUTSIDE.
  ITAB-VLIVE         = V_LIVE .
  ITAB-VPOSTDATE     = V_POSTDATE .
  ITAB-VEXPDATE      = V_EXPDATE  .
  ITAB-VUSED          = VUSED.
  ITAB-VWIDTH         = VWIDTH.
  ITAB-VLENGTH        = VLENGTH.
  ITAB-VPOINT         = VPOINT.
  ITAB-VPARTNO        = VPARTNO .
  ITAB-VJOINT         = VJOINT .
  ITAB-VBATCH         = IT_CHARG-CHARG.

  APPEND ITAB.
  CLEAR ITAB.

ENDLOOP.

PERFORM PRINT_DATA.



*&---------------------------------------------------------------------*
*&      Form  print_data
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM PRINT_DATA.

  ITAB2[] = ITAB[].
  CLEAR: ITAB.
  REFRESH: ITAB.

  LOOP AT ITAB2 INTO ITAB.
    DO V_COPIES TIMES.
      APPEND ITAB.
    ENDDO.
    CLEAR: ITAB.
  ENDLOOP.

  SORT ITAB BY VBATCH.

  DESCRIBE TABLE ITAB LINES V_ROW.

  DATA: GV_DEVTYPE    TYPE RSPOPTYPE.

  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      FORMNAME           = V_FORMNAME
    IMPORTING
      FM_NAME            = V_FUNCNAME
    EXCEPTIONS
      NO_FORM            = 1
      NO_FUNCTION_MODULE = 2
      OTHERS             = 3.

  V_COPY = V_COPIES.
  IF V_COPY LE 0.
    CONTROL_PARAMETERS-NO_DIALOG = ''.
  ELSE.
    CONTROL_PARAMETERS-NO_DIALOG = 'X'.
*    CONTROL_PARAMETERS-PREVIEW = 'X'.
*    OUTPUT_OPTIONS-TDCOPIES = V_COPY.

  ENDIF.

  CALL FUNCTION V_FUNCNAME
    EXPORTING
      CONTROL_PARAMETERS = CONTROL_PARAMETERS
      OUTPUT_OPTIONS     = OUTPUT_OPTIONS
      V_ROW              = V_ROW
      V_COPY             = V_COPY
    TABLES
      ITAB               = ITAB.

ENDFORM.                    "print_data