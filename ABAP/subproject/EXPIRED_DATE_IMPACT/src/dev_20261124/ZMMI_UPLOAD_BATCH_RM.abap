*&---------------------------------------------------------------------*
*& Report  ZMMI_UPLOAD_BATCH_RM
*&
*&---------------------------------------------------------------------*
*&
*&
*&---------------------------------------------------------------------*

REPORT  ZMMI_UPLOAD_BATCH_RM.
DATA: BDC_DATA LIKE BDCDATA OCCURS 1000 WITH HEADER LINE.
DATA: CHARG TYPE CHARG_D,
      WERKS TYPE WERKS_D,
      MATNR TYPE MARA-MATNR,
      ZID TYPE C LENGTH 32.

TYPES :
  BEGIN OF ST_FORMSG,
    MSGID  LIKE SY-MSGID,
    MSGTY  LIKE SY-MSGTY,
    MSGNO  LIKE SY-MSGNO,
    MSGV1  LIKE SY-MSGV1,
    MSGV2  LIKE SY-MSGV2,
    MSGV3  LIKE SY-MSGV3,
    MSGV4  LIKE SY-MSGV4,
    LINENO TYPE MESG-ZEILE,
  END OF ST_FORMSG.

DATA : TA_MESSAGE TYPE TABLE OF ST_FORMSG,
       WA_MESSAGE TYPE ST_FORMSG.


DEFINE BDC_DYNPRO.
  CLEAR &1.
  &1-PROGRAM = &2.
  &1-DYNPRO = &3.
  &1-DYNBEGIN = 'X'.
  APPEND &1.
END-OF-DEFINITION.

DEFINE BDC_FIELD.
  CLEAR &1.
  &1-FNAM = &2.
  &1-FVAL = &3.
  APPEND &1.
END-OF-DEFINITION.

DATA : TMP_I TYPE I,
       TMP_J TYPE I.

DATA: L_TA_MSG TYPE STANDARD TABLE OF BDCMSGCOLL,
      L_WA_MSG TYPE BDCMSGCOLL.

DATA : BEGIN OF IT_MM OCCURS 0,
  A_001(18), "Material Number
  B_002(10), "Batch
  C_003(4),  "Plant
  D_004(10), "Vendor
  E_005(10), "Production Date
  F_006(10),  "SLED
 END OF IT_MM.

DATA : NUM1 TYPE STRING,
       NUM2 TYPE P,
       VTEXT(22),
       FNAME TYPE STRING.

SELECTION-SCREEN BEGIN OF BLOCK B1000 WITH FRAME.
PARAMETERS: P_FILE   TYPE LOCALFILE OBLIGATORY.
SELECTION-SCREEN END OF BLOCK B1000.

SELECTION-SCREEN BEGIN OF BLOCK B1001 WITH FRAME.
PARAMETERS: CTUMODE LIKE CTU_PARAMS-DISMODE DEFAULT 'N'.
SELECTION-SCREEN END OF BLOCK B1001.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR P_FILE.
  PERFORM F4_OPEN_FILE.

START-OF-SELECTION.
  CLEAR : IT_MM.
  CLEAR : NUM1.
  REFRESH :IT_MM.

  MOVE P_FILE TO FNAME.
  CALL FUNCTION 'GUI_UPLOAD'
    EXPORTING
      FILENAME            = FNAME
      FILETYPE            = 'ASC'
      HAS_FIELD_SEPARATOR = 'X'
    TABLES
      DATA_TAB            = IT_MM.
  IF SY-SUBRC <> 0.
    MESSAGE W000(0K) WITH 'Upload Error'.
  ENDIF.

  NUM1 = 0.
  LOOP AT IT_MM.
    NUM1 = NUM1 + 1.
    NUM2 = NUM1.
    CLEAR : L_TA_MSG, L_WA_MSG.
    REFRESH : L_TA_MSG.
    REFRESH BDC_DATA[].
    CONCATENATE IT_MM-A_001 IT_MM-C_003 INTO VTEXT SEPARATED BY '-'.
    SET PARAMETER ID 'ZBAP1' FIELD VTEXT.
    BDC_DYNPRO BDC_DATA 'SAPMM03S' '0105'.
    BDC_FIELD BDC_DATA  'BDC_OKCODE'  '/00'.
    BDC_FIELD BDC_DATA  'RM03S-MATNR'  IT_MM-A_001.
    BDC_FIELD BDC_DATA  'RM03S-CHARG'  IT_MM-B_002.
    BDC_FIELD BDC_DATA  'RM03S-WERKS'  IT_MM-C_003.
    BDC_FIELD BDC_DATA  'RM03S-LGORT'  ' '.

    BDC_DYNPRO BDC_DATA 'SAPMM03S' '0200'.
    BDC_FIELD BDC_DATA  'BDC_OKCODE'  '=BU'.
    BDC_FIELD BDC_DATA  'MCHA-LIFNR'  IT_MM-D_004.
    BDC_FIELD BDC_DATA  'MCHA-HSDAT'  IT_MM-E_005.
    BDC_FIELD BDC_DATA  'MCHA-VFDAT'  IT_MM-F_006.

    CALL TRANSACTION 'MSC1' USING BDC_DATA MODE CTUMODE MESSAGES INTO L_TA_MSG.
    COMMIT WORK AND WAIT.

    GET PARAMETER ID 'ZBAP2' FIELD ZID.
    SPLIT ZID AT '-' INTO CHARG MATNR WERKS.

    LOOP AT L_TA_MSG INTO L_WA_MSG WHERE MSGID = 'M3' AND MSGNR = '600'..
      TMP_I = SY-TABIX.
      WA_MESSAGE-MSGID = 'ZMM'.
      WA_MESSAGE-MSGTY = 'S'.
      WA_MESSAGE-MSGNO = '018'.
      WA_MESSAGE-MSGV1 = 'Line'.
      WA_MESSAGE-MSGV2 = NUM1.
      WA_MESSAGE-MSGV3 = 'membentuk Batch'.
      WA_MESSAGE-MSGV4 = IT_MM-B_002.
      WA_MESSAGE-LINENO = NUM2.
      APPEND WA_MESSAGE TO TA_MESSAGE.
    ENDLOOP.
    IF SY-SUBRC NE 0.
      WA_MESSAGE-MSGID = 'ZMM'.
      WA_MESSAGE-MSGTY = 'E'.
      WA_MESSAGE-MSGNO = '018'.
      WA_MESSAGE-MSGV1 = 'Line'.
      WA_MESSAGE-MSGV2 = NUM1.
      WA_MESSAGE-MSGV3 = 'gagal'.
      WA_MESSAGE-MSGV4 = 'membentuk Batch'.
      WA_MESSAGE-LINENO = NUM2.
      APPEND WA_MESSAGE TO TA_MESSAGE.
    ENDIF.
  ENDLOOP.

  SORT TA_MESSAGE BY LINENO ASCENDING.
  CALL FUNCTION 'C14Z_MESSAGES_SHOW_AS_POPUP'
    TABLES
      I_MESSAGE_TAB = TA_MESSAGE.
*&---------------------------------------------------------------------*
*&      Form  F4_OPEN_FILE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM F4_OPEN_FILE .
  CALL FUNCTION 'F4_FILENAME'
    EXPORTING
      PROGRAM_NAME  = SY-CPROG
      DYNPRO_NUMBER = SY-DYNNR
      FIELD_NAME    = ' '
    IMPORTING
      FILE_NAME     = P_FILE.
  IF SY-SUBRC <> 0 OR P_FILE EQ ''.
    LEAVE PROGRAM.
  ENDIF.
ENDFORM.                    " F4_OPEN_FILE