* TESTING PROGRAM

REPORT  ZLABELROL_TES.

TABLES: MCHB.

DATA: V_FORMNAME  TYPE TDSFNAME  VALUE  'ZLABELROL_A132',
       V_FUNCNAME  TYPE RS38L_FNAM.

DATA: V_TAB    TYPE API_VALI OCCURS 0 WITH HEADER LINE.
DATA: CONTROL_PARAMETERS TYPE SSFCTRLOP,
      OUTPUT_OPTIONS TYPE SSFCOMPOP.

DATA: V_VBELN LIKE MSKA-VBELN,
       V_POSNR LIKE MSKA-POSNR,
       V_SONUM_ITEM(17),
       V_DERIVATIVEMS LIKE API_VALI-ATWTB,
       V_POSITIONMS LIKE API_VALI-ATWTB,
       V_DERIVATIVESS LIKE API_VALI-ATWTB,
       V_POSITIONSS LIKE API_VALI-ATWTB,
       V_GRADE LIKE API_VALI-ATWRT,
       VBARCTEXTTRIAS(30),
       VBARCODETRIAS(20),
       VTYPE(10),
       VCORE(20),
       VROLL(50),
       VNWEIGHT(10),
       VTHICK(20),
       VINSIDE(20),
       VOUTSIDE(20),
       V_LIVE TYPE P,
       V_POSTDATE TYPE MKPF-BUDAT,
       V_EXPDATE TYPE MKPF-BUDAT,
       VUSED(10),
       VWIDTH(10),
       VLENGTH(10),
       VPOINT(5) TYPE C,
       VPARTNO TYPE VBAP-KDMAT,
       VJOINT TYPE C.
DATA: V_COPY TYPE P.

CLEAR: VTYPE,VWIDTH,VLENGTH,VNWEIGHT,VROLL,VCORE,VTHICK,VUSED,VINSIDE,VOUTSIDE,
      VBARCTEXTTRIAS,VBARCODETRIAS,V_SONUM_ITEM,VPARTNO, VJOINT. "VBARCTEXTCUST,VBARCODECUST.

PARAMETER: V_CHARG LIKE MCHB-CHARG NO-DISPLAY,
           V_MATNR LIKE MCHB-MATNR NO-DISPLAY.
PARAMETER: V_COPIES(3) NO-DISPLAY.

*RANGES: V_CHARG FOR MCHB-CHARG,
*        V_MATNR FOR MCHB-MATNR.

SELECT-OPTIONS : S_CHARG FOR MCHB-CHARG,
                S_MATNR FOR MCHB-MATNR.

LOOP AT S_CHARG.

  SELECT SINGLE MATNR CHARG INTO (V_CHARG, V_MATNR) FROM MCHA
  WHERE CHARG = S_CHARG-LOW.


  IF V_CHARG IS NOT INITIAL AND V_MATNR IS NOT INITIAL.
    REFRESH V_TAB.
    CLEAR V_TAB.
    CALL FUNCTION 'QC01_BATCH_VALUES_READ'
      EXPORTING
        I_VAL_MATNR    = V_MATNR
        I_VAL_CHARGE   = V_CHARG
      TABLES
        T_VAL_TAB      = V_TAB
      EXCEPTIONS
        NO_CLASS       = 1
        INTERNAL_ERROR = 2
        NO_VALUES      = 3
        NO_CHARS       = 4
        OTHERS         = 5.
  ENDIF.

  SELECT SINGLE VBELN POSNR INTO (V_VBELN, V_POSNR) FROM MSKA
  WHERE MATNR = V_MATNR AND CHARG = V_CHARG AND ( KALAB > 0 OR KAINS > 0 OR KASPE > 0 ).

  IF SY-SUBRC = 0.
    SELECT SINGLE KDMAT INTO VPARTNO FROM VBAP WHERE VBELN = V_VBELN AND POSNR = V_POSNR.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = V_VBELN
      IMPORTING
        OUTPUT = V_VBELN.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = V_POSNR
      IMPORTING
        OUTPUT = V_POSNR.

    CONCATENATE V_VBELN V_POSNR INTO V_SONUM_ITEM SEPARATED BY '/'.
  ENDIF.

  V_DERIVATIVEMS = '00'.
  V_POSITIONMS = '00'.
  V_DERIVATIVESS = '00'.
  V_POSITIONSS = '00'.

  LOOP AT V_TAB.
    IF V_TAB-ATNAM = 'ZZDERIVATIVEMS'.
      V_DERIVATIVEMS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZPOSITIONMS'.
      V_POSITIONMS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZDERIVATIVESS'.
      V_DERIVATIVESS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZPOSITIONSS'.
      V_POSITIONSS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZGRADE'.
      V_GRADE = V_TAB-ATWRT.

    ELSEIF V_TAB-ATNAM = 'ZZCODE'.
      VTYPE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZALIAS'.
      VTYPE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZWIDTH'.
      VWIDTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZLENGTH'.
      VLENGTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZCORE'.
      CONCATENATE V_TAB-ATWRT '"' INTO VCORE.
    ELSEIF V_TAB-ATNAM = 'ZZTHICKNESS'.
      VTHICK = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZNOMORROLL'.
      VROLL = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZCONVERSIONROLLKG'.
      WRITE V_TAB-ATFLV TO VNWEIGHT EXPONENT 0 DECIMALS 2.
      CONDENSE VNWEIGHT.
    ELSEIF V_TAB-ATNAM = 'ZZINSIDE'.
      VINSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZOUTSIDE'.
      VOUTSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZSPLICE-1'.
      VJOINT = 'Y'.
    ELSEIF V_TAB-ATNAM = 'ZZEXPIREDLIVE'.
      V_LIVE = V_TAB-ATWTB.
    ENDIF.
  ENDLOOP.

  CONCATENATE V_CHARG V_DERIVATIVEMS V_POSITIONMS V_DERIVATIVESS  V_POSITIONSS INTO VBARCODETRIAS.

  CALL FUNCTION 'CONVERSION_EXIT_BAS36_OUTPUT'
    EXPORTING
      INPUT          = VBARCODETRIAS
    IMPORTING
      OUTPUT         = VBARCODETRIAS
    EXCEPTIONS
      INVALID_FORMAT = 1
      OTHERS         = 2.

  CONCATENATE V_CHARG '-' VBARCODETRIAS INTO VBARCTEXTTRIAS.

  IF V_LIVE NE ''.
    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
      EXPORTING
        MATNR = V_MATNR
        CHARG = V_CHARG
      IMPORTING
        PDATE = V_POSTDATE.

    IF SY-SUBRC = 0.
      V_EXPDATE = V_POSTDATE + V_LIVE.
      CONCATENATE V_EXPDATE+0(4) '.' V_EXPDATE+4(2) INTO VUSED.
    ENDIF.
  ENDIF.


  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      FORMNAME           = V_FORMNAME
    IMPORTING
      FM_NAME            = V_FUNCNAME
    EXCEPTIONS
      NO_FORM            = 1
      NO_FUNCTION_MODULE = 2
      OTHERS             = 3.

  V_COPY = V_COPIES.
  IF V_COPY LE 0.
    CONTROL_PARAMETERS-NO_DIALOG = ''.
  ELSE.
    CONTROL_PARAMETERS-NO_DIALOG = 'X'.
*  CONTROL_PARAMETERS-PREVIEW = 'X'.
    OUTPUT_OPTIONS-TDCOPIES = V_COPY.

  ENDIF.

  CALL FUNCTION V_FUNCNAME
    EXPORTING
      V_TYPE             = VTYPE
      V_WIDTH            = VWIDTH
      V_LENGTH           = VLENGTH
      V_NWEIGHT          = VNWEIGHT
      V_ROLL             = VROLL
      V_CORE             = VCORE
      V_THICK            = VTHICK
      V_USED             = VUSED
      V_INSIDE           = VINSIDE
      V_OUTSIDE          = VOUTSIDE
      V_BARCTEXTTRIAS    = VBARCTEXTTRIAS
      V_BARCODETRIAS     = VBARCODETRIAS
      V_SONUM            = V_SONUM_ITEM
      V_VPARTNO          = VPARTNO
      CONTROL_PARAMETERS = CONTROL_PARAMETERS
      OUTPUT_OPTIONS     = OUTPUT_OPTIONS.
*  TABLES
*    T_MSEG               = I_MSEG
  .

ENDLOOP.