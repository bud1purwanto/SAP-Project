REPORT ZLABELROL_A139.

TABLES: MCHA, MARA, MCHB.

DATA : V_FORMNAME  TYPE TDSFNAME  VALUE 'ZLABELROL_A139',
       V_FUNCNAME  TYPE RS38L_FNAM,
       CRKMNG(10)  TYPE C,
       V_TAB    TYPE API_VALI OCCURS 0 WITH HEADER LINE,
       CONTROL_PARAMETERS TYPE SSFCTRLOP,
       OUTPUT_OPTIONS TYPE SSFCOMPOP,
       V_COPY TYPE P,
       V_CHARG LIKE MCHA-CHARG,
       V_ROW TYPE P,
       V_SPLIT(10).

DATA: ITAB LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE,
      ITAB2 LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE.

DATA: BEGIN OF IT_CHARG OCCURS 0,
        CHARG LIKE MCHB-CHARG,
        MATNR LIKE MCHB-MATNR,
      END OF IT_CHARG.


DATA: V_VBELN LIKE MSKA-VBELN,
       V_POSNR LIKE MSKA-POSNR,
       V_SONUM_ITEM(17),
       V_DERIVATIVEMS LIKE API_VALI-ATWTB,
       V_POSITIONMS LIKE API_VALI-ATWTB,
       V_DERIVATIVESS LIKE API_VALI-ATWTB,
       V_POSITIONSS LIKE API_VALI-ATWTB,
       V_GRADE LIKE API_VALI-ATWRT,
       VBARCTEXTTRIAS(40),
       VBARCTEXTCUST(40),
       VBARCODETRIAS(40),
       VBARCODECUST(40),
       VTYPE(10),
       VCORE(20),
       VROLL(50),
       VNWEIGHT(10),
       VTHICK(20),
       VINSIDE(20),
       VOUTSIDE(20),
       V_LIVE TYPE P,
       V_POSTDATE TYPE MKPF-BUDAT,
       V_EXPDATE TYPE MKPF-BUDAT,
       VUSED(10),
       VWIDTH(10),
       VLENGTH(10),
       VPOINT(5) TYPE C,
       V_ATNROL LIKE CABN-ATINN,
       LEN TYPE I.

DATA: IT_DETAIL_KTNG LIKE ZDETAIL_KTNG OCCURS 0 WITH HEADER LINE,
      WA_DETAIL_KTNG LIKE ZDETAIL_KTNG OCCURS 0 WITH HEADER LINE,
      IT_MASTER_KTNG LIKE ZMASTER_KTNG OCCURS 0 WITH HEADER LINE,
      IT_MASTER_KTNG2 LIKE ZMASTER_KTNG OCCURS 0 WITH HEADER LINE,
      IT_CHAR LIKE CONF_OUT OCCURS 0 WITH HEADER LINE,
      ZCUOBJ LIKE VBAP-CUOBJ,
      V_VBELN_NEW LIKE MSKA-VBELN,
      V_POSNR_NEW LIKE MSKA-POSNR,
      ZROLCHAR TYPE ATWTB,
      ZSATUAN(5) TYPE C,
      VPOSISI(10),
      VMAINX TYPE I,
      VCOUNT TYPE F,
      VNEXT_VALUE(10),
      V_CODERESOURCE(1),
      VMAXNO(3),
      VJRMAX(3),
      VMIDROLL(1),
      VTS(1),
      VPS(2),
      VERDAT LIKE VBAK-ERDAT,
      VERDAT2(10),
      V_MESSAGE(50),
      V_COUNT TYPE I.

CLEAR: VTYPE,VWIDTH,VLENGTH,VNWEIGHT,VROLL,VCORE,VTHICK,VUSED,VBARCTEXTTRIAS,VBARCODETRIAS,VBARCTEXTCUST,
        VBARCODECUST,V_SONUM_ITEM, IT_CHARG.
REFRESH: IT_CHARG.

SELECT-OPTIONS: P_CHARG FOR MCHB-CHARG NO-DISPLAY.
PARAMETER: V_MATNR LIKE MCHB-MATNR NO-DISPLAY,
           V_COPIES(3) DEFAULT 1 NO-DISPLAY.

SELECT CHARG MATNR INTO TABLE IT_CHARG FROM MCH1
  WHERE CHARG IN P_CHARG.
DELETE ADJACENT DUPLICATES FROM IT_CHARG COMPARING CHARG.

SELECT SINGLE ATINN INTO V_ATNROL FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.

LOOP AT IT_CHARG.

  CLEAR: VTYPE,VWIDTH,VLENGTH,VNWEIGHT,VROLL,VCORE,VTHICK,VUSED,VBARCTEXTTRIAS,VBARCODETRIAS,VBARCTEXTCUST,
          VBARCODECUST,V_SONUM_ITEM, V_TAB, V_VBELN_NEW, V_POSNR_NEW, V_VBELN, V_POSNR.
  REFRESH: V_TAB.

  IF IT_CHARG-CHARG IS NOT INITIAL AND IT_CHARG-MATNR IS NOT INITIAL.
    REFRESH V_TAB.
    CLEAR V_TAB.
    CALL FUNCTION 'QC01_BATCH_VALUES_READ'
      EXPORTING
        I_VAL_MATNR    = IT_CHARG-MATNR
        I_VAL_CHARGE   = IT_CHARG-CHARG
      TABLES
        T_VAL_TAB      = V_TAB
      EXCEPTIONS
        NO_CLASS       = 1
        INTERNAL_ERROR = 2
        NO_VALUES      = 3
        NO_CHARS       = 4
        OTHERS         = 5.
  ENDIF.

  CLEAR V_TAB-ATWRT.
  READ TABLE V_TAB WITH KEY ATNAM = 'ZZLABEL'.
  IF V_TAB-ATWRT NE 'A139'.
    CONTINUE.
  ENDIF.

  READ TABLE V_TAB WITH KEY ATNAM = 'ZZCRITERIA'.
  IF V_TAB-ATWRT NE '1'.
    CLEAR: V_MESSAGE.
    CONCATENATE 'Grade Batch' IT_CHARG-CHARG 'Bukan First Grade' INTO V_MESSAGE SEPARATED BY SPACE.
    MESSAGE V_MESSAGE TYPE 'I'.
    CONTINUE.
  ENDIF.

  SELECT SINGLE VBELN POSNR INTO (V_VBELN, V_POSNR) FROM MSKA
  WHERE MATNR = IT_CHARG-MATNR AND CHARG = IT_CHARG-CHARG AND ( KALAB > 0 OR KAINS > 0 OR KASPE > 0 ).

  IF SY-SUBRC = 0.
    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = V_VBELN
      IMPORTING
        OUTPUT = V_VBELN_NEW.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = V_POSNR
      IMPORTING
        OUTPUT = V_POSNR_NEW.

    CONCATENATE V_VBELN_NEW V_POSNR_NEW INTO V_SONUM_ITEM SEPARATED BY '/'.
  ENDIF.

  V_DERIVATIVEMS = '00'.
  V_POSITIONMS = '00'.
  V_DERIVATIVESS = '00'.
  V_POSITIONSS = '00'.

  LOOP AT V_TAB.
    IF V_TAB-ATNAM = 'ZZDERIVATIVEMS'.
      V_DERIVATIVEMS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZPOSITIONMS'.
      V_POSITIONMS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZDERIVATIVESS'.
      V_DERIVATIVESS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZPOSITIONSS'.
      V_POSITIONSS = V_TAB-ATWRT.
    ELSEIF V_TAB-ATNAM = 'ZZGRADE'.
      V_GRADE = V_TAB-ATWRT.

    ELSEIF V_TAB-ATNAM = 'ZZTYPE'.
      VTYPE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZALIAS'.
      SPLIT V_TAB-ATWTB AT '-' INTO VTYPE V_SPLIT.
    ELSEIF V_TAB-ATNAM = 'ZZWIDTH'.
      VWIDTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZLENGTH'.
      VLENGTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZCORE'.
      CONCATENATE V_TAB-ATWRT '"' INTO VCORE.
    ELSEIF V_TAB-ATNAM = 'ZZTHICKNESS'.
      VTHICK = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZNOMORROLL'.
      VROLL = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZCONVERSIONROLLKG'.
      WRITE V_TAB-ATFLV TO VNWEIGHT EXPONENT 0 DECIMALS 2.
      CONDENSE VNWEIGHT.
    ELSEIF V_TAB-ATNAM = 'ZZINSIDE'.
      VINSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZOUTSIDE'.
      VOUTSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZEXPIREDLIVE'.
      V_LIVE = V_TAB-ATWTB.
    ENDIF.
  ENDLOOP.

  CONCATENATE IT_CHARG-CHARG V_DERIVATIVEMS V_POSITIONMS V_DERIVATIVESS V_POSITIONSS INTO VBARCODETRIAS.

  CALL FUNCTION 'CONVERSION_EXIT_BAS36_OUTPUT'
    EXPORTING
      INPUT          = VBARCODETRIAS
    IMPORTING
      OUTPUT         = VBARCODETRIAS
    EXCEPTIONS
      INVALID_FORMAT = 1
      OTHERS         = 2.

  CONCATENATE IT_CHARG-CHARG '-' VBARCODETRIAS INTO VBARCTEXTTRIAS.

  "Get manufacturing date
  CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
    EXPORTING
      MATNR = IT_CHARG-MATNR
      CHARG = IT_CHARG-CHARG
    IMPORTING
      PDATE = V_POSTDATE.

  CONCATENATE V_POSTDATE+0(4) '.' V_POSTDATE+4(2) INTO VUSED.

  IF V_SONUM_ITEM NE ''.
    PERFORM GET_CUST_BARCODE.
  ENDIF.

  ITAB-VTYPE          = VTYPE .
  ITAB-VWIDTH         = VWIDTH .
  ITAB-VLENGTH        = VLENGTH.
  ITAB-VNWEIGHT       = VNWEIGHT .
  ITAB-VROLL          = VROLL .
  ITAB-VCORE          = VCORE .
  ITAB-VTHICK         = VTHICK.
  ITAB-VUSED          = VUSED .
  ITAB-VBARCTEXTTRIAS = VBARCTEXTTRIAS.
  ITAB-VBARCODETRIAS  = VBARCODETRIAS .
  ITAB-VBARCTEXTCUST  = VBARCTEXTCUST .
  ITAB-VBARCODECUST   = VBARCODECUST .
  ITAB-VSONUM_ITEM    = V_SONUM_ITEM .

  APPEND ITAB.
  CLEAR ITAB.

ENDLOOP.

PERFORM PRINT_DATA.

*&---------------------------------------------------------------------*
*&      Form  PRINT_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM PRINT_DATA.
  IF ITAB[] IS INITIAL.
    EXIT.
  ENDIF.

  ITAB2[] = ITAB[].
  CLEAR: ITAB.
  REFRESH: ITAB.

  LOOP AT ITAB2 INTO ITAB.
    DO V_COPIES TIMES.
      APPEND ITAB.
    ENDDO.
    CLEAR: ITAB.
  ENDLOOP.

  SORT ITAB BY VBATCH.

  DESCRIBE TABLE ITAB LINES V_ROW.

  DATA: GV_DEVTYPE TYPE RSPOPTYPE.

  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      FORMNAME           = V_FORMNAME
    IMPORTING
      FM_NAME            = V_FUNCNAME
    EXCEPTIONS
      NO_FORM            = 1
      NO_FUNCTION_MODULE = 2
      OTHERS             = 3.

  V_COPY = V_COPIES.
  IF V_COPY LE 0.
    CONTROL_PARAMETERS-NO_DIALOG = ''.
  ELSE.
    CONTROL_PARAMETERS-NO_DIALOG = 'X'.
*    CONTROL_PARAMETERS-PREVIEW = 'X'.
*    OUTPUT_OPTIONS-TDCOPIES = V_COPY.
  ENDIF.

  CALL FUNCTION V_FUNCNAME
    EXPORTING
      CONTROL_PARAMETERS = CONTROL_PARAMETERS
      OUTPUT_OPTIONS     = OUTPUT_OPTIONS
      V_ROW              = V_ROW
      V_COPY             = V_COPY
    TABLES
      ITAB               = ITAB.

ENDFORM.                    "PRINT_DATA


*&---------------------------------------------------------------------*
*&      Form  GET_CUST_BARCODE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_CUST_BARCODE.
  DATA: V_AUFNR LIKE MSEG-AUFNR,
        V_MBLNR LIKE MSEG-MBLNR,
        V_SMBLN LIKE MSEG-SMBLN,
        V_JRCHARG LIKE MSEG-CHARG,
        V_JRMATNR LIKE MSEG-MATNR,
        V_COMBI LIKE AFPO-AUFNR,
        V_MIDROLL(2),
        V_RESOURCE LIKE CRHD-ARBPL,
        V_POS TYPE P,
        V_ROLNO LIKE AUSP-ATWRT.

  CLEAR: V_AUFNR,V_MBLNR,V_SMBLN,V_JRCHARG,V_JRMATNR,V_COMBI,V_MIDROLL,V_RESOURCE,
         V_CODERESOURCE,V_POS,V_ROLNO, V_DERIVATIVESS, V_POSITIONSS, V_TAB.

  "-- GET JR
  V_ROLNO = VROLL+0(13).

  SELECT SINGLE MCH1~CHARG MCH1~MATNR INTO (V_JRCHARG, V_JRMATNR)
    FROM AUSP JOIN MCH1 ON AUSP~OBJEK = MCH1~CUOBJ_BM
    WHERE AUSP~ATINN = V_ATNROL AND AUSP~KLART = '023' AND AUSP~ATWRT = V_ROLNO.

  SELECT AUFNR MBLNR INTO (V_AUFNR, V_MBLNR) FROM MSEG WHERE CHARG = IT_CHARG-CHARG AND BWART = '101'.
    SELECT SINGLE SMBLN INTO V_SMBLN FROM MSEG WHERE SMBLN = V_MBLNR. " CEK ADA PEMBATALAN (102) ATAU TIDAK
    IF SY-SUBRC NE 0.
      EXIT.
    ENDIF.
  ENDSELECT.

  IF V_AUFNR = ''.
    EXIT.
  ENDIF.

  SELECT SINGLE AUFNR INTO V_COMBI FROM AFPO WHERE MILL_OC_AUFNR_U = V_AUFNR.
  IF SY-SUBRC NE 0.
    EXIT.
  ENDIF.

  SELECT SINGLE CRHD~ARBPL INTO V_RESOURCE
    FROM AFRU JOIN CRHD ON AFRU~ARBID = CRHD~OBJID WHERE AFRU~AUFNR = V_COMBI.

  IF V_RESOURCE EQ 'PATL04-W'.
    V_CODERESOURCE = 1.
  ELSEIF V_RESOURCE EQ 'PATL05-W'.
    V_CODERESOURCE = 2.
  ELSEIF V_RESOURCE EQ 'PATL06-W'.
    V_CODERESOURCE = 3.
  ELSEIF V_RESOURCE EQ 'PATL07-W'.
    V_CODERESOURCE = 4.
  ELSEIF V_RESOURCE EQ 'PATL08-W'.
    V_CODERESOURCE = 5.
  ELSEIF V_RESOURCE EQ 'PDAHUA-W'.
    V_CODERESOURCE = 6.
  ELSEIF V_RESOURCE EQ 'PPSM-W'.
    V_CODERESOURCE = 8.
  ENDIF.

  "Get Manufacturing Date JR
  IF V_JRCHARG IS NOT INITIAL OR V_JRCHARG NE ''.
    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
      EXPORTING
        MATNR = V_JRMATNR
        CHARG = V_JRCHARG
      IMPORTING
        PDATE = V_POSTDATE.
  ENDIF.
  "-- END GET JR

  PERFORM GET_CODE.

ENDFORM.                    "GET_CUST_BARCODE


*&---------------------------------------------------------------------*
*&      Form  get_code
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_CODE.
  DATA: V_CD1(6), V_CD2 TYPE I, V_CD3 TYPE I.
  CLEAR: V_CD1, V_CD2, V_CD3, V_SPLIT, IT_DETAIL_KTNG, IT_MASTER_KTNG.
  REFRESH: IT_DETAIL_KTNG, IT_MASTER_KTNG.

  DATA: NV_ITEM   LIKE ZNAVIS-ITEM,
       NV_TYPE   LIKE ZNAVIS-TYPE,
       NV_WIDTH  LIKE ZNAVIS-WIDTH,
       NV_LENGTH LIKE ZNAVIS-LENGTH,
       V_MSG_KODE(100).

  READ TABLE V_TAB WITH KEY  ATNAM = 'ZZALIAS'.
  IF SY-SUBRC = 0.
    SPLIT V_TAB-ATWTB AT '-' INTO V_CD1 V_SPLIT.
    CONDENSE V_CD1.
  ELSE.
    READ TABLE V_TAB WITH KEY  ATNAM = 'ZZTYPE'.
    IF SY-SUBRC = 0.
      V_CD1 = V_TAB-ATWTB.
      CONDENSE V_CD1.
    ENDIF.
  ENDIF.

  READ TABLE V_TAB WITH KEY  ATNAM = 'ZZWIDTH'.
  IF SY-SUBRC = 0.
    V_CD2 = V_TAB-ATFLV.
  ENDIF.

  READ TABLE V_TAB WITH KEY  ATNAM = 'ZZLENGTH'.
  IF SY-SUBRC = 0.
    V_CD3 = V_TAB-ATFLV.
  ENDIF.

  NV_TYPE = V_CD1.
  NV_WIDTH = V_CD2.
  NV_LENGTH = V_CD3.

  CONDENSE NV_TYPE.
  CONDENSE NV_WIDTH.
  CONDENSE NV_LENGTH.
  CONDENSE VTHICK.

  "CEK NO BATCH
  SELECT SINGLE * INTO CORRESPONDING FIELDS OF IT_DETAIL_KTNG FROM ZDETAIL_KTNG WHERE BATCH = IT_CHARG-CHARG AND DELETION = ''.
  "KONDISI BATCH SUDAH PERNAH DI PRINT
  IF SY-SUBRC = 0.
    CONDENSE IT_DETAIL_KTNG-KTNGCODE.
    CONDENSE IT_DETAIL_KTNG-COMPANY.
    CONDENSE IT_DETAIL_KTNG-JRDATE.
    CONDENSE IT_DETAIL_KTNG-JRNUMB.
    CONDENSE IT_DETAIL_KTNG-MIDROLL.
    CONDENSE IT_DETAIL_KTNG-SLITT_MCHN.
    CONDENSE IT_DETAIL_KTNG-TS.
    CONDENSE IT_DETAIL_KTNG-PS.

    LEN = STRLEN( WA_DETAIL_KTNG-JRNUMB ) - 3.
    WA_DETAIL_KTNG-JRNUMB = WA_DETAIL_KTNG-JRNUMB+LEN(3).
    LEN = STRLEN( WA_DETAIL_KTNG-TS ) - 1.
    WA_DETAIL_KTNG-TS = WA_DETAIL_KTNG-TS+LEN(1).

    CONCATENATE IT_DETAIL_KTNG-KTNGCODE IT_DETAIL_KTNG-COMPANY IT_DETAIL_KTNG-JRDATE IT_DETAIL_KTNG-JRNUMB IT_DETAIL_KTNG-MIDROLL
    IT_DETAIL_KTNG-SLITT_MCHN  IT_DETAIL_KTNG-TS  IT_DETAIL_KTNG-PS '1' INTO VBARCODECUST.

    CONCATENATE IT_DETAIL_KTNG-KTNGCODE '-' IT_DETAIL_KTNG-COMPANY '-' IT_DETAIL_KTNG-JRDATE '-' IT_DETAIL_KTNG-JRNUMB '-' IT_DETAIL_KTNG-MIDROLL '-'
    IT_DETAIL_KTNG-SLITT_MCHN '-' IT_DETAIL_KTNG-TS '-' IT_DETAIL_KTNG-PS INTO VBARCTEXTCUST.

  ELSE.
    "CEK SO
    CLEAR: IT_DETAIL_KTNG, VJRMAX. REFRESH: IT_DETAIL_KTNG.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL_KTNG FROM ZDETAIL_KTNG WHERE SONUM = V_VBELN AND SOITEM = V_POSNR AND DELETION = ''.

    "KONDISI SALAH SATU BATCH SO SUDAH PERNAH DI PRINT
    IF SY-SUBRC = 0.
      REFRESH: IT_CHAR.
      CLEAR: ZROLCHAR, ZSATUAN, V_COUNT, ZCUOBJ.
      SELECT SINGLE VBAP~CUOBJ INTO ZCUOBJ FROM VBAP WHERE VBAP~VBELN = V_VBELN AND VBAP~POSNR = V_POSNR.

      CALL FUNCTION 'VC_I_GET_CONFIGURATION'
        EXPORTING
          INSTANCE            = ZCUOBJ
        TABLES
          CONFIGURATION       = IT_CHAR
        EXCEPTIONS
          INSTANCE_NOT_FOUND  = 1
          INTERNAL_ERROR      = 2
          NO_CLASS_ALLOCATION = 3
          INSTANCE_NOT_VALID  = 4
          OTHERS              = 5.

      READ TABLE IT_CHAR WITH KEY ATNAM = 'ZZNUMBEROFROLL'.
      SPLIT IT_CHAR-ATWTB AT SPACE INTO ZROLCHAR ZSATUAN.
      REPLACE ALL OCCURRENCES OF ',' IN ZROLCHAR WITH ' '.

      SELECT COUNT(*) INTO V_COUNT FROM ZDETAIL_KTNG
        WHERE SONUM = V_VBELN AND SOITEM = V_POSNR AND DELETION = ''.

      IF V_COUNT = ZROLCHAR.
        CONCATENATE 'Nomor Roll KT&G Untuk SO ' V_VBELN ' - ' V_POSNR ' sudah terpenuhi' INTO V_MESSAGE.
        MESSAGE V_MESSAGE TYPE 'I'.
        LEAVE PROGRAM.
      ENDIF.

      CLEAR: IT_MASTER_KTNG. REFRESH: IT_MASTER_KTNG.
      SELECT SINGLE * INTO CORRESPONDING FIELDS OF IT_MASTER_KTNG FROM ZMASTER_KTNG
         WHERE TYPE = NV_TYPE AND WIDTH = NV_WIDTH AND LENGTH = NV_LENGTH AND THICKNESS = VTHICK.

      IF IT_MASTER_KTNG-ROLL = '24'.
        VPOSISI = '12'.
      ELSEIF IT_MASTER_KTNG-ROLL = '36' OR IT_MASTER_KTNG-ROLL = '63' OR IT_MASTER_KTNG-ROLL = '81'.
        VPOSISI = '09'.
      ENDIF.

      "AMBIL MAX JR NO
      CLEAR: WA_DETAIL_KTNG, VPS.
      SORT IT_DETAIL_KTNG BY VCOUNT DESCENDING.
      READ TABLE IT_DETAIL_KTNG INTO WA_DETAIL_KTNG INDEX 1.

      IF WA_DETAIL_KTNG-PS EQ VPOSISI.
        VPS = '01'.
        WA_DETAIL_KTNG-TS = WA_DETAIL_KTNG-TS + 1.
        CONDENSE WA_DETAIL_KTNG-TS.
        IF WA_DETAIL_KTNG-TS > IT_MASTER_KTNG-MAX_SS.
          WA_DETAIL_KTNG-TS = 1.
          WA_DETAIL_KTNG-MIDROLL = WA_DETAIL_KTNG-MIDROLL + 1.
          CONDENSE WA_DETAIL_KTNG-MIDROLL.
          IF WA_DETAIL_KTNG-MIDROLL > IT_MASTER_KTNG-MAX_MS.
            WA_DETAIL_KTNG-MIDROLL = 1.
            WA_DETAIL_KTNG-JRNUMB = WA_DETAIL_KTNG-JRNUMB + 1.
            CONDENSE WA_DETAIL_KTNG-JRNUMB.
          ENDIF.
        ENDIF.
      ELSE.
        VPS = WA_DETAIL_KTNG-PS + 1.
      ENDIF.

      PERFORM INPUT_FORMAT USING VPS CHANGING VPS.
      PERFORM INPUT_FORMAT USING WA_DETAIL_KTNG-JRNUMB CHANGING VJRMAX.

      SELECT MAX( ID ) INTO WA_DETAIL_KTNG-ID FROM ZDETAIL_KTNG.
      WA_DETAIL_KTNG-ID             = WA_DETAIL_KTNG-ID + 1.
      WA_DETAIL_KTNG-PS             = VPS.
      WA_DETAIL_KTNG-VCOUNT         = WA_DETAIL_KTNG-VCOUNT + 1.
      WA_DETAIL_KTNG-JRNUMB         = VJRMAX.
      WA_DETAIL_KTNG-BATCH          = IT_CHARG-CHARG.
      WA_DETAIL_KTNG-SONUM          = V_VBELN.
      WA_DETAIL_KTNG-SOITEM         = V_POSNR.
      WA_DETAIL_KTNG-TIME           = SY-TIMLO.
      WA_DETAIL_KTNG-COMPANY        = 4.
      PERFORM DATE_FORMAT USING SY-DATUM CHANGING WA_DETAIL_KTNG-CREATE_ON.

      CONDENSE WA_DETAIL_KTNG-COMPANY.
      CONDENSE WA_DETAIL_KTNG-PS.
      CONDENSE WA_DETAIL_KTNG-JRNUMB.
      CONDENSE WA_DETAIL_KTNG-JRDATE.
      CONDENSE WA_DETAIL_KTNG-KTNGCODE.
      CONDENSE WA_DETAIL_KTNG-MIDROLL.
      CONDENSE WA_DETAIL_KTNG-SLITT_MCHN.
      CONDENSE WA_DETAIL_KTNG-TS.

      LEN = STRLEN( WA_DETAIL_KTNG-JRNUMB ) - 3.
      WA_DETAIL_KTNG-JRNUMB = WA_DETAIL_KTNG-JRNUMB+LEN(3).
      LEN = STRLEN( WA_DETAIL_KTNG-TS ) - 1.
      WA_DETAIL_KTNG-TS = WA_DETAIL_KTNG-TS+LEN(1).

      CONCATENATE WA_DETAIL_KTNG-KTNGCODE WA_DETAIL_KTNG-COMPANY WA_DETAIL_KTNG-JRDATE WA_DETAIL_KTNG-JRNUMB WA_DETAIL_KTNG-MIDROLL
      WA_DETAIL_KTNG-SLITT_MCHN WA_DETAIL_KTNG-TS WA_DETAIL_KTNG-PS '1' INTO VBARCODECUST.

      CONCATENATE WA_DETAIL_KTNG-KTNGCODE '-' WA_DETAIL_KTNG-COMPANY '-' WA_DETAIL_KTNG-JRDATE '-' WA_DETAIL_KTNG-JRNUMB '-' WA_DETAIL_KTNG-MIDROLL '-'
      WA_DETAIL_KTNG-SLITT_MCHN '-' WA_DETAIL_KTNG-TS '-' WA_DETAIL_KTNG-PS INTO VBARCTEXTCUST.

      "Update Detail
      MODIFY ZDETAIL_KTNG FROM WA_DETAIL_KTNG.
      IF SY-SUBRC <> 0.
        MESSAGE 'Gagal Update Detail' TYPE 'I'.
        LEAVE PROGRAM.
      ENDIF.
      COMMIT WORK.

      CLEAR: WA_DETAIL_KTNG, IT_DETAIL_KTNG.
      REFRESH: IT_DETAIL_KTNG.

    ELSE.
      "Kondisi  Baru Print dengan SO Baru
      CLEAR: IT_MASTER_KTNG,IT_DETAIL_KTNG, VJRMAX.
      REFRESH: IT_MASTER_KTNG,IT_DETAIL_KTNG.

      "GET NEXT VALUE
      SELECT SINGLE * INTO CORRESPONDING FIELDS OF IT_MASTER_KTNG FROM ZMASTER_KTNG
         WHERE TYPE = NV_TYPE AND WIDTH = NV_WIDTH AND LENGTH = NV_LENGTH AND THICKNESS = VTHICK.

      "Set Current Value
      IF IT_MASTER_KTNG-MS = IT_MASTER_KTNG-MAX_MS.
        "Reset Main Slit
        IT_MASTER_KTNG-MS = '1'.
        "Set JR Code
        IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-NEXT_VALUE + 1.
        CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
        PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-NEXT_VALUE CHANGING IT_MASTER_KTNG-NEXT_VALUE.
        PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING IT_MASTER_KTNG-MAX_VALUE.
        "Reset JR Code
        IF IT_MASTER_KTNG-NEXT_VALUE > IT_MASTER_KTNG-MAX_VALUE.
          IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-MIN_VALUE.
          PERFORM DATE_FORMAT USING SY-DATUM CHANGING IT_MASTER_KTNG-LAST_RESET.
        ENDIF.
      ELSE.
        "Set Main Slit
        IT_MASTER_KTNG-MS = IT_MASTER_KTNG-MS + 1.
      ENDIF.

      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-NEXT_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-NEXT_VALUE = VJRMAX.
      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-MAX_VALUE = VJRMAX.

      "GENERATE BARCODE UNTUK BATCH
      CONDENSE IT_MASTER_KTNG-CODE.
      CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
      CONDENSE IT_MASTER_KTNG-MS.
      CONDENSE V_CODERESOURCE.

      "Menambahakan MS, SS dan PS
      CONCATENATE IT_MASTER_KTNG-CODE '4' V_POSTDATE+2(2) V_POSTDATE+4(2) V_POSTDATE+6(2) IT_MASTER_KTNG-NEXT_VALUE IT_MASTER_KTNG-MS
      V_CODERESOURCE '1' '01' '1' INTO VBARCODECUST.

      CONCATENATE IT_MASTER_KTNG-CODE '-4-' V_POSTDATE+2(2) V_POSTDATE+4(2) V_POSTDATE+6(2) '-' IT_MASTER_KTNG-NEXT_VALUE '-'
      IT_MASTER_KTNG-MS '-' V_CODERESOURCE '-' '1' '-' '01' INTO VBARCTEXTCUST.

      SELECT MAX( ID ) INTO IT_DETAIL_KTNG-ID FROM ZDETAIL_KTNG.
      IT_DETAIL_KTNG-ID             = IT_DETAIL_KTNG-ID + 1.
      IT_DETAIL_KTNG-BATCH          = IT_CHARG-CHARG.
      IT_DETAIL_KTNG-SONUM          = V_VBELN.
      IT_DETAIL_KTNG-SOITEM         = V_POSNR.
      IT_DETAIL_KTNG-TIME           = SY-TIMLO.
      IT_DETAIL_KTNG-KTNGCODE       = IT_MASTER_KTNG-CODE.
      IT_DETAIL_KTNG-COMPANY        = 4.
      IT_DETAIL_KTNG-JRNUMB         = IT_MASTER_KTNG-NEXT_VALUE.
      IT_DETAIL_KTNG-MIDROLL        = IT_MASTER_KTNG-MS.
      IT_DETAIL_KTNG-SLITT_MCHN     = V_CODERESOURCE.
      IT_DETAIL_KTNG-TS             = 1.
      IT_DETAIL_KTNG-PS             = '01'.
      IT_DETAIL_KTNG-VCOUNT         = 1.
      PERFORM DATE_FORMAT USING SY-DATUM CHANGING IT_DETAIL_KTNG-CREATE_ON.
      CONCATENATE V_POSTDATE+2(2) V_POSTDATE+4(2) V_POSTDATE+6(2) INTO IT_DETAIL_KTNG-JRDATE.

      CONDENSE IT_DETAIL_KTNG-COMPANY.
      CONDENSE IT_DETAIL_KTNG-MIDROLL.
      CONDENSE IT_DETAIL_KTNG-TS.
      CONDENSE IT_DETAIL_KTNG-PS.

      MODIFY ZDETAIL_KTNG FROM IT_DETAIL_KTNG.
      IF SY-SUBRC <> 0.
        MESSAGE 'GAGAL Update Detail' TYPE 'I'.
        LEAVE PROGRAM.
      ENDIF.
      COMMIT WORK.

      "Hitung RANGE NUMBER dan Reset NEXT VALUE
      REFRESH: IT_CHAR.
      CLEAR: ZROLCHAR, ZSATUAN.
      SELECT SINGLE VBAP~CUOBJ INTO ZCUOBJ FROM VBAP WHERE VBAP~VBELN = V_VBELN AND VBAP~POSNR = V_POSNR.

      CALL FUNCTION 'VC_I_GET_CONFIGURATION'
        EXPORTING
          INSTANCE            = ZCUOBJ
        TABLES
          CONFIGURATION       = IT_CHAR
        EXCEPTIONS
          INSTANCE_NOT_FOUND  = 1
          INTERNAL_ERROR      = 2
          NO_CLASS_ALLOCATION = 3
          INSTANCE_NOT_VALID  = 4
          OTHERS              = 5.

      READ TABLE IT_CHAR WITH KEY ATNAM = 'ZZNUMBEROFROLL'.
      SPLIT IT_CHAR-ATWTB AT SPACE INTO ZROLCHAR ZSATUAN.
      REPLACE ALL OCCURRENCES OF ',' IN ZROLCHAR WITH ' '.

      "Count Pallet
      CLEAR: VCOUNT.
      VCOUNT = ( ZROLCHAR / IT_MASTER_KTNG-ROLL ).
      VCOUNT = CEIL( VCOUNT ) - 1.

      DO VCOUNT TIMES.
        IT_MASTER_KTNG-MS = IT_MASTER_KTNG-MS + 1.
        CONDENSE IT_MASTER_KTNG-MS.
        IF IT_MASTER_KTNG-MS > IT_MASTER_KTNG-MAX_MS.
          IT_MASTER_KTNG-MS = '1'.
          IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-NEXT_VALUE + 1.
          CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
          PERFORM OUTPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING IT_MASTER_KTNG-MAX_VALUE.
          IF IT_MASTER_KTNG-NEXT_VALUE > IT_MASTER_KTNG-MAX_VALUE.
            IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-MIN_VALUE.
            CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
            PERFORM DATE_FORMAT USING SY-DATUM CHANGING IT_MASTER_KTNG-LAST_RESET.
          ENDIF.
        ENDIF.
      ENDDO.

      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-NEXT_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-NEXT_VALUE = VJRMAX.
      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-MAX_VALUE = VJRMAX.

      APPEND IT_MASTER_KTNG.
      MODIFY ZMASTER_KTNG FROM TABLE IT_MASTER_KTNG.
      IF SY-SUBRC <> 0.
        MESSAGE 'Gagal Update Master' TYPE 'I'.
        LEAVE PROGRAM.
      ENDIF.
      COMMIT WORK.
      CLEAR: IT_MASTER_KTNG, IT_DETAIL_KTNG.
      REFRESH: IT_MASTER_KTNG, IT_DETAIL_KTNG.

    ENDIF.

  ENDIF.

ENDFORM.                    "get_code

