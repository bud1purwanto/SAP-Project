*&---------------------------------------------------------------------*
*&      Form  OLAP
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM OLAP.
  SELECT SINGLE DBMS
           FROM DBCON
           INTO DBTYPE
           WHERE CON_NAME = LV_DBS_CONNECTION.

  IF DBTYPE = 'MSS'.
    TRY.

      EXEC SQL.
        CONNECT TO :LV_DBS_CONNECTION

      ENDEXEC.
      IF SY-SUBRC <> 0.
        RAISE EXCEPTION TYPE CX_SY_NATIVE_SQL_ERROR.
      ENDIF.

      EXEC SQL.
        DELETE FROM ZMB5M
      ENDEXEC.

      EXEC SQL.
        COMMIT WORK
      ENDEXEC.

      LOOP AT ITAB.
        EXEC SQL.
          INSERT INTO
            ZMB5M(MATERIAL, PLANT, STORLOCATION, BATCH,
      MATERIALDESCRIPTION, SLDAYS, DAYS, SLEDBBD, UNRESTRICTED, BUN, LOCATION, STATUS)

          VALUES(:ITAB-MATNR, :ITAB-WERKS, :ITAB-LGORT, :ITAB-CHARG,
      :ITAB-MAKTX, :ITAB-TEMPO, :ITAB-DAYS, :ITAB-VFDAT, :ITAB-CLABS, :ITAB-BUN, :ITAB-LGOBE, :ITAB-STATUS)

        ENDEXEC.
      ENDLOOP.

      EXEC SQL.
        COMMIT WORK.
      ENDEXEC.

      EXEC SQL.
        DISCONNECT :LV_CURRENT_CONNECTION
      ENDEXEC.

      MESSAGE 'Penyimpanan Data ke SQL Sukses!!!' TYPE 'S'.

    ENDTRY.
  ENDIF.
ENDFORM.                    "OLAP