REPORT  ZOLAP_MB5M.


TABLES: AFPO,MCHB,T001N.



DATA : IT_FIELDCAT TYPE SLIS_T_FIELDCAT_ALV,
       WA_FIELDCAT TYPE SLIS_FIELDCAT_ALV,
       IT_LAYOUT TYPE SLIS_LAYOUT_ALV.

DATA:  LV_DBS_CONNECTION      TYPE DBCON-CON_NAME VALUE 'TRIASDB04',
       LV_CURRENT_CONNECTION  TYPE DBCON-CON_NAME.
DATA   DBTYPE TYPE DBCON_DBMS.

DATA:AMOUNT1 LIKE WMTO_S-AMOUNT,
     AMOUNT2 LIKE WMTO_S-AMOUNT,
     TEMPOGABUNG TYPE STRING,
     DATERANGE TYPE SY-DATUM,
     LV_I TYPE I,
     LV_C(1) TYPE C,
     LV_DOUBL(1) TYPE C,
     LV_COLOR(4) TYPE C.

DATA: BEGIN OF DATA,
        MATNR LIKE MCHB-MATNR,
        MAKTX LIKE MAKT-MAKTX,
        WERKS LIKE MCHB-WERKS,
        LGORT LIKE MCHB-LGORT,
        CHARG LIKE MCHB-CHARG,
        CLABS LIKE MCHB-CLABS,
        VFDAT LIKE MCH1-VFDAT,
        LGOBE LIKE T001L-LGOBE,
        BUN   TYPE STRING,
        DAYS  TYPE  STRING,
        STATUS TYPE STRING,
        TEMPO TYPE STRING,
        INDC(40) TYPE C,
        LINE_COLOR(4) TYPE C,
      END OF DATA.

*--------------------------------------------------------------------*
*UNTUK WARNA IJO DAN MERAH
*--------------------------------------------------------------------*
CONSTANTS : GCF_E1(4) TYPE C VALUE '@0A@',
            GCF_S1(4) TYPE C VALUE '@08@'.
*--------------------------------------------------------------------*
*UNTUK WARNA IJO DAN MERAH
*--------------------------------------------------------------------*

DATA: ITAB LIKE DATA OCCURS 0 WITH HEADER LINE.
DATA: ITAB2 LIKE DATA OCCURS 0 WITH HEADER LINE.

SELECTION-SCREEN BEGIN OF BLOCK B1 WITH FRAME TITLE TEXT-001.

SELECT-OPTIONS: V_MATNR FOR MCHB-MATNR.
SELECT-OPTIONS: V_WERKS FOR MCHB-WERKS.
SELECT-OPTIONS: V_LGORT FOR MCHB-LGORT.
SELECT-OPTIONS: V_CHARG FOR MCHB-CHARG.

SELECTION-SCREEN END OF BLOCK B1.

SELECTION-SCREEN BEGIN OF BLOCK B2 WITH FRAME TITLE TEXT-002.

SELECTION-SCREEN BEGIN OF LINE.
SELECTION-SCREEN COMMENT (20) TXT3 FOR FIELD V_MHDRZ.
PARAMETERS V_MHDRZ LIKE MARA-MHDRZ.
SELECTION-SCREEN COMMENT (20) TXT4 FOR FIELD V_MHDRZ.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS: R3 RADIOBUTTON GROUP RAD2.
SELECTION-SCREEN COMMENT (20) TXT5 FOR FIELD R3.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS: R4 RADIOBUTTON GROUP RAD2 DEFAULT 'X'.
SELECTION-SCREEN COMMENT (20) TXT6 FOR FIELD R4.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS: R5 AS CHECKBOX DEFAULT ''.
SELECTION-SCREEN COMMENT (20) TXT7 FOR FIELD R5.
SELECTION-SCREEN END OF LINE.



SELECTION-SCREEN END OF BLOCK B2.

SELECTION-SCREEN BEGIN OF BLOCK B3 WITH FRAME TITLE TEXT-003.

SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS: R1 RADIOBUTTON GROUP RAD1 DEFAULT 'X'.
SELECTION-SCREEN COMMENT (20) TXT1 FOR FIELD R1.
SELECTION-SCREEN END OF LINE.
SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS: R2 RADIOBUTTON GROUP RAD1.
SELECTION-SCREEN COMMENT (20) TXT2 FOR FIELD R2.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN END OF BLOCK B3.

INITIALIZATION.
  TXT1 = ' Display'.
  TXT2 = ' Olap'.
  TXT3 = 'Min. Rem. Shelf Life'.
  TXT4 = '(Days)'.
  TXT5 = 'Rem.shelf life whse'.
  TXT6 = 'Tot. rem. shelf life'.
  TXT7 = 'Materials with zero stock'.

START-OF-SELECTION.

  IF R1 IS NOT INITIAL.
    PERFORM GET_DATA.
    PERFORM DISPLAY_ALV.
  ELSEIF R2 IS NOT INITIAL.
    PERFORM GET_DATA.
    PERFORM OLAP.
  ELSE.
    MESSAGE 'CHECKBOX IS NOT DEFINED' TYPE 'E'.

  ENDIF.






*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA.
  CLEAR ITAB.
  REFRESH ITAB.

  DATERANGE = SY-DATUM + V_MHDRZ.

  IF V_MHDRZ IS INITIAL.
    SELECT MARA~MATNR MAKT~MAKTX MCHB~WERKS MCHB~LGORT MCHB~CHARG MCHB~CLABS MCH1~VFDAT
       FROM MCHB JOIN MCH1 ON MCHB~MATNR EQ MCH1~MATNR AND MCHB~CHARG EQ MCH1~CHARG JOIN MARA ON MARA~MATNR EQ MCHB~MATNR JOIN MAKT ON MARA~MATNR EQ MAKT~MATNR
        INTO CORRESPONDING FIELDS OF TABLE ITAB
       WHERE MCHB~MATNR IN V_MATNR AND MCHB~WERKS IN V_WERKS AND MCHB~LGORT IN V_LGORT AND MCHB~CHARG IN V_CHARG AND MCHB~CLABS NE '' AND MCH1~VFDAT NE '' AND MARA~MTART EQ 'ZRAW' AND MCH1~VFDAT LT SY-DATUM .
  ELSE.
    SELECT MARA~MATNR MAKT~MAKTX MCHB~WERKS MCHB~LGORT MCHB~CHARG MCHB~CLABS MCH1~VFDAT
       FROM MCHB JOIN MCH1 ON MCHB~MATNR EQ MCH1~MATNR AND MCHB~CHARG EQ MCH1~CHARG JOIN MARA ON MARA~MATNR EQ MCHB~MATNR JOIN MAKT ON MARA~MATNR EQ MAKT~MATNR
        INTO CORRESPONDING FIELDS OF TABLE ITAB
        WHERE MCHB~MATNR IN V_MATNR AND MCHB~WERKS IN V_WERKS AND MCHB~LGORT IN V_LGORT AND MCHB~CHARG IN V_CHARG AND MCHB~CLABS NE '' AND MCH1~VFDAT NE '' AND MARA~MTART EQ 'ZRAW' AND MCH1~VFDAT BETWEEN SY-DATUM AND DATERANGE.

  ENDIF.

  IF V_MHDRZ IS NOT INITIAL.
    SELECT MARA~MATNR MAKT~MAKTX MCHB~WERKS MCHB~LGORT MCHB~CHARG MCHB~CLABS MCH1~VFDAT
       FROM MCHB JOIN MCH1 ON MCHB~MATNR EQ MCH1~MATNR AND MCHB~CHARG EQ MCH1~CHARG JOIN MARA ON MARA~MATNR EQ MCHB~MATNR JOIN MAKT ON MARA~MATNR EQ MAKT~MATNR
       APPENDING CORRESPONDING FIELDS OF TABLE ITAB
        WHERE MCHB~MATNR IN V_MATNR AND MCHB~WERKS IN V_WERKS AND MCHB~LGORT IN V_LGORT AND MCHB~CHARG IN V_CHARG AND MCHB~CLABS NE '' AND MCH1~VFDAT NE '' AND MARA~MTART EQ 'ZRAW' AND MCH1~VFDAT LT SY-DATUM.



  ENDIF.

  LOOP AT ITAB.
    DELETE ITAB WHERE VFDAT EQ '00000000'.
  ENDLOOP.

  LOOP AT ITAB.



    SELECT SINGLE T001L~LGOBE FROM T001L INTO ITAB-LGOBE WHERE T001L~WERKS EQ ITAB-WERKS AND T001L~LGORT EQ ITAB-LGORT.

    AMOUNT1 = ITAB-CLABS.
    CALL FUNCTION 'CURRENCY_AMOUNT_SAP_TO_DISPLAY'
      EXPORTING
        CURRENCY        = 'IRD'
        AMOUNT_INTERNAL = AMOUNT1
      IMPORTING
        AMOUNT_DISPLAY  = AMOUNT2.

    ITAB-CLABS = AMOUNT2.
    ITAB-TEMPO = ITAB-VFDAT - SY-DATUM.

    IF ITAB-TEMPO < 0.
      ITAB-STATUS = 'Expired'.
      ITAB-INDC = GCF_E1.
      ITAB-LINE_COLOR = 'C610'.
    ELSEIF ITAB-TEMPO >= 0.
      ITAB-INDC = GCF_S1.
      ITAB-LINE_COLOR = 'C510'.
    ENDIF.

    ITAB-DAYS = 'Days'.
    ITAB-BUN = 'KG'.

    MODIFY ITAB.
  ENDLOOP.



ENDFORM.                    "GET_DATA


