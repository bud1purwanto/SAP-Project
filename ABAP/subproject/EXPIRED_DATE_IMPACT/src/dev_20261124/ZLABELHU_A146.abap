*&---------------------------------------------------------------------*
*& Report  ZMMR_LABELHU_KTNG
*&
*&---------------------------------------------------------------------*
*&
*&
*&---------------------------------------------------------------------*

REPORT  ZLABELHU_A146.

TABLES: MCHB.

DATA: V_FORMNAME  TYPE TDSFNAME  VALUE  'ZLABELHU_A146',
      V_FUNCNAME  TYPE RS38L_FNAM.


DATA: V_TAB    TYPE API_VALI OCCURS 0 WITH HEADER LINE.
DATA: CONTROL_PARAMETERS TYPE SSFCTRLOP,
      OUTPUT_OPTIONS TYPE SSFCOMPOP.

DATA: BEGIN OF IT_CHARG OCCURS 0,
  CHARG LIKE MCHB-CHARG,
  MATNR LIKE MCHB-MATNR,
  END OF IT_CHARG.

DATA: TOCHAR TYPE P DECIMALS 0,
      TOSTRG TYPE STRING,
      V_VBELN LIKE MSKA-VBELN,
      V_POSNR LIKE MSKA-POSNR,
      V_SONUM_ITEM(17),
      VBARCTEXTTRIAS(30),
      VBARCODETRIAS(20),
      VCODE(10),
      VCORE(20),
      VROLL(50),
      VNWEIGHT(10),
      VINSIDE(20),
      VOUTSIDE(20),
      V_LIVE TYPE P,
      V_POSTDATE TYPE MKPF-BUDAT,
      V_EXPDATE TYPE MKPF-BUDAT,
      VUSED(10),
      VWIDTH(10),
      VLENGTH(10),
      VSPLICE(30),
      VVBELN(30),
      VPOSNR(30),
      V_PARTNO(30),
      V_BARC(40),
      V_BARC1(40),
      V_BARC2(40),
      V_PRODDATE(30),
      VX_MSG(50),
      V_JUMLAH TYPE I.

DATA: ITAB LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE,
      ITAB2 LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE.

DATA: V_COPY TYPE P,
      V_ROW TYPE P,
      V_COPIES(3) VALUE 1,
      V_KALAB LIKE MSKA-KALAB,
      V_KAINS LIKE MSKA-KAINS,
      V_KASPE LIKE MSKA-KASPE,
      V_CLABS LIKE MCHB-CLABS,
      V_CINSM LIKE MCHB-CINSM,
      V_CEINM LIKE MCHB-CEINM,
      V_CSPEM LIKE MCHB-CSPEM,
      V_BOX_NO(40),
      V_ZZPACKING(10),
      V_SUM_NETWEIGHT TYPE P DECIMALS 2,
      V_S_SUM_QTYSHEET(20),
      V_SUM_QTYSHEET TYPE P DECIMALS 2.

DATA : V_ERDAT(3),
       V_PLANT_CODE(2).

CLEAR: VCODE,VWIDTH,VLENGTH,VNWEIGHT,VROLL,VCORE,VUSED,VINSIDE,VOUTSIDE,
      VBARCTEXTTRIAS,VBARCODETRIAS,V_SONUM_ITEM.

PARAMETER: V_CHARG LIKE MCHB-CHARG NO-DISPLAY,
           V_EXIDV LIKE MCHB-MATNR NO-DISPLAY,
           V_MATNR LIKE MARA-MATNR NO-DISPLAY,
           V_WERKS LIKE VBDPL-WERKS NO-DISPLAY,
           V_MAGRV LIKE VEKP-MAGRV NO-DISPLAY,
           V_TOTRL(4) NO-DISPLAY,             "Get Total Roll
           V_TOTBX(4) NO-DISPLAY,             "Get Total Box
           V_DATDD(2) NO-DISPLAY,
           V_DATMM(2) NO-DISPLAY,
           V_DATYY(1) NO-DISPLAY,
           V_TMWGHT TYPE P DECIMALS 3 NO-DISPLAY.

REFRESH: IT_CHARG, ITAB.

IF V_CHARG IS NOT INITIAL.
  SELECT CHARG MATNR INTO TABLE IT_CHARG FROM MCH1 WHERE CHARG EQ V_CHARG.
  DELETE ADJACENT DUPLICATES FROM IT_CHARG COMPARING CHARG.
ELSE.
  MESSAGE 'Data batch tidak didapatkan..!' TYPE 'I'.
  LEAVE LIST-PROCESSING.
ENDIF.

LOOP AT IT_CHARG.
  CLEAR: VCODE,VWIDTH,VLENGTH,VNWEIGHT,VCORE,VUSED,VINSIDE,VOUTSIDE,VBARCTEXTTRIAS,VBARCODETRIAS,V_SONUM_ITEM.

  IF IT_CHARG-CHARG IS NOT INITIAL AND IT_CHARG-MATNR IS NOT INITIAL.
    REFRESH V_TAB.
    CLEAR V_TAB.
    CALL FUNCTION 'QC01_BATCH_VALUES_READ'
      EXPORTING
        I_VAL_MATNR    = IT_CHARG-MATNR
        I_VAL_CHARGE   = IT_CHARG-CHARG
      TABLES
        T_VAL_TAB      = V_TAB
      EXCEPTIONS
        NO_CLASS       = 1
        INTERNAL_ERROR = 2
        NO_VALUES      = 3
        NO_CHARS       = 4
        OTHERS         = 5.
  ENDIF.

  CLEAR V_TAB-ATWRT.

  SELECT SINGLE VBELN POSNR INTO (ITAB-VVBELN, ITAB-VPOSNR)
      FROM MSKA
     WHERE MATNR = IT_CHARG-MATNR
       AND CHARG = IT_CHARG-CHARG
       AND ( KALAB > 0 OR KAINS > 0 OR KASPE > 0 ).

  IF SY-SUBRC = 0.
    SELECT SINGLE KDMAT INTO V_PARTNO FROM VBAP WHERE VBELN = ITAB-VVBELN AND POSNR = ITAB-VPOSNR.
    IF SY-SUBRC NE 0.
      MESSAGE 'Customer material belum ada...!' TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.

    CLEAR V_JUMLAH.
    V_JUMLAH = STRLEN( V_PARTNO ).
    IF V_JUMLAH NE 5.
      VX_MSG = 'Jumlah karakter customer material tidak sesuai (5 Karakter)...!'.
      MESSAGE VX_MSG TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = ITAB-VVBELN
      IMPORTING
        OUTPUT = ITAB-VVBELN.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = ITAB-VPOSNR
      IMPORTING
        OUTPUT = ITAB-VPOSNR.
    CONCATENATE ITAB-VVBELN ITAB-VPOSNR INTO ITAB-VSONUM_ITEM SEPARATED BY '/'.
  ELSE.
    CONCATENATE 'Batch' IT_CHARG-CHARG 'tidak terikat SO..!' INTO VX_MSG SEPARATED BY SPACE.
    MESSAGE VX_MSG TYPE 'I'..
    LEAVE LIST-PROCESSING.
  ENDIF.

  LOOP AT V_TAB.
    IF V_TAB-ATNAM = 'ZZCODE'.
      VCODE = V_TAB-ATWTB.
      READ TABLE V_TAB WITH KEY ATNAM = 'ZZALIAS'.
      IF SY-SUBRC = 0.
        VCODE = V_TAB-ATWRT.
      ENDIF.
    ELSEIF V_TAB-ATNAM = 'ZZWIDTH'.
      VWIDTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZLENGTH'.
      VLENGTH = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZTHICKNESS'.
      TOCHAR = V_TAB-ATFLV.
      TOSTRG = TOCHAR.
      ITAB-VTHICK = TOSTRG.
    ELSEIF V_TAB-ATNAM = 'ZZCORE'.
      CONCATENATE V_TAB-ATWRT '"' INTO VCORE.
    ELSEIF V_TAB-ATNAM = 'ZZPACKING'.
      IF SY-CPROG = 'ZPPPPRINTLABEL' OR SY-TCODE = 'MB90'.
        V_ZZPACKING = ' '.
      ELSEIF SY-TCODE = 'VL74'  OR SY-TCODE = 'ZHU005'.
        IF V_MAGRV = 'BOX'.
          V_ZZPACKING = V_TAB-ATWRT.
        ELSE.
          V_ZZPACKING = 'PL'.
        ENDIF.
      ENDIF.
*     Barcode Box No(from exidv plant and erdat)...
      CLEAR V_PLANT_CODE.
      IF V_WERKS = '1000'.
        V_PLANT_CODE = 'WR'.
      ELSEIF V_WERKS = '2000'.
        V_PLANT_CODE = 'KR'.
      ELSEIF V_WERKS = '3000'.
        V_PLANT_CODE = 'JR'.
      ENDIF.
      CONCATENATE V_DATMM V_DATYY INTO V_ERDAT.
      IF V_ZZPACKING <> 'PL'.
        CONCATENATE V_EXIDV V_PLANT_CODE V_ERDAT INTO V_BOX_NO SEPARATED BY '-'.
      ELSE.
        CONCATENATE V_EXIDV V_PLANT_CODE V_ERDAT V_DATDD INTO V_BOX_NO SEPARATED BY '-'.
      ENDIF.
    ELSEIF V_TAB-ATNAM = 'ZZINSIDE'.
      VINSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZOUTSIDE'.
      VOUTSIDE = V_TAB-ATWTB.
    ELSEIF V_TAB-ATNAM = 'ZZEXPIREDLIVE'.
      V_LIVE = V_TAB-ATWTB.
    ENDIF.
  ENDLOOP.

  VBARCODETRIAS = V_EXIDV.    "Get Barcode Value
  VBARCTEXTTRIAS = V_BOX_NO.  "Get Barcode Text Value


* Get Used Before Value
  IF V_LIVE NE ''.
    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
      EXPORTING
        MATNR = IT_CHARG-MATNR
        CHARG = IT_CHARG-CHARG
      IMPORTING
        PDATE = V_POSTDATE.

    IF SY-SUBRC EQ 0.
      CONCATENATE V_POSTDATE+2(2) V_POSTDATE+4(4) INTO V_PRODDATE.
      CONCATENATE V_POSTDATE(4) V_POSTDATE+4(2) V_POSTDATE+6(2) INTO ITAB-VPOSTDATE SEPARATED BY '/'.
    ELSE.
      MESSAGE 'Production date belum ada...!' TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.

    CONCATENATE 'P' V_PARTNO 'B3' V_PRODDATE '00' V_EXIDV
    INTO V_BARC1 SEPARATED BY '-'.

    CONCATENATE 'P' V_PARTNO 'B3' V_PRODDATE '00' V_EXIDV
    INTO V_BARC2.

    IF SY-SUBRC = 0.
      V_EXPDATE = V_POSTDATE + V_LIVE.
      CONCATENATE V_EXPDATE+0(4) '.' V_EXPDATE+4(2) INTO VUSED.
    ENDIF.
  ENDIF.

  ITAB-VSONUM_ITEM    = V_SONUM_ITEM.
  ITAB-VBARCTEXTTRIAS = VBARCTEXTTRIAS.
  ITAB-VBARCODETRIAS  = VBARCODETRIAS.
  ITAB-VTYPE          = VCODE.
  ITAB-VCORE          = VCORE.
  ITAB-VNWEIGHT       = VNWEIGHT.
  ITAB-VINSIDE        = VINSIDE.
  ITAB-VOUTSIDE       = VOUTSIDE.
  ITAB-VUSED          = VUSED.
  ITAB-VWIDTH         = VWIDTH.
  ITAB-VLENGTH        = VLENGTH.
  ITAB-VUSED          = V_EXIDV.
  ITAB-VPOINT         = V_TOTRL.
  ITAB-VPARTNO        = V_PARTNO.
  ITAB-VBARCTEXTCUST  = V_BARC1.
  ITAB-VBARCODECUST   = V_BARC2.
  ITAB-VBARCTEXTTRIAS = V_BARC2.

  APPEND ITAB.
  CLEAR ITAB.

ENDLOOP.

PERFORM PRINT_DATA.

*&---------------------------------------------------------------------*
*&      Form  print_data
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM PRINT_DATA.

  ITAB2[] = ITAB[].
  CLEAR: ITAB.
  REFRESH: ITAB.

  LOOP AT ITAB2 INTO ITAB.
    DO V_COPIES TIMES.
      APPEND ITAB.
    ENDDO.
    CLEAR: ITAB.
  ENDLOOP.

  SORT ITAB BY VBATCH.

  DESCRIBE TABLE ITAB LINES V_ROW.

  DATA: GV_DEVTYPE    TYPE RSPOPTYPE.

  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      FORMNAME           = V_FORMNAME
    IMPORTING
      FM_NAME            = V_FUNCNAME
    EXCEPTIONS
      NO_FORM            = 1
      NO_FUNCTION_MODULE = 2
      OTHERS             = 3.

  V_COPY = V_COPIES.
*  CONTROL_PARAMETERS-NO_DIALOG = ''. "set pop-up preview smartforms
  CONTROL_PARAMETERS-NO_DIALOG = 'X'.
  CONTROL_PARAMETERS-PREVIEW = 'X'.

  CALL FUNCTION V_FUNCNAME
    EXPORTING
      CONTROL_PARAMETERS = CONTROL_PARAMETERS
      OUTPUT_OPTIONS     = OUTPUT_OPTIONS
      V_ROW              = V_ROW
      V_TOTRL            = V_TOTRL
      V_TOTBX            = V_TOTBX
      V_COPY             = V_COPY
    TABLES
      ITAB               = ITAB.

ENDFORM.                    "print_data