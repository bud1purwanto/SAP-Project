FORM DISPLAY_REPORT.
  CREATE OBJECT MY_HANDLER.
  CALL SCREEN 0300.
ENDFORM.                    "DISPLAY_REPORT

DEFINE ADDTEXT.
  TEXT = &2.
  CALL METHOD &1->ADD_TEXT
    EXPORTING
      TEXT      = TEXT
      SAP_STYLE = &3
      SAP_FONTSIZE = CL_DD_AREA=>MEDIUM
      SAP_EMPHASIS = CL_DD_AREA=>STRONG.
END-OF-DEFINITION.

DEFINE ADDTABLE.
  CALL METHOD &1->ADD_TABLE
    EXPORTING
      WIDTH                       = &2
      NO_OF_COLUMNS               = &3
      CELL_BACKGROUND_TRANSPARENT = SPACE
      WITH_HEADING                = 'X'
    IMPORTING
      TABLE                       = &4.
END-OF-DEFINITION.

DEFINE ADDCOLUMN.
  CALL METHOD &1->ADD_COLUMN
    EXPORTING
      WIDTH  = &2
    IMPORTING
      COLUMN = &3.
END-OF-DEFINITION.

DEFINE NEWROW.
  CALL METHOD &1->NEW_ROW.
END-OF-DEFINITION.

DEFINE FILLROW.
  IF &3 = 'BOLD'.
    CALL METHOD &1->ADD_TEXT
      EXPORTING
        TEXT         = &2
        SAP_EMPHASIS = CL_DD_AREA=>STRONG
        SAP_FONTSIZE = CL_DD_AREA=>MEDIUM.
  ELSE.
    CALL METHOD &1->ADD_TEXT
      EXPORTING
        TEXT         = &2
        SAP_FONTSIZE = CL_DD_AREA=>MEDIUM.
  ENDIF.
END-OF-DEFINITION.

*----------------------------------------------------------------------*
*  MODULE STATUS_0300 OUTPUT
*----------------------------------------------------------------------*
*----------------------------------------------------------------------*
MODULE STATUS_0300 OUTPUT.
  IF DO IS INITIAL.
    SET PF-STATUS 'PF-EBANKING'.
*    SET PF-STATUS 'STANDARD_FULLSCREEN'.
    SET HANDLER MY_HANDLER->USE_NEW_RESOURCES.
* create document
    CREATE OBJECT DO.
* fill document
    PERFORM FILL_OPT_TAB CHANGING OPT_TAB.
    PERFORM SET_BACKGROUND_COLOR_DESC.
* styling document for DNM
    PERFORM DD_STYLE_TABLE_DNM USING DO.
* merge document
    CALL METHOD DO->MERGE_DOCUMENT.
* display the document inside the container named 'HTML'

    CREATE OBJECT CONTAINER1
      EXPORTING
        CONTAINER_NAME = 'CONTAINER1'.

    CALL METHOD DO->DISPLAY_DOCUMENT
      EXPORTING
        PARENT             = CONTAINER1  "CL_GUI_CONTAINER=>DEFAULT_SCREEN
*       PARENT             = CL_GUI_CONTAINER=>DEFAULT_SCREEN
      EXCEPTIONS
        HTML_DISPLAY_ERROR = 1.
  ENDIF.
ENDMODULE.                             " STATUS_0300  OUTPUT

