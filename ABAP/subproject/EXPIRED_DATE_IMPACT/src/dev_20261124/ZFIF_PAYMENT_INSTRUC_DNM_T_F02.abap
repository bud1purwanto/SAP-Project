* CLASS cl_my_event_handler IMPLEMENTATION.
CLASS CL_MY_EVENT_HANDLER IMPLEMENTATION.
****************************************************
*  METHOD handle_selections                        *
****************************************************
  METHOD HANDLE_SELECTIONS.
    BACKGROUND_COLOR_ID = SENDER->VALUE.
    PERFORM SET_BACKGROUND_COLOR_DESC.
    CALL METHOD USE_NEW_RESOURCES.
*    SUBMIT (sender->value) AND RETURN.
  ENDMETHOD.                    "handle_selections
****************************************************
*  METHOD use_new_resources                        *
****************************************************
  METHOD USE_NEW_RESOURCES.
    IF FIRST_DISPLAY IS INITIAL.
* initialize document
      CASE BACKGROUND_COLOR_ID.
        WHEN '-1'.
          CALL METHOD DO->INITIALIZE_DOCUMENT.
        WHEN '36'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_BACKGROUND_LEVEL1.
        WHEN '35'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_BACKGROUND_LEVEL2.
        WHEN '31'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_TEXTAREA.
        WHEN '60'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_TREE_LEVEL1.
        WHEN '61'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_TREE_LEVEL2.
        WHEN '62'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_TREE_LEVEL3.
        WHEN '63'.
          CALL METHOD DO->INITIALIZE_DOCUMENT
            EXPORTING
              BACKGROUND_COLOR = CL_DD_AREA=>COL_TREE_LEVEL4.
      ENDCASE.
* fill document
*      PERFORM DD_STYLE_TABLE USING DO.
* merge document
      CALL METHOD DO->MERGE_DOCUMENT.
* display document
      CALL METHOD DO->DISPLAY_DOCUMENT
        EXPORTING
          REUSE_CONTROL      = 'X'
          REUSE_REGISTRATION = 'X'.
    ENDIF.
  ENDMETHOD.                    "use_new_resources
ENDCLASS.                    "cl_my_event_handler IMPLEMENTATION

*&---------------------------------------------------------------------*
*&      Form  FILL_OPT_TAB
*&---------------------------------------------------------------------*
FORM FILL_OPT_TAB CHANGING P_OPT_TAB TYPE SDYDO_OPTION_TAB.
  DATA OPT TYPE SDYDO_OPTION.
  OPT-VALUE = '-1'.
  OPT-TEXT  = '<NONE>'.                                     "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '36'.
  OPT-TEXT  = 'COL_BACKGROUND_LEVEL1'.                      "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '35'.
  OPT-TEXT  = 'COL_BACKGROUND_LEVEL2'.                      "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '31'.
  OPT-TEXT  = 'COL_TEXTAREA'.                               "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '60'.
  OPT-TEXT  = 'COL_TREE_LEVEL1'.                            "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '61'.
  OPT-TEXT  = 'COL_TREE_LEVEL2'.                            "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '62'.
  OPT-TEXT  = 'COL_TREE_LEVEL3'.                            "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
  OPT-VALUE = '63'.
  OPT-TEXT  = 'COL_TREE_LEVEL4'.                            "#EC NOTEXT
  APPEND OPT TO P_OPT_TAB.
ENDFORM.                               " FILL_OPT_TAB

*&---------------------------------------------------------------------*
*&      Form  SET_BACKGROUND_COLOR_DESC
*&---------------------------------------------------------------------*
FORM SET_BACKGROUND_COLOR_DESC.
  CASE BACKGROUND_COLOR_ID.
    WHEN '-1'.
      BACKGROUND_COLOR_DESC = 'Keine Hintergrundfarbe gesetzt' &
        ' / Default (COL_BACKGROUND_LEVEL1) wird benutzt'(024).
    WHEN '36'.
      BACKGROUND_COLOR_DESC = 'Farb ID: Hintergrund,' &
        ' Stufe 1 (default: 36),' &
        ' verwendet in (Document) Style "ALV_GRID", "TREE"'(025).
    WHEN '35'.
      BACKGROUND_COLOR_DESC = 'Farb ID: Hintergrund,' &
        ' Stufe 2 (default: 35),' &
        ' verwendet in (Document) Style "ALV_TO_HTML",' &
        ' "STAND_ALONE"'(026).
    WHEN '31'.
      BACKGROUND_COLOR_DESC =
        'Farb ID: Hintergrund für Textbereiche (default: 31)'(027).
    WHEN '60'.
      BACKGROUND_COLOR_DESC =
        'Farb ID: Tree Level 1 (default: 60)'(028).
    WHEN '61'.
      BACKGROUND_COLOR_DESC =
        'Farb ID: Tree Level 2 (default: 61)'(029).
    WHEN '62'.
      BACKGROUND_COLOR_DESC =
        'Farb ID: Tree Level 3 (default: 62)'(030).
    WHEN '63'.
      BACKGROUND_COLOR_DESC =
        'Farb ID: Tree Level 4 (default: 63)'(031).
  ENDCASE.
ENDFORM.                               " SET_BACKGROUND_COLOR_DESC



*&---------------------------------------------------------------------*
*&      Form  DATA_RETRIEVAL_DNM
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM DATA_RETRIEVAL_DNM.
  DATA : ZANRED LIKE LFA1-ANRED.
  DATA : V_ADDT LIKE ADRCT-REMARK,
         V_MSG TYPE STRING.
  DATA: V_EXPDT LIKE SY-DATUM.
  REFRESH : IT_DNM_HEAD, IT_DNM_DETAIL.
  CLEAR : IT_DNM_HEAD, IT_DNM_DETAIL, Z_TOT_AMOUNT, Z_TOT_LINE.

*- fill Header
  IT_DNM_HEAD-TYPE = 'H'.
*  IT_DNM_HEAD-ACCNO = 'REGUH.UBKNT'.
  IT_DNM_HEAD-ACCDESC = ''.
  IT_DNM_HEAD-TRTYPE = 'D'.
  IT_DNM_HEAD-SNDRSTTS = 'Y'.
  IT_DNM_HEAD-SNDRCTRY = ''.
  CONCATENATE P_DATE+0(4) P_DATE+4(2) P_DATE+6(2) INTO IT_DNM_HEAD-INSDATE.
  IT_DNM_HEAD-INSAT = P_TIME.
  V_EXPDT = P_DATE + 1.
  CONCATENATE V_EXPDT+0(4) V_EXPDT+4(2) V_EXPDT+6(2) INTO IT_DNM_HEAD-EXPDATE.
  APPEND IT_DNM_HEAD.

  LOOP AT T_REGUH WHERE UBKNT NE ''.
    WRITE T_REGUH-UBKNT TO IT_DNM_HEAD-ACCNO NO-ZERO.
    MODIFY IT_DNM_HEAD TRANSPORTING ACCNO WHERE ACCNO = ''.
    EXIT.
  ENDLOOP.
*- end of fill header

  CLEAR : Z_TOT_AMOUNT,Z_TOT_LINE.
  LOOP AT T_REGUH.
    CLEAR : IT_DNM_DETAIL, ZDATE, ZAMOUNT, ZANRED, V_ADDT, ZTAMPUNG.

    IT_DNM_DETAIL-TYPE = 'D'.
    IT_DNM_DETAIL-PCODE = 'IAC'.
* IT_DNM_DETAIL-BENETYPE
    SELECT SINGLE ANRED INTO ZANRED FROM LFA1 WHERE LIFNR = T_REGUH-LIFNR.
    CASE ZANRED.
      WHEN 'Mr.'.
        IT_DNM_DETAIL-BENETYPE = '1'.
      WHEN 'Mrs.'.
        IT_DNM_DETAIL-BENETYPE = '1'.
      WHEN 'Mr. and Mrs.'.
        IT_DNM_DETAIL-BENETYPE = '1'.
      WHEN 'Company'.
        IT_DNM_DETAIL-BENETYPE = '2'.
      WHEN 'Non-Bank Financ'.
        IT_DNM_DETAIL-BENETYPE = '2'.
      WHEN 'Government'.
        IT_DNM_DETAIL-BENETYPE = '3'.
    ENDCASE.

*    IT_DNM_DETAIL-ACCDEBIT = T_REGUH-UBKNT.
    WRITE T_REGUH-UBKNT TO IT_DNM_DETAIL-ACCDEBIT NO-ZERO.

*          IT_DNM_DETAIL-ACCFROMDESC = ''.
    CONCATENATE T_REGUH-LAUFD+6(2) T_REGUH-LAUFD+4(2) T_REGUH-LAUFD+0(4) T_REGUH-LAUFI INTO IT_DNM_DETAIL-ACCFROMDESC.

    IT_DNM_DETAIL-NATDIR = 'SWIFT'.
*    IT_DNM_DETAIL-BENECNTRY = T_REGUH-ZLAND..
    IT_DNM_DETAIL-BENECNTRY = T_REGUH-ZBNKS.
    IT_DNM_DETAIL-BENECODE = T_REGUH-ZSWIF.
    IT_DNM_DETAIL-ITMBANK = ''.
*          IT_DNM_DETAIL-CRACCNO = 'D'.
*    IF T_REGUH-WAERS = 'EUR'.
*      IT_DNM_DETAIL-CRACCNO = T_REGUH-ZIBAN.
*    ELSE.
    CONCATENATE T_REGUH-ZBNKN T_REGUH-BKREF INTO IT_DNM_DETAIL-CRACCNO.
*    CONCATENATE T_REGUH-ZBNKN T_REGUH-BKREF T_REGUH-ZIBAN INTO IT_DNM_DETAIL-CRACCNO.
*    ENDIF.

*    IT_DNM_DETAIL-CRACCNO = T_REGUH-ZBNKN.

    SELECT SINGLE BUTXT INTO IT_DNM_DETAIL-TOACCDESC FROM T001 WHERE BUKRS EQ T_REGUH-ZBUKR.

    TRANSLATE IT_DNM_DETAIL-TOACCDESC TO UPPER CASE.

    IT_DNM_DETAIL-CRACCNAME = T_REGUH-KOINH.
    IT_DNM_DETAIL-CRACCCUR = T_REGUH-WAERS.
    IT_DNM_DETAIL-BENEADR1 = T_REGUH-ZORT1.
    IT_DNM_DETAIL-BENEADR2 = ''.
    IT_DNM_DETAIL-BENEADR3 = ''.
    IT_DNM_DETAIL-BENEMAIL = ''.
    IT_DNM_DETAIL-BENEPHONE = ''.
    IT_DNM_DETAIL-BENEREF = ''.
    IT_DNM_DETAIL-REMICUR = T_REGUH-WAERS.
    IT_DNM_DETAIL-TRAMTCUR = T_REGUH-HKTID.

    IF T_REGUH-RWBTR LT 0.
      T_REGUH-RWBTR =  T_REGUH-RWBTR * -1.
      WRITE T_REGUH-RWBTR TO IT_DNM_DETAIL-TRAMT NO-GROUPING.
    ELSE.
      WRITE T_REGUH-RWBTR TO IT_DNM_DETAIL-TRAMT NO-GROUPING.
    ENDIF.

    IT_DNM_DETAIL-EXCRATE = ''.
    IT_DNM_DETAIL-REFCODE = ''.
*          IT_DNM_DETAIL-CRHINST(3),
    CLEAR IT_DNM_DETAIL-CRHINST.
    SELECT SINGLE KVERM INTO IT_DNM_DETAIL-CRHINST FROM LFB1 WHERE LIFNR = T_REGUH-LIFNR
  AND BUKRS = T_REGUH-ZBUKR.
    IF IT_DNM_DETAIL-CRHINST = 'OUR'.
      IT_DNM_DETAIL-CRHINST = 'REM'.
    ELSE.
      IT_DNM_DETAIL-CRHINST = 'BEN'.
    ENDIF.
*
*    IF IT_DNM_DETAIL-CRHINST = 'BEN'.
    IT_DNM_DETAIL-DEBITCRG = 'C'.
*    ELSE.
*    IT_DNM_DETAIL-DEBITCRG = 'S'.
*    ENDIF.

*          IT_DNM_DETAIL-EXPDATE(8),
    IT_DNM_DETAIL-INSTCHG = P_DATE.
    IT_DNM_DETAIL-INSTAT = P_TIME.
    V_EXPDT = P_DATE + 1.
    CONCATENATE V_EXPDT+0(4) V_EXPDT+4(2) V_EXPDT+6(2) INTO IT_DNM_DETAIL-EXPDATE.

    IT_DNM_DETAIL-PAYMENT = ''.
*          IT_DNM_DETAIL-BENESTTS(1),
    IF T_REGUH-ZLAND = 'ID'.
      IT_DNM_DETAIL-BENESTTS = 'Y'.
    ELSE.
      IT_DNM_DETAIL-BENESTTS = 'N'.
    ENDIF.

    IT_DNM_DETAIL-BENERESCNTRY = T_REGUH-ZLAND.
*          IT_DNM_DETAIL-BENECAT(20),
    SELECT SINGLE ANRED INTO ZANRED FROM LFA1 WHERE LIFNR = T_REGUH-LIFNR.
    CASE ZANRED.
      WHEN 'Mr.'.
        IT_DNM_DETAIL-BENECAT = 'A0'.
      WHEN 'Mrs.'.
        IT_DNM_DETAIL-BENECAT = 'A0'.
      WHEN 'Mr. and Mrs.'.
        IT_DNM_DETAIL-BENECAT = 'A0'.
      WHEN 'Company'.
        IT_DNM_DETAIL-BENECAT = 'E0'.
      WHEN 'Non-Bank Financ'.
        IT_DNM_DETAIL-BENECAT = 'D0'.
      WHEN 'Government'.
        IT_DNM_DETAIL-BENECAT = 'B0'.
      WHEN OTHERS.
        IT_DNM_DETAIL-BENECAT = 'Z9'.
    ENDCASE.


    IT_DNM_DETAIL-TRANSRELA = 'N'.
    IT_DNM_DETAIL-INDENTSTTS = 'N'.
*          IT_DNM_DETAIL-PURPOSE(20), and *          IT_DNM_DETAIL-LHBUPURPOSE(20),
    IF T_REGUH-DTAWS = '01'.
      IT_DNM_DETAIL-PURPOSE = '2012'.
      IT_DNM_DETAIL-LHBUPURPOSE = '37'.
    ELSEIF T_REGUH-DTAWS = '02'.
      IT_DNM_DETAIL-PURPOSE = '2129'.
      IT_DNM_DETAIL-LHBUPURPOSE = '28'.
    ELSE.
    ENDIF.
    IT_DNM_DETAIL-LHBUTYPE = '004'.
*          IT_DNM_DETAIL-LHBUDESC(300),
    SELECT *  INTO CORRESPONDING FIELDS OF TABLE T_REGUP FROM REGUP
      WHERE REGUP~ZBUKR = T_REGUH-ZBUKR
       AND REGUP~LAUFD = T_REGUH-LAUFD
       AND REGUP~LAUFI = T_REGUH-LAUFI
       AND REGUP~XVORL = 'X'
       AND REGUP~LIFNR = T_REGUH-LIFNR
       AND REGUP~VBLNR = T_REGUH-VBLNR.
    LOOP AT T_REGUP. "WHERE ZUONR NE ''.
*      IT_DNM_DETAIL-LHBUDESC = T_REGUP-ZUONR.
      IF IT_DNM_DETAIL-LHBUDESC = ''.
        CONCATENATE IT_DNM_DETAIL-LHBUDESC T_REGUP-ZUONR INTO IT_DNM_DETAIL-LHBUDESC.
      ELSE.
        CONCATENATE IT_DNM_DETAIL-LHBUDESC ';' T_REGUP-ZUONR INTO IT_DNM_DETAIL-LHBUDESC.
      ENDIF.

      T_REGUP-WRBTR = T_REGUP-WRBTR - T_REGUP-QBSHB.
      WRITE T_REGUP-WRBTR TO T_REGUP-SGTXT NO-GROUPING.

      CONDENSE T_REGUP-SGTXT.
      CONCATENATE IT_DNM_DETAIL-PURPOSE_TD  T_REGUP-ZUONR '(' T_REGUP-SGTXT ')' INTO IT_DNM_DETAIL-PURPOSE_TD.

    ENDLOOP.

    APPEND IT_DNM_DETAIL.
  ENDLOOP.
ENDFORM.                    "DATA_RETRIEVAL_DBS