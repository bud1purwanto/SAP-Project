AT SELECTION-SCREEN OUTPUT.
  IF RB1 EQ 'X'.
    LOOP AT SCREEN.
      IF SCREEN-GROUP1 EQ 'INP'.
        SCREEN-INPUT = 0.
        SCREEN-ACTIVE = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.
  ELSEIF RB2 EQ 'X'.
    LOOP AT SCREEN.
      IF SCREEN-GROUP1 EQ 'CUS'.
        SCREEN-INPUT = 0.
        SCREEN-ACTIVE = 0.
        MODIFY SCREEN.
      ENDIF.
    ENDLOOP.

  ENDIF.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR P_SOURCE.
  CALL FUNCTION 'WS_FILENAME_GET'
    EXPORTING
      MODE             = 'O'
      TITLE            = 'Select File'
    IMPORTING
      FILENAME         = P_SOURCE
    EXCEPTIONS
      INV_WINSYS       = 1
      NO_BATCH         = 2
      SELECTION_CANCEL = 3
      SELECTION_ERROR  = 4
      OTHERS           = 5.

START-OF-SELECTION.
  PERFORM F_PROCESS_DATA.

END-OF-SELECTION.