FUNCTION ZCHARACTERISTICS.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(I_VAL_MATNR) TYPE  MARA-MATNR
*"     VALUE(I_VAL_CHARGE) TYPE  VBDPL-CHARG
*"  TABLES
*"      T_VAL_TAB STRUCTURE  ZCHARACTER
*"  EXCEPTIONS
*"      NO_OBJECT
*"      NO_VALUES
*"      T_L_E1
*"      T_L_E2
*"----------------------------------------------------------------------
** bagus aditya putra


  DATA : CUOBJ_BM TYPE MCH1-CUOBJ_BM.
  DATA : EX TYPE REF TO CX_ROOT.
  FIELD-SYMBOLS : <FS_VALUE> LIKE LINE OF T_VAL_TAB.


  SELECT SINGLE CUOBJ_BM INTO CUOBJ_BM
    FROM MCH1
    WHERE MCH1~MATNR  = I_VAL_MATNR
    AND   MCH1~CHARG  = I_VAL_CHARGE.
  IF CUOBJ_BM EQ ''.
    RAISE NO_OBJECT.
    RETURN.
  ENDIF.

  TRY.
      SELECT CABN~ATNAM AS ATNAM
             AUSP~ATINN AS ATINN
             AUSP~ATWRT AS ATWRT
             AUSP~ATFLV AS ATFLV
        FROM CABN
        JOIN AUSP ON CABN~ATINN = AUSP~ATINN
        INTO CORRESPONDING FIELDS OF TABLE T_VAL_TAB
        WHERE AUSP~OBJEK  = CUOBJ_BM
        AND   CABN~ATNAM IN ('ZZTYPE','ZZTHICKNESS','ZZWIDTH','ZZLENGTH','ZZNOMORROLL','ZZSPLICE-1',
                             'ZZSPLICE-2','ZZSPLICE-3','ZZALIAS','ZZEXLENGTH','ZZEXPIREDLIVE','ZZLENGTHSHT').
    CATCH CX_ROOT INTO EX.
      RAISE T_L_E1.
  ENDTRY.

  TRY.
      SELECT CABN~ATNAM AS ATNAM
             AUSP~ATINN AS ATINN
             AUSP~ATWRT AS ATWRT
             CAWNT~ATWTB AS ATWTB
        FROM CABN
        JOIN AUSP ON CABN~ATINN = AUSP~ATINN
        JOIN CAWN ON  AUSP~ATINN = CAWN~ATINN
                  AND AUSP~ATWRT = CAWN~ATWRT
        JOIN CAWNT ON CAWN~ATINN = CAWNT~ATINN
                  AND CAWN~ATZHL = CAWNT~ATZHL
        APPENDING CORRESPONDING FIELDS OF TABLE T_VAL_TAB
        WHERE AUSP~OBJEK  = CUOBJ_BM
        AND   CABN~ATNAM IN ('ZZCORE','ZZCRITERIA','ZZPACKING','ZZTREATMENT','ZZLABEL').
    CATCH CX_ROOT INTO EX.
      RAISE T_L_E2.
  ENDTRY.

ENDFUNCTION.