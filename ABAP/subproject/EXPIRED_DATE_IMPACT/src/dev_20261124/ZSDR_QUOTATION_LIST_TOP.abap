TYPES : BEGIN OF ITSO,
          VBELV LIKE VBFA-VBELV,
          POSNV LIKE VBFA-POSNV,
          VBELN LIKE VBFA-VBELN,
          POSNN LIKE VBFA-POSNN,
        END OF ITSO.

