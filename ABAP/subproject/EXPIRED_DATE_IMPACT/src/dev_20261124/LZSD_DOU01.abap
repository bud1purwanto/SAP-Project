FUNCTION ZSD_DO_DL.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(MODE) TYPE  CHAR10
*"     VALUE(DATE_FROM) TYPE  DATS
*"     VALUE(DATE_TO) TYPE  DATS
*"  TABLES
*"      LIKP STRUCTURE  LIKP
*"      LIPS STRUCTURE  LIPS
*"  EXCEPTIONS
*"      PAR_DATE_IS_NULL
*"      DATE_NOT_VALID
*"      DATA_NOT_FOUND
*"      MODE_IS_NOT_AVAILABLE
*"----------------------------------------------------------------------

  RANGES : P_DATE FOR LIKP-ERDAT.
  P_DATE-SIGN = 'I'.
  P_DATE-OPTION = 'BT'.
  P_DATE-LOW = DATE_FROM.
  P_DATE-HIGH = DATE_TO.
  APPEND P_DATE.

  CASE MODE.
    WHEN 'LIKP'.
      IF P_DATE-LOW IS INITIAL OR P_DATE-HIGH IS INITIAL.
        MESSAGE 'parameter DATE_FROM and DATE_TO must be initialized' TYPE 'S' RAISING PAR_DATE_IS_NULL.
      ELSEIF P_DATE-LOW GT P_DATE-HIGH.
        MESSAGE 'Date Not Valid' TYPE 'S' RAISING DATE_NOT_VALID.
      ELSE.
        DATA : I_LIKP TYPE LIKP OCCURS 0,
               I_LIPS TYPE LIPS OCCURS 0.
        PERFORM GET_DATA_LIKP USING P_DATE[] CHANGING I_LIKP I_LIPS.
        LIKP[] = I_LIKP[].
        LIPS[] = I_LIPS[].
        CLEAR : I_LIKP[], I_LIPS[].
        REFRESH : I_LIKP[], I_LIPS[].
      ENDIF.
    WHEN OTHERS.
      MESSAGE 'Mode Is Not Available' TYPE 'S' RAISING MODE_IS_NOT_AVAILABLE.
  ENDCASE.

ENDFUNCTION.

DATA : T_LIKP LIKE STANDARD TABLE OF LIKP,
       T_LIPS LIKE STANDARD TABLE OF LIPS.
FORM GET_DATA_LIKP USING VALUE(P_DATE) TYPE STANDARD TABLE CHANGING W_LIKP LIKE T_LIKP W_LIPS LIKE T_LIPS.
  DATA : IT_LIKP TYPE LIKP OCCURS 0 WITH HEADER LINE,
         IT_LIPS TYPE LIPS OCCURS 0 WITH HEADER LINE.

  SELECT * INTO TABLE IT_LIKP FROM LIKP WHERE ERDAT IN P_DATE.
  SELECT * APPENDING TABLE IT_LIKP FROM LIKP WHERE AEDAT IN P_DATE.
  SORT IT_LIKP BY VBELN.
  DELETE ADJACENT DUPLICATES FROM IT_LIKP COMPARING VBELN.

  IF IT_LIKP[] IS INITIAL.
    MESSAGE 'Data Not Found' TYPE 'S' RAISING DATA_NOT_FOUND.
  ELSE.
    SELECT * INTO TABLE IT_LIPS
    FROM LIPS
    FOR ALL ENTRIES IN IT_LIKP
    WHERE VBELN = IT_LIKP-VBELN.

    IT_LIKP-ERDAT = '19000101'.
    IT_LIKP-WADAT = '19000101'.
    IT_LIKP-LDDAT = '19000101'.
    IT_LIKP-TDDAT = '19000101'.
    IT_LIKP-LFDAT = '19000101'.
    IT_LIKP-KODAT = '19000101'.
    IT_LIKP-FKDAT = '19000101'.
    IT_LIKP-AEDAT = '19000101'.
    IT_LIKP-FKDIV = '19000101'.
    IT_LIKP-CMFRE = '19000101'.
    IT_LIKP-CMNGV = '19000101'.
    IT_LIKP-BLDAT = '19000101'.
    IT_LIKP-WADAT_IST = '19000101'.
    IT_LIKP-PODAT = '19000101'.
    MODIFY IT_LIKP TRANSPORTING ERDAT WHERE ERDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING WADAT WHERE WADAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING LDDAT WHERE LDDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING TDDAT WHERE TDDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING LFDAT WHERE LFDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING KODAT WHERE KODAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING FKDAT WHERE FKDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING AEDAT WHERE AEDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING FKDIV WHERE FKDIV = 00000000.
    MODIFY IT_LIKP TRANSPORTING CMFRE WHERE CMFRE = 00000000.
    MODIFY IT_LIKP TRANSPORTING CMNGV WHERE CMNGV = 00000000.
    MODIFY IT_LIKP TRANSPORTING BLDAT WHERE BLDAT = 00000000.
    MODIFY IT_LIKP TRANSPORTING WADAT_IST WHERE WADAT_IST = 00000000.
    MODIFY IT_LIKP TRANSPORTING PODAT WHERE PODAT = 00000000.

    IT_LIPS-ERDAT = '19000101'.
    IT_LIPS-MBDAT = '19000101'.
    IT_LIPS-AEDAT = '19000101'.
    IT_LIPS-STADAT = '19000101'.
    IT_LIPS-HSDAT = '19000101'.
    IT_LIPS-VFDAT = '19000101'.
    MODIFY IT_LIPS TRANSPORTING ERDAT WHERE ERDAT = 00000000.
    MODIFY IT_LIPS TRANSPORTING MBDAT WHERE MBDAT = 00000000.
    MODIFY IT_LIPS TRANSPORTING AEDAT WHERE AEDAT = 00000000.
    MODIFY IT_LIPS TRANSPORTING STADAT WHERE STADAT = 00000000.
    MODIFY IT_LIPS TRANSPORTING HSDAT WHERE HSDAT = 00000000.
    MODIFY IT_LIPS TRANSPORTING VFDAT WHERE VFDAT = 00000000.

    W_LIKP[] = IT_LIKP[].
    W_LIPS[] = IT_LIPS[].
    REFRESH : IT_LIKP[], IT_LIPS[].
    CLEAR : IT_LIKP[], IT_LIPS[].
  ENDIF.
ENDFORM.