  IF QUNUM-LOW IS NOT INITIAL.
    SELECT VBFA~VBELN VBFA~POSNN
      INTO CORRESPONDING FIELDS OF TABLE IT_SO
      FROM VBFA
      WHERE VBFA~MATNR IN MATNR
      AND   VBFA~VBELN IN VBELN
      AND   VBFA~VBELV IN QUNUM
      AND   VBFA~VBTYP_N = 'C'
      AND   VBFA~VBTYP_V = 'B'
      AND   VBFA~ERDAT IN ERDAT.

    SORT IT_SO ASCENDING BY VBELN.
    DELETE ADJACENT DUPLICATES FROM IT_SO COMPARING VBELN.

    LOOP AT IT_SO.
      SELECT VBAP~MATNR VBAP~VBELN VBAP~POSNR VBAK~VBTYP VBAK~AUART VBAK~KUNNR VBAP~KWMENG VBAP~VRKME VBAP~POSEX VBAP~UMVKN VBAP~UMVKZ
             VBAP~WERKS VBAP~VSTEL VBAK~BSTNK VBAP~PSTYV VBAP~MATKL VBAP~CUOBJ VBAK~KNUMV VBAK~WAERK VBAP~NETWR VBAP~ERDAT VBAP~PRODH
             VBAP~MVGR1 VBAP~MVGR2 VBAP~MVGR3 VBAP~MVGR4 VBAP~MVGR5
             INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL3
             FROM VBAP
             JOIN VBAK ON VBAK~VBELN = VBAP~VBELN
             JOIN VBUP ON VBUP~VBELN = VBAP~VBELN AND VBUP~POSNR = VBAP~POSNR
             JOIN VBUK ON VBUK~VBELN = VBAP~VBELN
             JOIN MARA ON MARA~MATNR = VBAP~MATNR
             WHERE VBAP~MATNR IN MATNR
             AND   VBAP~MATKL IN MATKL
             AND   VBAK~AUART IN AUART
             AND   VBAK~VDATU IN VDATU
             AND   VBAP~VSTEL IN VSTEL
             AND   VBAP~VBELN = IT_SO-VBELN
             AND   VBAP~ABGRU EQ '  '
             AND   VBUK~LFGSK IN LFGSK
             AND   VBAP~ERDAT IN ERDAT
             AND   MARA~MTART = 'ZFGS'
             AND   VBUP~GBSTA NE 'C'
             AND   VBAP~WERKS IN WERKS. "Add new company

      APPEND LINES OF IT_DETAIL3 TO IT_DETAIL.
      SORT IT_DETAIL ASCENDING BY VBELN POSNR.
      CLEAR IT_DETAIL3. REFRESH IT_DETAIL3.
    ENDLOOP.

  ELSE.     "QUNUM-LOW IS NOT INITIAL.
    SELECT VBAP~MATNR VBAP~VBELN VBAP~POSNR
*      VBEP~ETENR
      VBAK~VBTYP VBAK~AUART  VBAK~KUNNR VBAP~KWMENG VBAP~VRKME VBAP~POSEX VBAP~UMVKN VBAP~UMVKZ
                 VBAP~WERKS VBAP~VSTEL VBAK~BSTNK VBAP~PSTYV VBAP~MATKL VBAP~CUOBJ VBAK~KNUMV VBAK~WAERK VBAP~NETWR VBAP~ERDAT VBAP~PRODH
                 VBAP~MVGR1 VBAP~MVGR2 VBAP~MVGR3 VBAP~MVGR4 VBAP~MVGR5 VBUP~GBSTA VBAP~NTGEW
                 INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL
                 FROM VBAP
                 JOIN VBAK ON VBAK~VBELN = VBAP~VBELN
*       JOIN VBEP ON VBEP~VBELN = VBAP~VBELN
                 JOIN VBUP ON VBUP~VBELN = VBAP~VBELN AND VBUP~POSNR = VBAP~POSNR
                 JOIN VBUK ON VBUK~VBELN = VBAP~VBELN
                 JOIN MARA ON MARA~MATNR = VBAP~MATNR
                 WHERE VBAP~MATNR IN MATNR
                 AND   VBAP~MATKL IN MATKL
                 AND   VBAK~AUART IN AUART
                 AND   VBAK~VDATU IN VDATU
                 AND   VBAP~VSTEL IN VSTEL
                 AND   VBAP~VBELN IN VBELN
                 AND   VBAP~ABGRU EQ '  '
                 AND   VBAK~VBTYP = 'C'
                 AND   VBUK~LFGSK IN LFGSK
                 AND   VBAP~ERDAT IN ERDAT
                 AND   MARA~MTART = 'ZFGS'
                 AND   VBUP~GBSTA NE 'C'
                 AND   VBAP~WERKS IN WERKS. "Add new company.

    SORT IT_DETAIL ASCENDING BY VBELN POSNR.
  ENDIF.    "QUNUM-LOW IS NOT INITIAL.

  PERFORM SET_CONS.

  IF IT_DETAIL[] IS INITIAL.
*    MESSAGE 'Data has not found' TYPE 'I'.
    EXIT.
  ELSE.
    PERFORM GET_MASTER.

    LOOP AT IT_DETAIL.   "get Product hierarchy
      PERFORM GET_HIERARCHY.
    ENDLOOP.

    REFRESH: IT_T179T, IT_TVM1T, IT_TVM2T, IT_TVM3T, IT_TVM4T, IT_TVM5T.
    REFRESH: IT_TVV1T, IT_TVV2T, IT_TVV3T, IT_TVV4T, IT_TVV5T.
    REFRESH: IT_VBFA, IT_VBKD, IT_KUNNR, IT_KNKLI, IT_BLOCK, IT_BLOCK2, IT_DETAIL2, IT_VBEP, IT_VBEP2.

    SELECT AFPO~AUFNR AFPO~POSNR AFPO~PSMNG AFPO~WEMNG AFPO~KDAUF AFPO~KDPOS
       INTO TABLE IT_AFPO FROM AFPO
       FOR ALL ENTRIES IN IT_DETAIL
       WHERE KDAUF = IT_DETAIL-VBELN AND KDPOS = IT_DETAIL-POSNR.

    IF IT_AFPO[] IS NOT INITIAL.
      SORT IT_AFPO BY KDAUF KDPOS.

      LOOP AT IT_DETAIL.
        CLEAR VOPENPO.

        IF IT_DETAIL-VBTYP NE 'B'.

          LOOP AT IT_AFPO WHERE KDAUF = IT_DETAIL-VBELN AND KDPOS = IT_DETAIL-POSNR.

            CLEAR: VOBJNR, V_PO_STATUS.
            SELECT SINGLE OBJNR INTO VOBJNR FROM AUFK WHERE AUFNR = IT_AFPO-AUFNR.

            CALL FUNCTION 'STATUS_TEXT_EDIT'
              EXPORTING
                CLIENT = SY-MANDT
                OBJNR  = VOBJNR
                SPRAS  = 'E'
              IMPORTING
                LINE   = V_PO_STATUS.

            FIND 'TECO' IN V_PO_STATUS.
            CHECK SY-SUBRC NE 0.

            FIND 'CLSD' IN V_PO_STATUS.
            CHECK SY-SUBRC NE 0.

            VOPENPO = VOPENPO + IT_AFPO-PSMNG - IT_AFPO-WEMNG.

          ENDLOOP.

          IT_DETAIL-OPENPO = VOPENPO.
          IF IT_DETAIL-VRKME EQ 'PAK'.
            IT_DETAIL-OPENPO = ( ( IT_DETAIL-OPENPO / IT_DETAIL-CONVKG ) * IT_DETAIL-NUMOFSHEET ).
          ENDIF.
          MODIFY IT_DETAIL.
        ENDIF.
      ENDLOOP.
      REFRESH IT_AFPO.
    ENDIF.

*- get stock
    SELECT VBELN POSNR WERKS CHARG LGORT KALAB KASPE INTO TABLE IT_MSKA
      FROM MSKA FOR ALL ENTRIES IN IT_DETAIL
      WHERE VBELN = IT_DETAIL-VBELN AND POSNR = IT_DETAIL-POSNR.
    DELETE IT_MSKA WHERE KALAB = 0 AND KASPE = 0.

    LOOP AT IT_DETAIL.   "get stock
      PERFORM GET_STOCK.
    ENDLOOP.
    REFRESH IT_MSKA.

    LOOP AT IT_DETAIL.   "replace comma
      PERFORM REPLACE_COMMA.
    ENDLOOP.

  ENDIF.
ENDFORM.                    "GET_DETAIL



*&---------------------------------------------------------------------*
*&      Form  SCHEDULE_LINE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM SCHEDULE_LINE.
  CLEAR: IT_VBEP, IT_VBEP2, IT_CHAR, IT_CDPOS, IT_CDHDR.
  REFRESH: IT_VBEP, IT_VBEP2, IT_CHAR, IT_CDPOS, IT_CDHDR.

  SELECT VBELN POSNR ETENR WMENG EDATU
    INTO TABLE IT_VBEP FROM VBEP
    FOR ALL ENTRIES IN IT_DETAIL
    WHERE VBELN = IT_DETAIL-VBELN AND POSNR = IT_DETAIL-POSNR AND WMENG <> 0.

  SORT IT_VBEP BY VBELN POSNR EDATU.

  SELECT SINGLE ATINN INTO V_WEIGHT FROM CABN WHERE ATNAM = 'ZZCONVERSIONROLLKG'.

  SELECT ATINN ATFLV INSTANCE AS CUOBJ
    INTO CORRESPONDING FIELDS OF TABLE IT_CHAR FROM V_IBIN_SYVAL AS A
    JOIN IBIN AS B ON A~IN_RECNO EQ B~IN_RECNO
     FOR ALL ENTRIES IN IT_DETAIL
   WHERE A~ATINN EQ V_WEIGHT
     AND B~INSTANCE EQ IT_DETAIL-CUOBJ.

  LOOP AT IT_DETAIL.
    CLEAR: IDX, WA_ITDETAIL, VPOINT, ZORIDATE.
    ZORIDATENEW = '19990101'.

    LOOP AT IT_VBEP WHERE VBELN = IT_DETAIL-VBELN AND POSNR = IT_DETAIL-POSNR.
      IDX = IDX + 1.
      CLEAR: HITUNG, WA_VBEP, IT_VBEP2.
      CLEAR: ZQTYD, OPENPO, QTYTOBESLIT, TPRODW, TPRODK, TFGSW, TFGSK, TFGSJ, TINTW, TINTK, OTW, TEXCLUDE, VKURANG, HITUNG, WMENG, ZCONV.

      READ TABLE IT_VBEP INTO WA_VBEP WITH KEY VBELN = IT_DETAIL-VBELN POSNR = IT_DETAIL-POSNR ETENR = IT_VBEP-ETENR.
      IF SY-SUBRC <> 0.
        EXIT.
      ENDIF.

      READ TABLE IT_CHAR WITH KEY CUOBJ = IT_DETAIL-CUOBJ.
      IF SY-SUBRC EQ 0.
        CLEAR: TOCHAR, TOSTRG.
        TOCHAR = IT_CHAR-ATFLV.
        TOSTRG = TOCHAR.
        ZCONV = TOSTRG.
      ENDIF.
      REPLACE ALL OCCURRENCES OF ',' IN ZCONV WITH SPACE.

      PERFORM GET_ORIDATE.

      REPLACE ALL OCCURRENCES OF ',' IN IT_DETAIL-ZTOTALM2 WITH ' '.
      REPLACE ALL OCCURRENCES OF ',' IN IT_DETAIL-ZORDERQTY WITH ' '.

      IF IT_DETAIL-VRKME EQ 'KG'.
        IF IT_DETAIL-PSTYV EQ 'ZTAN'.
          IF IT_DETAIL-ZZROLLSTATUS EQ 'X'.
            WMENG = WA_VBEP-WMENG / ZCONV. "KONVERSI KE ROLL
          ELSE.
            WMENG = WA_VBEP-WMENG / 1.
          ENDIF.
        ELSEIF IT_DETAIL-CONVKG = 0.
          WMENG = WA_VBEP-WMENG / 1.
        ELSE.
          WMENG = WA_VBEP-WMENG / ZCONV. "KONVERSI KE ROLL
        ENDIF.
      ELSEIF IT_DETAIL-VRKME EQ 'M2'.
        WMENG = ( WA_VBEP-WMENG / IT_DETAIL-ZTOTALM2 ) * IT_DETAIL-KWMENG.
      ELSEIF IT_DETAIL-VRKME EQ 'ROL'.
        WMENG = WA_VBEP-WMENG.
      ELSEIF IT_DETAIL-VRKME EQ 'LB'.
        WMENG = WA_VBEP-WMENG / IT_DETAIL-ZORDERQTY.
      ELSEIF IT_DETAIL-VRKME EQ 'PAK'.
        WMENG = IT_DETAIL-ZKWMENG.
      ENDIF.

      WMENG = WMENG + VPOINT2.

      ZWMENG = WMENG.
      SPLIT ZWMENG AT '.' INTO ZWMENG VPOINT2.
      CONCATENATE '0.' VPOINT2 INTO VPOINT2.

      IF  IT_DETAIL-QTYD > ZWMENG.
        HITUNG = IT_DETAIL-QTYD - ZWMENG.
        ZQTYD = IT_DETAIL-QTYD - HITUNG.
        IT_DETAIL-QTYD = HITUNG.
      ELSE.
        ZQTYD = IT_DETAIL-QTYD.
        IT_DETAIL-QTYD = 0.
      ENDIF.
      MODIFY IT_DETAIL TRANSPORTING QTYD WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.

      " START STOCK

      VKURANG = ZWMENG - ZQTYD.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTPRODW <> 0. " CARI W-PRD
          IF IT_DETAIL-ZTPRODW > VKURANG.
            HITUNG = IT_DETAIL-ZTPRODW - VKURANG.
            TPRODW = IT_DETAIL-ZTPRODW - HITUNG.
            IT_DETAIL-ZTPRODW = HITUNG.
          ELSEIF IT_DETAIL-ZTPRODW <= VKURANG.
            TPRODW = IT_DETAIL-ZTPRODW.
            IT_DETAIL-ZTPRODW = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTPRODW WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TPRODW.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTPRODK <> 0. " CARI K-PRD
          IF IT_DETAIL-ZTPRODK > VKURANG.
            HITUNG = IT_DETAIL-ZTPRODK - VKURANG.
            TPRODK = IT_DETAIL-ZTPRODK - HITUNG.
            IT_DETAIL-ZTPRODK = HITUNG.
          ELSEIF IT_DETAIL-ZTPRODK <= VKURANG.
            TPRODK = IT_DETAIL-ZTPRODK.
            IT_DETAIL-ZTPRODK = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTPRODK WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TPRODK.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTFGSW <> 0. " CARI W-FGS
          IF IT_DETAIL-ZTFGSW > VKURANG.
            HITUNG = IT_DETAIL-ZTFGSW - VKURANG.
            TFGSW = IT_DETAIL-ZTFGSW - HITUNG.
            IT_DETAIL-ZTFGSW = HITUNG.
          ELSEIF IT_DETAIL-ZTFGSW <= VKURANG.
            TFGSW = IT_DETAIL-ZTFGSW.
            IT_DETAIL-ZTFGSW = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTFGSW WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TFGSW.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTFGSK <> 0. " CARI K-FGS
          IF IT_DETAIL-ZTFGSK > VKURANG.
            HITUNG = IT_DETAIL-ZTFGSK - VKURANG.
            TFGSK = IT_DETAIL-ZTFGSK - HITUNG.
            IT_DETAIL-ZTFGSK = HITUNG.
          ELSEIF IT_DETAIL-ZTFGSK <= VKURANG.
            TFGSK = IT_DETAIL-ZTFGSK.
            IT_DETAIL-ZTFGSK = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTFGSK WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TFGSK.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTFGSJ <> 0. " CARI Jkt-FGS
          IF IT_DETAIL-ZTFGSJ > VKURANG.
            HITUNG = IT_DETAIL-ZTFGSJ - VKURANG.
            TFGSJ = IT_DETAIL-ZTFGSJ - HITUNG.
            IT_DETAIL-ZTFGSJ = HITUNG.
          ELSEIF IT_DETAIL-ZTFGSJ <= VKURANG.
            TFGSJ = IT_DETAIL-ZTFGSJ.
            IT_DETAIL-ZTFGSJ = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTFGSJ WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TFGSJ.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTINTW <> 0. " CARI W-INTRANSIT
          IF IT_DETAIL-ZTINTW > VKURANG.
            HITUNG = IT_DETAIL-ZTINTW - VKURANG.
            TINTW = IT_DETAIL-ZTINTW - HITUNG.
            IT_DETAIL-ZTINTW = HITUNG.
          ELSEIF IT_DETAIL-ZTINTW <= VKURANG.
            TINTW = IT_DETAIL-ZTINTW.
            IT_DETAIL-ZTINTW = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTINTW WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TINTW.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZTINTK <> 0. " CARI K-INTRANSIT
          IF IT_DETAIL-ZTINTK > VKURANG.
            HITUNG = IT_DETAIL-ZTINTK - VKURANG.
            TINTK = IT_DETAIL-ZTINTK - HITUNG.
            IT_DETAIL-ZTINTK = HITUNG.
          ELSEIF IT_DETAIL-ZTINTK <= VKURANG.
            TINTK = IT_DETAIL-ZTINTK.
            IT_DETAIL-ZTINTK = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZTINTK WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - TINTK.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZOTW <> 0. " CARI OTW
          IF IT_DETAIL-ZOTW > VKURANG.
            HITUNG = IT_DETAIL-ZOTW - VKURANG.
            OTW = IT_DETAIL-ZOTW - HITUNG.
            IT_DETAIL-ZOTW = HITUNG.
          ELSEIF IT_DETAIL-ZOTW <= VKURANG.
            OTW = IT_DETAIL-ZOTW.
            IT_DETAIL-ZOTW = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZOTW WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - OTW.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZEXCLUDE <> 0. " CARI OTHERS
          IF IT_DETAIL-ZEXCLUDE > VKURANG.
            HITUNG = IT_DETAIL-ZEXCLUDE - VKURANG.
            TEXCLUDE = IT_DETAIL-ZEXCLUDE - HITUNG.
            IT_DETAIL-ZEXCLUDE = HITUNG.
          ELSEIF IT_DETAIL-ZEXCLUDE <= VKURANG.
            TEXCLUDE = IT_DETAIL-ZEXCLUDE.
            IT_DETAIL-ZEXCLUDE = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZEXCLUDE WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      " END STOCK

      VKURANG = VKURANG - TEXCLUDE.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZOPENPO <> 0. " HITUNG OPEN PO
          IF IT_DETAIL-ZOPENPO > VKURANG.
            HITUNG = IT_DETAIL-ZOPENPO - VKURANG.
            OPENPO = IT_DETAIL-ZOPENPO - HITUNG.
            IT_DETAIL-ZOPENPO = HITUNG.
          ELSEIF IT_DETAIL-ZOPENPO <= VKURANG.
            OPENPO = IT_DETAIL-ZOPENPO.
            IT_DETAIL-ZOPENPO = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZOPENPO WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      VKURANG = VKURANG - OPENPO.
      CLEAR HITUNG.
      IF VKURANG <> 0.
        IF IT_DETAIL-ZQTYTOBESLIT <> 0. " CARI QTY TOBE SLIT
          IF IT_DETAIL-ZQTYTOBESLIT > VKURANG.
            HITUNG = IT_DETAIL-ZQTYTOBESLIT - VKURANG.
            QTYTOBESLIT = IT_DETAIL-ZQTYTOBESLIT - HITUNG.
            IT_DETAIL-ZQTYTOBESLIT = HITUNG.
          ELSEIF IT_DETAIL-ZQTYTOBESLIT <= VKURANG.
            QTYTOBESLIT = IT_DETAIL-ZQTYTOBESLIT.
            IT_DETAIL-ZQTYTOBESLIT = 0.
          ENDIF.
          MODIFY IT_DETAIL TRANSPORTING ZQTYTOBESLIT WHERE VBELN = WA_VBEP-VBELN AND POSNR = WA_VBEP-POSNR.
        ENDIF.
      ENDIF.

      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          INPUT  = WA_VBEP-VBELN
        IMPORTING
          OUTPUT = IT_VBEP2-ZVBELN.
      MOVE-CORRESPONDING IT_DETAIL TO IT_VBEP2.

      IT_VBEP2-VBELN = WA_VBEP-VBELN.
      IT_VBEP2-POSNR = IT_DETAIL-POSNR.
      IT_VBEP2-ETENR = IT_VBEP-ETENR.
      IT_VBEP2-SCHLINE = IDX.
      IT_VBEP2-EDATU = WA_VBEP-EDATU.

      IT_VBEP2-ZQTYD = ZQTYD.
      IT_VBEP2-ZOPENPO = OPENPO.
      IT_VBEP2-ZQTYSLIT = QTYTOBESLIT.
      IT_VBEP2-ZTPRODW = TPRODW.
      IT_VBEP2-ZTPRODK = TPRODK.
      IT_VBEP2-ZTFGSW = TFGSW.
      IT_VBEP2-ZTFGSK = TFGSK.
      IT_VBEP2-ZTFGSJ = TFGSJ.
      IT_VBEP2-ZTINTW = TINTW.
      IT_VBEP2-ZTINTK = TINTK.
      IT_VBEP2-ZOTW = OTW.
      IT_VBEP2-ZEXCLUDE = TEXCLUDE.
      IT_VBEP2-ZKWMENG = WMENG.

      IT_VBEP2-WEIGHTSLIT = QTYTOBESLIT * IT_DETAIL-CONVKG.

      IT_VBEP2-ZKWMENG2 = WMENG. "untuk ke SQL
      IT_VBEP2-ZQTYD2 = ZQTYD.
      IT_VBEP2-ZOPENPO2 = OPENPO.
      IT_VBEP2-ZQTYSLIT2 = QTYTOBESLIT.
      IT_VBEP2-ZTPRODW2 = TPRODW.
      IT_VBEP2-ZTPRODK2 = TPRODK.
      IT_VBEP2-ZTFGSW2 = TFGSW.
      IT_VBEP2-ZTFGSK2 = TFGSK.
      IT_VBEP2-ZTFGSJ2 = TFGSJ.
      IT_VBEP2-ZTINTW2 = TINTW.
      IT_VBEP2-ZTINTK2 = TINTK.
      IT_VBEP2-ZOTW2 = OTW.
      IT_VBEP2-ZEXCLUDE2 = TEXCLUDE. "untuk ke SQL
      PERFORM REPLACE_COMMA_SCLINE.
      APPEND IT_VBEP2.
    ENDLOOP.

    "HITUNG JIKA ADA KELEBIHAN PRODUKSI
    CLEAR : WA_ITDETAIL, WA_VBEP2.
    READ TABLE IT_DETAIL INTO WA_ITDETAIL WITH KEY VBELN = IT_DETAIL-VBELN POSNR = IT_DETAIL-POSNR.
    READ TABLE IT_VBEP2 INTO WA_VBEP2 WITH KEY VBELN = IT_DETAIL-VBELN POSNR = IT_DETAIL-POSNR ETENR = IT_VBEP-ETENR.

    IT_VBEP2-ZQTYD = WA_VBEP2-ZQTYD + WA_ITDETAIL-QTYD.
    IT_VBEP2-ZOPENPO = WA_VBEP2-ZOPENPO + WA_ITDETAIL-ZOPENPO.
    IT_VBEP2-ZQTYSLIT = WA_VBEP2-ZQTYSLIT + WA_ITDETAIL-ZQTYTOBESLIT.
    IT_VBEP2-ZTPRODW = WA_VBEP2-ZTPRODW + WA_ITDETAIL-ZTPRODW.
    IT_VBEP2-ZTPRODK = WA_VBEP2-ZTPRODK + WA_ITDETAIL-ZTPRODK.
    IT_VBEP2-ZTFGSW = WA_VBEP2-ZTFGSW + WA_ITDETAIL-ZTFGSW.
    IT_VBEP2-ZTFGSK = WA_VBEP2-ZTFGSK + WA_ITDETAIL-ZTFGSK.
    IT_VBEP2-ZTFGSJ = WA_VBEP2-ZTFGSJ + WA_ITDETAIL-ZTFGSJ.
    IT_VBEP2-ZTINTW = WA_VBEP2-ZTINTW + WA_ITDETAIL-ZTINTW.
    IT_VBEP2-ZTINTK = WA_VBEP2-ZTINTK + WA_ITDETAIL-ZTINTK.
    IT_VBEP2-ZOTW = WA_VBEP2-ZOTW + WA_ITDETAIL-ZOTW.
    IT_VBEP2-ZEXCLUDE = WA_VBEP2-ZEXCLUDE + WA_ITDETAIL-ZEXCLUDE.

    PERFORM REPLACE_COMMA_SCLINE.

    MODIFY IT_VBEP2 TRANSPORTING VBELN ZQTYD ZOPENPO ZQTYSLIT ZTPRODW ZTPRODK ZTFGSW ZTFGSK ZTFGSJ ZTINTW ZTINTK ZOTW ZEXCLUDE
    WHERE VBELN = IT_DETAIL-VBELN AND POSNR = IT_DETAIL-POSNR AND ETENR = IT_VBEP-ETENR.

    "UPDT ORI DATE UTK NEW SCH LINE
    IT_VBEP2-ORIDATE = ZORIDATENEW.
    IF ZORIDATENEW EQ '19990101'.
      IT_VBEP2-ORIDATE = WA_CDHDR-UDATE.
    ENDIF.

    MODIFY IT_VBEP2 TRANSPORTING ORIDATE WHERE VBELN = IT_DETAIL-VBELN AND POSNR = IT_DETAIL-POSNR AND ORIDATE = '19990101'.
    IF SY-SUBRC <> 0.
*      EXIT.
    ENDIF.
  ENDLOOP.

ENDFORM.                    "SCHEDULE_LINE

