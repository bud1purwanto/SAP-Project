*----------------------------------------------------------------------*
FORM READTEXT USING ID OBJECT NAME.
  CLEAR : IT_LINE.
  REFRESH : IT_LINE.

  CALL FUNCTION 'READ_TEXT'
    EXPORTING
      ID                      = ID
      LANGUAGE                = SY-LANGU
      NAME                    = VVBELN
      OBJECT                  = OBJECT
    TABLES
      LINES                   = IT_LINE
    EXCEPTIONS
      ID                      = 1
      LANGUAGE                = 2
      NAME                    = 3
      NOT_FOUND               = 4
      OBJECT                  = 5
      REFERENCE_CHECK         = 6
      WRONG_ACCESS_TO_ARCHIVE = 7
      OTHERS                  = 8.
ENDFORM.       "readtext

