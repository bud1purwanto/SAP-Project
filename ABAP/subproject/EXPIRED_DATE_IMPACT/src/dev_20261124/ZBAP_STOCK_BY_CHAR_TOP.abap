DEFINE BDC_DYNPRO.
  CLEAR &1.
  &1-PROGRAM = &2.
  &1-DYNPRO = &3.
  &1-DYNBEGIN = 'X'.
  APPEND &1.
END-OF-DEFINITION.

DEFINE BDC_FIELD.
  CLEAR &1.
  &1-FNAM = &2.
  &1-FVAL = &3.
  APPEND &1.
END-OF-DEFINITION.

