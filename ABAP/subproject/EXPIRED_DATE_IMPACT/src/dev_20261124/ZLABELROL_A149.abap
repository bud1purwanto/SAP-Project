REPORT  ZLABELROL_A149.

TABLES: MCHB.

DATA : V_FORMNAME  TYPE TDSFNAME,
       V_FUNCNAME  TYPE RS38L_FNAM,
       V_TAB       TYPE API_VALI OCCURS 0 WITH HEADER LINE,
       CONTROL_PARAMETERS TYPE SSFCTRLOP,
       OUTPUT_OPTIONS TYPE SSFCOMPOP.

DATA: ITAB LIKE ZLABEL_WINDOWS OCCURS 0 WITH HEADER LINE.
DATA: IT_MAP LIKE ZMAP_LABEL OCCURS 0 WITH HEADER LINE.

DATA: TOCHAR TYPE P DECIMALS 0,
      TOCHAR1 TYPE P DECIMALS 2,
      TOCHAR2 TYPE P DECIMALS 1,
      TOSTRG TYPE STRING,
      V_POSTDATE TYPE MKPF-BUDAT,
      V_OBJEK LIKE AUSP-OBJEK,
      V_ATINN LIKE CABN-ATINN,
      V_JRCHARG LIKE MSEG-CHARG,
      V_JRMATNR LIKE MSEG-MATNR,
      V_JRPOST TYPE MKPF-BUDAT,
      V_COMPANY(1),
      V_JRDATE TYPE MKPF-BUDAT,
      VJRMAX(6),
      V_MESSAGE(100),
      V_ERR(1),
      V_MAINSLIT(4),
      V_PRODDATE(6),
      V_ROLLJR(30),
      V_LINE(5),
      V_CODE(5),
      V_MOYE(5),
      V_SEQ(5),
      V_GRADE(5),
      V_AUFNR LIKE MSEG-AUFNR,
      V_MBLNR LIKE MSEG-MBLNR,
      V_SMBLN LIKE MSEG-SMBLN,
      V_COMBI LIKE AFPO-AUFNR,
      V_RESOURCE LIKE CRHD-ARBPL,
      V_CODERESOURCE(1),
      V_VBELN LIKE MSKA-VBELN,
      V_POSNR LIKE MSKA-POSNR,
      V_JUMLAH TYPE I,
      V_SUPPCD(2),
      V_LABELCODE(4),
      V_SOCUSTCODE TYPE VBAP-KDMAT.

"For Code
DATA: IT_DETAIL_KTNG LIKE ZDETAIL_KTNG OCCURS 0 WITH HEADER LINE,
      WA_DETAIL_KTNG LIKE ZDETAIL_KTNG OCCURS 0 WITH HEADER LINE,
      IT_MASTER_KTNG LIKE ZMASTER_KTNG OCCURS 0 WITH HEADER LINE,
      IT_CHAR LIKE CONF_OUT OCCURS 0 WITH HEADER LINE,
      ZCUOBJ LIKE VBAP-CUOBJ,
      ZROLCHAR TYPE ATWTB,
      ZSATUAN(5) TYPE C,
      VMAINX TYPE I,
      VPOSISI(10),
      VPS(2),
      VCOUNT TYPE F,
      V_COUNT TYPE I.

DATA: BEGIN OF IT_CHARG OCCURS 0,
        CHARG LIKE MCHB-CHARG,
        MATNR LIKE MCHB-MATNR,
      END OF IT_CHARG.

DATA: BEGIN OF IT_CHARG_JR OCCURS 0,
        CHARG LIKE MCHB-CHARG,
        MATNR LIKE MCHB-MATNR,
        ERSDA LIKE MCH1-ERSDA,
      END OF IT_CHARG_JR.

SELECT-OPTIONS: P_CHARG FOR MCHB-CHARG.
PARAMETER: V_MATNR LIKE MCHB-MATNR NO-DISPLAY,
           V_COPIES(3) DEFAULT '1'.

START-OF-SELECTION.
  PERFORM GET_DATA_MAIN.
  IF V_ERR EQ 'X'.
    MESSAGE V_MESSAGE TYPE 'I'.
    EXIT.
  ELSEIF ITAB[] IS INITIAL.
    MESSAGE 'Data tidak ditemukan' TYPE 'I'.
    EXIT.
  ELSE.
    PERFORM PRINT_DATA.
  ENDIF.

END-OF-SELECTION.

*&---------------------------------------------------------------------*
*&      Form  GET_DATA_MAIN
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_DATA_MAIN.

  "Get data Batch & Material
  REFRESH: IT_CHARG.
  LOOP AT P_CHARG.
    SELECT SINGLE CHARG MATNR INTO IT_CHARG FROM MCH1
      WHERE CHARG = P_CHARG-LOW.
    IF SY-SUBRC = 0.
      APPEND IT_CHARG.
    ENDIF.
  ENDLOOP.
  DELETE ADJACENT DUPLICATES FROM IT_CHARG COMPARING CHARG.

  LOOP AT IT_CHARG.
    CLEAR: V_VBELN, V_POSNR.

    ITAB-VBATCH = IT_CHARG-CHARG.

    IF IT_CHARG-CHARG IS NOT INITIAL AND IT_CHARG-MATNR IS NOT INITIAL.
      REFRESH V_TAB.
      CLEAR V_TAB.
      CALL FUNCTION 'QC01_BATCH_VALUES_READ'
        EXPORTING
          I_VAL_MATNR    = IT_CHARG-MATNR
          I_VAL_CHARGE   = IT_CHARG-CHARG
        TABLES
          T_VAL_TAB      = V_TAB
        EXCEPTIONS
          NO_CLASS       = 1
          INTERNAL_ERROR = 2
          NO_VALUES      = 3
          NO_CHARS       = 4
          OTHERS         = 5.
    ENDIF.

    IF SY-SUBRC NE 0.
      CONTINUE.
    ENDIF.

    READ TABLE V_TAB WITH KEY ATNAM = 'ZZLABEL'.
    IF SY-SUBRC EQ 0.
      CLEAR : V_LABELCODE.
      V_LABELCODE = V_TAB-ATWRT.
      SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_MAP FROM ZMAP_LABEL WHERE CODE = V_TAB-ATWRT.
      IF SY-SUBRC EQ 0.
        READ TABLE IT_MAP INDEX 1.
        V_FORMNAME = IT_MAP-FORM_ROLL.
        V_SUPPCD  = IT_MAP-TEXT1.
      ELSE.
        CONTINUE.
      ENDIF.
    ENDIF.

    "Check SO
    SELECT SINGLE VBELN POSNR INTO (ITAB-VVBELN, ITAB-VPOSNR)
      FROM MSKA
     WHERE MATNR = IT_CHARG-MATNR
       AND CHARG = IT_CHARG-CHARG
       AND ( KALAB > 0 OR KAINS > 0 OR KASPE > 0 ).

    "Get Cust Material
    IF SY-SUBRC = 0.
      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          INPUT  = ITAB-VVBELN
        IMPORTING
          OUTPUT = V_VBELN.

      CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
        EXPORTING
          INPUT  = ITAB-VPOSNR
        IMPORTING
          OUTPUT = V_POSNR.
      CONCATENATE V_VBELN V_POSNR INTO ITAB-VSONUM_ITEM SEPARATED BY '/'.
    ENDIF.

    ITAB-VDERIVATIVEMS  = '00'.
    ITAB-VPOSITIONMS    = '00'.
    ITAB-VDERIVATIVESS  = '00'.
    ITAB-VPOSITIONSS    = '00'.

    "Get Main Characteristic
    SORT V_TAB BY ATNAM ASCENDING. "Sorting dilakukan untuk memprioritaskan value thicknes apabila terdapat Alias, sehingga ZZALIAS dilektakkan di paling akhir.
    LOOP AT V_TAB.
      IF V_TAB-ATNAM = 'ZZTYPE'.
        ITAB-VTYPE = V_TAB-ATWTB.
         READ TABLE V_TAB WITH KEY ATNAM = 'ZZALIAS'.
         IF SY-SUBRC = 0.
          SPLIT V_TAB-ATWRT AT '-' INTO ITAB-VTYPE ITAB-VTHICK.
         ENDIF.
      ELSEIF V_TAB-ATNAM = 'ZZWIDTH'.
        TOCHAR = V_TAB-ATFLV.
        TOSTRG = TOCHAR.
        ITAB-VWIDTH = TOSTRG.
      ELSEIF V_TAB-ATNAM = 'ZZLENGTH'.
        TOCHAR = V_TAB-ATFLV.
        TOSTRG = TOCHAR.
        ITAB-VLENGTH = TOSTRG.
      ELSEIF V_TAB-ATNAM = 'ZZTHICKNESS'.
        TOCHAR2 = V_TAB-ATFLV.
        TOSTRG = TOCHAR2.
        ITAB-VTHICK = TOSTRG.
      ELSEIF V_TAB-ATNAM = 'ZZNOMORROLL'.
        ITAB-VROLL = V_TAB-ATWRT.
      ELSEIF V_TAB-ATNAM = 'ZZDERIVATIVEMS'.
        ITAB-VDERIVATIVEMS = V_TAB-ATWRT.
      ELSEIF V_TAB-ATNAM = 'ZZPOSITIONMS'.
        ITAB-VPOSITIONMS = V_TAB-ATWRT.
      ELSEIF V_TAB-ATNAM = 'ZZDERIVATIVESS'.
        ITAB-VDERIVATIVESS = V_TAB-ATWRT.
      ELSEIF V_TAB-ATNAM = 'ZZPOSITIONSS'.
        ITAB-VPOSITIONSS = V_TAB-ATWRT.
      ENDIF.
    ENDLOOP.

    CONCATENATE IT_CHARG-CHARG ITAB-VDERIVATIVEMS ITAB-VPOSITIONMS ITAB-VDERIVATIVESS ITAB-VPOSITIONSS INTO ITAB-VBARCODETRIAS.

    CALL FUNCTION 'CONVERSION_EXIT_BAS36_OUTPUT'
      EXPORTING
        INPUT          = ITAB-VBARCODETRIAS
      IMPORTING
        OUTPUT         = ITAB-VBARCODETRIAS
      EXCEPTIONS
        INVALID_FORMAT = 1
        OTHERS         = 2.

    CONCATENATE IT_CHARG-CHARG '-' ITAB-VBARCODETRIAS INTO ITAB-VBARCTEXTTRIAS.

*    "Get Production Date
*    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
*      EXPORTING
*        MATNR = IT_CHARG-MATNR
*        CHARG = IT_CHARG-CHARG
*      IMPORTING
*        PDATE = V_POSTDATE.
*
*    CONCATENATE V_POSTDATE+2(2) V_POSTDATE+4(2) V_POSTDATE+6(2) INTO ITAB-VEXPDATE.
*    CONCATENATE V_POSTDATE(4) V_POSTDATE+4(2) V_POSTDATE+6(2) INTO ITAB-VPOSTDATE SEPARATED BY '/'.

    PERFORM GET_JUMBO_ROLL.

    " Start add by Fiqih 12.02.2026
    IF V_ERR EQ 'X'.
      EXIT.
    ENDIF.
    " End add by Fiqih 12.02.2026

    CONCATENATE V_JRDATE+2(2) V_JRDATE+4(2) V_JRDATE+6(2) INTO ITAB-VEXPDATE.
    CONCATENATE V_JRDATE(4) V_JRDATE+4(2) V_JRDATE+6(2) INTO ITAB-VPOSTDATE SEPARATED BY '/'.

    "Get customer material number/itemcode
    CLEAR : V_SOCUSTCODE.
    SELECT SINGLE KDMAT INTO V_SOCUSTCODE FROM VBAP WHERE VBELN = ITAB-VVBELN AND POSNR = ITAB-VPOSNR.

    IF V_SOCUSTCODE EQ ''. "Added by Fany Parama (24.09.2024)
      V_MESSAGE = 'Customer material number/item code belum diinput, silahkan menghubungi PPIC !'.
      MESSAGE V_MESSAGE TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ELSE.
       IF ITAB-VSONUM_ITEM NE ''.
         PERFORM GET_CODE USING ITAB-VVBELN ITAB-VPOSNR ITAB-VTYPE ITAB-VTHICK ITAB-VWIDTH ITAB-VLENGTH ITAB-VEXPDATE ITAB-VROLL(1) V_JRDATE 4 V_LABELCODE CHANGING ITAB-VPARTNO ITAB-VBARCODECUST.
       ENDIF.
    ENDIF.

    DO V_COPIES TIMES.
      APPEND ITAB.
    ENDDO.
    CLEAR: ITAB.
  ENDLOOP.

ENDFORM.                    "GET_DATA_MAIN

*&---------------------------------------------------------------------*
*&      Form  PRINT_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM PRINT_DATA.
  CALL FUNCTION 'SSF_FUNCTION_MODULE_NAME'
    EXPORTING
      FORMNAME           = V_FORMNAME
    IMPORTING
      FM_NAME            = V_FUNCNAME
    EXCEPTIONS
      NO_FORM            = 1
      NO_FUNCTION_MODULE = 2
      OTHERS             = 3.

  CONTROL_PARAMETERS-NO_DIALOG = 'X'.
  CONTROL_PARAMETERS-PREVIEW = 'X'.

  CALL FUNCTION V_FUNCNAME
    EXPORTING
      CONTROL_PARAMETERS = CONTROL_PARAMETERS
      OUTPUT_OPTIONS     = OUTPUT_OPTIONS
    TABLES
      ITAB               = ITAB.
ENDFORM.                    "PRINT_DATA

*&---------------------------------------------------------------------*
*&      Form  GET_JUMBO_ROLL
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GET_JUMBO_ROLL.
  REFRESH: IT_CHARG_JR.
  CLEAR: IT_CHARG_JR, V_OBJEK, V_JRCHARG, V_JRDATE, V_JRMATNR, V_JRPOST, V_LINE, V_CODE, V_MOYE, V_SEQ, V_GRADE, V_AUFNR, V_MBLNR, V_SMBLN, V_COMBI, V_RESOURCE, V_CODERESOURCE.

* Start Comented - Old Method (get JR no by SR no) - 12.02.2026
*  SELECT SINGLE ATINN INTO V_ATINN FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
*  SPLIT ITAB-VROLL AT SPACE INTO V_LINE V_CODE V_MOYE V_SEQ V_GRADE.
*  CONCATENATE V_LINE V_CODE V_MOYE V_SEQ INTO V_ROLLJR SEPARATED BY SPACE.
*
*  SELECT MATNR CHARG ERSDA
*    INTO CORRESPONDING FIELDS OF TABLE IT_CHARG_JR
*    FROM AUSP
*    JOIN MCH1 ON AUSP~OBJEK EQ MCH1~CUOBJ_BM
*   WHERE ATINN = V_ATINN AND KLART = '023' AND ATWRT = V_ROLLJR.
*
*  IF SY-SUBRC EQ 0.
*    SORT IT_CHARG_JR BY ERSDA DESCENDING.
*    READ TABLE IT_CHARG_JR INDEX 1.
*
*    IF SY-SUBRC EQ 0.
*      V_JRMATNR   = IT_CHARG_JR-MATNR.
*      V_JRCHARG   = IT_CHARG_JR-CHARG.
*
*      ITAB-VPOINT = V_JRCHARG+4(6).
*    ENDIF.
*  ENDIF.

* Start add by Fiqih 12.02.2026 - Find Jumbo Roll use Batch and Production Order
  IF ITAB-VPOINT EQ ''.
    CLEAR : IT_CHARG_JR.
      CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
      EXPORTING
        CHARG_S          = IT_CHARG-CHARG
      IMPORTING
        MATNR_J          = V_JRMATNR
        CHARG_J          = V_JRCHARG.

      IF V_JRCHARG IS NOT INITIAL.
         ITAB-VPOINT = V_JRCHARG+4(6).
      ENDIF.
  ENDIF.
* End add by Fiqih 12.02.2026 - Find Jumbo Roll use Batch and Production Order

  IF ITAB-VPOINT EQ ''.
    V_MESSAGE = 'Batch jumbo roll tidak ditemukan...!'.
    V_ERR = 'X'.
    EXIT.
  ENDIF.

  SELECT AUFNR MBLNR INTO (V_AUFNR, V_MBLNR) FROM MSEG WHERE CHARG = IT_CHARG-CHARG AND BWART = '101'.
    SELECT SINGLE SMBLN INTO V_SMBLN FROM MSEG WHERE SMBLN = V_MBLNR. " CEK ADA PEMBATALAN (102) ATAU TIDAK
    IF SY-SUBRC NE 0.
      EXIT.
    ENDIF.
  ENDSELECT.

  IF V_AUFNR = ''.
    EXIT.
  ENDIF.

  SELECT SINGLE AUFNR INTO V_COMBI FROM AFPO WHERE MILL_OC_AUFNR_U = V_AUFNR.
  IF SY-SUBRC NE 0.
    EXIT.
  ENDIF.

  SELECT SINGLE CRHD~ARBPL INTO V_RESOURCE
    FROM AFRU JOIN CRHD ON AFRU~ARBID = CRHD~OBJID WHERE AFRU~AUFNR = V_COMBI.

  IF V_RESOURCE EQ 'PATL04-W'.
    V_CODERESOURCE = 1.
  ELSEIF V_RESOURCE EQ 'PATL05-W'.
    V_CODERESOURCE = 2.
  ELSEIF V_RESOURCE EQ 'PATL06-W'.
    V_CODERESOURCE = 3.
  ELSEIF V_RESOURCE EQ 'PATL07-W'.
    V_CODERESOURCE = 4.
  ELSEIF V_RESOURCE EQ 'PATL08-W'.
    V_CODERESOURCE = 5.
  ELSEIF V_RESOURCE EQ 'PDAHUA-W'.
    V_CODERESOURCE = 6.
  ELSEIF V_RESOURCE EQ 'PPSM-W'.
    V_CODERESOURCE = 8.
  ENDIF.

  "Get Manufacturing Date JR
  IF V_JRCHARG IS NOT INITIAL OR V_JRCHARG NE ''.
    CALL FUNCTION 'Z_GET_PRODUCTION_DATE'
      EXPORTING
        MATNR = V_JRMATNR
        CHARG = V_JRCHARG
      IMPORTING
        PDATE = V_JRPOST.
  ENDIF.

*  V_JRDATE = V_JRPOST+2(2) && V_JRPOST+4(2) && V_JRPOST+6(2).
  V_JRDATE = V_JRPOST.
ENDFORM.                    " GET_JUMBO_ROLL

*&---------------------------------------------------------------------*
*&      Form  GET_CODE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM GET_CODE USING VBELN POSNR VTYPE THICK WIDTH LENGTH DATE LINE JRDATE COMPANY LABELCODE CHANGING CODE BARCODE.
  CLEAR: IT_DETAIL_KTNG, IT_MASTER_KTNG.
  REFRESH: IT_DETAIL_KTNG, IT_MASTER_KTNG.
  CLEAR: TOCHAR2.

  TOCHAR2 = THICK.

  "Cek batch
  SELECT SINGLE * INTO CORRESPONDING FIELDS OF IT_DETAIL_KTNG FROM ZDETAIL_KTNG WHERE BATCH = IT_CHARG-CHARG AND DELETION = ''.

  "Batch sudah pernah diprint
  IF SY-SUBRC = 0.
*    CONDENSE IT_DETAIL_KTNG-KTNGCODE.
*    CONDENSE IT_DETAIL_KTNG-JRNUMB.
*    CONDENSE IT_DETAIL_KTNG-MIDROLL.
*    CONDENSE IT_DETAIL_KTNG-TS.
*    CONDENSE IT_DETAIL_KTNG-PS.

    " Added by William at 16.06.2022 (Get first production date of JR for case reprint label)
    ITAB-VPOSTDATE = V_JRDATE+0(2).
    CONCATENATE ITAB-VPOSTDATE IT_DETAIL_KTNG-JRDATE+0(2) INTO ITAB-VPOSTDATE.
    CONCATENATE ITAB-VPOSTDATE IT_DETAIL_KTNG-JRDATE+2(2) IT_DETAIL_KTNG-JRDATE+4(2) INTO ITAB-VPOSTDATE SEPARATED BY '/'.

    CODE    = IT_DETAIL_KTNG-KTNGCODE.
    BARCODE = IT_DETAIL_KTNG-NOROLL.
*    CONCATENATE 'L' IT_DETAIL_KTNG-KTNGCODE '48' DATE '00' LINE IT_DETAIL_KTNG-JRNUMB IT_DETAIL_KTNG-MIDROLL IT_DETAIL_KTNG-TS IT_DETAIL_KTNG-PS INTO BARCODE.
  ELSE.
    "CEK SO
    CLEAR: IT_DETAIL_KTNG.
    REFRESH: IT_DETAIL_KTNG.
    SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_DETAIL_KTNG FROM ZDETAIL_KTNG WHERE SONUM = VBELN AND SOITEM = POSNR  AND DELETION = ''.

    "Kondisi salah satu batch pernah diprint
    IF SY-SUBRC = 0.
      REFRESH: IT_CHAR.
      CLEAR: ZROLCHAR, ZSATUAN, V_COUNT, ZCUOBJ.
      SELECT SINGLE VBAP~CUOBJ INTO ZCUOBJ FROM VBAP WHERE VBAP~VBELN = VBELN AND VBAP~POSNR = POSNR.

      CALL FUNCTION 'VC_I_GET_CONFIGURATION'
        EXPORTING
          INSTANCE            = ZCUOBJ
        TABLES
          CONFIGURATION       = IT_CHAR
        EXCEPTIONS
          INSTANCE_NOT_FOUND  = 1
          INTERNAL_ERROR      = 2
          NO_CLASS_ALLOCATION = 3
          INSTANCE_NOT_VALID  = 4
          OTHERS              = 5.

      READ TABLE IT_CHAR WITH KEY ATNAM = 'ZZNUMBEROFROLL'.
      SPLIT IT_CHAR-ATWTB AT SPACE INTO ZROLCHAR ZSATUAN.
      REPLACE ALL OCCURRENCES OF ',' IN ZROLCHAR WITH ' '.

      SELECT COUNT(*) INTO V_COUNT FROM ZDETAIL_KTNG
        WHERE SONUM = VBELN AND SOITEM = POSNR AND DELETION = ''.

      IF V_COUNT = ZROLCHAR.
        CONCATENATE 'Nomor Roll KT&G Untuk SO ' VBELN ' - ' POSNR ' sudah terpenuhi' INTO V_MESSAGE.
        MESSAGE V_MESSAGE TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ENDIF.

      CLEAR: IT_MASTER_KTNG. REFRESH: IT_MASTER_KTNG.

      SELECT SINGLE * INTO CORRESPONDING FIELDS OF IT_MASTER_KTNG FROM ZMASTER_KTNG
         WHERE TYPE = VTYPE AND WIDTH = WIDTH AND THICKNESS = TOCHAR2 AND LENGTH = LENGTH AND LABEL_CODE = LABELCODE.

      IF SY-SUBRC NE 0.
        CLEAR:TOSTRG.
        TOSTRG = TOCHAR2.
        CONCATENATE 'Product code type:' VTYPE 'thickness:' TOSTRG 'width:' WIDTH 'length:' LENGTH 'label:' LABELCODE 'belum ada' INTO V_MESSAGE SEPARATED BY SPACE.
        MESSAGE V_MESSAGE TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ELSE.
         IF V_SOCUSTCODE NE IT_MASTER_KTNG-CODE. "Added by Fany Parama (24.09.2024)
           V_MESSAGE = 'Product code yang di input pada SO dan master data tidak sama.'.
           MESSAGE V_MESSAGE TYPE 'I'.
           LEAVE LIST-PROCESSING.
        ENDIF.
      ENDIF.

      IF IT_MASTER_KTNG-ROLL = '24'.
        VPOSISI = '12'.
      ELSEIF IT_MASTER_KTNG-ROLL = '18' OR IT_MASTER_KTNG-ROLL = '36' OR IT_MASTER_KTNG-ROLL = '63' OR IT_MASTER_KTNG-ROLL = '81'.
        VPOSISI = '09'.
      ENDIF.

      CLEAR: WA_DETAIL_KTNG, VPS.
      SORT IT_DETAIL_KTNG BY VCOUNT DESCENDING.
      READ TABLE IT_DETAIL_KTNG INTO WA_DETAIL_KTNG INDEX 1.

      IF WA_DETAIL_KTNG-PS EQ VPOSISI.
        VPS = '01'.
        WA_DETAIL_KTNG-TS = WA_DETAIL_KTNG-TS + 1.
        CONDENSE WA_DETAIL_KTNG-TS.
        IF WA_DETAIL_KTNG-TS > IT_MASTER_KTNG-MAX_SS.
          WA_DETAIL_KTNG-TS = 1.
          WA_DETAIL_KTNG-MIDROLL = WA_DETAIL_KTNG-MIDROLL + 1.
          CONDENSE WA_DETAIL_KTNG-MIDROLL.
          IF WA_DETAIL_KTNG-MIDROLL > IT_MASTER_KTNG-MAX_MS.
            WA_DETAIL_KTNG-MIDROLL = 1.
            WA_DETAIL_KTNG-JRNUMB = WA_DETAIL_KTNG-JRNUMB + 1.
            CONDENSE WA_DETAIL_KTNG-JRNUMB.
          ENDIF.
        ENDIF.
      ELSE.
        VPS = WA_DETAIL_KTNG-PS + 1.
      ENDIF.

      PERFORM INPUT_FORMAT USING VPS CHANGING VPS.
      PERFORM INPUT_FORMAT USING WA_DETAIL_KTNG-TS CHANGING WA_DETAIL_KTNG-TS.
      PERFORM INPUT_FORMAT USING WA_DETAIL_KTNG-JRNUMB CHANGING VJRMAX.

      SELECT MAX( ID ) INTO WA_DETAIL_KTNG-ID FROM ZDETAIL_KTNG.
      WA_DETAIL_KTNG-ID             = WA_DETAIL_KTNG-ID + 1.
      WA_DETAIL_KTNG-PS             = VPS.
      WA_DETAIL_KTNG-VCOUNT         = WA_DETAIL_KTNG-VCOUNT + 1.
      WA_DETAIL_KTNG-JRNUMB         = VJRMAX.
      WA_DETAIL_KTNG-BATCH          = IT_CHARG-CHARG.
      WA_DETAIL_KTNG-SONUM          = VBELN.
      WA_DETAIL_KTNG-SOITEM         = POSNR.
      WA_DETAIL_KTNG-TIME           = SY-TIMLO.
      WA_DETAIL_KTNG-COMPANY        = COMPANY.
      PERFORM DATE_FORMAT USING SY-DATUM CHANGING WA_DETAIL_KTNG-CREATE_ON.

      CONDENSE WA_DETAIL_KTNG-JRNUMB.
      CONDENSE WA_DETAIL_KTNG-JRDATE.
      CONDENSE WA_DETAIL_KTNG-KTNGCODE.
      CONDENSE WA_DETAIL_KTNG-MIDROLL.
      CONDENSE WA_DETAIL_KTNG-SLITT_MCHN.
      CONDENSE WA_DETAIL_KTNG-TS.
      CONDENSE WA_DETAIL_KTNG-PS.
      CODE = WA_DETAIL_KTNG-KTNGCODE.

      DATE = WA_DETAIL_KTNG-JRDATE.
      ITAB-VPOSTDATE = V_JRDATE+0(2).
      CONCATENATE ITAB-VPOSTDATE WA_DETAIL_KTNG-JRDATE+0(2) INTO ITAB-VPOSTDATE.
      CONCATENATE ITAB-VPOSTDATE WA_DETAIL_KTNG-JRDATE+2(2) WA_DETAIL_KTNG-JRDATE+4(2) INTO ITAB-VPOSTDATE SEPARATED BY '/'.

      " Added by William at 08.07.2022 (new production line digit system)
      PERFORM GET_PROD_LINE USING LINE WA_DETAIL_KTNG-KTNGCODE CHANGING LINE.

      CONCATENATE 'L' WA_DETAIL_KTNG-KTNGCODE V_SUPPCD DATE '00' LINE WA_DETAIL_KTNG-JRNUMB WA_DETAIL_KTNG-MIDROLL WA_DETAIL_KTNG-TS WA_DETAIL_KTNG-PS INTO BARCODE.

      CLEAR V_JUMLAH.
      V_JUMLAH = STRLEN( BARCODE ).
      IF V_JUMLAH NE 33.
        V_MESSAGE = 'Jumlah karakter barcode tidak sesuai (33 Karakter)...!'.
        MESSAGE V_MESSAGE TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ENDIF.

      WA_DETAIL_KTNG-NOROLL          = BARCODE.

      "Update Detail
      MODIFY ZDETAIL_KTNG FROM WA_DETAIL_KTNG.
      IF SY-SUBRC <> 0.
        MESSAGE 'Gagal Update Detail' TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ENDIF.
      COMMIT WORK.

      CLEAR: WA_DETAIL_KTNG, IT_DETAIL_KTNG.
      REFRESH: IT_DETAIL_KTNG.

    ELSE.
      "Kondisi  Baru Print dengan SO Baru
      CLEAR: IT_MASTER_KTNG, IT_DETAIL_KTNG, VJRMAX.
      REFRESH: IT_MASTER_KTNG, IT_DETAIL_KTNG.

      SELECT SINGLE * INTO CORRESPONDING FIELDS OF IT_MASTER_KTNG FROM ZMASTER_KTNG
         WHERE TYPE = VTYPE AND WIDTH = WIDTH AND THICKNESS = TOCHAR2 AND LENGTH = LENGTH AND LABEL_CODE = LABELCODE.

      IF SY-SUBRC NE 0.
        CLEAR:TOSTRG.
        TOSTRG = TOCHAR2.
        CONCATENATE 'Product code type:' VTYPE 'thickness:' TOSTRG 'width:' WIDTH 'length:' LENGTH 'label:' LABELCODE 'belum ada' INTO V_MESSAGE SEPARATED BY SPACE.
        MESSAGE V_MESSAGE TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ELSE.
        IF V_SOCUSTCODE NE IT_MASTER_KTNG-CODE. "Added by Fany Parama (24.09.2024)
           V_MESSAGE = 'Product code yang di input pada SO dan master data tidak sama.'.
           MESSAGE V_MESSAGE TYPE 'I'.
           LEAVE LIST-PROCESSING.
        ENDIF.
      ENDIF.

      CODE = IT_MASTER_KTNG-CODE.

      "Set Current Value
      IF IT_MASTER_KTNG-MS = IT_MASTER_KTNG-MAX_MS.
        "Reset Main Slit
        IT_MASTER_KTNG-MS = '1'.
        "Set JR Code
        IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-NEXT_VALUE + 1.
        CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
        PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-NEXT_VALUE CHANGING IT_MASTER_KTNG-NEXT_VALUE.
        PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING IT_MASTER_KTNG-MAX_VALUE.
        "Reset JR Code
        IF IT_MASTER_KTNG-NEXT_VALUE > IT_MASTER_KTNG-MAX_VALUE.
          IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-MIN_VALUE.
          PERFORM DATE_FORMAT USING SY-DATUM CHANGING IT_MASTER_KTNG-LAST_RESET.
        ENDIF.
      ELSE.
        "Set Main Slit
        IT_MASTER_KTNG-MS = IT_MASTER_KTNG-MS + 1.
      ENDIF.

      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-NEXT_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-NEXT_VALUE = VJRMAX.
      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-MAX_VALUE = VJRMAX.

      "Generate barcode untuk batch
      CONDENSE IT_MASTER_KTNG-CODE.
      CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
      CONDENSE IT_MASTER_KTNG-MS.

      " Added by William at 08.07.2022 (new production line digit system)
      PERFORM GET_PROD_LINE USING LINE IT_MASTER_KTNG-CODE CHANGING LINE.

      CONCATENATE 'L' IT_MASTER_KTNG-CODE V_SUPPCD DATE '00' LINE IT_MASTER_KTNG-NEXT_VALUE IT_MASTER_KTNG-MS '01' '01' INTO BARCODE.

      CLEAR V_JUMLAH.
      V_JUMLAH = STRLEN( BARCODE ).
      IF V_JUMLAH NE 33.
        V_MESSAGE = 'Jumlah karakter barcode tidak sesuai (33 Karakter)...!'.
        MESSAGE V_MESSAGE TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ENDIF.

      SELECT MAX( ID ) INTO IT_DETAIL_KTNG-ID FROM ZDETAIL_KTNG.
      IT_DETAIL_KTNG-ID             = IT_DETAIL_KTNG-ID + 1.
      IT_DETAIL_KTNG-BATCH          = IT_CHARG-CHARG.
      IT_DETAIL_KTNG-SONUM          = VBELN.
      IT_DETAIL_KTNG-SOITEM         = POSNR.
      IT_DETAIL_KTNG-TIME           = SY-TIMLO.
      IT_DETAIL_KTNG-KTNGCODE       = IT_MASTER_KTNG-CODE.
      IT_DETAIL_KTNG-COMPANY        = COMPANY.
      IT_DETAIL_KTNG-JRNUMB         = IT_MASTER_KTNG-NEXT_VALUE.
      IT_DETAIL_KTNG-JRDATE         = DATE.
      IT_DETAIL_KTNG-MIDROLL        = IT_MASTER_KTNG-MS.
      IT_DETAIL_KTNG-SLITT_MCHN     = V_CODERESOURCE.
      IT_DETAIL_KTNG-TS             = '01'.
      IT_DETAIL_KTNG-PS             = '01'.
      IT_DETAIL_KTNG-VCOUNT         = 1.
      IT_DETAIL_KTNG-NOROLL          = BARCODE.
      PERFORM DATE_FORMAT USING SY-DATUM CHANGING IT_DETAIL_KTNG-CREATE_ON.

      CONDENSE IT_DETAIL_KTNG-COMPANY.
      CONDENSE IT_DETAIL_KTNG-MIDROLL.
      CONDENSE IT_DETAIL_KTNG-TS.
      CONDENSE IT_DETAIL_KTNG-PS.

      MODIFY ZDETAIL_KTNG FROM IT_DETAIL_KTNG.
      IF SY-SUBRC <> 0.
        MESSAGE 'GAGAL Update Detail' TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ENDIF.
      COMMIT WORK.

      "Hitung RANGE NUMBER dan Reset NEXT VALUE
      REFRESH: IT_CHAR.
      CLEAR: ZROLCHAR, ZSATUAN.
      SELECT SINGLE VBAP~CUOBJ INTO ZCUOBJ FROM VBAP WHERE VBAP~VBELN = VBELN AND VBAP~POSNR = POSNR.

      CALL FUNCTION 'VC_I_GET_CONFIGURATION'
        EXPORTING
          INSTANCE            = ZCUOBJ
        TABLES
          CONFIGURATION       = IT_CHAR
        EXCEPTIONS
          INSTANCE_NOT_FOUND  = 1
          INTERNAL_ERROR      = 2
          NO_CLASS_ALLOCATION = 3
          INSTANCE_NOT_VALID  = 4
          OTHERS              = 5.

      READ TABLE IT_CHAR WITH KEY ATNAM = 'ZZNUMBEROFROLL'.
      SPLIT IT_CHAR-ATWTB AT SPACE INTO ZROLCHAR ZSATUAN.
      REPLACE ALL OCCURRENCES OF ',' IN ZROLCHAR WITH ' '.

      "Count Pallet
      CLEAR: VCOUNT.
      VCOUNT = ( ZROLCHAR / IT_MASTER_KTNG-ROLL ).
      VCOUNT = CEIL( VCOUNT ) - 1.

      DO VCOUNT TIMES.
        IT_MASTER_KTNG-MS = IT_MASTER_KTNG-MS + 1.
        CONDENSE IT_MASTER_KTNG-MS.
        IF IT_MASTER_KTNG-MS > IT_MASTER_KTNG-MAX_MS.
          IT_MASTER_KTNG-MS = '1'.
          IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-NEXT_VALUE + 1.
          CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
          PERFORM OUTPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING IT_MASTER_KTNG-MAX_VALUE.
          IF IT_MASTER_KTNG-NEXT_VALUE > IT_MASTER_KTNG-MAX_VALUE.
            IT_MASTER_KTNG-NEXT_VALUE = IT_MASTER_KTNG-MIN_VALUE.
            CONDENSE IT_MASTER_KTNG-NEXT_VALUE.
            PERFORM DATE_FORMAT USING SY-DATUM CHANGING IT_MASTER_KTNG-LAST_RESET.
          ENDIF.
        ENDIF.
      ENDDO.

      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-NEXT_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-NEXT_VALUE = VJRMAX.
      CLEAR VJRMAX.
      PERFORM INPUT_FORMAT USING IT_MASTER_KTNG-MAX_VALUE CHANGING VJRMAX.
      IT_MASTER_KTNG-MAX_VALUE = VJRMAX.

      APPEND IT_MASTER_KTNG.
      MODIFY ZMASTER_KTNG FROM TABLE IT_MASTER_KTNG.
      IF SY-SUBRC <> 0.
        MESSAGE 'Gagal Update Master' TYPE 'I'.
        LEAVE LIST-PROCESSING.
      ENDIF.
      COMMIT WORK.
      CLEAR: IT_MASTER_KTNG, IT_DETAIL_KTNG.
      REFRESH: IT_MASTER_KTNG, IT_DETAIL_KTNG.

    ENDIF.

  ENDIF.
ENDFORM.                    "GET_CODE

*&---------------------------------------------------------------------*
*&      Form  GET_PROD_LINE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->LINE       text
*      -->CODE       text
*      -->NEW_LINE   text
*----------------------------------------------------------------------*
FORM GET_PROD_LINE USING LINE CODE CHANGING NEW_LINE.
  DATA: IT_ZHMS LIKE ZHMS OCCURS 0 WITH HEADER LINE.
  DATA: NEW_CODE LIKE ZHMS-EXIDV.

  CALL FUNCTION 'CONVERSION_EXIT_ALPHA_INPUT'
    EXPORTING
      INPUT  = CODE
    IMPORTING
      OUTPUT = NEW_CODE.

  SELECT SINGLE * INTO IT_ZHMS FROM ZHMS
  WHERE EXIDV = NEW_CODE AND PALID = LINE AND NOCOA = 'MASTER LINE KT&G'.

  IF SY-SUBRC = 0.
    READ TABLE IT_ZHMS INDEX 1.
    NEW_LINE = IT_ZHMS-GWEIGHT.
  ELSE.
    NEW_LINE = LINE.
  ENDIF.

  CLEAR: IT_ZHMS.
  REFRESH: IT_ZHMS.

ENDFORM.                    "GET_PROD_LINE

