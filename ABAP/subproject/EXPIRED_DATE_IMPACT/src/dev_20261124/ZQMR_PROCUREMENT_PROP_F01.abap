*&---------------------------------------------------------------------*
*&  Include           ZQMR_PROCUREMENT_PROP_F01
*&---------------------------------------------------------------------*
INCLUDE Z_PROG_INFO.

AT SELECTION-SCREEN.
  CASE SY-UCOMM.
    WHEN 'INFO'.
      PERFORM F_PROG_INFO USING V_PROG.
  ENDCASE.

START-OF-SELECTION.

  DATA: BEGIN OF IT_T001W OCCURS 0,
        WERKS LIKE T001W-WERKS,
        END OF IT_T001W.
  DATA: DMESSAGE(100).

  SELECT WERKS INTO TABLE IT_T001W FROM T001W WHERE WERKS IN P_PLANT.
  IF SY-SUBRC NE 0.
    MESSAGE 'No Plant Found...' TYPE 'I'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  LOOP AT IT_T001W.
    AUTHORITY-CHECK OBJECT 'Z_WERKS' ID 'ZWERKS' FIELD IT_T001W-WERKS.
    IF SY-SUBRC NE 0.
      CONCATENATE 'No Authorization for Plant' IT_T001W-WERKS INTO DMESSAGE SEPARATED BY SPACE.
      MESSAGE DMESSAGE TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.
  ENDLOOP.


*RM TYPE 1
  CONCATENATE P_DATE-LOW+6(2) P_DATE-LOW+4(2) P_DATE-LOW+0(4) INTO DATES SEPARATED BY '.'.
  CONCATENATE P_DATE-HIGH+6(2) P_DATE-HIGH+4(2) P_DATE-HIGH+0(4) INTO DATEF SEPARATED BY '.'.

  IF MTS1 EQ 'X'.
    IF RT1 EQ 'X'.
      PERFORM GETDATAMTS1T1.
      PERFORM ADD_DATA.
      PERFORM DISPLAY_REPORT_MTS1T1.
    ELSE.
      PERFORM GETDATAMTS1T2.
      IF ITMTSIT2[] IS  NOT INITIAL.
        PERFORM CREATEDINAMYCIT_MTS1T2.
      ENDIF.
    ENDIF.
*RM TYPE
  ELSEIF MTS2 EQ 'X'.
    IF RT1 EQ 'X'.
      PERFORM GETDATAMTS2T1.
      PERFORM DISPLAY_REPORT_MTS2T1.
    ELSE.
      PERFORM GETDATAMTS2T2.
      IF ITMTSIIT2[] IS  NOT INITIAL.
        PERFORM CREATEDINAMYCIT_MTS1T2.
      ENDIF.
    ENDIF.
  ELSE.
    IF RT1 EQ 'X'.
      PERFORM GETDATAMTS3T1.
      PERFORM DISPLAY_REPORT_MTS3T1.
    ELSE.
      PERFORM GETDATAMTS3T2.
      PERFORM CREATEDINAMYCIT_MTS3T2.
    ENDIF.
  ENDIF.


*GET DATA
*&---------------------------------------------------------------------*
*&      Form  GETDATAMTS1T1
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GETDATAMTS1T1 .
  DATA : ITMTSIT1CHAR LIKE LINE OF ITMTSIT1 OCCURS 0 WITH HEADER LINE,
         WA_ITMTSIT1 LIKE LINE OF ITMTSIT1,
         LINE TYPE I.

  CLEAR : ITMTSIT1, ITMTSIT1CHAR.
  REFRESH : ITMTSIT1, ITMTSIT1CHAR.
  SELECT DISTINCT QALS~ENSTEHDAT QALS~PRUEFLOS QALS~MATNR
         QALS~SELMATNR QALS~WERK QALS~MBLNR QALS~CHARG QALS~LIFNR
*         QAMV~KURZTEXT QAMV~STELLEN QAMV~MERKNR
*         QPMK~TOLERANZUN QPMK~TOLERANZOB
*         QAMR~MITTELWERT QAMR~CODE1 QAVE~VCODE
    INTO CORRESPONDING FIELDS OF TABLE ITMTSIT1
    FROM QALS "JOIN QAMV ON QAMV~PRUEFLOS = QAMV~PRUEFLOS
              "JOIN QPMK ON QPMK~MKMNR = QAMV~VERWMERKM AND QPMK~VERSION = QAMV~MKVERSION
*              JOIN QAMR ON QAMR~PRUEFLOS = QALS~PRUEFLOS
*              JOIN QAVE ON QAVE~PRUEFLOS = QALS~PRUEFLOS
    WHERE QALS~ART IN ('Z0B','ZE0B') AND
          QALS~ENSTEHDAT IN P_DATE AND
          QALS~WERK IN P_PLANT AND
          QALS~MATNR IN P_MATNR.

*ISI NAMA VENDOR
  SORT  ITMTSIT1 BY MATNR PRUEFLOS WERK CHARG ENSTEHDAT MBLNR ASCENDING.
  DELETE ADJACENT DUPLICATES FROM ITMTSIT1 COMPARING MATNR PRUEFLOS WERK CHARG ENSTEHDAT MBLNR.

* eliminate cancelled prueflos
  LOOP AT ITMTSIT1.
    CLEAR: NUMBER,RETURN, LANGUAGE, RETURN.
    CLEAR : SYSTEM_STATUS, USER_STATUS.
    REFRESH : SYSTEM_STATUS, USER_STATUS.
    NUMBER = ITMTSIT1-PRUEFLOS.
*      LANGUAGE = SY-LANGU.
    CALL FUNCTION 'BAPI_INSPLOT_GETSTATUS'
      EXPORTING
        NUMBER        = NUMBER
        LANGUAGE      = LANGUAGE
      IMPORTING
        RETURN        = RETURN
      TABLES
        SYSTEM_STATUS = SYSTEM_STATUS
        USER_STATUS   = USER_STATUS.
    IF SYSTEM_STATUS[] IS NOT INITIAL.
      READ TABLE SYSTEM_STATUS WITH KEY SYS_STATUS = 'LTCA'.
      IF SY-SUBRC = 0.
        DELETE  ITMTSIT1.
        CONTINUE.
      ENDIF.
    ENDIF.
  ENDLOOP.

* GET CHARACTERISTIC(QAMV)
  CLEAR LINE.
  LOOP AT ITMTSIT1.
    CLEAR LINE.
    CLEAR WA_ITMTSIT1.
    WA_ITMTSIT1 = ITMTSIT1.
    SELECT *
      FROM QAMV
      WHERE PRUEFLOS = WA_ITMTSIT1-PRUEFLOS.
      IF SY-SUBRC = 0.
        LINE = LINE + 1.
        WA_ITMTSIT1-KURZTEXT = QAMV-KURZTEXT.
        WA_ITMTSIT1-STELLEN = QAMV-STELLEN.
        WA_ITMTSIT1-MERKNR = QAMV-MERKNR.
        WA_ITMTSIT1-VERWMERKM = QAMV-VERWMERKM.
        WA_ITMTSIT1-MKVERSION = QAMV-MKVERSION.
        APPEND WA_ITMTSIT1 TO ITMTSIT1CHAR.
      ENDIF.
    ENDSELECT.
    IF LINE > 0.
      DELETE ITMTSIT1.
      CONTINUE.
    ENDIF.
  ENDLOOP.

  IF ITMTSIT1CHAR[] IS NOT INITIAL.
    CLEAR LINE.
    LINE = LINES( ITMTSIT1CHAR ).
    APPEND LINES OF ITMTSIT1CHAR FROM 1 TO LINE TO ITMTSIT1.
  ENDIF.

*GET VALUE(QPMK)
  LOOP AT ITMTSIT1.
    CLEAR: ITMTSIT1-TOLERANZUN,  ITMTSIT1-TOLERANZOB, ITMTSIT1-MITTELWERT, ITMTSIT1-CODE1, ITMTSIT1-VCODE.

    SELECT SINGLE TOLERANZUN TOLERANZOB
      INTO (ITMTSIT1-TOLERANZUN,  ITMTSIT1-TOLERANZOB)
      FROM QPMK
      WHERE MKMNR = ITMTSIT1-VERWMERKM AND
            VERSION = ITMTSIT1-MKVERSION.

    SELECT SINGLE QAMR~MITTELWERT QAMR~CODE1 QAMR~GRUPPE1
      INTO (ITMTSIT1-MITTELWERT, ITMTSIT1-CODE1, ITMTSIT1-GRUPPE1)
      FROM QAMR WHERE PRUEFLOS = ITMTSIT1-PRUEFLOS AND
                      MERKNR =  ITMTSIT1-MERKNR.

    SELECT SINGLE VCODE
      INTO (ITMTSIT1-VCODE)
      FROM QAVE WHERE PRUEFLOS = ITMTSIT1-PRUEFLOS.

    MODIFY ITMTSIT1.
  ENDLOOP.

  LOOP AT ITMTSIT1 WHERE LIFNR NE ''.
    CLEAR :ITMTSIT1-NAME1, ITMTSIT1-MVAL.
    SELECT SINGLE NAME1
      INTO ITMTSIT1-NAME1
      FROM LFA1
      WHERE LIFNR = ITMTSIT1-LIFNR.

    MODIFY ITMTSIT1.
  ENDLOOP.

*   get posting date and expired date
  LOOP AT ITMTSIT1.
    CLEAR : ITMTSIT1-HSDAT, ITMTSIT1-EXDAT, ITMTSIT1-MHDHB.
    SELECT SINGLE HSDAT
      INTO ITMTSIT1-HSDAT
      FROM MCHA WHERE
      MATNR = ITMTSIT1-MATNR AND
      CHARG = ITMTSIT1-CHARG.

    SELECT SINGLE MHDHB
      INTO ITMTSIT1-MHDHB
      FROM MARA WHERE
      MATNR = ITMTSIT1-MATNR.

    ITMTSIT1-EXDAT = ITMTSIT1-HSDAT + ITMTSIT1-MHDHB.

    CLEAR : ITMTSIT1-TOLERANZUNT, ITMTSIT1-TOLERANZOBT, ITMTSIT1-MVALT.
    WRITE ITMTSIT1-TOLERANZUN TO ITMTSIT1-TOLERANZUNT EXPONENT 0 DECIMALS ITMTSIT1-STELLEN.
    WRITE ITMTSIT1-TOLERANZOB TO ITMTSIT1-TOLERANZOBT EXPONENT 0 DECIMALS ITMTSIT1-STELLEN.
    IF ITMTSIT1-CODE1 NE ''.
      IF ITMTSIT1-GRUPPE1 EQ '1-QL-RM'.
        SELECT SINGLE LANDX50 INTO ITMTSIT1-MVALT FROM T005T WHERE LAND1 EQ ITMTSIT1-CODE1 AND SPRAS EQ 'EN'.
        IF SY-SUBRC NE 0.
          SELECT SINGLE LANDX INTO ITMTSIT1-MVALT FROM T005T WHERE LAND1 EQ ITMTSIT1-CODE1 AND SPRAS EQ 'EN'.
        ENDIF.
      ELSE.
        MOVE ITMTSIT1-CODE1 TO ITMTSIT1-MVALT.
      ENDIF.
    ELSE.
      WRITE ITMTSIT1-MITTELWERT TO ITMTSIT1-MVALT EXPONENT 0 DECIMALS 2.
    ENDIF.

    MODIFY ITMTSIT1.
  ENDLOOP.
ENDFORM.                    " GETDATAMTS1T1

