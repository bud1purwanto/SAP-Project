    INTO CORRESPONDING FIELDS OF TABLE ITMTSIIIT1
    FROM QALS "JOIN QAMV ON QAMV~PRUEFLOS = QAMV~PRUEFLOS
              "JOIN QPMK ON QPMK~MKMNR = QAMV~VERWMERKM AND QPMK~VERSION = QAMV~MKVERSION
              "JOIN QAMR ON QAMR~PRUEFLOS = QALS~PRUEFLOS
              "JOIN QAVE ON QAVE~PRUEFLOS = QALS~PRUEFLOS
