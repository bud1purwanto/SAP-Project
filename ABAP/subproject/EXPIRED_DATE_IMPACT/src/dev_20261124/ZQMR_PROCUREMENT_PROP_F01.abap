  CLEAR LINE.
  LOOP AT ITMTSIIIT1.
    CLEAR LINE.
    CLEAR WA_ITMTSIT1.
    WA_ITMTSIT1 = ITMTSIIIT1.
    SELECT *
      FROM QAMV
      WHERE PRUEFLOS = WA_ITMTSIT1-PRUEFLOS.
      IF SY-SUBRC = 0.
