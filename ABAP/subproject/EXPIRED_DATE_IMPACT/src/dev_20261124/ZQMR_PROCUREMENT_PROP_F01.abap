      FROM QAMR WHERE PRUEFLOS = ITMTSIIIT1-PRUEFLOS AND
                      MERKNR =  ITMTSIIIT1-MERKNR.

    SELECT SINGLE VCODE
      INTO (ITMTSIIIT1-VCODE)
      FROM QAVE WHERE PRUEFLOS = ITMTSIIIT1-PRUEFLOS.

    MODIFY ITMTSIIIT1.
  ENDLOOP.

  LOOP AT ITMTSIIIT1. " WHERE LIFNR NE ''.
    CLEAR : ITMTSIIIT1-NAME1, ITMTSIIIT1-MVAL.
    SELECT SINGLE NAME1
      INTO ITMTSIIIT1-NAME1
      FROM LFA1
      WHERE LIFNR = ITMTSIIIT1-LIFNR.

    CLEAR : ITMTSIIIT1-TOLERANZUNT, ITMTSIIIT1-TOLERANZOBT, ITMTSIIIT1-MVALT.
    WRITE ITMTSIIIT1-TOLERANZUN TO ITMTSIIIT1-TOLERANZUNT EXPONENT 0 DECIMALS ITMTSIIIT1-STELLEN.
    WRITE ITMTSIIIT1-TOLERANZOB TO ITMTSIIIT1-TOLERANZOBT EXPONENT 0 DECIMALS ITMTSIIIT1-STELLEN.

    IF ITMTSIIIT1-CODE1 NE ''.
      MOVE ITMTSIIIT1-CODE1 TO ITMTSIIIT1-MVALT.
    ELSE.
      WRITE ITMTSIIIT1-MITTELWERT TO ITMTSIIIT1-MVALT EXPONENT 0 DECIMALS ITMTSIIIT1-STELLEN.
    ENDIF.

    MODIFY ITMTSIIIT1.
  ENDLOOP.

ENDFORM.                    " GETDATAMTS3T1


