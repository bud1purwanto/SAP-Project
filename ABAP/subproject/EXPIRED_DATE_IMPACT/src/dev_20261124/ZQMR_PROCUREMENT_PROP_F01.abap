*&---------------------------------------------------------------------*
*&      Form  CREATEDINAMYCIT_MTS1T2
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CREATEDINAMYCIT_MTS1T2 .
  DATA : ITEMP LIKE STANDARD TABLE OF ITMTSIT2 WITH HEADER LINE,
         ITEMP1 LIKE STANDARD TABLE OF ITMTSIT2 WITH HEADER LINE,
         ITEMP2 LIKE STANDARD TABLE OF ITMTSIT2 WITH HEADER LINE,
         ITAB2 LIKE STANDARD TABLE OF ITMTSIT2 WITH HEADER LINE,
         ITAB4 LIKE STANDARD TABLE OF ITMTSIT2 WITH HEADER LINE,
         ITAB3 LIKE STANDARD TABLE OF ITMTSIT2 WITH HEADER LINE,
         WA_ITAB LIKE LINE OF ITMTSIT2,
         N TYPE I, "COUNTER FOR PROPERTIES OF MATERIAL.
         VTEMP TYPE C,
         MVAL(32) TYPE C.

*  UNTUK ROW MAT TIPE 2
  REFRESH: ITEMP, ITAB2.
  CLEAR: ITEMP, ITAB2.
  "assign nilai itab ke internal tabel itab2(untuk keperluan type2)
  IF MTS1 EQ 'X' AND RT2 EQ 'X'.
    ITAB2[] = ITMTSIT2[].
  ELSEIF MTS2 EQ 'X' AND RT2 EQ 'X'.
    ITAB2[] = ITMTSIIT2[].
  ENDIF.

*  SORT ITAB2 BY MATNR PRUEFLOS KURZTEXT.
  ITEMP[] = ITAB2[].
  SORT ITEMP BY MATNR KURZTEXT.
  DELETE ADJACENT DUPLICATES FROM ITEMP COMPARING MATNR KURZTEXT.

*  MATERIAL
  ITAB3[] = ITAB2[].
  SORT ITAB3 BY MATNR ASCENDING.
  DELETE ADJACENT DUPLICATES FROM ITAB3 COMPARING MATNR.

  "CREATE FIELDNAME
  SORT ITAB2 BY MATNR KURZTEXT ASCENDING.
  ITEMP2[] = ITAB2[].
  DELETE ADJACENT DUPLICATES FROM ITEMP2 COMPARING MATNR KURZTEXT.


*  SORT ITAB2 BY PRUEFLOS ASCENDING.
*  DELETE ADJACENT DUPLICATES FROM ITAB2 COMPARING PRUEFLOS.
*  LOOP AT ITEMP2.
  LOOP AT ITAB2 . "WHERE MATNR = ITEMP2-MATNR AND KURZTEXT = ITEMP2-KURZTEXT.
    CLEAR ITAB2-ZFIELDNAME.
    CONCATENATE 'Z' ITAB2-PRUEFLOS INTO ITAB2-ZFIELDNAME.
    MODIFY ITAB2.
  ENDLOOP.
*  ENDLOOP.

*  REFRESH ITEMP2.
  ITEMP2[] = ITAB2[].
