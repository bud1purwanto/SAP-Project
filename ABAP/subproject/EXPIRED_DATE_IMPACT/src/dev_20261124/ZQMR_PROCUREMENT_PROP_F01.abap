*&---------------------------------------------------------------------*
*&      Form  add_data
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM ADD_DATA.
  DATA: V_CEK_BATCH LIKE MCHA-CHARG.
  DATA:   BEGIN OF HTEXT,                   "Struktur für Textparameter
            TDOBJECT LIKE THEAD-TDOBJECT,
            TDID     LIKE THEAD-TDID,
            TDNAME   LIKE THEAD-TDNAME,
            TDSPRAS  LIKE THEAD-TDSPRAS,
          END OF  HTEXT.
  DATA: FINLINE_COUNT  LIKE SY-STEPL.
  DATA: IT_INLINES LIKE TLINE OCCURS 0 WITH HEADER LINE,
        IT_LINES LIKE TLINE OCCURS 0.

  HTEXT-TDID   = 'VERM'.
  FINLINE_COUNT = 1.
*  HTEXT-TDNAME = 'RCC-L820A             0000351773'.
  HTEXT-TDOBJECT = 'CHARGE'.

  LOOP AT  ITMTSIT1.
    IF V_CEK_BATCH = ITMTSIT1-CHARG.
      SELECT SINGLE CERTNO BUDAT CERTDAT INTO (ITMTSIT1-CERTNO, ITMTSIT1-BUDAT, ITMTSIT1-CERTDAT)
        FROM QCPR WHERE MBLNR = ITMTSIT1-MBLNR.
      MODIFY ITMTSIT1 TRANSPORTING CERTNO BUDAT CERTDAT WHERE MBLNR = ITMTSIT1-MBLNR.

      CONTINUE.
    ENDIF.

    V_CEK_BATCH = ITMTSIT1-CHARG.
    HTEXT-TDNAME = ITMTSIT1-MATNR.
    CONDENSE HTEXT-TDNAME.
    HTEXT-TDNAME+22(10) = ITMTSIT1-CHARG.

    CLEAR: IT_INLINES, IT_LINES.
    REFRESH: IT_INLINES, IT_LINES.
    CALL FUNCTION 'READ_TEXT_INLINE'
      EXPORTING
        ID              = HTEXT-TDID  "'VERM'
        INLINE_COUNT    = FINLINE_COUNT  "'1'
        LANGUAGE        = SY-LANGU
        NAME            = HTEXT-TDNAME
        OBJECT          = HTEXT-TDOBJECT  "'CHARGE'
      TABLES
        INLINES         = IT_INLINES
        LINES           = IT_LINES
      EXCEPTIONS
        ID              = 1
        LANGUAGE        = 2
        NAME            = 3
        NOT_FOUND       = 4
        OBJECT          = 5
        REFERENCE_CHECK = 6
        OTHERS          = 7.

    READ TABLE IT_INLINES INDEX 1.
    ITMTSIT1-LTEXT = IT_INLINES-TDLINE.

    CLEAR: ITMTSIT1-EXDAT.
    SELECT SINGLE VFDAT INTO ITMTSIT1-EXDAT FROM MCH1 WHERE CHARG = ITMTSIT1-CHARG.

    MODIFY ITMTSIT1 TRANSPORTING LTEXT CERTNO BUDAT CERTDAT EXDAT WHERE CHARG = ITMTSIT1-CHARG.

  ENDLOOP.


ENDFORM.                    "add_data