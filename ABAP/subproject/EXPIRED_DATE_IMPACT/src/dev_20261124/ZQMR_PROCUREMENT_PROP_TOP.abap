         CHARG LIKE QALS-CHARG,
         MATNR LIKE QALS-MATNR,
         SELMATNR LIKE QALS-SELMATNR,
         WERK LIKE QALS-WERK,
         MERKNR LIKE QAMV-MERKNR,
         KURZTEXT LIKE QAMV-KURZTEXT,
         VERWMERKM LIKE QAMV-VERWMERKM,
         MKVERSION LIKE QAMV-MKVERSION,
         TOLERANZUN LIKE QPMK-TOLERANZUN,
         TOLERANZOB LIKE QPMK-TOLERANZOB,
         MITTELWERT LIKE QAMR-MITTELWERT,
