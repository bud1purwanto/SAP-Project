       ITMTSIIIT1 LIKE STANDARD TABLE OF ITMTSIT1 WITH HEADER LINE,
       ITMTSIIIT2 LIKE STANDARD TABLE OF ITMTSIT1 WITH HEADER LINE.


DATA: V_PROG LIKE ZPROGINFO-PGMNA VALUE 'ZQMR_PROCUREMENT_PROP'.
