* field symbols to access the dynamic table
FIELD-SYMBOLS: <F_TAB>   TYPE ANY TABLE,
               <F_LINE>  TYPE ANY,
               <F_FIELD> TYPE ANY,
               <LO_LINE> TYPE ANY.

DATA: LO_STRUCT   TYPE REF TO CL_ABAP_STRUCTDESCR,
      LO_ELEMENT  TYPE REF TO CL_ABAP_ELEMDESCR,
      LO_NEW_TYPE TYPE REF TO CL_ABAP_STRUCTDESCR,
      LO_NEW_TAB  TYPE REF TO CL_ABAP_TABLEDESCR,
      LO_DATA     TYPE REF TO DATA,
      NEW_LINE    TYPE REF TO DATA,
      LT_COMP     TYPE CL_ABAP_STRUCTDESCR=>COMPONENT_TABLE,
      LT_TOT_COMP TYPE CL_ABAP_STRUCTDESCR=>COMPONENT_TABLE,
      LA_COMP     LIKE LINE OF LT_COMP.

DATA: TAB_COUNT TYPE I,
      LS_TABIX  LIKE SY-TABIX.
DATA : DATES(10) TYPE C,
       DATEF(10) TYPE C.

DATA : NUMBER LIKE  BAPI2045D_IL0-INSPLOT,
       LANGUAGE LIKE  BAPI2045LA,
       RETURN LIKE  BAPIRETURN1.
*"       TABLES
DATA : SYSTEM_STATUS LIKE  BAPI2045SS OCCURS 0 WITH HEADER LINE,
       USER_STATUS LIKE  BAPI2045US OCCURS 0 WITH HEADER LINE.

