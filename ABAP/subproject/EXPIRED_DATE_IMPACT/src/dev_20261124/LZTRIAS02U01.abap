FUNCTION Z_ITI_MSEG.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(CPUDT1) TYPE  CPUDT
*"     VALUE(CPUDT2) TYPE  CPUDT
*"     VALUE(IS_RAW) TYPE  CHAR01 OPTIONAL
*"     VALUE(RAW_MVT) TYPE  CHAR120 OPTIONAL
*"     VALUE(IS_JR) TYPE  CHAR01 OPTIONAL
*"     VALUE(JR_MVT) TYPE  CHAR120 OPTIONAL
*"     VALUE(IS_SR) TYPE  CHAR01 OPTIONAL
*"     VALUE(SR_MVT) TYPE  CHAR120 OPTIONAL
*"     VALUE(IS_GI) TYPE  CHAR01 OPTIONAL
*"     VALUE(GI_MVT) TYPE  CHAR120 OPTIONAL
*"     VALUE(DL_FOLDER) TYPE  CHAR120 OPTIONAL
*"  TABLES
*"      WA_MKPF STRUCTURE  MKPF
*"      WA_MSEG STRUCTURE  MSEG
*"      WA_MSEG_DET STRUCTURE  ZCHAR00
*"      WA_LIKP STRUCTURE  LIKP
*"----------------------------------------------------------------------
  DATA: BEGIN OF IT_MBLNR OCCURS 0,
        MBLNR LIKE MKPF-MBLNR,
    END OF IT_MBLNR.

  DATA: BEGIN OF IT_MKPF OCCURS 0.
          INCLUDE TYPE MKPF.
  DATA: LFART LIKE LIKP-LFART,
  END OF IT_MKPF.

  DATA: BEGIN OF IT_MSEG OCCURS 0.
          INCLUDE TYPE MSEG.
  DATA: MTART LIKE MARA-MTART,
        MATKL LIKE MARA-MATKL,
      ZZTYPE LIKE AUSP-ATWRT,
      ZZTHICKNESS LIKE AUSP-ATWRT,
      ZZLENGTH LIKE AUSP-ATWRT,
      ZZWIDTH LIKE AUSP-ATWRT,
      ZZCORE LIKE AUSP-ATWRT,
      ZZTREATMENT LIKE AUSP-ATWRT,
      ZZCRITERIA LIKE AUSP-ATWRT,
      ZZNOMORROLL LIKE AUSP-ATWRT,
  END OF IT_MSEG.

  DATA: V_ATFLV TYPE P LENGTH 8 DECIMALS 2. "LIKE AUSP-ATFLV.

  RANGES: P_CPUDT FOR MKPF-CPUDT,
          P_CPUTM FOR MKPF-CPUTM.

  RANGES: P_BWART FOR MSEG-BWART.
  DATA: V_PS(2) VALUE 0,
        FILE_D TYPE STRING.

  DATA: FILE   TYPE STRING,  " VALUE '/spare/sapreport/ZMCHB.TXT',
        RESULT TYPE STRING,
        V_TMP TYPE STRING.
  FIELD-SYMBOLS <FS> TYPE ANY.

  IF CPUDT1 = '00000000' OR CPUDT2 = '00000000'.
    EXIT.
  ENDIF.

  P_CPUDT-SIGN = 'I'.
  P_CPUDT-OPTION = 'BT'.
  P_CPUDT-LOW = CPUDT1.
  P_CPUDT-HIGH = CPUDT2.
  APPEND P_CPUDT.

*01--- exec RAW
  IF IS_RAW = 'X' AND RAW_MVT NE ''.
    REFRESH: P_BWART.
    CLEAR: P_BWART.
    P_BWART-SIGN = 'I'.
    P_BWART-OPTION = 'EQ'.

    V_PS = 0.
    DO 100 TIMES.
      P_BWART-LOW = RAW_MVT+V_PS(3).
      APPEND P_BWART.

      V_PS = V_PS + 4.
      IF P_BWART-LOW = ''.
        EXIT.
      ENDIF.
    ENDDO.
    DELETE P_BWART WHERE LOW = ''.

    REFRESH: IT_MKPF, IT_MSEG, IT_MBLNR.
    SELECT MKPF~MBLNR INTO TABLE IT_MBLNR
      FROM ( MKPF JOIN MSEG ON MKPF~MBLNR = MSEG~MBLNR ) JOIN MARA ON MSEG~MATNR = MARA~MATNR
      WHERE MKPF~CPUDT IN P_CPUDT AND MARA~MTART = 'ZRAW'
      AND MSEG~BWART IN P_BWART.  "('101', '102', '261', '262', '301', '302').

    DELETE ADJACENT DUPLICATES FROM IT_MBLNR COMPARING MBLNR.

    LOOP AT IT_MBLNR.
      SELECT * APPENDING TABLE IT_MKPF
        FROM MKPF WHERE MBLNR = IT_MBLNR-MBLNR.

      SELECT * INTO CORRESPONDING FIELDS OF IT_MSEG FROM MSEG JOIN MARA ON MSEG~MATNR = MARA~MATNR
             WHERE MSEG~MBLNR = IT_MBLNR-MBLNR AND BWART IN P_BWART AND MARA~MTART = 'ZRAW'.
        APPEND IT_MSEG.
      ENDSELECT.
    ENDLOOP.

    IT_MKPF-BUDAT = '19000101'.
    MODIFY IT_MKPF TRANSPORTING BUDAT WHERE BUDAT = 00000000.
    IT_MKPF-BLDAT = '19000101'.
    MODIFY IT_MKPF TRANSPORTING BLDAT WHERE BLDAT = 00000000.
    IT_MKPF-AEDAT = '19000101'.
    MODIFY IT_MKPF TRANSPORTING AEDAT WHERE AEDAT = 00000000.

    IT_MSEG-VFDAT = '19000101'.
    MODIFY IT_MSEG TRANSPORTING VFDAT WHERE VFDAT = 00000000.
    IT_MSEG-DABRBZ = '19000101'.
    MODIFY IT_MSEG TRANSPORTING DABRBZ WHERE DABRBZ = 00000000.
    IT_MSEG-DABRZ = '19000101'.
    MODIFY IT_MSEG TRANSPORTING DABRZ WHERE DABRZ = 00000000.
    IT_MSEG-HSDAT = '19000101'.
    MODIFY IT_MSEG TRANSPORTING HSDAT WHERE HSDAT = 00000000.
    IT_MSEG-BUDAT_MKPF = '19000101'.
    MODIFY IT_MSEG TRANSPORTING BUDAT_MKPF WHERE BUDAT_MKPF = 00000000.
    IT_MSEG-CPUDT_MKPF = '19000101'.
    MODIFY IT_MSEG TRANSPORTING CPUDT_MKPF WHERE CPUDT_MKPF = 00000000.
    IT_MSEG-/BEV2/ED_AEDAT = '19000101'.
    MODIFY IT_MSEG TRANSPORTING /BEV2/ED_AEDAT WHERE /BEV2/ED_AEDAT = 00000000.

    WA_MKPF[] = IT_MKPF[].
    WA_MSEG[] = IT_MSEG[].
    LOOP AT IT_MSEG.
      MOVE IT_MSEG-MATNR TO WA_MSEG_DET-MATNR.
      MOVE IT_MSEG-MBLNR TO WA_MSEG_DET-CHARG.
      MOVE IT_MSEG-MTART TO WA_MSEG_DET-CLASS.
      MOVE IT_MSEG-MATKL TO WA_MSEG_DET-CHAR01.
      MOVE IT_MSEG-ZZTYPE TO WA_MSEG_DET-CHAR02.
      MOVE IT_MSEG-ZZTHICKNESS TO WA_MSEG_DET-CHAR03.
      MOVE IT_MSEG-ZZLENGTH TO WA_MSEG_DET-CHAR04.
      MOVE IT_MSEG-ZZWIDTH TO WA_MSEG_DET-CHAR05.
      MOVE IT_MSEG-ZZCORE TO WA_MSEG_DET-CHAR06.
      MOVE IT_MSEG-ZZTREATMENT TO WA_MSEG_DET-CHAR07.
      MOVE IT_MSEG-ZZCRITERIA TO WA_MSEG_DET-CHAR08.
      MOVE IT_MSEG-ZZNOMORROLL TO WA_MSEG_DET-CHAR09.
      APPEND WA_MSEG_DET.
    ENDLOOP.

    LOOP AT IT_MKPF.
      MOVE IT_MKPF-LE_VBELN TO WA_LIKP-VBELN.
      MOVE IT_MKPF-LFART TO WA_LIKP-LFART.
      APPEND WA_LIKP.
    ENDLOOP.
    REFRESH: IT_MKPF[], IT_MSEG[].


  ENDIF.




*02--- exec JR
  IF IS_JR = 'X' AND JR_MVT NE ''.
    REFRESH: P_BWART.
    CLEAR: P_BWART.
    P_BWART-SIGN = 'I'.
    P_BWART-OPTION = 'EQ'.

    V_PS = 0.
    DO 100 TIMES.
      P_BWART-LOW = JR_MVT+V_PS(3).
      APPEND P_BWART.

      V_PS = V_PS + 4.
      IF P_BWART-LOW = ''.
        EXIT.
      ENDIF.
    ENDDO.

    DELETE P_BWART WHERE LOW = ''.

    REFRESH: IT_MKPF, IT_MSEG, IT_MBLNR.
    SELECT MKPF~MBLNR INTO TABLE IT_MBLNR
       FROM ( MKPF JOIN MSEG ON MKPF~MBLNR = MSEG~MBLNR ) JOIN MARA ON MSEG~MATNR = MARA~MATNR
      WHERE MKPF~CPUDT IN P_CPUDT AND MARA~MTART = 'ZSFG'
      AND MSEG~BWART IN P_BWART.  "('101', '102', '261', '262', '301', '302').

    DELETE ADJACENT DUPLICATES FROM IT_MBLNR COMPARING MBLNR.


    LOOP AT IT_MBLNR.
      SELECT * APPENDING TABLE IT_MKPF
        FROM MKPF WHERE MBLNR = IT_MBLNR-MBLNR.

      SELECT * INTO CORRESPONDING FIELDS OF IT_MSEG FROM MSEG JOIN MARA ON MSEG~MATNR = MARA~MATNR
             WHERE MSEG~MBLNR = IT_MBLNR-MBLNR AND BWART IN P_BWART AND MARA~MTART = 'ZSFG'.
        APPEND IT_MSEG.
      ENDSELECT.
    ENDLOOP.


    LOOP AT IT_MSEG.
      IF IT_MSEG-CHARG = ''.
        CONTINUE.
      ENDIF.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZTYPE
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZTYPE'.

      CLEAR V_ATFLV.
      SELECT SINGLE  AUSP~ATFLV FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO V_ATFLV
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZTHICKNESS'.
      IT_MSEG-ZZTHICKNESS = V_ATFLV. CONDENSE IT_MSEG-ZZTHICKNESS.

      CLEAR V_ATFLV.
      SELECT SINGLE  AUSP~ATFLV FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO V_ATFLV
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZLENGTH'.
      IT_MSEG-ZZLENGTH = V_ATFLV. CONDENSE IT_MSEG-ZZLENGTH.

      CLEAR V_ATFLV.
      SELECT SINGLE  AUSP~ATFLV FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO V_ATFLV
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZWIDTH'.
      IT_MSEG-ZZWIDTH = V_ATFLV.  CONDENSE IT_MSEG-ZZWIDTH.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZCORE
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZCORE'.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZTREATMENT
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZTREATMENT'.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZCRITERIA
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZCRITERIA'.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZNOMORROLL
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZNOMORROLL'.

      MODIFY IT_MSEG.
    ENDLOOP.
    IT_MKPF-BUDAT = '19000101'.
    MODIFY IT_MKPF TRANSPORTING BUDAT WHERE BUDAT = 00000000.
    IT_MKPF-BLDAT = '19000101'.
    MODIFY IT_MKPF TRANSPORTING BLDAT WHERE BLDAT = 00000000.
    IT_MKPF-AEDAT = '19000101'.
    MODIFY IT_MKPF TRANSPORTING AEDAT WHERE AEDAT = 00000000.

    IT_MSEG-VFDAT = '19000101'.
    MODIFY IT_MSEG TRANSPORTING VFDAT WHERE VFDAT = 00000000.
    IT_MSEG-DABRBZ = '19000101'.
    MODIFY IT_MSEG TRANSPORTING DABRBZ WHERE DABRBZ = 00000000.
    IT_MSEG-DABRZ = '19000101'.
    MODIFY IT_MSEG TRANSPORTING DABRZ WHERE DABRZ = 00000000.
    IT_MSEG-HSDAT = '19000101'.
    MODIFY IT_MSEG TRANSPORTING HSDAT WHERE HSDAT = 00000000.
    IT_MSEG-BUDAT_MKPF = '19000101'.
    MODIFY IT_MSEG TRANSPORTING BUDAT_MKPF WHERE BUDAT_MKPF = 00000000.
    IT_MSEG-CPUDT_MKPF = '19000101'.
    MODIFY IT_MSEG TRANSPORTING CPUDT_MKPF WHERE CPUDT_MKPF = 00000000.
    IT_MSEG-/BEV2/ED_AEDAT = '19000101'.
    MODIFY IT_MSEG TRANSPORTING /BEV2/ED_AEDAT WHERE /BEV2/ED_AEDAT = 00000000.

    WA_MKPF[] = IT_MKPF[].
    WA_MSEG[] = IT_MSEG[].
     LOOP AT IT_MSEG.
      MOVE IT_MSEG-MATNR TO WA_MSEG_DET-MATNR.
      MOVE IT_MSEG-MBLNR TO WA_MSEG_DET-CHARG.
      MOVE IT_MSEG-MTART TO WA_MSEG_DET-CLASS.
      MOVE IT_MSEG-MATKL TO WA_MSEG_DET-CHAR01.
      MOVE IT_MSEG-ZZTYPE TO WA_MSEG_DET-CHAR02.
      MOVE IT_MSEG-ZZTHICKNESS TO WA_MSEG_DET-CHAR03.
      MOVE IT_MSEG-ZZLENGTH TO WA_MSEG_DET-CHAR04.
      MOVE IT_MSEG-ZZWIDTH TO WA_MSEG_DET-CHAR05.
      MOVE IT_MSEG-ZZCORE TO WA_MSEG_DET-CHAR06.
      MOVE IT_MSEG-ZZTREATMENT TO WA_MSEG_DET-CHAR07.
      MOVE IT_MSEG-ZZCRITERIA TO WA_MSEG_DET-CHAR08.
      MOVE IT_MSEG-ZZNOMORROLL TO WA_MSEG_DET-CHAR09.
      APPEND WA_MSEG_DET.
    ENDLOOP.

     LOOP AT IT_MKPF.
      MOVE IT_MKPF-LE_VBELN TO WA_LIKP-VBELN.
      MOVE IT_MKPF-LFART TO WA_LIKP-LFART.
      APPEND WA_LIKP.
    ENDLOOP.
    REFRESH: IT_MKPF[], IT_MSEG[].


  ENDIF.



*03--- exec SR
  IF IS_SR = 'X' AND SR_MVT NE ''.
    REFRESH: P_BWART.
