      WHERE MKPF~CPUDT IN P_CPUDT AND MARA~MTART = 'ZFGS'
      AND MSEG~BWART IN P_BWART. "('101', '102', '261', '262', '301', '302', '311', '312') AND  "MARA~MATNR LIKE 'SR%I' AND
*      AND MSEG~UMLGO IN ('2801', '2802', '2803', '2804', '2805', '2806', '2807', '2808', '2809', '2810', '2811', '2812', '2813', '2814',
*                   '2815', '1801', '1802', '1803', '1804', '1805', '1806', '1808', '1809', '1810', '1811', '1812', '1813', '1814', '1815', '1813').

    DELETE ADJACENT DUPLICATES FROM IT_MBLNR COMPARING MBLNR.

    LOOP AT IT_MBLNR.
      SELECT * APPENDING TABLE IT_MKPF
        FROM MKPF WHERE MBLNR = IT_MBLNR-MBLNR.

      SELECT * INTO CORRESPONDING FIELDS OF IT_MSEG FROM MSEG JOIN MARA ON MSEG~MATNR = MARA~MATNR
             WHERE MSEG~MBLNR = IT_MBLNR-MBLNR AND BWART IN P_BWART AND MARA~MTART = 'ZFGS'.
        APPEND IT_MSEG.
      ENDSELECT.
    ENDLOOP.

*    DELETE IT_MSEG WHERE MATNR+5(1) NE 'I'.

    LOOP AT IT_MSEG.
      IF IT_MSEG-CHARG = ''.
        CONTINUE.
      ENDIF.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZTYPE
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZTYPE'.

      CLEAR V_ATFLV.
      SELECT SINGLE  AUSP~ATFLV FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO V_ATFLV
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZTHICKNESS'.
      IT_MSEG-ZZTHICKNESS = V_ATFLV. CONDENSE IT_MSEG-ZZTHICKNESS.

      CLEAR V_ATFLV.
      SELECT SINGLE  AUSP~ATFLV FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO V_ATFLV
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZLENGTH'.
      IT_MSEG-ZZLENGTH = V_ATFLV. CONDENSE IT_MSEG-ZZLENGTH.

      CLEAR V_ATFLV.
      SELECT SINGLE  AUSP~ATFLV FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO V_ATFLV
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZWIDTH'.
      IT_MSEG-ZZWIDTH = V_ATFLV.  CONDENSE IT_MSEG-ZZWIDTH.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZCORE
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZCORE'.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZTREATMENT
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZTREATMENT'.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZCRITERIA
      WHERE MCH1~MATNR  = IT_MSEG-MATNR  AND   MCH1~CHARG  = IT_MSEG-CHARG    AND   CABN~ATNAM = 'ZZCRITERIA'.

      SELECT SINGLE  AUSP~ATWRT FROM CABN JOIN AUSP ON CABN~ATINN = AUSP~ATINN JOIN MCH1 ON CUOBJ_BM = AUSP~OBJEK INTO IT_MSEG-ZZNOMORROLL
