FORM ZZ_MT_RUN USING PV TYPE LIPS-VBELN.
  DATA: LV_S TYPE STRING, LV_N TYPE STRING.
  FIELD-SYMBOLS: <V> TYPE ANY.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZNOMORROLL' IMPORTING OUTPUT = ATINN_ROLL.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZCODE' IMPORTING OUTPUT = ATINN_CODE.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZWIDTH' IMPORTING OUTPUT = ATINN_WIDTH.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZLENGTH' IMPORTING OUTPUT = ATINN_LENGTH.
  P_VBELN-SIGN = 'I'. P_VBELN-OPTION = 'EQ'. P_VBELN-LOW = PV.
  APPEND P_VBELN.
  PERFORM GET_DATA.
  IF IT_DATA[] IS NOT INITIAL.
    SY-UCOMM = 'EXEC'.
    PERFORM ZZ_UC0100.
  ENDIF.
ENDFORM.
DATA: GV_STNT_MIC TYPE C LENGTH 8.
FORM ZZ_CHK USING PT TYPE C.
  DATA: LV_O TYPE C, LV_N TYPE C, LV_S TYPE STRING, LV_NR TYPE I.
  CLEAR: LV_O, LV_N.
  LOOP AT IT_DETAIL WHERE CMICMIT EQ '-' OR CMICMIT IS INITIAL
      OR CMICMIT EQ '00000000' OR CMICMIT EQ '0'
      OR CMICMIT EQ '0.00' OR CMICMIT EQ '0.000'.
    LV_O = 'X'. EXIT.
  ENDLOOP.
  LOOP AT IT_DETAIL WHERE CHK EQ 'X' AND ( CMICMIT EQ '-'
      OR CMICMIT IS INITIAL OR CMICMIT EQ '00000000'
      OR CMICMIT EQ '0' OR CMICMIT EQ '0.00'
      OR CMICMIT EQ '0.000' ).
    LV_N = 'X'. EXIT.
  ENDLOOP.
  LV_NR = 0.
  LOOP AT IT_DETAIL WHERE CHK EQ 'X'.
    LV_NR = LV_NR + 1.
  ENDLOOP.
  CONCATENATE '#T|' PT '|baris dicentang=' INTO LV_S.
  WRITE: / LV_S, LV_NR, '| blok LAMA=', LV_O, '| blok BARU=', LV_N.
ENDFORM.
FORM ZZ_AFTER_EXEC.
  DATA: LV_S TYPE STRING.
  LOOP AT IT_DATA.
    CONCATENATE '|' IT_DATA-MATNR '|' IT_DATA-MIC '|' IT_DATA-CMICMIT '|' IT_DATA-INSLOT
      '|' IT_DATA-MICMIN '|' IT_DATA-MICMAX '|' IT_DATA-MICDES '|' IT_DATA-METHOD INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
ENDFORM.
