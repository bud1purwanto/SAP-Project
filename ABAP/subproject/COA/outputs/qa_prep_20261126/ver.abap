REPORT ZQA_VER.
DATA: LT_K TYPE TABLE OF LIKP, LS_K TYPE LIKP,
 LT_I TYPE TABLE OF LIPS, LS_I TYPE LIPS, LV_N TYPE I,
 LV_Q TYPE LIPS-LFIMG, LV_D TYPE I, LT_L TYPE TABLE OF LIPS.
SELECT * FROM LIKP INTO TABLE LT_K WHERE ERDAT = '20261126'
 AND VBELN >= '0085051548'.
SORT LT_K BY VBELN.
LOOP AT LT_K INTO LS_K.
 SELECT * FROM LIPS INTO TABLE LT_I WHERE VBELN = LS_K-VBELN
  AND PSTYV = 'ZB'.
 DESCRIBE TABLE LT_I LINES LV_N.
 CLEAR LV_Q.
 LOOP AT LT_I INTO LS_I.
  LV_Q = LV_Q + LS_I-LFIMG.
 ENDLOOP.
 READ TABLE LT_I INTO LS_I INDEX 1.
 WRITE: / LS_K-VBELN, LS_I-MATNR, 'roll', LV_N, 'kg', LV_Q.
ENDLOOP.
