REPORT ZQA_CHK76.
TYPES: BEGIN OF TY_R, S TYPE I, M TYPE MATNR, C TYPE CHARG_D,
 END OF TY_R.
DATA: LT_R TYPE TABLE OF TY_R, LS_R TYPE TY_R,
 LT_B TYPE TABLE OF MCHB, LS_B TYPE MCHB,
 LT_I TYPE TABLE OF LIPS, LS_I TYPE LIPS,
 LV_W TYPE VBUK-WBSTK.
DEFINE R.
 LS_R-S = &1. LS_R-M = &2. LS_R-C = &3.
 APPEND LS_R TO LT_R.
END-OF-DEFINITION.
R 0 'SRAABI' '0003885659'.
R 0 'SRAABI' '0003885660'.
R 0 'SRAABI' '0003885661'.
R 0 'SRAABI' '0003885662'.
R 0 'SRAABI' '0003885663'.
R 0 'SRAABI' '0003885664'.
R 0 'SRAABI' '0003885665'.
R 0 'SRAABI' '0003885666'.
R 0 'SRAABI' '0003885667'.
LOOP AT LT_R INTO LS_R.
 CLEAR: LS_B, LV_W.
 SELECT * FROM MCHB INTO TABLE LT_B WHERE MATNR = LS_R-M
  AND CHARG = LS_R-C AND CLABS > 0.
 READ TABLE LT_B INTO LS_B INDEX 1.
 SELECT * FROM LIPS INTO TABLE LT_I WHERE MATNR = LS_R-M
  AND CHARG = LS_R-C.
 WRITE: / 'SK', LS_R-S, LS_R-M, LS_R-C, LS_B-WERKS, LS_B-LGORT,
  LS_B-CLABS, 'blok', LS_B-CSPEM.
 LOOP AT LT_I INTO LS_I.
  SELECT SINGLE WBSTK INTO LV_W FROM VBUK WHERE VBELN = LS_I-VBELN.
  WRITE: / '    DO', LS_I-VBELN, LS_I-PSTYV, 'wbstk', LV_W.
 ENDLOOP.
ENDLOOP.
