REPORT ZQA_TBD.
DATA: LT_B TYPE TABLE OF MCHB, LS_B TYPE MCHB,
 LT_S TYPE TABLE OF MSEG, LS_S TYPE MSEG,
 LT_C TYPE TABLE OF AUFM, LS_C TYPE AUFM,
 LV_D TYPE MCH1-ERSDA, LV_L TYPE MCH1-LICHA, LV_N TYPE I,
 LV_LOT TYPE QALS-PRUEFLOS, LV_Q TYPE I, LV_OC TYPE AFPO-AUFNR.
* 4: SREWEI stok terbaru -> JR asal
SELECT * FROM MCHB INTO TABLE LT_B WHERE MATNR = 'SREWEI'
 AND WERKS = '2000' AND CLABS > 0.
LOOP AT LT_B INTO LS_B.
 SELECT SINGLE ERSDA LICHA INTO (LV_D, LV_L) FROM MCH1
  WHERE MATNR = LS_B-MATNR AND CHARG = LS_B-CHARG.
 CHECK LV_D >= '20260801'.
 CLEAR LV_OC.
 SELECT SINGLE AUFNR INTO LV_OC FROM AFPO
  WHERE MILL_OC_AUFNR_U <> '' AND MILL_OC_AUFNR_U = LV_L.
 WRITE: / 'EW', LS_B-CHARG, LV_D, LS_B-LGORT, LS_B-CLABS, LV_L, LV_OC.
 IF LV_OC IS NOT INITIAL.
  SELECT * FROM AUFM INTO TABLE LT_C WHERE AUFNR = LV_OC
   AND BWART = '261'.
  LOOP AT LT_C INTO LS_C.
   WRITE: / '    261', LS_C-MATNR(10), LS_C-CHARG.
  ENDLOOP.
 ENDIF.
ENDLOOP.
* 7: hasil order 100000778527
SELECT SINGLE MILL_OC_AUFNR_U INTO LV_L FROM AFPO
 WHERE AUFNR = '100000778527'.
WRITE: / 'ORD527 ref', LV_L.
SELECT * FROM MSEG INTO TABLE LT_S WHERE ( AUFNR = '100000778527'
 OR AUFNR = LV_L ) AND BWART = '101'.
LOOP AT LT_S INTO LS_S.
 CLEAR LS_B.
 SELECT SINGLE * FROM MCHB INTO LS_B WHERE MATNR = LS_S-MATNR
  AND WERKS = '2000' AND CHARG = LS_S-CHARG.
 WRITE: / '  101', LS_S-MATNR(10), LS_S-CHARG, LS_S-LGORT,
  'stk', LS_B-CLABS.
ENDLOOP.
* 16: SRAAAI stok
SELECT * FROM MCHB INTO TABLE LT_B WHERE MATNR = 'SRAAAI'
 AND WERKS = '2000' AND CLABS > 100.
LOOP AT LT_B INTO LS_B.
 SELECT SINGLE ERSDA LICHA INTO (LV_D, LV_L) FROM MCH1
  WHERE MATNR = LS_B-MATNR AND CHARG = LS_B-CHARG.
 CHECK LV_D >= '20250101'.
 WRITE: / 'AAAI', LS_B-CHARG, LV_D, LS_B-LGORT, LS_B-CLABS, LV_L.
ENDLOOP.
* 20: SRCBUX 9003864618 gerakan
SELECT * FROM MSEG INTO TABLE LT_S WHERE MATNR = 'SRCBUX'
 AND CHARG = '9003864618'.
LOOP AT LT_S INTO LS_S.
 WRITE: / 'CBUX', LS_S-BWART, LS_S-WERKS, LS_S-LGORT, LS_S-AUFNR,
  LS_S-EBELN, LS_S-LIFNR.
ENDLOOP.
