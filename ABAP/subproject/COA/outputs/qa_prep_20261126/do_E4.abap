REPORT ZQA_DOE4.
DATA: LT_S TYPE TABLE OF BAPIDLVREFTOSALESORDER WITH HEADER LINE,
 LT_C TYPE TABLE OF BAPIDLVITEMCREATED WITH HEADER LINE,
 LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
 LV_D TYPE VBELN_VL, LV_E TYPE C.
LT_S-REF_DOC = '0000015876'. LT_S-REF_ITEM = '000010'.
LT_S-DLV_QTY = '3654.940'. LT_S-SALES_UNIT = 'KG'. APPEND LT_S.
CALL FUNCTION 'BAPI_OUTB_DELIVERY_CREATE_SLS'
  EXPORTING SHIP_POINT = '2000' DUE_DATE = SY-DATUM
  IMPORTING DELIVERY = LV_D
  TABLES SALES_ORDER_ITEMS = LT_S CREATED_ITEMS = LT_C
         RETURN = LT_R.
LOOP AT LT_R.
  WRITE: / LT_R-TYPE, LT_R-ID, LT_R-NUMBER, LT_R-MESSAGE_V1,
   LT_R-MESSAGE_V2, LT_R-MESSAGE_V3.
  IF LT_R-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
IF LV_E IS INITIAL AND LV_D IS NOT INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'DO CREATED', LV_D.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'DO NOT CREATED'.
ENDIF.
