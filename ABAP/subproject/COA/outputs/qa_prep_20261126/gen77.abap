LOOP AT LT_R INTO LS_R.
 CLEAR: LV_A, LV_J, LV_JM, LV_F.
 REFRESH LT_A.
 SELECT SINGLE AUFNR FROM MSEG INTO LV_A WHERE MATNR = LS_R-M
  AND CHARG = LS_R-C AND BWART = '101' AND AUFNR <> SPACE.
 IF LV_A IS INITIAL.
  WRITE: / 'GEN', LS_R-D, LS_R-C, 'tanpa order 101'.
  CONTINUE.
 ENDIF.
 SELECT MATNR CHARG FROM MSEG INTO (LV_JM, LV_J) UP TO 1 ROWS
  WHERE AUFNR = LV_A AND BWART = '261' AND MATNR LIKE 'JR%'.
 ENDSELECT.
 IF LV_J IS INITIAL.
  WRITE: / 'GEN', LS_R-D, LS_R-C, 'order', LV_A, 'tanpa JR 261'.
  CONTINUE.
 ENDIF.
 SELECT AUFNR FROM MSEG INTO TABLE LT_A WHERE MATNR = LV_JM
  AND CHARG = LV_J AND BWART = '261'.
 SORT LT_A. DELETE ADJACENT DUPLICATES FROM LT_A.
 WRITE: / 'GEN', LS_R-D, LS_R-M, LS_R-C, 'JR', LV_JM, LV_J.
 LOOP AT LT_A INTO LV_A2.
  SELECT * FROM MSEG INTO TABLE LT_S WHERE AUFNR = LV_A2
   AND BWART = '101' AND MATNR = LS_R-M.
  LOOP AT LT_S INTO LS_S.
   SELECT * FROM MCHB INTO TABLE LT_B WHERE MATNR = LS_S-MATNR
    AND CHARG = LS_S-CHARG AND CLABS > 0.
   IF LT_B IS INITIAL. CONTINUE. ENDIF.
   SELECT * FROM LIPS INTO TABLE LT_I WHERE MATNR = LS_S-MATNR
    AND CHARG = LS_S-CHARG.
   DESCRIBE TABLE LT_I LINES LV_N.
   IF LV_N = 0.
    READ TABLE LT_B INTO LS_B INDEX 1.
    WRITE: / '   FREE', LS_S-CHARG, LS_B-LGORT, LS_B-CLABS.
   ENDIF.
  ENDLOOP.
 ENDLOOP.
ENDLOOP.
