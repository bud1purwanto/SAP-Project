REPORT ZQA_GEN77.
TYPES: BEGIN OF TY_R, D TYPE VBELN, M TYPE MATNR, C TYPE CHARG_D,
 END OF TY_R.
DATA: LT_R TYPE TABLE OF TY_R, LS_R TYPE TY_R,
 LV_A TYPE AUFNR, LV_J TYPE CHARG_D, LV_JM TYPE MATNR,
 LT_A TYPE TABLE OF AUFNR, LV_A2 TYPE AUFNR,
 LT_S TYPE TABLE OF MSEG, LS_S TYPE MSEG,
 LT_B TYPE TABLE OF MCHB, LS_B TYPE MCHB,
 LT_I TYPE TABLE OF LIPS, LV_N TYPE I, LV_F TYPE I.
DEFINE R.
 LS_R-D = &1. LS_R-M = &2. LS_R-C = &3.
 APPEND LS_R TO LT_R.
END-OF-DEFINITION.
