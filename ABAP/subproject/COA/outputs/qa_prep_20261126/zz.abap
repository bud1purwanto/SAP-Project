REPORT ZQA_ZZ.
DATA: LT_D TYPE TABLE OF DD03L, LS_D TYPE DD03L.
SELECT * FROM DD03L INTO TABLE LT_D WHERE TABNAME = 'VBAP'
 AND FIELDNAME LIKE 'ZZ%'.
LOOP AT LT_D INTO LS_D.
 WRITE: / 'VBAP', LS_D-FIELDNAME, LS_D-ROLLNAME, LS_D-INTTYPE.
ENDLOOP.
