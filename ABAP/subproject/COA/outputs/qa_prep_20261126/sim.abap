REPORT ZQA_SIM.
DATA: LS_H TYPE BAPISDHEAD, LT_P TYPE TABLE OF BAPIPARNR,
 LS_P TYPE BAPIPARNR, LT_I TYPE TABLE OF BAPIITEMIN,
 LS_I TYPE BAPIITEMIN, LT_S TYPE TABLE OF BAPISCHDL,
 LS_S TYPE BAPISCHDL, LT_R TYPE TABLE OF BAPIRET2,
 LS_R TYPE BAPIRET2, LT_O TYPE TABLE OF BAPIITEMEX,
 LS_O TYPE BAPIITEMEX, LT_K TYPE TABLE OF VBKD.
DATA: LT_C TYPE TABLE OF STRING.
LS_H-DOC_TYPE = 'ZDOR'. LS_H-SALES_ORG = '1000'.
LS_H-DISTR_CHAN = '00'. LS_H-DIVISION = '00'.
LS_P-PARTN_ROLE = 'AG'. LS_P-PARTN_NUMB = '1141000584'.
APPEND LS_P TO LT_P.
LS_P-PARTN_ROLE = 'WE'. APPEND LS_P TO LT_P.
LS_I-ITM_NUMBER = '000010'. LS_I-MATERIAL = 'SRAABI'.
LS_I-PLANT = '2000'. LS_I-TARGET_QTY = '721'.
LS_I-TARGET_QU = 'KG'. APPEND LS_I TO LT_I.
LS_S-ITM_NUMBER = '000010'. LS_S-REQ_QTY = '721'.
APPEND LS_S TO LT_S.
CALL FUNCTION 'BAPI_SALESORDER_SIMULATE'
 EXPORTING ORDER_HEADER_IN = LS_H
 TABLES RETURN = LT_R ORDER_ITEMS_IN = LT_I
  ORDER_PARTNERS = LT_P ORDER_SCHEDULE_IN = LT_S
  ORDER_ITEMS_OUT = LT_O.
LOOP AT LT_R INTO LS_R.
 WRITE: / LS_R-TYPE, LS_R-ID, LS_R-NUMBER, LS_R-MESSAGE(60).
ENDLOOP.
LOOP AT LT_O INTO LS_O.
 WRITE: / 'ITEM', LS_O-ITM_NUMBER, LS_O-MATERIAL, LS_O-ITEM_CATEG.
ENDLOOP.
