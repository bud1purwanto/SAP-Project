REPORT ZQA_ORD.
DATA: LT TYPE TABLE OF AUFM, LS TYPE AUFM, LT2 TYPE TABLE OF MSEG,
 LS2 TYPE MSEG.
SELECT * FROM AUFM INTO TABLE LT WHERE AUFNR = '100000778212'.
LOOP AT LT INTO LS.
 WRITE: / 'AUFM', LS-BWART, LS-MATNR(18), LS-CHARG, LS-MENGE, LS-BUDAT.
ENDLOOP.
SELECT * FROM MSEG INTO TABLE LT2 WHERE AUFNR = '100000778212'.
LOOP AT LT2 INTO LS2.
 WRITE: / 'MSEG', LS2-BWART, LS2-MATNR(18), LS2-CHARG, LS2-MENGE.
ENDLOOP.
SELECT * FROM MSEG INTO TABLE LT2 UP TO 30 ROWS
 WHERE MATNR = 'SRAABI' AND WERKS = '2000' AND MJAHR = '2026'.
LOOP AT LT2 INTO LS2.
 WRITE: / 'SR26', LS2-BWART, LS2-CHARG, LS2-AUFNR, LS2-MENGE, LS2-MBLNR.
ENDLOOP.
