REPORT ZQA_SO.
DATA: LS_K TYPE VBAK, LS_D TYPE VBKD, LS_V TYPE VBAP,
 LT_P TYPE TABLE OF VBPA, LS_P TYPE VBPA,
 LT_C TYPE TABLE OF KONV, LS_C TYPE KONV, LS_E TYPE VBEP,
 LS_L TYPE LIKP.
SELECT SINGLE * FROM VBAK INTO LS_K WHERE VBELN = '0000015856'.
WRITE: / 'VBAK', LS_K-AUART, LS_K-VKORG, LS_K-VTWEG, LS_K-SPART,
 LS_K-VKBUR, LS_K-VKGRP, LS_K-WAERK, LS_K-VSBED, LS_K-AUGRU,
 LS_K-VSBED, LS_K-KNUMV.
SELECT SINGLE * FROM VBKD INTO LS_D WHERE VBELN = '0000015856'
 AND POSNR = '000000'.
WRITE: / 'VBKD', LS_D-ZTERM, LS_D-INCO1, LS_D-INCO2.
SELECT SINGLE * FROM VBAP INTO LS_V WHERE VBELN = '0000015856'
 AND POSNR = '000010'.
WRITE: / 'VBAP', LS_V-MATNR, LS_V-WERKS, LS_V-LGORT, LS_V-PSTYV,
 LS_V-KWMENG, LS_V-VRKME, LS_V-ROUTE.
SELECT * FROM VBPA INTO TABLE LT_P WHERE VBELN = '0000015856'.
LOOP AT LT_P INTO LS_P.
 WRITE: / 'VBPA', LS_P-POSNR, LS_P-PARVW, LS_P-KUNNR.
ENDLOOP.
SELECT * FROM KONV INTO TABLE LT_C WHERE KNUMV = LS_K-KNUMV.
LOOP AT LT_C INTO LS_C.
 WRITE: / 'KONV', LS_C-KPOSN, LS_C-KSCHL, LS_C-KBETR, LS_C-WAERS.
ENDLOOP.
SELECT SINGLE * FROM VBEP INTO LS_E WHERE VBELN = '0000015856'
 AND POSNR = '000010'.
WRITE: / 'VBEP', LS_E-ETENR, LS_E-WMENG, LS_E-LFREL.
SELECT SINGLE * FROM LIKP INTO LS_L WHERE VBELN = '0085051551'.
WRITE: / 'LIKP', LS_L-LFART, LS_L-VSTEL, LS_L-KUNNR, LS_L-KUNAG,
 LS_L-VKORG, LS_L-ROUTE, LS_L-WADAT, LS_L-LFDAT.
