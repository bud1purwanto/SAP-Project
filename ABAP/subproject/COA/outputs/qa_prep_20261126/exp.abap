REPORT ZQA_EXP.
DATA: LS_A TYPE KNA1, LT_V TYPE TABLE OF KNVV, LS_V TYPE KNVV,
 LS_K TYPE VBAK.
DEFINE C.
 SELECT SINGLE * FROM KNA1 INTO LS_A WHERE KUNNR = &1.
 WRITE: / &1, LS_A-LAND1, LS_A-NAME1(30).
 SELECT * FROM KNVV INTO TABLE LT_V WHERE KUNNR = &1.
 LOOP AT LT_V INTO LS_V.
  WRITE: / '   area', LS_V-VKORG, LS_V-VTWEG, LS_V-SPART, LS_V-VKBUR,
   LS_V-WAERS.
 ENDLOOP.
END-OF-DEFINITION.
