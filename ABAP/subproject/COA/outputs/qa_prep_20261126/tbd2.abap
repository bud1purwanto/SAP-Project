REPORT ZQA_TBD2.
DATA: LT_S TYPE TABLE OF MSEG, LS_S TYPE MSEG, LS_B TYPE MCHB,
 LT_C TYPE TABLE OF AUFM, LS_C TYPE AUFM, LV_L TYPE MCH1-LICHA,
 LV_R TYPE AFPO-MILL_OC_AUFNR_U, LS_Q TYPE QALS.
WRITE: / 'A. order 100000778527'.
SELECT * FROM MSEG INTO TABLE LT_S UP TO 40 ROWS
 WHERE AUFNR = '100000778527'.
LOOP AT LT_S INTO LS_S.
 CLEAR LS_B.
 SELECT SINGLE * FROM MCHB INTO LS_B WHERE MATNR = LS_S-MATNR
  AND WERKS = '2000' AND CHARG = LS_S-CHARG AND CLABS > 0.
 WRITE: / '  ', LS_S-BWART, LS_S-MATNR(10), LS_S-CHARG, LS_B-LGORT,
  LS_B-CLABS.
ENDLOOP.
SELECT SINGLE MILL_OC_AUFNR_U INTO LV_R FROM AFPO
 WHERE AUFNR = '100000778527'.
WRITE: / '  mill_oc ref', LV_R.
IF LV_R IS NOT INITIAL.
 SELECT * FROM MSEG INTO TABLE LT_S UP TO 40 ROWS
  WHERE AUFNR = LV_R AND BWART = '101'.
 LOOP AT LT_S INTO LS_S.
  WRITE: / '  ref101', LS_S-MATNR(10), LS_S-CHARG, LS_S-LGORT.
 ENDLOOP.
ENDIF.
WRITE: / 'B. order SRCBUX 100000771932'.
SELECT * FROM AUFM INTO TABLE LT_C WHERE AUFNR = '100000771932'.
LOOP AT LT_C INTO LS_C.
 CLEAR LV_L.
 SELECT SINGLE LICHA INTO LV_L FROM MCH1 WHERE MATNR = LS_C-MATNR
  AND CHARG = LS_C-CHARG.
 WRITE: / '  ', LS_C-BWART, LS_C-MATNR(14), LS_C-CHARG, LS_C-WERKS,
  'licha', LV_L.
ENDLOOP.
SELECT SINGLE MILL_OC_AUFNR_U INTO LV_R FROM AFPO
 WHERE AUFNR = '100000771932'.
WRITE: / '  mill_oc ref', LV_R.
WRITE: / 'C. lot SRCBUX Z05 berhasil'.
SELECT * FROM QALS INTO LS_Q UP TO 3 ROWS WHERE MATNR = 'SRCBUX'
 AND ART = 'Z05'.
 WRITE: / '  ', LS_Q-PRUEFLOS, LS_Q-WERK, LS_Q-CHARG, LS_Q-ENSTEHDAT,
  LS_Q-AUFNR.
ENDSELECT.
WRITE: / 'D. SRAAAI stok'.
SELECT * FROM MCHB INTO LS_B UP TO 6 ROWS WHERE MATNR = 'SRAAAI'
 AND WERKS = '2000' AND CLABS > 100.
 WRITE: / '  ', LS_B-CHARG, LS_B-LGORT, LS_B-CLABS.
ENDSELECT.
