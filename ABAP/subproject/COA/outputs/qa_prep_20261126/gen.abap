REPORT ZQA_GEN.
TYPES: BEGIN OF TY_L, PRUEFLOS TYPE QALS-PRUEFLOS, ART TYPE QALS-ART,
 MATNR TYPE QALS-MATNR, CHARG TYPE QALS-CHARG, AUFNR TYPE QALS-AUFNR,
 DAT TYPE QALS-ENSTEHDAT, END OF TY_L.
DATA: LT_L TYPE TABLE OF TY_L, LS_L TYPE TY_L, LV_N TYPE I,
 LT_A TYPE TABLE OF AUFM, LS_A TYPE AUFM, LT_O TYPE TABLE OF AUFM,
 LS_O TYPE AUFM, LT_C TYPE TABLE OF AUFM, LS_C TYPE AUFM,
 LV_ST TYPE MCHB-CLABS, LV_Q TYPE I, LV_NC TYPE I, LV_U TYPE I,
 LV_R TYPE AFPO-MILL_OC_AUFNR_U, LT_P TYPE TABLE OF AFPO, LV_NP TYPE I,
 LV_X TYPE QALS-PRUEFLOS, LV_XA TYPE QALS-ART, LV_309 TYPE I.
SELECT PRUEFLOS ART MATNR CHARG AUFNR ENSTEHDAT FROM QALS
 INTO TABLE LT_L WHERE WERK = '2000' AND ART = 'Z02'
 AND ENSTEHDAT >= '20250101'.
LOOP AT LT_L INTO LS_L.
 SELECT COUNT(*) INTO LV_N FROM QAMR WHERE PRUEFLOS = LS_L-PRUEFLOS.
 CHECK LV_N > 0.
 WRITE: / 'JR', LS_L-PRUEFLOS, LS_L-MATNR(10), LS_L-CHARG,
  LS_L-AUFNR, LS_L-DAT.
* komponen order JR (mundur)
 IF LS_L-AUFNR IS NOT INITIAL.
  SELECT * FROM AUFM INTO TABLE LT_C WHERE AUFNR = LS_L-AUFNR
   AND BWART = '261'.
  LOOP AT LT_C INTO LS_C WHERE CHARG IS NOT INITIAL.
   WRITE: / '  IN', LS_C-MATNR(18), LS_C-CHARG.
  ENDLOOP.
 ENDIF.
* order yang memakai JR (maju)
 SELECT * FROM AUFM INTO TABLE LT_A WHERE MATNR = LS_L-MATNR
  AND CHARG = LS_L-CHARG AND BWART = '261'.
 SORT LT_A BY AUFNR. DELETE ADJACENT DUPLICATES FROM LT_A
  COMPARING AUFNR.
 LOOP AT LT_A INTO LS_A.
  SELECT * FROM AUFM INTO TABLE LT_C WHERE AUFNR = LS_A-AUFNR
   AND BWART = '261'.
  SORT LT_C BY CHARG. DELETE ADJACENT DUPLICATES FROM LT_C
   COMPARING CHARG. DESCRIBE TABLE LT_C LINES LV_NC.
  WRITE: / '  ORD', LS_A-AUFNR, 'nKomp', LV_NC.
  CLEAR LV_R.
  SELECT SINGLE MILL_OC_AUFNR_U INTO LV_R FROM AFPO
   WHERE AUFNR = LS_A-AUFNR.
  WRITE: 'ref', LV_R.
  SELECT * FROM AUFM INTO TABLE LT_O WHERE ( AUFNR = LS_A-AUFNR
   OR AUFNR = LV_R ) AND BWART = '101'.
  IF LV_R IS NOT INITIAL.
   SELECT * FROM AFPO INTO TABLE LT_P WHERE MILL_OC_AUFNR_U = LV_R.
   DESCRIBE TABLE LT_P LINES LV_NP. WRITE: 'nOrdGab', LV_NP.
  ENDIF.
  LOOP AT LT_O INTO LS_O WHERE CHARG IS NOT INITIAL.
   CLEAR: LV_ST, LV_X, LV_XA, LV_Q, LV_U, LV_309.
   SELECT SUM( CLABS ) INTO LV_ST FROM MCHB WHERE MATNR = LS_O-MATNR
    AND CHARG = LS_O-CHARG.
   SELECT PRUEFLOS ART INTO (LV_X, LV_XA) FROM QALS UP TO 1 ROWS
    WHERE MATNR = LS_O-MATNR AND CHARG = LS_O-CHARG. ENDSELECT.
   IF LV_X IS NOT INITIAL.
    SELECT COUNT(*) INTO LV_Q FROM QAMR WHERE PRUEFLOS = LV_X.
   ENDIF.
   SELECT COUNT(*) INTO LV_U FROM AUFM WHERE MATNR = LS_O-MATNR
    AND CHARG = LS_O-CHARG AND BWART = '261'.
   SELECT COUNT(*) INTO LV_309 FROM MSEG WHERE MATNR = LS_O-MATNR
    AND CHARG = LS_O-CHARG AND BWART = '309'.
   WRITE: / '   SR', LS_O-MATNR(10), LS_O-CHARG, 'stk', LV_ST,
    'lot', LV_X, LV_XA, 'res', LV_Q, 'used', LV_U, 'cg', LV_309.
  ENDLOOP.
 ENDLOOP.
ENDLOOP.
