REPORT ZQA_NR.
DATA: LV_A TYPE AUSP-ATINN, LV_C TYPE MCH1-CUOBJ_BM,
 LV_O TYPE AUSP-OBJEK, LV_W TYPE AUSP-ATWRT, LV_M TYPE MCH1-MATNR.
DEFINE B.
 CLEAR: LV_C, LV_W, LV_M.
 SELECT SINGLE CUOBJ_BM MATNR FROM MCH1 INTO (LV_C, LV_M)
  WHERE CHARG = &1.
 LV_O = LV_C.
 SELECT SINGLE ATWRT FROM AUSP INTO LV_W WHERE OBJEK = LV_O
  AND ATINN = LV_A AND KLART = '023' AND MAFID = 'O'.
 WRITE: / &1, LV_M, LV_W.
END-OF-DEFINITION.
