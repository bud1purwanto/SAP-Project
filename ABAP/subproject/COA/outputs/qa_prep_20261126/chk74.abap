REPORT ZQA_CHK74.
DATA: LT_I TYPE TABLE OF LIPS, LS_I TYPE LIPS,
 LV_W TYPE VBUK-WBSTK, LV_D TYPE LIKP-LFART,
 LV_E TYPE LIKP-ERDAT, LV_K TYPE LIKP-KUNNR.
DEFINE R.
 SELECT * FROM LIPS INTO TABLE LT_I WHERE MATNR = &1
  AND CHARG = &2.
 LOOP AT LT_I INTO LS_I.
  SELECT SINGLE WBSTK INTO LV_W FROM VBUK WHERE VBELN = LS_I-VBELN.
  SELECT SINGLE LFART ERDAT KUNNR INTO (LV_D, LV_E, LV_K) FROM LIKP
   WHERE VBELN = LS_I-VBELN.
  WRITE: / &2, LS_I-VBELN, LS_I-POSNR, LS_I-PSTYV, LV_D, LV_E, LV_K,
   'wbstk', LV_W.
 ENDLOOP.
END-OF-DEFINITION.
