REPORT ZQA_STK.
DATA: LT TYPE TABLE OF MCHB, LS TYPE MCHB, LV_N TYPE I, LV_9 TYPE I,
 LT_M TYPE TABLE OF MATNR, LV_M TYPE MATNR, LV_D TYPE MCH1-ERSDA,
 LV_MAX TYPE MCH1-ERSDA, LV_L TYPE MCH1-LICHA, LT_A TYPE TABLE OF AUFM,
 LS_A TYPE AUFM.
APPEND: 'SRCBUX' TO LT_M, 'SREC7I' TO LT_M, 'SRCADI' TO LT_M,
 'SRVC2I' TO LT_M, 'SRGJBI' TO LT_M, 'SREYAI' TO LT_M, 'SRAAAI' TO LT_M,
 'SRABDI' TO LT_M, 'SRGLBI' TO LT_M, 'SREWEI' TO LT_M, 'SREASI' TO LT_M,
 'SRGIDI' TO LT_M, 'SRACBI' TO LT_M, 'SRAABI' TO LT_M, 'SREC7X' TO LT_M.
LOOP AT LT_M INTO LV_M.
 SELECT * FROM MCHB INTO TABLE LT WHERE MATNR = LV_M AND WERKS = '2000'
  AND CLABS > 0.
 DESCRIBE TABLE LT LINES LV_N. LV_9 = 0. CLEAR LV_MAX.
 LOOP AT LT INTO LS.
  IF LS-CHARG(1) = '9'. LV_9 = LV_9 + 1. ENDIF.
  SELECT SINGLE ERSDA INTO LV_D FROM MCH1 WHERE MATNR = LS-MATNR
   AND CHARG = LS-CHARG.
  IF LV_D > LV_MAX. LV_MAX = LV_D. ENDIF.
 ENDLOOP.
 WRITE: / LV_M, 'stokBatch', LV_N, 'batch9', LV_9, 'terbaru', LV_MAX.
 LOOP AT LT INTO LS WHERE CHARG(1) = '9' AND CLABS > 1.
  CHECK SY-TABIX < 4.
  SELECT SINGLE LICHA INTO LV_L FROM MCH1 WHERE MATNR = LS-MATNR
   AND CHARG = LS-CHARG.
  WRITE: / '  9*', LS-CHARG, LS-LGORT, LS-CLABS, 'LICHA', LV_L.
 ENDLOOP.
ENDLOOP.
SELECT * FROM AUFM INTO TABLE LT_A WHERE MATNR = 'SRAABI'
 AND CHARG = '0003884165'.
LOOP AT LT_A INTO LS_A.
 WRITE: / 'SR3884165', LS_A-BWART, LS_A-AUFNR.
ENDLOOP.
