REPORT ZQA_VER2.
DATA: LS_K TYPE LIKP, LT_I TYPE TABLE OF LIPS, LS_I TYPE LIPS,
 LV_N TYPE I, LV_Q TYPE LIPS-LFIMG, LV_L TYPE KNA1-LAND1,
 LV_W TYPE VBUK-WBSTK.
DEFINE D.
 SELECT SINGLE * FROM LIKP INTO LS_K WHERE VBELN = &1.
 SELECT * FROM LIPS INTO TABLE LT_I WHERE VBELN = &1
  AND PSTYV = 'ZB'.
 DESCRIBE TABLE LT_I LINES LV_N.
 CLEAR LV_Q.
 LOOP AT LT_I INTO LS_I.
  LV_Q = LV_Q + LS_I-LFIMG.
 ENDLOOP.
 READ TABLE LT_I INTO LS_I INDEX 1.
 SELECT SINGLE LAND1 FROM KNA1 INTO LV_L WHERE KUNNR = LS_K-KUNNR.
 SELECT SINGLE WBSTK FROM VBUK INTO LV_W WHERE VBELN = &1.
 WRITE: / &1, LS_K-LFART, LS_K-KUNNR, LV_L, LS_I-MATNR, 'roll', LV_N,
  'kg', LV_Q, 'wbstk', LV_W.
END-OF-DEFINITION.
D '0085051584'.
D '0085051585'.
D '0085051586'.
D '0085051587'.
D '0085051551'.
