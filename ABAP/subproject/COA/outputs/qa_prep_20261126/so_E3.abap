REPORT ZQA_SOE3.
DATA: LS_H TYPE BAPISDHD1,
 LT_I TYPE TABLE OF BAPISDITM WITH HEADER LINE,
 LT_P TYPE TABLE OF BAPIPARNR WITH HEADER LINE,
 LT_S TYPE TABLE OF BAPISCHDL WITH HEADER LINE,
 LT_CN TYPE TABLE OF BAPICOND WITH HEADER LINE,
 LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
 LT_EX TYPE TABLE OF BAPIPAREX WITH HEADER LINE,
 LS_EX TYPE BAPE_VBAP,
 LV_SO TYPE BAPIVBELN-VBELN, LV_E TYPE C.
LS_H-DOC_TYPE = 'ZEOR'. LS_H-SALES_ORG = '1000'.
LS_H-DISTR_CHAN = '02'. LS_H-DIVISION = '00'.
LS_H-SALES_OFF = '0002'.
LS_H-REQ_DATE_H = SY-DATUM.
LT_P-PARTN_ROLE = 'AG'. LT_P-PARTN_NUMB = '1141100236'. APPEND LT_P.
LT_P-PARTN_ROLE = 'RE'. LT_P-PARTN_NUMB = '1141100236'. APPEND LT_P.
LT_P-PARTN_ROLE = 'RG'. LT_P-PARTN_NUMB = '1141100236'. APPEND LT_P.
LT_P-PARTN_ROLE = 'WE'. LT_P-PARTN_NUMB = '1141100236'. APPEND LT_P.
LT_I-ITM_NUMBER = '000010'. LT_I-MATERIAL = 'SRAABI'.
LT_I-PLANT = '2000'. LT_I-STORE_LOC = '2302'.
LT_I-TARGET_QTY = '3590.520'. LT_I-TARGET_QU = 'KG'. APPEND LT_I.
LT_S-ITM_NUMBER = '000010'. LT_S-SCHED_LINE = '0001'.
LT_S-REQ_QTY = '3590.520'. APPEND LT_S.
LT_CN-ITM_NUMBER = '000010'. LT_CN-COND_TYPE = 'ZE00'.
LT_CN-COND_VALUE = '100'. LT_CN-CURRENCY = 'USD'.
LT_CN-COND_P_UNT = 1. LT_CN-COND_UNIT = 'KG'. APPEND LT_CN.
LS_EX-POSNR = '000010'. LS_EX-ZDATE = SY-DATUM.
LS_EX-ZLINE = '1'.
LT_EX-STRUCTURE = 'BAPE_VBAP'. LT_EX-VALUEPART1 = LS_EX.
APPEND LT_EX.
CALL FUNCTION 'BAPI_SALESORDER_CREATEFROMDAT2'
  EXPORTING ORDER_HEADER_IN = LS_H
  IMPORTING SALESDOCUMENT = LV_SO
  TABLES RETURN = LT_R ORDER_ITEMS_IN = LT_I EXTENSIONIN = LT_EX
         ORDER_PARTNERS = LT_P ORDER_SCHEDULES_IN = LT_S
         ORDER_CONDITIONS_IN = LT_CN.
LOOP AT LT_R.
  WRITE: / LT_R-TYPE, LT_R-ID, LT_R-NUMBER, LT_R-MESSAGE_V1,
   LT_R-MESSAGE_V2, LT_R-MESSAGE_V3.
  IF LT_R-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
IF LV_E IS INITIAL AND LV_SO IS NOT INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'SO CREATED', LV_SO.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'SO NOT CREATED', LV_E.
ENDIF.
