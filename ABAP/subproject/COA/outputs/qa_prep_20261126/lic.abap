REPORT ZQA_LIC.
DATA: LT TYPE TABLE OF MCH1, LS TYPE MCH1, LT2 TYPE TABLE OF MSEG,
 LS2 TYPE MSEG.
SELECT * FROM MCH1 INTO TABLE LT WHERE CHARG = '0003883665'
 OR CHARG = '0003885063' OR CHARG = '0003883666'.
LOOP AT LT INTO LS.
 WRITE: / LS-MATNR(10), LS-CHARG, 'LICHA', LS-LICHA, LS-ERSDA.
ENDLOOP.
SELECT * FROM MCH1 INTO TABLE LT UP TO 20 ROWS
 WHERE LICHA = '100000778212' OR LICHA = '0003883652'
 OR LICHA = '000100000778212'.
LOOP AT LT INTO LS.
 WRITE: / 'BYLIC', LS-MATNR(10), LS-CHARG, LS-LICHA.
ENDLOOP.
SELECT * FROM MSEG INTO TABLE LT2 WHERE CHARG = '0003883665'
 AND MATNR = 'SRAABI'.
LOOP AT LT2 INTO LS2.
 WRITE: / 'MV', LS2-BWART, LS2-AUFNR, LS2-MBLNR, LS2-LGORT, LS2-MENGE.
ENDLOOP.
