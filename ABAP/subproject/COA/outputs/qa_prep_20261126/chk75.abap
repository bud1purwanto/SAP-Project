REPORT ZQA_CHK75.
DATA: LT_K TYPE TABLE OF LIKP, LS_K TYPE LIKP,
 LT_I TYPE TABLE OF LIPS, LS_I TYPE LIPS,
 LV_N TYPE I, LV_M TYPE MATNR, LV_B TYPE CHARG_D,
 LV_F TYPE CHARG_D, LV_L TYPE CHARG_D.
SELECT * FROM LIKP INTO TABLE LT_K WHERE ERDAT >= '20261124'
 AND VBELN >= '0085051500'.
SORT LT_K BY VBELN.
LOOP AT LT_K INTO LS_K.
 SELECT * FROM LIPS INTO TABLE LT_I WHERE VBELN = LS_K-VBELN
  AND PSTYV = 'ZB'.
 DESCRIBE TABLE LT_I LINES LV_N.
 CLEAR: LV_M, LV_F, LV_L.
 READ TABLE LT_I INTO LS_I INDEX 1.
 LV_M = LS_I-MATNR. LV_F = LS_I-CHARG.
 LOOP AT LT_I INTO LS_I.
  LV_L = LS_I-CHARG.
 ENDLOOP.
 WRITE: / LS_K-VBELN, LS_K-LFART, LS_K-ERDAT, LS_K-ERNAM,
  LS_K-KUNNR, 'ZB', LV_N, LV_M, LV_F, LV_L.
ENDLOOP.
