FORM ZZ_MT_RUN USING PV TYPE LIPS-VBELN.
  DATA: LV_S TYPE STRING.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZNOMORROLL' IMPORTING OUTPUT = ATINN_ROLL.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZCODE' IMPORTING OUTPUT = ATINN_CODE.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZWIDTH' IMPORTING OUTPUT = ATINN_WIDTH.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZLENGTH' IMPORTING OUTPUT = ATINN_LENGTH.
  P_VBELN-SIGN = 'I'. P_VBELN-OPTION = 'EQ'. P_VBELN-LOW = PV.
  APPEND P_VBELN.
  WRITE: / '#MANDT', SY-MANDT, SY-SYSID.
  PERFORM GET_DATA.
  LOOP AT IT_DATA.
    CONCATENATE '|' IT_DATA-VBELN '|' IT_DATA-MIC '|' IT_DATA-CMICMIT '|' IT_DATA-INSLOT INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT IT_DATA.
    CONCATENATE '#X|' IT_DATA-VBELN '|' IT_DATA-CHARG '|' IT_DATA-BATCH_MIC '|' IT_DATA-MIC '|' IT_DATA-INSLOT INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT IT_MIC1.
    CONCATENATE '#B|' IT_MIC1-VBELN '|' IT_MIC1-CHARG '|' IT_MIC1-MIC '|' IT_MIC1-INSLOT '|' IT_MIC1-MERKNR '|' IT_MIC1-CMICMIT INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  DATA LV_C TYPE C LENGTH 6.
  LOOP AT GT_JRAVG INTO GS_JRAVG.
    LV_C = GS_JRAVG-CNT.
    CONCATENATE '#J|' GS_JRAVG-INSLOT '|' GS_JRAVG-MIC '|' GS_JRAVG-ISJR '|' LV_C INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT GT_DBG.
    CONCATENATE '#D|' GT_DBG-K '|' GT_DBG-I '|' GT_DBG-M '|' GT_DBG-L INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
ENDFORM.
