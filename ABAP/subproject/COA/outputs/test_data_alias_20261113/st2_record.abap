REPORT ZZST2REC.
* Tahap 2 data uji alias: hasil inspeksi lot JR (1 nilai/karakteristik)
DATA: LT_SG TYPE TABLE OF BAPI2045D4 WITH HEADER LINE,
      LT_CR TYPE TABLE OF BAPI2045D2 WITH HEADER LINE,
      LT_RT TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LS_RT TYPE BAPIRET2, LV_L TYPE QALS-PRUEFLOS, LV_E TYPE C.
DEFINE ADDV.
  CLEAR: LT_SG, LT_CR.
  LT_SG-INSPLOT = LV_L. LT_SG-INSPOPER = '0010'.
  LT_SG-INSPCHAR = &1. LT_SG-RES_NO = '0001'.
  LT_SG-RES_VALUE = &2. LT_SG-INSP_DATE = SY-DATUM.
  LT_SG-INSP_TIME = SY-UZEIT. APPEND LT_SG.
  LT_CR-INSPLOT = LV_L. LT_CR-INSPOPER = '0010'.
  LT_CR-INSPCHAR = &1. LT_CR-CLOSED = 'X'.
  LT_CR-EVALUATED = 'X'. LT_CR-EVALUATION = 'A'. APPEND LT_CR.
END-OF-DEFINITION.
DEFINE POST.
  CLEAR: LS_RT, LV_E. REFRESH LT_RT.
  CALL FUNCTION 'BAPI_INSPOPER_RECORDRESULTS'
    EXPORTING INSPLOT = LV_L INSPOPER = '0010'
    IMPORTING RETURN = LS_RT
    TABLES CHAR_RESULTS = LT_CR SINGLE_RESULTS = LT_SG
           RETURNTABLE = LT_RT.
  WRITE: / LV_L, 'RET', LS_RT-TYPE, LS_RT-MESSAGE(100).
  IF LS_RT-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
  LOOP AT LT_RT.
    WRITE: / '  ', LT_RT-TYPE, LT_RT-MESSAGE(100).
    IF LT_RT-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
  ENDLOOP.
  IF LV_E IS INITIAL.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
    WRITE: / '  COMMIT'.
  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    WRITE: / '  ROLLBACK'.
  ENDIF.
END-OF-DEFINITION.
