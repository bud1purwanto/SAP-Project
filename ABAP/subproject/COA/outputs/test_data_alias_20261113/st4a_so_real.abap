REPORT ZZST4ASO.
* Tahap 4a data uji alias: SO (ZDOR) 2 item. TEST = 'X' simulasi.
PARAMETERS: P_TEST TYPE C DEFAULT ' '.
DATA: LS_H TYPE BAPISDHD1, LS_HX TYPE BAPISDHD1X,
      LT_I TYPE TABLE OF BAPISDITM WITH HEADER LINE,
      LT_IX TYPE TABLE OF BAPISDITMX WITH HEADER LINE,
      LT_P TYPE TABLE OF BAPIPARNR WITH HEADER LINE,
      LT_S TYPE TABLE OF BAPISCHDL WITH HEADER LINE,
      LT_SX TYPE TABLE OF BAPISCHDLX WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LT_K TYPE TABLE OF BAPICOND WITH HEADER LINE,
      LT_KX TYPE TABLE OF BAPICONDX WITH HEADER LINE,
      LT_EX TYPE TABLE OF BAPIPAREX WITH HEADER LINE,
      LS_EV TYPE BAPE_VBAP, LS_EVX TYPE BAPE_VBAPX,
      LV_SO TYPE BAPIVBELN-VBELN, LV_E TYPE C.
LS_H-DOC_TYPE = 'ZDOR'. LS_H-SALES_ORG = '1000'.
LS_H-DISTR_CHAN = '01'. LS_H-DIVISION = '00'.
LS_H-PURCH_NO_C = 'UJI ALIAS PLE-22 (COA OPSI 1)'.
LS_H-REQ_DATE_H = SY-DATUM. LS_H-SALES_OFF = '0002'.
LS_H-PMNTTRMS = 'P060'.
LS_HX-UPDATEFLAG = 'I'. LS_HX-DOC_TYPE = 'X'. LS_HX-SALES_ORG = 'X'.
LS_HX-DISTR_CHAN = 'X'. LS_HX-DIVISION = 'X'. LS_HX-PURCH_NO_C = 'X'.
LS_HX-REQ_DATE_H = 'X'. LS_HX-SALES_OFF = 'X'. LS_HX-PMNTTRMS = 'X'.
DEFINE ITM.
  LT_I-ITM_NUMBER = &1. LT_I-MATERIAL = &2. LT_I-PLANT = '2000'.
  LT_I-TARGET_QTY = &3. LT_I-TARGET_QU = 'KG'. APPEND LT_I.
  LT_IX-ITM_NUMBER = &1. LT_IX-UPDATEFLAG = 'I'. LT_IX-MATERIAL = 'X'.
  LT_IX-PLANT = 'X'. LT_IX-TARGET_QTY = 'X'. LT_IX-TARGET_QU = 'X'.
  APPEND LT_IX.
  LT_S-ITM_NUMBER = &1. LT_S-SCHED_LINE = '0001'.
  LT_S-REQ_QTY = &3. LT_S-REQ_DATE = SY-DATUM. APPEND LT_S.
  LT_SX-ITM_NUMBER = &1. LT_SX-SCHED_LINE = '0001'.
  LT_SX-UPDATEFLAG = 'I'. LT_SX-REQ_QTY = 'X'. LT_SX-REQ_DATE = 'X'.
  APPEND LT_SX.
  LT_K-ITM_NUMBER = &1. LT_K-COND_TYPE = 'ZD00'.
  LT_K-COND_VALUE = '339.85'. LT_K-CURRENCY = 'IDR'. APPEND LT_K.
  LT_KX-ITM_NUMBER = &1. LT_KX-COND_TYPE = 'ZD00'.
  LT_KX-UPDATEFLAG = 'I'. LT_KX-COND_VALUE = 'X'.
  LT_KX-CURRENCY = 'X'. APPEND LT_KX.
  CLEAR: LS_EV, LS_EVX, LT_EX. LS_EV-POSNR = &1.
  LS_EV-ZDATE = SY-DATUM. LS_EV-ZLINE = 'Z'.
  LT_EX-STRUCTURE = 'BAPE_VBAP'. LT_EX-VALUEPART1 = LS_EV.
  APPEND LT_EX. CLEAR LT_EX. LS_EVX-POSNR = &1.
  LS_EVX-ZDATE = 'X'. LS_EVX-ZLINE = 'X'.
  LT_EX-STRUCTURE = 'BAPE_VBAPX'. LT_EX-VALUEPART1 = LS_EVX.
  APPEND LT_EX.
END-OF-DEFINITION.
ITM '000010' 'SRAABI' '27.300'.
ITM '000020' 'SRABDI' '682.500'.
LT_P-PARTN_ROLE = 'AG'. LT_P-PARTN_NUMB = '1141000514'. APPEND LT_P.
LT_P-PARTN_ROLE = 'WE'. LT_P-PARTN_NUMB = '1141000514'. APPEND LT_P.
CALL FUNCTION 'BAPI_SALESORDER_CREATEFROMDAT2'
  EXPORTING ORDER_HEADER_IN = LS_H ORDER_HEADER_INX = LS_HX
            TESTRUN = P_TEST
  IMPORTING SALESDOCUMENT = LV_SO
  TABLES RETURN = LT_R ORDER_ITEMS_IN = LT_I ORDER_ITEMS_INX = LT_IX
         ORDER_PARTNERS = LT_P ORDER_SCHEDULES_IN = LT_S
         ORDER_SCHEDULES_INX = LT_SX
         ORDER_CONDITIONS_IN = LT_K ORDER_CONDITIONS_INX = LT_KX
         EXTENSIONIN = LT_EX.
LOOP AT LT_R.
  WRITE: / LT_R-TYPE, LT_R-ID(8), LT_R-NUMBER, LT_R-MESSAGE(90).
  IF LT_R-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
IF P_TEST IS INITIAL AND LV_E IS INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT SO', LV_SO.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'NO COMMIT (test/error)', LV_SO.
ENDIF.
