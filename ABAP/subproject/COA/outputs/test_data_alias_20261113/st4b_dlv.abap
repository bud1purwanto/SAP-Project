REPORT ZZST4BDLV.
* Tahap 4b data uji alias: outbound delivery dari SO 7205
DATA: LT_SO TYPE TABLE OF BAPIDLVREFTOSALESORDER WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LT_C TYPE TABLE OF BAPIDLVITEMCREATED WITH HEADER LINE,
      LV_D TYPE BAPISHPDELIVNUMB-DELIV_NUMB, LV_E TYPE C,
      LV_N TYPE BAPIDLVCREATEHEADER-NUM_DELIVERIES.
LT_SO-REF_DOC = '0000007205'. LT_SO-REF_ITEM = '000010'.
LT_SO-DLV_QTY = '27.300'. LT_SO-SALES_UNIT = 'KG'. APPEND LT_SO.
LT_SO-REF_DOC = '0000007205'. LT_SO-REF_ITEM = '000020'.
LT_SO-DLV_QTY = '682.500'. LT_SO-SALES_UNIT = 'KG'. APPEND LT_SO.
CALL FUNCTION 'BAPI_OUTB_DELIVERY_CREATE_SLS'
  EXPORTING SHIP_POINT = '2000' DUE_DATE = SY-DATUM
  IMPORTING DELIVERY = LV_D NUM_DELIVERIES = LV_N
  TABLES SALES_ORDER_ITEMS = LT_SO CREATED_ITEMS = LT_C
         RETURN = LT_R.
LOOP AT LT_R.
  WRITE: / LT_R-TYPE, LT_R-ID(8), LT_R-NUMBER, LT_R-MESSAGE(90).
  IF LT_R-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
LOOP AT LT_C.
  WRITE: / 'ITEM', LT_C-DELIV_NUMB, LT_C-DELIV_ITEM, LT_C-MATERIAL,
           LT_C-DLV_QTY.
ENDLOOP.
IF LV_E IS INITIAL AND LV_D IS NOT INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT DO', LV_D, LV_N.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK', LV_D.
ENDIF.
