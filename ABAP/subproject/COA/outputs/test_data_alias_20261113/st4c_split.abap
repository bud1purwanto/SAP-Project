REPORT ZZST4CSPLIT.
* Tahap 4c data uji alias: batch split DO 0085006280 (3+3 roll)
DATA: LS_H TYPE BAPIOBDLVHDRCHG, LS_HC TYPE BAPIOBDLVHDRCTRLCHG,
      LT_I TYPE TABLE OF BAPIOBDLVITEMCHG WITH HEADER LINE,
      LT_C TYPE TABLE OF BAPIOBDLVITEMCTRLCHG WITH HEADER LINE,
      LT_S TYPE TABLE OF /SPE/BAPIOBDLVITEMCHG WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LV_D TYPE VBELN_VL VALUE '0085006280', LV_E TYPE C.
DEFINE SPL.
  CLEAR: LT_I, LT_C, LT_S.
  LT_I-DELIV_NUMB = LV_D. LT_I-DELIV_ITEM = &1.
  LT_I-MATERIAL = &3. LT_I-BATCH = &4. LT_I-HIERARITEM = &2.
  LT_I-USEHIERITM = '1'. LT_I-DLV_QTY = &5.
  LT_I-DLV_QTY_IMUNIT = &5. LT_I-SALES_UNIT = 'KG'.
  LT_I-BASE_UOM = 'KG'. LT_I-FACT_UNIT_NOM = 1.
  LT_I-FACT_UNIT_DENOM = 1. APPEND LT_I.
  LT_C-DELIV_NUMB = LV_D. LT_C-DELIV_ITEM = &1.
  LT_C-CHG_DELQTY = 'X'. APPEND LT_C.
  LT_S-DELIV_NUMB = LV_D. LT_S-DELIV_ITEM = &1.
  LT_S-STGE_LOC = &6. APPEND LT_S.
END-OF-DEFINITION.
LS_H-DELIV_NUMB = LV_D. LS_HC-DELIV_NUMB = LV_D.
SPL '900001' '000010' 'SRAABI' '0000395789' '9.100' '2322'.
SPL '900002' '000010' 'SRAABI' '0000395790' '9.100' '2322'.
SPL '900003' '000010' 'SRAABI' '0000395791' '9.100' '2322'.
SPL '900004' '000020' 'SRABDI' '0000387115' '227.500' '2801'.
SPL '900005' '000020' 'SRABDI' '0000387116' '227.500' '2801'.
SPL '900006' '000020' 'SRABDI' '0000387117' '227.500' '2801'.
CALL FUNCTION 'BAPI_OUTB_DELIVERY_CHANGE'
  EXPORTING HEADER_DATA = LS_H HEADER_CONTROL = LS_HC
            DELIVERY = LV_D
  TABLES ITEM_DATA = LT_I ITEM_CONTROL = LT_C
         ITEM_DATA_SPL = LT_S RETURN = LT_R.
LOOP AT LT_R.
  WRITE: / LT_R-TYPE, LT_R-ID(8), LT_R-NUMBER, LT_R-MESSAGE(90).
  IF LT_R-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
IF LV_E IS INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT SPLIT'.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK'.
ENDIF.
