REPORT ZZST3ALIAS.
* Tahap 3 data uji alias: ZZALIAS = PLE-22 pada 6 roll stok
DATA: LT_N TYPE TABLE OF BAPI1003_ALLOC_VALUES_NUM WITH HEADER LINE,
      LT_C TYPE TABLE OF BAPI1003_ALLOC_VALUES_CHAR WITH HEADER LINE,
      LT_U TYPE TABLE OF BAPI1003_ALLOC_VALUES_CURR WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LV_K TYPE BAPI1003_KEY-OBJECT, LV_S TYPE CLSTATUS,
      LV_E TYPE C, LV_CNT TYPE I, LV_N0 TYPE I, LV_C0 TYPE I.
DEFINE DOB.
  CLEAR: LV_K, LV_E. REFRESH: LT_N, LT_C, LT_U, LT_R.
  LV_K(18) = &1. LV_K+18(10) = &2.
  CALL FUNCTION 'BAPI_OBJCL_GETDETAIL'
    EXPORTING OBJECTKEY = LV_K OBJECTTABLE = 'MCH1'
              CLASSNUM = 'ZZSRBOPP' CLASSTYPE = '023'
    IMPORTING STATUS = LV_S
    TABLES ALLOCVALUESNUM = LT_N ALLOCVALUESCHAR = LT_C
           ALLOCVALUESCURR = LT_U RETURN = LT_R.
  DESCRIBE TABLE LT_N LINES LV_N0. DESCRIBE TABLE LT_C LINES LV_C0.
  READ TABLE LT_C WITH KEY CHARACT = 'ZZALIAS'.
  IF SY-SUBRC = 0.
    WRITE: / &2, 'SKIP: ZZALIAS sudah ada', LT_C-VALUE_CHAR.
  ELSE.
    CLEAR LT_C. LT_C-CHARACT = 'ZZALIAS'.
    LT_C-VALUE_CHAR = 'PLE-22'. LT_C-VALUE_NEUTRAL = 'PLE-22'.
    APPEND LT_C. REFRESH LT_R.
    CALL FUNCTION 'BAPI_OBJCL_CHANGE'
      EXPORTING OBJECTKEY = LV_K OBJECTTABLE = 'MCH1'
                CLASSNUM = 'ZZSRBOPP' CLASSTYPE = '023'
      IMPORTING CLASSIF_STATUS = LV_S
      TABLES ALLOCVALUESNUMNEW = LT_N ALLOCVALUESCHARNEW = LT_C
             ALLOCVALUESCURRNEW = LT_U RETURN = LT_R.
    LOOP AT LT_R WHERE TYPE CA 'EA'. LV_E = 'X'.
      WRITE: / &2, LT_R-TYPE, LT_R-MESSAGE(90). ENDLOOP.
    IF LV_E IS INITIAL.
      CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
      WRITE: / &2, 'OK num', LV_N0, 'char', LV_C0, 'status', LV_S.
    ELSE.
      CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
      WRITE: / &2, 'ROLLBACK'.
    ENDIF.
  ENDIF.
END-OF-DEFINITION.
DOB 'SRAABI' '0000395789'.
DOB 'SRAABI' '0000395790'.
DOB 'SRAABI' '0000395791'.
DOB 'SRABDI' '0000387115'.
DOB 'SRABDI' '0000387116'.
DOB 'SRABDI' '0000387117'.
