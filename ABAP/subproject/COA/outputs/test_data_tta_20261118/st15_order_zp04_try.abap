REPORT ZZST15TRY.
* Uji (tanpa commit) buat order ZP04 JREYAI dari versi produksi 0002
PARAMETERS: P_COMMIT TYPE C DEFAULT ' '.
DATA: LS_O TYPE BAPI_PP_ORDER_CREATE,
      LS_R TYPE BAPIRET2,
      LV_N TYPE BAPI_ORDER_KEY-ORDER_NUMBER,
      LV_T TYPE AUFK-AUART.
LS_O-MATERIAL = 'JREYAI'. LS_O-PLANT = '2000'.
LS_O-ORDER_TYPE = 'ZP04'. LS_O-PROD_VERSION = '0002'.
LS_O-BASIC_START_DATE = SY-DATUM. LS_O-BASIC_END_DATE = SY-DATUM.
LS_O-QUANTITY = '0.004'. LS_O-QUANTITY_UOM = 'ROL'.
LS_O-STORAGE_LOCATION = '2052'.
CALL FUNCTION 'BAPI_PRODORD_CREATE'
  EXPORTING ORDERDATA = LS_O
  IMPORTING RETURN = LS_R ORDER_NUMBER = LV_N ORDER_TYPE = LV_T.
WRITE: / 'RET', LS_R-TYPE, LS_R-ID, LS_R-NUMBER, LS_R-MESSAGE(80).
WRITE: / 'ORDER', LV_N, LV_T.
IF P_COMMIT = 'X' AND LS_R-TYPE CA 'SIW' AND LV_N IS NOT INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT'.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK (uji)'.
ENDIF.
