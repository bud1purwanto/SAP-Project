REPORT ZZST19CLS.
* Data uji TTA: klasifikasi JREYAI 0000407417 (kelas ZZJRMETZ)
PARAMETERS: P_COMMIT TYPE C DEFAULT 'X'.
DATA: LT_N TYPE TABLE OF BAPI1003_ALLOC_VALUES_NUM WITH HEADER LINE,
      LT_C TYPE TABLE OF BAPI1003_ALLOC_VALUES_CHAR WITH HEADER LINE,
      LT_U TYPE TABLE OF BAPI1003_ALLOC_VALUES_CURR WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LV_K TYPE BAPI1003_KEY-OBJECT, LV_S TYPE CLSTATUS,
      LV_E TYPE C.
DEFINE CH.
  CLEAR LT_C. LT_C-CHARACT = &1.
  LT_C-VALUE_CHAR = &2. LT_C-VALUE_NEUTRAL = &2.
  APPEND LT_C.
END-OF-DEFINITION.
DEFINE NU.
  CLEAR LT_N. LT_N-CHARACT = &1.
  LT_N-VALUE_FROM = &2. APPEND LT_N.
END-OF-DEFINITION.
LV_K(18) = 'JREYAI'. LV_K+18(10) = '0000407417'.
CH 'ZZCODE' 'EYA'.
CH 'ZZGRADEJR' 'OK'.
CH 'ZZINSIDE' 'NO'.
CH 'ZZMONTHYEAR' '124'.
CH 'ZZNOMORROLL' 'G EYA 124 901'.
CH 'ZZOUTSIDE' 'NO'.
CH 'ZZPRODLINE' 'G'.
CH 'ZZSEQUENCENBR' '901'.
CH 'ZZTREATMENT' 'NONO'.
CH 'ZZTYPE' 'KEZ'.
NU 'ZZCONVERSIONMTRKG' '0.014168'.
NU 'ZZCONVERSIONROLLKG' '162.93'.
NU 'ZZDENSITY' '1.4'.
NU 'ZZGRAMMAGE' '15.4'.
NU 'ZZLENGTH' '11500'.
NU 'ZZPEMBILANGASAL' '162932000'.
NU 'ZZPEMBILANGBARU' '16293'.
NU 'ZZPENYEBUTASAL' '1000000'.
NU 'ZZPENYEBUTBARU' '100'.
NU 'ZZTHICKNESS' '11'.
NU 'ZZWIDTH' '920'.
DO 2 TIMES.
  REFRESH LT_R. CLEAR LV_E.
  CALL FUNCTION 'BAPI_OBJCL_CHANGE'
    EXPORTING OBJECTKEY = LV_K OBJECTTABLE = 'MCH1'
              CLASSNUM = 'ZZJRMETZ' CLASSTYPE = '023'
    IMPORTING CLASSIF_STATUS = LV_S
    TABLES ALLOCVALUESNUMNEW = LT_N
           ALLOCVALUESCHARNEW = LT_C
           ALLOCVALUESCURRNEW = LT_U RETURN = LT_R.
  LOOP AT LT_R WHERE TYPE CA 'EA'. LV_E = 'X'. ENDLOOP.
  WRITE: / 'percobaan', SY-INDEX, 'error', LV_E.
  IF LV_E IS INITIAL. EXIT. ENDIF.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
ENDDO.
LOOP AT LT_R.
  WRITE: / LT_R-TYPE, LT_R-ID, LT_R-NUMBER, LT_R-MESSAGE(60).
ENDLOOP.
IF P_COMMIT = 'X' AND LV_E IS INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT status', LV_S.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK (uji)', LV_S.
ENDIF.
