REPORT ZZST21LST.
* Daftar operasi dan karakteristik lot JR conv 040000021140
DATA: LT_OP TYPE TABLE OF BAPI2045L2 WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LT_CR TYPE TABLE OF BAPI2045L3 WITH HEADER LINE,
      LT_CO TYPE TABLE OF BAPI2045D1 WITH HEADER LINE,
      LS_RET TYPE BAPIRETURN1.
CALL FUNCTION 'BAPI_INSPLOT_GETOPERATIONS'
  EXPORTING NUMBER = '040000021140'
  IMPORTING RETURN = LS_RET
  TABLES INSPOPER_LIST = LT_OP.
LOOP AT LT_OP.
  WRITE: / 'OP', LT_OP-INSPLOT, LT_OP-INSPOPER.
ENDLOOP.
LOOP AT LT_OP.
  REFRESH: LT_CR, LT_CO.
  CALL FUNCTION 'BAPI_INSPOPER_GETCHAR'
    EXPORTING INSPLOT = LT_OP-INSPLOT INSPOPER = LT_OP-INSPOPER
    TABLES INSPCHAR_LIST = LT_CR.
  LOOP AT LT_CR.
    WRITE: / 'CH', LT_CR-INSPCHAR, LT_CR-CHAR_TYPE,
           LT_CR-CHAR_DESCR(24).
  ENDLOOP.
ENDLOOP.
