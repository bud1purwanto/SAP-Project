REPORT ZZST25CSR.
* Data uji TTA: ZZNOMORROLL dkk batch SR conv SREYAI (kelas ZZSRMETZ)
PARAMETERS: P_COMMIT TYPE C DEFAULT 'X'.
DATA: LT_N TYPE TABLE OF BAPI1003_ALLOC_VALUES_NUM WITH HEADER LINE,
      LT_C TYPE TABLE OF BAPI1003_ALLOC_VALUES_CHAR WITH HEADER LINE,
      LT_U TYPE TABLE OF BAPI1003_ALLOC_VALUES_CURR WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LV_K TYPE BAPI1003_KEY-OBJECT, LV_S TYPE CLSTATUS,
      LV_E TYPE C.
DEFINE CLS.
  REFRESH: LT_C, LT_N, LT_R. CLEAR LV_E.
  LV_K(18) = 'SREYAI'. LV_K+18(10) = &1.
  CLEAR LT_C. LT_C-CHARACT = 'ZZMONTHYEAR'.
  LT_C-VALUE_CHAR = '116'. LT_C-VALUE_NEUTRAL = '116'. APPEND LT_C.
  CLEAR LT_C. LT_C-CHARACT = 'ZZSEQUENCENBR'.
  LT_C-VALUE_CHAR = '901'. LT_C-VALUE_NEUTRAL = '901'. APPEND LT_C.
  CLEAR LT_C. LT_C-CHARACT = 'ZZNOMORROLL'.
  LT_C-VALUE_CHAR = &2. LT_C-VALUE_NEUTRAL = &2. APPEND LT_C.
  CLEAR LT_C. LT_C-CHARACT = 'ZZSCRAP'.
  LT_C-VALUE_CHAR = 'OK'. LT_C-VALUE_NEUTRAL = 'OK'. APPEND LT_C.
  DO 2 TIMES.
    REFRESH LT_R. CLEAR LV_E.
    CALL FUNCTION 'BAPI_OBJCL_CHANGE'
      EXPORTING OBJECTKEY = LV_K OBJECTTABLE = 'MCH1'
                CLASSNUM = 'ZZSRMETZ' CLASSTYPE = '023'
      IMPORTING CLASSIF_STATUS = LV_S
      TABLES ALLOCVALUESNUMNEW = LT_N
             ALLOCVALUESCHARNEW = LT_C
             ALLOCVALUESCURRNEW = LT_U RETURN = LT_R.
    LOOP AT LT_R WHERE TYPE CA 'EA'. LV_E = 'X'. ENDLOOP.
    IF LV_E IS INITIAL. EXIT. ENDIF.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  ENDDO.
  LOOP AT LT_R.
    WRITE: / &1, LT_R-TYPE, LT_R-NUMBER, LT_R-MESSAGE(50).
  ENDLOOP.
  IF P_COMMIT = 'X' AND LV_E IS INITIAL.
    CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
    WRITE: / &1, 'COMMIT'.
  ELSE.
    CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
    WRITE: / &1, 'ROLLBACK (uji)', LV_E.
  ENDIF.
END-OF-DEFINITION.
CLS '0000407419' 'H EYA 116 901 9C 01 01'.
CLS '0000407420' 'H EYA 116 901 9C 02 01'.
