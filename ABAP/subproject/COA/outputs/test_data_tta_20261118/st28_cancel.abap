REPORT ZZST28CAN.
* Data uji TTA: cancel GI 261 (BKTXT tidak sama dgn GR) 4900436247 + 260
PARAMETERS: P_COMMIT TYPE C DEFAULT ' ',
            P_DOC TYPE C LENGTH 10 DEFAULT '4900436260'.
DATA: LT_RET TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LS_R TYPE BAPI2017_GM_HEAD_RET,
      LV_E TYPE C.
DEFINE CAN.
  REFRESH LT_RET.
  CALL FUNCTION 'BAPI_GOODSMVT_CANCEL'
    EXPORTING MATERIALDOCUMENT = &1 MATDOCUMENTYEAR = '2026'
              GOODSMVT_PSTNG_DATE = SY-DATUM
    IMPORTING GOODSMVT_HEADRET = LS_R
    TABLES RETURN = LT_RET.
  LOOP AT LT_RET.
    WRITE: / &1, LT_RET-TYPE, LT_RET-NUMBER, LT_RET-MESSAGE(60).
    IF LT_RET-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
  ENDLOOP.
  WRITE: / &1, 'CANCELDOC', LS_R-MAT_DOC.
END-OF-DEFINITION.
CAN P_DOC.
IF P_COMMIT = 'X' AND LV_E IS INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT'.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK (uji)'.
ENDIF.
