REPORT ZZST22RES.
* Data uji TTA: hasil inspeksi lot JR conv 040000021140
PARAMETERS: P_COMMIT TYPE C DEFAULT ' '.
DATA: LT_CR TYPE TABLE OF BAPI2045D2 WITH HEADER LINE,
      LT_SM TYPE TABLE OF BAPI2045D3 WITH HEADER LINE,
      LT_RET TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LS_RET TYPE BAPIRET2,
      LV_E TYPE C.
DEFINE RES.
  CLEAR LT_CR.
  LT_CR-INSPLOT = '040000021140'. LT_CR-INSPOPER = '0010'.
  LT_CR-INSPCHAR = &1. LT_CR-CLOSED = ' '. APPEND LT_CR.
  CLEAR LT_SM.
  LT_SM-INSPLOT = '040000021140'. LT_SM-INSPOPER = '0010'.
  LT_SM-INSPCHAR = &1. LT_SM-INSPSAMPLE = '000000'.
  LT_SM-MEAN_VALUE = &2. LT_SM-ORIGINAL_INPUT = &2.
  LT_SM-VALID_VALS = 1. LT_SM-MINIMUM = &2. LT_SM-MAXIMUM = &2.
  LT_SM-CLOSED = 'X'. LT_SM-EVALUATION = 'A'.
  APPEND LT_SM.
END-OF-DEFINITION.
RES '0010' '42'.
RES '0030' '1.60'.
RES '0040' '0.35'.
RES '0050' '0.45'.
RES '0060' '0.30'.
RES '0070' '0.40'.
RES '0080' '0.32'.
RES '0090' '0.38'.
RES '0100' '2.50'.
CALL FUNCTION 'BAPI_INSPOPER_RECORDRESULTS'
  EXPORTING INSPLOT = '040000021140' INSPOPER = '0010'
  IMPORTING RETURN = LS_RET
  TABLES CHAR_RESULTS = LT_CR SAMPLE_RESULTS = LT_SM
         RETURNTABLE = LT_RET.
WRITE: / 'RET', LS_RET-TYPE, LS_RET-ID, LS_RET-NUMBER,
       LS_RET-MESSAGE(50).
LOOP AT LT_RET.
  WRITE: / LT_RET-TYPE, LT_RET-NUMBER, LT_RET-MESSAGE(60).
  WRITE: / '  ', LT_RET-MESSAGE_V1, LT_RET-MESSAGE_V2,
         LT_RET-MESSAGE_V3.
  IF LT_RET-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
IF P_COMMIT = 'X' AND LV_E IS INITIAL AND LS_RET-TYPE NA 'EA'.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT'.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK (uji)'.
ENDIF.
