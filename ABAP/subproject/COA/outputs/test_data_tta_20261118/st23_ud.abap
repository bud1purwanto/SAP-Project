REPORT ZZST23UD.
* Data uji TTA: usage decision lot JR conv 040000021140 (P1)
PARAMETERS: P_COMMIT TYPE C DEFAULT 'X'.
DATA: LS_UD TYPE BAPI2045UD,
      LS_RET TYPE BAPIRETURN1,
      LS_STK TYPE BAPI2045D_IL2,
      LS_UR TYPE BAPI2045UD_RETURN,
      LT_SS TYPE TABLE OF BAPI2045SS WITH HEADER LINE,
      LT_US TYPE TABLE OF BAPI2045US WITH HEADER LINE.
LS_UD-INSPLOT = '040000021140'.
LS_UD-UD_SELECTED_SET = '0-UD-PRD'.
LS_UD-UD_PLANT = '2000'.
LS_UD-UD_CODE_GROUP = '0-UD-PRD'.
LS_UD-UD_CODE = 'P1'.
LS_UD-UD_FORCE_COMPLETION = 'X'.
CALL FUNCTION 'BAPI_INSPLOT_SETUSAGEDECISION'
  EXPORTING NUMBER = '040000021140' UD_DATA = LS_UD
  IMPORTING RETURN = LS_RET STOCK_DATA = LS_STK
            UD_RETURN_DATA = LS_UR
  TABLES SYSTEM_STATUS = LT_SS USER_STATUS = LT_US.
WRITE: / 'RET', LS_RET-TYPE, LS_RET-ID, LS_RET-NUMBER,
       LS_RET-MESSAGE(60).
WRITE: / 'UDRET done'.
IF P_COMMIT = 'X' AND LS_RET-TYPE NA 'EA'.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT'.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK (uji)'.
ENDIF.
