REPORT ZZST24GRS.
* Data uji TTA: GR 101 batch SR conv ke order sumber A29000009001
PARAMETERS: P_COMMIT TYPE C DEFAULT 'X'.
DATA: LS_H TYPE BAPI2017_GM_HEAD_01,
      LS_C TYPE BAPI2017_GM_CODE,
      LS_R TYPE BAPI2017_GM_HEAD_RET,
      LT_I TYPE TABLE OF BAPI2017_GM_ITEM_CREATE WITH HEADER LINE,
      LT_RET TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LV_E TYPE C.
LS_H-PSTNG_DATE = SY-DATUM. LS_H-DOC_DATE = SY-DATUM.
LS_H-HEADER_TXT = 'UJI TTA GR SR CONV'.
LS_C-GM_CODE = '02'.
DEFINE ITM.
  CLEAR LT_I.
  LT_I-MATERIAL = 'SREYAI'. LT_I-PLANT = '2000'.
  LT_I-STGE_LOC = '2310'. LT_I-BATCH = &1.
  LT_I-MOVE_TYPE = '101'. LT_I-MVT_IND = 'F'.
  LT_I-ENTRY_QNT = '1.200'. LT_I-ENTRY_UOM = 'KG'.
  LT_I-ORDERID = 'A29000009001'.
  APPEND LT_I.
END-OF-DEFINITION.
ITM '0000407419'.
ITM '0000407420'.
CALL FUNCTION 'BAPI_GOODSMVT_CREATE'
  EXPORTING GOODSMVT_HEADER = LS_H GOODSMVT_CODE = LS_C
  IMPORTING GOODSMVT_HEADRET = LS_R
  TABLES GOODSMVT_ITEM = LT_I RETURN = LT_RET.
LOOP AT LT_RET.
  WRITE: / LT_RET-TYPE, LT_RET-ID, LT_RET-NUMBER, LT_RET-MESSAGE(80).
  IF LT_RET-TYPE CA 'EA'. LV_E = 'X'. ENDIF.
ENDLOOP.
WRITE: / 'MATDOC', LS_R-MAT_DOC, LS_R-DOC_YEAR.
IF P_COMMIT = 'X' AND LV_E IS INITIAL AND LS_R-MAT_DOC IS NOT INITIAL.
  CALL FUNCTION 'BAPI_TRANSACTION_COMMIT' EXPORTING WAIT = 'X'.
  WRITE: / 'COMMIT'.
ELSE.
  CALL FUNCTION 'BAPI_TRANSACTION_ROLLBACK'.
  WRITE: / 'ROLLBACK (uji)'.
ENDIF.
