REPORT ZZCHKVER.
* Read-only: verifikasi data uji DO 6280/6281 (alias + mapping)
TYPES: BEGIN OF TY_M, MIC TYPE ZMAP_COA-MIC, KUNNR TYPE KUNNR,
         METHOD TYPE ZMAP_COA-METHOD, LO TYPE ZMAP_COA-LOWER_LIMIT,
         HI TYPE ZMAP_COA-UPPER_LIMIT, SEQ TYPE ZMAP_COA-SEQ_NO,
       END OF TY_M.
DATA: LT_G TYPE TABLE OF TY_M WITH HEADER LINE,
      LT_K TYPE TABLE OF TY_M WITH HEADER LINE,
      LT_L TYPE TABLE OF LIPS WITH HEADER LINE,
      LT_N TYPE TABLE OF BAPI1003_ALLOC_VALUES_NUM WITH HEADER LINE,
      LT_C TYPE TABLE OF BAPI1003_ALLOC_VALUES_CHAR WITH HEADER LINE,
      LT_U TYPE TABLE OF BAPI1003_ALLOC_VALUES_CURR WITH HEADER LINE,
      LT_R TYPE TABLE OF BAPIRET2 WITH HEADER LINE,
      LV_K TYPE BAPI1003_KEY-OBJECT, LV_KUN TYPE KUNNR,
      LV_ATWRT TYPE CAWN-ATWRT, LV_AMAT TYPE MATNR.
DEFINE VDO.
  SELECT SINGLE KUNAG INTO LV_KUN FROM LIKP WHERE VBELN = &1.
  WRITE: / '== DO', &1, 'KUNAG', LV_KUN.
  SELECT * INTO TABLE LT_L FROM LIPS WHERE VBELN = &1
    AND CHARG <> ' '.
  LOOP AT LT_L.
    CLEAR LV_K. REFRESH: LT_N, LT_C, LT_U, LT_R.
    LV_K(18) = LT_L-MATNR. LV_K+18(10) = LT_L-CHARG.
    CALL FUNCTION 'BAPI_OBJCL_GETDETAIL'
      EXPORTING OBJECTKEY = LV_K OBJECTTABLE = 'MCH1'
                CLASSNUM = 'ZZSRBOPP' CLASSTYPE = '023'
      TABLES ALLOCVALUESNUM = LT_N ALLOCVALUESCHAR = LT_C
             ALLOCVALUESCURR = LT_U RETURN = LT_R.
    CLEAR: LT_C, LV_ATWRT, LV_AMAT.
    READ TABLE LT_C WITH KEY CHARACT = 'ZZALIAS'.
    IF LT_C-VALUE_CHAR IS NOT INITIAL.
      SELECT SINGLE A~ATWRT INTO LV_ATWRT FROM CAWN AS A
        INNER JOIN CAWNT AS T ON T~ATINN = A~ATINN
        AND T~ATZHL = A~ATZHL
        WHERE A~ATINN = '0000000811' AND T~ATWTB = LT_C-VALUE_CHAR.
      IF SY-SUBRC = 0.
        CONCATENATE LT_L-MATNR(2) LV_ATWRT
          LT_L-MATNR+5(1) INTO LV_AMAT.
      ENDIF.
    ENDIF.
    WRITE: / LT_L-POSNR, LT_L-MATNR(8), LT_L-CHARG,
             'ALIAS', LT_C-VALUE_CHAR(10), 'AMAT', LV_AMAT.
  ENDLOOP.
  REFRESH: LT_G, LT_K.
  SELECT MIC KUNNR METHOD LOWER_LIMIT UPPER_LIMIT SEQ_NO
    INTO TABLE LT_G FROM ZMAP_COA
    WHERE MATNR = 'SRAACI' AND KUNNR = ' ' AND DELETION NE 'X'.
  SELECT MIC KUNNR METHOD LOWER_LIMIT UPPER_LIMIT SEQ_NO
    INTO TABLE LT_K FROM ZMAP_COA
    WHERE MATNR = 'SRAACI' AND KUNNR = LV_KUN AND DELETION NE 'X'.
  SORT LT_G BY MIC.
  LOOP AT LT_K.
    READ TABLE LT_G WITH KEY MIC = LT_K-MIC BINARY SEARCH.
    IF SY-SUBRC = 0.
      LT_G-METHOD = LT_K-METHOD. LT_G-KUNNR = LT_K-KUNNR.
      IF LT_K-LO IS NOT INITIAL. LT_G-LO = LT_K-LO. ENDIF.
      IF LT_K-HI IS NOT INITIAL. LT_G-HI = LT_K-HI. ENDIF.
      MODIFY LT_G INDEX SY-TABIX.
    ELSE. APPEND LT_K TO LT_G. ENDIF.
  ENDLOOP.
  SORT LT_G BY SEQ.
  LOOP AT LT_G.
    WRITE: / 'MAP', LT_G-SEQ, LT_G-MIC, LT_G-KUNNR,
             LT_G-METHOD(18), LT_G-LO(8), LT_G-HI(8).
  ENDLOOP.
END-OF-DEFINITION.
VDO '0085006280'.
VDO '0085006281'.
