REPORT ZZST5LIM.
* Tahap 5 data uji alias: limit di mapping umum SRAACI (KUNNR kosong)
DATA: LV_N TYPE I.
DEFINE LIM.
  UPDATE ZMAP_COA SET LOWER_LIMIT = &2 UPPER_LIMIT = &3
         AENAM = SY-UNAME AEDAT = SY-DATUM
   WHERE MATNR = 'SRAACI' AND KUNNR = ' ' AND MIC = &1
     AND LOWER_LIMIT = ' ' AND UPPER_LIMIT = ' '.
  WRITE: / &1, &2, &3, SY-SUBRC, SY-DBCNT.
END-OF-DEFINITION.
LIM 'PAACTSTD' '25.00' '35.00'.
LIM 'PAACELMD' '140.00' '230.00'.
LIM 'PAACSHTD' ' ' '2.00'.
LIM 'PAACG400' '92.00' ' '.
COMMIT WORK.
WRITE: / 'DONE'.
