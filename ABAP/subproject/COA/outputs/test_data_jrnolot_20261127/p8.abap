REPORT ZTMP.
DATA: BEGIN OF LT OCCURS 0, P TYPE QAMV-PRUEFLOS, M TYPE QAMV-MERKNR,
      V TYPE QAMV-VERWMERKM, END OF LT.
DATA: LV_MW TYPE QAMR-MITTELWERT, LV_AZ TYPE QAMR-ANZWERTG,
      LV_S TYPE QALS-STAT35, LV_F TYPE F.
SELECT PRUEFLOS MERKNR VERWMERKM INTO TABLE LT FROM QAMV
  WHERE PRUEFLOS IN ('040000009460','040000009481').
LOOP AT LT.
  CLEAR: LV_MW, LV_AZ.
  SELECT SINGLE MITTELWERT ANZWERTG INTO (LV_MW, LV_AZ) FROM QAMR
    WHERE PRUEFLOS = LT-P AND MERKNR = LT-M.
  LV_F = LV_MW.
  WRITE: / LT-P, LT-M, LT-V, LV_AZ, LV_F.
ENDLOOP.
