REPORT ZTMP.
DATA: LV_ATR TYPE AUSP-ATINN, LV_CU TYPE MCH1-CUOBJ_BM.
DATA: BEGIN OF LT OCCURS 0, OBJEK TYPE AUSP-OBJEK,
      ATWRT TYPE AUSP-ATWRT, END OF LT.
DATA: BEGIN OF LM OCCURS 0, CHARG TYPE MCH1-CHARG,
      ERSDA TYPE MCH1-ERSDA, END OF LM.
SELECT SINGLE ATINN INTO LV_ATR FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
SELECT OBJEK ATWRT INTO TABLE LT FROM AUSP WHERE ATINN = LV_ATR
  AND KLART = '023' AND MAFID = 'O' AND ( ATWRT LIKE '4 AAB 076 ___'
  OR ATWRT LIKE '4 AAB 086 00_' ).
SORT LT BY ATWRT DESCENDING.
LOOP AT LT.
  LV_CU = LT-OBJEK.
  SELECT CHARG ERSDA INTO TABLE LM FROM MCH1 WHERE CUOBJ_BM = LV_CU.
  LOOP AT LM WHERE ERSDA >= '20250101'.
    WRITE: / LT-ATWRT(16), LM-CHARG, LM-ERSDA.
  ENDLOOP.
ENDLOOP.
