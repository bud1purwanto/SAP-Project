REPORT ZTMP.
DATA: LV_M TYPE MCH1-MATNR, LV_C TYPE I.
DATA: BEGIN OF LT OCCURS 0, MATNR TYPE MCH1-MATNR, N TYPE I,
      END OF LT.
SELECT SINGLE MATNR INTO LV_M FROM MCH1 WHERE CHARG = '0000405990'.
WRITE: / 'JR 405990 mat', LV_M.
SELECT MATNR COUNT(*) INTO TABLE LT FROM MCH1
  WHERE MATNR LIKE 'JR%' GROUP BY MATNR.
SORT LT BY N DESCENDING.
LOOP AT LT TO 15. WRITE: / LT-MATNR, LT-N. ENDLOOP.
