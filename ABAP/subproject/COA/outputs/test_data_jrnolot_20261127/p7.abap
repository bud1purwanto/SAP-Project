REPORT ZTMP.
DATA: BEGIN OF LT OCCURS 0, VBELN TYPE LIPS-VBELN, POSNR TYPE
      LIPS-POSNR, MATNR TYPE LIPS-MATNR, CHARG TYPE LIPS-CHARG,
      PSTYV TYPE LIPS-PSTYV, LFIMG TYPE LIPS-LFIMG, END OF LT.
DATA: LV_K TYPE LIKP-KUNNR, LV_D TYPE LIKP-WADAT_IST, LV_N TYPE I,
      LV_T TYPE LIKP-LFART.
SELECT VBELN POSNR MATNR CHARG PSTYV LFIMG INTO TABLE LT FROM LIPS
  WHERE CHARG IN ('0000353052','0000353060','0000353067',
  '0000352989','0000352990','0000352994').
SORT LT BY VBELN POSNR.
LOOP AT LT.
  SELECT SINGLE KUNNR WADAT_IST LFART INTO (LV_K, LV_D, LV_T)
    FROM LIKP WHERE VBELN = LT-VBELN.
  WRITE: / LT-VBELN, LT-POSNR, LT-MATNR(8), LT-CHARG, LT-PSTYV,
    LT-LFIMG, LV_K, LV_D, LV_T.
ENDLOOP.
