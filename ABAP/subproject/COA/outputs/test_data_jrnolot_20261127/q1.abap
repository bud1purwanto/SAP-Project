REPORT ZTMP.
DATA: LV_ATR TYPE AUSP-ATINN, LV_CU TYPE MCH1-CUOBJ_BM,
      LV_O TYPE AUSP-OBJEK.
DATA: BEGIN OF LT OCCURS 0, OBJEK TYPE AUSP-OBJEK,
      ATWRT TYPE AUSP-ATWRT, END OF LT.
DATA: BEGIN OF LM OCCURS 0, CHARG TYPE MCH1-CHARG,
      MATNR TYPE MCH1-MATNR, ERSDA TYPE MCH1-ERSDA,
      HSDAT TYPE MCH1-HSDAT, LWEDT TYPE MCH1-LWEDT,
      ERNAM TYPE MCH1-ERNAM, END OF LM.
DATA: BEGIN OF LQ OCCURS 0, P TYPE QALS-PRUEFLOS, ART TYPE QALS-ART,
      D TYPE QALS-ENSTEHDAT, END OF LQ.
DATA: BEGIN OF LC OCCURS 0, ATNAM TYPE CABN-ATNAM,
      ATWRT TYPE AUSP-ATWRT, ATFLV TYPE AUSP-ATFLV, END OF LC.
DATA: LV_N TYPE I.
SELECT SINGLE ATINN INTO LV_ATR FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
SELECT OBJEK ATWRT INTO TABLE LT FROM AUSP WHERE ATINN = LV_ATR
  AND KLART = '023' AND ( ATWRT = '4 AAB 086 003'
  OR ATWRT LIKE '4 AAB 076 0__' ).
SORT LT BY ATWRT.
LOOP AT LT.
  LV_CU = LT-OBJEK. REFRESH LM.
  SELECT CHARG MATNR ERSDA HSDAT LWEDT ERNAM INTO TABLE LM FROM MCH1
    WHERE CUOBJ_BM = LV_CU.
  LOOP AT LM.
    REFRESH LQ.
    SELECT PRUEFLOS ART ENSTEHDAT INTO TABLE LQ FROM QALS
      WHERE CHARG = LM-CHARG AND ( ART = 'Z02' OR ART = 'Z03' ).
    WRITE: / LT-ATWRT(14), LM-CHARG, LM-ERSDA, LM-HSDAT, LM-LWEDT,
      LM-ERNAM(12).
    LOOP AT LQ.
      SELECT COUNT(*) INTO LV_N FROM QAMR WHERE PRUEFLOS = LQ-P
        AND ANZWERTG > 0.
      WRITE: / '   lot', LQ-P, LQ-ART, LQ-D, 'res', LV_N.
    ENDLOOP.
  ENDLOOP.
ENDLOOP.
