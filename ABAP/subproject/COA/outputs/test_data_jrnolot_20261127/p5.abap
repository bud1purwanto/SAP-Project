REPORT ZTMP.
DATA: LV_ATR TYPE AUSP-ATINN, LV_J TYPE CHARG_D, LV_N TYPE I,
      LV_A TYPE I, LV_PAT TYPE AUSP-ATWRT.
DATA: BEGIN OF LT OCCURS 0, OBJEK TYPE AUSP-OBJEK,
      ATWRT TYPE AUSP-ATWRT, END OF LT.
DATA: BEGIN OF LM OCCURS 0, CHARG TYPE MCH1-CHARG,
      MATNR TYPE MCH1-MATNR, ERSDA TYPE MCH1-ERSDA, END OF LM.
DATA: BEGIN OF LQ OCCURS 0, P TYPE QALS-PRUEFLOS, ART TYPE QALS-ART,
      END OF LQ.
DATA: LV_CU TYPE MCH1-CUOBJ_BM.
DEFINE J.
  CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
    EXPORTING CHARG_S = &1 IMPORTING CHARG_J = LV_J.
  WRITE: / 'SR', &1, '-> JR', LV_J.
END-OF-DEFINITION.
DEFINE P.
  LV_PAT = &1.
  REFRESH LT.
  SELECT OBJEK ATWRT INTO TABLE LT FROM AUSP WHERE ATINN = LV_ATR
    AND KLART = '023' AND ATWRT LIKE LV_PAT.
  SORT LT BY ATWRT.
  LOOP AT LT.
    LV_CU = LT-OBJEK. REFRESH LM.
    SELECT CHARG MATNR ERSDA INTO TABLE LM FROM MCH1
      WHERE CUOBJ_BM = LV_CU.
    LOOP AT LM.
      REFRESH LQ.
      SELECT PRUEFLOS ART INTO TABLE LQ FROM QALS
        WHERE CHARG = LM-CHARG AND ( ART = 'Z02' OR ART = 'Z03' ).
      CLEAR LV_A.
      LOOP AT LQ.
        SELECT COUNT(*) INTO LV_N FROM QAMR WHERE PRUEFLOS = LQ-P
          AND ANZWERTG > 0.
        LV_A = LV_A + LV_N.
      ENDLOOP.
      DESCRIBE TABLE LQ LINES LV_N.
      WRITE: / LT-ATWRT(20), LM-CHARG, LM-MATNR, LM-ERSDA,
        'lots', LV_N, 'res', LV_A.
    ENDLOOP.
  ENDLOOP.
END-OF-DEFINITION.
SELECT SINGLE ATINN INTO LV_ATR FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
J '0000354110'. J '0000358649'. J '0000358654'.
P 'J EYA 086 %'. P 'J EYA 076 %'. P 'Q EYA 027 %'. P 'Q EYA 017 %'.
