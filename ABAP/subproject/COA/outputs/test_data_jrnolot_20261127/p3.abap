REPORT ZTMP.
DATA: LT_SR TYPE TABLE OF ZQM_GET_BATCH_SR WITH HEADER LINE.
DATA: LV_STK TYPE MCHB-CLABS, LV_N TYPE I, LV_M TYPE MCH1-MATNR.
DEFINE CHK.
  REFRESH LT_SR.
  CALL FUNCTION 'ZQM_GET_BATCH_SR_BY_JR'
    EXPORTING CHARGJR = &1 TABLES T_SR = LT_SR.
  WRITE: / 'JR', &1.
  LOOP AT LT_SR.
    CLEAR: LV_STK, LV_N, LV_M.
    SELECT SINGLE MATNR INTO LV_M FROM MCH1 WHERE CHARG = LT_SR-CHARG.
    SELECT SUM( CLABS ) INTO LV_STK FROM MCHB
      WHERE CHARG = LT_SR-CHARG AND WERKS = '2000'.
    SELECT COUNT(*) INTO LV_N FROM LIPS WHERE CHARG = LT_SR-CHARG.
    WRITE: / '  SR', LT_SR-CHARG, LV_M, LV_STK, 'LIPS', LV_N.
  ENDLOOP.
END-OF-DEFINITION.
CHK '0000352844'. CHK '0000353949'. CHK '0000353010'.
CHK '0000353073'. CHK '0000354163'. CHK '0000358648'.
CHK '0000358677'. CHK '0000358680'. CHK '0000352995'.
CHK '0000358974'.
