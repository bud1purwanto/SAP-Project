REPORT ZTMP.
DATA: LV_J TYPE CHARG_D, LV_L TYPE MCH1-LICHA, LV_E TYPE MCH1-ERSDA,
      LV_Z TYPE QALS-PRUEFLOS.
DATA: BEGIN OF LT OCCURS 0, MBLNR TYPE MSEG-MBLNR, BWART TYPE
      MSEG-BWART, CHARG TYPE MSEG-CHARG, AUFNR TYPE MSEG-AUFNR,
      MATNR TYPE MSEG-MATNR, END OF LT.
DATA: LT_C TYPE TABLE OF CHARG_D WITH HEADER LINE.
APPEND '0000406016' TO LT_C. APPEND '0000406019' TO LT_C.
APPEND '0000406020' TO LT_C. APPEND '0000406028' TO LT_C.
APPEND '0000358959' TO LT_C. APPEND '0000354052' TO LT_C.
LOOP AT LT_C.
  CLEAR: LV_J, LV_L, LV_Z.
  CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
    EXPORTING CHARG_S = LT_C IMPORTING CHARG_J = LV_J.
  SELECT SINGLE LICHA ERSDA INTO (LV_L, LV_E) FROM MCH1
    WHERE CHARG = LT_C.
  SELECT SINGLE PRUEFLOS INTO LV_Z FROM QALS WHERE CHARG = LT_C
    AND ART = 'Z04'.
  WRITE: / 'SR', LT_C, LV_E, 'LICHA', LV_L, 'JR(FM)', LV_J, 'Z04',
    LV_Z.
  REFRESH LT.
  SELECT MBLNR BWART CHARG AUFNR MATNR INTO TABLE LT FROM MSEG
    WHERE CHARG = LT_C.
  LOOP AT LT.
    WRITE: / '   ', LT-MBLNR, LT-BWART, LT-AUFNR, LT-MATNR.
  ENDLOOP.
ENDLOOP.
