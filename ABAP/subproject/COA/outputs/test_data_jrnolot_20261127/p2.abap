REPORT ZTMP.
* Cari JR (JRAABI/JRAAAI/JREYAI) tanpa lot Z02/Z03, punya SR stok
DATA: LV_ATR TYPE AUSP-ATINN, LV_OBJ TYPE AUSP-OBJEK,
      LV_ROLL TYPE AUSP-ATWRT, LV_N TYPE I, LV_SR TYPE I,
      LV_STK TYPE MCHB-CLABS, LV_CNT TYPE I.
DATA: BEGIN OF LT OCCURS 0, MATNR TYPE MCH1-MATNR,
      CHARG TYPE MCH1-CHARG, CUOBJ TYPE MCH1-CUOBJ_BM,
      ERSDA TYPE MCH1-ERSDA, END OF LT.
SELECT SINGLE ATINN INTO LV_ATR FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
SELECT MATNR CHARG CUOBJ_BM ERSDA INTO TABLE LT FROM MCH1
  WHERE MATNR IN ('JRAABI','JRAAAI','JREYAI','JRCADI','JREWAI').
LOOP AT LT.
  SELECT COUNT(*) INTO LV_N FROM QALS WHERE CHARG = LT-CHARG
    AND ( ART = 'Z02' OR ART = 'Z03' ).
  CHECK LV_N = 0.
  CLEAR LV_ROLL. LV_OBJ = LT-CUOBJ.
  SELECT SINGLE ATWRT INTO LV_ROLL FROM AUSP WHERE OBJEK = LV_OBJ
    AND ATINN = LV_ATR AND KLART = '023'.
  CHECK LV_ROLL IS NOT INITIAL.
  LV_CNT = LV_CNT + 1.
  WRITE: / LT-MATNR, LT-CHARG, LT-ERSDA, LV_ROLL(20).
ENDLOOP.
WRITE: / 'total', LV_CNT.
