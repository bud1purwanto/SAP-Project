REPORT ZTMP.
DATA: BEGIN OF LA OCCURS 0, AUFNR TYPE AFPO-AUFNR,
      U TYPE AFPO-MILL_OC_AUFNR_U, END OF LA.
DATA: BEGIN OF LT OCCURS 0, MBLNR TYPE AUFM-MBLNR, ZEILE TYPE
      AUFM-ZEILE, BWART TYPE AUFM-BWART, CHARG TYPE AUFM-CHARG,
      MATNR TYPE AUFM-MATNR, MENGE TYPE AUFM-MENGE, END OF LT.
DATA: LV_R TYPE AUSP-ATWRT, LV_CU TYPE MCH1-CUOBJ_BM,
      LV_O TYPE AUSP-OBJEK, LV_ATR TYPE AUSP-ATINN,
      LV_E TYPE MCH1-ERSDA, LV_L TYPE QALS-PRUEFLOS.
SELECT SINGLE ATINN INTO LV_ATR FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
SELECT AUFNR MILL_OC_AUFNR_U INTO TABLE LA FROM AFPO
  WHERE MILL_OC_AUFNR_U IN ('P29000003258','P29000003259',
  'P29000003260','P29000003261','P29000003264').
SORT LA.
LOOP AT LA.
  WRITE: / 'P29', LA-U, '-> ZCA', LA-AUFNR.
  REFRESH LT.
  SELECT MBLNR ZEILE BWART CHARG MATNR MENGE INTO TABLE LT FROM AUFM
    WHERE AUFNR = LA-AUFNR AND ( BWART = '261' OR BWART = '262' ).
  LOOP AT LT.
    CLEAR: LV_R, LV_E, LV_L.
    SELECT SINGLE CUOBJ_BM ERSDA INTO (LV_CU, LV_E) FROM MCH1
      WHERE CHARG = LT-CHARG.
    LV_O = LV_CU.
    SELECT SINGLE ATWRT INTO LV_R FROM AUSP WHERE OBJEK = LV_O
      AND ATINN = LV_ATR AND KLART = '023'.
    SELECT SINGLE PRUEFLOS INTO LV_L FROM QALS WHERE CHARG = LT-CHARG
      AND ART = 'Z02'.
    WRITE: / '  ', LT-MBLNR, LT-ZEILE, LT-BWART, LT-CHARG,
      LT-MATNR(8), LT-MENGE, LV_E, LV_R(16), LV_L.
  ENDLOOP.
ENDLOOP.
