REPORT ZTMP.
DATA: LV_INC TYPE TFDIR-PNAME, LV_N TYPE TFDIR-INCLUDE,
      LV_P TYPE PROGNAME.
DATA: LT TYPE TABLE OF ABAPTXT255 WITH HEADER LINE.
SELECT SINGLE PNAME INCLUDE INTO (LV_INC, LV_N) FROM TFDIR
  WHERE FUNCNAME = 'ZQM_GET_BATCH_JR_BY_SR'.
CONCATENATE LV_INC+3 'U' LV_N INTO LV_P.
WRITE: / LV_P.
READ REPORT LV_P INTO LT.
LOOP AT LT. WRITE: / LT-LINE(200). ENDLOOP.
