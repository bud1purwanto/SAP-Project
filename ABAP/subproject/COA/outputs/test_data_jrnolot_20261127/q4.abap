REPORT ZTMP.
DATA: BEGIN OF LT OCCURS 0, MBLNR TYPE MSEG-MBLNR, BWART TYPE
      MSEG-BWART, CHARG TYPE MSEG-CHARG, MATNR TYPE MSEG-MATNR,
      AUFNR TYPE MSEG-AUFNR, MENGE TYPE MSEG-MENGE, END OF LT.
DATA: LT_A TYPE TABLE OF AUFK-AUFNR WITH HEADER LINE.
DATA: LV_R TYPE AUSP-ATWRT, LV_CU TYPE MCH1-CUOBJ_BM,
      LV_O TYPE AUSP-OBJEK, LV_ATR TYPE AUSP-ATINN,
      LV_E TYPE MCH1-ERSDA.
SELECT SINGLE ATINN INTO LV_ATR FROM CABN WHERE ATNAM = 'ZZNOMORROLL'.
APPEND 'P29000003258' TO LT_A. APPEND 'P29000003259' TO LT_A.
APPEND 'P29000003260' TO LT_A. APPEND 'P29000003261' TO LT_A.
APPEND 'P29000003264' TO LT_A.
LOOP AT LT_A.
  WRITE: / 'ORDER', LT_A.
  REFRESH LT.
  SELECT MBLNR BWART CHARG MATNR AUFNR MENGE INTO TABLE LT FROM MSEG
    WHERE AUFNR = LT_A.
  LOOP AT LT.
    CLEAR: LV_R, LV_E.
    SELECT SINGLE CUOBJ_BM ERSDA INTO (LV_CU, LV_E) FROM MCH1
      WHERE CHARG = LT-CHARG.
    LV_O = LV_CU.
    SELECT SINGLE ATWRT INTO LV_R FROM AUSP WHERE OBJEK = LV_O
      AND ATINN = LV_ATR AND KLART = '023'.
    WRITE: / '  ', LT-MBLNR, LT-BWART, LT-CHARG, LT-MATNR(8),
      LT-MENGE, LV_E, LV_R(22).
  ENDLOOP.
ENDLOOP.
