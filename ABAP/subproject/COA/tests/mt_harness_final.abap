REPORT ZTMP_MT_FINAL.
* Read-only: GET_DATA of ZQMI_COA, dump final IT_DATA per DO
PARAMETERS: PV TYPE LIPS-VBELN DEFAULT '0085006278'.
FIELD-SYMBOLS: <R> TYPE STANDARD TABLE, <F> TYPE ANY,
               <T> TYPE STANDARD TABLE, <W> TYPE ANY, <V> TYPE ANY.
DATA: LV_S TYPE STRING, LV_N TYPE STRING.
DATA: BEGIN OF LS_R, SIGN(1), OPTION(2), LOW TYPE LIPS-VBELN,
      HIGH TYPE LIPS-VBELN, END OF LS_R.
DEFINE ATN.
  ASSIGN ('(ZQMI_COA)&1') TO <F>.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = &2 IMPORTING OUTPUT = <F>.
END-OF-DEFINITION.
DEFINE CMP.
  ASSIGN COMPONENT &1 OF STRUCTURE <W> TO <V>.
  LV_N = <V>. CONDENSE LV_N.
  CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
END-OF-DEFINITION.
START-OF-SELECTION.
  PERFORM DUMMY_LOAD IN PROGRAM ZQMI_COA IF FOUND.
  ATN ATINN_ROLL 'ZZNOMORROLL'.
  ATN ATINN_CODE 'ZZCODE'.
  ATN ATINN_WIDTH 'ZZWIDTH'.
  ATN ATINN_LENGTH 'ZZLENGTH'.
  ASSIGN ('(ZQMI_COA)P_VBELN[]') TO <R>.
  LS_R-SIGN = 'I'. LS_R-OPTION = 'EQ'. LS_R-LOW = PV.
  APPEND LS_R TO <R>.
  PERFORM GET_DATA IN PROGRAM ZQMI_COA.
  ASSIGN ('(ZQMI_COA)IT_DATA[]') TO <T>.
  LOOP AT <T> ASSIGNING <W>.
    CLEAR LV_S.
    CMP 'VBELN'. CMP 'MATNR'. CMP 'CHK'. CMP 'NUM'. CMP 'MIC'.
    CMP 'CMICMIT'. CMP 'INSLOT'.
    WRITE: / LV_S.
  ENDLOOP.
