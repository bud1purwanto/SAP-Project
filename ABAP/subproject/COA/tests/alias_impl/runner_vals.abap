FORM ZZ_MT_RUN USING PV TYPE LIPS-VBELN.
  DATA: LV_S TYPE STRING, LV_N TYPE STRING.
  FIELD-SYMBOLS: <V> TYPE ANY.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZNOMORROLL' IMPORTING OUTPUT = ATINN_ROLL.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZCODE' IMPORTING OUTPUT = ATINN_CODE.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZWIDTH' IMPORTING OUTPUT = ATINN_WIDTH.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZLENGTH' IMPORTING OUTPUT = ATINN_LENGTH.
  P_VBELN-SIGN = 'I'. P_VBELN-OPTION = 'EQ'. P_VBELN-LOW = PV.
  APPEND P_VBELN.
  PERFORM GET_DATA.
  LOOP AT IT_MIC1 WHERE MIC = 'PGLBOD00' OR MIC = 'SGLASTCD'
                    OR MIC = 'SACBSIIN' OR MIC = 'SGLASTMZ'.
    CLEAR LV_S.
    DO 5 TIMES.
      CASE SY-INDEX.
        WHEN 1. ASSIGN IT_MIC1-CHARG TO <V>.
        WHEN 2. ASSIGN IT_MIC1-MIC TO <V>.
        WHEN 3. ASSIGN IT_MIC1-MICMIT TO <V>.
        WHEN 4. ASSIGN IT_MIC1-CMICMIT TO <V>.
        WHEN 5. ASSIGN IT_MIC1-INSLOT TO <V>.
      ENDCASE.
      LV_N = <V>. CONDENSE LV_N.
      CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
    ENDDO.
    CONCATENATE '#V' LV_S INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
ENDFORM.
