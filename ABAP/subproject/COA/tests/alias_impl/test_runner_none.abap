FORM ZZ_MT_RUN USING PV TYPE LIPS-VBELN.
  DATA: LV_S TYPE STRING, LV_N TYPE STRING.
  FIELD-SYMBOLS: <V> TYPE ANY.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZNOMORROLL' IMPORTING OUTPUT = ATINN_ROLL.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZCODE' IMPORTING OUTPUT = ATINN_CODE.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZWIDTH' IMPORTING OUTPUT = ATINN_WIDTH.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZLENGTH' IMPORTING OUTPUT = ATINN_LENGTH.
  GV_ZZ_FORCE = 'HSS-18'.
  REFRESH GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJTH00'. GT_ZZTMAP-SEQ_NO = '001'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJTSMD'. GT_ZZTMAP-SEQ_NO = '002'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJTSTD'. GT_ZZTMAP-SEQ_NO = '003'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJELMD'. GT_ZZTMAP-SEQ_NO = '004'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJELTD'. GT_ZZTMAP-SEQ_NO = '005'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSHMD'. GT_ZZTMAP-SEQ_NO = '006'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSHTD'. GT_ZZTMAP-SEQ_NO = '007'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJHZ00'. GT_ZZTMAP-SEQ_NO = '008'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJG400'. GT_ZZTMAP-SEQ_NO = '009'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSIIN'. GT_ZZTMAP-SEQ_NO = '010'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSIOT'. GT_ZZTMAP-SEQ_NO = '011'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJSSIN'. GT_ZZTMAP-SEQ_NO = '012'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJSSOT'. GT_ZZTMAP-SEQ_NO = '013'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACBFDIN'. GT_ZZTMAP-SEQ_NO = '014'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'. APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP. GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJXX99'. GT_ZZTMAP-SEQ_NO = '015'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'. APPEND GT_ZZTMAP.
  P_VBELN-SIGN = 'I'. P_VBELN-OPTION = 'EQ'. P_VBELN-LOW = PV.
  APPEND P_VBELN.
  PERFORM GET_DATA.
* ZQM002: format sama dengan suite regresi
  LOOP AT IT_DATA.
    CLEAR LV_S.
    DO 7 TIMES.
      CASE SY-INDEX.
        WHEN 1. ASSIGN IT_DATA-VBELN TO <V>.
        WHEN 2. ASSIGN IT_DATA-MATNR TO <V>.
        WHEN 3. ASSIGN IT_DATA-CHK TO <V>.
        WHEN 4. ASSIGN IT_DATA-NUM TO <V>.
        WHEN 5. ASSIGN IT_DATA-MIC TO <V>.
        WHEN 6. ASSIGN IT_DATA-CMICMIT TO <V>.
        WHEN 7. ASSIGN IT_DATA-INSLOT TO <V>.
      ENDCASE.
      LV_N = <V>. CONDENSE LV_N.
      CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
    ENDDO.
    WRITE: / LV_S.
  ENDLOOP.
* Detail alias
  LOOP AT IT_DATA.
    CLEAR LV_S.
    DO 10 TIMES.
      CASE SY-INDEX.
        WHEN 1. ASSIGN IT_DATA-COA_MAT TO <V>.
        WHEN 2. ASSIGN IT_DATA-COA_PATH TO <V>.
        WHEN 3. ASSIGN IT_DATA-MIC TO <V>.
        WHEN 4. ASSIGN IT_DATA-BATCH_MIC TO <V>.
        WHEN 5. ASSIGN IT_DATA-ALIAS TO <V>.
        WHEN 6. ASSIGN IT_DATA-MICDES TO <V>.
        WHEN 7. ASSIGN IT_DATA-METHOD TO <V>.
        WHEN 8. ASSIGN IT_DATA-MICMIN TO <V>.
        WHEN 9. ASSIGN IT_DATA-MICMAX TO <V>.
        WHEN 10. ASSIGN IT_DATA-UOM TO <V>.
      ENDCASE.
      LV_N = <V>. CONDENSE LV_N.
      CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
    ENDDO.
    CONCATENATE '#X' LV_S INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT GT_AROLL INTO GS_AROLL.
    CONCATENATE '#R|' GS_AROLL-CHARG '|' GS_AROLL-MATNR '|'
      GS_AROLL-ALIAS '|' GS_AROLL-AMAT '|' GS_AROLL-PATH INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT GT_AMIC INTO GS_AMIC.
    CONCATENATE '#M|' GS_AMIC-MATNR '|' GS_AMIC-AMIC '|'
      GS_AMIC-BMIC '|' GS_AMIC-HOW '|' GS_AMIC-CHK INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT GT_ALOG INTO LV_S.
    CONCATENATE '#L|' LV_S INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
* EXEC (pilih semua baris CHK = X dari GET_DATA)
  IF IT_DATA[] IS NOT INITIAL.
    SY-UCOMM = 'EXEC'.
    PERFORM ZZ_UC0100.
  ENDIF.
* ZQM003
  PERFORM RPT_FILTER.
  PERFORM RPT_BUILD.
  LOOP AT IT_ALVR.
    CLEAR LV_S.
    DO 11 TIMES.
      CASE SY-INDEX.
        WHEN 1. ASSIGN IT_ALVR-VBELN TO <V>.
        WHEN 2. ASSIGN IT_ALVR-MATNR TO <V>.
        WHEN 3. ASSIGN IT_ALVR-POSNR TO <V>.
        WHEN 4. ASSIGN IT_ALVR-CHARG TO <V>.
        WHEN 5. ASSIGN IT_ALVR-MIC TO <V>.
        WHEN 6. ASSIGN IT_ALVR-CMICMIT TO <V>.
        WHEN 7. ASSIGN IT_ALVR-INS TO <V>.
        WHEN 8. ASSIGN IT_ALVR-MICDES TO <V>.
        WHEN 9. ASSIGN IT_ALVR-MICMIN TO <V>.
        WHEN 10. ASSIGN IT_ALVR-MICMAX TO <V>.
        WHEN 11. ASSIGN IT_ALVR-NUM TO <V>.
      ENDCASE.
      LV_N = <V>. CONDENSE LV_N.
      CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
    ENDDO.
    CONCATENATE '#A' LV_S INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
ENDFORM.
FORM ZZ_AFTER_EXEC.
  DATA: LV_S TYPE STRING, LV_N TYPE STRING.
  FIELD-SYMBOLS: <V> TYPE ANY.
  CONCATENATE '#E|PRODUCT|' PRODUCT '|WIDTH|' WIDTH INTO LV_S.
  WRITE: / LV_S.
  LOOP AT IT_DETAIL.
    CLEAR LV_S.
    DO 6 TIMES.
      CASE SY-INDEX.
        WHEN 1. ASSIGN IT_DETAIL-MIC TO <V>.
        WHEN 2. ASSIGN IT_DETAIL-MICDES TO <V>.
        WHEN 3. ASSIGN IT_DETAIL-CMICMIT TO <V>.
        WHEN 4. ASSIGN IT_DETAIL-MICMIN TO <V>.
        WHEN 5. ASSIGN IT_DETAIL-MICMAX TO <V>.
        WHEN 6. ASSIGN IT_DETAIL-METHOD TO <V>.
      ENDCASE.
      LV_N = <V>. CONDENSE LV_N.
      CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
    ENDDO.
    CONCATENATE '#E' LV_S INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
ENDFORM.
