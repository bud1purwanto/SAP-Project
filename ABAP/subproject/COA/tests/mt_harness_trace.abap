REPORT ZTMP_MT_TRACE.
* Read-only: run GET_TRACED_LOTS of ZQMI_COA for one batch
PARAMETERS: PC TYPE LIPS-CHARG DEFAULT '0000406850'.
FIELD-SYMBOLS: <F> TYPE ANY, <S> TYPE ANY, <V> TYPE ANY,
               <T> TYPE STANDARD TABLE.
DATA: LV_S TYPE STRING, LV_N TYPE STRING, LV_NM TYPE STRING.
DEFINE PR.
  CONCATENATE '(ZQMI_COA)' &1 INTO LV_NM.
  ASSIGN (LV_NM) TO <V>.
  IF SY-SUBRC = 0. WRITE: / &1, <V>. ELSE. WRITE: / &1, '?'. ENDIF.
END-OF-DEFINITION.
START-OF-SELECTION.
  PERFORM DUMMY_LOAD IN PROGRAM ZQMI_COA IF FOUND.
  ASSIGN ('(ZQMI_COA)ATINN_ROLL') TO <F>.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZNOMORROLL' IMPORTING OUTPUT = <F>.
  ASSIGN ('(ZQMI_COA)IT_DATA') TO <S>.
  ASSIGN COMPONENT 'CHARG' OF STRUCTURE <S> TO <V>. <V> = PC.
  SELECT SINGLE MATNR INTO LV_N FROM MCH1 WHERE CHARG = PC.
  ASSIGN COMPONENT 'MATNR' OF STRUCTURE <S> TO <V>. <V> = LV_N.
  PERFORM GET_TRACED_LOTS IN PROGRAM ZQMI_COA.
  PR 'LOT_SR_CONV'. PR 'LOT_SR_CONV2'. PR 'LOT_JR_CONV'.
  PR 'LOT_SR_BASE'. PR 'LOT_JR_BASE'.
  PR 'GS_TRACE_DATA-L_JR_CONV_BATCH'.
  PR 'GS_TRACE_DATA-L_SR_BASE_BATCH'.
  PR 'GS_TRACE_DATA-L_JR_BASE_BATCH'.
