REPORT ZTMP_MT_CHAIN.
* Read-only: walk genealogy SR->JR->SR... using ZQMI_COA forms
TABLES MCH1.
SELECT-OPTIONS: SC FOR MCH1-CHARG DEFAULT '0000406850' TO '0000406859'.
DATA: LV_S TYPE CHARG_D, LV_O TYPE CHARG_D, LV_J TYPE CHARG_D,
      LV_A TYPE AUFNR, LV_C TYPE CHARG_D, LV_M TYPE MATNR,
      LV_MJ TYPE MATNR, LV_LS TYPE QALS-PRUEFLOS,
      LV_LJ TYPE QALS-PRUEFLOS, LV_LV TYPE I,
      LV_LICHA TYPE MCH1-LICHA.
DATA: LT_C TYPE TABLE OF CHARG_D WITH HEADER LINE.
START-OF-SELECTION.
  SELECT CHARG INTO TABLE LT_C FROM MCH1 WHERE CHARG IN SC.
  SORT LT_C. DELETE ADJACENT DUPLICATES FROM LT_C.
  LOOP AT LT_C.
    LV_S = LT_C. CLEAR LV_LV.
    WRITE: / '=== ROLL', LV_S.
    DO 8 TIMES.
      LV_LV = SY-INDEX.
      CLEAR: LV_M, LV_LS, LV_J, LV_MJ, LV_LJ, LV_A, LV_C.
      SELECT SINGLE MATNR INTO LV_M FROM MCH1 WHERE CHARG = LV_S.
      SELECT SINGLE PRUEFLOS INTO LV_LS FROM QALS
        WHERE CHARG = LV_S AND ART = 'Z04'.
      PERFORM GET_ORIGINAL_BATCH IN PROGRAM ZQMI_COA
        USING LV_S CHANGING LV_O.
      CALL FUNCTION 'ZQM_GET_BATCH_JR_BY_SR'
        EXPORTING CHARG_S = LV_O IMPORTING CHARG_J = LV_J.
      IF LV_J IS NOT INITIAL.
        SELECT SINGLE MATNR INTO LV_MJ FROM MCH1 WHERE CHARG = LV_J.
        SELECT SINGLE PRUEFLOS INTO LV_LJ FROM QALS
          WHERE CHARG = LV_J AND ( ART = 'Z02' OR ART = 'Z03' ).
        PERFORM GET_VALID_ORDER_FROM_MSEG IN PROGRAM ZQMI_COA
          USING LV_J CHANGING LV_A.
        IF LV_A IS NOT INITIAL.
          PERFORM GET_VALID_COMPONENT_FROM_MSEG
            IN PROGRAM ZQMI_COA USING LV_A CHANGING LV_C.
        ENDIF.
      ENDIF.
      WRITE: / LV_LV, 'SR', LV_S, LV_M, LV_LS, '| JR', LV_J, LV_MJ,
               LV_LJ, '| ORD', LV_A, '| COMP', LV_C.
      IF LV_C IS INITIAL. EXIT. ENDIF.
      CLEAR LV_LICHA.
      SELECT SINGLE MATNR LICHA INTO (LV_M, LV_LICHA) FROM MCH1
        WHERE CHARG = LV_C.
      IF LV_LICHA IS NOT INITIAL AND LV_M(2) = 'SR'.
        WRITE: / '   LICHA of comp', LV_LICHA.
        LV_C = LV_LICHA.
      ENDIF.
      LV_S = LV_C.
    ENDDO.
  ENDLOOP.
