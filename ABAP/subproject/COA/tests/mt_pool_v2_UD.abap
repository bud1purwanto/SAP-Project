APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''B''. EV_P = ''001001001''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''C''. EV_P = ''101001000''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''D''. EV_P = ''000011001''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''E''. EV_P = ''100011000''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''F''. EV_P = ''001011000''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
