APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    EXPORTING INPUT = ''ZZCODE'' IMPORTING'.
C ' OUTPUT = ATINN_CODE.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
