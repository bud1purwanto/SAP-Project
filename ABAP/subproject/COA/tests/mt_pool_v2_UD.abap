APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    EXPORTING INPUT = ''ZZWIDTH'' IMPORTIN'.
C 'G OUTPUT = ATINN_WIDTH.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '  CALL FUNCTION ''CONVERSION_EXIT_ATINN_I'.
C 'NPUT'''.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    EXPORTING INPUT = ''ZZLENGTH'' IMPORTI'.
C 'NG OUTPUT = ATINN_LENGTH.'.
APPEND LV_SB TO LT_P.
