C 'ETING LEADING ''0''.'.
APPEND LV_SB TO LT_P.
A '        GS_HU_CACHE-HU_NUMBER = LT_BOX_VEKP-EXIDV.'.
CLEAR LV_SB.
C '        WRITE LT_BOX_VEKP-NTGEW TO GS_HU'.
C '_CACHE-TOT_WEIGHT DECIMALS 2.'.
APPEND LV_SB TO LT_P.
A '        CONDENSE GS_HU_CACHE-TOT_WEIGHT.'.
