C 'NPUT'''.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    EXPORTING INPUT = ''ZZNOMORROLL'' IMPO'.
C 'RTING OUTPUT = ATINN_ROLL.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
