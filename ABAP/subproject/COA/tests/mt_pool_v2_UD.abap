APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''J''. EV_P = ''000011100''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''K''. EV_P = ''100000011''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''L''. EV_P = ''001000011''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''M''. EV_P = ''101000010''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''N''. EV_P = ''000010011''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''O''. EV_P = ''100010010''.'.
APPEND LV_SB TO LT_P.
CLEAR LV_SB.
C '    WHEN ''P''. EV_P = ''001010010''.'.
