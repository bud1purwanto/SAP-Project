*&---------------------------------------------------------------------*
*& ZZ_ALIAS_MAP - live test alias (12/11/2026), TIDAK disimpan ke SAP
*& Alias batch -> material alias -> ZMAP_COA material alias ->
*& terjemahkan MIC ke MIC material batch (plan): EXACT/RULE/SUFFIX/DESC
*&---------------------------------------------------------------------*
FORM ZZ_ALIAS_MAP USING P_VBELN TYPE LIPS-VBELN
                        P_MATNR TYPE LIPS-MATNR
                        P_CHARG TYPE LIPS-CHARG
                        P_OBJEK
                        P_KUNNR.
  TYPES: BEGIN OF TY_PM,
           MIC TYPE PLMK-VERWMERKM,
           TXT TYPE PLMK-KURZTEXT,
         END OF TY_PM.
  DATA: LT_PB TYPE STANDARD TABLE OF TY_PM,
        LT_PA TYPE STANDARD TABLE OF TY_PM,
        LS_PM TYPE TY_PM,
        LS_PA TYPE TY_PM.
  DATA: LT_AMAP LIKE IT_ZMAP OCCURS 0 WITH HEADER LINE,
        LT_ACUS LIKE IT_ZMAP OCCURS 0 WITH HEADER LINE,
        LT_OUT  LIKE IT_ZMAP OCCURS 0 WITH HEADER LINE.
  DATA: LV_OBJ   TYPE AUSP-OBJEK,
        LV_KUN   TYPE ZMAP_COA-KUNNR,
        LV_ALIAS TYPE AUSP-ATWRT,
        LV_MAT   TYPE MARA-MATNR,
        LV_AMAT  TYPE MARA-MATNR,
        LV_CMAT  TYPE MARA-MATNR,
        LV_JRB   TYPE MARA-MATNR,
        LV_JRA   TYPE MARA-MATNR,
        LV_ATZHL TYPE CAWN-ATZHL,
        LV_CODE  TYPE CAWN-ATWRT,
        LV_MAKTX TYPE MAKT-MAKTX,
        LV_MAKTG TYPE MAKT-MAKTG,
        LV_LK    TYPE MAKT-MATNR,
        LV_NEW   TYPE ZMAP_COA-MIC,
        LV_HOW   TYPE C LENGTH 6,
        LV_VIA   TYPE C LENGTH 6,
        LV_HIT   TYPE I,
        LV_LEN   TYPE I,
        LV_IX    TYPE SY-TABIX,
        LV_NOK   TYPE I,
        LV_NNO   TYPE I,
        LV_T1    TYPE STRING,
        LV_T2    TYPE STRING,
        LV_S1    TYPE STRING,
        LV_S2    TYPE STRING.

  LV_OBJ = P_OBJEK.
  LV_KUN = P_KUNNR.
  LV_MAT = P_MATNR.
  IF GV_ZZ_ATAL IS INITIAL.
    CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
      EXPORTING
        INPUT  = 'ZZALIAS'
      IMPORTING
        OUTPUT = GV_ZZ_ATAL.
  ENDIF.
  SELECT SINGLE ATWRT INTO LV_ALIAS FROM AUSP
    WHERE OBJEK = LV_OBJ
      AND ATINN = GV_ZZ_ATAL
      AND KLART = '023'.
  IF GV_ZZ_FORCE IS NOT INITIAL.
    LV_ALIAS = GV_ZZ_FORCE.
  ENDIF.
  IF LV_ALIAS IS INITIAL.
    RETURN.
  ENDIF.

* 1) Alias -> material: ZZCODE value text (CAWNT-ATWTB)
  SELECT SINGLE ATZHL INTO LV_ATZHL FROM CAWNT
    WHERE ATINN = ATINN_CODE
      AND ATWTB = LV_ALIAS.
  IF SY-SUBRC = 0.
    SELECT SINGLE ATWRT INTO LV_CODE FROM CAWN
      WHERE ATINN = ATINN_CODE
        AND ATZHL = LV_ATZHL.
    IF LV_CODE IS NOT INITIAL.
      LV_LEN = STRLEN( LV_MAT ) - 1.
      CONCATENATE LV_MAT(2) LV_CODE LV_MAT+LV_LEN(1) INTO LV_CMAT.
      SELECT SINGLE MATNR INTO LV_AMAT FROM MARA
        WHERE MATNR = LV_CMAT.
      IF SY-SUBRC = 0.
        LV_VIA = 'ZZCODE'.
      ELSE.
        CLEAR LV_AMAT.
      ENDIF.
    ENDIF.
  ENDIF.
* 2) Fallback: MAKT = awalan teks material batch + alias
  IF LV_AMAT IS INITIAL.
    SELECT SINGLE MAKTX INTO LV_MAKTX FROM MAKT
      WHERE MATNR = LV_MAT AND SPRAS = 'E'.
    LV_T1 = LV_MAKTX.
    CLEAR LV_T2.
    FIND REGEX '^(.*\s)\S+\s*$' IN LV_T1 SUBMATCHES LV_T2.
    IF LV_T2 IS NOT INITIAL.
      LV_S1 = LV_ALIAS.
      CONDENSE LV_S1.
      LV_T2 = LV_T2 && LV_S1.
      TRANSLATE LV_T2 TO UPPER CASE.
      LV_MAKTG = LV_T2.
      CONCATENATE LV_MAT(2) '%' INTO LV_LK.
      SELECT SINGLE MATNR INTO LV_AMAT FROM MAKT
        WHERE MAKTG = LV_MAKTG
          AND SPRAS = 'E'
          AND MATNR LIKE LV_LK.
      IF SY-SUBRC = 0.
        LV_VIA = 'MAKT'.
      ENDIF.
    ENDIF.
  ENDIF.

  IF LV_AMAT IS INITIAL.
    CONCATENATE 'L' P_VBELN P_CHARG LV_ALIAS 'NOCONV'
      'fallback mapping material DO' INTO GV_ZZLOG SEPARATED BY '|'.
    APPEND GV_ZZLOG TO GT_ZZLOG.
    RETURN.
  ENDIF.
  IF LV_AMAT = LV_MAT.
    CONCATENATE 'L' P_VBELN P_CHARG LV_ALIAS 'SAME' LV_AMAT
      INTO GV_ZZLOG SEPARATED BY '|'.
    APPEND GV_ZZLOG TO GT_ZZLOG.
    RETURN.
  ENDIF.

* 3) Mapping material alias (umum + override customer)
  SELECT MATNR MIC KUNNR METHOD MAPPING UOM MIC_DESC
         LOWER_LIMIT UPPER_LIMIT SEQ_NO
    INTO CORRESPONDING FIELDS OF TABLE LT_AMAP
    FROM ZMAP_COA
    WHERE MATNR = LV_AMAT
      AND KUNNR = ' '
      AND DELETION NE 'X'.
  LOOP AT GT_ZZTMAP WHERE MATNR = LV_AMAT.
    APPEND GT_ZZTMAP TO LT_AMAP.
  ENDLOOP.
  IF LV_KUN IS NOT INITIAL.
    SELECT MATNR MIC KUNNR METHOD MAPPING UOM MIC_DESC
           LOWER_LIMIT UPPER_LIMIT SEQ_NO
      INTO CORRESPONDING FIELDS OF TABLE LT_ACUS
      FROM ZMAP_COA
      WHERE MATNR = LV_AMAT
        AND KUNNR = LV_KUN
        AND DELETION NE 'X'.
  ENDIF.
  SORT LT_AMAP BY MIC.
  LOOP AT LT_ACUS.
    READ TABLE LT_AMAP WITH KEY MIC = LT_ACUS-MIC BINARY SEARCH.
    LV_IX = SY-TABIX.
    IF SY-SUBRC = 0.
      LT_AMAP-METHOD   = LT_ACUS-METHOD.
      LT_AMAP-KUNNR    = LT_ACUS-KUNNR.
      LT_AMAP-MAPPING  = LT_ACUS-MAPPING.
      LT_AMAP-UOM      = LT_ACUS-UOM.
      LT_AMAP-MIC_DESC = LT_ACUS-MIC_DESC.
      IF LT_ACUS-LOWER_LIMIT IS NOT INITIAL.
        LT_AMAP-LOWER_LIMIT = LT_ACUS-LOWER_LIMIT.
      ENDIF.
      IF LT_ACUS-UPPER_LIMIT IS NOT INITIAL.
        LT_AMAP-UPPER_LIMIT = LT_ACUS-UPPER_LIMIT.
      ENDIF.
      IF LT_ACUS-SEQ_NO IS NOT INITIAL.
        LT_AMAP-SEQ_NO = LT_ACUS-SEQ_NO.
      ENDIF.
      MODIFY LT_AMAP INDEX LV_IX.
    ELSE.
      APPEND LT_ACUS TO LT_AMAP.
      SORT LT_AMAP BY MIC.
    ENDIF.
  ENDLOOP.
  IF LT_AMAP[] IS INITIAL.
    CONCATENATE 'L' P_VBELN P_CHARG LV_ALIAS 'NOMAP' LV_AMAT
      'fallback mapping material DO' INTO GV_ZZLOG SEPARATED BY '|'.
    APPEND GV_ZZLOG TO GT_ZZLOG.
    RETURN.
  ENDIF.

* 4) Kamus MIC: inspection plan material batch & material alias
  LV_JRB = LV_MAT.  LV_JRB(2) = 'JR'.
  LV_JRA = LV_AMAT. LV_JRA(2) = 'JR'.
  SELECT DISTINCT PLMK~VERWMERKM PLMK~KURZTEXT
    INTO TABLE LT_PB
    FROM MAPL INNER JOIN PLMK
      ON PLMK~PLNTY = MAPL~PLNTY AND PLMK~PLNNR = MAPL~PLNNR
    WHERE ( MAPL~MATNR = LV_MAT OR MAPL~MATNR = LV_JRB )
      AND MAPL~PLNTY = 'Q'
      AND MAPL~LOEKZ = ' '
      AND PLMK~LOEKZ = ' '.
  SELECT DISTINCT PLMK~VERWMERKM PLMK~KURZTEXT
    INTO TABLE LT_PA
    FROM MAPL INNER JOIN PLMK
      ON PLMK~PLNTY = MAPL~PLNTY AND PLMK~PLNNR = MAPL~PLNNR
    WHERE ( MAPL~MATNR = LV_AMAT OR MAPL~MATNR = LV_JRA )
      AND MAPL~PLNTY = 'Q'
      AND MAPL~LOEKZ = ' '
      AND PLMK~LOEKZ = ' '.
  SORT LT_PB BY MIC.
  SORT LT_PA BY MIC.

* 5) Terjemahkan MIC mapping alias -> MIC material batch
  LOOP AT LT_AMAP.
    CLEAR: LV_NEW, LV_HOW.
    READ TABLE LT_PB INTO LS_PM WITH KEY MIC = LT_AMAP-MIC
      BINARY SEARCH.
    IF SY-SUBRC = 0.
      LV_NEW = LT_AMAP-MIC.
      LV_HOW = 'EXACT'.
    ELSEIF STRLEN( LT_AMAP-MIC ) = 8.
      CONCATENATE LT_AMAP-MIC(1) LV_MAT+2(3) LT_AMAP-MIC+4(4)
        INTO LV_NEW.
      READ TABLE LT_PB INTO LS_PM WITH KEY MIC = LV_NEW
        BINARY SEARCH.
      IF SY-SUBRC = 0.
        LV_HOW = 'RULE'.
      ELSE.
        CLEAR: LV_NEW, LV_HIT.
        LOOP AT LT_PB INTO LS_PM.
          IF STRLEN( LS_PM-MIC ) = 8 AND
             LS_PM-MIC(1) = LT_AMAP-MIC(1) AND
             LS_PM-MIC+4(4) = LT_AMAP-MIC+4(4).
            LV_HIT = LV_HIT + 1.
            LV_NEW = LS_PM-MIC.
          ENDIF.
        ENDLOOP.
        IF LV_HIT = 1.
          LV_HOW = 'SUFFIX'.
        ELSE.
          CLEAR LV_NEW.
        ENDIF.
      ENDIF.
    ENDIF.
    IF LV_NEW IS INITIAL.
      CLEAR LS_PA.
      READ TABLE LT_PA INTO LS_PA WITH KEY MIC = LT_AMAP-MIC
        BINARY SEARCH.
      IF LS_PA-TXT IS INITIAL.
        SELECT SINGLE KURZTEXT INTO LS_PA-TXT FROM QPMT
          WHERE MKMNR = LT_AMAP-MIC AND SPRACHE = 'E'.
      ENDIF.
      LV_T1 = LS_PA-TXT.
      CONDENSE LV_T1 NO-GAPS.
      TRANSLATE LV_T1 TO UPPER CASE.
      CLEAR LV_HIT.
      LOOP AT LT_PB INTO LS_PM.
        LV_T2 = LS_PM-TXT.
        CONDENSE LV_T2 NO-GAPS.
        TRANSLATE LV_T2 TO UPPER CASE.
        IF LV_T1 IS NOT INITIAL AND LV_T1 = LV_T2.
          LV_HIT = LV_HIT + 1.
          LV_NEW = LS_PM-MIC.
        ENDIF.
      ENDLOOP.
      IF LV_HIT = 1.
        LV_HOW = 'DESC'.
      ELSE.
        CLEAR LV_NEW.
      ENDIF.
    ENDIF.
    CLEAR GT_ZZX.
    GT_ZZX-VBELN  = P_VBELN.
    GT_ZZX-CHARG  = P_CHARG.
    GT_ZZX-SRC    = LT_AMAP-MIC.
    GT_ZZX-AMAT   = LV_AMAT.
    GT_ZZX-METHOD = LT_AMAP-METHOD.
    IF LV_NEW IS INITIAL.
      GT_ZZX-HOW = 'NONE'.
      LV_NNO = LV_NNO + 1.
    ELSE.
      GT_ZZX-MIC = LV_NEW.
      GT_ZZX-HOW = LV_HOW.
      LV_NOK = LV_NOK + 1.
      LT_OUT = LT_AMAP.
      LT_OUT-MATNR = LV_MAT.
      LT_OUT-MIC   = LV_NEW.
      APPEND LT_OUT.
    ENDIF.
    APPEND GT_ZZX.
  ENDLOOP.

  IT_ZMAP[] = LT_OUT[].
  SORT IT_ZMAP BY MIC ASCENDING.
  DELETE ADJACENT DUPLICATES FROM IT_ZMAP COMPARING MIC.
  LV_S1 = LV_NOK.
  LV_S2 = LV_NNO.
  CONCATENATE 'L' P_VBELN P_CHARG LV_ALIAS 'ALIASMAP' LV_AMAT LV_VIA
    LV_S1 LV_S2 INTO GV_ZZLOG SEPARATED BY '|'.
  APPEND GV_ZZLOG TO GT_ZZLOG.
ENDFORM.                    "ZZ_ALIAS_MAP
