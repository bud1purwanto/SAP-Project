FORM ZZ_MT_RUN USING PV TYPE LIPS-VBELN.
  DATA: LV_S TYPE STRING, LV_N TYPE STRING.
  FIELD-SYMBOLS: <V> TYPE ANY.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZNOMORROLL' IMPORTING OUTPUT = ATINN_ROLL.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZCODE' IMPORTING OUTPUT = ATINN_CODE.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZWIDTH' IMPORTING OUTPUT = ATINN_WIDTH.
  CALL FUNCTION 'CONVERSION_EXIT_ATINN_INPUT'
    EXPORTING INPUT = 'ZZLENGTH' IMPORTING OUTPUT = ATINN_LENGTH.
  REFRESH: GT_ZZTMAP, GT_ZZX, GT_ZZLOG.
  GV_ZZ_FORCE = 'HSS-18'.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJTH00'.
  GT_ZZTMAP-METHOD = 'ASTM D 374'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '001'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJTSMD'.
  GT_ZZTMAP-METHOD = 'ASTM D 882'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '002'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJTSTD'.
  GT_ZZTMAP-METHOD = 'ASTM D 882'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '003'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJELMD'.
  GT_ZZTMAP-METHOD = 'ASTM D 882'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '004'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJELTD'.
  GT_ZZTMAP-METHOD = 'ASTM D 882'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '005'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSHMD'.
  GT_ZZTMAP-METHOD = 'ASTM D 1204'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '006'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSHTD'.
  GT_ZZTMAP-METHOD = 'ASTM D 1204'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '007'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJHZ00'.
  GT_ZZTMAP-METHOD = 'ASTM D 1003'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '008'.
  GT_ZZTMAP-UPPER_LIMIT = '2.5'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJG400'.
  GT_ZZTMAP-METHOD = 'ASTM D 2457'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '009'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSITR'.
  GT_ZZTMAP-METHOD = 'Trias Method'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '010'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJSINT'.
  GT_ZZTMAP-METHOD = 'Trias Method'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '011'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
