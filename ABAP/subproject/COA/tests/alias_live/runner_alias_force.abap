  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '012'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'PACJSSNT'.
  GT_ZZTMAP-METHOD = 'Trias Method'.
  GT_ZZTMAP-MAPPING = 'JR Base Film'.
  GT_ZZTMAP-SEQ_NO = '013'.
  APPEND GT_ZZTMAP.
  CLEAR GT_ZZTMAP.
  GT_ZZTMAP-MATNR = 'SRACJI'.
  GT_ZZTMAP-MIC = 'SACJFDTR'.
  GT_ZZTMAP-METHOD = 'ASTM D 1894'.
  GT_ZZTMAP-MAPPING = 'SR Base Film'.
  GT_ZZTMAP-SEQ_NO = '014'.
  APPEND GT_ZZTMAP.
  P_VBELN-SIGN = 'I'. P_VBELN-OPTION = 'EQ'. P_VBELN-LOW = PV.
  APPEND P_VBELN.
  PERFORM GET_DATA.
  LOOP AT IT_DATA.
    CLEAR LV_S.
    DO 11 TIMES.
      CASE SY-INDEX.
        WHEN 1. ASSIGN IT_DATA-VBELN TO <V>.
        WHEN 2. ASSIGN IT_DATA-MATNR TO <V>.
        WHEN 3. ASSIGN IT_DATA-CHK TO <V>.
        WHEN 4. ASSIGN IT_DATA-NUM TO <V>.
        WHEN 5. ASSIGN IT_DATA-MIC TO <V>.
        WHEN 6. ASSIGN IT_DATA-CMICMIT TO <V>.
        WHEN 7. ASSIGN IT_DATA-INSLOT TO <V>.
        WHEN 8. ASSIGN IT_DATA-MICMIN TO <V>.
        WHEN 9. ASSIGN IT_DATA-MICMAX TO <V>.
        WHEN 10. ASSIGN IT_DATA-METHOD TO <V>.
        WHEN 11. ASSIGN IT_DATA-MICDES TO <V>.
      ENDCASE.
      LV_N = <V>. CONDENSE LV_N.
      CONCATENATE LV_S LV_N INTO LV_S SEPARATED BY '|'.
    ENDDO.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT GT_ZZX.
    CONCATENATE 'X' GT_ZZX-CHARG GT_ZZX-SRC GT_ZZX-MIC
      GT_ZZX-HOW INTO LV_S SEPARATED BY '|'.
    WRITE: / LV_S.
  ENDLOOP.
  LOOP AT GT_ZZLOG INTO LV_S.
    WRITE: / LV_S.
  ENDLOOP.
ENDFORM.
