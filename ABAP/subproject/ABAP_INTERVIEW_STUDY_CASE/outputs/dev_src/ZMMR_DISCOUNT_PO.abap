REPORT  ZMMR_DISCOUNT_PO.

TYPE-POOLS: SLIS.
DATA : LS_FIELDCAT   TYPE SLIS_FIELDCAT_ALV,
       LS_EVENT_EXIT TYPE SLIS_EVENT_EXIT,
       T_SORT        TYPE SLIS_T_SORTINFO_ALV WITH HEADER LINE,
       IT_FIELDCAT   TYPE SLIS_T_FIELDCAT_ALV,
       IT_LAYOUT     TYPE SLIS_LAYOUT_ALV OCCURS 0 WITH HEADER LINE.

DATA : LS_VARIANT TYPE  DISVARIANT.
LS_VARIANT-REPORT = SY-REPID.
LS_VARIANT-USERNAME = SY-UNAME.

TABLES : EKPO, EKKO, T161T.
TYPES : BEGIN OF ITAB,
          EBELN LIKE EKPO-EBELN,        "PO NUMBER
          EBELP LIKE EKPO-EBELP,        "PO ITEM
          NETPR LIKE EKPO-NETPR,        "NET PRICE
          NETPR2(16) TYPE P DECIMALS 2, "NET PRICE2
          NETPR3(16) TYPE P DECIMALS 2, "NET PRICE DISPLAY
          AEDAT LIKE EKKO-AEDAT,        "PO DATE
          WAERS LIKE EKKO-WAERS,        "CURRENCY
          MATNR LIKE EKPO-MATNR,        "MATERIAL
          TXZ01 LIKE EKPO-TXZ01,        "DESCR
          ZRFQNUM LIKE EKET-EBELN,      "RFQ
          ZRFQITEM LIKE EKET-EBELP,     "RFQ ITEM
          ZRFQDESCR LIKE EKPO-TXZ01,    "RFQ MAT DESCR
          ZNETPR(16) TYPE P DECIMALS 2, "PRICE OF RFQ
          ZNETPR2(16) TYPE P DECIMALS 2,"PRICE OF RFQ2
          ZWAERS LIKE EKKO-WAERS,       "CURRENCY OF RFQ
          ZAEDAT LIKE EKKO-AEDAT,       "RFQ DATE
          ZKTMNG LIKE EKPO-KTMNG,       "RFQ QTY
          QTYRFQ(10) TYPE P DECIMALS 2, "RFQ QTY
          BANFN LIKE EKPO-BANFN,        "PR NUMBER
          BNFPO LIKE EKPO-BNFPO,        "PR ITEM

          ZDISCABSOLUTE(16) TYPE P DECIMALS 2,      "DISCOUNT absolute
          ZDISCABSOLUTE2(16) TYPE P DECIMALS 2,     "FORMAT CURR
          ZDISCABSOLUTE3(20) TYPE C,                "BIAR BISA DI MERGE
          ZSAVINGRELATIVE(16) TYPE P DECIMALS 2,    "SAVING RELATIVE
          ZSAVINGRELATIVE2(16) TYPE P DECIMALS 2,   "FORMAT CURR
          ZSAVINGRELATIVE3(20) TYPE C,              "BIAR BISA DI MERGE

          ZDISCABSOLUTEUSD(16) TYPE P DECIMALS 2,   "DISCOUNT absolute USD
          ZDISCABSOLUTEUSD2(16) TYPE P DECIMALS 2,  "FORMAT CURR
          ZDISCABSOLUTEUSD3(20) TYPE C,             "BIAR BISA DI MERGE
          ZSAVINGRELATIVEUSD(16) TYPE P DECIMALS 2, "SAVING RELATIVE USD
          ZSAVINGRELATIVEUSD2(16) TYPE P DECIMALS 2,"FORMAT CURR
          ZSAVINGRELATIVEUSD3(20) TYPE C,           "BIAR BISA DI MERGE

          ZDISCABSOLUTEIDR(16) TYPE P DECIMALS 2,   "DISCOUNT absolute IDR
          ZDISCABSOLUTEIDR2(16) TYPE P DECIMALS 2,  "FORMAT CURR
          ZDISCABSOLUTEIDR3(20) TYPE C,             "BIAR BISA DI MERGE
          ZSAVINGRELATIVEIDR(16) TYPE P DECIMALS 2, "SAVING RELATIVE IDR
          ZSAVINGRELATIVEIDR2(16) TYPE P DECIMALS 2,"FORMAT CURR
          ZSAVINGRELATIVEIDR3(20) TYPE C,           "BIAR BISA DI MERGE

          KNUMV LIKE EKKO-KNUMV,       "DOC CONDITIONS
          BSART LIKE EKKO-BSART,       "Document Type
          EKGRP LIKE EKKO-EKGRP,       "Purch. Group
          NETWR LIKE EKPO-NETWR,       "Net Value
          PEINH LIKE EKPO-PEINH,       "PRICE UNIT PO
          PEINHX(20) TYPE C,           "PRICE UNIT / order unit
          ZPEINH(20) TYPE C,           "PRICE UNIT RFQ / order unit
          MEINS LIKE EKPO-MEINS,       "Order Unit
          MENGE LIKE EKPO-MENGE,       "QTY PO
          QTYPO(10) TYPE P DECIMALS 2, "QTY PO

          LIFNR LIKE EKKO-LIFNR,           "VENDOR (add 17-5-2017 by Gani)
          NAME1 LIKE ADRC-NAME1,           "VENDOR NAME
          BATXT LIKE T161T-BATXT,          "PO Type Desc
          ADRNR LIKE EKKO-ADRNR,           "ADDRESS
          NETPRUSD(16) TYPE P DECIMALS 2,  "NET PRICE DISPLAY USD (add 17-7-2017 by Rey)
          BUKRS LIKE EKKO-BUKRS,           "Company Code (Add for New Company 27/12/2017 by Jarwo)
        END OF ITAB.

TYPES : BEGIN OF ITRFQ,
          EBELN LIKE EKET-EBELN,         "RFQ NUMBER
          EBELP LIKE EKET-EBELP,         "RFQ ITEM
          BANFN LIKE EKET-BANFN,         "PR NUMBER
          BNFPO LIKE EKET-BNFPO,         "PR ITEM
          NETPR LIKE EKPO-NETPR,         "NET PRICE RFQ
          NETPR2(16) TYPE P DECIMALS 2,  "NET PRICE RFQ2
          NETPR3(16) TYPE P DECIMALS 2,  "NET PRICE DISPLAY
          WAERS LIKE EKKO-WAERS,         "CURRENCY RFQ
          AEDAT LIKE EKKO-AEDAT,         "RFQ DATE
          KTMNG  LIKE EKPO-KTMNG,        "RFQ QTY
          TXZ01 LIKE EKPO-TXZ01,         "MTR DESCR
          LOEKZ LIKE EKPO-LOEKZ,         "DEL
          PEINH LIKE EKPO-PEINH,         "PRICE UNIT
        END OF ITRFQ.

DATA :  ITAB TYPE ITAB OCCURS 0 WITH HEADER LINE,
        ITAB2 TYPE ITAB OCCURS 0 WITH HEADER LINE,
        ITRFQ TYPE ITRFQ OCCURS 0 WITH HEADER LINE,
        ZMAX TYPE P DECIMALS 2,
        ZCHAR(20) TYPE C,
        ZCHAR2(20) TYPE C,
        IT_POTYPE TYPE T161T OCCURS 0 WITH HEADER LINE,
        V_KTOKK LIKE LFA1-KTOKK.

DATA : BEGIN OF ITKONV OCCURS 0,
        KNUMV LIKE KONV-KNUMV, "Doc. condition
        KPOSN LIKE KONV-KPOSN, "Item
        KSCHL LIKE KONV-KSCHL, "Condition type
        KWERT LIKE KONV-KWERT, "Condition Value
       END OF ITKONV.

DATA : ZGROSSPRICE LIKE KONV-KWERT,
       V_KURS LIKE RKB1K-EXCHR.

SELECTION-SCREEN BEGIN OF BLOCK BLOCK1 WITH FRAME TITLE TEXT-001.
SELECT-OPTIONS : S_BUKRS FOR EKKO-BUKRS,  "Add for New Company 27/12/2017 By Jarwo
                 S_EBELN FOR EKPO-EBELN,
                 S_AEDAT FOR EKPO-AEDAT,
                 S_EKGRP FOR EKKO-EKGRP,
                 S_MATNR FOR EKPO-MATNR.
SELECTION-SCREEN END OF BLOCK BLOCK1.

START-OF-SELECTION.
  IF S_EBELN IS INITIAL AND S_AEDAT IS INITIAL AND S_MATNR IS INITIAL AND S_EKGRP IS INITIAL AND S_BUKRS IS INITIAL.
    MESSAGE 'Isi Salah Satu Filter' TYPE 'I'.
    EXIT.
  ENDIF.
  PERFORM GET_DATA.
  IF ITAB2[] IS INITIAL.
    MESSAGE 'No Data Selected' TYPE 'I'.
    EXIT.
  ENDIF.
  PERFORM DISPLAY_DATA.

END-OF-SELECTION.

*&---------------------------------------------------------------------*
*&      Form  GET_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM GET_DATA .
  CLEAR: ITAB, ITAB2, ITRFQ, IT_POTYPE.
  REFRESH: ITAB, ITAB2, ITRFQ, IT_POTYPE.
  "AMBIL DATA PO
  SELECT EKPO~EBELN EKPO~EBELP EKPO~NETPR EKKO~WAERS EKPO~MATNR EKPO~TXZ01 EKPO~BANFN EKPO~BNFPO
         EKKO~AEDAT EKKO~KNUMV EKKO~BSART EKKO~EKGRP EKPO~NETWR EKPO~PEINH EKPO~MEINS EKPO~MENGE
         EKKO~LIFNR EKKO~ADRNR EKKO~BUKRS
    INTO CORRESPONDING FIELDS OF TABLE ITAB
    FROM EKKO JOIN EKPO ON EKKO~EBELN = EKPO~EBELN
    WHERE EKPO~EBELN IN S_EBELN
    AND EKKO~AEDAT IN S_AEDAT
    AND EKPO~MATNR IN S_MATNR
    AND EKPO~LOEKZ NE 'L'
    AND EKPO~BANFN NE ''
    AND EKKO~BSART NOT IN ('PO08','PO11','PO19')
    AND EKKO~EKGRP IN S_EKGRP
    AND EKKO~BUKRS IN S_BUKRS.  "Add for New Company 27/12/2017 By Jarwo

  SORT ITAB BY EBELN EBELP.

  IF ITAB[] IS INITIAL.
    EXIT.
  ENDIF.

  "AMBIL DATA RFQ
  SELECT EKET~EBELN EKET~EBELP EKET~BANFN EKET~BNFPO EKPO~NETPR EKKO~WAERS EKKO~AEDAT EKPO~KTMNG EKPO~TXZ01 EKPO~LOEKZ EKPO~PEINH
     INTO CORRESPONDING FIELDS OF TABLE ITRFQ
     FROM EKET LEFT JOIN EKPO ON EKET~EBELN =  EKPO~EBELN AND EKET~EBELP =  EKPO~EBELP
     LEFT JOIN EKKO ON EKET~EBELN = EKKO~EBELN
     FOR ALL ENTRIES IN ITAB
     WHERE EKET~BANFN = ITAB-BANFN AND EKET~BNFPO = ITAB-BNFPO AND EKET~EBELN NE ITAB-EBELN
      AND EKET~EBELN LIKE '6%'.

  SORT ITRFQ BY EBELN EBELP.

  DELETE ITRFQ WHERE LOEKZ EQ 'L' OR NETPR = 0.

  CLEAR ITKONV.
  REFRESH ITKONV.

  "Ambil Gross Price
  SELECT KONV~KNUMV KONV~KPOSN KONV~KSCHL KONV~KWERT INTO CORRESPONDING FIELDS OF TABLE ITKONV
    FROM KONV
    FOR ALL ENTRIES IN ITAB
    WHERE KNUMV = ITAB-KNUMV
    AND KSCHL LIKE 'PB%'.

  "Ambil PO Type Desc (add 17-5-2017)
  SELECT * INTO CORRESPONDING FIELDS OF TABLE IT_POTYPE
    FROM T161T WHERE SPRAS = 'EN' AND BSART LIKE 'PO%'.

  LOOP AT ITAB.
    CLEAR: ZGROSSPRICE, V_KTOKK.

    "Get Vendor Name (add 17-5-2017 by Gani)
    SELECT SINGLE ADRC~NAME1 LFA1~KTOKK INTO (ITAB-NAME1, V_KTOKK)
        FROM LFA1 JOIN ADRC ON LFA1~ADRNR = ADRC~ADDRNUMBER
        WHERE LFA1~LIFNR = ITAB-LIFNR.

    IF V_KTOKK = 'ZOTI'. "One Time Vendor
      CLEAR: ITAB-NAME1.
      SELECT SINGLE NAME1 INTO ITAB-NAME1 FROM ADRC WHERE ADDRNUMBER = ITAB-ADRNR.
    ENDIF.

    "PO Type Desc (add 17-5-2017)
    READ TABLE IT_POTYPE WITH KEY BSART = ITAB-BSART.
    IF SY-SUBRC = 0.
      ITAB-BATXT = IT_POTYPE-BATXT.
    ENDIF.

    READ TABLE ITKONV WITH KEY KNUMV = ITAB-KNUMV KPOSN = ITAB-EBELP.
    IF SY-SUBRC = 0.
      IF ITAB-WAERS = 'IDR'.
        ZGROSSPRICE = ( ITKONV-KWERT * 100 ).
      ELSE.
        "KONVERSI GROSSPRICE
        CLEAR V_KURS.
        CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
          EXPORTING
            DATUM         = ITAB-AEDAT
            KURST         = 'M'
            NCURR         = 'IDR'
            VCURR         = ITAB-WAERS
          IMPORTING
            EXCHR         = V_KURS
          EXCEPTIONS
            NO_RATE_FOUND = 1
            OTHERS        = 2.

        IF SY-SUBRC <> 0.
*       Implement suitable error handling here
        ENDIF.
        ZGROSSPRICE = ITKONV-KWERT * V_KURS.
      ENDIF.
    ENDIF.

    "HITUNG NETPRICE PO
    IF ITAB-WAERS EQ 'IDR'.
      ITAB-NETPR2 = ITAB-NETPR * 100 / ITAB-PEINH.
      ITAB-NETPR3 = ITAB-NETPR2.
      "Konversi Net Value
      ITAB-NETWR = ITAB-NETWR * 100.
    ELSE.
      "Net Price PO Konversi Ke IDR
      CLEAR V_KURS.
      CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
        EXPORTING
          DATUM         = ITAB-AEDAT
          KURST         = 'M'
          NCURR         = 'IDR'
          VCURR         = ITAB-WAERS
        IMPORTING
          EXCHR         = V_KURS
        EXCEPTIONS
          NO_RATE_FOUND = 1
          OTHERS        = 2.

      IF SY-SUBRC <> 0.
*     Implement suitable error handling here
      ENDIF.
      ITAB-NETPR2 = ITAB-NETPR * V_KURS / ITAB-PEINH.
      ITAB-NETPR3 = ITAB-NETPR / ITAB-PEINH.

      "Net Value Konversi Ke IDR
      CLEAR V_KURS.
      CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
        EXPORTING
          DATUM         = ITAB-AEDAT
          KURST         = 'M'
          NCURR         = 'IDR'
          VCURR         = ITAB-WAERS
        IMPORTING
          EXCHR         = V_KURS
        EXCEPTIONS
          NO_RATE_FOUND = 1
          OTHERS        = 2.

      IF SY-SUBRC <> 0.
*     Implement suitable error handling here
      ENDIF.
      ITAB-NETWR = ITAB-NETWR * V_KURS.
    ENDIF.

    "Perhitungan Discount Absolute (Gross Price - Net Value PO)(IDR & USD)
    ITAB-ZDISCABSOLUTE = ZGROSSPRICE - ITAB-NETWR.
    ITAB-ZDISCABSOLUTE2 = ITAB-ZDISCABSOLUTE.
    WRITE ITAB-ZDISCABSOLUTE2 TO ITAB-ZDISCABSOLUTE3.
    WRITE ITAB-ZDISCABSOLUTE2 TO ITAB-ZDISCABSOLUTEIDR3.
    CLEAR V_KURS.
    CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
      EXPORTING
        DATUM         = ITAB-AEDAT
        KURST         = 'M'
        NCURR         = 'IDR'
        VCURR         = 'USD'
      IMPORTING
        EXCHR         = V_KURS
      EXCEPTIONS
        NO_RATE_FOUND = 1
        OTHERS        = 2.

    IF SY-SUBRC <> 0.
*     Implement suitable error handling here
    ENDIF.

    ITAB-ZDISCABSOLUTEUSD2 = ITAB-ZDISCABSOLUTE * 1 / V_KURS.
    WRITE ITAB-ZDISCABSOLUTEUSD2 TO ITAB-ZDISCABSOLUTEUSD3.

    CLEAR: ZCHAR, ZCHAR2.
    ZCHAR = ITAB-PEINH.
    CONDENSE ZCHAR.
    CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
      EXPORTING
        INPUT    = ITAB-MEINS
        LANGUAGE = SY-LANGU
      IMPORTING
        OUTPUT   = ZCHAR2.

    CONDENSE ZCHAR2.
    CONCATENATE ZCHAR ZCHAR2 INTO ITAB-PEINHX SEPARATED BY SPACE.
    ITAB-QTYPO = ITAB-MENGE.

    CALL FUNCTION 'CONVERSION_EXIT_ALPHA_OUTPUT'
      EXPORTING
        INPUT  = ITAB-MATNR
      IMPORTING
        OUTPUT = ITAB-MATNR.

    MODIFY ITAB TRANSPORTING MATNR NETPR NETPR2 NETPR3 NETWR ZDISCABSOLUTE ZDISCABSOLUTE2 ZDISCABSOLUTE3 ZDISCABSOLUTEIDR3 ZDISCABSOLUTEUSD2
    ZDISCABSOLUTEUSD3 PEINHX QTYPO NAME1 BATXT WHERE EBELN = ITAB-EBELN AND EBELP = ITAB-EBELP.

    READ TABLE ITRFQ WITH KEY BANFN = ITAB-BANFN BNFPO = ITAB-BNFPO.
    IF SY-SUBRC = 0.
      "KONVERSI NETPRICE RFQ
      CLEAR: ZMAX, ITRFQ.
      LOOP AT ITRFQ WHERE BANFN = ITAB-BANFN AND BNFPO = ITAB-BNFPO.
        IF ITRFQ-WAERS = 'IDR'.
          ITRFQ-NETPR2 = ITRFQ-NETPR * 100 / ITRFQ-PEINH.
          ITRFQ-NETPR3 = ITRFQ-NETPR2.
        ELSE.
          "KONVERSI KE IDR (DISAMAKAN DENGAN CURR PO)
          CLEAR V_KURS.
          CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
            EXPORTING
              DATUM         = ITAB-AEDAT
              KURST         = 'M'
              NCURR         = 'IDR'
              VCURR         = ITRFQ-WAERS
            IMPORTING
              EXCHR         = V_KURS
            EXCEPTIONS
              NO_RATE_FOUND = 1
              OTHERS        = 2.

          ITRFQ-NETPR2 = ITRFQ-NETPR * V_KURS / ITRFQ-PEINH.
          ITRFQ-NETPR3 = ITRFQ-NETPR / ITRFQ-PEINH.

        ENDIF.

        IF ITRFQ-NETPR2 > ZMAX.
          ZMAX = ITRFQ-NETPR2.
        ENDIF.

        MODIFY ITRFQ TRANSPORTING NETPR NETPR2 NETPR3 WHERE EBELN = ITRFQ-EBELN AND EBELP = ITRFQ-EBELP.

      ENDLOOP.
      "----END MAX NETPRICE RFQ----

      LOOP AT ITRFQ WHERE BANFN = ITAB-BANFN AND BNFPO = ITAB-BNFPO.
        CLEAR ITAB2.
        MOVE-CORRESPONDING ITAB TO ITAB2.

        ITAB2-ZRFQNUM = ITRFQ-EBELN.
        ITAB2-ZRFQITEM = ITRFQ-EBELP.
        ITAB2-ZNETPR = ITRFQ-NETPR3.
        ITAB2-ZNETPR2 = ITRFQ-NETPR2.
        ITAB2-ZWAERS = ITRFQ-WAERS.

        "SAVING RELATIVE (MAX Price RFQ - Net Price PO)(IDR & USD)
*        ITAB2-ZSAVINGRELATIVE = ZMAX - ITAB2-NETPR2. "disable, use new formula (17-5-2017)
        ITAB2-ZSAVINGRELATIVE = ( ZMAX - ITAB2-NETPR2 ) * ITAB2-QTYPO. "ADD NEW FORMULA (MAX Price RFQ - Net Price PO)* PO Qty --(add 17-5-2017)
        ITAB2-ZSAVINGRELATIVE2 = ITAB2-ZSAVINGRELATIVE.
        WRITE ITAB2-ZSAVINGRELATIVE2 TO ITAB2-ZSAVINGRELATIVE3.
        WRITE ITAB2-ZSAVINGRELATIVE2 TO ITAB2-ZSAVINGRELATIVEIDR3.
        CLEAR V_KURS.
        CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
          EXPORTING
            DATUM         = ITAB2-AEDAT
            KURST         = 'M'
            NCURR         = 'IDR'
            VCURR         = 'USD'
          IMPORTING
            EXCHR         = V_KURS
          EXCEPTIONS
            NO_RATE_FOUND = 1
            OTHERS        = 2.

        IF SY-SUBRC <> 0.
*           Implement suitable error handling here
        ENDIF.
        ITAB2-ZSAVINGRELATIVEUSD2 = ITAB2-ZSAVINGRELATIVE * 1 / V_KURS.
        WRITE ITAB2-ZSAVINGRELATIVEUSD2 TO ITAB2-ZSAVINGRELATIVEUSD3.

        ITAB2-ZAEDAT = ITRFQ-AEDAT.
        ITAB2-ZKTMNG = ITRFQ-KTMNG.
        ITAB2-ZRFQDESCR = ITRFQ-TXZ01.
        ITAB2-QTYRFQ = ITAB2-ZKTMNG.

        CLEAR: ZCHAR, ZCHAR2.
        ZCHAR = ITRFQ-PEINH.
        CONDENSE ZCHAR.
        CALL FUNCTION 'CONVERSION_EXIT_CUNIT_OUTPUT'
          EXPORTING
            INPUT    = ITAB-MEINS
            LANGUAGE = SY-LANGU
          IMPORTING
            OUTPUT   = ZCHAR2.

        CONDENSE ZCHAR2.
        CONCATENATE ZCHAR ZCHAR2 INTO ITAB2-ZPEINH SEPARATED BY SPACE.

        APPEND ITAB2.
      ENDLOOP.

    ELSE.

      MOVE-CORRESPONDING ITAB TO ITAB2.
      APPEND ITAB2.

    ENDIF.
  ENDLOOP.
  "----PERULANGAN PER RFQ----

*-add netprice in USD by Rey
  LOOP AT ITAB2.
    IF ITAB2-WAERS EQ 'USD'.
      ITAB2-NETPRUSD  = ITAB2-NETPR3.

    ELSEIF ITAB2-WAERS EQ 'IDR'.
      CLEAR V_KURS.
      CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
        EXPORTING
          DATUM         = ITAB2-AEDAT
          KURST         = 'M'
          NCURR         = 'IDR'
          VCURR         = 'USD'
        IMPORTING
          EXCHR         = V_KURS
        EXCEPTIONS
          NO_RATE_FOUND = 1
          OTHERS        = 2.
      IF SY-SUBRC <> 0.
* Implement suitable error handling here
      ENDIF.

      ITAB2-NETPRUSD = ITAB2-NETPR3 * 1 / V_KURS.

    ELSE.
      CLEAR V_KURS.
      CALL FUNCTION 'RKC_SINGLE_EXCHANGE_RATE_GET'
        EXPORTING
          DATUM         = ITAB2-AEDAT
          KURST         = 'M'
          NCURR         = 'USD'
          VCURR         = ITAB2-WAERS
        IMPORTING
          EXCHR         = V_KURS
        EXCEPTIONS
          NO_RATE_FOUND = 1
          OTHERS        = 2.
      IF SY-SUBRC <> 0.
* Implement suitable error handling here
      ENDIF.

      ITAB2-NETPRUSD = ITAB2-NETPR3 * V_KURS.


    ENDIF.

    MODIFY ITAB2.

  ENDLOOP.

ENDFORM.                    " GET_DATA

*&---------------------------------------------------------------------*
*&      Form  DISPLAY_DATA
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
FORM DISPLAY_DATA.
  DATA: REPID TYPE SY-REPID.
  REPID = SY-REPID.

  LS_FIELDCAT-FIX_COLUMN = 'X'. LS_FIELDCAT-FIELDNAME = 'BUKRS'. LS_FIELDCAT-SELTEXT_M = 'Company Code'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.  "Add 27/12/2017 by Jarwo
  LS_FIELDCAT-FIX_COLUMN = 'X'. LS_FIELDCAT-FIELDNAME = 'EBELN'. LS_FIELDCAT-SELTEXT_M = 'PO NUMBER'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIX_COLUMN = 'X'. LS_FIELDCAT-FIELDNAME = 'EBELP'. LS_FIELDCAT-SELTEXT_M = 'PO ITEM'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
*  LS_FIELDCAT-FIELDNAME = 'BSART'. LS_FIELDCAT-SELTEXT_M = 'PO TYPE'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIX_COLUMN = 'X'. LS_FIELDCAT-FIELDNAME = 'BATXT'. LS_FIELDCAT-SELTEXT_M = 'PO TYPE'. LS_FIELDCAT-OUTPUTLEN = '40'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIX_COLUMN = 'X'. LS_FIELDCAT-FIELDNAME = 'NAME1'. LS_FIELDCAT-SELTEXT_M = 'VENDOR'. LS_FIELDCAT-OUTPUTLEN = '40'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIELDNAME = 'EKGRP'. LS_FIELDCAT-SELTEXT_M = 'PURCH. GROUP'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIELDNAME = 'AEDAT'. LS_FIELDCAT-SELTEXT_M = 'PO DATE'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIELDNAME = 'QTYPO'. LS_FIELDCAT-SELTEXT_M = 'PO QTY'. LS_FIELDCAT-OUTPUTLEN = '10'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIELDNAME = 'NETPR3'. LS_FIELDCAT-SELTEXT_M = 'NET PRICE'. LS_FIELDCAT-OUTPUTLEN = '20'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
  LS_FIELDCAT-FIELDNAME = 'PEINHX'. LS_FIELDCAT-SELTEXT_M = 'UNIT/UOM PO'. LS_FIELDCAT-OUTPUTLEN = '20'. APPEND LS_FIELDCAT TO IT_FIELDCAT. CLEAR LS_FIELDCAT.
