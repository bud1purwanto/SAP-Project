METHOD IF_EX_SLS_ITEM_SCR_CUS~ACTIVATE_TAB_PAGE.
  IF SY-TCODE EQ 'VA01' OR SY-TCODE EQ 'VA02' OR SY-TCODE EQ 'VA03'.
    DATA: LS_HEAD TYPE LINE OF SALES_CUST_TAB_PAGE_T.
    LS_HEAD-ITEM_CAPTION = 'Additional Screen'.
    LS_HEAD-ITEM_PROGRAM = 'ZBADI_ADD_TAB_SO'.
    LS_HEAD-ITEM_DYNPRO = '4003'.
    APPEND LS_HEAD TO CT_CUS_ITEM_TAB.
  ELSE.
    EXIT.
  ENDIF.

  DATA: ZDATE TYPE VBAP-ZDATE,
        ZLINE TYPE VBAP-ZLINE,
        VDATE TYPE VBAP-ZDATE,
        VLINE TYPE VBAP-ZLINE,
        ZSO   TYPE VBAP-VBELN,
        ZITEM TYPE VBAP-POSNR,
        VBUKRS TYPE ZMAPPG-BUKRS,
        ZGRUP TYPE ZMAPPG-GRPPRD3,
        ZSBU  TYPE ZMAPPG-SBU,
        ZMATKL TYPE T025T-BKBEZ.

  TYPES: BEGIN OF T_TAB,
         VBELN        TYPE VBAP-VBELN,            "SO Number
         POSNR        TYPE VBAP-POSNR,            "SO Item
         ZDATE TYPE VBAP-ZDATE,
         ZLINE TYPE VBAP-ZLINE,
         END OF T_TAB.

  DATA: ITAB TYPE STANDARD TABLE OF T_TAB.
  DATA: WA_TAB LIKE LINE OF ITAB.

  IF SY-TCODE EQ 'VA01'.
    SET PARAMETER ID 'ZDATE' FIELD SPACE.
    SET PARAMETER ID 'ZLINE' FIELD SPACE.
    SET PARAMETER ID 'ZGRUP'  FIELD SPACE.
    SET PARAMETER ID 'ZSBU'   FIELD SPACE.
    SET PARAMETER ID 'ZMATKL' FIELD SPACE.
  ENDIF.

  ZSO = IS_VBAP-VBELN.
  ZITEM = IS_VBAP-POSNR.
  SET PARAMETER ID: 'ZSO' FIELD ZSO.
  SET PARAMETER ID: 'ZITEM' FIELD ZITEM.

  GET PARAMETER ID: 'ZDATE' FIELD ZDATE.
  GET PARAMETER ID: 'ZLINE' FIELD ZLINE.

  IMPORT ITAB TO ITAB FROM MEMORY ID 'ZBADI_ADD_TAB_SO'.

  "DATE
  SELECT SINGLE ZDATE FROM VBAP INTO VDATE WHERE VBELN = IS_VBAP-VBELN AND POSNR = IS_VBAP-POSNR.
  IF VDATE IS NOT INITIAL.
    ZDATE = VDATE.
    SET PARAMETER ID: 'ZDATE' FIELD ZDATE.
  ELSE.
    READ TABLE ITAB INTO WA_TAB WITH KEY VBELN = IS_VBAP-VBELN POSNR = IS_VBAP-POSNR.
    IF SY-SUBRC EQ 0.
      IF WA_TAB-ZDATE IS NOT INITIAL.
        ZDATE = WA_TAB-ZDATE.
        SET PARAMETER ID: 'ZDATE' FIELD ZDATE.
      ELSE.
        SET PARAMETER ID 'ZDATE' FIELD SPACE.
      ENDIF.
    ELSE.
      SET PARAMETER ID 'ZDATE' FIELD SPACE.
    ENDIF.
  ENDIF.

  "LINE
  SELECT SINGLE ZLINE FROM VBAP INTO VLINE WHERE VBELN = IS_VBAP-VBELN AND POSNR = IS_VBAP-POSNR.
  IF VLINE IS NOT INITIAL.
    ZLINE = VLINE.
    SET PARAMETER ID: 'ZLINE' FIELD ZLINE.
  ELSE.
    READ TABLE ITAB INTO WA_TAB WITH KEY VBELN = IS_VBAP-VBELN POSNR = IS_VBAP-POSNR.
    IF SY-SUBRC EQ 0.
      IF WA_TAB-ZLINE IS NOT INITIAL.
        ZLINE = WA_TAB-ZLINE.
        SET PARAMETER ID: 'ZLINE' FIELD ZLINE.
      ELSE.
        SET PARAMETER ID 'ZLINE' FIELD SPACE.
      ENDIF.
    ELSE.
      SET PARAMETER ID 'ZLINE' FIELD SPACE.
    ENDIF.
  ENDIF.

  "Group Line
*  SELECT SINGLE ZPROD1 INTO ZMATKL FROM ZMAP_LINEBR WHERE ZLINE EQ ZLINE.
*  IF SY-SUBRC EQ 0.
*    SET PARAMETER ID 'ZMATKL' FIELD ZMATKL.
*  ENDIF.

  "SBU
  SELECT SINGLE BUKRS INTO VBUKRS FROM T001K WHERE BWKEY EQ IS_VBAP-WERKS.
  IF SY-SUBRC EQ 0.
    SELECT SINGLE GRPPRD3 SBU INTO (ZGRUP, ZSBU) FROM ZMAPPG WHERE MATNR EQ IS_VBAP-MATNR AND BUKRS EQ VBUKRS.
    IF SY-SUBRC EQ 0.
      SET PARAMETER ID 'ZGRUP' FIELD ZGRUP.
      SET PARAMETER ID 'ZSBU' FIELD ZSBU.
    ENDIF.
  ENDIF.
ENDMETHOD.
