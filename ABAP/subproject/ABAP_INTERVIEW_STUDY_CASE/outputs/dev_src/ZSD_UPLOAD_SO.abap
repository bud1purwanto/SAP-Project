*----------------------------------------------------------------------*
FORM CREATE_SO .
  IT_DETAIL[] = ITAB[].
  IT_DETAIL_CHANGE[] = ITAB[].
  SORT ITAB BY ZPO.
  DELETE ADJACENT DUPLICATES FROM ITAB COMPARING ZPO.
  "LOOP FOR HEADER
  LOOP AT ITAB INTO WA_ITAB.
    CLEAR : T_QUOTE_HEADER_IN, TAB_QUOTE_PARTNR, RETURN, RETURN2, TAB_QUOT_COND.
    REFRESH : RETURN, RETURN2.

*   "START HEADER
    T_QUOTE_HEADER_IN-SALES_ORG  = WA_ITAB-ZSLSORG.
    T_QUOTE_HEADER_IN-DIVISION   = WA_ITAB-ZDIVISION.
    T_QUOTE_HEADER_IN-DISTR_CHAN = WA_ITAB-ZDISTCHANEL.
    T_QUOTE_HEADER_IN-PURCH_DATE = SY-DATUM.
    T_QUOTE_HEADER_IN-DOC_TYPE   = WA_ITAB-ZORDTYPE.
    T_QUOTE_HEADER_IN-PURCH_NO_C = WA_ITAB-ZPO.
    T_QUOTE_HEADER_IN-CURRENCY = WA_ITAB-ZCURR.
    T_QUOTE_HEADER_IN-ORD_REASON = WA_ITAB-ZORDREASON.
    PERFORM CHANGEDATE USING WA_ITAB-ZDLVDATE CHANGING  T_QUOTE_HEADER_IN-REQ_DATE_H.
    PERFORM CHANGEDATE USING WA_ITAB-ZPODATE CHANGING T_QUOTE_HEADER_IN-QT_VALID_T.
    APPEND T_QUOTE_HEADER_IN.
*   "END HEADER

*   "START PARTNER
    WA_QUOTE_PARTNR-PARTN_ROLE = 'AG'.
    WA_QUOTE_PARTNR-PARTN_NUMB = WA_ITAB-ZCUST.
    APPEND WA_QUOTE_PARTNR TO TAB_QUOTE_PARTNR.

    WA_QUOTE_PARTNR-PARTN_ROLE = 'WE'.
    WA_QUOTE_PARTNR-PARTN_NUMB = WA_ITAB-ZSHIPH.
    APPEND WA_QUOTE_PARTNR TO TAB_QUOTE_PARTNR.
*   "END PARTNER

    CLEAR : V_KALKS, V_WAERK, V_KALVG,V_KARTV, V_CONFIG, V_MATNR2, TAB_ITEMS, TAB_QUOTE_REF, TAB_QUOTE_REFINST, TAB_QUOTE_INST, TAB_QUOTE_VALUE, RETURN, TAB_ITEMS_SCHED,TAB_SCHEDULES_INX.
    SORT IT_DETAIL BY ZPO.
    DELETE ADJACENT DUPLICATES FROM IT_DETAIL COMPARING ZPO ZSOITEM.
    "LOOP FOR ITEM
    LOOP AT IT_DETAIL INTO WA_DETAIL WHERE ZPO = WA_ITAB-ZPO.

      V_CONFIG = WA_DETAIL-ZSOITEM.

      CONCATENATE WA_DETAIL-ZTYPE '-' WA_DETAIL-ZTHICK INTO V_ATWTB.

      SELECT CAWN~ATWRT
        INTO V_ATWTB
        FROM CAWN JOIN CAWNT ON CAWN~ATINN = CAWNT~ATINN AND CAWN~ATZHL = CAWNT~ATZHL
        WHERE CAWN~ATINN EQ '0000000811' AND CAWNT~ATWTB = V_ATWTB.
      ENDSELECT.

      IF WA_DETAIL-ZINOUT EQ 'I'.
        CONCATENATE 'SR' V_ATWTB 'I' INTO V_MATNR2.
        CONDENSE V_MATNR2 NO-GAPS.
      ELSEIF WA_DETAIL-ZINOUT EQ 'X'.
        CONCATENATE 'SR' V_ATWTB 'X' INTO V_MATNR2.
        CONDENSE V_MATNR2 NO-GAPS.
      ELSEIF WA_DETAIL-ZINOUT EQ 'O'.
        CONCATENATE 'SR' V_ATWTB 'O' INTO V_MATNR2.
        CONDENSE V_MATNR2 NO-GAPS.
      ELSEIF WA_DETAIL-ZINOUT EQ ''.
        V_MATNR2 = WA_DETAIL-ZTYPE.
        CONDENSE V_MATNR2 NO-GAPS.
      ENDIF.

      SELECT SINGLE MATKL INTO V_MATKL FROM MARA WHERE MATNR = V_MATNR2.
      LV_STR = V_MATKL(1).

*     "START ITEM
      "mencari item category
      SELECT SINGLE MVKE~MTPOS INTO V_MTPOS FROM MVKE
        WHERE MATNR = V_MATNR2.

      SELECT SINGLE T184~PSTYV INTO V_PSTYV FROM T184
        WHERE AUART = WA_DETAIL-ZORDTYPE AND MTPOS = V_MTPOS AND VWPOS = '' AND UEPST = ''.

      SELECT SINGLE KNVV~KALKS INTO V_KALKS FROM KNVV WHERE KUNNR = WA_DETAIL-ZCUST AND VKORG = WA_DETAIL-ZSLSORG.
      SELECT SINGLE TVAK~KALVG INTO V_KALVG FROM TVAK WHERE AUART = WA_DETAIL-ZORDTYPE.
      SELECT SINGLE T683V~KARTV INTO V_KARTV FROM T683V WHERE VKORG = WA_DETAIL-ZSLSORG AND VTWEG = WA_DETAIL-ZDISTCHANEL AND SPART = WA_DETAIL-ZDIVISION AND KALVG = V_KALVG AND KALKS = V_KALKS.

      IF V_KALVG EQ 5.
        WA_ITEM-ITM_NUMBER = WA_DETAIL-ZSOITEM.
        WA_ITEM-PLANT = WA_DETAIL-ZPLANT.
        WA_ITEM-MATERIAL  = V_MATNR2.
        WA_ITEM-SHIP_POINT = WA_DETAIL-ZSHPPOINT.
        WA_ITEM-CUST_MAT35 = WA_DETAIL-ZCUSTMATNUM.
        WA_ITEM-SALES_UNIT = WA_DETAIL-ZUOM.
        WA_ITEM-ITEM_CATEG = V_PSTYV.
        WA_ITEM-PO_ITM_NO  = WA_DETAIL-ZPOLINE.
        WA_ITEM-TARGET_QTY = WA_DETAIL-ZNOROLL.
        WA_ITEM-TARGET_QU = WA_DETAIL-ZUOM.
        APPEND WA_ITEM TO TAB_ITEMS.
        CLEAR WA_ITEM.
      ELSE.
        WA_ITEM-ITM_NUMBER = WA_DETAIL-ZSOITEM.
        WA_ITEM-PLANT = WA_DETAIL-ZPLANT.
        WA_ITEM-MATERIAL  = V_MATNR2.
        WA_ITEM-SHIP_POINT = WA_DETAIL-ZSHPPOINT.
        WA_ITEM-CUST_MAT35 = WA_DETAIL-ZCUSTMATNUM.
        WA_ITEM-SALES_UNIT = WA_DETAIL-ZUOM.
        WA_ITEM-ITEM_CATEG = V_PSTYV.
        WA_ITEM-PO_ITM_NO  = WA_DETAIL-ZPOLINE.
        APPEND WA_ITEM TO TAB_ITEMS.
        CLEAR WA_ITEM.
      ENDIF.
*     "END ITEM

*     "START CONFIGURATION
      WA_QUOTE_REF-POSEX     = WA_DETAIL-ZPOLINE.
      WA_QUOTE_REF-ROOT_ID   = INST_ID.
      WA_QUOTE_REF-CONFIG_ID = V_CONFIG.
      APPEND WA_QUOTE_REF TO TAB_QUOTE_REF.
      CLEAR  WA_QUOTE_REF.
*     "END CONFIGURATION

*     "START REFINST
      WA_QUOTE_REFINST-POSEX     = WA_DETAIL-ZPOLINE.
      WA_QUOTE_REFINST-CONFIG_ID = V_CONFIG.
      WA_QUOTE_REFINST-INST_ID   = INST_ID.
      APPEND WA_QUOTE_REFINST TO TAB_QUOTE_REFINST.
      CLEAR WA_QUOTE_REFINST.
*     "END REFINST

*      "START ATTRIBUTE VALUES
      IF LV_STR EQ '3' AND V_KALVG NE 5.
*        IF WA_ITAB-ZINOUT EQ 'I' OR WA_ITAB-ZINOUT EQ 'O'.
        IF WA_DETAIL-ZTYPE NE ''.
          PERFORM FILL_CHAR USING 'ZZTYPE' WA_DETAIL-ZTYPE.
        ENDIF.
*        ENDIF.

        IF WA_DETAIL-ZLENGTH NE ''.
          IF WA_DETAIL-ZUOM CS 'PAK'.
            PERFORM FILL_CHAR USING 'ZZLENGTHSHT' WA_DETAIL-ZLENGTH.
          ELSE.
            PERFORM FILL_CHAR USING 'ZZLENGTH' WA_DETAIL-ZLENGTH.
          ENDIF.
        ENDIF.

        IF WA_DETAIL-ZWIDTH NE ''.
          PERFORM FILL_CHAR USING 'ZZWIDTH' WA_DETAIL-ZWIDTH.
        ENDIF.

        IF WA_DETAIL-ZEXTLENGTH NE ''.
          PERFORM FILL_CHAR USING 'ZZEXLENGTH' WA_DETAIL-ZEXTLENGTH.
        ENDIF.

        "TYPE LABEL
        IF WA_DETAIL-ZTYPLBL NE ''.
          PERFORM FILL_CHAR USING 'ZZLABEL' WA_DETAIL-ZTYPLBL.
        ENDIF.

        "KODE PACK
        IF WA_DETAIL-ZKDPACK NE ''.
          PERFORM FILL_CHAR USING 'ZZPACKINGCODE' WA_DETAIL-ZKDPACK.
        ENDIF.

        IF WA_DETAIL-ZUOM CS 'ROL' OR
               WA_DETAIL-ZUOM CS 'LB' OR
               WA_DETAIL-ZUOM CS 'M2' OR
               WA_DETAIL-ZUOM CS 'KG'.

          IF WA_DETAIL-ZNOROLL NE ''.
            PERFORM FILL_CHAR USING 'ZZNUMBEROFROLL' WA_DETAIL-ZNOROLL.
          ENDIF.
        ENDIF.

        IF WA_DETAIL-ZCORE NE ''.
          PERFORM FILL_CHAR USING 'ZZCORE' WA_DETAIL-ZCORE.
        ENDIF.

        "ALIAS
        "Changed by Dila <15.05.2025> for Subcont Laminator #2 #3
        IF WA_DETAIL-ZALIAS NE ''.
          IF WA_DETAIL-ZORDTYPE = 'ZDSS'.
            SELECT SINGLE TEXT1 INTO V_ALIAS1
              FROM ZMAP_TYPE
              WHERE TCODE  EQ SY-TCODE
              AND TYPE   EQ 'DEFAULT VALUE'
              AND VALUE  EQ 'ZZALIAS'.

            CONCATENATE V_ALIAS1 WA_DETAIL-ZALIAS INTO WA_DETAIL-ZALIAS SEPARATED BY SPACE.

            CONDENSE WA_DETAIL-ZALIAS.

            PERFORM FILL_CHAR USING 'ZZALIAS' WA_DETAIL-ZALIAS.
          ELSE.
            PERFORM FILL_CHAR USING 'ZZALIAS' WA_DETAIL-ZALIAS.
          ENDIF.
        ELSE.
          IF WA_DETAIL-ZORDTYPE = 'ZDSS'.

            SELECT SINGLE TEXT1 INTO V_ALIAS1
              FROM ZMAP_TYPE
              WHERE TCODE  EQ SY-TCODE
              AND TYPE   EQ 'DEFAULT VALUE'
              AND VALUE  EQ 'ZZALIAS'.

            CONCATENATE WA_DETAIL-ZTYPE '-' WA_DETAIL-ZTHICK INTO V_ATWTB.

            CONCATENATE V_ALIAS1 WA_DETAIL-ZALIAS V_ATWTB INTO WA_DETAIL-ZALIAS SEPARATED BY SPACE.

            CONDENSE WA_DETAIL-ZALIAS.

            PERFORM FILL_CHAR USING 'ZZALIAS' WA_DETAIL-ZALIAS.
          ENDIF.
        ENDIF.
        "End Changed

        "Added by Dila <15.05.2025> for Subcont Laminator #2 #3
        "NoCustomer
        IF WA_DETAIL-ZCUST NE ''.
          IF WA_DETAIL-ZORDTYPE = 'ZDSS'.
            PERFORM FILL_CHAR USING 'ZZCUSTOMER' WA_DETAIL-ZCUST.
          ENDIF.
        ENDIF.

        "PO Customer
        IF WA_DETAIL-ZPO NE ''.
          IF WA_DETAIL-ZORDTYPE = 'ZDSS'.
            PERFORM FILL_CHAR USING 'ZZPOCUSTOMER' WA_DETAIL-ZPO.
          ENDIF.
        ENDIF.
*
*        "SKU
        IF WA_DETAIL-ZSKU NE ''.
          IF WA_DETAIL-ZORDTYPE = 'ZDSS'.
            PERFORM FILL_CHAR USING 'ZZSKU' WA_DETAIL-ZSKU.
          ENDIF.
        ENDIF.
        "End Added

        "specialtouch-1
        IF WA_DETAIL-ZSPECIALTOUCH1 NE ''.
          PERFORM FILL_CHAR USING 'ZZSPECIALTOUCH-1' WA_DETAIL-ZSPECIALTOUCH1.
        ENDIF.

        "specialtouch-2
        IF WA_DETAIL-ZSPECIALTOUCH2 NE ''.
          PERFORM FILL_CHAR USING 'ZZSPECIALTOUCH-2' WA_DETAIL-ZSPECIALTOUCH2.
        ENDIF.

        "specialtouch-3
        IF WA_DETAIL-ZSPECIALTOUCH3 NE ''.
          PERFORM FILL_CHAR USING 'ZZSPECIALTOUCH-3' WA_DETAIL-ZSPECIALTOUCH3.
        ENDIF.

        IF WA_DETAIL-ZTREAT NE ''.
          PERFORM FILL_CHAR USING 'ZZTREATMENT' WA_DETAIL-ZTREAT.
        ENDIF.

        IF WA_DETAIL-ZPACK NE ''.
          PERFORM FILL_CHAR USING 'ZZPACKING' WA_DETAIL-ZPACK.
        ENDIF.

        IF WA_DETAIL-ZCRITERIA NE ''.
          PERFORM FILL_CHAR USING 'ZZCRITERIA' WA_DETAIL-ZCRITERIA.
        ENDIF.
*      "END ATTRIBUTE VALUES
      ENDIF.

      "CONDITION PRICE
      IF V_KALVG = 5 AND WA_DETAIL-ZDISTCHANEL EQ '01' .
        V_UANG = WA_DETAIL-ZPRICE.
        WA_QUOT_COND-COND_TYPE   = 'ZDD0'.
        WA_QUOT_COND-ITM_NUMBER  = WA_DETAIL-ZSOITEM.
        WA_QUOT_COND-CURRENCY    = WA_DETAIL-ZCURR.
        WA_QUOT_COND-COND_VALUE  = V_UANG.
        APPEND WA_QUOT_COND TO TAB_QUOT_COND.
        CLEAR WA_QUOT_COND.

      ELSEIF V_KALVG = 5 AND WA_DETAIL-ZDISTCHANEL EQ '02' .
        V_UANG = WA_DETAIL-ZPRICE.
        WA_QUOT_COND-COND_TYPE   = 'ZED0'.
        WA_QUOT_COND-ITM_NUMBER  = WA_DETAIL-ZSOITEM.
        WA_QUOT_COND-CURRENCY    = WA_DETAIL-ZCURR.
        WA_QUOT_COND-COND_VALUE  = V_UANG.
        APPEND WA_QUOT_COND TO TAB_QUOT_COND.
        CLEAR WA_QUOT_COND.

      ELSE.
        V_UANG = WA_DETAIL-ZPRICE.
        WA_QUOT_COND-COND_TYPE   = V_KARTV.
        WA_QUOT_COND-ITM_NUMBER  = WA_DETAIL-ZSOITEM.
        WA_QUOT_COND-CURRENCY    = WA_DETAIL-ZCURR.
        WA_QUOT_COND-COND_VALUE  = V_UANG.
        APPEND WA_QUOT_COND TO TAB_QUOT_COND.
        CLEAR WA_QUOT_COND.
      ENDIF.

      IF LV_STR = 'B'.
        PERFORM CHANGEDATE USING WA_DETAIL-ZDLVDATE CHANGING WA_ITEMS_SCHED-REQ_DATE.
        ZWEIGHT = WA_DETAIL-ZNOROLL.
        WA_ITEMS_SCHED-ITM_NUMBER = WA_DETAIL-ZSOITEM.
        WA_ITEMS_SCHED-SCHED_LINE  = 1.
        WA_ITEMS_SCHED-REQ_QTY = ZWEIGHT.
        WA_ITEMS_SCHED-REQ_DATE = WA_ITEMS_SCHED-REQ_DATE.
        WA_ITEMS_SCHED-DATE_TYPE  = '1'.
        APPEND WA_ITEMS_SCHED TO TAB_ITEMS_SCHED.
        CLEAR WA_ITEMS_SCHED.

        WA_SCHEDULES_INX-ITM_NUMBER = WA_DETAIL-ZSOITEM.
        WA_SCHEDULES_INX-SCHED_LINE  = 1.
        WA_SCHEDULES_INX-UPDATEFLAG = 'I'.
        WA_SCHEDULES_INX-REQ_QTY = 'X'.
        WA_SCHEDULES_INX-REQ_DATE = 'X'.
        APPEND WA_SCHEDULES_INX TO TAB_SCHEDULES_INX.
        CLEAR WA_SCHEDULES_INX.

      ENDIF.

      IF WA_DETAIL-ZDATE IS INITIAL.
        WA_DETAIL-ZDATE = '00000000'.
      ENDIF.

      IF WA_DETAIL-ZORDTYPE EQ 'ZDOR' OR WA_DETAIL-ZORDTYPE EQ 'ZEOR' OR WA_DETAIL-ZORDTYPE EQ 'ZDKB' OR WA_DETAIL-ZORDTYPE EQ 'ZEKB' OR
         WA_DETAIL-ZORDTYPE EQ 'ZDSO' OR WA_DETAIL-ZORDTYPE EQ 'ZESO' OR WA_DETAIL-ZORDTYPE EQ 'ZINV' OR WA_DETAIL-ZORDTYPE EQ 'ZDSD' OR
         WA_DETAIL-ZORDTYPE EQ 'ZESD' OR WA_DETAIL-ZORDTYPE EQ 'ZDSS'. " Added by Dila <13.02.2025> for Laminator #2 #3
        IF WA_DETAIL-ZDATE IS INITIAL OR WA_DETAIL-ZDATE EQ '00000000'..
          PERFORM CHANGEDATE USING WA_DETAIL-ZDLVDATE CHANGING WA_DETAIL-ZDATE.
        ELSE.
          PERFORM CHANGEDATE USING WA_DETAIL-ZDATE CHANGING WA_DETAIL-ZDATE.
        ENDIF.

        CLEAR: V_BUKRS.
        IF WA_DETAIL-ZLINE IS INITIAL.
          SELECT SINGLE BUKRS INTO V_BUKRS FROM T001K WHERE BWKEY EQ WA_DETAIL-ZPLANT.
          IF SY-SUBRC EQ 0.
            SELECT SINGLE ZLINE INTO WA_DETAIL-ZLINE FROM ZMAP_PRODLINE WHERE BUKRS EQ V_BUKRS AND MATNR EQ V_MATNR2.
          ENDIF.
        ENDIF.
      ELSE.
        PERFORM CHANGEDATE USING WA_DETAIL-ZDATE CHANGING WA_DETAIL-ZDATE.
      ENDIF.

      "Extension Field
      WA_BAPE_VBAP-POSNR  = WA_DETAIL-ZSOITEM.
      WA_BAPE_VBAP-ZDATE  = WA_DETAIL-ZDATE.
      WA_BAPE_VBAP-ZLINE  = WA_DETAIL-ZLINE.
      WA_EXTENSIONIN-STRUCTURE = 'BAPE_VBAP'.
      WA_EXTENSIONIN-VALUEPART1 = WA_BAPE_VBAP.
      APPEND WA_EXTENSIONIN TO EXTENSIONIN.

      WA_BAPE_VBAPX-POSNR  = WA_DETAIL-ZSOITEM.
      WA_BAPE_VBAPX-ZDATE  = 'X'.
      WA_BAPE_VBAPX-ZLINE  = 'X'.
      WA_EXTENSIONIN-STRUCTURE = 'BAPE_VBAPX'.
      WA_EXTENSIONIN-VALUEPART1 = WA_BAPE_VBAPX.
      APPEND WA_EXTENSIONIN TO EXTENSIONIN.
    ENDLOOP.

    IF WA_DETAIL-ZPO NE ''.
      CALL FUNCTION 'SD_SALESDOCUMENT_CREATE'
        EXPORTING
          SALES_HEADER_IN      = T_QUOTE_HEADER_IN
        IMPORTING
          SALESDOCUMENT_EX     = SALESORDERNUMBER
        TABLES
          RETURN               = RETURN
          SALES_ITEMS_IN       = TAB_ITEMS
          SALES_PARTNERS       = TAB_QUOTE_PARTNR
          SALES_SCHEDULES_IN   = TAB_ITEMS_SCHED
          SALES_SCHEDULES_INX  = TAB_SCHEDULES_INX
          SALES_CONDITIONS_IN  = TAB_QUOT_COND
*         SALES_CONDITIONS_INX = IT_BAPICONDX
          SALES_CFGS_REF       = TAB_QUOTE_REF
          SALES_CFGS_INST      = TAB_QUOTE_INST
          SALES_CFGS_VALUE     = TAB_QUOTE_VALUE
          SALES_CFGS_REFINST   = TAB_QUOTE_REFINST
          EXTENSIONIN          = EXTENSIONIN.

      PERFORM COMMIT.
      IF LV_STR NE 'B'.
        PERFORM CHANGE_SO.
      ENDIF.
    ENDIF.

    "Added by Akbar for insert PI No 21.06.2019
    READ TABLE RETURN WITH KEY TYPE = 'E'.
    IF SY-SUBRC NE 0.
      IF WA_ITAB-ZPINO IS NOT INITIAL.
        PERFORM INSERT_PI_NO USING SALESORDERNUMBER.
      ENDIF.
    ENDIF.
    "Added by Akbar for insert PI No 21.06.2019

    PERFORM ALV_ERROR.
    CLEAR : WA_DETAIL.
  ENDLOOP.
*  PERFORM CHANGE_SO.
  PERFORM WRITE_ERROR.
ENDFORM.                    " CREATE_SO

*&---------------------------------------------------------------------*
*&      Form  CHANGE_SO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM CHANGE_SO.
*    LOOP AT IT_DETAIL_CHANGE INTO WA_DETAIL_CHANGE WHERE ZPO = WA_ITAB-ZPO.
  SORT IT_DETAIL_CHANGE BY ZPO ZSCHLINE.
  LOOP AT IT_DETAIL_CHANGE INTO WA_DETAIL_CHANGE WHERE ZPO = WA_ITAB-ZPO.
    CLEAR : ZCUOBJ, ZEDATU, IT_TEMP2, V_KALKS, V_KALVG,V_KARTV, ZEDATU, ZETENR, ZZWEIGTHTOT, ZJMLROLL,
    TAB_ITEMS_SCHED,TAB_SCHEDULES_INX, ZWEIGHT, ZORDERQTY, ZSATUAN, ZTOTALM2, ZZCONV, V_KALKS, V_KALVG, V_KARTV.

    REFRESH : IT_TEMP2.

    SELECT SINGLE VBAP~CUOBJ
          INTO V_CUOBJ
          FROM VBAP
          WHERE VBAP~VBELN = SALESORDERNUMBER
            AND VBAP~POSNR = WA_DETAIL_CHANGE-ZSOITEM.

    ZCUOBJ =  V_CUOBJ.

    CALL FUNCTION 'VC_I_GET_CONFIGURATION'
      EXPORTING
        INSTANCE            = ZCUOBJ
      TABLES
        CONFIGURATION       = IT_TEMP2
      EXCEPTIONS
        INSTANCE_NOT_FOUND  = 1
        INTERNAL_ERROR      = 2
        NO_CLASS_ALLOCATION = 3
        INSTANCE_NOT_VALID  = 4
        OTHERS              = 5.

    READ TABLE IT_TEMP2 WITH KEY ATNAM = 'ZZCONVERSIONROLLKG'.
    SPLIT IT_TEMP2-ATWTB AT SPACE INTO ZZCONV ZSATUAN.
    REPLACE ALL OCCURRENCES OF ',' IN ZZCONV WITH SPACE.

    ZJMLROLL = WA_DETAIL_CHANGE-ZPECAHSCH.
    ZJMLROLL_M2 = WA_DETAIL_CHANGE-ZNOROLL.
    CASE WA_DETAIL_CHANGE-ZUOM.
      WHEN 'KG'.
        ZZWEIGTHTOT = ZJMLROLL * ZZCONV.
      WHEN 'ROL'.
        ZZWEIGTHTOT = ZJMLROLL.
      WHEN 'M2'.
        READ TABLE IT_TEMP2 WITH KEY ATNAM = 'ZZTOTALM2'.
        SPLIT IT_TEMP2-ATWTB AT SPACE INTO ZTOTALM2 ZSATUAN.
        REPLACE ALL OCCURRENCES OF ',' IN ZTOTALM2 WITH SPACE.
        ZTEMP = ZTOTALM2.
        CALL FUNCTION 'ROUND'
          EXPORTING
            DECIMALS = 3
            INPUT    = ZTEMP
            SIGN     = '+'
          IMPORTING
            OUTPUT   = ZWEIGHT.
        ZZWEIGTHTOT = ( ZWEIGHT / ZJMLROLL_M2 ) * ZJMLROLL.
      WHEN 'LB'.
        READ TABLE IT_TEMP2 WITH KEY ATNAM = 'ZZORDERQTY'.
        SPLIT IT_TEMP2-ATWTB AT SPACE INTO ZORDERQTY ZSATUAN.
        ZZWEIGTHTOT = ZORDERQTY * ZJMLROLL.
*    WHEN OTHERS.
*      ZWEIGHT = XVBAP-KWMENG.
    ENDCASE.

    PERFORM CHANGEDATE USING WA_DETAIL_CHANGE-ZDLVDATE CHANGING WA_ITEMS_SCHED-REQ_DATE.

    WA_ITEMS_SCHED-ITM_NUMBER = WA_DETAIL_CHANGE-ZSOITEM.
    WA_ITEMS_SCHED-SCHED_LINE  = WA_DETAIL_CHANGE-ZSCHLINE.
    WA_ITEMS_SCHED-REQ_QTY = ZZWEIGTHTOT.
    WA_ITEMS_SCHED-REQ_DATE = WA_ITEMS_SCHED-REQ_DATE.
    WA_ITEMS_SCHED-DATE_TYPE  = '1'.
    APPEND WA_ITEMS_SCHED TO TAB_ITEMS_SCHED.
    CLEAR WA_ITEMS_SCHED.

    WA_SCHEDULES_INX-ITM_NUMBER = WA_DETAIL_CHANGE-ZSOITEM.
    WA_SCHEDULES_INX-SCHED_LINE  = WA_DETAIL_CHANGE-ZSCHLINE.
    WA_SCHEDULES_INX-UPDATEFLAG = 'I'.
    WA_SCHEDULES_INX-REQ_QTY = 'X'.
    WA_SCHEDULES_INX-REQ_DATE = 'X'.
    APPEND WA_SCHEDULES_INX TO TAB_SCHEDULES_INX.
    CLEAR WA_SCHEDULES_INX.

    PERFORM UPLOAD_CHANGE.
    CLEAR: WA_DETAIL_CHANGE.
*    REFRESH WA_DETAIL_CHANGE.
  ENDLOOP.
*  PERFORM UPLOAD_CHANGE.
*  CLEAR: IT_DETAIL_CHANGE, WA_DETAIL_CHANGE.
ENDFORM.                    " CHANGE_SO
*&---------------------------------------------------------------------*
*&      Form  UPLOAD_CHANGE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM UPLOAD_CHANGE.
  REFRESH : IT_BAPISDH1X, IT_RETURN.

  IT_BAPISDH1X-UPDATEFLAG = 'U'.
  COLLECT IT_BAPISDH1X.

  CALL FUNCTION 'BAPI_SALESORDER_CHANGE'
    EXPORTING
      SALESDOCUMENT    = SALESORDERNUMBER
      ORDER_HEADER_INX = IT_BAPISDH1X
    TABLES
      RETURN           = IT_RETURN
*     CONDITIONS_IN    = TAB_QUOT_COND
*     CONDITIONS_INX   = IT_BAPICONDX
*     ORDER_ITEM_IN    = TAB_ITEMS
*     ORDER_ITEM_INX   = TAB_ITEMX
      SCHEDULE_LINESX  = TAB_SCHEDULES_INX
      SCHEDULE_LINES   = TAB_ITEMS_SCHED.
  PERFORM COMMIT.
ENDFORM.                    " UPLOAD_CHANGE

