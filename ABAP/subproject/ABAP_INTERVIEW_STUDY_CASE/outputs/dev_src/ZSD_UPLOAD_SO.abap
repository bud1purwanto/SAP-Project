FORM CHECK_DATA .

  "Added by Akbar for insert PI No 21.06.2019
  READ TABLE ITAB WITH KEY ZORDTYPE = 'ZEOR'.
  IF SY-SUBRC NE 0.
    READ TABLE ITAB WITH KEY ZPINO = ''.
    IF SY-SUBRC EQ 4.
      MESSAGE 'PI Number is only used for Export Sales Order.' TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.
  ENDIF.
  "Added by Akbar for insert PI No 21.06.2019

  " Added by Dila <15.05.2025> Subcont Laminator #2 #3
  READ TABLE ITAB WITH KEY ZORDTYPE = 'ZDSS'.
  IF SY-SUBRC = 0.
    READ TABLE ITAB WITH KEY ZSKU = ''.
    IF SY-SUBRC = 0.
      MESSAGE 'Please input SKU Number.' TYPE 'I'.
      LEAVE LIST-PROCESSING.
    ENDIF.
  ENDIF.
  " End Added

  IT_CEK_HEADER[] = ITAB[].
  IT_CEK_HEADER_DETAIL[] = ITAB[].

  IT_CEK_SCH[] = ITAB[].
  IT_CEK_SCH_DETAIL[] = ITAB[].
  LOOP AT ITAB INTO WA_ITAB.

    IF WA_ITAB-ZORDTYPE EQ ''.
*      WRITE:/ 'Masukkan Order Type', WA_ITAB-ZPO.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Order Type'.
    ENDIF.

    IF WA_ITAB-ZSLSORG EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Sales Organisation'.
    ENDIF.

    IF WA_ITAB-ZDISTCHANEL EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Dist. Channel'.
    ENDIF.

    IF WA_ITAB-ZDIVISION EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Division'.
    ENDIF.

    IF WA_ITAB-ZPO EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan PO Number'.
    ENDIF.

    IF WA_ITAB-ZPODATE EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Tanggal PO'.
    ENDIF.

    PERFORM CHANGEDATE USING WA_ITAB-ZPODATE CHANGING PODATECHECK.
    IF PODATECHECK LT SY-DATUM.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Cek Tanggal PO'.
    ENDIF.

    IF WA_ITAB-ZPOLINE EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan PO Line'.
    ENDIF.

    IF WA_ITAB-ZSOITEM EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan SO Item'.
    ENDIF.

    IF WA_ITAB-ZPLANT EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Plant'.
    ENDIF.

    IF WA_ITAB-ZSHPPOINT EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Shipping Point'.
    ENDIF.

    IF WA_ITAB-ZCUST EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Sold to Party'.
    ENDIF.

    IF WA_ITAB-ZSHIPH EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Ship to Party'.
    ENDIF.

    SELECT SINGLE KNA1~KUNNR INTO V_KUNNR_SOLD FROM KNA1 WHERE KNA1~KUNNR = WA_ITAB-ZCUST.
    IF SY-SUBRC > 0.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Sold to Party does not exist'.
    ELSE.
      SELECT SINGLE KNVV~WAERS INTO V_WAERS FROM KNVV WHERE KNVV~KUNNR = V_KUNNR_SOLD.
      IF SY-SUBRC > 0.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Invalid Currency'.
      ENDIF.
    ENDIF.

    IF WA_ITAB-ZSHIPH EQ ''.
      WA_ITAB-ZSHIPH = WA_ITAB-ZCUST.
    ENDIF.

    SELECT SINGLE KNA1~KUNNR INTO V_KUNNR_SHIP FROM KNA1 WHERE KNA1~KUNNR = WA_ITAB-ZSHIPH.
    IF SY-SUBRC > 0.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Ship to Party does not exist'.
    ENDIF.

    IF WA_ITAB-ZTYPE EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Tipe Film'.
    ENDIF.

    CONCATENATE WA_ITAB-ZTYPE '-' WA_ITAB-ZTHICK INTO V_ATWTB.
    SELECT CAWN~ATWRT
      INTO V_ATWTB
      FROM CAWN JOIN CAWNT ON CAWN~ATINN = CAWNT~ATINN AND CAWN~ATZHL = CAWNT~ATZHL
      WHERE CAWN~ATINN EQ '0000000811' AND CAWNT~ATWTB = V_ATWTB.
    ENDSELECT.

    IF WA_ITAB-ZINOUT EQ 'I'.
      CONCATENATE 'SR' V_ATWTB 'I' INTO V_MATNR.
      CONDENSE V_MATNR NO-GAPS.
    ELSEIF WA_ITAB-ZINOUT EQ 'X'.
      CONCATENATE 'SR' V_ATWTB 'X' INTO V_MATNR.
      CONDENSE V_MATNR NO-GAPS.
    ELSEIF WA_ITAB-ZINOUT EQ 'O'.
      CONCATENATE 'SR' V_ATWTB 'O' INTO V_MATNR.
      CONDENSE V_MATNR NO-GAPS.
    ELSEIF WA_ITAB-ZINOUT NE 'I' AND WA_ITAB-ZINOUT NE 'X'.
      V_MATNR = WA_ITAB-ZTYPE.
      CONDENSE V_MATNR NO-GAPS.
    ENDIF.

*    IF SY-SUBRC <> 0 AND WA_ITAB-ZINOUT EQ 'I'.
*      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Material does not exist'.
*    ENDIF.

    SELECT SINGLE MATKL INTO V_MATKL FROM MARA WHERE MATNR = V_MATNR.
    LV_STR = V_MATKL(1).

    IF WA_ITAB-ZUOM EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Sales Unit'.
    ENDIF.

    "pengecekan Finish Good atau Recycle
    IF LV_STR EQ '3'.

      IF WA_ITAB-ZSCHLINE EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Schedule Line Item'.
      ENDIF.

      IF WA_ITAB-ZDLVDATE EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Tanggal Delivery'.
      ENDIF.

      PERFORM CHANGEDATE USING WA_ITAB-ZDLVDATE CHANGING ZDLVDATECHECK.
      IF ZDLVDATECHECK LT SY-DATUM.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Cek Tanggal Delivery'.
      ENDIF.

      IF WA_ITAB-ZTHICK EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Thickness Film'.
      ENDIF.

      IF WA_ITAB-ZCORE EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Diameter Core'.
      ENDIF.

      IF WA_ITAB-ZNOROLL EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Jumlah Rol'.
      ENDIF.

      IF WA_ITAB-ZPECAHSCH EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Jumlah Rol Schedule Line Item'.
      ENDIF.

      IF WA_ITAB-ZTYPLBL EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Type Label'.
      ENDIF.

      IF WA_ITAB-ZTREAT EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Treatment Film'.
      ENDIF.

      IF WA_ITAB-ZWIDTH EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Lebar Roll'.
      ENDIF.

      IF WA_ITAB-ZLENGTH EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Panjang Roll'.
      ENDIF.

      IF WA_ITAB-ZCRITERIA EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Kriteria Film'.
      ENDIF.

      IF WA_ITAB-ZCRITERIA EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Kriteria Film'.
      ENDIF.

      IF WA_ITAB-ZEXTLENGTH EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Extra Length'.
      ENDIF.

      IF WA_ITAB-ZPACK EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Packing'.
      ENDIF.

    ELSEIF LV_STR EQ 'B'.

      IF WA_ITAB-ZNOROLL EQ ''.
        PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Jumlah Rol'.
      ENDIF.

    ENDIF.

    IF WA_ITAB-ZPRICE EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Pricing'.
    ENDIF.

    IF WA_ITAB-ZCURR EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Currency'.
    ENDIF.

    IF WA_ITAB-ZUOMPRICE EQ ''.
      PERFORM FILLMSG USING WA_ITAB-ZPO WA_ITAB-ZSOITEM 'Masukkan Sales Unit Pricing'.
    ENDIF.

    "end pengecekan
    CLEAR : WA_ITAB.
  ENDLOOP.


*  SORT IT_CEK_HEADER BY ZPO ZORDTYPE ZSLSORG ZDISTCHANEL ZDIVISION ZPODATE ZCUST ZSHIPH ZORDREASON ZPLANT.
  DELETE ADJACENT DUPLICATES FROM IT_CEK_HEADER COMPARING ZPO ZORDTYPE ZSLSORG ZDISTCHANEL ZDIVISION ZPODATE ZCUST ZSHIPH ZORDREASON ZPLANT
  ZUOM ZPOLINE ZTYPE ZTHICK ZCORE ZNOROLL ZTYPLBL ZTREAT ZWIDTH ZLENGTH ZCRITERIA ZEXTLENGTH ZPACK ZPRICE ZCURR
  ZUOMPRICE ZKDPACK ZSPECIALTOUCH1 ZSPECIALTOUCH2 ZSPECIALTOUCH3 ZALIAS ZCUSTMATNUM ZINOUT
  ZROUTE ZSOITEM.
  LOOP AT IT_CEK_HEADER INTO WA_CEK_HEADER.
*    SORT IT_CEK_HEADER_DETAIL BY ZPO ZORDTYPE ZSLSORG ZDISTCHANEL ZDIVISION ZPODATE ZCUST ZSHIPH ZORDREASON ZPLANT.
    DELETE ADJACENT DUPLICATES FROM IT_CEK_HEADER_DETAIL COMPARING ZPO ZORDTYPE ZSLSORG ZDISTCHANEL ZDIVISION ZPODATE ZCUST ZSHIPH ZORDREASON ZPLANT
    ZUOM ZPOLINE ZTYPE ZTHICK ZCORE ZNOROLL ZTYPLBL ZTREAT ZWIDTH ZLENGTH ZCRITERIA ZEXTLENGTH ZPACK ZPRICE ZCURR
    ZUOMPRICE ZKDPACK ZSPECIALTOUCH1 ZSPECIALTOUCH2 ZSPECIALTOUCH3 ZALIAS ZCUSTMATNUM ZINOUT
    ZROUTE ZSOITEM.

    LOOP AT IT_CEK_HEADER_DETAIL INTO WA_CEK_HEADER_DETAIL WHERE ZPO = WA_CEK_HEADER-ZPO AND ZSOITEM = WA_CEK_HEADER-ZSOITEM.

      V_PO = WA_CEK_HEADER_DETAIL-ZPO.
      V_SOITEM = WA_CEK_HEADER_DETAIL-ZSOITEM.

      "deklarasi cek header
      V_ORDTYPE = WA_CEK_HEADER_DETAIL-ZORDTYPE.
      V_SLSORG = WA_CEK_HEADER_DETAIL-ZSLSORG.
