*&      Form  INSERT_PI_NO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_SALESORDERNUMBER  text
*----------------------------------------------------------------------*
FORM INSERT_PI_NO  USING V_VBELN TYPE VBAK-VBELN.

  DATA: IT_TLINE TYPE STANDARD TABLE OF TLINE WITH HEADER LINE,
        V_TDNAME LIKE	THEAD-TDNAME.

  V_TDNAME = V_VBELN.
  IT_TLINE-TDFORMAT = '*'.
  IT_TLINE-TDLINE = WA_ITAB-ZPINO.  "PI No. Value
  APPEND IT_TLINE.

  CALL FUNCTION 'CREATE_TEXT'
    EXPORTING
      FID         = 'Z101'    "ID PI No.
      FLANGUAGE   = SY-LANGU
      FNAME       = V_TDNAME  "SO No.
      FOBJECT     = 'VBBK'
      SAVE_DIRECT = 'X'
      FFORMAT     = '*'
    TABLES
      FLINES      = IT_TLINE  "PI No. Value
    EXCEPTIONS
      NO_INIT     = 1
      NO_SAVE     = 2
      OTHERS      = 3.

  CLEAR: IT_TLINE.
  REFRESH IT_TLINE.

ENDFORM.                    " INSERT_PI_NO
