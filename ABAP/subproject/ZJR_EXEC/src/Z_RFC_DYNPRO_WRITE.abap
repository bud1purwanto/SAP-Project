FUNCTION Z_RFC_DYNPRO_WRITE.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     VALUE(PROGNAME) TYPE  PROGNAME
*"     VALUE(DYNNR) TYPE  SYCHAR04
*"     VALUE(HEADER_TITLE) LIKE  SY-TITLE
*"     VALUE(HEADER_TYPE) TYPE  CHAR1
*"     VALUE(NEXT_SCREEN) TYPE  SYDYNNR
*"  EXPORTING
*"     VALUE(EV_SUCCESS) TYPE  CHAR1
*"     VALUE(EV_MESSAGE) TYPE  STRING
*"  TABLES
*"      FLOW_LOGIC STRUCTURE  SOLI OPTIONAL
*"      CONTAINERS_JSON STRUCTURE  SOLI OPTIONAL
*"      FIELDS_JSON STRUCTURE  SOLI OPTIONAL
*"----------------------------------------------------------------------

  DATA: LS_HEADER TYPE RPY_DYHEAD,
        LT_CONTAINERS TYPE TABLE OF RPY_DYCATT WITH HEADER LINE,
        LT_FIELDS TYPE TABLE OF RPY_DYFATC WITH HEADER LINE,
        LT_FLOW TYPE TABLE OF RPY_DYFLOW WITH HEADER LINE.

  DATA: LV_MSG TYPE STRING,
        LV_SUBRC_STR TYPE STRING,
        LV_CONT_XML TYPE STRING,
        LV_FLD_XML TYPE STRING.

  " Variables for internal Dynpro Generation
  DATA: BEGIN OF L_DYNPRO_ID,
          PROG TYPE D020S-PROG,
          DNUM TYPE D020S-DNUM,
        END OF L_DYNPRO_ID.
  DATA: LT_D020S TYPE TABLE OF D020S WITH HEADER LINE,
        LT_D021S TYPE TABLE OF D021S WITH HEADER LINE,
        LT_D022S TYPE TABLE OF D022S WITH HEADER LINE,
        LT_D023S TYPE TABLE OF D023S WITH HEADER LINE,
        LV_GEN_MSG TYPE STRING,
        LV_GEN_LINE TYPE I,
        LV_GEN_WORD TYPE STRING.
  FIELD-SYMBOLS: <FS_LINE> TYPE ANY.

  " Set Header Attributes (Set dimensi max 200x255 agar container besar dari DEV tidak ditolak)
  LS_HEADER-PROGRAM = PROGNAME.
  LS_HEADER-SCREEN = DYNNR.
  LS_HEADER-LANGUAGE = SY-LANGU.
  LS_HEADER-DESCRIPT = HEADER_TITLE.
  LS_HEADER-TYPE = HEADER_TYPE.
  LS_HEADER-NEXTSCREEN = NEXT_SCREEN.
  LS_HEADER-LINES = 200.
  LS_HEADER-COLUMNS = 255.
  " Mapping Flow Logic
  LOOP AT FLOW_LOGIC ASSIGNING <FS_LINE>.
    LT_FLOW-LINE = <FS_LINE>.
    APPEND LT_FLOW.
  ENDLOOP.
  " Mapping Containers (XML to Internal Table via Transformation)
  LOOP AT CONTAINERS_JSON ASSIGNING <FS_LINE>.
    CONCATENATE LV_CONT_XML <FS_LINE> INTO LV_CONT_XML.
  ENDLOOP.
  IF LV_CONT_XML IS NOT INITIAL.
    CALL TRANSFORMATION ID SOURCE XML LV_CONT_XML RESULT DATA = LT_CONTAINERS[].
  ENDIF.
  " Mapping Fields (XML to Internal Table via Transformation)
  LOOP AT FIELDS_JSON ASSIGNING <FS_LINE>.
    CONCATENATE LV_FLD_XML <FS_LINE> INTO LV_FLD_XML.
  ENDLOOP.
  IF LV_FLD_XML IS NOT INITIAL.
    CALL TRANSFORMATION ID SOURCE XML LV_FLD_XML RESULT DATA = LT_FIELDS[].
  ENDIF.
  " Hapus screen lama secara Halal menggunakan API resmi SAP (Tanpa tembak tabel D020S)
  CALL FUNCTION 'RS_SCRP_DELETE'
    EXPORTING
      PROGNAME        = PROGNAME
      DYNNR           = DYNNR
      WITH_POPUP      = ' '
      SUPPRESS_CHECKS = 'X'
    EXCEPTIONS
      OTHERS          = 1.
  " Insert screen baru beserta seluruh UI Elements & Containers
  CALL FUNCTION 'RPY_DYNPRO_INSERT'
    EXPORTING
      HEADER                  = LS_HEADER
      SUPPRESS_CORR_CHECKS    = 'X'
    TABLES
      CONTAINERS              = LT_CONTAINERS
      FIELDS_TO_CONTAINERS    = LT_FIELDS
      FLOW_LOGIC              = LT_FLOW
    EXCEPTIONS
      CANCELLED               = 1
      ALREADY_EXISTS          = 2
      PROGRAM_NOT_EXISTS      = 3
      NOT_EXECUTED            = 4
      FIELD_NOT_ALLOWED       = 6
      ILLEGAL_FIELD_POSITION=
      7
      ILLEGAL_FIELD_VALUE     = 8
      MISSING_REQUIRED_FIELD=
      9
      NOT_GENERATED           = 10
      OTHERS                  = 99.
  IF SY-SUBRC <> 0.
    EV_SUCCESS = ABAP_FALSE.
    LV_SUBRC_STR = SY-SUBRC.
    CONDENSE LV_SUBRC_STR.
    CONCATENATE 'RPY_DYNPRO_INSERT gagal (subrc =' LV_SUBRC_STR ')' INTO EV_MESSAGE SEPARATED BY SPACE.
    RETURN.
  ENDIF.
  " Activate & Generate Dynpro Screen
  L_DYNPRO_ID-PROG = PROGNAME.
  L_DYNPRO_ID-DNUM = DYNNR.
  IMPORT DYNPRO LT_D020S LT_D021S LT_D022S LT_D023S ID L_DYNPRO_ID.
  IF SY-SUBRC = 0.
    GENERATE DYNPRO LT_D020S LT_D021S LT_D022S LT_D023S ID L_DYNPRO_ID
                    MESSAGE LV_GEN_MSG LINE LV_GEN_LINE WORD LV_GEN_WORD.
    IF SY-SUBRC = 0.
      EV_SUCCESS = ABAP_TRUE.
      EV_MESSAGE = 'Dynpro Screen berhasil disinkronisasi & di-Activate secara Sempurna!'.
    ELSE.
      EV_SUCCESS = ABAP_TRUE.
      CONCATENATE 'Screen tersimpan tapi Activate gagal:' LV_GEN_MSG INTO EV_MESSAGE.
    ENDIF.
  ELSE.
    EV_SUCCESS = ABAP_TRUE.
    EV_MESSAGE = 'Dynpro Screen berhasil disinkronisasi (Read for Activate failed).'.
  ENDIF.

ENDFUNCTION.