{"nodes": [{"id": "abap_subproject_coa_docs_render_deck_slide_3", "label": "COA Deck Slide 3: As-Is Root Cause vs Dynamic Solution", "file_type": "image", "source_file": "ABAP/subproject/COA/docs/render_deck/slide-3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "abap_subproject_coa_docs_render_deck_slide_3_as_is_single_variable", "label": "As-Is Single Variable Logic (LOT_JR_CONV / LOT_SR_CONV)", "file_type": "concept", "source_file": "ABAP/subproject/COA/docs/render_deck/slide-3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only one LOT_JR_CONV and one LOT_SR_CONV variable; in multi-tier flows the last trace overwrites the lot (JR_CONV keeps only stage 7 JRGLBI), so stage 5 (JRGLAI Shrinkage/Gloss) and stage 6 (SRGLAI Surface Tension) lots are lost and COA values print empty ('-'). Hardcoding material/MIC rejected as rigid, unscalable, and regression-prone."}, {"id": "abap_subproject_coa_docs_render_deck_slide_3_batch_genealogy_tree", "label": "Dynamic Solution: Batch Genealogy Tree", "file_type": "rationale", "source_file": "ABAP/subproject/COA/docs/render_deck/slide-3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Collect full backward order lineage into an internal table so all stages (1,5,6,7) are held simultaneously without overwriting; zero hardcode; ZMAP_COA master data unchanged; zero-regression since normal 1-2 stage scenarios yield a single-lot tree."}, {"id": "abap_subproject_coa_docs_render_deck_slide_3_gt_stage_lots", "label": "GT_STAGE_LOTS internal table", "file_type": "code", "source_file": "ABAP/subproject/COA/docs/render_deck/slide-3.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "abap_subproject_coa_docs_render_deck_slide_3_zmap_coa", "label": "ZMAP_COA mast